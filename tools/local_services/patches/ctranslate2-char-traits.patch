+// Names std_string_view<Char> only for standard character types: libc++
+// deprecates std::char_traits for others, such as char8_type before C++20.
+template <typename Char>
+struct is_std_char_type
+    : bool_constant<std::is_same<Char, char>::value ||
+                    std::is_same<Char, wchar_t>::value ||
+#ifdef __cpp_char8_t
+                    std::is_same<Char, char8_t>::value ||
+#endif
+                    std::is_same<Char, char16_t>::value ||
+                    std::is_same<Char, char32_t>::value> {};
+
+template <typename S, typename Char, bool = is_std_char_type<Char>::value>
+struct is_std_string_view : std::false_type {};
+
+template <typename S, typename Char>
+struct is_std_string_view<S, Char, true>
+    : std::is_same<S, std_string_view<Char>> {};
+
