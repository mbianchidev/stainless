 // Do nothing.
 #elif defined(__SIZEOF_INT128__) && !FMT_NVCC && \
@@ -483,8 +502,8 @@ template <typename Char> class basic_string_view {
       : data_(s.data()),
         size_(s.size()) {}
 
-  template <typename S, FMT_ENABLE_IF(std::is_same<
-                                      S, detail::std_string_view<Char>>::value)>
+  template <typename S,
+            FMT_ENABLE_IF(detail::is_std_string_view<S, Char>::value)>
