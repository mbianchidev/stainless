+class mtmd_file_streambuf final : public std::streambuf {
+    FILE * file;
+public:
+    explicit mtmd_file_streambuf(FILE * value) : file(value) {}
+
+protected:
+    std::streamsize xsgetn(char * data, std::streamsize count) override {
+        if (!file || count < 0) {
+            return 0;
+        }
+        return static_cast<std::streamsize>(std::fread(data, 1, static_cast<size_t>(count), file));
+    }
+
+    pos_type seekoff(off_type offset, std::ios_base::seekdir direction,
+                      std::ios_base::openmode mode) override {
+        const int origin = direction == std::ios_base::beg ? SEEK_SET
+                         : direction == std::ios_base::cur ? SEEK_CUR : SEEK_END;
+        if (!file || !(mode & std::ios_base::in) ||
+            offset < std::numeric_limits<long>::min() || offset > std::numeric_limits<long>::max() ||
+            std::fseek(file, static_cast<long>(offset), origin) != 0) {
+            return pos_type(off_type(-1));
+        }
+        const long position = std::ftell(file);
+        return position < 0 ? pos_type(off_type(-1)) : pos_type(position);
+    }
+};
