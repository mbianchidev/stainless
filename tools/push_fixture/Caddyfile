{
	admin off
	auto_https off
	persist_config off
}

:8443 {
	tls /run/tls/cert.pem /run/tls/key.pem
	@connection path / /__heartbeat__ /__lbheartbeat__
	handle @connection {
		reverse_proxy 127.0.0.1:8080
	}
	handle {
		respond 404
	}
}

:8444 {
	tls /run/tls/cert.pem /run/tls/key.pem
	@publishing path /wpush/* /__heartbeat__ /__lbheartbeat__
	handle @publishing {
		reverse_proxy 127.0.0.1:8082
	}
	handle {
		respond 404
	}
}
