+impl Drop for TestServer {
+    fn drop(&mut self) {
+        actix_rt::spawn(self.handle.stop(false));
+    }
+}
+
+impl TestServer {
+    fn url(&self, path: &str) -> String {
+        format!("http://{}{path}", self.address)
+    }
+
+    async fn ws(&mut self) -> std::io::Result<actix_codec::Framed<TcpStream, Codec>> {
+        let mut stream = TcpStream::connect(self.address).await?;
+        // RFC 6455's published handshake example; no authentication is involved.
+        stream.write_all(format!(
+            "GET / HTTP/1.1\r\nHost: {}\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n",
+            self.address
+        ).as_bytes()).await?;
+        let mut headers = Vec::new();
+        loop {
+            headers.push(stream.read_u8().await?);
+            assert!(headers.len() <= 8192);
+            if headers.ends_with(b"\r\n\r\n") {
+                break;
+            }
+        }
+        let headers = String::from_utf8(headers).unwrap().to_ascii_lowercase();
+        assert!(headers.starts_with("http/1.1 101 "));
+        assert!(headers.contains("sec-websocket-accept: s3pplmbitxaq9kygzzhzrbk+xoo="));
+        Ok(actix_codec::Framed::new(stream, Codec::new().client_mode()))
+    }
