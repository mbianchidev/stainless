+struct FilePayload {
+  mojom::RequestPtr request;
+  std::vector<mojom::ModelFilePtr> files;
+  std::vector<base::File> leases;
+};
+
+void CloseFiles(mojom::RequestPtr request,
+                std::vector<mojom::ModelFilePtr> files,
+                std::vector<base::File> leases, base::OnceClosure closed) {
+  if (!request && files.empty() && leases.empty()) {
+    if (closed) {
+      std::move(closed).Run();
+    }
+    return;
+  }
+  static const base::NoDestructor<scoped_refptr<base::SequencedTaskRunner>>
+      runner(base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+           base::TaskShutdownBehavior::BLOCK_SHUTDOWN}));
+  using Payload = std::unique_ptr<FilePayload, base::OnTaskRunnerDeleter>;
+  Payload payload(
+      new FilePayload{std::move(request), std::move(files), std::move(leases)},
+      base::OnTaskRunnerDeleter(*runner));
+  if (!(*runner)->PostTaskAndReply(
+          FROM_HERE,
+          base::BindOnce([](Payload value) { delete value.release(); },
+                         std::move(payload)),
+          closed ? std::move(closed) : base::DoNothing())) {
+    LOG(ERROR) << "Stainless model file cleanup could not be scheduled; "
+                  "new inference must not assume released leases";
+  }
+}
