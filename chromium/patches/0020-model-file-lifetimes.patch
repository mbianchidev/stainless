+IN_PROC_BROWSER_TEST_F(StainlessLocalWorkerBrowserTest,
+                       RejectedPreparationClosesFilesOffTheUiSequence) {
+  base::ScopedTempDir directory;
+  base::File lease;
+  {
+    base::ScopedAllowBlockingForTesting setup;
+    ASSERT_TRUE(directory.CreateUniqueTempDir());
+    const auto path = directory.GetPath().AppendASCII("synthetic-lease");
+    ASSERT_TRUE(base::WriteFile(path, "synthetic"));
+    lease = base::File(path, base::File::FLAG_OPEN | base::File::FLAG_READ);
+    ASSERT_TRUE(lease.IsValid());
+  }
+  browser()->GetProfile()->GetPrefs()->SetBoolean(kOcrEnabled, true);
+  base::test::TestFuture<mojom::ResultPtr> rejected;
+  LocalBroker::Get().Submit(
+      frame(), Feature::kOcr,
+      base::BindOnce(
+          [](base::File lease, LocalBroker::Ready ready) {
+            LocalBroker::Prepared prepared;
+            prepared.leases.push_back(std::move(lease));
+            auto request = mojom::OcrRequest::New();
+            prepared.request = mojom::Request::NewOcr(std::move(request));
+            std::move(ready).Run(std::move(prepared));
+          },
+          std::move(lease)),
+      rejected.GetCallback());
+  EXPECT_EQ(mojom::Status::kInvalidInput, rejected.Get()->status);
+  base::test::TestFuture<mojom::ResultPtr> second;
+  base::test::TestFuture<LocalBroker::Ready> admitted;
+  const auto id = LocalBroker::Get().Submit(
+      frame(), Feature::kOcr, admitted.GetCallback(), second.GetCallback());
+  ASSERT_TRUE(admitted.Wait());
+  LocalBroker::Get().Cancel(id);
+  EXPECT_EQ(mojom::Status::kCancelled, second.Get()->status);
+  {
+    base::ScopedAllowBlockingForTesting cleanup;
+    ASSERT_TRUE(directory.Delete());
+  }
+}
