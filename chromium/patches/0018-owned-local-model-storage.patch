+base::expected<Inventory, std::string> Inspect(const Location& location,
+                                               bool verify_members) {
+  auto exists = Directories(location.leaf, false);
+  if (!exists.has_value()) {
+    return base::unexpected(exists.error());
+  }
+  if (!*exists) {
+    return Inventory();
+  }
+  auto lease = RootLease(location, false, false);
+  if (!lease.has_value()) {
+    return base::unexpected(lease.error());
+  }
+  return InventoryLocked(location, verify_members);
+}
+
+base::expected<std::unique_ptr<Transaction>, std::string> Reserve(
+    const Location& location, const ModelPack& pack) {
+  if (!DigestName(pack.archive_sha256) || !CatalogPack(pack.id) ||
+      *CatalogPack(pack.id) != pack ||
+      pack.archive_bytes > kMaximumCacheBytes ||
+      pack.unpacked_bytes > kMaximumCacheBytes - pack.archive_bytes) {
+    return base::unexpected(
+        "Only compiled reviewed model packs can be installed");
+  }
+  auto lease = RootLease(location, true, true);
+  if (!lease.has_value()) {
+    return base::unexpected(lease.error());
+  }
+  if (base::PathExists(PackPath(location, pack.archive_sha256))) {
+    return base::unexpected(
+        "This model pack already exists; verify or remove it first");
+  }
+  auto inventory = InventoryLocked(location, false);
+  if (!inventory.has_value()) {
+    return base::unexpected(inventory.error());
+  }
+  const uint64_t required = pack.archive_bytes + pack.unpacked_bytes + 65536;
+  if (required > kMaximumCacheBytes - inventory->stored_bytes -
+                     inventory->reserved_bytes) {
+    return base::unexpected(
+        "The 4 GiB model budget cannot fit archive and staging; remove a pack "
+        "explicitly");
+  }
+  const auto free = base::SysInfo::AmountOfFreeDiskSpace(location.leaf);
+  if (!free || *free < 0 || static_cast<uint64_t>(*free) < required) {
+    return base::unexpected(
+        "Not enough available disk space for model archive and staging");
+  }
+  auto result = std::make_unique<Transaction>();
+  result->location = location;
+  result->pack = pack;
+  result->lease = std::move(*lease);
+  const auto token = base::UnguessableToken::Create().ToString();
+  result->archive = location.leaf.AppendASCII("download-" + token + ".zip");
+  result->staging = location.leaf.AppendASCII("staging-" + token);
+  result->reservation = location.leaf.AppendASCII("reserve-" + token + ".json");
+  auto record = PackRecord(location, pack);
+  record.Set("download", result->archive.BaseName().value());
+  record.Set("staging", result->staging.BaseName().value());
+  auto written = WriteJson(result->reservation, record);
+  if (!written.has_value()) {
+    return base::unexpected(written.error());
+  }
+  auto archive = OpenData(result->archive, O_WRONLY, true);
+  if (!archive.has_value()) {
+    if (!base::DeleteFile(result->reservation)) {
+      return base::unexpected(
+          "Model archive setup failed and its reservation needs explicit "
+          "cleanup");
+    }
+    return base::unexpected(archive.error());
+  }
+  result->archive_file = std::move(*archive);
+  return result;
+}
+
+Status Install(Transaction& transaction) {
+  if (transaction.cancelled->load()) {
+    return base::unexpected("Model installation was cancelled");
+  }
+  if (!transaction.archive_file.Flush()) {
+    return base::unexpected("Downloaded model data could not be flushed");
+  }
+  transaction.archive_file.Close();
+  const auto& pack = transaction.pack;
+  base::File archive;
+  auto checked = VerifyFile(
+      transaction.archive, {"archive", pack.archive_sha256, pack.archive_bytes},
+      true, &archive);
+  if (!checked.has_value()) {
+    return checked;
+  }
+  if (mkdir(transaction.staging.value().c_str(), 0700) != 0) {
+    return base::unexpected(
+        "A new owned model staging directory could not be created");
+  }
+  auto marked = WriteJson(transaction.staging.AppendASCII(kPackMarker),
+                          PackRecord(transaction.location, pack));
+  if (!marked.has_value()) {
+    return marked;
+  }
+  zip::ZipReader reader;
+  if (!reader.OpenFromPlatformFile(archive.GetPlatformFile())) {
+    return base::unexpected("The verified model ZIP could not be opened");
+  }
+  std::set<std::string> extracted;
+  while (const auto* entry = reader.Next()) {
+    const auto found = std::ranges::find(pack.members, entry->path.value(),
+                                         &ModelMember::name);
+    if (transaction.cancelled->load() || entry->is_directory ||
+        entry->is_unsafe || entry->is_encrypted || entry->is_symbolic_link ||
+        (entry->external_attributes >> 16) & 0111 ||
+        !S_ISREG(entry->external_attributes >> 16) ||
+        entry->path_in_original_encoding != entry->path.value() ||
+        entry->physical_path != entry->path || found == pack.members.end() ||
+        entry->original_size < 0 ||
+        static_cast<uint64_t>(entry->original_size) != found->bytes ||
+        !extracted.insert(found->name).second) {
+      return base::unexpected(
+          "Model ZIP has an unreviewed, linked, encrypted or oversized member");
+    }
+    auto output =
+        OpenData(transaction.staging.AppendASCII(found->name), O_WRONLY, true);
+    if (!output.has_value()) {
+      return base::unexpected(output.error());
+    }
+    MemberWriter writer(std::move(*output), found->bytes,
+                        transaction.cancelled);
+    if (!reader.ExtractCurrentEntry(&writer, found->bytes + 1) ||
+        !writer.Complete()) {
+      return base::unexpected(
+          "Model ZIP extraction was cancelled or exceeded its exact byte "
+          "limit");
+    }
+    auto member =
+        VerifyFile(transaction.staging.AppendASCII(found->name), *found, true);
+    if (!member.has_value()) {
+      return member;
+    }
+  }
+  if (!reader.ok() || extracted.size() != pack.members.size() ||
+      transaction.cancelled->load()) {
+    return base::unexpected("Model ZIP is incomplete, malformed or cancelled");
+  }
+  for (const auto& member : pack.members) {
+    if (chmod(transaction.staging.AppendASCII(member.name).value().c_str(),
+              0400) != 0) {
+      return base::unexpected(
+          "Verified model member permissions could not be finalized");
+    }
+  }
+  if (chmod(transaction.staging.AppendASCII(kPackMarker).value().c_str(),
+            0400) != 0 ||
+      chmod(transaction.staging.value().c_str(), 0500) != 0 ||
+      !base::Move(transaction.staging,
+                  PackPath(transaction.location, pack.archive_sha256))) {
+    return base::unexpected(
+        "Verified model installation could not commit atomically");
+  }
+  if (!base::DeleteFile(transaction.archive) ||
+      !base::DeleteFile(transaction.reservation)) {
+    return base::unexpected(
+        "Model is installed but archive/reservation cleanup needs attention");
+  }
+  return {};
+}
+
+Status Cancel(Transaction& transaction) {
+  transaction.cancelled->store(true);
+  transaction.archive_file.Close();
+  if (base::PathExists(transaction.staging)) {
+    auto record = ReadJson(transaction.staging.AppendASCII(kPackMarker));
+    if (!record.has_value()) {
+      return base::unexpected("Unrecognized staging data is preserved");
+    }
+    auto owned = ParseRecord(transaction.location, *record);
+    if (!owned.has_value() ||
+        owned->archive_sha256 != transaction.pack.archive_sha256) {
+      return base::unexpected("Staging ownership could not be verified");
+    }
+    auto checked = VerifyPack(transaction.location, transaction.staging, *owned,
+                              false, true);
+    if (!checked.has_value() ||
+        chmod(transaction.staging.value().c_str(), 0700) != 0 ||
+        !base::DeletePathRecursively(transaction.staging)) {
+      return base::unexpected(
+          "Owned model staging could not be removed safely");
+    }
+  }
+  if ((base::PathExists(transaction.archive) &&
+       !base::DeleteFile(transaction.archive)) ||
+      (base::PathExists(transaction.reservation) &&
+       !base::DeleteFile(transaction.reservation))) {
+    return base::unexpected("Owned partial model cleanup could not finish");
+  }
+  return {};
+}
+
+base::expected<Acquired, std::string> Acquire(const Location& location,
+                                              const std::string& pack_id) {
+  const auto* pack = CatalogPack(pack_id);
+  if (!pack) {
+    return base::unexpected("This model pack is unsupported");
+  }
+  auto lease = RootLease(location, false, false);
+  if (!lease.has_value()) {
+    return base::unexpected(lease.error());
+  }
+  const auto directory = PackPath(location, pack->archive_sha256);
+  auto record = ReadJson(directory.AppendASCII(kPackMarker));
+  if (!record.has_value()) {
+    return base::unexpected(
+        "Model pack is not installed; explicit setup is required");
+  }
+  auto owned = ParseRecord(location, *record);
+  if (!owned.has_value() || owned->id != pack->id ||
+      owned->archive_sha256 != pack->archive_sha256) {
+    return base::unexpected(
+        "Installed model ownership does not match the catalog");
+  }
+  auto checked = VerifyPack(location, directory, *pack, false);
+  if (!checked.has_value()) {
+    return base::unexpected(checked.error());
+  }
+  Acquired result;
+  result.leases.push_back(std::move(*lease));
+  for (const auto& member : pack->members) {
+    base::File file;
+    auto valid =
+        VerifyFile(directory.AppendASCII(member.name), member, true, &file);
+    if (!valid.has_value()) {
+      return base::unexpected(valid.error());
+    }
+    auto model = mojom::ModelFile::New();
+    model->name = member.name;
+    model->file = std::move(file);
+    model->size = member.bytes;
+    if (!base::HexStringToBytes(member.sha256, &model->sha256) ||
+        model->sha256.size() != 32) {
+      return base::unexpected("Compiled model digest is invalid");
+    }
+    result.files.push_back(std::move(model));
+  }
+  return result;
+}
+
+Status Remove(const Location& location, const std::string& archive_sha256) {
+  if (!DigestName(archive_sha256)) {
+    return base::unexpected(
+        "Choose an owned model version from this root's inventory");
+  }
+  auto lease = RootLease(location, false, true);
+  if (!lease.has_value()) {
+    return base::unexpected(lease.error());
+  }
+  const auto directory = PackPath(location, archive_sha256);
+  bool removed = false;
+  if (base::PathExists(directory)) {
+    auto record = ReadJson(directory.AppendASCII(kPackMarker));
+    if (!record.has_value()) {
+      return base::unexpected(
+          "An owned installed model marker is required for removal");
+    }
+    auto pack = ParseRecord(location, *record);
+    if (!pack.has_value() || pack->archive_sha256 != archive_sha256) {
+      return base::unexpected(
+          "Model version ownership does not match the requested removal");
+    }
+    auto checked = VerifyPack(location, directory, *pack, false, true);
+    if (!checked.has_value()) {
+      return checked;
+    }
+    if (chmod(directory.value().c_str(), 0700) != 0 ||
+        !base::DeletePathRecursively(directory)) {
+      return base::unexpected("Owned model version could not be removed");
+    }
+    removed = true;
+  }
+  base::FileEnumerator reservations(
+      location.leaf, false, base::FileEnumerator::FILES, "reserve-*.json");
+  for (auto path = reservations.Next(); !path.empty();
+       path = reservations.Next()) {
+    auto record = ReadJson(path);
+    if (!record.has_value()) {
+      return base::unexpected("Unrecognized model reservations are preserved");
+    }
+    auto pack = ParseRecord(location, *record);
+    if (!pack.has_value()) {
+      return base::unexpected(pack.error());
+    }
+    if (pack->archive_sha256 != archive_sha256) {
+      continue;
+    }
+    const auto* archive = record->FindString("download");
+    const auto* staging = record->FindString("staging");
+    if (!archive || !DataName(*archive) || !archive->starts_with("download-") ||
+        !archive->ends_with(".zip") || !staging || !DataName(*staging) ||
+        !staging->starts_with("staging-")) {
+      return base::unexpected("Reserved model cleanup paths are invalid");
+    }
+    Transaction transaction;
+    transaction.location = location;
+    transaction.pack = std::move(*pack);
+    transaction.archive = location.leaf.AppendASCII(*archive);
+    transaction.staging = location.leaf.AppendASCII(*staging);
+    transaction.reservation = path;
+    auto cancelled = Cancel(transaction);
+    if (!cancelled.has_value()) {
+      return cancelled;
+    }
+    removed = true;
+  }
+  if (!removed) {
+    return base::unexpected("No matching owned model version was found");
+  }
+  return {};
+}
+
+}  // namespace stainless_local::model_storage
