+base::expected<Location, std::string> ResolveLocation(
+    const base::FilePath& user_root) {
+  Location result;
+  if (!user_root.IsAbsolute() || user_root.ReferencesParent() ||
+      !base::NormalizeFilePath(user_root, &result.user_root)) {
+    return base::unexpected("A canonical existing user-data root is required");
+  }
+  const auto* command = base::CommandLine::ForCurrentProcess();
+  if (command->HasSwitch(switches::kDiskCacheDir)) {
+    const auto cache = command->GetSwitchValuePath(switches::kDiskCacheDir);
+    if (!cache.IsAbsolute() || cache.ReferencesParent()) {
+      return base::unexpected(
+          "Model setup requires an absolute --disk-cache-dir");
+    }
+    auto canonical = CanonicalCacheBase(cache);
+    if (!canonical.has_value()) {
+      return base::unexpected(canonical.error());
+    }
+    result.namespace_root = canonical->AppendASCII("StainlessLocalModels");
+  } else {
+    base::FilePath cache;
+    if (!base::PathService::Get(base::DIR_CACHE, &cache)) {
+      return base::unexpected(
+          "The macOS caches directory could not be resolved");
+    }
+    auto canonical = CanonicalCacheBase(cache);
+    if (!canonical.has_value()) {
+      return base::unexpected(canonical.error());
+    }
+    result.namespace_root =
+        canonical->AppendASCII("Stainless").AppendASCII("LocalModels");
+  }
+  if (result.user_root == result.namespace_root ||
+      result.user_root.IsParent(result.namespace_root) ||
+      result.namespace_root.IsParent(result.user_root)) {
+    return base::unexpected(
+        "Model cache and private user-data root cannot overlap");
+  }
+  result.binding =
+      base::HexEncodeLower(crypto::hash::Sha256(result.user_root.value()));
+  result.leaf = result.namespace_root.AppendASCII(result.binding);
+  return result;
+}
