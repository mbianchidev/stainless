+IN_PROC_BROWSER_TEST_F(
+    StainlessLocalWorkerBrowserTest,
+    MANUAL_CompiledModelPackInstallOfflineLeaseBudgetAndRemoval) {
+  base::ScopedAllowBlockingForTesting allow_blocking;
+  base::ScopedTempDir root;
+  base::ScopedTempDir other_root;
+  base::ScopedTempDir cache;
+  ASSERT_TRUE(root.CreateUniqueTempDir());
+  ASSERT_TRUE(other_root.CreateUniqueTempDir());
+  ASSERT_TRUE(cache.CreateUniqueTempDir());
+  ASSERT_TRUE(
+      base::WriteFile(root.GetPath().AppendASCII("private-state"), "keep"));
+  base::test::ScopedCommandLine command;
+  command.GetProcessCommandLine()->AppendSwitchPath(
+      "disk-cache-dir", CanonicalFixturePath(cache.GetPath()));
+  auto location = model_storage::ResolveLocation(root.GetPath());
+  auto other = model_storage::ResolveLocation(other_root.GetPath());
+  ASSERT_TRUE(location.has_value());
+  ASSERT_TRUE(other.has_value());
+  ASSERT_NE(location->binding, other->binding);
+  const auto found =
+      std::ranges::find(ModelCatalog(), "ocr-eng", &ModelPack::id);
+  ASSERT_NE(ModelCatalog().end(), found);
+  const ModelPack pack = *found;
+  const auto directory =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValuePath(
+          "stainless-model-pack-fixture");
+  ASSERT_TRUE(directory.IsAbsolute());
+  const auto archive = directory.AppendASCII(GURL(pack.url).ExtractFileName());
+  auto corrupt_reservation = model_storage::Reserve(*location, pack);
+  ASSERT_TRUE(corrupt_reservation.has_value()) << corrupt_reservation.error();
+  ASSERT_TRUE((*corrupt_reservation)
+                  ->archive_file.WriteAtCurrentPosAndCheck(
+                      base::as_byte_span("not a verified archive")));
+  ASSERT_TRUE(
+      (*corrupt_reservation)->archive_file.SetLength(pack.archive_bytes));
+  EXPECT_FALSE(model_storage::Install(**corrupt_reservation).has_value());
+  EXPECT_FALSE(base::PathExists((*corrupt_reservation)->staging));
+  auto cancelled = model_storage::Cancel(**corrupt_reservation);
+  ASSERT_TRUE(cancelled.has_value()) << cancelled.error();
+  corrupt_reservation->reset();
+  auto reserve = model_storage::Reserve(*location, pack);
+  ASSERT_TRUE(reserve.has_value()) << reserve.error();
+  auto& transaction = **reserve;
+  base::File input(archive, base::File::FLAG_OPEN | base::File::FLAG_READ);
+  ASSERT_TRUE(input.IsValid());
+  std::array<uint8_t, 65536> bytes;
+  while (true) {
+    const auto read = input.ReadAtCurrentPos(bytes);
+    ASSERT_TRUE(read.has_value());
+    if (!*read) {
+      break;
+    }
+    ASSERT_TRUE(transaction.archive_file.WriteAtCurrentPosAndCheck(
+        base::span(bytes).first(*read)));
+  }
+  auto installed = model_storage::Install(transaction);
+  ASSERT_TRUE(installed.has_value()) << installed.error();
+  reserve->reset();
+  auto inventory = model_storage::Inspect(*location, true);
+  ASSERT_TRUE(inventory.has_value()) << inventory.error();
+  ASSERT_EQ(1u, inventory->packs.size());
+  EXPECT_EQ("ready", inventory->packs[0].state);
+  EXPECT_EQ(0u, inventory->reserved_bytes);
+  EXPECT_GE(inventory->stored_bytes, pack.unpacked_bytes);
+  auto acquired = model_storage::Acquire(*location, pack.id);
+  ASSERT_TRUE(acquired.has_value()) << acquired.error();
+  EXPECT_FALSE(acquired->files.empty());
+  EXPECT_FALSE(
+      model_storage::Remove(*location, pack.archive_sha256).has_value());
+  EXPECT_FALSE(model_storage::Acquire(*other, pack.id).has_value());
+  EXPECT_FALSE(base::PathExists(other->leaf));
+  acquired = base::unexpected("release synthetic lease");
+  const auto member = location->leaf.AppendASCII("pack-" + pack.archive_sha256)
+                          .AppendASCII("eng.traineddata");
+  ASSERT_TRUE(base::SetPosixFilePermissions(member, 0600));
+  base::File corrupt(member, base::File::FLAG_OPEN | base::File::FLAG_WRITE);
+  ASSERT_TRUE(corrupt.IsValid());
+  ASSERT_TRUE(corrupt.WriteAndCheck(0, base::as_byte_span("corrupt")));
+  corrupt.Close();
+  EXPECT_FALSE(model_storage::Acquire(*location, pack.id).has_value());
+  const uint64_t overhead =
+      inventory->stored_bytes -
+      std::ranges::find(pack.members, "eng.traineddata", &ModelMember::name)
+          ->bytes;
+  base::File sparse(member, base::File::FLAG_OPEN | base::File::FLAG_WRITE);
+  ASSERT_TRUE(sparse.IsValid());
+  ASSERT_TRUE(sparse.SetLength(model_storage::kMaximumCacheBytes - overhead));
+  auto at_limit = model_storage::Inspect(*location, false);
+  ASSERT_TRUE(at_limit.has_value()) << at_limit.error();
+  EXPECT_EQ(model_storage::kMaximumCacheBytes, at_limit->stored_bytes);
+  auto another = std::ranges::find(ModelCatalog(), "ocr-ita", &ModelPack::id);
+  ASSERT_NE(ModelCatalog().end(), another);
+  EXPECT_FALSE(model_storage::Reserve(*location, *another).has_value());
+  ASSERT_TRUE(
+      sparse.SetLength(model_storage::kMaximumCacheBytes - overhead + 1));
+  EXPECT_FALSE(model_storage::Inspect(*location, false).has_value());
+  sparse.Close();
+  auto removed = model_storage::Remove(*location, pack.archive_sha256);
+  ASSERT_TRUE(removed.has_value()) << removed.error();
+  EXPECT_FALSE(base::PathExists(member));
+  std::string private_state;
+  ASSERT_TRUE(base::ReadFileToString(
+      root.GetPath().AppendASCII("private-state"), &private_state));
+  EXPECT_EQ("keep", private_state);
+}
