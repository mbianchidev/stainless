+#ifndef CHROME_BROWSER_STAINLESS_LOCAL_MODEL_STORAGE_H_
+#define CHROME_BROWSER_STAINLESS_LOCAL_MODEL_STORAGE_H_
+
+#include <atomic>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/files/file.h"
+#include "base/files/file_path.h"
+#include "base/types/expected.h"
+#include "chrome/browser/stainless_local/model_catalog.h"
+#include "chrome/services/stainless_local/public/mojom/local_worker.mojom.h"
+
+namespace stainless_local::model_storage {
+
+inline constexpr uint64_t kMaximumCacheBytes = 4294967296;
+
+struct Location {
+  base::FilePath user_root;
+  base::FilePath namespace_root;
+  base::FilePath leaf;
+  std::string binding;
+};
+
+struct StoredPack {
+  std::string id;
+  std::string archive_sha256;
+  std::string state;
+  uint64_t bytes = 0;
+  bool current = false;
+};
+
+struct Inventory {
+  uint64_t stored_bytes = 0;
+  uint64_t reserved_bytes = 0;
+  std::vector<StoredPack> packs;
+};
+
+struct Transaction {
+  Location location;
+  ModelPack pack;
+  base::File lease;
+  base::File archive_file;
+  base::FilePath archive;
+  base::FilePath staging;
+  base::FilePath reservation;
+  std::shared_ptr<std::atomic_bool> cancelled =
+      std::make_shared<std::atomic_bool>(false);
+};
+
+struct Acquired {
+  std::vector<base::File> leases;
+  std::vector<mojom::ModelFilePtr> files;
+};
+
+base::expected<Location, std::string> ResolveLocation(
+    const base::FilePath& user_root);
+base::expected<Inventory, std::string> Inspect(const Location& location,
+                                               bool verify_members);
+base::expected<std::unique_ptr<Transaction>, std::string> Reserve(
+    const Location& location, const ModelPack& pack);
+base::expected<void, std::string> Install(Transaction& transaction);
+base::expected<void, std::string> Cancel(Transaction& transaction);
+base::expected<Acquired, std::string> Acquire(const Location& location,
+                                              const std::string& pack_id);
+base::expected<void, std::string> Remove(const Location& location,
+                                         const std::string& archive_sha256);
+
+}  // namespace stainless_local::model_storage
+
+#endif
