+  ASSERT_TRUE(cache.CreateUniqueTempDir());
+  base::ScopedPathOverride caches(base::DIR_CACHE,
+                                  CanonicalFixturePath(cache.GetPath()));
+  base::test::ScopedCommandLine command;
+  command.GetProcessCommandLine()->RemoveSwitch("disk-cache-dir");
+  auto location = model_storage::ResolveLocation(root.GetPath());
+  ASSERT_TRUE(location.has_value()) << location.error();
+  EXPECT_FALSE(base::PathExists(location->namespace_root));
+  auto inventory = model_storage::Inspect(*location, true);
+  ASSERT_TRUE(inventory.has_value()) << inventory.error();
+  EXPECT_EQ(0u, inventory->stored_bytes);
+  EXPECT_FALSE(base::PathExists(location->namespace_root));
+  command.GetProcessCommandLine()->AppendSwitchPath(
+      "disk-cache-dir", root.GetPath().AppendASCII("cache"));
+  EXPECT_FALSE(model_storage::ResolveLocation(root.GetPath()).has_value());
+  EXPECT_FALSE(base::PathExists(root.GetPath().AppendASCII("cache")));
+  command.GetProcessCommandLine()->AppendSwitchASCII("disk-cache-dir",
+                                                     "relative");
+  EXPECT_FALSE(model_storage::ResolveLocation(root.GetPath()).has_value());
