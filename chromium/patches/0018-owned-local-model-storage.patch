+bool DigestName(std::string_view value) {
+  return value.size() == 64 && std::ranges::all_of(value, [](char c) {
+           return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
+         });
+}
+
+bool DataName(std::string_view value) {
+  return !value.empty() && value != "." && value != ".." &&
+         value.size() <= 96 && std::ranges::all_of(value, [](char c) {
+           return base::IsAsciiAlphaNumeric(c) || c == '.' || c == '_' ||
+                  c == '-';
+         });
+}
+
+const ModelPack* CatalogPack(std::string_view id) {
+  const auto& catalog = ModelCatalog();
+  auto found = std::ranges::find(catalog, id, &ModelPack::id);
+  return found == catalog.end() ? nullptr : &*found;
+}
+
+base::FilePath PackPath(const Location& location, std::string_view hash) {
+  return location.leaf.AppendASCII("pack-" + std::string(hash));
+}
+
+base::expected<base::FilePath, std::string> CanonicalCacheBase(
+    const base::FilePath& path) {
+  if (!path.IsAbsolute() || path.ReferencesParent()) {
+    return base::unexpected(
+        "Model cache base must be an absolute normalized path");
+  }
+  auto existing = path;
+  std::vector<std::string> missing;
+  while (!base::PathExists(existing)) {
+    if (base::IsLink(existing) || existing == existing.DirName()) {
+      return base::unexpected("Model cache base cannot be resolved safely");
+    }
+    missing.push_back(existing.BaseName().value());
+    existing = existing.DirName();
+  }
+  base::FilePath canonical;
+  if (!base::NormalizeFilePath(existing, &canonical)) {
+    return base::unexpected("Model cache base could not be canonicalized");
+  }
+  for (auto component = missing.rbegin(); component != missing.rend();
+       ++component) {
+    canonical = canonical.Append(*component);
+  }
+  return canonical;
+}
+
+base::expected<bool, std::string> Directories(const base::FilePath& path,
+                                              bool create) {
+  if (!path.IsAbsolute() || path.ReferencesParent()) {
+    return base::unexpected("Model cache path must be absolute and normalized");
+  }
+  base::FilePath current("/");
+  for (const auto& component : path.GetComponents()) {
+    if (component == "/") {
+      continue;
+    }
+    current = current.Append(component);
+    struct stat info;
+    if (lstat(current.value().c_str(), &info) != 0) {
+      if (errno != ENOENT) {
+        return base::unexpected("Model cache directory cannot be inspected");
+      }
+      if (!create) {
+        return false;
+      }
+      if (mkdir(current.value().c_str(), 0700) != 0 ||
+          lstat(current.value().c_str(), &info) != 0) {
+        return base::unexpected("Model cache directory cannot be created");
+      }
+    }
+    if (!S_ISDIR(info.st_mode) || S_ISLNK(info.st_mode)) {
+      return base::unexpected(
+          "Model cache paths cannot contain links or non-directories");
+    }
+  }
+  return true;
+}
+
+base::expected<base::File, std::string> OpenData(const base::FilePath& path,
+                                                 int flags,
+                                                 bool create = false) {
+  base::File file(open(
+      path.value().c_str(),
+      flags | O_CLOEXEC | O_NOFOLLOW | (create ? O_CREAT | O_EXCL : 0), 0600));
+  struct stat info;
+  if (!file.IsValid() || fstat(file.GetPlatformFile(), &info) != 0 ||
+      !S_ISREG(info.st_mode) || info.st_uid != geteuid() ||
+      info.st_nlink != 1 || (info.st_mode & 0111)) {
+    return base::unexpected(
+        "Expected owned, single-link, non-executable model data");
+  }
+  return std::move(file);
+}
+
+base::expected<base::DictValue, std::string> ReadJson(
+    const base::FilePath& path) {
+  auto file = OpenData(path, O_RDONLY);
+  if (!file.has_value()) {
+    return base::unexpected(file.error());
+  }
+  const auto size = file->GetLength();
+  if (size <= 0 || size > 65536) {
+    return base::unexpected("Invalid bounded model-cache metadata");
+  }
+  std::string bytes(size, '\0');
+  if (!file->ReadAndCheck(0, base::as_writable_byte_span(bytes))) {
+    return base::unexpected("Model-cache metadata could not be read");
+  }
+  auto value = base::JSONReader::Read(bytes, base::JSON_PARSE_RFC);
+  if (!value || !value->is_dict()) {
+    return base::unexpected("Model-cache metadata is malformed");
+  }
+  return std::move(value->GetDict());
+}
+
+Status WriteJson(const base::FilePath& path, const base::DictValue& value) {
+  auto bytes = base::WriteJson(value);
+  if (!bytes) {
+    return base::unexpected("Model-cache metadata could not be serialized");
+  }
+  auto file = OpenData(path, O_WRONLY, true);
+  if (!file.has_value() ||
+      !file->WriteAtCurrentPosAndCheck(base::as_byte_span(*bytes)) ||
+      !file->Flush()) {
+    return base::unexpected("Model-cache metadata could not be persisted");
+  }
+  return {};
+}
+
+base::DictValue PackRecord(const Location& location, const ModelPack& pack) {
+  base::ListValue members;
+  for (const auto& member : pack.members) {
+    members.Append(base::DictValue()
+                       .Set("name", member.name)
+                       .Set("sha256", member.sha256)
+                       .Set("bytes", base::NumberToString(member.bytes)));
+  }
+  return base::DictValue()
+      .Set("schema", 1)
+      .Set("binding", location.binding)
+      .Set("id", pack.id)
+      .Set("archive", pack.archive_sha256)
+      .Set("archive_bytes", base::NumberToString(pack.archive_bytes))
+      .Set("unpacked_bytes", base::NumberToString(pack.unpacked_bytes))
+      .Set("members", std::move(members));
+}
+
+base::expected<ModelPack, std::string> ParseRecord(
+    const Location& location, const base::DictValue& value) {
+  const auto* binding = value.FindString("binding");
+  const auto* id = value.FindString("id");
+  const auto* hash = value.FindString("archive");
+  const auto* archive = value.FindString("archive_bytes");
+  const auto* unpacked = value.FindString("unpacked_bytes");
+  const auto* members = value.FindList("members");
+  ModelPack pack;
+  if (value.FindInt("schema") != 1 || !binding ||
+      *binding != location.binding || !id || !DataName(*id) || !hash ||
+      !DigestName(*hash) || !archive || !unpacked ||
+      !base::StringToUint64(*archive, &pack.archive_bytes) ||
+      !base::StringToUint64(*unpacked, &pack.unpacked_bytes) ||
+      !pack.archive_bytes || !pack.unpacked_bytes ||
+      pack.archive_bytes > kMaximumCacheBytes ||
+      pack.unpacked_bytes > kMaximumCacheBytes || !members ||
+      members->empty() || members->size() > 64) {
+    return base::unexpected("Unrecognized model-cache ownership metadata");
+  }
+  pack.id = *id;
+  pack.archive_sha256 = *hash;
+  uint64_t total = 0;
+  std::set<std::string> names;
+  for (const auto& item : *members) {
+    const auto* member = item.GetIfDict();
+    const auto* name = member ? member->FindString("name") : nullptr;
+    const auto* sha = member ? member->FindString("sha256") : nullptr;
+    const auto* bytes = member ? member->FindString("bytes") : nullptr;
+    uint64_t size = 0;
+    if (!name || !DataName(*name) || *name == kPackMarker ||
+        !names.insert(*name).second || !sha || !DigestName(*sha) || !bytes ||
+        !base::StringToUint64(*bytes, &size) ||
+        size > kMaximumCacheBytes - total) {
+      return base::unexpected("Invalid owned model member inventory");
+    }
+    total += size;
+    pack.members.push_back({*name, *sha, size});
+  }
+  if (total != pack.unpacked_bytes) {
+    return base::unexpected("Owned model byte inventory does not balance");
+  }
+  return pack;
+}
+
+base::expected<base::File, std::string> RootLease(const Location& location,
+                                                  bool create, bool exclusive) {
+  auto directories = Directories(location.leaf, create);
+  if (!directories.has_value()) {
+    return base::unexpected(directories.error());
+  }
+  if (!*directories) {
+    return base::unexpected("Model cache is not installed");
+  }
+  struct stat root;
+  if (lstat(location.leaf.value().c_str(), &root) != 0 ||
+      root.st_uid != geteuid() || root.st_mode & 0077) {
+    return base::unexpected("Model-cache leaf must be owned and private");
+  }
+  const auto lease_path = location.leaf.AppendASCII(kLease);
+  const auto marker = location.leaf.AppendASCII(kMarker);
+  if (!base::PathExists(marker)) {
+    if (!create) {
+      return base::unexpected("Existing cache leaf has no owned marker");
+    }
+    base::FileEnumerator entries(location.leaf, false,
+                                 base::FileEnumerator::FILES |
+                                     base::FileEnumerator::DIRECTORIES |
+                                     base::FileEnumerator::SHOW_SYM_LINKS);
+    for (auto path = entries.Next(); !path.empty(); path = entries.Next()) {
+      if (path.BaseName().value() != kLease) {
+        return base::unexpected(
+            "Refusing to modify an existing foreign cache leaf");
+      }
+    }
+  }
+  auto lease = OpenData(lease_path, exclusive ? O_RDWR : O_RDONLY);
+  if (!lease.has_value() && create && !base::PathExists(lease_path)) {
+    lease = OpenData(lease_path, O_RDWR, true);
+  }
+  if (!lease.has_value()) {
+    return base::unexpected(lease.error());
+  }
+  if (flock(lease->GetPlatformFile(),
+            (exclusive ? LOCK_EX : LOCK_SH) | LOCK_NB) != 0) {
+    return base::unexpected(
+        "Model cache is in use; stop its current task before changing packs");
+  }
+  if (!base::PathExists(marker) && create) {
+    base::FileEnumerator entries(location.leaf, false,
+                                 base::FileEnumerator::FILES |
+                                     base::FileEnumerator::DIRECTORIES |
+                                     base::FileEnumerator::SHOW_SYM_LINKS);
+    for (auto path = entries.Next(); !path.empty(); path = entries.Next()) {
+      if (path.BaseName().value() != kLease) {
+        return base::unexpected(
+            "Refusing to claim an existing foreign cache leaf");
+      }
+    }
+    auto written =
+        WriteJson(marker, base::DictValue()
+                              .Set("schema", 1)
+                              .Set("binding", location.binding)
+                              .Set("root", location.user_root.value()));
+    if (!written.has_value()) {
+      return base::unexpected(written.error());
+    }
+  }
+  auto owner = ReadJson(marker);
+  if (!owner.has_value() || owner->FindInt("schema") != 1 ||
+      !owner->FindString("binding") ||
+      *owner->FindString("binding") != location.binding ||
+      !owner->FindString("root") ||
+      *owner->FindString("root") != location.user_root.value()) {
+    return base::unexpected("Model-cache marker does not belong to this root");
+  }
+  return std::move(*lease);
+}
+
+Status VerifyFile(const base::FilePath& path, const ModelMember& member,
+                  bool hash, base::File* opened = nullptr) {
+  auto file = OpenData(path, O_RDONLY);
+  if (!file.has_value() || file->GetLength() < 0 ||
+      static_cast<uint64_t>(file->GetLength()) != member.bytes) {
+    return base::unexpected(
+        "Model data is missing, linked, or has changed size");
+  }
+  if (hash) {
+    std::array<uint8_t, crypto::hash::kSha256Size> digest;
+    if (!crypto::hash::HashFile(crypto::hash::kSha256, &*file, digest) ||
+        base::HexEncodeLower(digest) != member.sha256) {
+      return base::unexpected("Model data failed its compiled SHA-256 check");
+    }
+  }
+  if (opened) {
+    *opened = std::move(*file);
+  }
+  return {};
+}
+
+Status VerifyPack(const Location& location, const base::FilePath& directory,
+                  const ModelPack& pack, bool hash, bool partial = false) {
+  struct stat root;
+  if (lstat(directory.value().c_str(), &root) != 0 || !S_ISDIR(root.st_mode) ||
+      root.st_uid != geteuid()) {
+    return base::unexpected("Owned model directory is unavailable");
+  }
+  std::set<std::string> expected{kPackMarker};
+  for (const auto& member : pack.members) {
+    expected.insert(member.name);
+    if (partial && !base::PathExists(directory.AppendASCII(member.name))) {
+      continue;
+    }
+    if (!partial) {
+      auto checked =
+          VerifyFile(directory.AppendASCII(member.name), member, hash);
+      if (!checked.has_value()) {
+        return checked;
+      }
+    }
+  }
+  base::FileEnumerator files(directory, false,
+                             base::FileEnumerator::FILES |
+                                 base::FileEnumerator::DIRECTORIES |
+                                 base::FileEnumerator::SHOW_SYM_LINKS);
+  for (auto path = files.Next(); !path.empty(); path = files.Next()) {
+    if (!expected.contains(path.BaseName().value())) {
+      return base::unexpected("Unknown model-cache files are preserved");
+    }
+    auto file = OpenData(path, O_RDONLY);
+    if (!file.has_value()) {
+      return base::unexpected(file.error());
+    }
+  }
+  return {};
+}
+
+base::expected<Inventory, std::string> InventoryLocked(const Location& location,
+                                                       bool verify) {
+  Inventory result;
+  std::set<std::string> reserved_names;
+  std::set<std::string> temporary_names;
+  base::FileEnumerator all(location.leaf, true,
+                           base::FileEnumerator::FILES |
+                               base::FileEnumerator::DIRECTORIES |
+                               base::FileEnumerator::SHOW_SYM_LINKS);
+  for (auto path = all.Next(); !path.empty(); path = all.Next()) {
+    struct stat info;
+    if (lstat(path.value().c_str(), &info) != 0 || info.st_uid != geteuid() ||
+        S_ISLNK(info.st_mode) ||
+        (!S_ISDIR(info.st_mode) && !S_ISREG(info.st_mode)) ||
+        (S_ISREG(info.st_mode) &&
+         (info.st_nlink != 1 || info.st_mode & 0111))) {
+      return base::unexpected(
+          "Ambiguous or linked model-cache data is preserved");
+    }
+    if (S_ISREG(info.st_mode)) {
+      if (info.st_size < 0 || static_cast<uint64_t>(info.st_size) >
+                                  kMaximumCacheBytes - result.stored_bytes) {
+        return base::unexpected(
+            "Model cache exceeds the 4 GiB logical byte limit");
+      }
+      result.stored_bytes += info.st_size;
+    }
+  }
+  base::FileEnumerator top(location.leaf, false,
+                           base::FileEnumerator::FILES |
+                               base::FileEnumerator::DIRECTORIES |
+                               base::FileEnumerator::SHOW_SYM_LINKS);
+  for (auto path = top.Next(); !path.empty(); path = top.Next()) {
+    const auto name = path.BaseName().value();
+    if (name == kMarker || name == kLease) {
+      continue;
+    }
+    if (name.starts_with("pack-") && DigestName(name.substr(5))) {
+      auto record = ReadJson(path.AppendASCII(kPackMarker));
+      if (!record.has_value()) {
+        return base::unexpected(record.error());
+      }
+      auto pack = ParseRecord(location, *record);
+      if (!pack.has_value() || pack->archive_sha256 != name.substr(5)) {
+        return base::unexpected("Installed model ownership is inconsistent");
+      }
+      const auto* current = CatalogPack(pack->id);
+      const bool recognized =
+          current && current->archive_sha256 == pack->archive_sha256;
+      auto valid =
+          VerifyPack(location, path, recognized ? *current : *pack, verify);
+      result.packs.push_back({pack->id, pack->archive_sha256,
+                              valid.has_value()
+                                  ? (recognized ? "ready" : "old version")
+                                  : "error: " + valid.error(),
+                              pack->unpacked_bytes, recognized});
+    } else if (name.starts_with("reserve-") && name.ends_with(".json")) {
+      auto record = ReadJson(path);
+      if (!record.has_value()) {
+        return base::unexpected(record.error());
+      }
+      auto pack = ParseRecord(location, *record);
+      const auto* archive = record->FindString("download");
+      const auto* staging = record->FindString("staging");
+      if (!pack.has_value() || !archive || !DataName(*archive) || !staging ||
+          !DataName(*staging)) {
+        return base::unexpected(
+            "Interrupted model reservation is unrecognized");
+      }
+      uint64_t present = 0;
+      int64_t archive_size = 0;
+      if (base::PathExists(location.leaf.AppendASCII(*archive))) {
+        auto file = OpenData(location.leaf.AppendASCII(*archive), O_RDONLY);
+        if (!file.has_value() || (archive_size = file->GetLength()) < 0 ||
+            static_cast<uint64_t>(archive_size) > pack->archive_bytes) {
+          return base::unexpected(
+              "Partial model archive exceeds its reservation");
+        }
+        present += archive_size;
+      }
+      const auto staged = location.leaf.AppendASCII(*staging);
+      if (!archive->starts_with("download-") || !archive->ends_with(".zip") ||
+          !staging->starts_with("staging-") ||
+          !reserved_names.insert(*archive).second ||
+          !reserved_names.insert(*staging).second) {
+        return base::unexpected("Model reservation paths are ambiguous");
+      }
+      if (base::PathExists(staged)) {
+        for (const auto& member : pack->members) {
+          const auto file_path = staged.AppendASCII(member.name);
+          if (!base::PathExists(file_path)) {
+            continue;
+          }
+          auto file = OpenData(file_path, O_RDONLY);
+          const auto size = file.has_value() ? file->GetLength() : -1;
+          if (size < 0 || static_cast<uint64_t>(size) > member.bytes) {
+            return base::unexpected(
+                "Staged model member exceeds its reservation");
+          }
+          present += size;
+        }
+      }
+      if (base::PathExists(PackPath(location, pack->archive_sha256))) {
+        auto committed = ReadJson(
+            PackPath(location, pack->archive_sha256).AppendASCII(kPackMarker));
+        if (!committed.has_value()) {
+          return base::unexpected(
+              "A committed model cleanup needs ownership review");
+        }
+        auto owned = ParseRecord(location, *committed);
+        if (!owned.has_value() || owned->id != pack->id ||
+            owned->archive_sha256 != pack->archive_sha256) {
+          return base::unexpected(
+              "Committed model cleanup ownership is inconsistent");
+        }
+        present += pack->unpacked_bytes;
+      }
+      const uint64_t maximum = pack->archive_bytes + pack->unpacked_bytes;
+      if (maximum < present ||
+          maximum - present > kMaximumCacheBytes - result.reserved_bytes) {
+        return base::unexpected("Model reservation accounting is invalid");
+      }
+      result.reserved_bytes += maximum - present;
+      result.packs.push_back({pack->id, pack->archive_sha256,
+                              "interrupted or staging", maximum, false});
+    } else {
+      temporary_names.insert(name);
+    }
+  }
+  for (const auto& name : temporary_names) {
+    if (!reserved_names.contains(name)) {
+      return base::unexpected(
+          "Unowned files in the marked model cache are preserved");
+    }
+  }
+  if (result.reserved_bytes > kMaximumCacheBytes - result.stored_bytes) {
+    return base::unexpected("Installed, reserved and staged data exceed 4 GiB");
+  }
+  return result;
+}
+
+class MemberWriter final : public zip::WriterDelegate {
+ public:
+  MemberWriter(base::File file, uint64_t maximum,
+               const std::shared_ptr<std::atomic_bool>& cancelled)
+      : file_(std::move(file)), maximum_(maximum), cancelled_(cancelled) {}
+  bool WriteBytes(base::span<const uint8_t> bytes) override {
+    if (cancelled_->load() || bytes.size() > maximum_ - written_ ||
+        !file_.WriteAtCurrentPosAndCheck(bytes)) {
+      return false;
+    }
+    written_ += bytes.size();
+    return true;
+  }
+  bool Complete() { return written_ == maximum_ && file_.Flush(); }
+
+ private:
+  base::File file_;
+  uint64_t maximum_;
+  uint64_t written_ = 0;
+  std::shared_ptr<std::atomic_bool> cancelled_;
+};
