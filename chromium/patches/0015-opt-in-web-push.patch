@@ -0,0 +1,105 @@
+#include "chrome/browser/push_messaging/stainless_push_journal.h"
+
+#include "base/containers/span.h"
+#include "base/json/json_writer.h"
+#include "base/strings/string_number_conversions.h"
+#include "crypto/sha2.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace stainless {
+namespace {
+
+std::string Id(int id) {
+  return base::HexEncodeLower(base::as_byte_span(
+      crypto::SHA256HashString("fictional-push-" + base::NumberToString(id))));
+}
+
+using Action = PushDeliveryDecision::Action;
+
+TEST(StainlessPushJournalTest, RestartCannotResetThePoisonMessageBudget) {
+  PushDeliveryJournal journal;
+  const auto now = base::Time::Now();
+  for (int attempt = 0; attempt < 3; ++attempt) {
+    EXPECT_EQ(journal.Admit(Id(1), Id(2), now).action, Action::kDispatch);
+    auto restored = PushDeliveryJournal::Deserialize(journal.Serialize(), now);
+    ASSERT_TRUE(restored.has_value());
+    journal = std::move(*restored);
+  }
+  const auto exhausted = journal.Admit(Id(1), Id(2), now);
+  EXPECT_EQ(exhausted.action, Action::kReplayAck);
+  EXPECT_EQ(exhausted.ack, PushAck::kNotDelivered);
+  EXPECT_EQ(journal.Admit(Id(3), Id(4), now).action, Action::kDispatch);
+}
+
+TEST(StainlessPushJournalTest, LostAckIsReplayedWithoutDispatchUntilExpiry) {
+  PushDeliveryJournal journal;
+  const auto now = base::Time::Now();
+  journal.Complete(Id(1), Id(2), PushAck::kHandled, now);
+  auto restored = PushDeliveryJournal::Deserialize(journal.Serialize(), now);
+  ASSERT_TRUE(restored.has_value());
+  EXPECT_EQ(
+      restored->Admit(Id(1), Id(2), now + base::Days(7) - base::Milliseconds(1))
+          .action,
+      Action::kReplayAck);
+  EXPECT_EQ(restored->Admit(Id(1), Id(2), now + base::Days(7)).action,
+            Action::kDispatch);
+}
+
+TEST(StainlessPushJournalTest, UpdatingAnOutcomeCannotExtendItsRetention) {
+  PushDeliveryJournal journal;
+  const auto now = base::Time::Now();
+  journal.Complete(Id(1), Id(2), PushAck::kHandled, now);
+  journal.Complete(Id(1), Id(2), PushAck::kNotDelivered, now + base::Days(6));
+  EXPECT_EQ(journal.Admit(Id(1), Id(2), now + base::Days(6)).ack,
+            PushAck::kNotDelivered);
+  EXPECT_EQ(journal.Admit(Id(1), Id(2), now + base::Days(7)).action,
+            Action::kDispatch);
+}
+
+TEST(StainlessPushJournalTest, CapacityEvictsOldestAndNeverBlocksNewOrigins) {
+  PushDeliveryJournal journal;
+  const auto now = base::Time::Now();
+  for (int message = 0; message <= 4096; ++message) {
+    journal.Complete(Id(message), Id(9000), PushAck::kHandled,
+                     now + base::Milliseconds(message));
+  }
+  const auto encoded = journal.Serialize();
+  ASSERT_TRUE(encoded.FindList("terminals"));
+  EXPECT_EQ(encoded.FindList("terminals")->size(), 4096u);
+  EXPECT_LE(base::WriteJson(*encoded.FindList("terminals"))->size(), 1048576u);
+  EXPECT_EQ(journal.capacity_evictions(), 1u);
+  EXPECT_EQ(journal.Admit(Id(4096), Id(9000), now + base::Seconds(5)).action,
+            Action::kReplayAck);
+  EXPECT_EQ(journal.Admit(Id(0), Id(9000), now + base::Seconds(5)).action,
+            Action::kDispatch);
+}
+
+TEST(StainlessPushJournalTest, PendingBoundAgeAndRevocationAreExplicit) {
+  PushDeliveryJournal journal;
+  const auto now = base::Time::Now();
+  for (int message = 0; message < 64; ++message) {
+    EXPECT_EQ(journal.Admit(Id(message), Id(9000), now).action,
+              Action::kDispatch);
+  }
+  EXPECT_EQ(journal.Admit(Id(64), Id(9000), now).action, Action::kBackpressure);
+  const auto expired = journal.Admit(Id(0), Id(9000), now + base::Seconds(120));
+  EXPECT_EQ(expired.action, Action::kReplayAck);
+  EXPECT_EQ(expired.ack, PushAck::kNotDelivered);
+  EXPECT_EQ(journal.Admit(Id(64), Id(9000), now + base::Seconds(120)).action,
+            Action::kDispatch);
+  journal.RemoveBinding(Id(9000));
+  EXPECT_EQ(journal.Admit(Id(0), Id(9000), now + base::Seconds(120)).action,
+            Action::kDispatch);
+}
+
+TEST(StainlessPushJournalTest, CorruptPersistedOutcomesAreNotSuccessDefaults) {
+  PushDeliveryJournal journal;
+  journal.Complete(Id(1), Id(2), PushAck::kHandled, base::Time::Now());
+  auto encoded = journal.Serialize();
+  encoded.FindList("terminals")->front().GetDict().Set("ack", 999);
+  EXPECT_FALSE(
+      PushDeliveryJournal::Deserialize(encoded, base::Time::Now()).has_value());
+}
+
+}  // namespace
+}  // namespace stainless
