+// Copyright 2026 Synctune Open
+
+#ifndef CHROME_BROWSER_UI_WEBUI_SETTINGS_STAINLESS_LOCAL_SERVICES_HANDLER_H_
+#define CHROME_BROWSER_UI_WEBUI_SETTINGS_STAINLESS_LOCAL_SERVICES_HANDLER_H_
+
+#include "chrome/browser/ui/webui/settings/settings_page_ui_handler.h"
+
+namespace settings {
+
+class StainlessLocalServicesHandler : public SettingsPageUIHandler {
+ public:
+  StainlessLocalServicesHandler();
+  ~StainlessLocalServicesHandler() override;
+
+  void RegisterMessages() override;
+  void OnJavascriptAllowed() override {}
