+  )JS"));
+  ASSERT_NO_FATAL_FAILURE(Notify("owned-message-after-unsubscribe"));
+  ASSERT_TRUE(base::test::RunUntil([&] { return Acks(102) == 1; }));
+  EXPECT_EQ(1, content::EvalJs(contents(), "window.receivedPush.length"));
