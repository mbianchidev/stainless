diff --git a/chrome/browser/ui/webui/settings/stainless_local_services_handler.cc b/chrome/browser/ui/webui/settings/stainless_local_services_handler.cc
new file mode 100644
index 0000000000000000000000000000000000000000..1cd19ab00ede1decf57c54d42a11583126e8a679
--- /dev/null
+++ b/chrome/browser/ui/webui/settings/stainless_local_services_handler.cc
@@ -0,0 +1,139 @@
+// Copyright 2026 Synctune Open
+
+#include "chrome/browser/ui/webui/settings/stainless_local_services_handler.h"
+
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/push_messaging/stainless_push_messaging_service.h"
+#include "chrome/common/webui_url_constants.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_ui.h"
+#include "url/origin.h"
+
+namespace settings {
+namespace {
+
+base::DictValue UnavailableStatus() {
+  return base::DictValue()
+      .Set("available", false)
+      .Set("enabled", false)
+      .Set("connected", false)
+      .Set("configurationPending", false)
+      .Set("status", "Unavailable in this browsing mode")
+      .Set("error", "")
+      .Set("connection", "")
+      .Set("publisher", "")
+      .Set("subscriptions", 0)
+      .Set("queued", 0)
+      .Set("backpressured", false)
+      .Set("terminalCapacityEvictions", "0");
+}
+
+stainless::PushMessagingService* Provider(content::WebUI* ui) {
+  return stainless::GetPushMessagingService(
+      Profile::FromBrowserContext(ui->GetWebContents()->GetBrowserContext()));
+}
+
+}  // namespace
+
+StainlessLocalServicesHandler::StainlessLocalServicesHandler() = default;
+StainlessLocalServicesHandler::~StainlessLocalServicesHandler() = default;
+
+void StainlessLocalServicesHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "stainlessGetLocalServiceStatus",
+      base::BindRepeating(&StainlessLocalServicesHandler::GetStatus,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "stainlessConfigurePush",
+      base::BindRepeating(&StainlessLocalServicesHandler::ConfigurePush,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "stainlessResetPush",
+      base::BindRepeating(&StainlessLocalServicesHandler::ResetPush,
+                          base::Unretained(this)));
+}
+
+bool StainlessLocalServicesHandler::ValidateRequest(const base::ListValue& args,
+                                                    size_t count) {
+  if (args.size() != count || !args[0].is_string()) {
+    LOG(ERROR) << "Stainless Local Services: invalid Settings request";
+    return false;
+  }
+  AllowJavascript();
+  auto* frame = web_ui()->GetWebContents()->GetPrimaryMainFrame();
+  if (!frame || !frame->IsActive() || frame->IsErrorDocument() ||
+      frame->GetLastCommittedOrigin() !=
+          url::Origin::Create(GURL(chrome::kChromeUISettingsURL))) {
+    LOG(ERROR) << "Stainless Local Services: untrusted Settings document";
+    RejectJavascriptCallback(
+        args[0], base::Value("A valid native Settings page is required"));
+    return false;
+  }
+  return true;
+}
+
+void StainlessLocalServicesHandler::GetStatus(const base::ListValue& args) {
+  if (!ValidateRequest(args, 1)) {
+    return;
+  }
+  auto* provider = Provider(web_ui());
+  ResolveJavascriptCallback(
+      args[0], provider ? provider->GetStatus() : UnavailableStatus());
+}
+
+void StainlessLocalServicesHandler::ConfigurePush(const base::ListValue& args) {
+  if (!ValidateRequest(args, 2)) {
+    return;
+  }
+  const auto* configuration = args[1].GetIfDict();
+  const auto enabled =
+      configuration ? configuration->FindBool("enabled") : std::nullopt;
+  const auto consent =
+      configuration ? configuration->FindBool("consent") : std::nullopt;
+  const auto* connection =
+      configuration ? configuration->FindString("connection") : nullptr;
+  const auto* publisher =
+      configuration ? configuration->FindString("publisher") : nullptr;
+  if (!configuration || configuration->size() != 4 || !enabled || !consent ||
+      !connection || !publisher || (*enabled && !*consent)) {
+    LOG(ERROR) << "Stainless Local Services: invalid setup or missing consent";
+    RejectJavascriptCallback(
+        args[0], base::Value("Explicit server trust consent is required"));
+    return;
+  }
+  auto* provider = Provider(web_ui());
+  if (!provider) {
+    RejectJavascriptCallback(
+        args[0],
+        base::Value("Push setup is unavailable in this browsing mode"));
+    return;
+  }
+  const auto result =
+      provider->Configure(GURL(*connection), GURL(*publisher), *enabled);
+  if (!result) {
+    RejectJavascriptCallback(args[0], base::Value(result.error()));
+    return;
+  }
+  ResolveJavascriptCallback(args[0], provider->GetStatus());
+}
+
+void StainlessLocalServicesHandler::ResetPush(const base::ListValue& args) {
+  if (!ValidateRequest(args, 2)) {
+    return;
+  }
+  auto* provider = Provider(web_ui());
+  if (!args[1].is_bool() || !args[1].GetBool() || !provider ||
+      provider->GetStatus().FindBool("available") != true) {
+    RejectJavascriptCallback(
+        args[0],
+        base::Value("Confirm resetting registrations in an eligible profile"));
+    return;
+  }
+  provider->ResetRegistrations();
+  ResolveJavascriptCallback(args[0], provider->GetStatus());
+}
+
+}  // namespace settings
