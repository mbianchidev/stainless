diff --git a/chrome/browser/push_messaging/stainless_push_crypto.cc b/chrome/browser/push_messaging/stainless_push_crypto.cc
new file mode 100644
index 0000000000000000000000000000000000000000..e3466167155e328decf2708f5bcbe82e2eb9ce9f
--- /dev/null
+++ b/chrome/browser/push_messaging/stainless_push_crypto.cc
@@ -0,0 +1,54 @@
+#include "chrome/browser/push_messaging/stainless_push_crypto.h"
+
+#include <array>
+
+#include "base/numerics/byte_conversions.h"
+#include "base/strings/string_view_util.h"
+#include "components/gcm_driver/crypto/gcm_message_cryptographer.h"
+#include "crypto/kex.h"
+#include "third_party/boringssl/src/include/openssl/mem.h"
+
+namespace stainless {
+
+base::expected<std::string, PushDecryptionError> DecryptPushPayload(
+    base::span<const uint8_t> body,
+    const crypto::keypair::PrivateKey& recipient,
+    std::string_view auth_secret) {
+  constexpr size_t kHeaderBytes = 16 + 4 + 1 + 65;
+  if (body.size() < kHeaderBytes + 17 || body.size() > 16384 ||
+      body[20] != 65 || body[21] != 4) {
+    return base::unexpected(PushDecryptionError::kMalformedPayload);
+  }
+  const uint32_t record_size = base::U32FromBigEndian(body.subspan<16, 4>());
+  if (body.size() - kHeaderBytes > record_size) {
+    return base::unexpected(PushDecryptionError::kMalformedPayload);
+  }
+  if (!recipient.IsEcP256() || auth_secret.size() != 16) {
+    return base::unexpected(PushDecryptionError::kInvalidKey);
+  }
+  auto sender =
+      crypto::keypair::PublicKey::FromEcP256Point(body.subspan<21, 65>());
+  if (!sender) {
+    return base::unexpected(PushDecryptionError::kInvalidKey);
+  }
+  std::array<uint8_t, 32> shared_secret;
+  crypto::kex::EcdhP256(*sender, recipient, shared_secret);
+  const auto recipient_public = recipient.ToUncompressedX962Point();
+  gcm::GCMMessageCryptographer cryptographer(
+      gcm::GCMMessageCryptographer::Version::DRAFT_08);
+  std::string plaintext;
+  const bool authenticated =
+      cryptographer.Decrypt(base::as_string_view(base::span(recipient_public)),
+                            base::as_string_view(body.subspan<21, 65>()),
+                            base::as_string_view(base::span(shared_secret)),
+                            auth_secret, base::as_string_view(body.first<16>()),
+                            base::as_string_view(body.subspan(kHeaderBytes)),
+                            record_size, &plaintext);
+  OPENSSL_cleanse(shared_secret.data(), shared_secret.size());
+  if (!authenticated) {
+    return base::unexpected(PushDecryptionError::kAuthenticationFailed);
+  }
+  return plaintext;
+}
+
+}  // namespace stainless
diff --git a/chrome/browser/push_messaging/stainless_push_crypto.h b/chrome/browser/push_messaging/stainless_push_crypto.h
new file mode 100644
index 0000000000000000000000000000000000000000..22ea50b5c2c108b6a86706ac78108742b901474d
