@@ -0,0 +1,275 @@
+// Copyright 2026 Synctune Open
+
+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import 'chrome://resources/cr_elements/cr_checkbox/cr_checkbox.js';
+import 'chrome://resources/cr_elements/cr_dialog/cr_dialog.js';
+import 'chrome://resources/cr_elements/cr_input/cr_input.js';
+import '../settings_page/settings_section.js';
+
+import type {CrDialogElement} from 'chrome://resources/cr_elements/cr_dialog/cr_dialog.js';
+import type {CrInputElement} from 'chrome://resources/cr_elements/cr_input/cr_input.js';
+import {getCss as getCrSharedStyle} from 'chrome://resources/cr_elements/cr_shared_style_lit.css.js';
+import {sendWithPromise} from 'chrome://resources/js/cr.js';
+import {CrLitElement, css} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import {loadTimeData} from '../i18n_setup.js';
+import {routes} from '../route.js';
+import {RouteObserverMixinLit, Router} from '../router.js';
+import type {Route} from '../router.js';
+import {getSearchManager} from '../search_settings.js';
+import type {SettingsPlugin} from '../settings_main/settings_plugin.js';
+import {getCss as getSettingsSharedLit} from '../settings_shared_lit.css.js';
+
+import {getHtml} from './local_services_page.html.js';
+
+interface PushStatus {
+  available: boolean;
+  enabled: boolean;
+  connected: boolean;
+  configurationPending: boolean;
+  status: string;
+  error: string;
+  connection: string;
+  publisher: string;
+  subscriptions: number;
+  queued: number;
+  backpressured: boolean;
+  terminalCapacityEvictions: string;
+}
+
+export interface SettingsLocalServicesPageElement {
+  $: {
+    connection: CrInputElement,
+    publisher: CrInputElement,
+    resetDialog: CrDialogElement,
+    error: HTMLElement,
+  };
+}
+
+const Base = RouteObserverMixinLit(CrLitElement);
+
+export class SettingsLocalServicesPageElement extends Base implements
+    SettingsPlugin {
+  static get is() {
+    return 'settings-local-services-page';
+  }
+
+  static override get styles() {
+    return [
+      getCrSharedStyle(),
+      getSettingsSharedLit(),
+      css`
+        .content { padding: 20px; }
+        cr-input, cr-checkbox, .actions, .status { margin-block: 16px; }
+        .actions { display: flex; flex-wrap: wrap; gap: 12px; }
+        .notice { color: var(--cr-secondary-text-color); }
+        #error { color: var(--cr-primary-text-color); }
+      `,
+    ];
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      status_: {type: Object},
+      connection_: {type: String},
+      publisher_: {type: String},
+      consent_: {type: Boolean},
+      busy_: {type: Boolean},
+      error_: {type: String},
+    };
+  }
+
+  protected accessor status_: PushStatus|null = null;
+  protected accessor connection_: string = '';
+  protected accessor publisher_: string = '';
+  protected accessor consent_: boolean = false;
+  protected accessor busy_: boolean = false;
+  protected accessor error_: string = '';
+  private edited_: boolean = false;
+  private request_: number = 0;
+  private timer_: number|null = null;
+
+  override connectedCallback() {
+    super.connectedCallback();
+    if (Router.getInstance().getCurrentRoute() === routes.LOCAL_SERVICES) {
+      void this.refresh_();
+    }
+  }
+
+  override disconnectedCallback() {
+    super.disconnectedCallback();
+    ++this.request_;
+    this.stopPolling_();
+  }
+
+  override currentRouteChanged(route: Route) {
+    this.stopPolling_();
+    if (route === routes.LOCAL_SERVICES && this.isConnected) {
+      void this.refresh_();
+    }
+  }
+
+  private stopPolling_() {
+    if (this.timer_ !== null) {
+      window.clearTimeout(this.timer_);
+      this.timer_ = null;
+    }
+  }
+
+  private schedulePoll_() {
+    this.stopPolling_();
+    if (this.isConnected &&
+        Router.getInstance().getCurrentRoute() === routes.LOCAL_SERVICES) {
+      this.timer_ = window.setTimeout(() => void this.refresh_(), 1000);
+    }
+  }
+
+  private updateStatus_(status: PushStatus) {
+    this.status_ = status;
+    this.busy_ = status.configurationPending;
+    if (!this.edited_) {
+      this.connection_ = status.connection;
+      this.publisher_ = status.publisher;
+    }
+  }
+
+  private async refresh_() {
+    const request = ++this.request_;
+    try {
+      const status = await sendWithPromise<PushStatus>(
+          'stainlessGetLocalServiceStatus');
+      if (request !== this.request_ || !this.isConnected) {
+        return;
+      }
+      this.updateStatus_(status);
+      this.schedulePoll_();
+    } catch (error) {
+      if (request === this.request_ && this.isConnected) {
+        this.error_ = String(error);
+        this.busy_ = false;
+      }
+    }
+  }
+
+  protected onConnectionValueChanged_(event: CustomEvent<{value: string}>) {
+    if (this.connection_ !== event.detail.value) {
+      this.edited_ = true;
+      this.consent_ = false;
+      this.connection_ = event.detail.value;
+    }
+  }
+
+  protected onPublisherValueChanged_(event: CustomEvent<{value: string}>) {
+    if (this.publisher_ !== event.detail.value) {
+      this.edited_ = true;
+      this.consent_ = false;
+      this.publisher_ = event.detail.value;
+    }
+  }
+
+  protected onConsentCheckedChanged_(event: CustomEvent<{value: boolean}>) {
+    this.consent_ = event.detail.value;
+  }
+
+  protected canApply_(): boolean {
+    return !!this.status_?.available && !this.busy_ && this.consent_ &&
+        this.connection_.trim().length > 0 &&
+        this.publisher_.trim().length > 0;
+  }
+
+  protected async onApplyClick_() {
+    if (!this.canApply_()) {
+      return;
+    }
+    if (!this.$.connection.validate() || !this.$.publisher.validate()) {
+      this.error_ = loadTimeData.getString('stainlessPushUrlError');
+      await this.updateComplete;
+      this.$.error.focus();
+      return;
+    }
+    await this.configure_(true);
+  }
+
+  protected async onDisableClick_() {
+    await this.configure_(false);
+  }
+
+  private async configure_(enabled: boolean) {
+    this.stopPolling_();
+    const request = ++this.request_;
+    this.busy_ = true;
+    this.error_ = '';
+    try {
+      const status = await sendWithPromise<PushStatus>(
+          'stainlessConfigurePush', {
+            enabled,
+            consent: enabled && this.consent_,
+            connection: enabled ? this.connection_.trim() :
+                                  this.status_!.connection,
+            publisher: enabled ? this.publisher_.trim() :
+                                 this.status_!.publisher,
+          });
+      if (request !== this.request_ || !this.isConnected) {
+        return;
+      }
+      this.edited_ = false;
+      this.consent_ = false;
+      this.updateStatus_(status);
+      this.schedulePoll_();
+    } catch (error) {
+      if (request === this.request_ && this.isConnected) {
+        this.busy_ = false;
+        this.error_ = String(error);
+        await this.updateComplete;
+        this.$.error.focus();
+      }
+    }
+  }
+
+  protected onResetClick_() {
+    this.$.resetDialog.showModal();
+  }
+
+  protected onCancelResetClick_() {
+    this.$.resetDialog.close();
+  }
+
+  protected async onConfirmResetClick_() {
+    this.$.resetDialog.close();
+    this.stopPolling_();
+    const request = ++this.request_;
+    this.busy_ = true;
+    this.error_ = '';
+    try {
+      const status =
+          await sendWithPromise<PushStatus>('stainlessResetPush', true);
+      if (request === this.request_ && this.isConnected) {
+        this.updateStatus_(status);
+        this.schedulePoll_();
+      }
+    } catch (error) {
+      if (request === this.request_ && this.isConnected) {
+        this.busy_ = false;
+        this.error_ = String(error);
+      }
+    }
+  }
+
+  async searchContents(query: string) {
+    const result = await getSearchManager().search(query, this);
+    return result.getSearchResult();
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-local-services-page': SettingsLocalServicesPageElement;
+  }
+}
+
