+// A controlled protocol peer, not the independent tagged Autopush fixture.
+class PushPeer final : public net::test_server::WebSocketHandler {
+ public:
+  PushPeer(scoped_refptr<net::test_server::WebSocketConnection> connection,
+           GURL publisher,
+           Opened opened,
+           Received received);
+  ~PushPeer() override;
+
+  void OnHandshakeComplete() override {
+    auto runner = base::SingleThreadTaskRunner::GetCurrentDefault();
+    opened_.Run(
+        base::BindPostTask(
+            runner,
+            base::BindRepeating(
+                [](scoped_refptr<net::test_server::WebSocketConnection> socket,
+                   std::string message) { socket->SendTextMessage(message); },
+                connection())),
+        base::BindPostTask(
+            runner,
+            base::BindRepeating(
+                [](scoped_refptr<net::test_server::WebSocketConnection>
+                       socket) { socket->DisconnectAfterAnyWritesDone(); },
+                connection())));
+  }
+
+  void OnTextMessage(std::string_view text) override {
+    auto decoded = base::JSONReader::Read(text, base::JSON_PARSE_RFC);
+    CHECK(decoded && decoded->is_dict());
+    auto& message = decoded->GetDict();
+    received_.Run(message.Clone());
+    const auto* type = message.FindString("messageType");
+    if (message.empty()) {
+      Reply(base::DictValue());
+    } else if (type && *type == "hello") {
+      Reply(base::DictValue()
+                .Set("messageType", "hello")
+                .Set("status", 200)
+                .Set("use_webpush", true)
+                .Set("uaid", "69caf57cf63e4fb7bd7191541cc8deac"));
+    } else if (type && *type == "register") {
+      const auto* channel = message.FindString("channelID");
+      CHECK(channel);
+      Reply(base::DictValue()
+                .Set("messageType", "register")
+                .Set("status", 200)
+                .Set("channelID", *channel)
+                .Set("pushEndpoint", publisher_
+                                         .Resolve("/wpush/" +
+                                                  base::Uuid::GenerateRandomV4()
+                                                      .AsLowercaseString() +
+                                                  "/" + *channel)
+                                         .spec()));
+    }
+  }
+
+ private:
+  void Reply(base::DictValue message) {
+    auto json = base::WriteJson(message);
+    CHECK(json);
+    connection()->SendTextMessage(*json);
+  }
+
+  const GURL publisher_;
+  const Opened opened_;
+  const Received received_;
+};
