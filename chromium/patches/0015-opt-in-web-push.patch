+              std::move(callback).Run(true, {}, {});
+            } else if (status == blink::ServiceWorkerStatusCode::kOk &&
+                       values.size() == 2) {
+              std::move(callback).Run(true, values[0], values[1]);
+            } else {
+              std::move(callback).Run(false, {}, {});
