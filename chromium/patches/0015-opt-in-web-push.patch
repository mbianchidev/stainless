@@ -0,0 +1,27 @@
+#ifndef CHROME_BROWSER_PUSH_MESSAGING_STAINLESS_PUSH_CRYPTO_H_
+#define CHROME_BROWSER_PUSH_MESSAGING_STAINLESS_PUSH_CRYPTO_H_
+
+#include <string>
+#include <string_view>
+
+#include "base/containers/span.h"
+#include "base/types/expected.h"
+#include "crypto/keypair.h"
+
+namespace stainless {
+
+enum class PushDecryptionError {
+  kMalformedPayload,
+  kInvalidKey,
+  kAuthenticationFailed,
+};
+
+// RFC 8291 section 4 requires one record and the full uncompressed P-256 key.
+base::expected<std::string, PushDecryptionError> DecryptPushPayload(
+    base::span<const uint8_t> body,
+    const crypto::keypair::PrivateKey& recipient,
+    std::string_view auth_secret);
+
+}  // namespace stainless
+
+#endif  // CHROME_BROWSER_PUSH_MESSAGING_STAINLESS_PUSH_CRYPTO_H_
diff --git a/chrome/browser/push_messaging/stainless_push_crypto_unittest.cc b/chrome/browser/push_messaging/stainless_push_crypto_unittest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..9f65119e357d1e5c39dd586848b6bc85b2ea6b52
--- /dev/null
+++ b/chrome/browser/push_messaging/stainless_push_crypto_unittest.cc
@@ -0,0 +1,60 @@
+#include "chrome/browser/push_messaging/stainless_push_crypto.h"
+
+#include <string>
+
+#include "base/base64url.h"
+#include "base/containers/span.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace stainless {
+namespace {
+
+std::string Decode(std::string_view encoded) {
+  std::string decoded;
+  EXPECT_TRUE(base::Base64UrlDecode(
+      encoded, base::Base64UrlDecodePolicy::DISALLOW_PADDING, &decoded));
+  return decoded;
+}
+
+TEST(StainlessPushCryptoTest, AuthenticatesThePublishedRfc8291Vector) {
+  // Public synthetic test material from RFC 8291 section 5, not a credential.
+  const auto scalar = Decode("q1dXpw3UpT5VOmu_cf_v6ih07Aems3njxI-JWgLcM94");
+  auto recipient = crypto::keypair::PrivateKey::FromEcP256PrivateScalar(
+      base::as_byte_span(scalar));
+  ASSERT_TRUE(recipient);
+  const auto secret = Decode("BTBZMqHH6r4Tts7J_aSIgg");
+  std::string payload = Decode(
+      "DGv6ra1nlYgDCS1FRnbzlwAAEABBBP4z9KsN6nGRTbVYI_c7VJSPQTBtkgcy27ml"
+      "mlMoZIIgDll6e3vCYLocInmYWAmS6TlzAC8wEqKK6PBru3jl7A_yl95bQpu6cVPT"
+      "pK4Mqgkf1CXztLVBSt2Ks3oZwbuwXPXLWyouBWLVWGNWQexSgSxsj_Qulcy4a-fN");
+  const auto plaintext =
+      DecryptPushPayload(base::as_byte_span(payload), *recipient, secret);
+  ASSERT_TRUE(plaintext.has_value());
+  EXPECT_EQ(*plaintext, "When I grow up, I want to be a watermelon");
+
+  payload.back() ^= 1;
+  EXPECT_EQ(DecryptPushPayload(base::as_byte_span(payload), *recipient, secret)
+                .error(),
+            PushDecryptionError::kAuthenticationFailed);
+}
+
+TEST(StainlessPushCryptoTest, RejectsMalformedHeadersAndNonCurvePoints) {
+  auto recipient = crypto::keypair::PrivateKey::GenerateEcP256();
+  const std::string secret(16, 's');
+  std::string payload(103, '\0');
+  EXPECT_EQ(DecryptPushPayload(base::as_byte_span(payload), recipient, secret)
+                .error(),
+            PushDecryptionError::kMalformedPayload);
+  payload[19] = 100;
+  payload[20] = 65;
+  payload[21] = 4;
+  EXPECT_EQ(DecryptPushPayload(base::as_byte_span(payload), recipient, secret)
+                .error(),
+            PushDecryptionError::kInvalidKey);
+  EXPECT_EQ(DecryptPushPayload(base::as_byte_span(payload), recipient, "short")
+                .error(),
+            PushDecryptionError::kInvalidKey);
+}
+
+}  // namespace
+}  // namespace stainless
diff --git a/chrome/browser/push_messaging/stainless_push_journal.cc b/chrome/browser/push_messaging/stainless_push_journal.cc
new file mode 100644
index 0000000000000000000000000000000000000000..779eeadb29c022e4df367494519a7ecb20314c1a
--- /dev/null
+++ b/chrome/browser/push_messaging/stainless_push_journal.cc
@@ -0,0 +1,217 @@
+#include "chrome/browser/push_messaging/stainless_push_journal.h"
+
+#include <algorithm>
+#include <limits>
+#include <optional>
+#include <utility>
+
+#include "base/check.h"
+#include "base/json/json_writer.h"
+#include "base/logging.h"
+#include "base/strings/string_number_conversions.h"
+
+namespace stainless {
+namespace {
+
+bool IsDigest(std::string_view value) {
+  return value.size() == 64 && std::ranges::all_of(value, [](char c) {
+           return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
+         });
+}
+
+std::optional<base::Time> ReadTime(const base::DictValue& value) {
+  const std::string* encoded = value.FindString("time");
+  int64_t milliseconds;
+  if (!encoded || !base::StringToInt64(*encoded, &milliseconds) ||
+      milliseconds < 0 || milliseconds > 253402300799999LL) {
+    return std::nullopt;
+  }
+  return base::Time::FromMillisecondsSinceUnixEpoch(milliseconds);
+}
+
+base::DictValue Entry(const std::string& message,
+                      const std::string& binding,
+                      base::Time when) {
+  return base::DictValue()
+      .Set("message", message)
+      .Set("binding", binding)
+      .Set("time", base::NumberToString(when.InMillisecondsSinceUnixEpoch()));
+}
+
+}  // namespace
+
+PushDeliveryJournal::PushDeliveryJournal() = default;
+PushDeliveryJournal::~PushDeliveryJournal() = default;
+PushDeliveryJournal::PushDeliveryJournal(PushDeliveryJournal&&) = default;
+PushDeliveryJournal& PushDeliveryJournal::operator=(PushDeliveryJournal&&) =
+    default;
+
+base::expected<PushDeliveryJournal, std::string>
+PushDeliveryJournal::Deserialize(const base::DictValue& value, base::Time now) {
+  const auto* attempts = value.FindList("attempts");
+  const auto* terminals = value.FindList("terminals");
+  const auto* evictions = value.FindString("capacity_evictions");
+  uint64_t eviction_count;
+  if (value.size() != 3 || !attempts || !terminals || !evictions ||
+      !base::StringToUint64(*evictions, &eviction_count) ||
+      attempts->size() > 64 || terminals->size() > 4096) {
+    return base::unexpected("Invalid Push delivery journal bounds");
+  }
+  const auto serialized = base::WriteJson(*terminals);
+  if (!serialized || serialized->size() > 1048576) {
+    return base::unexpected("Oversized Push terminal journal");
+  }
+  PushDeliveryJournal result;
+  result.capacity_evictions_ = eviction_count;
+  for (const auto& item : *attempts) {
+    const auto* entry = item.GetIfDict();
+    if (!entry || entry->size() != 4) {
+      return base::unexpected("Invalid Push attempt record");
+    }
+    const auto* message = entry->FindString("message");
+    const auto* binding = entry->FindString("binding");
+    const auto count = entry->FindInt("count");
+    const auto time = ReadTime(*entry);
+    if (!message || !binding || !IsDigest(*message) || !IsDigest(*binding) ||
+        !count || *count < 1 || *count > 3 || !time ||
+        !result.attempts_.emplace(*message, Attempt{*binding, *time, *count})
+             .second) {
+      return base::unexpected("Invalid or duplicate Push attempt");
+    }
+  }
+  for (const auto& item : *terminals) {
+    const auto* entry = item.GetIfDict();
+    if (!entry || entry->size() != 4) {
+      return base::unexpected("Invalid Push terminal record");
+    }
+    const auto* message = entry->FindString("message");
+    const auto* binding = entry->FindString("binding");
+    const auto ack = entry->FindInt("ack");
+    const auto time = ReadTime(*entry);
+    if (!message || !binding || !IsDigest(*message) || !IsDigest(*binding) ||
+        !ack || (*ack != 100 && *ack != 101 && *ack != 102) || !time ||
+        result.attempts_.contains(*message) ||
+        std::ranges::any_of(result.terminals_, [&](const auto& existing) {
+          return existing.message == *message;
+        })) {
+      return base::unexpected("Invalid or duplicate Push terminal outcome");
+    }
+    result.terminals_.push_back(
+        Terminal{*message, *binding, *time, static_cast<PushAck>(*ack)});
+  }
+  result.Prune(now);
+  return result;
+}
+
+base::ListValue PushDeliveryJournal::SerializeTerminals() const {
+  base::ListValue result;
+  for (const auto& terminal : terminals_) {
+    result.Append(Entry(terminal.message, terminal.binding, terminal.when)
+                      .Set("ack", static_cast<int>(terminal.ack)));
+  }
+  return result;
+}
+
+base::DictValue PushDeliveryJournal::Serialize() const {
+  base::ListValue attempts;
+  for (const auto& [message, attempt] : attempts_) {
+    attempts.Append(Entry(message, attempt.binding, attempt.first_seen)
+                        .Set("count", attempt.count));
+  }
+  return base::DictValue()
+      .Set("attempts", std::move(attempts))
+      .Set("terminals", SerializeTerminals())
+      .Set("capacity_evictions", base::NumberToString(capacity_evictions_));
+}
+
+void PushDeliveryJournal::Prune(base::Time now) {
+  std::erase_if(terminals_, [now](const auto& terminal) {
+    return now - terminal.when >= base::Days(7);
+  });
+  for (auto iterator = attempts_.begin(); iterator != attempts_.end();) {
+    if (now - iterator->second.first_seen < base::Seconds(120)) {
+      ++iterator;
+      continue;
+    }
+    auto expired = *iterator++;
+    Complete(expired.first, expired.second.binding, PushAck::kNotDelivered,
+             now);
+  }
+}
+
+PushDeliveryDecision PushDeliveryJournal::Admit(
+    const std::string& message_digest,
+    const std::string& binding_digest,
+    base::Time now) {
+  CHECK(IsDigest(message_digest));
+  CHECK(IsDigest(binding_digest));
+  Prune(now);
+  for (const auto& terminal : terminals_) {
+    if (terminal.message == message_digest) {
+      CHECK_EQ(terminal.binding, binding_digest);
+      return {PushDeliveryDecision::Action::kReplayAck, terminal.ack};
+    }
+  }
+  auto iterator = attempts_.find(message_digest);
+  if (iterator == attempts_.end()) {
+    if (attempts_.size() == 64) {
+      return {PushDeliveryDecision::Action::kBackpressure};
+    }
+    iterator =
+        attempts_.emplace(message_digest, Attempt{binding_digest, now, 0})
+            .first;
+  }
+  CHECK_EQ(iterator->second.binding, binding_digest);
+  if (iterator->second.count == 3) {
+    Complete(message_digest, binding_digest, PushAck::kNotDelivered, now);
+    return {PushDeliveryDecision::Action::kReplayAck, PushAck::kNotDelivered};
+  }
+  ++iterator->second.count;
+  return {PushDeliveryDecision::Action::kDispatch};
+}
+
+void PushDeliveryJournal::Complete(const std::string& message_digest,
+                                   const std::string& binding_digest,
+                                   PushAck ack,
+                                   base::Time now) {
+  CHECK(IsDigest(message_digest));
+  CHECK(IsDigest(binding_digest));
+  const auto attempt = attempts_.find(message_digest);
+  if (ack == PushAck::kNotDelivered && attempt != attempts_.end() &&
+      (attempt->second.count >= 3 ||
+       now - attempt->second.first_seen >= base::Seconds(120))) {
+    LOG(WARNING) << "Stainless Push: message discarded after its retry budget";
+  }
+  attempts_.erase(message_digest);
+  for (auto& terminal : terminals_) {
+    if (terminal.message == message_digest) {
+      CHECK_EQ(terminal.binding, binding_digest);
+      terminal.ack = ack;
+      return;
+    }
+  }
+  terminals_.push_back(Terminal{message_digest, binding_digest, now, ack});
+  while (terminals_.size() > 4096) {
+    terminals_.pop_front();
+    if (capacity_evictions_ != std::numeric_limits<uint64_t>::max()) {
+      ++capacity_evictions_;
+    }
+  }
+  while (base::WriteJson(SerializeTerminals()).value().size() > 1048576) {
+    terminals_.pop_front();
+    if (capacity_evictions_ != std::numeric_limits<uint64_t>::max()) {
+      ++capacity_evictions_;
+    }
+  }
+}
+
+void PushDeliveryJournal::RemoveBinding(const std::string& binding_digest) {
+  std::erase_if(attempts_, [&](const auto& item) {
+    return item.second.binding == binding_digest;
+  });
+  std::erase_if(terminals_, [&](const auto& item) {
+    return item.binding == binding_digest;
+  });
+}
+
+}  // namespace stainless
