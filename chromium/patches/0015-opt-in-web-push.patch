@@ -0,0 +1,76 @@
+#ifndef CHROME_BROWSER_PUSH_MESSAGING_STAINLESS_PUSH_JOURNAL_H_
+#define CHROME_BROWSER_PUSH_MESSAGING_STAINLESS_PUSH_JOURNAL_H_
+
+#include <cstdint>
+#include <deque>
+#include <map>
+#include <string>
+
+#include "base/time/time.h"
+#include "base/types/expected.h"
+#include "base/values.h"
+
+namespace stainless {
+
+enum class PushAck {
+  kHandled = 100,
+  kBadCiphertext = 101,
+  kNotDelivered = 102
+};
+
+struct PushDeliveryDecision {
+  enum class Action { kDispatch, kReplayAck, kBackpressure };
+  Action action;
+  PushAck ack = PushAck::kNotDelivered;
+};
+
+// State only: callers must durably encrypt/persist mutations before
+// dispatch/ACK.
+class PushDeliveryJournal {
+ public:
+  PushDeliveryJournal();
+  ~PushDeliveryJournal();
+  PushDeliveryJournal(PushDeliveryJournal&&);
+  PushDeliveryJournal& operator=(PushDeliveryJournal&&);
+  PushDeliveryJournal(const PushDeliveryJournal&) = delete;
+  PushDeliveryJournal& operator=(const PushDeliveryJournal&) = delete;
+
+  static base::expected<PushDeliveryJournal, std::string> Deserialize(
+      const base::DictValue& value,
+      base::Time now);
+  base::DictValue Serialize() const;
+
+  PushDeliveryDecision Admit(const std::string& message_digest,
+                             const std::string& binding_digest,
+                             base::Time now);
+  void Complete(const std::string& message_digest,
+                const std::string& binding_digest,
+                PushAck ack,
+                base::Time now);
+  void RemoveBinding(const std::string& binding_digest);
+  uint64_t capacity_evictions() const { return capacity_evictions_; }
+
+ private:
+  struct Attempt {
+    std::string binding;
+    base::Time first_seen;
+    int count = 0;
+  };
+  struct Terminal {
+    std::string message;
+    std::string binding;
+    base::Time when;
+    PushAck ack;
+  };
+
+  void Prune(base::Time now);
+  base::ListValue SerializeTerminals() const;
+
+  std::map<std::string, Attempt> attempts_;
+  std::deque<Terminal> terminals_;
+  uint64_t capacity_evictions_ = 0;
+};
+
+}  // namespace stainless
+
+#endif  // CHROME_BROWSER_PUSH_MESSAGING_STAINLESS_PUSH_JOURNAL_H_
