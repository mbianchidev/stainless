+std::unique_ptr<net::test_server::HttpResponse> FixturePage(
+    const net::test_server::HttpRequest& request) {
+  auto response = std::make_unique<net::test_server::BasicHttpResponse>();
+  response->set_code(net::HTTP_OK);
+  if (request.relative_url == "/fixture/") {
+    response->set_content_type("text/html");
+    response->set_content(R"HTML(
+      <!doctype html><title>Owned synthetic Push fixture</title>
+      <script>
+        window.receivedPush = [];
+        navigator.serviceWorker.addEventListener('message', event => {
+          if (typeof event.data === 'string') {
+            window.receivedPush.push(event.data);
+          }
+        });
+      </script>
+    )HTML");
+  } else if (request.relative_url == "/fixture/worker.js") {
+    response->set_content_type("text/javascript");
+    response->set_content(R"JS(
+      self.addEventListener('install', event => {
+        event.waitUntil(self.skipWaiting());
+      });
+      self.addEventListener('activate', event => {
+        event.waitUntil(self.clients.claim());
+      });
+      let nextMode = '';
+      let released = false;
+      let releaseGate;
+      self.addEventListener('message', event => {
+        if (event.data === 'feature-probe') {
+          event.source.postMessage({
+            featureProbe: true,
+            supported: 'onpushsubscriptionchange' in self
+          });
+        } else if (['hold', 'reject'].includes(event.data)) {
+          nextMode = event.data;
+          released = false;
+          event.source.postMessage({armed: event.data});
+        } else if (event.data === 'release') {
+          released = true;
+          if (releaseGate) releaseGate();
+        }
+      });
+      self.addEventListener('push', event => {
+        const text = event.data ? event.data.text() : 'payload-less';
+        const mode = nextMode;
+        nextMode = '';
+        event.waitUntil((async () => {
+          if (mode === 'hold' && !released) {
+            await new Promise(resolve => { releaseGate = resolve; });
+          }
+          if (mode === 'reject') {
+            for (const client of await self.clients.matchAll({
+              includeUncontrolled: true
+            })) {
+              client.postMessage('synthetic-rejected-event');
+            }
+            throw new Error('Owned synthetic rejected handler');
+          }
+          await self.registration.showNotification('Fictional Parcel', {
+            body: text, tag: 'synthetic-push'
+          });
+          for (const client of await self.clients.matchAll({
+            includeUncontrolled: true
+          })) {
+            client.postMessage(text);
+          }
+        })());
+      });
+    )JS");
+  } else {
+    return nullptr;
+  }
+  return response;
+}
