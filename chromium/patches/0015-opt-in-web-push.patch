+                        NotificationHandler::Type::WEB_PERSISTENT)
+                    .size());
+
+  const int previous_connections = connections_;
+  disconnect_.Run();
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return connections_ > previous_connections &&
+           service_->GetStatus().FindBool("connected") == true;
+  }));
+  EXPECT_EQ(endpoint_, content::EvalJs(contents(), R"JS(
+    (async () => (await window.registration.pushManager.getSubscription()).endpoint)()
+  )JS"));
+  ASSERT_NO_FATAL_FAILURE(Notify("owned-message-1"));
+  ASSERT_TRUE(base::test::RunUntil([&] { return Acks(100) == 2; }));
+  EXPECT_EQ(1, content::EvalJs(contents(), "window.receivedPush.length"));
+  EXPECT_EQ(true, content::EvalJs(contents(),
+                                  "window.pushSubscription.unsubscribe()"));
+  EXPECT_EQ(true, content::EvalJs(contents(), R"JS(
