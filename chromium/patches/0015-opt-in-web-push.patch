+// Copyright 2026 Synctune Open
+
+import {html} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import type {SettingsLocalServicesPageElement} from './local_services_page.js';
+
+export function getHtml(this: SettingsLocalServicesPageElement) {
+  // clang-format off
+  return html`<!--_html_template_start_-->
+    <settings-section page-title="$i18n{stainlessLocalServicesTitle}"
+        class="cr-centered-card-container">
+      <div class="content">
+        <p>$i18n{stainlessLocalServicesDescription}</p>
+        <h2>$i18n{stainlessLocalModelsTitle}</h2>
+        <p class="notice">$i18n{stainlessLocalModelsUnavailable}</p>
+      </div>
+    </settings-section>
+    <settings-section page-title="$i18n{stainlessPushTitle}"
+        class="cr-centered-card-container">
+      <div class="content">
+        <p>$i18n{stainlessPushDescription}</p>
+        <p id="privacy" class="notice">$i18n{stainlessPushPrivacy}</p>
+        <p id="changeWarning" class="notice">$i18n{stainlessPushChangeWarning}</p>
+        <p ?hidden="${!this.status_ || this.status_.available}">
+          $i18n{stainlessPushUnavailable}
+        </p>
+        <cr-input id="connection" type="url" required
+            label="$i18n{stainlessPushConnection}"
+            .value="${this.connection_}"
+            ?disabled="${!this.status_?.available || this.busy_}"
+            @value-changed="${this.onConnectionValueChanged_}">
+        </cr-input>
+        <cr-input id="publisher" type="url" required
+            label="$i18n{stainlessPushPublisher}"
+            .value="${this.publisher_}"
+            ?disabled="${!this.status_?.available || this.busy_}"
+            @value-changed="${this.onPublisherValueChanged_}">
+        </cr-input>
+        <cr-checkbox id="consent" .checked="${this.consent_}"
+            aria-describedby="privacy changeWarning"
+            ?disabled="${!this.status_?.available || this.busy_}"
+            @checked-changed="${this.onConsentCheckedChanged_}">
+          $i18n{stainlessPushConsent}
+        </cr-checkbox>
+        <div class="actions">
+          <cr-button id="apply" class="action-button"
+              ?disabled="${!this.canApply_()}"
+              @click="${this.onApplyClick_}">
+            ${this.status_?.enabled ?
+                html`$i18n{stainlessPushSave}` :
+                html`$i18n{stainlessPushEnable}`}
+          </cr-button>
+          <cr-button id="disable" ?hidden="${!this.status_?.enabled}"
+              ?disabled="${this.busy_}"
+              @click="${this.onDisableClick_}">
+            $i18n{stainlessPushDisable}
+          </cr-button>
+          <cr-button id="reset"
+              ?disabled="${!this.status_?.available || this.busy_}"
+              @click="${this.onResetClick_}">
+            $i18n{stainlessPushReset}
+          </cr-button>
+        </div>
+        <div class="status" role="status" aria-atomic="true">
+          <strong>$i18n{stainlessPushStatus}:</strong>
+          ${this.busy_ ? html`$i18n{stainlessPushApplying}` :
+                        html`${this.status_?.status}`}
+        </div>
+        <p>$i18n{stainlessPushSubscriptions}: ${this.status_?.subscriptions ?? 0}</p>
+        <div id="error" role="alert" tabindex="-1"
+            ?hidden="${!this.error_ && !this.status_?.error}">
+          <strong>$i18n{stainlessPushError}:</strong>
+          ${this.error_ || this.status_?.error}
+        </div>
+      </div>
+    </settings-section>
+    <cr-dialog id="resetDialog">
+      <div slot="title">$i18n{stainlessPushReset}</div>
+      <div slot="body">$i18n{stainlessPushResetPrompt}</div>
+      <div slot="button-container">
+        <cr-button class="cancel-button" @click="${this.onCancelResetClick_}">
+          $i18n{cancel}
+        </cr-button>
+        <cr-button class="action-button" @click="${this.onConfirmResetClick_}">
+          $i18n{stainlessPushReset}
+        </cr-button>
+      </div>
+    </cr-dialog>
+  <!--_html_template_end_-->`;
+  // clang-format on
+}
