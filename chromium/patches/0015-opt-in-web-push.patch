+  base::TimeTicks started = base::TimeTicks::Now();
+  bool persisting = false;
+};
+
+PendingRegistration::PendingRegistration() = default;
+PendingRegistration::~PendingRegistration() = default;
+PendingRegistration::PendingRegistration(PendingRegistration&&) = default;
+PendingRegistration& PendingRegistration::operator=(PendingRegistration&&) =
+    default;
+
