+#ifndef CHROME_BROWSER_PUSH_MESSAGING_STAINLESS_PUSH_MESSAGING_SERVICE_H_
+#define CHROME_BROWSER_PUSH_MESSAGING_STAINLESS_PUSH_MESSAGING_SERVICE_H_
+
+#include <memory>
+#include <string>
+
+#include "base/types/expected.h"
+#include "base/values.h"
+#include "components/keyed_service/core/keyed_service.h"
+#include "content/public/browser/push_messaging_service.h"
+
+class Profile;
+
+namespace stainless {
+
+inline constexpr char kPushConfigurationPref[] = "stainless.push.configuration";
+
+class PushMessagingService : public content::PushMessagingService,
+                             public KeyedService {
+ public:
+  explicit PushMessagingService(Profile* profile);
+  ~PushMessagingService() override;
+
+  base::expected<void, std::string> Configure(const GURL& connection,
+                                              const GURL& publisher,
+                                              bool enabled);
+  base::DictValue GetStatus() const;
+  void ResetRegistrations();
+
+  void SubscribeFromDocument(const GURL& origin,
+                             int64_t registration,
+                             int process,
+                             int frame,
+                             blink::mojom::PushSubscriptionOptionsPtr options,
+                             bool user_gesture,
+                             RegisterCallback callback) override;
+  void SubscribeFromWorker(const GURL& origin,
+                           int64_t registration,
+                           int process,
+                           blink::mojom::PushSubscriptionOptionsPtr options,
+                           RegisterCallback callback) override;
+  void GetSubscriptionInfo(const GURL& origin,
+                           int64_t registration,
+                           const std::string& sender,
+                           const std::string& subscription,
+                           SubscriptionInfoCallback callback) override;
+  bool IsSubscriptionStorageAvailable() const override;
+  void DidFailToStoreSubscription(const GURL& origin,
+                                  int64_t registration,
+                                  const std::string& subscription,
+                                  base::OnceClosure callback) override;
+  void Unsubscribe(blink::mojom::PushUnregistrationReason reason,
+                   const GURL& origin,
+                   int64_t registration,
+                   const std::string& sender,
+                   UnregisterCallback callback) override;
+  bool SupportNonVisibleMessages() override;
+  void DidDeleteServiceWorkerRegistration(const GURL& origin,
+                                          int64_t registration) override;
+  void DidDeleteServiceWorkerDatabase() override;
+  void Shutdown() override;
+
+ private:
+  class Impl;
+  std::unique_ptr<Impl> impl_;
+};
+
+PushMessagingService* GetPushMessagingService(Profile* profile);
+void EnsurePushMessagingServiceFactory();
+
+}  // namespace stainless
+
