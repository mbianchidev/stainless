+std::string EncodeUrl(base::span<const uint8_t> bytes) {
+  std::string result;
+  base::Base64UrlEncode(base::as_string_view(bytes),
+                        base::Base64UrlEncodePolicy::OMIT_PADDING, &result);
+  return result;
+}
+
+std::optional<std::string> DecodeUrl(std::string_view input) {
+  std::string result;
+  if (!base::Base64UrlDecode(input, base::Base64UrlDecodePolicy::IGNORE_PADDING,
+                             &result)) {
+    return std::nullopt;
+  }
+  return result;
+}
+
+std::string Digest(std::string_view input) {
+  return base::HexEncodeLower(
+      base::as_byte_span(crypto::SHA256HashString(input)));
+}
+
+bool IsWebOrigin(const GURL& origin) {
+  return origin.is_valid() && origin.SchemeIsHTTPOrHTTPS() &&
+         origin == url::Origin::Create(origin).GetURL() &&
+         network::IsOriginPotentiallyTrustworthy(url::Origin::Create(origin));
+}
+
+bool IsConnection(const GURL& connection) {
+  return connection.is_valid() && connection.SchemeIs("wss") &&
+         connection.has_host() && !connection.has_username() &&
+         !connection.has_password() && !connection.has_ref() &&
+         !connection.has_query() && connection.spec().size() <= 2048;
+}
+
+bool IsPublisher(const GURL& publisher) {
+  return publisher.is_valid() && publisher.SchemeIs("https") &&
+         publisher == url::Origin::Create(publisher).GetURL() &&
+         !publisher.has_username() && !publisher.has_password();
+}
+
+bool IsUaid(std::string_view value) {
+  return value.size() == 36
+             ? base::Uuid::ParseCaseInsensitive(value).is_valid()
+             : value.size() == 32 && std::ranges::all_of(value, [](char c) {
+                 return base::IsHexDigit(c);
+               });
+}
+
+void FailRegistration(RegisterCallback callback, RegistrationStatus status) {
+  std::move(callback).Run({}, GURL(), std::nullopt, {}, {}, status);
+}
