+  void OpenSettings() {
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(
+        browser(), GURL("stainless://settings/localServices")));
+    EXPECT_EQ(GURL("stainless://settings/localServices"),
+              contents()->GetVisibleURL());
+    EXPECT_EQ(
+        GURL("chrome://settings"),
+        contents()->GetPrimaryMainFrame()->GetLastCommittedOrigin().GetURL());
+    ASSERT_TRUE(content::ExecJs(contents(), R"JS(
+      window.findLocalServices = function find(root) {
+        for (const element of root.querySelectorAll('*')) {
+          if (element.localName === 'settings-local-services-page') return element;
+          if (element.shadowRoot) {
+            const found = find(element.shadowRoot);
+            if (found) return found;
+          }
+        }
+        return null;
+      };
+      window.serviceControls = () => window.findLocalServices(document)?.shadowRoot;
+      window.editServiceInput = (id, value) => {
+        const field = window.serviceControls().querySelector('#' + id);
+        const input = field.shadowRoot.querySelector('input');
+        input.focus();
+        input.value = value;
+        input.dispatchEvent(new Event('input', {bubbles: true, composed: true}));
+      };
+    )JS"));
+    ASSERT_TRUE(base::test::RunUntil([&] {
+      return content::EvalJs(contents(), R"JS(
+        !!window.serviceControls()?.querySelector('#connection') &&
+        !window.serviceControls().querySelector('#connection').disabled
+      )JS")
+          .ExtractBool();
+    }));
+  }
+
+  void GrantNotificationPermission() {
+    // Chromium denies prompts headlessly. Positive delivery uses an explicit
+    // test-profile grant, not a bypass of the production permission controller.
+    const auto origin = server_.GetURL("page.test", "/");
+    HostContentSettingsMapFactory::GetForProfile(browser()->GetProfile())
+        ->SetContentSettingDefaultScope(origin, origin,
+                                        ContentSettingsType::NOTIFICATIONS,
+                                        CONTENT_SETTING_ALLOW);
+    ASSERT_EQ("granted",
+              content::EvalJs(contents(), "Notification.permission"));
+  }
+
+  void SubscribeWithGrantedPermission() {
+    ASSERT_NO_FATAL_FAILURE(GrantNotificationPermission());
+    vapid_ = Vapid();
+    auto result = content::EvalJs(contents(), content::JsReplace(R"JS(
+      (async () => {
+        const raw = atob($1.replaceAll('-', '+').replaceAll('_', '/'));
+        const key = Uint8Array.from(raw, c => c.charCodeAt(0));
+        window.pushSubscription =
+            await window.registration.pushManager.subscribe({
+              userVisibleOnly: true, applicationServerKey: key
+            });
+        return JSON.stringify(window.pushSubscription.toJSON());
+      })()
+    )JS",
+                                                                 vapid_));
+    auto status = base::WriteJson(service_->GetStatus());
+    ASSERT_TRUE(status);
+    ASSERT_TRUE(result.is_ok())
+        << result << "\nNotification permission: "
+        << content::EvalJs(contents(), "Notification.permission")
+        << "\nNative status: " << *status;
+    auto subscription =
+        base::JSONReader::Read(result.ExtractString(), base::JSON_PARSE_RFC);
+    ASSERT_TRUE(subscription && subscription->is_dict());
+    const auto* endpoint = subscription->GetDict().FindString("endpoint");
+    ASSERT_TRUE(endpoint);
+    endpoint_ = *endpoint;
+    channel_ = GURL(endpoint_).ExtractFileName();
+    ASSERT_FALSE(channel_.empty());
+    const auto* keys = subscription->GetDict().FindDict("keys");
+    ASSERT_TRUE(keys);
+    EXPECT_TRUE(keys->FindString("p256dh"));
+    EXPECT_TRUE(keys->FindString("auth"));
+  }
+
+  void Notify(std::string version,
+              std::optional<std::string> encoding = std::nullopt) {
+    auto notification = base::DictValue()
+                            .Set("messageType", "notification")
+                            .Set("channelID", channel_)
+                            .Set("version", std::move(version));
+    if (encoding) {
+      notification.Set("data", "ZmljdGlvbmFsLWNpcGhlcnRleHQ");
+      notification.Set("headers", base::DictValue().Set("encoding", *encoding));
+    }
+    auto json = base::WriteJson(notification);
+    ASSERT_TRUE(json);
+    send_.Run(*json);
+  }
+
+  std::optional<int64_t> RegistrationId() { return registration_id_; }
+
+  void OnRegistrationStored(
+      int64_t registration,
+      const GURL& scope,
+      const content::ServiceWorkerRegistrationInformation&) override {
+    if (scope == server_.GetURL("page.test", "/fixture/")) {
+      registration_id_ = registration;
+    }
+  }
+
+  void OnDestruct(content::ServiceWorkerContext*) override {
+    observation_.Reset();
+  }
+
+  void ArmWorker(std::string mode) {
+    ASSERT_EQ(true, content::EvalJs(contents(), content::JsReplace(R"JS(
+      new Promise(resolve => {
+        navigator.serviceWorker.addEventListener('message', event => {
+          if (event.data.armed === $1) resolve(true);
+        });
+        window.registration.active.postMessage($1);
+      })
+    )JS",
+                                                                   mode)));
+  }
+
+  size_t Acks(int code) {
+    size_t count = 0;
+    for (const auto& frame : frames_) {
+      const auto* updates = frame.FindList("updates");
+      if (!updates) {
+        continue;
+      }
+      for (const auto& update : *updates) {
+        if (update.GetDict().FindInt("code") == code) {
+          ++count;
+        }
+      }
+    }
+    return count;
+  }
+
+  void OpenedConnection(SendFrame send, base::RepeatingClosure disconnect) {
+    send_ = std::move(send);
+    disconnect_ = std::move(disconnect);
+    ++connections_;
+  }
+
+  void ReceivedFrame(base::DictValue message) {
+    frames_.push_back(std::move(message));
+  }
+
+  base::test::ScopedFeatureList feature_list_;
+  net::EmbeddedTestServer server_{net::EmbeddedTestServer::TYPE_HTTPS};
+  raw_ptr<stainless::PushMessagingService> service_ = nullptr;
+  std::unique_ptr<NotificationDisplayServiceTester> notifications_;
+  std::vector<base::DictValue> frames_;
+  SendFrame send_;
+  base::RepeatingClosure disconnect_;
+  std::string vapid_;
+  std::string endpoint_;
+  std::string channel_;
+  int connections_ = 0;
+  std::optional<int64_t> registration_id_;
+  base::ScopedObservation<content::ServiceWorkerContext,
+                          content::ServiceWorkerContextObserver>
+      observation_{this};
+  base::WeakPtrFactory<StainlessPushMessagingBrowserTest> weak_{this};
+};
