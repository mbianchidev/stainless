+  options.max_incoming_bytes = 65536;
+  options.max_outgoing_bytes = 65536;
+  options.max_pending_messages = 64;
+  options.block_cookies_unconditionally = true;
+  options.omit_credentials = true;
+  options.reject_redirects = true;
+  delegate_.additional_headers.push_back(
+      network::mojom::HttpHeader::New("Authorization", "fictional-test-token"));
