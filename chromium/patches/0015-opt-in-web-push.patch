+constexpr size_t kMaximumStateBytes = 4 * 1024 * 1024;
+constexpr net::NetworkTrafficAnnotationTag kPushTraffic =
+    net::DefineNetworkTrafficAnnotation("stainless_user_configured_push", R"(
+      semantics {
+        sender: "Stainless user-controlled Web Push"
+        description:
+          "An optional user-configured Autopush server delivers encrypted "
+          "website notifications while the regular browser profile is running."
+        trigger: "Explicit profile opt-in and website notification permission."
+        data:
+          "Random profile/channel identifiers, VAPID public keys, encrypted "
+          "payloads and acknowledgement metadata. No history or account token."
+        destination: OTHER
+        destination_other: "The WSS server explicitly configured by the user."
+      }
+      policy {
+        cookies_allowed: NO
+        setting: "Off by default in Stainless Local Services settings."
+        policy_exception_justification:
+          "A user-selected optional service, without automatic cloud fallback."
+      })");
