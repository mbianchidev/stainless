+PushMessagingService::Impl::Impl(PushMessagingService* owner, Profile* profile)
+    : owner_(owner),
+      profile_(profile),
+      path_(profile->GetPath().AppendASCII("StainlessPushState")),
+      storage_(base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+           base::TaskShutdownBehavior::BLOCK_SHUTDOWN})),
+      settings_(HostContentSettingsMapFactory::GetForProfile(profile)) {
+  preferences_.Init(profile_->GetPrefs());
+  preferences_.Add(
+      kPushConfigurationPref,
+      base::BindRepeating(&Impl::ReadConfiguration, weak_.GetWeakPtr()));
+  settings_->AddObserver(this);
+  ReadConfiguration();
+  if (profile_->IsOffTheRecord() || !profile_->IsRegularProfile() ||
+      IncognitoModePrefs::ShouldLaunchIncognito(
+          *base::CommandLine::ForCurrentProcess(), profile_)) {
+    status_ = "Unavailable in this browsing mode";
+    return;
+  }
+  base::FilePath root;
+  if (!base::PathService::Get(chrome::DIR_USER_DATA, &root)) {
+    Error("Push profile root is unavailable");
+    return;
+  }
+  storage_->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(&ReadDiskState, root, profile_->GetPath(), path_),
+      base::BindOnce(&Impl::Loaded, weak_.GetWeakPtr()));
+}
+
+PushMessagingService::Impl::~Impl() {
+  Shutdown();
+}
+
+bool PushMessagingService::Impl::Excluded() const {
+  return profile_->IsOffTheRecord() || !profile_->IsRegularProfile() ||
+         IsStartupSafeMode() ||
+         IncognitoModePrefs::ShouldLaunchIncognito(
+             *base::CommandLine::ForCurrentProcess(), profile_);
+}
+
+bool PushMessagingService::Impl::Permitted(const GURL& origin) const {
+  if (!IsWebOrigin(origin)) {
+    return false;
+  }
+  return profile_->GetPermissionController()
+             ->GetPermissionResultForOriginWithoutContext(
+                 content::PermissionDescriptorUtil::
+                     CreatePermissionDescriptorForPermissionType(
+                         blink::PermissionType::NOTIFICATIONS),
+                 url::Origin::Create(origin))
+             .status == blink::mojom::PermissionStatus::GRANTED;
+}
+
+bool PushMessagingService::Impl::Enabled() const {
+  return !stopped_ && !Excluded() && configured_ && loaded_ && decoded_ &&
+         storage_ok_ && encryptor_ && encryptor_->IsEncryptionAvailable();
+}
+
+bool PushMessagingService::Impl::Authorized(const std::string& channel) const {
+  const auto binding = bindings_.find(channel);
+  return binding != bindings_.end() && Permitted(binding->second.origin);
+}
+
+void PushMessagingService::Impl::Error(std::string_view status) {
+  status_ = std::string(status);
+  last_error_ = status_;
+  configuration_pending_ = false;
+  LOG(ERROR) << "Stainless Push: " << status_;
+}
+
+void PushMessagingService::Impl::UnverifiedState(std::string_view status) {
+  storage_ok_ = false;
+  StopConnection();
+  if (!Excluded()) {
+    applying_configuration_ = true;
+    profile_->GetPrefs()->SetDict(kPushConfigurationPref,
+                                  base::DictValue()
+                                      .Set("enabled", false)
+                                      .Set("connection", connection_.spec())
+                                      .Set("publisher", publisher_.spec()));
+    applying_configuration_ = false;
+    configured_ = false;
+  }
+  Error(status);
+}
+
+base::DictValue PushMessagingService::Impl::Status() const {
+  return base::DictValue()
+      .Set("available", !Excluded())
+      .Set("enabled", configured_)
+      .Set("connected", ready_)
+      .Set("status", status_)
+      .Set("error", last_error_)
+      .Set("connection", connection_.spec())
+      .Set("publisher", publisher_.spec())
+      .Set("subscriptions", static_cast<int>(bindings_.size()))
+      .Set("queued", static_cast<int>(messages_.size()))
+      .Set("backpressured", backpressured_)
+      .Set("configurationPending", configuration_pending_)
+      .Set("terminalCapacityEvictions",
+           base::NumberToString(journal_.capacity_evictions()));
+}
+
+base::expected<void, std::string> PushMessagingService::Impl::Configure(
+    const GURL& connection,
+    const GURL& publisher,
+    bool enabled) {
+  if (Excluded()) {
+    return base::unexpected("Push setup is unavailable in this browsing mode");
+  }
+  if (((enabled || !connection.is_empty()) && !IsConnection(connection)) ||
+      ((enabled || !publisher.is_empty()) && !IsPublisher(publisher))) {
+    LOG(WARNING) << "Stainless Push: invalid setup URL";
+    return base::unexpected(
+        "Use a WSS connection and HTTPS publishing origin without credentials, "
+        "query parameters or fragments");
+  }
+  explicit_enablement_ = enabled;
+  configuration_pending_ = true;
+  applying_configuration_ = true;
+  profile_->GetPrefs()->SetDict(kPushConfigurationPref,
+                                base::DictValue()
+                                    .Set("enabled", enabled)
+                                    .Set("connection", connection.spec())
+                                    .Set("publisher", publisher.spec()));
+  applying_configuration_ = false;
+  ReadConfiguration();
+  return base::ok();
+}
+
+void PushMessagingService::Impl::ReadConfiguration() {
+  if (applying_configuration_ || stopped_) {
+    return;
+  }
+  const bool was_enabled = configured_;
+  const GURL old_connection = connection_;
+  const GURL old_publisher = publisher_;
+  const auto& configuration =
+      profile_->GetPrefs()->GetDict(kPushConfigurationPref);
+  bool valid = true;
+  if (configuration.empty()) {
+    configured_ = false;
+    connection_ = GURL();
+    publisher_ = GURL();
+  } else {
+    const auto enabled = configuration.FindBool("enabled");
+    const auto* connection = configuration.FindString("connection");
+    const auto* publisher = configuration.FindString("publisher");
+    valid = configuration.size() == 3 && enabled && connection && publisher;
+    configured_ = valid && *enabled;
+    connection_ = GURL(connection ? *connection : "");
+    publisher_ = GURL(publisher ? *publisher : "");
+    valid = valid && (!configured_ ||
+                      (IsConnection(connection_) && IsPublisher(publisher_)));
+    if (!valid) {
+      configured_ = false;
+    }
+  }
+  ++epoch_;
+  if (was_enabled && (!configured_ || old_connection != connection_ ||
+                      old_publisher != publisher_)) {
+    UnregisterBeforeClosing();
+  }
+  StopConnection();
+  operations_.Stop();
+  validations_ = 0;
+  legacy_cleaning_ = false;
+  messages_.clear();
+  processing_ = false;
+  CancelPending(RegistrationStatus::SERVICE_NOT_AVAILABLE);
+  if (!valid) {
+    Error("Push configuration is invalid");
+    return;
+  }
+  if (!loaded_) {
+    return;
+  }
+  if ((was_enabled && !configured_) || old_connection != connection_ ||
+      old_publisher != publisher_) {
+    EraseAll();
+    uaid_.clear();
+  }
+  if (!configured_) {
+    status_ = Excluded() ? "Unavailable in this browsing mode" : "Disabled";
+    if (encryptor_ && decoded_) {
+      Save(base::DoNothing());
+    } else if (decoded_ && (!disk_ || !disk_->ciphertext)) {
+      configuration_pending_ = false;
+    }
+    return;
+  }
+  if (!encryptor_ || !encryptor_->IsEncryptionAvailable() ||
+      (!decoded_ && disk_ && disk_->ciphertext)) {
+    loaded_ = false;
+    g_browser_process->os_crypt_async()->GetInstance(
+        base::BindOnce(&Impl::EncryptorReady, weak_.GetWeakPtr()));
+    return;
+  }
+  if (!decoded_) {
+    Error("Push state needs an explicit registration reset");
+    return;
+  }
+  Save(base::BindOnce(
+      [](base::WeakPtr<Impl> self, bool saved) {
+        if (self && saved) {
+          self->ValidateAndConnect();
+        }
+      },
+      weak_.GetWeakPtr()));
+}
+
+void PushMessagingService::Impl::Loaded(
+    base::expected<DiskState, std::string> result) {
+  if (!result) {
+    UnverifiedState(result.error());
+    return;
+  }
+  root_ = result->root;
+  relative_profile_ = result->relative_profile;
+  disk_ = std::move(*result);
+  legacy_cleanup_needed_ = !disk_->ciphertext;
+  if (!disk_->ciphertext && configured_ && !explicit_enablement_) {
+    applying_configuration_ = true;
+    profile_->GetPrefs()->SetDict(kPushConfigurationPref,
+                                  base::DictValue()
+                                      .Set("enabled", false)
+                                      .Set("connection", connection_.spec())
+                                      .Set("publisher", publisher_.spec()));
+    applying_configuration_ = false;
+    configured_ = false;
+    decoded_ = true;
+    loaded_ = true;
+    Error(
+        "Push state is missing; explicitly enable Push to create new "
+        "registrations");
+    return;
+  }
+  if (!disk_->ciphertext && (!configured_ || Excluded())) {
+    decoded_ = true;
+    loaded_ = true;
+    status_ = Excluded() ? "Unavailable in this browsing mode" : "Disabled";
+    return;
+  }
+  g_browser_process->os_crypt_async()->GetInstance(
+      base::BindOnce(&Impl::EncryptorReady, weak_.GetWeakPtr()));
+}
+
+void PushMessagingService::Impl::EncryptorReady(
+    scoped_refptr<os_crypt_async::Encryptor> encryptor) {
+  loaded_ = true;
+  encryptor_ = std::move(encryptor);
+  if (!encryptor_ || !encryptor_->IsEncryptionAvailable()) {
+    storage_ok_ = false;
+    Error("Local Push key protection is unavailable");
+    return;
+  }
+  if (disk_ && disk_->ciphertext && !reset_after_load_) {
+    os_crypt_async::Encryptor::DecryptFlags flags;
+    auto plaintext =
+        encryptor_->DecryptData(base::as_byte_span(*disk_->ciphertext), &flags);
+    if (!plaintext) {
+      if (flags.temporarily_unavailable) {
+        storage_ok_ = false;
+        Error("Local Push keys are temporarily unavailable");
+      } else {
+        UnverifiedState(
+            "Local Push state cannot be decrypted; reset and fresh enablement "
+            "are required");
+      }
+      return;
+    }
+    if (!DecodeState(*plaintext)) {
+      UnverifiedState(
+          "Local Push state is invalid; reset and fresh enablement are "
+          "required");
+      return;
+    }
+    disk_->ciphertext.reset();
+  } else {
+    decoded_ = true;
+  }
+  if (reset_after_load_) {
+    EraseAll();
+    uaid_.clear();
+    reset_after_load_ = false;
+    disk_->ciphertext.reset();
+  }
+  storage_ok_ = true;
+  if (!configured_) {
+    EraseAll();
+    Save(base::DoNothing());
+    status_ = Excluded() ? "Unavailable in this browsing mode" : "Disabled";
+    return;
+  }
+  ValidateAndConnect();
+}
+
+std::optional<std::string> PushMessagingService::Impl::EncodeState() const {
+  base::DictValue bindings;
+  for (const auto& [channel, binding] : bindings_) {
+    if (!binding.key || binding.auth.size() != 16) {
+      return std::nullopt;
+    }
+    bindings.Set(
+        channel,
+        base::DictValue()
+            .Set("origin", binding.origin.spec())
+            .Set("registration", base::NumberToString(binding.registration))
+            .Set("vapid", binding.vapid)
+            .Set("endpoint", binding.endpoint.spec())
+            .Set("privateKey",
+                 base::Base64Encode(binding.key->ToPrivateKeyInfo()))
+            .Set("auth", base::Base64Encode(binding.auth)));
+  }
+  return base::WriteJson(base::DictValue()
+                             .Set("schema", 1)
+                             .Set("enabled", configured_)
+                             .Set("root", root_.AsUTF8Unsafe())
+                             .Set("profile", relative_profile_.AsUTF8Unsafe())
+                             .Set("connection", connection_.spec())
+                             .Set("publisher", publisher_.spec())
+                             .Set("uaid", uaid_)
+                             .Set("bindings", std::move(bindings))
+                             .Set("journal", journal_.Serialize()));
+}
+
+bool PushMessagingService::Impl::DecodeState(std::string_view plaintext) {
+  auto decoded = base::JSONReader::Read(plaintext, base::JSON_PARSE_RFC);
+  if (!decoded || !decoded->is_dict()) {
+    return false;
+  }
+  auto& value = decoded->GetDict();
+  const auto schema = value.FindInt("schema");
+  const auto enabled = value.FindBool("enabled");
+  const auto* root = value.FindString("root");
+  const auto* profile = value.FindString("profile");
+  const auto* connection = value.FindString("connection");
+  const auto* publisher = value.FindString("publisher");
+  const auto* uaid = value.FindString("uaid");
+  const auto* bindings = value.FindDict("bindings");
+  const auto* journal = value.FindDict("journal");
+  if (value.size() != 9 || !schema || *schema != 1 || !enabled || !root ||
+      !profile || !connection || !publisher || !uaid ||
+      (!uaid->empty() && !IsUaid(*uaid)) || !bindings ||
+      bindings->size() > 128 || !journal) {
+    return false;
+  }
+  auto restored_journal =
+      PushDeliveryJournal::Deserialize(*journal, base::Time::Now());
+  if (!restored_journal) {
+    return false;
+  }
+  std::map<std::string, Binding> restored;
+  for (const auto [channel, item] : *bindings) {
+    const auto* record = item.GetIfDict();
+    if (!record || record->size() != 6 ||
+        !base::Uuid::ParseCaseInsensitive(channel).is_valid()) {
+      return false;
+    }
+    const auto* origin = record->FindString("origin");
+    const auto* registration = record->FindString("registration");
+    const auto* vapid = record->FindString("vapid");
+    const auto* endpoint = record->FindString("endpoint");
+    const auto* private_key = record->FindString("privateKey");
+    const auto* auth = record->FindString("auth");
+    Binding binding;
+    std::string key_bytes;
+    if (!origin || !registration || !vapid || !endpoint || !private_key ||
+        !auth || !IsWebOrigin(GURL(*origin)) ||
+        !base::StringToInt64(*registration, &binding.registration) ||
+        binding.registration < 0 ||
+        !base::Base64Decode(*private_key, &key_bytes) ||
+        !base::Base64Decode(*auth, &binding.auth) ||
+        binding.auth.size() != 16) {
+      return false;
+    }
+    binding.origin = GURL(*origin);
+    binding.endpoint = GURL(*endpoint);
+    binding.vapid = *vapid;
+    binding.key = crypto::keypair::PrivateKey::FromPrivateKeyInfo(
+        base::as_byte_span(key_bytes));
+    const auto vapid_bytes = DecodeUrl(*vapid);
+    if (!binding.key || !binding.key->IsEcP256() || !vapid_bytes ||
+        vapid_bytes->size() != 65 ||
+        !crypto::keypair::PublicKey::FromEcP256Point(
+            base::as_byte_span(*vapid_bytes)) ||
+        !binding.endpoint.is_valid() || !binding.endpoint.SchemeIs("https") ||
+        url::Origin::Create(binding.endpoint) !=
+            url::Origin::Create(GURL(*publisher))) {
+      return false;
+    }
+    restored.emplace(channel, std::move(binding));
+  }
+  bindings_ = std::move(restored);
+  journal_ = std::move(*restored_journal);
+  decoded_ = true;
+  const bool copied = *root != root_.AsUTF8Unsafe() ||
+                      *profile != relative_profile_.AsUTF8Unsafe();
+  if (copied || !*enabled || *connection != connection_.spec() ||
+      *publisher != publisher_.spec()) {
+    EraseAll();
+    uaid_.clear();
+    if (copied || (!*enabled && !explicit_enablement_)) {
+      applying_configuration_ = true;
+      profile_->GetPrefs()->SetDict(kPushConfigurationPref,
+                                    base::DictValue()
+                                        .Set("enabled", false)
+                                        .Set("connection", connection_.spec())
+                                        .Set("publisher", publisher_.spec()));
+      applying_configuration_ = false;
+      configured_ = false;
+      if (copied) {
+        Error(
+            "Copied profile: explicitly enable Push to create new "
+            "registrations");
+      } else {
+        status_ = "Disabled";
+      }
+    }
+  } else {
+    uaid_ = *uaid;
+  }
+  return true;
+}
+
+void PushMessagingService::Impl::Save(SaveCallback callback) {
+  if (!encryptor_ || !loaded_ || !decoded_ || root_.empty()) {
+    Error("Local Push state is not ready to save");
+    std::move(callback).Run(false);
+    return;
+  }
+  auto serialized = EncodeState();
+  if (!serialized || serialized->size() > kMaximumStateBytes) {
+    Error("Local Push state could not be serialized within its limit");
+    std::move(callback).Run(false);
+    return;
+  }
+  storage_->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(&WriteDiskState, path_, encryptor_,
+                     std::move(*serialized)),
+      base::BindOnce(
+          [](base::WeakPtr<Impl> self, uint64_t epoch, SaveCallback callback,
+             bool success) {
+            if (!self) {
+              return;
+            }
+            self->storage_ok_ = success;
+            if (self->epoch_ == epoch) {
+              self->configuration_pending_ = false;
+            }
+            if (!success) {
+              self->StopConnection();
+              self->Error(
+                  "Local Push state could not be saved; delivery is paused");
+            }
+            std::move(callback).Run(success);
+          },
+          weak_.GetWeakPtr(), epoch_, std::move(callback)));
+}
+
+bool PushMessagingService::Impl::StorageAvailable() const {
+  return !Excluded() && loaded_ && decoded_ && storage_ok_ &&
+         validations_ == 0 &&
+         (bindings_.empty() ||
+          (encryptor_ && encryptor_->IsEncryptionAvailable() &&
+           startup_reconciled_));
+}
+
+void PushMessagingService::Impl::ValidateAndConnect() {
+  if (stopped_ || !loaded_ || !decoded_ || !storage_ok_ || !encryptor_ ||
+      !encryptor_->IsEncryptionAvailable() || !profile_->IsRegularProfile() ||
+      profile_->IsOffTheRecord() || validations_ != 0 ||
+      IncognitoModePrefs::ShouldLaunchIncognito(
+          *base::CommandLine::ForCurrentProcess(), profile_)) {
+    return;
+  }
+  if (legacy_cleanup_needed_) {
+    if (legacy_cleaning_) {
+      return;
+    }
+    legacy_cleaning_ = true;
+    const uint64_t epoch = epoch_;
+    owner_->ClearAllPushSubscriptionDataWithStatus(
+        profile_,
+        base::BindOnce(
+            [](base::WeakPtr<Impl> self, uint64_t epoch, bool success) {
+              if (!self || self->epoch_ != epoch) {
+                return;
+              }
+              self->legacy_cleaning_ = false;
+              if (!success) {
+                self->storage_ok_ = false;
+                self->Error(
+                    "Previous Push registrations could not be removed from "
+                    "local storage");
+                return;
+              }
+              self->legacy_cleanup_needed_ = false;
+              self->ValidateAndConnect();
+            },
+            weak_.GetWeakPtr(), epoch));
+    return;
+  }
+  status_ = "Checking local registrations";
+  validation_failed_ = false;
+  validations_ = 1;
+  const uint64_t epoch = epoch_;
+  std::vector<std::tuple<std::string, GURL, int64_t>> snapshot;
+  for (const auto& [channel, binding] : bindings_) {
+    snapshot.emplace_back(channel, binding.origin, binding.registration);
+  }
+  for (const auto& [channel, origin, registration] : snapshot) {
+    if (!Permitted(origin)) {
+      Erase(channel);
+      continue;
+    }
+    ++validations_;
+    owner_->GetSWDataWithStatus(
+        profile_, origin, registration,
+        base::BindOnce(&Impl::Validated, weak_.GetWeakPtr(), epoch, channel));
+  }
+  ValidationFinished(epoch);
+}
+
+void PushMessagingService::Impl::Validated(uint64_t epoch,
+                                           std::string channel,
+                                           bool success,
+                                           std::string sender,
+                                           std::string subscription) {
+  if (epoch != epoch_) {
+    return;
+  }
+  if (!success) {
+    validation_failed_ = true;
+    Error("Push registration storage is temporarily unavailable");
+  } else {
+    auto binding = bindings_.find(channel);
+    if (binding != bindings_.end() &&
+        (subscription != channel ||
+         EncodeUrl(base::as_byte_span(sender)) != binding->second.vapid ||
+         !Permitted(binding->second.origin))) {
+      Erase(channel);
+    }
+  }
+  ValidationFinished(epoch);
+}
+
+void PushMessagingService::Impl::ValidationFinished(uint64_t epoch) {
+  if (epoch != epoch_ || --validations_ != 0) {
+    return;
+  }
+  if (validation_failed_) {
+    Retry();
+    return;
+  }
+  Save(base::BindOnce(
+      [](base::WeakPtr<Impl> self, uint64_t epoch, bool saved) {
+        if (self && saved && self->epoch_ == epoch && self->Enabled()) {
+          self->Connect();
+        } else if (self && saved && self->epoch_ == epoch && self->Excluded()) {
+          self->status_ = "Unavailable in this browsing mode";
+        }
+      },
+      weak_.GetWeakPtr(), epoch));
+}
+
+void PushMessagingService::Impl::Connect() {
+  if (!Enabled() || socket_) {
+    return;
+  }
+  ++connection_generation_;
+  streaming_client::StreamingWebSocketOptions options;
+  options.message_type = network::mojom::WebSocketMessageType::TEXT;
+  options.max_incoming_bytes = 64 * 1024;
+  options.max_outgoing_bytes = 64 * 1024;
+  options.max_pending_messages = 64;
+  options.block_cookies_unconditionally = true;
+  options.omit_credentials = true;
+  options.reject_redirects = true;
+  socket_ = std::make_unique<streaming_client::StreamingWebSocketClient>(
+      connection_,
+      base::BindRepeating(
+          [](Profile* profile) {
+            return profile->GetDefaultStoragePartition()->GetNetworkContext();
+          },
+          base::Unretained(profile_.get())),
+      kPushTraffic, this, options);
+  status_ = "Connecting";
+  connection_timeout_.Start(FROM_HERE, base::Seconds(30),
+                            base::BindOnce(&Impl::Retry, weak_.GetWeakPtr()));
+  operations_.Start(
+      FROM_HERE, base::Seconds(1),
+      base::BindRepeating(&Impl::OperationTimeouts, weak_.GetWeakPtr()));
+  socket_->Connect();
+}
+
+void PushMessagingService::Impl::StopConnection() {
+  ready_ = false;
+  hello_accepted_ = false;
+  hello_received_ = false;
+  transport_open_ = false;
+  backpressured_ = false;
+  reconnect_.Stop();
+  connection_timeout_.Stop();
+  heartbeat_.Stop();
+  reconciling_.clear();
+  heartbeat_sent_ = base::TimeTicks();
+  if (socket_) {
+    socket_->Close();
+    base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(
+        FROM_HERE, std::move(socket_));
+  }
+}
+
+void PushMessagingService::Impl::UnregisterBeforeClosing() {
+  if (Excluded() || !socket_ || !transport_open_ || !hello_accepted_) {
+    return;
+  }
+  for (const auto& [channel, binding] : bindings_) {
+    if (!transport_open_) {
+      return;
+    }
+    const auto json = base::WriteJson(base::DictValue()
+                                          .Set("messageType", "unregister")
+                                          .Set("channelID", channel));
+    if (!json) {
+      Error("Push unregister control could not be serialized");
+      return;
+    }
+    socket_->Send(std::vector<uint8_t>(json->begin(), json->end()));
+  }
+}
+
+void PushMessagingService::Impl::Retry() {
+  if (reconnect_.IsRunning() || !Enabled()) {
+    return;
+  }
+  ready_ = false;
+  transport_open_ = false;
+  status_ = "Disconnected; retrying";
+  heartbeat_.Stop();
+  connection_timeout_.Stop();
+  if (!connected_at_.is_null() &&
+      base::TimeTicks::Now() - connected_at_ > base::Seconds(60)) {
+    retry_count_ = 0;
+  }
+  const int nominal = std::min(300000, 1000 << std::min(retry_count_++, 9u));
+  const auto delay = base::Milliseconds(base::RandIntInclusive(
+      std::max(1000, nominal * 3 / 4), std::min(300000, nominal * 5 / 4)));
+  reconnect_.Start(FROM_HERE, delay,
+                   base::BindOnce(
+                       [](base::WeakPtr<Impl> self) {
+                         if (!self) {
+                           return;
+                         }
+                         self->StopConnection();
+                         self->messages_.clear();
+                         self->ValidateAndConnect();
+                       },
+                       weak_.GetWeakPtr()));
+}
+
+void PushMessagingService::Impl::Send(base::DictValue message) {
+  if (!Enabled() || !socket_) {
+    return;
+  }
+  auto json = base::WriteJson(message);
+  if (!json || json->size() > 64 * 1024) {
+    Error("Push control message exceeds its limit");
+    Retry();
+    return;
+  }
+  socket_->Send(std::vector<uint8_t>(json->begin(), json->end()));
+}
+
+void PushMessagingService::Impl::OnConnected() {
+  transport_open_ = true;
+  connected_at_ = base::TimeTicks::Now();
+  auto hello =
+      base::DictValue().Set("messageType", "hello").Set("use_webpush", true);
+  if (!uaid_.empty()) {
+    hello.Set("uaid", uaid_);
+  }
+  connection_timeout_.Start(FROM_HERE, base::Seconds(5),
+                            base::BindOnce(&Impl::Retry, weak_.GetWeakPtr()));
+  Send(std::move(hello));
+}
+
+void PushMessagingService::Impl::Hello(base::DictValue message) {
+  const auto* uaid = message.FindString("uaid");
+  const auto status = message.FindInt("status");
+  if (hello_received_ || !uaid || !IsUaid(*uaid) || !status || *status != 200 ||
+      message.FindBool("use_webpush") != true) {
+    Error("Push server returned an invalid hello");
+    Retry();
+    return;
+  }
+  hello_received_ = true;
+  if (!uaid_.empty() && uaid_ != *uaid) {
+    ++epoch_;
+    CancelPending(RegistrationStatus::NETWORK_ERROR);
+    EraseAll();
+    messages_.clear();
+    processing_ = false;
+  }
+  uaid_ = *uaid;
+  const uint64_t epoch = epoch_;
+  Save(base::BindOnce(
+      [](base::WeakPtr<Impl> self, uint64_t epoch,
+         uint64_t connection_generation, bool saved) {
+        if (!self || !saved || self->epoch_ != epoch || !self->Enabled() ||
+            !self->socket_ || !self->transport_open_ ||
+            self->connection_generation_ != connection_generation) {
+          return;
+        }
+        self->hello_accepted_ = true;
+        self->connection_timeout_.Stop();
+        for (const auto& [channel, binding] : self->bindings_) {
+          self->reconciling_.emplace(channel, base::TimeTicks::Now());
+          self->RegisterChannel(channel, binding);
+        }
+        if (self->reconciling_.empty()) {
+          self->ready_ = true;
+          self->startup_reconciled_ = true;
+          self->status_ = "Connected";
+          self->last_error_.clear();
+          self->Pump();
+        }
+        self->heartbeat_.Start(
+            FROM_HERE, base::Seconds(300),
+            base::BindRepeating(
+                [](base::WeakPtr<Impl> self) {
+                  if (self && self->heartbeat_sent_.is_null()) {
+                    self->heartbeat_sent_ = base::TimeTicks::Now();
+                    self->Send(base::DictValue());
+                  }
+                },
+                self));
+      },
+      weak_.GetWeakPtr(), epoch, connection_generation_));
+}
+
+void PushMessagingService::Impl::RegisterChannel(const std::string& channel,
+                                                 const Binding& binding) {
+  Send(base::DictValue()
+           .Set("messageType", "register")
+           .Set("channelID", channel)
+           .Set("key", binding.vapid));
+}
+
+void PushMessagingService::Impl::OnMessage(std::vector<uint8_t> bytes) {
+  if (!Enabled() || !transport_open_ || reconnect_.IsRunning()) {
+    return;
+  }
+  auto value = base::JSONReader::Read(base::as_string_view(base::span(bytes)),
+                                      base::JSON_PARSE_RFC);
+  if (!value || !value->is_dict()) {
+    Error("Push server returned malformed JSON");
+    Retry();
+    return;
+  }
+  auto message = std::move(value->GetDict());
+  if (message.empty()) {
+    heartbeat_sent_ = base::TimeTicks();
+    return;
+  }
+  const auto* type = message.FindString("messageType");
+  if (!type) {
+    Error("Push server returned an untyped message");
+    Retry();
+  } else if (*type == "hello") {
+    Hello(std::move(message));
+  } else if (!hello_accepted_) {
+    if (hello_received_ && *type == "notification") {
+      ReceiveNotification(std::move(message));
+    } else {
+      Error("Push server sent data before its hello was persisted");
+      Retry();
+    }
+  } else if (*type == "register") {
+    Registered(std::move(message));
+  } else if (*type == "notification") {
+    ReceiveNotification(std::move(message));
+  } else if (*type != "unregister" && *type != "broadcast") {
+    Error("Push server returned an unsupported control message");
+    Retry();
+  }
+}
+
+void PushMessagingService::Impl::OnConnectionError(const std::string&,
+                                                   int,
+                                                   int) {
+  transport_open_ = false;
+  Error("Push connection failed; check the server and its TLS configuration");
+  Retry();
+}
+
+void PushMessagingService::Impl::OnDropChannel(bool,
+                                               uint16_t,
+                                               const std::string&,
+                                               std::optional<base::TimeDelta>) {
+  transport_open_ = false;
+  Retry();
+}
+
+void PushMessagingService::Impl::OnError(const std::string&) {
+  transport_open_ = false;
+  Error("Push transport failed");
+  Retry();
+}
+
+void PushMessagingService::Impl::OnClose() {
+  transport_open_ = false;
+  Retry();
+}
+
+void PushMessagingService::Impl::Subscribe(
+    const GURL& origin,
+    int64_t registration,
+    int process,
+    int frame,
+    blink::mojom::PushSubscriptionOptionsPtr options,
+    bool user_gesture,
+    RegisterCallback callback) {
+  if (!Enabled()) {
+    FailRegistration(std::move(callback),
+                     RegistrationStatus::SERVICE_NOT_AVAILABLE);
+    return;
+  }
+  if (!options || !options->user_visible_only || !IsWebOrigin(origin) ||
+      registration < 0) {
+    FailRegistration(std::move(callback),
+                     RegistrationStatus::PERMISSION_DENIED);
+    return;
+  }
+  if (options->application_server_key.size() != 65 ||
+      options->application_server_key.front() != 4 ||
+      !crypto::keypair::PublicKey::FromEcP256Point(
+          options->application_server_key)) {
+    FailRegistration(std::move(callback),
+                     RegistrationStatus::UNSUPPORTED_GCM_SENDER_ID);
+    return;
+  }
+  if (frame == -1) {
+    StartSubscription(
+        origin, registration, std::move(options), std::move(callback),
+        Permitted(origin) ? blink::mojom::PermissionStatus::GRANTED
+                          : blink::mojom::PermissionStatus::DENIED);
+    return;
+  }
+  auto* host = content::RenderFrameHost::FromID(process, frame);
+  if (!host || host->GetBrowserContext() != profile_ || !host->IsActive() ||
+      host->GetLastCommittedOrigin() != url::Origin::Create(origin)) {
+    FailRegistration(std::move(callback),
+                     RegistrationStatus::RENDERER_SHUTDOWN);
+    return;
+  }
+  auto document = host->GetWeakDocumentPtr();
+  profile_->GetPermissionController()->RequestPermissionFromCurrentDocument(
+      host,
+      content::PermissionRequestDescription(
+          content::PermissionDescriptorUtil::
+              CreatePermissionDescriptorForPermissionType(
+                  blink::PermissionType::NOTIFICATIONS),
+          user_gesture),
+      base::BindOnce(
+          [](base::WeakPtr<Impl> self, content::WeakDocumentPtr document,
+             GURL origin, int64_t registration,
+             blink::mojom::PushSubscriptionOptionsPtr options,
+             RegisterCallback callback, content::PermissionResult result) {
+            if (!self) {
+              return;
+            }
+            auto* host = document.AsRenderFrameHostIfValid();
+            if (!host || host->GetBrowserContext() != self->profile_ ||
+                host->GetLastCommittedOrigin() != url::Origin::Create(origin)) {
+              FailRegistration(std::move(callback),
+                               RegistrationStatus::RENDERER_SHUTDOWN);
+              return;
+            }
+            self->StartSubscription(origin, registration, std::move(options),
+                                    std::move(callback), result.status);
+          },
+          weak_.GetWeakPtr(), document, origin, registration,
+          std::move(options), std::move(callback)));
+}
+
+void PushMessagingService::Impl::StartSubscription(
+    const GURL& origin,
+    int64_t registration,
+    blink::mojom::PushSubscriptionOptionsPtr options,
+    RegisterCallback callback,
+    blink::mojom::PermissionStatus permission) {
+  if (!Enabled()) {
+    FailRegistration(std::move(callback),
+                     RegistrationStatus::SERVICE_NOT_AVAILABLE);
+    return;
+  }
+  if (permission != blink::mojom::PermissionStatus::GRANTED ||
+      !Permitted(origin)) {
+    FailRegistration(std::move(callback),
+                     RegistrationStatus::PERMISSION_DENIED);
+    return;
+  }
+  const std::string vapid = EncodeUrl(options->application_server_key);
+  for (const auto& [channel, binding] : bindings_) {
+    if (binding.origin != origin || binding.registration != registration) {
+      continue;
+    }
+    if (binding.vapid != vapid) {
+      FailRegistration(std::move(callback),
+                       RegistrationStatus::SENDER_ID_MISMATCH);
+      return;
+    }
+    auto pending = pending_.find(channel);
+    if (pending != pending_.end()) {
+      if (pending->second.callbacks.size() == 16) {
+        FailRegistration(std::move(callback),
+                         RegistrationStatus::LIMIT_REACHED);
+      } else {
+        pending->second.callbacks.push_back(std::move(callback));
+      }
+      return;
+    }
+    if (!StorageAvailable() || reconciling_.contains(channel)) {
+      FailRegistration(std::move(callback), RegistrationStatus::NETWORK_ERROR);
+      return;
+    }
+    std::move(callback).Run(
+        channel, binding.endpoint, std::nullopt,
+        binding.key->ToUncompressedX962Point(),
+        std::vector<uint8_t>(binding.auth.begin(), binding.auth.end()),
+        RegistrationStatus::SUCCESS_FROM_PUSH_SERVICE);
+    return;
+  }
+  for (auto& [channel, pending] : pending_) {
+    if (pending.persisting || pending.binding.origin != origin ||
+        pending.binding.registration != registration) {
+      continue;
+    }
+    if (pending.binding.vapid != vapid) {
+      FailRegistration(std::move(callback),
+                       RegistrationStatus::SENDER_ID_MISMATCH);
+    } else if (pending.callbacks.size() == 16) {
+      FailRegistration(std::move(callback), RegistrationStatus::LIMIT_REACHED);
+    } else {
+      pending.callbacks.push_back(std::move(callback));
+    }
+    return;
+  }
+  if (!ready_) {
+    FailRegistration(std::move(callback), RegistrationStatus::NETWORK_ERROR);
+    return;
+  }
+  const auto new_count = std::ranges::count_if(
+      pending_, [](const auto& item) { return !item.second.persisting; });
+  if (bindings_.size() + new_count >= 128) {
+    FailRegistration(std::move(callback), RegistrationStatus::LIMIT_REACHED);
+    return;
+  }
+  const std::string channel =
+      base::Uuid::GenerateRandomV4().AsLowercaseString();
+  PendingRegistration pending;
+  pending.binding.origin = origin;
+  pending.binding.registration = registration;
+  pending.binding.vapid = vapid;
+  pending.binding.key = crypto::keypair::PrivateKey::GenerateEcP256();
+  pending.binding.auth.resize(16);
+  crypto::RandBytes(base::as_writable_byte_span(pending.binding.auth));
+  pending.callbacks.push_back(std::move(callback));
+  auto inserted = pending_.emplace(channel, std::move(pending));
+  RegisterChannel(channel, inserted.first->second.binding);
+}
+
+void PushMessagingService::Impl::Registered(base::DictValue message) {
+  const auto* channel = message.FindString("channelID");
+  const auto status = message.FindInt("status");
+  const auto* endpoint = message.FindString("pushEndpoint");
+  if (!channel || !base::Uuid::ParseCaseInsensitive(*channel).is_valid() ||
+      !status) {
+    Error("Push server returned an invalid registration response");
+    Retry();
+    return;
+  }
+  const GURL url(endpoint ? *endpoint : "");
+  const bool valid =
+      *status == 200 && endpoint && url.is_valid() && url.SchemeIs("https") &&
+      !url.has_username() && !url.has_password() && !url.has_ref() &&
+      !url.has_query() && url.spec().size() <= 2048 &&
+      url::Origin::Create(url) == url::Origin::Create(publisher_);
+  if (reconciling_.erase(*channel) != 0) {
+    auto binding = bindings_.find(*channel);
+    if (*status != 200 && *status != 404 && *status != 410) {
+      Error(
+          "Push server could not reconcile a registration; retaining local "
+          "keys");
+      Retry();
+      return;
+    }
+    if (*status == 200 && !valid) {
+      Error("Push server returned an invalid publishing endpoint");
+      Retry();
+      return;
+    }
+    if (binding != bindings_.end() && *status != 200) {
+      Erase(*channel);
+      Save(base::DoNothing());
+    }
+    if (reconciling_.empty() && transport_open_ && !reconnect_.IsRunning()) {
+      ready_ = true;
+      startup_reconciled_ = true;
+      status_ = "Connected";
+      last_error_.clear();
+      Pump();
+    }
+    return;
+  }
+  auto pending = pending_.find(*channel);
+  if (pending == pending_.end()) {
+    if (!bindings_.contains(*channel)) {
+      Send(base::DictValue()
+               .Set("messageType", "unregister")
+               .Set("channelID", *channel));
+    }
+    return;
+  }
+  if (pending->second.persisting) {
+    return;
+  }
+  if (!valid || !Permitted(pending->second.binding.origin)) {
+    auto callbacks = std::move(pending->second.callbacks);
+    pending_.erase(pending);
+    Send(base::DictValue()
+             .Set("messageType", "unregister")
+             .Set("channelID", *channel));
+    Error(
+        "Push registration failed or returned an unexpected publishing origin");
+    for (auto& callback : callbacks) {
+      FailRegistration(std::move(callback), RegistrationStatus::SERVICE_ERROR);
+    }
+    return;
+  }
+  pending->second.binding.endpoint = url;
+  bindings_.emplace(*channel, std::move(pending->second.binding));
+  pending->second.persisting = true;
+  Save(base::BindOnce(&Impl::FinishRegistration, weak_.GetWeakPtr(), *channel,
+                      epoch_));
+}
+
+void PushMessagingService::Impl::FinishRegistration(std::string channel,
+                                                    uint64_t epoch,
+                                                    bool saved) {
+  auto pending = pending_.find(channel);
+  if (pending == pending_.end()) {
+    return;
+  }
+  auto callbacks = std::move(pending->second.callbacks);
+  pending_.erase(pending);
+  auto binding = bindings_.find(channel);
+  if (!saved || epoch != epoch_ || !Enabled() || binding == bindings_.end() ||
+      !Permitted(binding->second.origin)) {
+    if (binding != bindings_.end()) {
+      Erase(channel);
+    }
+    for (auto& callback : callbacks) {
+      FailRegistration(std::move(callback),
+                       saved ? RegistrationStatus::SERVICE_NOT_AVAILABLE
+                             : RegistrationStatus::STORAGE_ERROR);
+    }
+    return;
+  }
+  const auto endpoint = binding->second.endpoint;
+  const auto public_key = binding->second.key->ToUncompressedX962Point();
+  const std::vector<uint8_t> auth(binding->second.auth.begin(),
+                                  binding->second.auth.end());
+  for (auto& callback : callbacks) {
+    std::move(callback).Run(channel, endpoint, std::nullopt, public_key, auth,
+                            RegistrationStatus::SUCCESS_FROM_PUSH_SERVICE);
+  }
+}
+
+void PushMessagingService::Impl::GetInfo(const GURL& origin,
+                                         int64_t registration,
+                                         const std::string& sender,
+                                         const std::string& subscription,
+                                         SubscriptionInfoCallback callback) {
+  auto binding = bindings_.find(subscription);
+  if (!Enabled() || !StorageAvailable() || binding == bindings_.end() ||
+      binding->second.origin != origin ||
+      binding->second.registration != registration ||
+      EncodeUrl(base::as_byte_span(sender)) != binding->second.vapid ||
+      pending_.contains(subscription) || !Permitted(origin)) {
+    std::move(callback).Run(false, true, GURL(), std::nullopt, {}, {});
+    return;
+  }
+  std::move(callback).Run(true, true, binding->second.endpoint, std::nullopt,
+                          binding->second.key->ToUncompressedX962Point(),
+                          std::vector<uint8_t>(binding->second.auth.begin(),
+                                               binding->second.auth.end()));
+}
+
+void PushMessagingService::Impl::FailedStore(const GURL& origin,
+                                             int64_t registration,
+                                             const std::string& channel,
+                                             base::OnceClosure callback) {
+  owner_->GetSWDataWithStatus(
+      profile_, origin, registration,
+      base::BindOnce(
+          [](base::WeakPtr<Impl> self, GURL origin, int64_t registration,
+             std::string channel, base::OnceClosure callback, bool success,
+             std::string sender, std::string subscription) {
+            if (!self) {
+              return;
+            }
+            auto binding = self->bindings_.find(channel);
+            if (binding == self->bindings_.end() ||
+                binding->second.origin != origin ||
+                binding->second.registration != registration) {
+              std::move(callback).Run();
+              return;
+            }
+            if (!success) {
+              self->storage_ok_ = false;
+              self->StopConnection();
+              self->Error(
+                  "Push subscription storage failed; local delivery is paused");
+              std::move(callback).Run();
+              return;
+            }
+            if (subscription == channel &&
+                EncodeUrl(base::as_byte_span(sender)) ==
+                    binding->second.vapid) {
+              std::move(callback).Run();
+              return;
+            }
+            self->Erase(channel, false);
+            self->Save(base::BindOnce([](base::OnceClosure callback,
+                                         bool) { std::move(callback).Run(); },
+                                      std::move(callback)));
+          },
+          weak_.GetWeakPtr(), origin, registration, channel,
+          std::move(callback)));
+}
+
+void PushMessagingService::Impl::CancelPending(RegistrationStatus status) {
+  auto pending = std::move(pending_);
+  pending_.clear();
+  for (auto& [channel, item] : pending) {
+    for (auto& callback : item.callbacks) {
+      FailRegistration(std::move(callback), status);
+    }
+  }
+}
+
+void PushMessagingService::Impl::OperationTimeouts() {
+  if (Excluded() || !configured_) {
+    StopConnection();
+    operations_.Stop();
+    return;
+  }
+  const auto now = base::TimeTicks::Now();
+  if (!heartbeat_sent_.is_null() &&
+      now - heartbeat_sent_ >= base::Seconds(30)) {
+    Error("Push heartbeat timed out");
+    Retry();
+    return;
+  }
+  if (std::ranges::any_of(reconciling_, [now](const auto& item) {
+        return now - item.second >= base::Seconds(30);
+      })) {
+    Error("Push registration reconciliation timed out");
+    Retry();
+    return;
+  }
+  std::vector<std::string> expired;
+  for (const auto& [channel, pending] : pending_) {
+    if (!pending.persisting && now - pending.started >= base::Seconds(30)) {
+      expired.push_back(channel);
+    }
+  }
+  for (const auto& channel : expired) {
+    auto pending = pending_.extract(channel);
+    Send(base::DictValue()
+             .Set("messageType", "unregister")
+             .Set("channelID", channel));
+    for (auto& callback : pending.mapped().callbacks) {
+      FailRegistration(std::move(callback), RegistrationStatus::NETWORK_ERROR);
+    }
+  }
+}
+
+void PushMessagingService::Impl::Erase(const std::string& channel,
+                                       bool clear_worker) {
+  auto binding = bindings_.find(channel);
+  if (binding != bindings_.end()) {
+    const GURL origin = binding->second.origin;
+    const int64_t registration = binding->second.registration;
+    journal_.RemoveBinding(BindingDigest(channel, binding->second));
+    bindings_.erase(binding);
+    if (clear_worker) {
+      owner_->ClearPushSubscriptionIdWithStatus(
+          profile_, origin, registration,
+          base::BindOnce(
+              [](base::WeakPtr<Impl> self, bool success) {
+                if (self && !success) {
+                  self->storage_ok_ = false;
+                  self->StopConnection();
+                  self->Error(
+                      "Push registration could not be removed from local "
+                      "storage");
+                }
+              },
+              weak_.GetWeakPtr()));
+    }
+  }
+  auto pending = pending_.extract(channel);
+  if (!pending.empty()) {
+    for (auto& callback : pending.mapped().callbacks) {
+      FailRegistration(std::move(callback),
+                       RegistrationStatus::SERVICE_NOT_AVAILABLE);
+    }
+  }
+  reconciling_.erase(channel);
+  if (hello_accepted_) {
+    Send(base::DictValue()
+             .Set("messageType", "unregister")
+             .Set("channelID", channel));
+  }
+}
+
+void PushMessagingService::Impl::EraseAll() {
+  CancelPending(RegistrationStatus::SERVICE_NOT_AVAILABLE);
+  std::vector<std::string> channels;
+  for (const auto& [channel, binding] : bindings_) {
+    channels.push_back(channel);
+  }
+  for (const auto& channel : channels) {
+    Erase(channel);
+  }
+  journal_ = PushDeliveryJournal();
+  startup_reconciled_ = false;
+}
+
+void PushMessagingService::Impl::Unsubscribe(const GURL& origin,
+                                             int64_t registration,
+                                             UnregisterCallback callback) {
+  if (!loaded_ || !decoded_) {
+    std::move(callback).Run(UnregistrationStatus::STORAGE_ERROR);
+    return;
+  }
+  bool existed = false;
+  std::vector<std::string> channels;
+  for (const auto& [channel, binding] : bindings_) {
+    if (binding.origin == origin && binding.registration == registration) {
+      channels.push_back(channel);
+    }
+  }
+  for (const auto& [channel, pending] : pending_) {
+    if (!pending.persisting && pending.binding.origin == origin &&
+        pending.binding.registration == registration) {
+      channels.push_back(channel);
+    }
+  }
+  existed = !channels.empty();
+  for (const auto& channel : channels) {
+    Erase(channel, false);
+  }
+  auto completed = base::BarrierCallback<bool>(
+      2,
+      base::BindOnce(
+          [](UnregisterCallback callback, bool existed,
+             const std::vector<bool>& results) {
+            std::move(callback).Run(
+                std::ranges::all_of(results, [](bool result) { return result; })
+                    ? (existed
+                           ? UnregistrationStatus::SUCCESS_UNREGISTERED
+                           : UnregistrationStatus::SUCCESS_WAS_NOT_REGISTERED)
+                    : UnregistrationStatus::STORAGE_ERROR);
+          },
+          std::move(callback), existed));
+  owner_->ClearPushSubscriptionIdWithStatus(profile_, origin, registration,
+                                            completed);
+  if (encryptor_) {
+    Save(completed);
+  } else {
+    completed.Run(!existed && storage_ok_);
+  }
+}
+
+void PushMessagingService::Impl::DeleteRegistration(const GURL& origin,
+                                                    int64_t registration) {
+  Unsubscribe(origin, registration,
+              base::BindOnce(
+                  [](base::WeakPtr<Impl> self, UnregistrationStatus status) {
+                    if (self && status == UnregistrationStatus::STORAGE_ERROR) {
+                      self->Error(
+                          "Deleted worker Push registration needs local "
+                          "storage recovery");
+                    }
+                  },
+                  weak_.GetWeakPtr()));
+}
+
+void PushMessagingService::Impl::ResetRegistrations() {
+  if (Excluded() || root_.empty()) {
+    Error("Push registrations cannot be reset in this browsing mode");
+    return;
+  }
+  configuration_pending_ = true;
+  DeleteDatabase();
+}
+
+void PushMessagingService::Impl::DeleteDatabase() {
+  if (root_.empty() || !loaded_) {
+    reset_after_load_ = true;
+    return;
+  }
+  ++epoch_;
+  UnregisterBeforeClosing();
+  StopConnection();
+  operations_.Stop();
+  validations_ = 0;
+  messages_.clear();
+  processing_ = false;
+  EraseAll();
+  uaid_.clear();
+  decoded_ = true;
+  if (disk_) {
+    disk_->ciphertext.reset();
+  }
+  if (!encryptor_ || !encryptor_->IsEncryptionAvailable()) {
+    loaded_ = false;
+    g_browser_process->os_crypt_async()->GetInstance(
+        base::BindOnce(&Impl::EncryptorReady, weak_.GetWeakPtr()));
+    return;
+  }
+  Save(base::BindOnce(
+      [](base::WeakPtr<Impl> self, bool saved) {
+        if (self && saved) {
+          self->ValidateAndConnect();
+        }
+      },
+      weak_.GetWeakPtr()));
+}
+
+void PushMessagingService::Impl::OnContentSettingChanged(
+    const ContentSettingsPattern&,
+    const ContentSettingsPattern&,
+    ContentSettingsTypeSet types) {
+  if (!types.Contains(ContentSettingsType::NOTIFICATIONS)) {
+    return;
+  }
+  std::vector<std::string> revoked;
+  for (const auto& [channel, binding] : bindings_) {
+    if (!Permitted(binding.origin)) {
+      revoked.push_back(channel);
+    }
+  }
+  for (const auto& [channel, pending] : pending_) {
+    if (!pending.persisting && !Permitted(pending.binding.origin)) {
+      revoked.push_back(channel);
+    }
+  }
+  for (const auto& channel : revoked) {
+    Erase(channel);
+  }
+  if (!revoked.empty()) {
+    Save(base::DoNothing());
+  }
+}
+
+void PushMessagingService::Impl::Shutdown() {
+  if (stopped_) {
+    return;
+  }
+  stopped_ = true;
+  ++epoch_;
+  weak_.InvalidateWeakPtrs();
+  StopConnection();
+  operations_.Stop();
+  preferences_.RemoveAll();
+  settings_->RemoveObserver(this);
+  CancelPending(RegistrationStatus::SERVICE_NOT_AVAILABLE);
+  messages_.clear();
+  bindings_.clear();
+  notifications_.reset();
+}
+
+void PushMessagingService::Impl::ReceiveNotification(base::DictValue message) {
+  const auto* channel = message.FindString("channelID");
+  const auto* version = message.FindString("version");
+  if (!channel || !base::Uuid::ParseCaseInsensitive(*channel).is_valid() ||
+      !version || version->empty() || version->size() > 2048) {
+    Error("Push notification has an invalid channel or version");
+    Retry();
+    return;
+  }
+  if (backpressured_) {
+    return;
+  }
+  if (messages_.size() == 64) {
+    backpressured_ = true;
+    Error(
+        "Push queue is full; draining accepted work before resuming "
+        "unacknowledged backlog");
+    return;
+  }
+  messages_.push_back(std::move(message));
+  Pump();
+}
+
+void PushMessagingService::Impl::Pump() {
+  if (!Enabled() || !ready_ || processing_) {
+    return;
+  }
+  if (messages_.empty()) {
+    if (backpressured_) {
+      Retry();
+    }
+    return;
+  }
+  processing_ = true;
+  auto message = std::move(messages_.front());
+  messages_.pop_front();
+  const std::string channel = *message.FindString("channelID");
+  const std::string version = *message.FindString("version");
+  std::string ciphertext_digest = "payload-less";
+  if (const auto* data = message.FindString("data"); data && !data->empty()) {
+    const auto ciphertext = DecodeUrl(*data);
+    ciphertext_digest =
+        ciphertext ? Digest(*ciphertext) : "invalid:" + Digest(*data);
+  }
+  const std::string message_digest = Digest(uaid_ + "\n" + channel + "\n" +
+                                            version + "\n" + ciphertext_digest);
+  const auto binding = bindings_.find(channel);
+  const std::string binding_digest =
+      binding == bindings_.end() ? Digest(channel)
+                                 : BindingDigest(channel, binding->second);
+  const auto decision =
+      journal_.Admit(message_digest, binding_digest, base::Time::Now());
+  if (decision.action == PushDeliveryDecision::Action::kBackpressure) {
+    processing_ = false;
+    Retry();
+    return;
+  }
+  if (decision.action == PushDeliveryDecision::Action::kReplayAck) {
+    const uint64_t epoch = epoch_;
+    Save(base::BindOnce(
+        [](base::WeakPtr<Impl> self, uint64_t epoch, std::string message_digest,
+           std::string channel, std::string version, PushAck ack, bool saved) {
+          if (!self || self->epoch_ != epoch) {
+            return;
+          }
+          if (saved && self->Enabled()) {
+            if (ack != PushAck::kNotDelivered && !self->Authorized(channel)) {
+              self->FinishMessage(message_digest, channel, version, epoch,
+                                  PushAck::kNotDelivered);
+              return;
+            }
+            self->processing_ = false;
+            self->Acknowledge(channel, version, ack);
+            self->Pump();
+          } else {
+            self->processing_ = false;
+          }
+        },
+        weak_.GetWeakPtr(), epoch, message_digest, channel, version,
+        decision.ack));
+    return;
+  }
+  Save(base::BindOnce(&Impl::Dispatch, weak_.GetWeakPtr(), std::move(message),
+                      message_digest, channel, version, epoch_));
+}
+
+void PushMessagingService::Impl::Dispatch(base::DictValue message,
+                                          std::string message_digest,
+                                          std::string channel,
+                                          std::string version,
+                                          uint64_t epoch,
+                                          bool saved) {
+  if (epoch != epoch_) {
+    return;
+  }
+  if (!saved || !Enabled()) {
+    processing_ = false;
+    return;
+  }
+  auto binding = bindings_.find(channel);
+  if (binding == bindings_.end() || !Permitted(binding->second.origin)) {
+    Erase(channel);
+    FinishMessage(message_digest, channel, version, epoch,
+                  PushAck::kNotDelivered);
+    return;
+  }
+  std::optional<std::string> payload;
+  const auto* data_value = message.Find("data");
+  const auto* data = message.FindString("data");
+  const auto* headers = message.FindDict("headers");
+  const auto* encoding = headers ? headers->FindString("encoding") : nullptr;
+  if ((data_value && !data) || (data && data->size() > 24 * 1024)) {
+    FinishMessage(message_digest, channel, version, epoch,
+                  PushAck::kBadCiphertext);
+    return;
+  }
+  if ((data && !data->empty()) || encoding) {
+    const auto ciphertext = data ? DecodeUrl(*data) : std::nullopt;
+    if (!encoding || *encoding != "aes128gcm" || !ciphertext ||
+        ciphertext->empty() || ciphertext->size() > 16 * 1024) {
+      FinishMessage(message_digest, channel, version, epoch,
+                    PushAck::kBadCiphertext);
+      return;
+    }
+    auto decrypted =
+        DecryptPushPayload(base::as_byte_span(*ciphertext),
+                           *binding->second.key, binding->second.auth);
+    if (!decrypted) {
+      FinishMessage(message_digest, channel, version, epoch,
+                    PushAck::kBadCiphertext);
+      return;
+    }
+    payload = std::move(*decrypted);
+  }
+  const GURL origin = binding->second.origin;
+  const int64_t registration = binding->second.registration;
+  owner_->DeliverMessageWithDispatchSignal(
+      profile_, origin, registration, message_digest, std::move(payload),
+      base::BindOnce(
+          [](base::WeakPtr<Impl> self, uint64_t epoch, std::string channel,
+             GURL origin, int64_t registration) {
+            if (!self || self->epoch_ != epoch || !self->Enabled() ||
+                !self->Permitted(origin)) {
+              return false;
+            }
+            const auto binding = self->bindings_.find(channel);
+            return binding != self->bindings_.end() &&
+                   binding->second.origin == origin &&
+                   binding->second.registration == registration;
+          },
+          weak_.GetWeakPtr(), epoch, channel, origin, registration),
+      base::BindOnce(&Impl::Delivered, weak_.GetWeakPtr(), message_digest,
+                     channel, version, origin, registration, epoch));
+}
+
+void PushMessagingService::Impl::Delivered(std::string message_digest,
+                                           std::string channel,
+                                           std::string version,
+                                           GURL origin,
+                                           int64_t registration,
+                                           uint64_t epoch,
+                                           EventStatus status,
+                                           bool dispatched) {
+  if (dispatched) {
+    if (!notifications_) {
+      notifications_ =
+          std::make_unique<PushMessagingNotificationManager>(profile_);
+    }
+    notifications_->EnforceUserVisibleOnlyRequirements(
+        origin, registration,
+        base::BindOnce(
+            [](base::WeakPtr<Impl> self, std::string message_digest,
+               std::string channel, std::string version, uint64_t epoch, bool) {
+              if (self && self->epoch_ == epoch) {
+                self->FinishMessage(message_digest, channel, version, epoch,
+                                    PushAck::kHandled);
+              }
+            },
+            weak_.GetWeakPtr(), message_digest, channel, version, epoch),
+        /*user_visible_only_bypass=*/false);
+    return;
+  }
+  if (epoch != epoch_) {
+    return;
+  }
+  switch (status) {
+    case EventStatus::UNKNOWN_APP_ID:
+    case EventStatus::NO_SERVICE_WORKER:
+    case EventStatus::PERMISSION_DENIED:
+    case EventStatus::PERMISSION_REVOKED_ABUSIVE:
+    case EventStatus::PERMISSION_REVOKED_DISRUPTIVE:
+    case EventStatus::NO_APP_LEVEL_PERMISSION_UNSUBSCRIBE:
+      Erase(channel);
+      FinishMessage(message_digest, channel, version, epoch,
+                    PushAck::kNotDelivered);
+      return;
+    case EventStatus::NO_APP_LEVEL_PERMISSION_IGNORE:
+      Error("System notification permission blocks Push delivery");
+      FinishMessage(message_digest, channel, version, epoch,
+                    PushAck::kNotDelivered);
+      return;
+    case EventStatus::SUCCESS:
+    case EventStatus::SERVICE_WORKER_ERROR:
+    case EventStatus::EVENT_WAITUNTIL_REJECTED:
+    case EventStatus::TIMEOUT:
+      processing_ = false;
+      Retry();
+      return;
+  }
+}
+
+void PushMessagingService::Impl::FinishMessage(std::string message_digest,
+                                               std::string channel,
+                                               std::string version,
+                                               uint64_t epoch,
+                                               PushAck ack) {
+  if (epoch != epoch_ || !Enabled()) {
+    return;
+  }
+  const auto binding = bindings_.find(channel);
+  if (binding != bindings_.end() && !Permitted(binding->second.origin)) {
+    Erase(channel);
+    ack = PushAck::kNotDelivered;
+  }
+  const auto current_binding = bindings_.find(channel);
+  journal_.Complete(message_digest,
+                    current_binding == bindings_.end()
+                        ? Digest(channel)
+                        : BindingDigest(channel, current_binding->second),
+                    ack, base::Time::Now());
+  Save(base::BindOnce(
+      [](base::WeakPtr<Impl> self, std::string message_digest,
+         std::string channel, std::string version, uint64_t epoch, PushAck ack,
+         bool saved) {
+        if (!self || self->epoch_ != epoch) {
+          return;
+        }
+        if (saved && self->Enabled()) {
+          if (ack != PushAck::kNotDelivered && !self->Authorized(channel)) {
+            self->FinishMessage(message_digest, channel, version, epoch,
+                                PushAck::kNotDelivered);
+            return;
+          }
+          self->processing_ = false;
+          self->Acknowledge(channel, version, ack);
+          self->Pump();
+        } else {
+          self->processing_ = false;
+        }
+      },
+      weak_.GetWeakPtr(), message_digest, channel, version, epoch, ack));
+}
+
+void PushMessagingService::Impl::Acknowledge(const std::string& channel,
+                                             const std::string& version,
+                                             PushAck ack) {
+  if (!ready_) {
+    return;
+  }
+  base::ListValue updates;
+  updates.Append(base::DictValue()
+                     .Set("channelID", channel)
+                     .Set("version", version)
+                     .Set("code", static_cast<int>(ack)));
+  Send(base::DictValue()
+           .Set("messageType", "ack")
+           .Set("updates", std::move(updates)));
+}
+
+namespace {
+
+class PushFactory final : public ProfileKeyedServiceFactory {
+ public:
+  static PushFactory* GetInstance() {
+    static base::NoDestructor<PushFactory> instance;
+    return instance.get();
+  }
+
+  PushMessagingService* GetForProfile(Profile* profile) {
+    return static_cast<PushMessagingService*>(
+        GetServiceForBrowserContext(profile, true));
+  }
+
+  PushFactory()
+      : ProfileKeyedServiceFactory(
+            "StainlessPushMessaging",
+            ProfileSelections::Builder()
+                .WithRegular(ProfileSelection::kOriginalOnly)
+                .WithGuest(ProfileSelection::kNone)
+                .WithSystem(ProfileSelection::kNone)
+                .Build()) {
+    DependsOn(HostContentSettingsMapFactory::GetInstance());
+    DependsOn(PermissionManagerFactory::GetInstance());
+  }
+
+ private:
+  std::unique_ptr<KeyedService> BuildServiceInstanceForBrowserContext(
+      content::BrowserContext* context) const override {
+    return std::make_unique<PushMessagingService>(
+        Profile::FromBrowserContext(context));
+  }
+
+  void RegisterProfilePrefs(
+      user_prefs::PrefRegistrySyncable* registry) override {
+    registry->RegisterDictionaryPref(kPushConfigurationPref);
+  }
+
+  bool ServiceIsCreatedWithBrowserContext() const override { return true; }
+};
+
+}  // namespace
+
+PushMessagingService::PushMessagingService(Profile* profile)
+    : impl_(std::make_unique<Impl>(this, profile)) {}
+
+PushMessagingService::~PushMessagingService() = default;
+
+base::expected<void, std::string> PushMessagingService::Configure(
+    const GURL& connection,
+    const GURL& publisher,
+    bool enabled) {
+  return impl_->Configure(connection, publisher, enabled);
+}
+
+base::DictValue PushMessagingService::GetStatus() const {
+  return impl_->Status();
+}
+
+void PushMessagingService::ResetRegistrations() {
+  impl_->ResetRegistrations();
+}
+
+void PushMessagingService::SubscribeFromDocument(
+    const GURL& origin,
+    int64_t registration,
+    int process,
+    int frame,
+    blink::mojom::PushSubscriptionOptionsPtr options,
+    bool user_gesture,
+    RegisterCallback callback) {
+  impl_->Subscribe(origin, registration, process, frame, std::move(options),
+                   user_gesture, std::move(callback));
+}
+
+void PushMessagingService::SubscribeFromWorker(
+    const GURL& origin,
+    int64_t registration,
+    int process,
+    blink::mojom::PushSubscriptionOptionsPtr options,
+    RegisterCallback callback) {
+  impl_->Subscribe(origin, registration, process, -1, std::move(options), false,
+                   std::move(callback));
+}
+
+void PushMessagingService::GetSubscriptionInfo(
+    const GURL& origin,
+    int64_t registration,
+    const std::string& sender,
+    const std::string& subscription,
+    SubscriptionInfoCallback callback) {
+  impl_->GetInfo(origin, registration, sender, subscription,
+                 std::move(callback));
+}
+
+bool PushMessagingService::IsSubscriptionStorageAvailable() const {
+  return impl_->StorageAvailable();
+}
+
+void PushMessagingService::DidFailToStoreSubscription(
+    const GURL& origin,
+    int64_t registration,
+    const std::string& subscription,
+    base::OnceClosure callback) {
+  impl_->FailedStore(origin, registration, subscription, std::move(callback));
+}
+
+void PushMessagingService::Unsubscribe(blink::mojom::PushUnregistrationReason,
+                                       const GURL& origin,
+                                       int64_t registration,
+                                       const std::string&,
+                                       UnregisterCallback callback) {
+  impl_->Unsubscribe(origin, registration, std::move(callback));
+}
+
+bool PushMessagingService::SupportNonVisibleMessages() {
+  return false;
+}
+
+void PushMessagingService::DidDeleteServiceWorkerRegistration(
+    const GURL& origin,
+    int64_t registration) {
+  impl_->DeleteRegistration(origin, registration);
+}
+
+void PushMessagingService::DidDeleteServiceWorkerDatabase() {
+  impl_->DeleteDatabase();
+}
+
+void PushMessagingService::Shutdown() {
+  impl_->Shutdown();
+}
+
+PushMessagingService* GetPushMessagingService(Profile* profile) {
+  if (!profile || profile->IsOffTheRecord() || !profile->IsRegularProfile()) {
+    return nullptr;
+  }
+  return PushFactory::GetInstance()->GetForProfile(profile);
+}
+
+void EnsurePushMessagingServiceFactory() {
+  PushFactory::GetInstance();
+}
+
+}  // namespace stainless
