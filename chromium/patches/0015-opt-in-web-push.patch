+  Binding& operator=(Binding&&);
+  Binding(const Binding&) = delete;
+  Binding& operator=(const Binding&) = delete;
+
+  GURL origin;
+  int64_t registration = -1;
+  std::string vapid;
+  GURL endpoint;
+  std::optional<crypto::keypair::PrivateKey> key;
+  std::string auth;
+};
