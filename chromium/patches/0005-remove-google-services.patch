+class StainlessPolicyProvider final : public ConfigurationPolicyProvider {
+ public:
+  StainlessPolicyProvider() { Publish(); }
+
+  void RefreshPolicies(PolicyFetchReason) override { Publish(); }
+
+ private:
+  void Publish() {
+    PolicyBundle bundle;
+    PolicyMap& policies =
+        bundle.Get(PolicyNamespace(POLICY_DOMAIN_CHROME, std::string()));
+    auto set = [&policies](const char* name, base::Value value) {
+      policies.Set(name, POLICY_LEVEL_MANDATORY, POLICY_SCOPE_MACHINE,
+                   POLICY_SOURCE_STAINLESS, std::move(value), nullptr);
+    };
+    for (const char* name :
+         {"AccessibilityImageLabelsEnabled", "AlternateErrorPagesEnabled",
+          "AutofillCreditCardEnabled", "CloudReportingEnabled",
+          "CloudProfileReportingEnabled", "EnableMediaRouter",
+          "LiveCaptionEnabled", "LiveTranslateEnabled",
+          "MetricsReportingEnabled", "PasswordLeakDetectionEnabled",
+          "PrivacySandboxAdMeasurementEnabled", "PrivacySandboxAdTopicsEnabled",
+          "PrivacySandboxSiteEnabledAdsEnabled", "SearchSuggestEnabled",
+          "SpellCheckServiceEnabled", "TranslateEnabled",
+          "UrlKeyedAnonymizedDataCollectionEnabled", "UserFeedbackAllowed",
+          "PolicyTestPageEnabled"}) {
+      set(name, base::Value(false));
+    }
+    set("BrowserSignin", base::Value(0));
+    set("SyncDisabled", base::Value(true));
+    set("SafeBrowsingProtectionLevel", base::Value(0));
+    set("NetworkPredictionOptions", base::Value(2));
+    set("DefaultGeolocationSetting", base::Value(2));
+    set("GenAiDefaultSettings", base::Value(2));
+    UpdatePolicy(std::move(bundle));
+  }
+};
 }  // namespace
 
