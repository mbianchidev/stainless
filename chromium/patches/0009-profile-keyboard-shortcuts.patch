+  auto* focus_manager =
+      BrowserView::GetBrowserViewForBrowser(browser())->GetFocusManager();
+  ui::Accelerator extension_key(ui::VKEY_J, kCustomModifiers);
+  focus_manager->RegisterAccelerator(
+      extension_key, ui::AcceleratorManager::kHighPriority, &extension);
+  base::ScopedClosureRunner unregister(
+      base::BindOnce(&views::FocusManager::UnregisterAccelerator,
+                     base::Unretained(focus_manager), extension_key,
+                     base::Unretained(&extension)));
+  ASSERT_TRUE(Record(editor, IDC_NEW_TAB, ui::VKEY_J));
+  EXPECT_FALSE(editor->apply_->GetEnabled());
+  Dispatch(browser(), ui::VKEY_J);
+  EXPECT_EQ(1, extension.invocations);
+  EXPECT_EQ(count, browser()->GetTabStripModel()->count());
+  ASSERT_TRUE(Record(editor, IDC_FIND, ui::VKEY_K));
+  Apply(editor);
+  Close(editor);
