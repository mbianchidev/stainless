+void StainlessShortcutEditorView::OnDoubleClick() {
+  Record();
+}
+
+void StainlessShortcutEditorView::OnKeyDown(ui::KeyboardCode key_code) {
+  if (key_code == ui::VKEY_RETURN) {
+    Record();
+  }
