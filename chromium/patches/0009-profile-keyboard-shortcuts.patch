+StainlessShortcutEditorView* StainlessShortcutEditorView::Show(
+    BrowserWindowInterface* browser) {
+  if (!browser || browser->IsDeleteScheduled()) {
+    LOG(WARNING) << "Stainless shortcut editor has no live browser owner";
+    return nullptr;
+  }
+  if (auto* editor = Get(browser->GetUnownedUserDataHost())) {
+    if (!editor->GetWidget()->IsClosed()) {
+      editor->GetWidget()->Activate();
+    }
+    return editor;
+  }
+  if (!chrome::CanExecuteStainlessBrowserAction(browser,
+                                                IDC_SHOW_COMMAND_PALETTE)) {
+    LOG(WARNING) << "Stainless shortcut editor is unavailable for this window";
+    return nullptr;
+  }
+  auto* owner = BrowserView::GetBrowserViewForBrowser(browser);
+  auto contents = std::make_unique<StainlessShortcutEditorView>(browser);
+  auto* editor = contents.get();
+  auto dialog = std::make_unique<views::DialogDelegate>();
+  dialog->SetTitle(l10n_util::GetStringUTF16(IDS_STAINLESS_SHORTCUTS));
+  dialog->SetButtons(static_cast<int>(ui::mojom::DialogButton::kCancel));
+  dialog->SetButtonLabel(
+      ui::mojom::DialogButton::kCancel,
+      l10n_util::GetStringUTF16(IDS_STAINLESS_COMMAND_PALETTE_CLOSE));
+  dialog->SetDefaultButton(static_cast<int>(ui::mojom::DialogButton::kNone));
+  dialog->set_margins(
+      ChromeLayoutProvider::Get()->GetDialogInsetsForContentType(
+          views::DialogContentType::kControl,
+          views::DialogContentType::kControl));
+  dialog->SetInitiallyFocusedView(editor->table_);
+  dialog->SetContentsView(std::move(contents));
+  auto* widget = views::DialogDelegate::CreateDialogWidget(
+      std::move(dialog), gfx::NativeWindow(),
+      owner->GetWidget()->GetNativeView());
+  widget->SetProperty(stainless::kShortcutEditorWindow, true);
+  editor->widget_observation_.Observe(widget);
+  editor->focus_manager_ = widget->GetFocusManager();
+  editor->focus_manager_->AddFocusChangeListener(editor);
+  widget->Show();
+  return editor;
+}
