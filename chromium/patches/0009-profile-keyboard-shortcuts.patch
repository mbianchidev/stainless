+constexpr int kCustomModifiers =
+    ui::EF_COMMAND_DOWN | ui::EF_CONTROL_DOWN | ui::EF_SHIFT_DOWN;
+
+NSWindow* NativeWindow(BrowserWindowInterface* browser) {
+  return BrowserView::GetBrowserViewForBrowser(browser)
+      ->GetWidget()
+      ->GetNativeWindow()
+      .GetNativeNSWindow();
+}
+
+NSEvent* NativeKey(NSWindow* window, ui::KeyboardCode key, int flags) {
+  NSUInteger modifiers =
+      ((flags & ui::EF_COMMAND_DOWN) ? NSEventModifierFlagCommand : 0) |
+      ((flags & ui::EF_CONTROL_DOWN) ? NSEventModifierFlagControl : 0) |
+      ((flags & ui::EF_SHIFT_DOWN) ? NSEventModifierFlagShift : 0) |
+      ((flags & ui::EF_ALT_DOWN) ? NSEventModifierFlagOption : 0);
+  unichar shifted;
+  unichar unshifted;
+  int code =
+      ui::MacKeyCodeForWindowsKeyCode(key, modifiers, &shifted, &unshifted);
+  CHECK_GE(code, 0);
+  NSString* characters = [NSString stringWithFormat:@"%C", shifted];
+  return [NSEvent keyEventWithType:NSEventTypeKeyDown
+                          location:NSZeroPoint
+                     modifierFlags:modifiers
+                         timestamp:0
+                      windowNumber:window.windowNumber
+                           context:nil
+                        characters:characters
+       charactersIgnoringModifiers:characters
+                         isARepeat:NO
+                           keyCode:code];
+}
+
+NSMenuItem* MenuItem(NSMenu* menu, int command) {
+  for (NSMenuItem* item in menu.itemArray) {
+    if (item.tag == command) {
+      return item;
+    }
+    if (NSMenuItem* child = MenuItem(item.submenu, command)) {
+      return child;
+    }
+  }
+  return nil;
+}
