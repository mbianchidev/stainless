+  Action(owner, IDC_NEW_TAB)->SetVisible(true);
+  owner->GetTabStripModel()->SetTabBlocked(
+      owner->GetTabStripModel()->active_index(), true);
+  Dispatch(owner, ui::VKEY_K);
+  EXPECT_EQ(count, owner->GetTabStripModel()->count());
+  owner->GetTabStripModel()->SetTabBlocked(
+      owner->GetTabStripModel()->active_index(), false);
+  auto dialog = std::make_unique<views::DialogDelegate>();
+  dialog->SetModalType(ui::mojom::ModalType::kWindow);
+  auto* modal = views::DialogDelegate::CreateDialogWidget(
+      std::move(dialog), gfx::NativeWindow(),
+      BrowserView::GetBrowserViewForBrowser(owner)
+          ->GetWidget()
+          ->GetNativeView());
+  auto modal_lifetime = modal->GetWeakPtr();
+  modal->Show();
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return modal->GetNativeWindow().GetNativeNSWindow().visible; }));
+  Dispatch(owner, ui::VKEY_K);
+  EXPECT_EQ(count, owner->GetTabStripModel()->count());
+  modal->Close();
+  ASSERT_TRUE(base::test::RunUntil([&] { return !modal_lifetime; }));
+  ASSERT_TRUE(Dispatch(owner, ui::VKEY_K));
+  EXPECT_EQ(count + 1, owner->GetTabStripModel()->count());
+  auto* other = CreateBrowser(owner->GetProfile());
+  auto* editor = Open(other);
+  ASSERT_TRUE(editor);
+  views::ViewTracker lifetime;
+  lifetime.SetView(editor);
+  CloseBrowserSynchronously(other);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(nullptr, lifetime.view());
