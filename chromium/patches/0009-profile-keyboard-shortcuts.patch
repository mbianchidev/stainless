+  content::SimulateKeyPress(contents, ui::DomKey::FromCharacter('k'),
+                            ui::DomCode::US_K, ui::VKEY_K, false, false, false,
+                            false);
+  EXPECT_EQ("k",
+            content::EvalJs(contents, "document.querySelector('input').value"));
+  EXPECT_FALSE(chrome::CanCloseFind(browser()));
+  ASSERT_TRUE(Dispatch(browser(), ui::VKEY_K));
+  EXPECT_TRUE(chrome::CanCloseFind(browser()));
+  chrome::CloseFind(browser());
+  EXPECT_EQ(count, browser()->GetTabStripModel()->count());
+}
