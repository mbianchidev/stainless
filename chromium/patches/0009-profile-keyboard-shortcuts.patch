+
+void StainlessShortcutEditorView::ShowStatus(int message) {
+  status_->SetText(l10n_util::GetStringUTF16(message));
+}
+
+void StainlessShortcutEditorView::Record() {
+  if (!record_->GetEnabled()) {
+    return;
+  }
+  pending_.reset();
+  SetRecording(true);
+  confirming_reset_ = false;
+  reset_->SetText(l10n_util::GetStringUTF16(IDS_STAINLESS_SHORTCUT_RESET));
+  capture_->SetText(std::u16string());
+  apply_->SetEnabled(false);
+  ShowStatus(IDS_STAINLESS_SHORTCUT_RECORDING);
+  capture_->RequestFocus();
+}
+
+void StainlessShortcutEditorView::SetRecording(bool recording) {
+  recording_ = recording;
+  if (auto* widget = GetWidget()) {
+    widget->SetProperty(stainless::kShortcutCaptureActive, recording);
+  }
+}
+
+void StainlessShortcutEditorView::CancelRecording() {
+  SetRecording(false);
+  pending_.reset();
+  ShowStatus(IDS_STAINLESS_SHORTCUT_CANCELED);
+  Refresh();
+}
+
+bool StainlessShortcutEditorView::HandleKeyEvent(views::Textfield* sender,
+                                                 const ui::KeyEvent& event) {
+  if (sender != capture_ || !recording_ ||
+      event.type() != ui::EventType::kKeyPressed) {
+    return false;
+  }
+  if (sender->IsIMEComposing() || event.key_code() == ui::VKEY_PROCESSKEY ||
+      event.GetDomKey().IsDeadKey()) {
+    ShowStatus(IDS_STAINLESS_SHORTCUT_UNSUPPORTED);
+    return false;
+  }
+  if (event.flags() & ui::EF_IS_REPEAT) {
+    return true;
+  }
+  if (event.key_code() == ui::VKEY_ESCAPE && !event.IsShiftDown() &&
+      !event.IsControlDown() && !event.IsAltDown() && !event.IsCommandDown()) {
+    CancelRecording();
+    record_->RequestFocus();
+    return true;
+  }
+  if (event.key_code() == ui::VKEY_SHIFT ||
+      event.key_code() == ui::VKEY_CONTROL ||
+      event.key_code() == ui::VKEY_MENU || event.key_code() == ui::VKEY_LWIN ||
+      event.key_code() == ui::VKEY_RWIN) {
+    return true;
+  }
+  Stage(ui::Accelerator(event.key_code(),
+                        ui::Accelerator::MaskOutKeyEventFlags(event.flags())));
+  return true;
+}
+
+bool StainlessShortcutEditorView::AcceleratorPressed(
+    const ui::Accelerator& accelerator) {
+  if (recording_ && !capture_->IsIMEComposing() &&
+      accelerator == ui::Accelerator(ui::VKEY_ESCAPE, ui::EF_NONE)) {
+    CancelRecording();
+    record_->RequestFocus();
+    return true;
+  }
+  return false;
+}
+
+void StainlessShortcutEditorView::Stage(const ui::Accelerator& accelerator) {
+  auto command = SelectedCommand();
+  if (!browser_ || !command) {
+    ShowStatus(IDS_STAINLESS_SHORTCUT_UNAVAILABLE);
+    return;
+  }
+  auto error = stainless::ValidateShortcut(browser_->GetProfile(), *command,
+                                           accelerator);
+  if (error.empty() && !accelerator.IsEmpty() &&
+      BrowserView::GetBrowserViewForBrowser(browser_)
+          ->GetFocusManager()
+          ->HasPriorityHandler(accelerator)) {
+    error = l10n_util::GetStringUTF16(IDS_STAINLESS_SHORTCUT_CONFLICT);
+  }
+  pending_.reset();
+  confirming_reset_ = false;
+  reset_->SetText(l10n_util::GetStringUTF16(IDS_STAINLESS_SHORTCUT_RESET));
+  if (!error.empty()) {
+    apply_->SetEnabled(false);
+    status_->SetText(error);
+    return;
+  }
+  SetRecording(false);
+  pending_ = accelerator;
+  capture_->SetText(ShortcutLabel(accelerator));
+  apply_->SetEnabled(true);
+  ShowStatus(IDS_STAINLESS_SHORTCUT_READY);
+  apply_->RequestFocus();
+}
+
+void StainlessShortcutEditorView::Apply() {
+  if (!browser_ || browser_->IsDeleteScheduled() || !pending_) {
+    ShowStatus(IDS_STAINLESS_SHORTCUT_UNAVAILABLE);
+    return;
+  }
+  auto command = SelectedCommand();
+  if (!command) {
+    ShowStatus(IDS_STAINLESS_SHORTCUT_UNAVAILABLE);
+    return;
+  }
+  const auto candidate = *pending_;
+  if (!candidate.IsEmpty() && BrowserView::GetBrowserViewForBrowser(browser_)
+                                  ->GetFocusManager()
+                                  ->HasPriorityHandler(candidate)) {
+    ShowStatus(IDS_STAINLESS_SHORTCUT_CONFLICT);
+    return;
+  }
+  auto error =
+      stainless::SetShortcut(browser_->GetProfile(), *command, candidate);
+  if (!error.empty()) {
+    status_->SetText(error);
+    return;
+  }
+  pending_.reset();
+  SetRecording(false);
+  Refresh();
+  ShowStatus(browser_->GetProfile()->IsOffTheRecord()
+                 ? IDS_STAINLESS_SHORTCUT_PRIVATE_APPLIED
+                 : IDS_STAINLESS_SHORTCUT_APPLIED);
+}
+
+void StainlessShortcutEditorView::UseDefault() {
+  if (auto command = SelectedCommand()) {
+    Stage(stainless::DefaultShortcut(*command));
+  }
+}
+
+void StainlessShortcutEditorView::ResetAll() {
+  if (!browser_ || browser_->IsDeleteScheduled()) {
+    ShowStatus(IDS_STAINLESS_SHORTCUT_UNAVAILABLE);
+    return;
+  }
+  SetRecording(false);
+  pending_.reset();
+  if (!confirming_reset_) {
+    confirming_reset_ = true;
+    apply_->SetEnabled(false);
+    reset_->SetText(
+        l10n_util::GetStringUTF16(IDS_STAINLESS_SHORTCUT_RESET_CONFIRM));
+    ShowStatus(IDS_STAINLESS_SHORTCUT_RESET_PROMPT);
+    return;
+  }
+  auto error = stainless::ResetShortcuts(browser_->GetProfile());
+  if (!error.empty()) {
+    status_->SetText(error);
+    return;
+  }
+  confirming_reset_ = false;
+  reset_->SetText(l10n_util::GetStringUTF16(IDS_STAINLESS_SHORTCUT_RESET));
+  Refresh();
+  ShowStatus(IDS_STAINLESS_SHORTCUT_RESET_DONE);
+}
+
+void StainlessShortcutEditorView::OnWillChangeFocus(views::View* before,
+                                                    views::View* now) {}
+
+void StainlessShortcutEditorView::OnDidChangeFocus(views::View* before,
+                                                   views::View* now) {
+  if (recording_ && before == capture_ && now != capture_) {
+    CancelRecording();
+  }
+}
+
+void StainlessShortcutEditorView::OnBrowserClosed(
+    BrowserWindowInterface* browser) {
+  SetRecording(false);
+  pref_registrar_.RemoveAll();
+  registration_.reset();
+  browser_ = nullptr;
+  GetWidget()->Close();
+}
+
+void StainlessShortcutEditorView::OnWidgetDestroyed(views::Widget* widget) {
+  SetRecording(false);
+  focus_manager_->RemoveFocusChangeListener(this);
+  focus_manager_ = nullptr;
+  widget_observation_.Reset();
+  auto browser = browser_ ? browser_->GetWeakPtr()
+                          : base::WeakPtr<BrowserWindowInterface>();
+  registration_.reset();
+  pref_registrar_.RemoveAll();
+  browser_close_subscription_ = {};
+  browser_ = nullptr;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::WeakPtr<BrowserWindowInterface> browser,
+             std::unique_ptr<views::ViewTracker> focus) {
+            if (!browser || browser->IsDeleteScheduled()) {
+              return;
+            }
+            if (focus->view() && focus->view()->IsDrawn() &&
+                focus->view()->IsFocusable()) {
+              focus->view()->RequestFocus();
+            } else if (auto* contents = browser->GetTabStripModel()
+                                            ->GetActiveWebContents()) {
+              contents->Focus();
+            }
+          },
+          std::move(browser), std::move(return_focus_)));
+}
+
+void StainlessShortcutEditorView::OnWidgetActivationChanged(
+    views::Widget* widget,
+    bool active) {
+  if (!active && recording_) {
+    CancelRecording();
+  }
+}
+
+namespace chrome {
+
+void ShowKeyboardShortcuts(BrowserWindowInterface* browser) {
+  StainlessShortcutEditorView::Show(browser);
+}
+
+}  // namespace chrome
+
+BEGIN_METADATA(StainlessShortcutEditorView)
+END_METADATA
