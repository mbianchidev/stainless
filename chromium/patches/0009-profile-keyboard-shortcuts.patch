+StainlessShortcutEditorView::StainlessShortcutEditorView(
+    BrowserWindowInterface* browser)
+    : browser_(browser), return_focus_(std::make_unique<views::ViewTracker>()) {
+  registration_.emplace(browser->GetUnownedUserDataHost(), *this);
+  auto* owner_focus =
+      BrowserView::GetBrowserViewForBrowser(browser)->GetFocusManager();
+  return_focus_->SetView(owner_focus->GetFocusedView()
+                             ? owner_focus->GetFocusedView()
+                             : owner_focus->GetStoredFocusView());
+  browser_close_subscription_ = browser->RegisterBrowserDidClose(
+      base::BindRepeating(&StainlessShortcutEditorView::OnBrowserClosed,
+                          base::Unretained(this)));
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(),
+      ChromeLayoutProvider::Get()->GetDistanceMetric(
+          views::DISTANCE_RELATED_CONTROL_VERTICAL)));
+  auto add_label = [this](int message) {
+    auto* label = AddChildView(
+        std::make_unique<views::Label>(l10n_util::GetStringUTF16(message)));
+    label->SetMultiLine(true);
+    label->SetHorizontalAlignment(gfx::HorizontalAlignment::ALIGN_LEFT);
+    return label;
+  };
+  add_label(browser->GetProfile()->IsOffTheRecord()
+                ? IDS_STAINLESS_SHORTCUT_INCOGNITO
+                : IDS_STAINLESS_SHORTCUT_PROFILE);
+  add_label(IDS_STAINLESS_SHORTCUT_HINT);
+  ui::TableColumn command(IDS_STAINLESS_COMMAND_PALETTE_COMMAND,
+                          ui::TableColumn::LEFT, -1, 1);
+  ui::TableColumn current(IDS_STAINLESS_COMMAND_PALETTE_SHORTCUT,
+                          ui::TableColumn::RIGHT, 125, 0);
+  ui::TableColumn original(IDS_STAINLESS_SHORTCUT_DEFAULT,
+                           ui::TableColumn::RIGHT, 125, 0);
+  auto table = std::make_unique<views::TableView>(
+      this, std::vector{command, current, original},
+      views::TableType::kTextOnly, true);
+  table_ = table.get();
+  table_->set_observer(this);
+  table_->GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_STAINLESS_SHORTCUT_ACTIONS));
+  auto* scroll = AddChildView(
+      views::TableView::CreateScrollViewWithTable(std::move(table)));
+  scroll->ClipHeightTo(240, 240);
+  scroll->SetHorizontalScrollBarMode(
+      views::ScrollView::ScrollBarMode::kDisabled);
+  scroll->SetAllowKeyboardScrolling(false);
+  capture_ = AddChildView(std::make_unique<views::Textfield>());
+  capture_->SetReadOnly(true);
+  capture_->SetPlaceholderText(
+      l10n_util::GetStringUTF16(IDS_STAINLESS_SHORTCUT_CAPTURE));
+  capture_->GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_STAINLESS_SHORTCUT_CAPTURE));
+  capture_->set_controller(this);
+  auto* buttons = AddChildView(std::make_unique<views::View>());
+  buttons->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal, gfx::Insets(), 8));
+  auto button = [buttons](int message,
+                          views::Button::PressedCallback callback) {
+    return buttons->AddChildView(std::make_unique<views::MdTextButton>(
+        std::move(callback), l10n_util::GetStringUTF16(message)));
+  };
+  record_ = button(IDS_STAINLESS_SHORTCUT_RECORD,
+                   base::BindRepeating(&StainlessShortcutEditorView::Record,
+                                       base::Unretained(this)));
+  remove_ =
+      button(IDS_STAINLESS_SHORTCUT_REMOVE,
+             base::BindRepeating(&StainlessShortcutEditorView::Stage,
+                                 base::Unretained(this), ui::Accelerator()));
+  use_default_ =
+      button(IDS_STAINLESS_SHORTCUT_USE_DEFAULT,
+             base::BindRepeating(&StainlessShortcutEditorView::UseDefault,
+                                 base::Unretained(this)));
+  apply_ = button(IDS_STAINLESS_SHORTCUT_SAVE,
+                  base::BindRepeating(&StainlessShortcutEditorView::Apply,
+                                      base::Unretained(this)));
+  reset_ = AddChildView(std::make_unique<views::MdTextButton>(
+      base::BindRepeating(&StainlessShortcutEditorView::ResetAll,
+                          base::Unretained(this)),
+      l10n_util::GetStringUTF16(IDS_STAINLESS_SHORTCUT_RESET)));
+  status_ = add_label(IDS_STAINLESS_SHORTCUT_SELECT);
+  status_->GetViewAccessibility().SetRole(ax::mojom::Role::kStatus);
+  status_->GetViewAccessibility().SetLiveRegionContainer(
+      views::ViewAccessibility::LiveRegionStatus::kPolite);
+  AddAccelerator(ui::Accelerator(ui::VKEY_ESCAPE, ui::EF_NONE));
+  pref_registrar_.Init(browser->GetProfile()->GetPrefs());
+  pref_registrar_.Add(stainless::kKeyboardShortcutsPref,
+                      base::BindRepeating(&StainlessShortcutEditorView::Refresh,
+                                          base::Unretained(this)));
+  SetPreferredSize(gfx::Size(760, 680));
+  table_->Select(0);
+  Refresh();
+}
