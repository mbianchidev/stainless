diff --git a/chrome/browser/ui/cocoa/stainless_shortcuts_mac.mm b/chrome/browser/ui/cocoa/stainless_shortcuts_mac.mm
new file mode 100644
index 0000000000000000000000000000000000000000..292a44074b92bea815ed67a86aeeaf866b61d01e
--- /dev/null
+++ b/chrome/browser/ui/cocoa/stainless_shortcuts_mac.mm
@@ -0,0 +1,414 @@
+// Copyright 2026 Synctune Open
+
+#include "chrome/browser/ui/cocoa/stainless_shortcuts_mac.h"
+
+#import <AppKit/AppKit.h>
+#include <Carbon/Carbon.h>
+
+#include <algorithm>
+#include <utility>
+
+#include "base/apple/scoped_cftyperef.h"
+#include "base/logging.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/values.h"
+#include "chrome/browser/global_keyboard_shortcuts_mac.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/cocoa/accelerators_cocoa.h"
+#include "chrome/browser/ui/stainless_browser_actions.h"
+#include "chrome/common/stainless_switches.h"
+#include "chrome/grit/branded_strings.h"
+#include "components/prefs/pref_service.h"
+#include "ui/base/accelerators/platform_accelerator_cocoa.h"
+#include "ui/base/cocoa/nsmenuitem_additions.h"
+#include "ui/base/l10n/l10n_util.h"
+#include "ui/events/keycodes/keyboard_code_conversion_mac.h"
+
+namespace stainless {
+
+DEFINE_UI_CLASS_PROPERTY_KEY(bool, kShortcutEditorWindow, false)
+DEFINE_UI_CLASS_PROPERTY_KEY(bool, kShortcutCaptureActive, false)
+
+namespace {
+
+bool HasAppShortcuts() {
+  return [NSUserDefaults.standardUserDefaults
+             dictionaryForKey:@"NSUserKeyEquivalents"]
+             .count != 0;
+}
+
+bool IsSupportedAccelerator(int command, const ui::Accelerator& accelerator) {
+  if (accelerator.IsEmpty()) {
+    return true;
+  }
+  constexpr int kModifiers =
+      ui::EF_COMMAND_DOWN | ui::EF_CONTROL_DOWN | ui::EF_SHIFT_DOWN;
+  const bool letter = accelerator.key_code() >= ui::VKEY_A &&
+                      accelerator.key_code() <= ui::VKEY_Z;
+  const bool number = accelerator.key_code() >= ui::VKEY_0 &&
+                      accelerator.key_code() <= ui::VKEY_9;
+  return accelerator.key_state() == ui::Accelerator::KeyState::PRESSED &&
+         !accelerator.IsRepeat() && !accelerator.interrupted_by_mouse_event() &&
+         (accelerator == DefaultShortcut(command) ||
+          ((letter || number) && accelerator.IsCmdDown() &&
+           (accelerator.modifiers() & ~kModifiers) == 0));
+}
+
+NSEvent* EventForShortcut(const ui::Accelerator& accelerator) {
+  NSUInteger modifiers = 0;
+  if (accelerator.IsCmdDown()) {
+    modifiers |= NSEventModifierFlagCommand;
+  }
+  if (accelerator.IsCtrlDown()) {
+    modifiers |= NSEventModifierFlagControl;
+  }
+  if (accelerator.IsShiftDown()) {
+    modifiers |= NSEventModifierFlagShift;
+  }
+  if (accelerator.IsAltDown()) {
+    modifiers |= NSEventModifierFlagOption;
+  }
+  unichar shifted;
+  unichar unshifted;
+  int code = ui::MacKeyCodeForWindowsKeyCode(accelerator.key_code(), modifiers,
+                                             &shifted, &unshifted);
+  if (code < 0) {
+    return nil;
+  }
+  NSString* characters = [NSString stringWithFormat:@"%C", shifted];
+  return [NSEvent keyEventWithType:NSEventTypeKeyDown
+                          location:NSZeroPoint
+                     modifierFlags:modifiers
+                         timestamp:0
+                      windowNumber:0
+                           context:nil
+                        characters:characters
+       charactersIgnoringModifiers:characters
+                         isARepeat:NO
+                           keyCode:code];
+}
+
+ui::Accelerator HiddenShortcut(const KeyboardShortcutData& shortcut) {
+  int modifiers = (shortcut.command_key ? ui::EF_COMMAND_DOWN : 0) |
+                  (shortcut.cntrl_key ? ui::EF_CONTROL_DOWN : 0) |
+                  (shortcut.shift_key ? ui::EF_SHIFT_DOWN : 0) |
+                  (shortcut.opt_key ? ui::EF_ALT_DOWN : 0);
+  return ui::Accelerator(ui::KeyboardCodeFromKeyCode(shortcut.vkey_code),
+                         modifiers);
+}
+
+bool MenuConflicts(NSMenu* menu, NSEvent* event, int command) {
+  for (NSMenuItem* item in menu.itemArray) {
+    if (item.tag != command && !IsShortcutCommand(item.tag) &&
+        [item cr_firesForKeyEquivalentEvent:event]) {
+      return true;
+    }
+    if (item.submenu && MenuConflicts(item.submenu, event, command)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+std::u16string ConfigurationConflict(const ShortcutOverrides& overrides,
+                                     int command,
+                                     const ui::Accelerator& accelerator) {
+  if (accelerator.IsEmpty()) {
+    return {};
+  }
+  if (!accelerator.IsCtrlDown() && accelerator.IsShiftDown() &&
+      accelerator.key_code() >= ui::VKEY_3 &&
+      accelerator.key_code() <= ui::VKEY_6) {
+    return l10n_util::GetStringUTF16(IDS_STAINLESS_SHORTCUT_RESERVED);
+  }
+  if (!accelerator.IsCtrlDown() && !accelerator.IsAltDown() &&
+      std::ranges::contains(
+          std::array{ui::VKEY_A, ui::VKEY_B, ui::VKEY_C, ui::VKEY_I, ui::VKEY_K,
+                     ui::VKEY_U, ui::VKEY_V, ui::VKEY_X, ui::VKEY_Z},
+          accelerator.key_code())) {
+    return l10n_util::GetStringUTF16(IDS_STAINLESS_SHORTCUT_RESERVED);
+  }
+  NSEvent* event = EventForShortcut(accelerator);
+  if (!event) {
+    return l10n_util::GetStringUTF16(IDS_STAINLESS_SHORTCUT_UNSUPPORTED);
+  }
+  for (const auto& action : kShortcutActions) {
+    auto it = overrides.find(action.command_id);
+    auto key =
+        it == overrides.end() ? DefaultShortcut(action.command_id) : it->second;
+    if (action.command_id != command && ShortcutMatchesEvent(key, event)) {
+      return l10n_util::GetStringUTF16(IDS_STAINLESS_SHORTCUT_CONFLICT);
+    }
+  }
+  for (const auto& [id, key] : *AcceleratorsCocoa::GetInstance()) {
+    if (id != command && !overrides.contains(id) &&
+        !(command == IDC_OPTIONS && id == IDC_WEB_APP_SETTINGS) &&
+        ShortcutMatchesEvent(key, event)) {
+      return l10n_util::GetStringUTF16(IsShortcutCommand(id)
+                                           ? IDS_STAINLESS_SHORTCUT_CONFLICT
+                                           : IDS_STAINLESS_SHORTCUT_RESERVED);
+    }
+  }
+  for (const auto& shortcut : GetShortcutsNotPresentInMainMenu()) {
+    if (shortcut.chrome_command != command &&
+        !overrides.contains(shortcut.chrome_command) &&
+        ShortcutMatchesEvent(HiddenShortcut(shortcut), event)) {
+      return l10n_util::GetStringUTF16(
+          IsShortcutCommand(shortcut.chrome_command)
+              ? IDS_STAINLESS_SHORTCUT_CONFLICT
+              : IDS_STAINLESS_SHORTCUT_RESERVED);
+    }
+  }
+  if (MenuConflicts(NSApp.mainMenu, event, command)) {
+    return l10n_util::GetStringUTF16(IDS_STAINLESS_SHORTCUT_RESERVED);
+  }
+  // The macOS Dictionary lookup is a text-system command, not an NSMenu item.
+  if (accelerator ==
+      ui::Accelerator(ui::VKEY_D, ui::EF_COMMAND_DOWN | ui::EF_CONTROL_DOWN)) {
+    return l10n_util::GetStringUTF16(IDS_STAINLESS_SHORTCUT_RESERVED);
+  }
+  return {};
+}
+
+std::u16string SystemConflict(const ui::Accelerator& accelerator,
+                              CFArrayRef hotkeys) {
+  if (accelerator.IsEmpty()) {
+    return {};
+  }
+  NSEvent* event = EventForShortcut(accelerator);
+  if (!event) {
+    return l10n_util::GetStringUTF16(IDS_STAINLESS_SHORTCUT_UNSUPPORTED);
+  }
+  const uint32_t modifiers = (accelerator.IsCmdDown() ? cmdKey : 0) |
+                             (accelerator.IsCtrlDown() ? controlKey : 0) |
+                             (accelerator.IsShiftDown() ? shiftKey : 0) |
+                             (accelerator.IsAltDown() ? optionKey : 0);
+  for (NSDictionary* hotkey in (__bridge NSArray*)hotkeys) {
+    if ([hotkey[(__bridge NSString*)kHISymbolicHotKeyEnabled] boolValue] &&
+        [hotkey[(__bridge NSString*)kHISymbolicHotKeyCode] unsignedIntValue] ==
+            event.keyCode &&
+        [hotkey[(__bridge NSString*)kHISymbolicHotKeyModifiers]
+            unsignedIntValue] == modifiers) {
+      return l10n_util::GetStringUTF16(IDS_STAINLESS_SHORTCUT_RESERVED);
+    }
+  }
+  return {};
+}
+
+void UpdateMenu(NSMenu* menu, const ShortcutOverrides& overrides) {
+  for (NSMenuItem* item in menu.itemArray) {
+    if (IsShortcutCommand(item.tag)) {
+      auto it = overrides.find(item.tag);
+      auto* original =
+          AcceleratorsCocoa::GetInstance()->GetAcceleratorForCommand(item.tag);
+      ui::Accelerator accelerator =
+          it != overrides.end() ? it->second
+                                : (original ? *original : ui::Accelerator());
+      if (accelerator.IsEmpty()) {
+        item.keyEquivalent = @"";
+        item.keyEquivalentModifierMask = 0;
+      } else {
+        auto* equivalent =
+            ui::GetKeyEquivalentAndModifierMaskFromAccelerator(accelerator);
+        item.keyEquivalent = equivalent.keyEquivalent;
+        item.keyEquivalentModifierMask = equivalent.modifierMask;
+      }
+    }
+    if (item.submenu) {
+      UpdateMenu(item.submenu, overrides);
+    }
+  }
+}
+
+std::u16string ReportRejected(std::u16string error) {
+  if (!error.empty()) {
+    LOG(WARNING) << "Stainless shortcut change rejected: "
+                 << base::UTF16ToUTF8(error);
+  }
+  return error;
+}
+
+}  // namespace
+
+ui::Accelerator DefaultShortcut(int command_id) {
+  ui::Accelerator accelerator;
+  if (IsShortcutCommand(command_id)) {
+    GetDefaultMacAcceleratorForCommandId(command_id, &accelerator);
+  }
+  return accelerator;
+}
+
+bool ShortcutMatchesEvent(const ui::Accelerator& accelerator, NSEvent* event) {
+  if (accelerator.IsEmpty()) {
+    return false;
+  }
+  auto* equivalent =
+      ui::GetKeyEquivalentAndModifierMaskFromAccelerator(accelerator);
+  NSMenuItem* item =
+      [[NSMenuItem alloc] initWithTitle:@""
+                                 action:nil
+                          keyEquivalent:equivalent.keyEquivalent];
+  item.keyEquivalentModifierMask = equivalent.modifierMask;
+  return [item cr_firesForKeyEquivalentEvent:event];
+}
+
+base::expected<ShortcutOverrides, std::u16string> ReadShortcutOverrides(
+    Profile* profile) {
+  ShortcutOverrides overrides;
+  if (!profile || IsStartupSafeMode()) {
+    return overrides;
+  }
+  auto* prefs = profile->GetPrefs();
+  const auto* user_value = prefs->GetUserPrefValue(kKeyboardShortcutsPref);
+  const auto malformed = [] {
+    return base::unexpected(
+        l10n_util::GetStringUTF16(IDS_STAINLESS_SHORTCUT_INVALID_SAVED));
+  };
+  if (user_value && !user_value->is_dict()) {
+    return malformed();
+  }
+  const auto& values = prefs->GetDict(kKeyboardShortcutsPref);
+  if (values.empty()) {
+    return overrides;
+  }
+  if (HasAppShortcuts()) {
+    return base::unexpected(
+        l10n_util::GetStringUTF16(IDS_STAINLESS_SHORTCUT_APP_SHORTCUTS));
+  }
+  for (const auto [name, value] : values) {
+    auto action =
+        std::ranges::find(kShortcutActions, name, &BrowserAction::pref_key);
+    const auto* dict = value.GetIfDict();
+    if (action == kShortcutActions.end() || !dict || dict->size() != 2) {
+      return malformed();
+    }
+    auto key = dict->FindInt("key");
+    auto modifiers = dict->FindInt("modifiers");
+    if (!key || !modifiers ||
+        (*modifiers & ~ui::Accelerator::MaskOutKeyEventFlags(*modifiers))) {
+      return malformed();
+    }
+    ui::Accelerator accelerator(static_cast<ui::KeyboardCode>(*key),
+                                *modifiers);
+    if (!IsSupportedAccelerator(action->command_id, accelerator)) {
+      return malformed();
+    }
+    overrides.emplace(action->command_id, accelerator);
+  }
+  base::apple::ScopedCFTypeRef<CFArrayRef> hotkeys;
+  if (CopySymbolicHotKeys(hotkeys.InitializeInto()) != noErr) {
+    return base::unexpected(
+        l10n_util::GetStringUTF16(IDS_STAINLESS_SHORTCUT_SYSTEM_UNAVAILABLE));
+  }
+  for (const auto& [command, key] : overrides) {
+    auto error = ConfigurationConflict(overrides, command, key);
+    if (error.empty()) {
+      error = SystemConflict(key, hotkeys.get());
+    }
+    if (!error.empty()) {
+      return base::unexpected(
+          l10n_util::GetStringUTF16(IDS_STAINLESS_SHORTCUT_INVALID_SAVED) +
+          u" " + error);
+    }
+  }
+  return overrides;
+}
+
+ui::Accelerator ShortcutForCommand(Profile* profile, int command_id) {
+  auto overrides = ReadShortcutOverrides(profile);
+  if (overrides.has_value()) {
+    auto it = overrides->find(command_id);
+    if (it != overrides->end()) {
+      return it->second;
+    }
+  }
+  return DefaultShortcut(command_id);
+}
+
+std::u16string ShortcutEditingError(Profile* profile) {
+  if (IsStartupSafeMode()) {
+    return l10n_util::GetStringUTF16(IDS_STAINLESS_SHORTCUT_SAFE_MODE);
+  }
+  if (!profile || profile->IsGuestSession() || profile->IsSystemProfile() ||
+      profile->GetPrefs()->ReadOnly() ||
+      !profile->GetPrefs()
+           ->FindPreference(kKeyboardShortcutsPref)
+           ->IsUserModifiable()) {
+    return l10n_util::GetStringUTF16(IDS_STAINLESS_SHORTCUT_READ_ONLY);
+  }
+  if (HasAppShortcuts()) {
+    return l10n_util::GetStringUTF16(IDS_STAINLESS_SHORTCUT_APP_SHORTCUTS);
+  }
+  return {};
+}
+
+std::u16string ValidateShortcut(Profile* profile,
+                                int command_id,
+                                const ui::Accelerator& accelerator) {
+  if (auto error = ShortcutEditingError(profile); !error.empty()) {
+    return error;
+  }
+  if (!IsShortcutCommand(command_id) ||
+      !IsSupportedAccelerator(command_id, accelerator)) {
+    return l10n_util::GetStringUTF16(IDS_STAINLESS_SHORTCUT_UNSUPPORTED);
+  }
+  auto overrides = ReadShortcutOverrides(profile);
+  if (!overrides.has_value()) {
+    return overrides.error();
+  }
+  (*overrides)[command_id] = accelerator;
+  auto error = ConfigurationConflict(*overrides, command_id, accelerator);
+  if (!error.empty() || accelerator.IsEmpty()) {
+    return error;
+  }
+  base::apple::ScopedCFTypeRef<CFArrayRef> hotkeys;
+  if (CopySymbolicHotKeys(hotkeys.InitializeInto()) != noErr) {
+    return l10n_util::GetStringUTF16(IDS_STAINLESS_SHORTCUT_SYSTEM_UNAVAILABLE);
+  }
+  return SystemConflict(accelerator, hotkeys.get());
+}
+
+std::u16string SetShortcut(Profile* profile,
+                           int command_id,
+                           const ui::Accelerator& accelerator) {
+  auto error = ValidateShortcut(profile, command_id, accelerator);
+  if (!error.empty()) {
+    return ReportRejected(std::move(error));
+  }
+  auto values = profile->GetPrefs()->GetDict(kKeyboardShortcutsPref).Clone();
+  auto action = std::ranges::find(kShortcutActions, command_id,
+                                  &BrowserAction::command_id);
+  if (accelerator == DefaultShortcut(command_id)) {
+    values.Remove(action->pref_key);
+  } else {
+    values.Set(action->pref_key,
+               base::DictValue()
+                   .Set("key", static_cast<int>(accelerator.key_code()))
+                   .Set("modifiers", accelerator.modifiers()));
+  }
+  profile->GetPrefs()->SetDict(kKeyboardShortcutsPref, std::move(values));
+  profile->GetPrefs()->CommitPendingWrite();
+  return {};
+}
+
+std::u16string ResetShortcuts(Profile* profile) {
+  auto error = ShortcutEditingError(profile);
+  if (!error.empty()) {
+    return ReportRejected(std::move(error));
+  }
+  // Set an empty overlay in Incognito; ClearPref would inherit saved overrides.
+  profile->GetPrefs()->SetDict(kKeyboardShortcutsPref, base::DictValue());
+  profile->GetPrefs()->CommitPendingWrite();
+  return {};
+}
+
+void UpdateMainMenuShortcuts(Profile* profile) {
+  if (HasAppShortcuts()) {
+    return;
+  }
+  auto overrides = ReadShortcutOverrides(profile);
+  UpdateMenu(NSApp.mainMenu,
+             overrides.has_value() ? *overrides : ShortcutOverrides());
+}
+
+}  // namespace stainless
