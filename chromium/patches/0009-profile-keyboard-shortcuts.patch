+size_t StainlessShortcutEditorView::RowCount() const {
+  return stainless::kShortcutActions.size();
+}
+
+std::u16string StainlessShortcutEditorView::GetText(size_t row,
+                                                    int column_id) const {
+  if (!browser_) {
+    return {};
+  }
+  int command = stainless::kShortcutActions.at(row).command_id;
+  if (column_id == IDS_STAINLESS_COMMAND_PALETTE_COMMAND) {
+    auto* action = actions::ActionManager::Get().FindAction(
+        *chrome::GetActionIdForCommandId(command),
+        BrowserActions::From(browser_)->root_action_item());
+    return action ? chrome::GetCleanText(std::u16string(action->GetText()))
+                  : std::u16string();
+  }
+  return ShortcutLabel(
+      column_id == IDS_STAINLESS_SHORTCUT_DEFAULT
+          ? stainless::DefaultShortcut(command)
+          : stainless::ShortcutForCommand(browser_->GetProfile(), command));
+}
+
+void StainlessShortcutEditorView::SetObserver(
+    ui::TableModelObserver* observer) {
+  model_observer_ = observer;
+}
+
+std::optional<int> StainlessShortcutEditorView::SelectedCommand() const {
+  auto row = table_->GetFirstSelectedRow();
+  return row && *row < RowCount()
+             ? std::optional(stainless::kShortcutActions[*row].command_id)
+             : std::nullopt;
+}
+
+void StainlessShortcutEditorView::Refresh() {
+  if (!browser_ || (GetWidget() && GetWidget()->IsClosed())) {
+    return;
+  }
+  refreshing_ = true;
+  auto row = table_->GetFirstSelectedRow();
+  if (model_observer_) {
+    model_observer_->OnModelChanged();
+  }
+  table_->Select(row);
+  refreshing_ = false;
+  if (!pending_ && !recording_) {
+    if (auto command = SelectedCommand()) {
+      capture_->SetText(ShortcutLabel(
+          stainless::ShortcutForCommand(browser_->GetProfile(), *command)));
+    }
+  }
+  auto error = stainless::ShortcutEditingError(browser_->GetProfile());
+  bool editable = error.empty();
+  auto saved = stainless::ReadShortcutOverrides(browser_->GetProfile());
+  record_->SetEnabled(editable && saved.has_value() && SelectedCommand());
+  remove_->SetEnabled(record_->GetEnabled());
+  use_default_->SetEnabled(record_->GetEnabled());
+  apply_->SetEnabled(record_->GetEnabled() && pending_.has_value());
+  reset_->SetEnabled(editable);
+  if (!error.empty() || !saved.has_value()) {
+    status_->SetText(error.empty() ? saved.error() : error);
+  }
+}
+
+void StainlessShortcutEditorView::OnSelectionChanged() {
+  if (refreshing_) {
+    return;
+  }
+  SetRecording(false);
+  pending_.reset();
+  confirming_reset_ = false;
+  if (reset_) {
+    reset_->SetText(l10n_util::GetStringUTF16(IDS_STAINLESS_SHORTCUT_RESET));
+    ShowStatus(IDS_STAINLESS_SHORTCUT_SELECT);
+    Refresh();
+  }
+}
