+std::u16string ShortcutLabel(const ui::Accelerator& accelerator) {
+  return accelerator.IsEmpty()
+             ? l10n_util::GetStringUTF16(IDS_STAINLESS_SHORTCUT_NONE)
+             : accelerator.GetShortcutText();
