+           {ui::VKEY_K, ui::EF_COMMAND_DOWN | ui::EF_ALT_DOWN,
+            IDS_STAINLESS_SHORTCUT_UNSUPPORTED},
+           {ui::VKEY_C, ui::EF_COMMAND_DOWN, IDS_STAINLESS_SHORTCUT_RESERVED},
+           {ui::VKEY_P, ui::EF_COMMAND_DOWN, IDS_STAINLESS_SHORTCUT_RESERVED},
+           {ui::VKEY_Q, ui::EF_COMMAND_DOWN, IDS_STAINLESS_SHORTCUT_RESERVED},
+           {ui::VKEY_N, ui::EF_COMMAND_DOWN, IDS_STAINLESS_SHORTCUT_CONFLICT},
