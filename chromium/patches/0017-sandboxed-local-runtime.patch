@@ -0,0 +1,130 @@
+module stainless_local.mojom;
+
+import "mojo/public/mojom/base/big_buffer.mojom";
+import "mojo/public/mojom/base/file.mojom";
+import "sandbox/policy/mojom/context.mojom";
+import "sandbox/policy/mojom/sandbox.mojom";
+
+enum Status {
+  kOk,
+  kInvalidInput,
+  kInvalidModel,
+  kUnavailable,
+  kFailed,
+  kResourceLimit,
+  kCancelled,
+  kQueueFull,
+  kTimedOut,
+  kNotAllowed,
+  kNoSpeech,
+};
+
+struct ModelFile {
+  string name;
+  mojo_base.mojom.ReadOnlyFile file;
+  uint64 size;
+  array<uint8, 32> sha256;
+};
+
+struct TranslationModel {
+  array<ModelFile> files;
+  ModelFile source_tokenizer;
+  ModelFile target_tokenizer;
+};
+
+struct Bitmap {
+  uint32 width;
+  uint32 height;
+  uint32 stride;
+  mojo_base.mojom.BigBuffer pixels;
+};
+
+union Image {
+  mojo_base.mojom.BigBuffer encoded;
+  Bitmap bitmap;
+};
+
+struct TranslationRequest {
+  TranslationModel model;
+  string text;
+};
+
+struct OcrRequest {
+  ModelFile model;
+  string language;
+  Image image;
+};
+
+struct SpeechRequest {
+  ModelFile model;
+  array<int16> pcm;
+  string language;
+};
+
+struct DescriptionRequest {
+  ModelFile model;
+  ModelFile projector;
+  Image image;
+};
+
+union Request {
+  TranslationRequest translation;
+  OcrRequest ocr;
+  SpeechRequest speech;
+  DescriptionRequest description;
+};
+
+struct Word {
+  string text;
+  double confidence;
+  int32 left;
+  int32 top;
+  int32 width;
+  int32 height;
+  uint32 line_index;
+  int32 line_left;
+  int32 line_top;
+  int32 line_width;
+  int32 line_height;
+  double line_confidence;
+};
+
+struct Result {
+  Status status;
+  string detail;
+  string text;
+  array<Word> words;
+  uint32 image_width;
+  uint32 image_height;
+  SpeechMetrics? speech;
+  DescriptionEvidence? description;
+  // The browser replaces this field with its own watchdog measurements.
+  WorkerUsage? worker_usage;
+};
+
+struct WorkerUsage {
+  uint64 sampled_peak_rss_bytes;
+  uint64 samples;
+  uint64 maximum_sample_gap_microseconds;
+};
+
+struct SpeechMetrics {
+  bool has_metrics;
+  double average_log_probability;
+  double no_speech_probability;
+};
+
+struct DescriptionEvidence {
+  string raw_text;
+  uint32 generated_tokens;
+  bool measured_uniform_color;
+};
+
+[ServiceSandbox=sandbox.mojom.Sandbox.kUtility,
+ RequireContext=sandbox.mojom.Context.kBrowser]
+interface LocalWorker {
+  Translate(TranslationModel model, string text) => (Result result);
+  ReadImageText(ModelFile model, string language, Image image) => (Result result);
+  RecognizeSpeech(ModelFile model, array<int16> pcm, string language) => (Result result);
+  DescribeImage(ModelFile model, ModelFile projector, Image image) => (Result result);
+};
diff --git a/chrome/services/stainless_local/public/stainless_local_runtime.h b/chrome/services/stainless_local/public/stainless_local_runtime.h
new file mode 100644
index 0000000000000000000000000000000000000000..0dcb9750c280a6f8a7468e7e1b84a8b87f374e44
