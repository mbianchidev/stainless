+  const auto directory =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValuePath(
+          "stainless-native-ocr-fixture");
+  ASSERT_TRUE(directory.IsAbsolute());
+  std::string data;
+  ASSERT_TRUE(
+      base::ReadFileToString(directory.AppendASCII("fixture.json"), &data));
+  auto decoded = base::JSONReader::Read(data, base::JSON_PARSE_RFC);
+  ASSERT_TRUE(decoded && decoded->is_dict());
+  const auto& fixture = decoded->GetDict();
+  const auto* hash = fixture.FindString("corpus_sha256");
+  ASSERT_TRUE(hash);
+  ASSERT_EQ("972d9c126b3ddb194846832d6feefc2f869ea14ed1312fe9ee53aca4e60972aa",
+            *hash);
+  const auto* cases = fixture.FindList("cases");
+  ASSERT_TRUE(cases);
+  ASSERT_EQ(6u, cases->size());
+  browser()->GetProfile()->GetPrefs()->SetBoolean(kOcrEnabled, true);
+  for (const auto& test : *cases) {
