diff --git a/third_party/webrtc_overrides/stainless_vad.cc b/third_party/webrtc_overrides/stainless_vad.cc
new file mode 100644
index 0000000000000000000000000000000000000000..1cf09bcbb99ccf300db5dd100f0b34b9f331489f
--- /dev/null
+++ b/third_party/webrtc_overrides/stainless_vad.cc
@@ -0,0 +1,43 @@
+#include "third_party/webrtc_overrides/stainless_vad.h"
+
+#include <array>
+#include <memory>
+
+#include "third_party/webrtc/common_audio/vad/include/webrtc_vad.h"
+
+namespace stainless_local {
+
+base::expected<bool, std::string> ContainsSpeech(
+    base::span<const int16_t> pcm) {
+  if (pcm.empty() || pcm.size() > 480000) {
+    return base::unexpected("Invalid bounded 16 kHz local speech PCM");
+  }
+  std::unique_ptr<VadInst, decltype(&WebRtcVad_Free)> vad(WebRtcVad_Create(),
+                                                          WebRtcVad_Free);
+  if (!vad || WebRtcVad_Init(vad.get()) != 0 ||
+      WebRtcVad_set_mode(vad.get(), 3) != 0) {
+    return base::unexpected(
+        "Local speech activity detector initialization failed");
+  }
+  std::array<int, 5> window = {};
+  size_t position = 0;
+  int voiced = 0;
+  for (size_t offset = 0; offset + 320 <= pcm.size(); offset += 320) {
+    const auto frame = pcm.subspan(offset, 320u);
+    const int active =
+        WebRtcVad_Process(vad.get(), 16000, frame.data(), frame.size());
+    if (active < 0) {
+      return base::unexpected("Local speech activity detector rejected PCM");
+    }
+    voiced -= window[position];
+    window[position] = active;
+    voiced += active;
+    position = (position + 1) % window.size();
+    if (voiced >= 3) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace stainless_local
