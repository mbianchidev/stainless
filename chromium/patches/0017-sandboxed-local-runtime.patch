+LocalBroker::Prepared PrepareFixture(const base::FilePath& root,
+                                     const base::DictValue& fixture,
+                                     const base::DictValue& test, bool encoded,
+                                     bool wrong_digest) {
+  LocalBroker::Prepared prepared;
+  const auto* language = test.FindString("language");
+  const auto* models = fixture.FindDict("models");
+  const auto* model =
+      language && models ? models->FindDict(*language) : nullptr;
+  const auto* model_name = model ? model->FindString("file") : nullptr;
+  const auto* model_sha = model ? model->FindString("sha256") : nullptr;
+  const auto size = model ? model->FindInt("bytes") : std::nullopt;
+  const auto* image_name = test.FindString(encoded ? "encoded_file" : "file");
+  const auto* image_sha =
+      test.FindString(encoded ? "encoded_sha256" : "sha256");
+  if (!language || !model_name || !model_sha || !size || !image_name ||
+      !image_sha ||
+      base::FilePath(*model_name).BaseName().value() != *model_name ||
+      base::FilePath(*image_name).BaseName().value() != *image_name) {
+    ADD_FAILURE() << "Invalid synthetic native fixture metadata";
+    return prepared;
+  }
+  std::string bytes;
+  if (!base::ReadFileToString(root.AppendASCII(*image_name), &bytes) ||
+      base::HexEncodeLower(crypto::hash::Sha256(bytes)) != *image_sha) {
+    ADD_FAILURE() << "Synthetic fixture pixels changed";
+    return prepared;
+  }
+  auto request = mojom::OcrRequest::New();
+  request->model = mojom::ModelFile::New();
+  request->model->name = *language + ".traineddata";
+  request->model->file =
+      base::File(root.AppendASCII(*model_name),
+                 base::File::FLAG_OPEN | base::File::FLAG_READ);
+  request->model->size = *size;
+  if (!request->model->file.IsValid() ||
+      !base::HexStringToBytes(*model_sha, &request->model->sha256) ||
+      request->model->sha256.size() != 32) {
+    ADD_FAILURE() << "Synthetic fixture model cannot be opened";
+    return prepared;
+  }
+  if (wrong_digest) {
+    request->model->sha256[0] ^= 1;
+  }
+  request->language = *language;
+  if (encoded) {
+    request->image = mojom::Image::NewEncoded(
+        mojo_base::BigBuffer(base::as_byte_span(bytes)));
+  } else {
+    auto bitmap = mojom::Bitmap::New();
+    bitmap->width = fixture.FindInt("width").value_or(0);
+    bitmap->height = fixture.FindInt("height").value_or(0);
+    bitmap->stride = bitmap->width * 4;
+    bitmap->pixels = mojo_base::BigBuffer(base::as_byte_span(bytes));
+    request->image = mojom::Image::NewBitmap(std::move(bitmap));
+  }
+  prepared.request = mojom::Request::NewOcr(std::move(request));
+  return prepared;
+}
