+class LocalBroker : public content::ServiceProcessHost::Observer {
+ public:
+  struct Prepared {
+    Prepared();
+    ~Prepared();
+    Prepared(Prepared&&);
+    Prepared& operator=(Prepared&&);
+
+    mojom::RequestPtr request;
+    std::vector<base::File> leases;
+  };
+
+  using Reply = base::OnceCallback<void(mojom::ResultPtr)>;
+  using Ready = base::OnceCallback<void(Prepared)>;
+  // Capture descriptors/document references only. Fetch pixels and open model
+  // leases only when admission invokes this callback.
+  using Prepare = base::OnceCallback<void(Ready)>;
+
+  static LocalBroker& Get();
+  base::UnguessableToken Submit(content::RenderFrameHost* frame,
+                                Feature feature, Prepare prepare, Reply reply);
+  void Cancel(const base::UnguessableToken& id);
+
+ private:
+  friend class base::NoDestructor<LocalBroker>;
+  struct Job;
+
+  LocalBroker();
+  ~LocalBroker() override;
+  void StartNext();
+  void OnPrepared(base::UnguessableToken id, Prepared prepared);
+  void OnProcess(base::UnguessableToken id, const base::Process& process);
+  void OnServiceProcessLaunched(
+      const content::ServiceProcessInfo& info) override;
+  void OnServiceProcessTerminatedNormally(
+      const content::ServiceProcessInfo& info) override;
+  void OnServiceProcessCrashed(
+      const content::ServiceProcessInfo& info) override;
+  void OnExited(const content::ServiceProcessInfo& info, bool crashed);
+  void Complete(mojom::ResultPtr result);
+  void OnWatchdog(base::UnguessableToken id, int event);
+  void OnResult(base::UnguessableToken id, mojom::ResultPtr result);
+  void Sweep();
+  void Stop(const base::UnguessableToken& id, mojom::Status status);
+  void Finish(mojom::ResultPtr result, bool terminate);
+  bool Matches(const base::UnguessableToken& id) const;
+  bool Permitted(const Job& job) const;
+
+  std::deque<std::unique_ptr<Job>> queued_;
+  std::unique_ptr<Job> active_;
+  mojo::Remote<mojom::LocalWorker> worker_;
+  base::Process process_;
+  base::Time process_created_;
+  std::optional<content::ServiceProcessId> service_id_;
+  base::SequenceBound<ResourceWatchdog> watchdog_;
+  scoped_refptr<base::SequencedTaskRunner> watchdog_runner_;
+  base::RepeatingTimer timer_;
+  bool termination_failed_ = false;
+  base::WeakPtrFactory<LocalBroker> weak_{this};
+};
+
