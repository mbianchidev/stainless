+namespace stainless_local {
+
+inline constexpr char kTranslationEnabled[] =
+    "stainless.local_services.translation.enabled";
+inline constexpr char kOcrEnabled[] = "stainless.local_services.ocr.enabled";
+
+enum class Feature { kTranslation, kOcr };
+
+bool IsEligibleProfile(Profile* profile);
+void RegisterProfilePrefs(PrefRegistrySimple* registry);
+
+class ResourceWatchdog;
+
+class LocalBroker {
+ public:
+  struct Prepared {
+    Prepared();
+    ~Prepared();
+    Prepared(Prepared&&);
+    Prepared& operator=(Prepared&&);
+
+    mojom::RequestPtr request;
+    std::vector<base::File> leases;
+  };
+
+  using Reply = base::OnceCallback<void(mojom::ResultPtr)>;
+  using Ready = base::OnceCallback<void(Prepared)>;
+  // Capture descriptors/document references only. Fetch pixels and open model
+  // leases only when admission invokes this callback.
+  using Prepare = base::OnceCallback<void(Ready)>;
+
+  static LocalBroker& Get();
