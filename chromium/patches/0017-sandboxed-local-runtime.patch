@@ -0,0 +1,85 @@
+module stainless_local.mojom;
+
+import "mojo/public/mojom/base/big_buffer.mojom";
+import "mojo/public/mojom/base/file.mojom";
+import "sandbox/policy/mojom/context.mojom";
+import "sandbox/policy/mojom/sandbox.mojom";
+
+enum Status {
+  kOk,
+  kInvalidInput,
+  kInvalidModel,
+  kUnavailable,
+  kFailed,
+  kResourceLimit,
+  kCancelled,
+  kQueueFull,
+  kTimedOut,
+  kNotAllowed,
+};
+
+struct ModelFile {
+  string name;
+  mojo_base.mojom.ReadOnlyFile file;
+  uint64 size;
+  array<uint8, 32> sha256;
+};
+
+struct TranslationModel {
+  array<ModelFile> files;
+  ModelFile source_tokenizer;
+  ModelFile target_tokenizer;
+};
+
+struct Bitmap {
+  uint32 width;
+  uint32 height;
+  uint32 stride;
+  mojo_base.mojom.BigBuffer pixels;
+};
+
+union Image {
+  mojo_base.mojom.BigBuffer encoded;
+  Bitmap bitmap;
+};
+
+struct TranslationRequest {
+  TranslationModel model;
+  string text;
+};
+
+struct OcrRequest {
+  ModelFile model;
+  string language;
+  Image image;
+};
+
+union Request {
+  TranslationRequest translation;
+  OcrRequest ocr;
+};
+
+struct Word {
+  string text;
+  double confidence;
+  int32 left;
+  int32 top;
+  int32 width;
+  int32 height;
+};
+
+struct Result {
+  Status status;
+  string detail;
+  string text;
+  array<Word> words;
+  uint32 image_width;
+  uint32 image_height;
+};
+
+[ServiceSandbox=sandbox.mojom.Sandbox.kUtility,
+ RequireContext=sandbox.mojom.Context.kBrowser]
+interface LocalWorker {
+  Translate(TranslationModel model, string text) => (Result result);
+  ReadImageText(ModelFile model, string language, Image image) => (Result result);
+};
