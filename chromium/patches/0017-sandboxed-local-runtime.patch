+                PrepareDescription(directory, fixture, test, false, true));
+          },
+          directory, fixture.Clone(), (*cases)[0].GetDict().Clone()),
+      rejected.GetCallback());
+  EXPECT_EQ(mojom::Status::kInvalidModel, rejected.Get()->status);
+  EXPECT_TRUE(rejected.Get()->text.empty());
+}
+
+}  // namespace stainless_local
