+IN_PROC_BROWSER_TEST_F(StainlessLocalWorkerBrowserTest,
+                       DisabledNeverAdmitsModelOrImagePreparation) {
+  for (const auto feature :
+       {Feature::kTranslation, Feature::kOcr, Feature::kSpeech,
+        Feature::kCaptions, Feature::kImageDescriptions}) {
+    int admitted = 0;
+    base::test::TestFuture<mojom::ResultPtr> result;
+    const auto id = LocalBroker::Get().Submit(
+        frame(), feature,
+        base::BindOnce([](int* admitted, LocalBroker::Ready) { ++*admitted; },
+                       &admitted),
+        result.GetCallback());
+    EXPECT_TRUE(id.is_empty());
+    EXPECT_EQ(mojom::Status::kNotAllowed, result.Get()->status);
+    EXPECT_EQ(0, admitted);
+  }
+}
+
+IN_PROC_BROWSER_TEST_F(StainlessLocalWorkerBrowserTest,
+                       ModelLeasesAndNextAdmissionWaitForTheActualWorkerExit) {
+  base::ScopedAllowBlockingForTesting allow_blocking;
+  base::ScopedTempDir directory;
+  ASSERT_TRUE(directory.CreateUniqueTempDir());
+  const auto model_path = directory.GetPath().AppendASCII("model");
+  const auto lease_path = directory.GetPath().AppendASCII("lease");
+  ASSERT_TRUE(base::WriteFile(model_path, "synthetic"));
+  ASSERT_TRUE(base::WriteFile(lease_path, "owned lease"));
+  base::File probe(lease_path, base::File::FLAG_OPEN | base::File::FLAG_READ |
+                                   base::File::FLAG_WRITE);
+  ASSERT_TRUE(probe.IsValid());
+  browser()->GetProfile()->GetPrefs()->SetBoolean(kOcrEnabled, true);
+  for (const bool cancel_before_process_launch : {false, true}) {
+    base::RunLoop admitted;
+    base::test::TestFuture<mojom::ResultPtr> second;
+    LocalBroker::Ready delayed;
+    base::UnguessableToken second_id;
+    bool first_replied = false;
+    bool next_admitted = false;
+    const auto first_id = LocalBroker::Get().Submit(
+        frame(), Feature::kOcr,
+        base::BindLambdaForTesting([&](LocalBroker::Ready ready) {
+          LocalBroker::Prepared prepared;
+          base::File lease(lease_path,
+                           base::File::FLAG_OPEN | base::File::FLAG_READ);
+          ASSERT_TRUE(lease.IsValid());
+          ASSERT_EQ(0, flock(lease.GetPlatformFile(), LOCK_SH | LOCK_NB));
+          prepared.leases.push_back(std::move(lease));
+          auto request = mojom::OcrRequest::New();
+          request->model = mojom::ModelFile::New();
+          request->model->name = "eng.traineddata";
+          request->model->file = base::File(
+              model_path, base::File::FLAG_OPEN | base::File::FLAG_READ);
+          request->model->size = 9;
+          const auto sha = crypto::hash::Sha256("synthetic");
+          request->model->sha256.assign(sha.begin(), sha.end());
+          request->language = "eng";
+          const std::string invalid_image = "not an encoded image";
+          request->image = mojom::Image::NewEncoded(
+              mojo_base::BigBuffer(base::as_byte_span(invalid_image)));
+          prepared.request = mojom::Request::NewOcr(std::move(request));
+          std::move(ready).Run(std::move(prepared));
+        }),
+        base::BindLambdaForTesting([&](mojom::ResultPtr result) {
+          first_replied = true;
+          EXPECT_EQ(cancel_before_process_launch ? mojom::Status::kCancelled
+                                                 : mojom::Status::kInvalidInput,
+                    result->status);
+          EXPECT_NE(0, flock(probe.GetPlatformFile(), LOCK_EX | LOCK_NB));
+          second_id = LocalBroker::Get().Submit(
+              frame(), Feature::kOcr,
+              base::BindLambdaForTesting([&](LocalBroker::Ready ready) {
+                next_admitted = true;
+                EXPECT_EQ(0, flock(probe.GetPlatformFile(), LOCK_EX | LOCK_NB));
+                EXPECT_EQ(0, flock(probe.GetPlatformFile(), LOCK_UN));
+                delayed = std::move(ready);
+                admitted.Quit();
+              }),
+              second.GetCallback());
+          EXPECT_FALSE(next_admitted);
+        }));
+    ASSERT_FALSE(first_id.is_empty());
+    if (cancel_before_process_launch) {
+      LocalBroker::Get().Cancel(first_id);
+    }
+    admitted.Run();
+    EXPECT_TRUE(first_replied);
+    EXPECT_TRUE(next_admitted);
+    ASSERT_FALSE(second_id.is_empty());
+    LocalBroker::Get().Cancel(second_id);
+    EXPECT_EQ(mojom::Status::kCancelled, second.Get()->status);
+  }
+}
