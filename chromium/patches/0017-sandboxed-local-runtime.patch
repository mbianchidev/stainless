diff --git a/chrome/services/stainless_local/image_description.cc b/chrome/services/stainless_local/image_description.cc
new file mode 100644
index 0000000000000000000000000000000000000000..26e9ebabf35ad0de07fcec8749b1ba0f8c8e644c
--- /dev/null
+++ b/chrome/services/stainless_local/image_description.cc
@@ -0,0 +1,100 @@
+#include "chrome/services/stainless_local/image_description.h"
+
+#include <utility>
+
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+
+namespace stainless_local {
+namespace {
+
+std::string ColorName(const std::array<uint8_t, 3>& rgb) {
+  if (rgb == std::array<uint8_t, 3>{255, 255, 255}) {
+    return "white";
+  }
+  if (rgb == std::array<uint8_t, 3>{0, 0, 0}) {
+    return "black";
+  }
+  if (rgb == std::array<uint8_t, 3>{255, 0, 0}) {
+    return "red";
+  }
+  if (rgb == std::array<uint8_t, 3>{0, 255, 0}) {
+    return "green";
+  }
+  if (rgb == std::array<uint8_t, 3>{0, 0, 255}) {
+    return "blue";
+  }
+  if (rgb == std::array<uint8_t, 3>{255, 255, 0}) {
+    return "yellow";
+  }
+  if (rgb == std::array<uint8_t, 3>{0, 255, 255}) {
+    return "cyan";
+  }
+  if (rgb == std::array<uint8_t, 3>{255, 0, 255}) {
+    return "magenta";
+  }
+  if (rgb[0] == rgb[1] && rgb[1] == rgb[2]) {
+    return "gray";
+  }
+  return "RGB " + base::NumberToString(rgb[0]) + ", " +
+         base::NumberToString(rgb[1]) + ", " + base::NumberToString(rgb[2]);
+}
+
+}  // namespace
+
+base::expected<UniformImageColor, std::string> MeasureUniformImageColor(
+    base::span<const uint8_t> rgba, uint32_t width, uint32_t height,
+    uint32_t stride) {
+  if (!width || width > 4096 || !height || height > 4096 ||
+      static_cast<uint64_t>(width) * height > 16777216 || stride != width * 4 ||
+      rgba.size() != static_cast<uint64_t>(stride) * height) {
+    return base::unexpected("Invalid image geometry for measured properties");
+  }
+  UniformImageColor result;
+  result.uniform = true;
+  for (size_t pixel = 0; pixel < rgba.size(); pixel += 4) {
+    const auto alpha = rgba[pixel + 3];
+    std::array<uint8_t, 3> rgb;
+    for (size_t channel = 0; channel < rgb.size(); ++channel) {
+      rgb[channel] =
+          (rgba[pixel + channel] * alpha + 255 * (255 - alpha) + 127) / 255;
+    }
+    if (pixel == 0) {
+      result.rgb = rgb;
+    } else if (result.rgb != rgb) {
+      result.uniform = false;
+      return result;
+    }
+  }
+  return result;
+}
+
+base::expected<std::string, std::string> CompleteImageDescription(
+    std::string_view raw, const UniformImageColor& color) {
+  if (raw.empty() || raw.size() > 32768 || !base::IsStringUTF8(raw) ||
+      raw.find('\0') != std::string_view::npos) {
+    return base::unexpected("Invalid generated image description");
+  }
+  std::string text(base::TrimWhitespaceASCII(raw, base::TRIM_ALL));
+  if (text.starts_with("<think>")) {
+    const auto end = text.find("</think>");
+    if (end == std::string::npos ||
+        !base::TrimWhitespaceASCII(std::string_view(text).substr(7, end - 7),
+                                   base::TRIM_ALL)
+             .empty()) {
+      return base::unexpected(
+          "Image model returned reasoning instead of a description");
+    }
+    text = base::TrimWhitespaceASCII(std::string_view(text).substr(end + 8),
+                                     base::TRIM_ALL);
+  }
+  if (text.empty()) {
+    return base::unexpected("Image model returned an empty final description");
+  }
+  if (color.uniform) {
+    text += " Measured uniform image color: " + ColorName(color.rgb) + ".";
+  }
+  return base::ok(std::move(text));
+}
+
+}  // namespace stainless_local
