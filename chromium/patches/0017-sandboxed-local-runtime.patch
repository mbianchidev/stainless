@@ -0,0 +1,52 @@
+#include "chrome/services/stainless_local/image_description.h"
+
+#include <array>
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+TEST(StainlessImageDescriptionTest,
+     UniformColorIsMeasuredAndRawMeaningIsRetained) {
+  const std::array<uint8_t, 8> pixels = {255, 255, 255, 255,
+                                         255, 255, 255, 255};
+  auto color = stainless_local::MeasureUniformImageColor(pixels, 2, 1, 8);
+  ASSERT_TRUE(color.has_value());
+  ASSERT_TRUE(color->uniform);
+  auto result = stainless_local::CompleteImageDescription(
+      "<think>\n\n</think>\nThe image is completely blank.", *color);
+  ASSERT_TRUE(result.has_value());
+  EXPECT_EQ(
+      "The image is completely blank. Measured uniform image color: white.",
+      *result);
+}
+
+TEST(StainlessImageDescriptionTest,
+     OneDifferentPixelDoesNotInventAUniformColor) {
+  const std::array<uint8_t, 8> pixels = {255, 255, 255, 255,
+                                         254, 255, 255, 255};
+  auto color = stainless_local::MeasureUniformImageColor(pixels, 2, 1, 8);
+  ASSERT_TRUE(color.has_value());
+  EXPECT_FALSE(color->uniform);
+  auto result =
+      stainless_local::CompleteImageDescription("A plain image.", *color);
+  ASSERT_TRUE(result.has_value());
+  EXPECT_EQ("A plain image.", *result);
+}
+
+TEST(StainlessImageDescriptionTest,
+     TransparentPixelsAndInvalidOutputAreExplicit) {
+  const std::array<uint8_t, 8> pixels = {255, 0, 0, 0, 0, 0, 255, 0};
+  auto color = stainless_local::MeasureUniformImageColor(pixels, 2, 1, 8);
+  ASSERT_TRUE(color.has_value());
+  ASSERT_TRUE(color->uniform);
+  EXPECT_EQ((std::array<uint8_t, 3>{255, 255, 255}), color->rgb);
+  EXPECT_FALSE(stainless_local::MeasureUniformImageColor(pixels, 4097, 1, 8)
+                   .has_value());
+  EXPECT_FALSE(
+      stainless_local::MeasureUniformImageColor(pixels, 2, 1, 7).has_value());
+  EXPECT_FALSE(stainless_local::CompleteImageDescription(
+                   "<think>Not a final description</think>", *color)
+                   .has_value());
+  EXPECT_FALSE(
+      stainless_local::CompleteImageDescription("<think></think>", *color)
+          .has_value());
+}
