@@ -0,0 +1,498 @@
+#include "chrome/browser/stainless_local/local_broker.h"
+
+#include <cmath>
+#include <utility>
+
+#include "base/command_line.h"
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/process/process_metrics.h"
+#include "base/strings/string_util.h"
+#include "base/task/bind_post_task.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/task/thread_pool.h"
+#include "chrome/browser/prefs/incognito_mode_prefs.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/common/stainless_switches.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/browser_child_process_host.h"
+#include "content/public/browser/browser_thread.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/service_process_host.h"
+#include "content/public/browser/weak_document_ptr.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "url/origin.h"
+
+namespace stainless_local {
+namespace {
+
+constexpr auto kDeadline = base::Seconds(60);
+constexpr auto kSampleInterval = base::Milliseconds(200);
+constexpr uint64_t kMaximumRssBytes = 2147483648;
+constexpr size_t kMaximumQueued = 16;
+enum WatchEvent {
+  kReady,
+  kTooLarge,
+  kExpired,
+  kUnmeasurable,
+  kCannotTerminate
+};
+
+const char* Preference(Feature feature) {
+  return feature == Feature::kTranslation ? kTranslationEnabled : kOcrEnabled;
+}
+
+mojom::ResultPtr Failure(mojom::Status status, const char* detail) {
+  auto result = mojom::Result::New();
+  result->status = status;
+  result->detail = detail;
+  return result;
+}
+
+bool TerminateOwned(base::Process& process, const base::Time& created) {
+  if (!process.IsValid() || created.is_null() ||
+      process.CreationTime() != created) {
+    LOG(ERROR)
+        << "Stainless local worker: process ownership could not be verified";
+    return false;
+  }
+  if (!process.Terminate(1, false)) {
+    PLOG(ERROR) << "Stainless local worker: owned process termination failed";
+    return false;
+  }
+  return true;
+}
+
+bool ValidResult(const mojom::Result& result) {
+  if (result.text.size() > 1048576 || result.detail.size() > 192 ||
+      result.words.size() > 16384 || !base::IsStringUTF8(result.text) ||
+      result.text.find('\0') != std::string::npos ||
+      result.image_width > 4096 || result.image_height > 4096) {
+    return false;
+  }
+  size_t bytes = result.text.size();
+  for (const auto& word : result.words) {
+    if (!word || word->text.empty() || !base::IsStringUTF8(word->text) ||
+        word->text.find('\0') != std::string::npos ||
+        word->text.size() > 1048576 - bytes ||
+        !std::isfinite(word->confidence) || word->confidence < 0 ||
+        word->confidence > 100 || word->left < 0 || word->top < 0 ||
+        word->width <= 0 || word->height <= 0 ||
+        static_cast<uint64_t>(word->left) + word->width > result.image_width ||
+        static_cast<uint64_t>(word->top) + word->height > result.image_height) {
+      return false;
+    }
+    bytes += word->text.size();
+  }
+  return true;
+}
+
+bool ValidRequest(const mojom::Request& request) {
+  if (request.is_translation()) {
+    const auto& value = request.get_translation();
+    return value && value->model && !value->text.empty() &&
+           value->text.size() <= 8192 &&
+           value->text.find('\0') == std::string::npos &&
+           base::IsStringUTF8(value->text) && value->model->files.size() >= 3 &&
+           value->model->files.size() <= 4;
+  }
+  const auto& value = request.get_ocr();
+  if (!value || !value->model || !value->image) {
+    return false;
+  }
+  if (value->image->is_encoded()) {
+    return value->image->get_encoded().size() &&
+           value->image->get_encoded().size() <= 16777216;
+  }
+  const auto& bitmap = value->image->get_bitmap();
+  return bitmap && bitmap->width && bitmap->width <= 4096 && bitmap->height &&
+         bitmap->height <= 4096 && bitmap->stride == bitmap->width * 4 &&
+         bitmap->pixels.size() ==
+             static_cast<uint64_t>(bitmap->stride) * bitmap->height;
+}
+
+bool SupportedDocument(content::RenderFrameHost* frame) {
+  if (!frame || !frame->IsActive() || frame->IsErrorDocument()) {
+    return false;
+  }
+  const auto& origin = frame->GetLastCommittedOrigin();
+  return !origin.opaque() &&
+         (origin.scheme() == "https" || origin.scheme() == "http" ||
+          origin.scheme() == "file");
+}
+
+}  // namespace
+
+class ResourceWatchdog {
+ public:
+  ResourceWatchdog(base::Process process, base::Time created,
+                   base::TimeTicks deadline,
+                   base::RepeatingCallback<void(int)> report)
+      : process_(std::move(process)),
+        created_(created),
+        deadline_(deadline),
+        report_(std::move(report)),
+        metrics_(base::ProcessMetrics::CreateProcessMetrics(
+            process_.Handle(),
+            content::BrowserChildProcessHost::GetPortProvider())) {
+    started_ = base::TimeTicks::Now();
+    timer_.Start(FROM_HERE, kSampleInterval, this, &ResourceWatchdog::Sample);
+    Sample();
+  }
+
+ private:
+  void Stop(int event) {
+    timer_.Stop();
+    report_.Run(TerminateOwned(process_, created_) ? event : kCannotTerminate);
+  }
+
+  void Sample() {
+    if (base::TimeTicks::Now() >= deadline_) {
+      Stop(kExpired);
+      return;
+    }
+    if (!metrics_) {
+      Stop(kUnmeasurable);
+      return;
+    }
+    auto memory = metrics_->GetMemoryInfo();
+    if (!memory.has_value()) {
+      if (ready_ || base::TimeTicks::Now() - started_ >= base::Seconds(1)) {
+        Stop(kUnmeasurable);
+      }
+      return;
+    }
+    if (memory->resident_set_bytes > kMaximumRssBytes) {
+      Stop(kTooLarge);
+      return;
+    }
+    if (!ready_) {
+      ready_ = true;
+      report_.Run(kReady);
+    }
+  }
+
+  base::Process process_;
+  base::Time created_;
+  base::TimeTicks deadline_;
+  base::TimeTicks started_;
+  base::RepeatingCallback<void(int)> report_;
+  std::unique_ptr<base::ProcessMetrics> metrics_;
+  base::RepeatingTimer timer_;
+  bool ready_ = false;
+};
+
+struct LocalBroker::Job : public content::WebContentsObserver {
+  Job(content::RenderFrameHost* frame, Feature feature, Prepare prepare,
+      Reply reply, base::RepeatingClosure invalidated)
+      : content::WebContentsObserver(
+            content::WebContents::FromRenderFrameHost(frame)),
+        document(frame->GetWeakDocumentPtr()),
+        feature(feature),
+        prepare(std::move(prepare)),
+        reply(std::move(reply)),
+        invalidated(std::move(invalidated)) {
+    auto* profile = Profile::FromBrowserContext(frame->GetBrowserContext());
+    preferences.Init(profile->GetPrefs());
+    preferences.Add(Preference(feature), this->invalidated);
+  }
+
+  void DidFinishNavigation(content::NavigationHandle*) override {
+    if (!document.AsRenderFrameHostIfValid()) {
+      invalidated.Run();
+    }
+  }
+  void RenderFrameDeleted(content::RenderFrameHost* frame) override {
+    if (!document.AsRenderFrameHostIfValid() ||
+        frame == document.AsRenderFrameHostIfValid()) {
+      invalidated.Run();
+    }
+  }
+  void WebContentsDestroyed() override { invalidated.Run(); }
+
+  base::UnguessableToken id;
+  content::WeakDocumentPtr document;
+  Feature feature;
+  base::TimeTicks deadline = base::TimeTicks::Now() + kDeadline;
+  Prepare prepare;
+  Reply reply;
+  base::RepeatingClosure invalidated;
+  PrefChangeRegistrar preferences;
+  Prepared prepared;
+  bool dispatched = false;
+};
+
+bool IsEligibleProfile(Profile* profile) {
+  return profile && profile->IsRegularProfile() && !profile->IsOffTheRecord() &&
+         !stainless::IsStartupSafeMode() &&
+         !IncognitoModePrefs::ShouldLaunchIncognito(
+             *base::CommandLine::ForCurrentProcess(), profile);
+}
+
+void RegisterProfilePrefs(PrefRegistrySimple* registry) {
+  registry->RegisterBooleanPref(kTranslationEnabled, false);
+  registry->RegisterBooleanPref(kOcrEnabled, false);
+}
+
+LocalBroker::Prepared::Prepared() = default;
+LocalBroker::Prepared::~Prepared() = default;
+LocalBroker::Prepared::Prepared(Prepared&&) = default;
+LocalBroker::Prepared& LocalBroker::Prepared::operator=(Prepared&&) = default;
+
+LocalBroker& LocalBroker::Get() {
+  static base::NoDestructor<LocalBroker> broker;
+  return *broker;
+}
+
+LocalBroker::LocalBroker() = default;
+LocalBroker::~LocalBroker() = default;
+
+base::UnguessableToken LocalBroker::Submit(content::RenderFrameHost* frame,
+                                           Feature feature, Prepare prepare,
+                                           Reply reply) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  auto* profile =
+      frame ? Profile::FromBrowserContext(frame->GetBrowserContext()) : nullptr;
+  if (!IsEligibleProfile(profile) || !SupportedDocument(frame) ||
+      !profile->GetPrefs()->GetBoolean(Preference(feature)) || !prepare ||
+      termination_failed_) {
+    std::move(reply).Run(
+        Failure(mojom::Status::kNotAllowed,
+                "Local inference is unavailable or not enabled"));
+    return {};
+  }
+  if (active_ && queued_.size() >= kMaximumQueued) {
+    std::move(reply).Run(
+        Failure(mojom::Status::kQueueFull, "Local inference queue is full"));
+    return {};
+  }
+  const auto id = base::UnguessableToken::Create();
+  auto job = std::make_unique<Job>(
+      frame, feature, std::move(prepare), std::move(reply),
+      base::BindRepeating(&LocalBroker::Cancel, weak_.GetWeakPtr(), id));
+  job->id = id;
+  queued_.push_back(std::move(job));
+  if (!timer_.IsRunning()) {
+    timer_.Start(FROM_HERE, kSampleInterval, this, &LocalBroker::Sweep);
+  }
+  StartNext();
+  return id;
+}
+
+bool LocalBroker::Permitted(const Job& job) const {
+  auto* frame = job.document.AsRenderFrameHostIfValid();
+  auto* profile =
+      frame ? Profile::FromBrowserContext(frame->GetBrowserContext()) : nullptr;
+  return SupportedDocument(frame) && IsEligibleProfile(profile) &&
+         profile->GetPrefs()->GetBoolean(Preference(job.feature));
+}
+
+bool LocalBroker::Matches(const base::UnguessableToken& id) const {
+  return active_ && active_->id == id;
+}
+
+void LocalBroker::StartNext() {
+  if (active_ || queued_.empty()) {
+    if (!active_ && queued_.empty()) {
+      timer_.Stop();
+    }
+    return;
+  }
+  active_ = std::move(queued_.front());
+  queued_.pop_front();
+  if (base::TimeTicks::Now() >= active_->deadline) {
+    Finish(Failure(mojom::Status::kTimedOut,
+                   "Local inference request expired in the queue"),
+           false);
+    return;
+  }
+  if (termination_failed_ || !Permitted(*active_)) {
+    Finish(Failure(mojom::Status::kCancelled,
+                   "Local inference request expired or lost authorization"),
+           false);
+    return;
+  }
+  std::move(active_->prepare)
+      .Run(base::BindOnce(&LocalBroker::OnPrepared, weak_.GetWeakPtr(),
+                          active_->id));
+}
+
+void LocalBroker::OnPrepared(base::UnguessableToken id, Prepared prepared) {
+  if (!Matches(id)) {
+    return;
+  }
+  if (!Permitted(*active_) || base::TimeTicks::Now() >= active_->deadline) {
+    Cancel(id);
+    return;
+  }
+  if (!prepared.request || !ValidRequest(*prepared.request) ||
+      (active_->feature == Feature::kTranslation) !=
+          prepared.request->is_translation()) {
+    Finish(Failure(mojom::Status::kInvalidInput,
+                   "Local inference preparation returned invalid input"),
+           false);
+    return;
+  }
+  active_->prepared = std::move(prepared);
+  worker_ = content::ServiceProcessHost::Launch<mojom::LocalWorker>(
+      content::ServiceProcessHost::Options()
+          .WithDisplayName("Stainless local inference")
+          .WithProcessCallback(
+              base::BindOnce(&LocalBroker::OnProcess, weak_.GetWeakPtr(), id))
+          .Pass());
+  worker_.set_disconnect_handler(base::BindOnce(
+      &LocalBroker::OnResult, weak_.GetWeakPtr(), id,
+      Failure(mojom::Status::kFailed, "Local inference worker disconnected")));
+}
+
+void LocalBroker::OnProcess(base::UnguessableToken id,
+                            const base::Process& process) {
+  if (!Matches(id)) {
+    return;
+  }
+  process_ = process.Duplicate();
+  process_created_ = process.CreationTime();
+  if (!process_.IsValid() || process_created_.is_null()) {
+    Finish(Failure(mojom::Status::kFailed,
+                   "Local inference process ownership is unavailable"),
+           false);
+    return;
+  }
+  if (!watchdog_runner_) {
+    watchdog_runner_ = base::ThreadPool::CreateSequencedTaskRunner(
+        {base::MayBlock(), base::TaskPriority::USER_BLOCKING,
+         base::TaskShutdownBehavior::BLOCK_SHUTDOWN});
+  }
+  watchdog_.emplace(
+      watchdog_runner_, process.Duplicate(), process_created_,
+      active_->deadline,
+      base::BindPostTask(base::SingleThreadTaskRunner::GetCurrentDefault(),
+                         base::BindRepeating(&LocalBroker::OnWatchdog,
+                                             weak_.GetWeakPtr(), id)));
+}
+
+void LocalBroker::OnWatchdog(base::UnguessableToken id, int event) {
+  if (!Matches(id)) {
+    return;
+  }
+  if (event != kReady) {
+    if (event == kCannotTerminate) {
+      termination_failed_ = true;
+    }
+    Finish(Failure(event == kTooLarge  ? mojom::Status::kResourceLimit
+                   : event == kExpired ? mojom::Status::kTimedOut
+                                       : mojom::Status::kFailed,
+                   "Local inference resource watchdog stopped the worker"),
+           false);
+    return;
+  }
+  if (!Permitted(*active_) || base::TimeTicks::Now() >= active_->deadline) {
+    Cancel(id);
+    return;
+  }
+  if (active_->dispatched) {
+    return;
+  }
+  active_->dispatched = true;
+  auto request = std::move(active_->prepared.request);
+  auto done = base::BindOnce(&LocalBroker::OnResult, weak_.GetWeakPtr(), id);
+  if (request->is_translation()) {
+    auto& translation = request->get_translation();
+    worker_->Translate(std::move(translation->model), translation->text,
+                       std::move(done));
+  } else {
+    auto& ocr = request->get_ocr();
+    worker_->ReadImageText(std::move(ocr->model), ocr->language,
+                           std::move(ocr->image), std::move(done));
+  }
+}
+
+void LocalBroker::OnResult(base::UnguessableToken id, mojom::ResultPtr result) {
+  if (!Matches(id)) {
+    return;
+  }
+  if (!Permitted(*active_)) {
+    Cancel(id);
+    return;
+  }
+  if (base::TimeTicks::Now() >= active_->deadline) {
+    Finish(
+        Failure(mojom::Status::kTimedOut, "Local inference deadline exceeded"),
+        true);
+    return;
+  }
+  if (!result || !ValidResult(*result)) {
+    Finish(Failure(mojom::Status::kFailed,
+                   "Local inference returned an invalid bounded result"),
+           true);
+    return;
+  }
+  Finish(std::move(result), false);
+}
+
+void LocalBroker::Finish(mojom::ResultPtr result, bool terminate) {
+  auto completed = std::move(active_);
+  if (terminate && process_.IsValid() &&
+      !TerminateOwned(process_, process_created_)) {
+    termination_failed_ = true;
+  }
+  watchdog_.Reset();
+  worker_.reset();
+  process_.Close();
+  process_created_ = {};
+  auto reply = std::move(completed->reply);
+  completed.reset();
+  std::move(reply).Run(std::move(result));
+  StartNext();
+}
+
+void LocalBroker::Cancel(const base::UnguessableToken& id) {
+  Stop(id, mojom::Status::kCancelled);
+}
+
+void LocalBroker::Stop(const base::UnguessableToken& id, mojom::Status status) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (Matches(id)) {
+    Finish(Failure(status, "Local inference was cancelled or expired"), true);
+    return;
+  }
+  for (auto item = queued_.begin(); item != queued_.end(); ++item) {
+    if ((*item)->id == id) {
+      auto reply = std::move((*item)->reply);
+      queued_.erase(item);
+      std::move(reply).Run(
+          Failure(status, "Queued inference was cancelled or expired"));
+      return;
+    }
+  }
+}
+
+void LocalBroker::Sweep() {
+  std::vector<std::pair<base::UnguessableToken, mojom::Status>> cancelled;
+  for (const auto& job : queued_) {
+    if (!Permitted(*job) || base::TimeTicks::Now() >= job->deadline) {
+      cancelled.emplace_back(job->id, base::TimeTicks::Now() >= job->deadline
+                                          ? mojom::Status::kTimedOut
+                                          : mojom::Status::kCancelled);
+    }
+  }
+  if (active_ &&
+      (!Permitted(*active_) || base::TimeTicks::Now() >= active_->deadline)) {
+    cancelled.emplace_back(active_->id,
+                           base::TimeTicks::Now() >= active_->deadline
+                               ? mojom::Status::kTimedOut
+                               : mojom::Status::kCancelled);
+  }
+  for (const auto& [id, status] : cancelled) {
+    Stop(id, status);
+  }
+  if (!active_ && queued_.empty()) {
+    timer_.Stop();
+  }
+}
+
+}  // namespace stainless_local
