+std::vector<std::u16string> Words(const std::string& text) {
+  const auto lower = base::i18n::ToLower(base::UTF8ToUTF16(text));
+  base::i18n::BreakIterator words(lower, base::i18n::BreakIterator::BREAK_WORD);
+  std::vector<std::u16string> result;
+  if (!words.Init()) {
+    ADD_FAILURE() << "Synthetic fixture Unicode tokenizer failed";
+    return result;
+  }
+  while (words.Advance()) {
+    if (words.IsWord()) {
+      result.emplace_back(words.GetString());
+    }
+  }
+  return result;
+}
