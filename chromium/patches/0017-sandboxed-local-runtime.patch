+#ifndef CHROME_SERVICES_STAINLESS_LOCAL_LOCAL_WORKER_H_
+#define CHROME_SERVICES_STAINLESS_LOCAL_LOCAL_WORKER_H_
+
+#include "base/files/file_path.h"
+#include "base/task/sequenced_task_runner.h"
+#include "chrome/services/stainless_local/public/mojom/local_worker.mojom.h"
+#include "mojo/public/cpp/bindings/pending_receiver.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+
+namespace stainless_local {
+
+class LocalWorker final : public mojom::LocalWorker {
+ public:
+  explicit LocalWorker(mojo::PendingReceiver<mojom::LocalWorker> receiver);
+  ~LocalWorker() override;
+
+  void Translate(mojom::TranslationModelPtr model, const std::string& text,
+                 TranslateCallback callback) override;
+  void ReadImageText(mojom::ModelFilePtr model, const std::string& language,
+                     mojom::ImagePtr image,
+                     ReadImageTextCallback callback) override;
+  void RecognizeSpeech(mojom::ModelFilePtr model,
+                       const std::vector<int16_t>& pcm,
+                       const std::string& language,
+                       RecognizeSpeechCallback callback) override;
+  void DescribeImage(mojom::ModelFilePtr model, mojom::ModelFilePtr projector,
+                     mojom::ImagePtr image,
+                     DescribeImageCallback callback) override;
+
+ private:
+  static void RunTranslation(const base::FilePath& libraries,
+                             mojom::TranslationModelPtr model,
+                             const std::string& text,
+                             TranslateCallback callback);
+  static void RunOcr(const base::FilePath& libraries, mojom::ModelFilePtr model,
+                     const std::string& language, mojom::ImagePtr image,
+                     ReadImageTextCallback callback);
+  static void RunSpeech(const base::FilePath& libraries,
+                        mojom::ModelFilePtr model,
+                        const std::vector<int16_t>& pcm,
+                        const std::string& language,
+                        RecognizeSpeechCallback callback);
+  static void RunDescription(const base::FilePath& libraries,
+                             mojom::ModelFilePtr model,
+                             mojom::ModelFilePtr projector,
+                             mojom::ImagePtr image,
+                             DescribeImageCallback callback);
+
+  const base::FilePath libraries_;
+  scoped_refptr<base::SequencedTaskRunner> runner_;
+  mojo::Receiver<mojom::LocalWorker> receiver_;
+};
+
+}  // namespace stainless_local
+
+#endif
