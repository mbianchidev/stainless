+std::vector<std::u16string> Words(const std::string& text) {
+  const auto lower = base::i18n::ToLower(base::UTF8ToUTF16(text));
+  base::i18n::BreakIterator words(lower, base::i18n::BreakIterator::BREAK_WORD);
+  std::vector<std::u16string> result;
+  if (!words.Init()) {
+    ADD_FAILURE() << "Synthetic fixture Unicode tokenizer failed";
+    return result;
+  }
+  while (words.Advance()) {
+    if (words.IsWord()) {
+      result.emplace_back(words.GetString());
+    }
+  }
+  return result;
+}
+
+mojom::ImagePtr ReadFixtureImage(const base::FilePath& root,
+                                 const base::DictValue& fixture,
+                                 const base::DictValue& test, bool encoded) {
+  const auto* name = test.FindString(encoded ? "encoded_file" : "file");
+  const auto* hash = test.FindString(encoded ? "encoded_sha256" : "sha256");
+  if (!name || !hash || *name == "." || *name == ".." ||
+      base::FilePath(*name).BaseName().value() != *name) {
+    ADD_FAILURE() << "Invalid bounded synthetic image fixture";
+    return nullptr;
+  }
+  std::string bytes;
+  if (!base::ReadFileToStringWithMaxSize(root.AppendASCII(*name), &bytes,
+                                         encoded ? 16777216 : 67108864) ||
+      base::HexEncodeLower(crypto::hash::Sha256(bytes)) != *hash) {
+    ADD_FAILURE() << "Frozen synthetic image pixels changed";
+    return nullptr;
+  }
+  if (encoded) {
+    return mojom::Image::NewEncoded(
+        mojo_base::BigBuffer(base::as_byte_span(bytes)));
+  }
+  auto bitmap = mojom::Bitmap::New();
+  bitmap->width = fixture.FindInt("width").value_or(0);
+  bitmap->height = fixture.FindInt("height").value_or(0);
+  bitmap->stride = bitmap->width * 4;
+  bitmap->pixels = mojo_base::BigBuffer(base::as_byte_span(bytes));
+  return mojom::Image::NewBitmap(std::move(bitmap));
+}
+
+LocalBroker::Prepared PrepareFixture(const base::FilePath& root,
+                                     const base::DictValue& fixture,
+                                     const base::DictValue& test, bool encoded,
+                                     bool wrong_digest) {
+  LocalBroker::Prepared prepared;
+  const auto* language = test.FindString("language");
+  const auto* models = fixture.FindDict("models");
+  const auto* model =
+      language && models ? models->FindDict(*language) : nullptr;
+  const auto* model_name = model ? model->FindString("file") : nullptr;
+  const auto* model_sha = model ? model->FindString("sha256") : nullptr;
+  const auto size = model ? model->FindInt("bytes") : std::nullopt;
+  if (!language || !model_name || !model_sha || !size ||
+      base::FilePath(*model_name).BaseName().value() != *model_name) {
+    ADD_FAILURE() << "Invalid synthetic native fixture metadata";
+    return prepared;
+  }
+  auto request = mojom::OcrRequest::New();
+  request->model = mojom::ModelFile::New();
+  request->model->name = *language + ".traineddata";
+  request->model->file =
+      base::File(root.AppendASCII(*model_name),
+                 base::File::FLAG_OPEN | base::File::FLAG_READ);
+  request->model->size = *size;
+  if (!request->model->file.IsValid() ||
+      !base::HexStringToBytes(*model_sha, &request->model->sha256) ||
+      request->model->sha256.size() != 32) {
+    ADD_FAILURE() << "Synthetic fixture model cannot be opened";
+    return prepared;
+  }
+  if (wrong_digest) {
+    request->model->sha256[0] ^= 1;
+  }
+  request->language = *language;
+  request->image = ReadFixtureImage(root, fixture, test, encoded);
+  prepared.request = mojom::Request::NewOcr(std::move(request));
+  return prepared;
+}
+
+mojom::ModelFilePtr TranslationFile(const base::FilePath& root,
+                                    const base::DictValue& records,
+                                    const char* name) {
+  const auto* record = records.FindDict(name);
+  const auto size = record ? record->FindInt("bytes") : std::nullopt;
+  const auto* hash = record ? record->FindString("sha256") : nullptr;
+  if (!size || !hash) {
+    ADD_FAILURE() << "Missing pinned native translation fixture member";
+    return nullptr;
+  }
+  auto file = mojom::ModelFile::New();
+  file->name = name;
+  file->size = *size;
+  file->file = base::File(root.AppendASCII(name),
+                          base::File::FLAG_OPEN | base::File::FLAG_READ);
+  if (!file->file.IsValid() || !base::HexStringToBytes(*hash, &file->sha256) ||
+      file->sha256.size() != 32) {
+    ADD_FAILURE() << "Native translation fixture descriptor is invalid";
+    return nullptr;
+  }
+  return file;
+}
+
+LocalBroker::Prepared PrepareTranslation(const base::FilePath& root,
+                                         const base::DictValue& records,
+                                         bool wrong_tokenizer) {
+  LocalBroker::Prepared prepared;
+  auto model = mojom::TranslationModel::New();
+  for (const char* name :
+       {"model.bin", "config.json", "shared_vocabulary.json"}) {
+    auto file = TranslationFile(root, records, name);
+    if (!file) {
+      return prepared;
+    }
+    model->files.push_back(std::move(file));
+  }
+  model->source_tokenizer = TranslationFile(root, records, "source.spm");
+  model->target_tokenizer = TranslationFile(root, records, "target.spm");
+  if (!model->source_tokenizer || !model->target_tokenizer) {
+    return prepared;
+  }
+  if (wrong_tokenizer) {
+    model->source_tokenizer->sha256[0] ^= 1;
+  }
+  auto request = mojom::TranslationRequest::New();
+  request->model = std::move(model);
+  request->text = "The red robot holds three blue boxes.";
+  prepared.request = mojom::Request::NewTranslation(std::move(request));
+  return prepared;
+}
+
+LocalBroker::Prepared PrepareSpeech(const base::FilePath& root,
+                                    const base::DictValue& model,
+                                    const base::DictValue& test,
+                                    bool wrong_digest) {
+  LocalBroker::Prepared prepared;
+  const auto* name = test.FindString("file");
+  const auto* hash = test.FindString("sha256");
+  const auto* language = test.FindString("language");
+  if (!name || !hash || !language ||
+      base::FilePath(*name).BaseName().value() != *name) {
+    ADD_FAILURE() << "Invalid bounded synthetic speech fixture";
+    return prepared;
+  }
+  std::string bytes;
+  if (!base::ReadFileToStringWithMaxSize(root.AppendASCII(*name), &bytes,
+                                         960000) ||
+      bytes.empty() || bytes.size() % 2 ||
+      base::HexEncodeLower(crypto::hash::Sha256(bytes)) != *hash) {
+    ADD_FAILURE() << "Frozen synthetic speech PCM changed";
+    return prepared;
+  }
+  base::DictValue records;
+  records.Set("model.bin", model.Clone());
+  auto file = TranslationFile(root, records, "model.bin");
+  if (!file) {
+    return prepared;
+  }
+  if (wrong_digest) {
+    file->sha256[0] ^= 1;
+  }
+  auto request = mojom::SpeechRequest::New();
+  request->model = std::move(file);
+  request->language = *language;
+  request->pcm.resize(bytes.size() / sizeof(int16_t));
+  base::as_writable_byte_span(request->pcm)
+      .copy_from(base::as_byte_span(bytes));
+  prepared.request = mojom::Request::NewSpeech(std::move(request));
+  return prepared;
+}
+
+LocalBroker::Prepared PrepareDescription(const base::FilePath& root,
+                                         const base::DictValue& fixture,
+                                         const base::DictValue& test,
+                                         bool encoded, bool wrong_digest) {
+  LocalBroker::Prepared prepared;
+  const auto* records = fixture.FindDict("models");
+  if (!records) {
+    ADD_FAILURE() << "Missing pinned native image-description model metadata";
+    return prepared;
+  }
+  auto model = TranslationFile(root, *records, "model.gguf");
+  auto projector = TranslationFile(root, *records, "projector.gguf");
+  auto image = ReadFixtureImage(root, fixture, test, encoded);
+  if (!model || !projector || !image) {
+    return prepared;
+  }
+  if (wrong_digest) {
+    projector->sha256[0] ^= 1;
+  }
+  auto request = mojom::DescriptionRequest::New();
+  request->model = std::move(model);
+  request->projector = std::move(projector);
+  request->image = std::move(image);
+  prepared.request = mojom::Request::NewDescription(std::move(request));
+  return prepared;
+}
