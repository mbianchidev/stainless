+          result.GetCallback());
+      const auto& response = result.Get();
+      ASSERT_EQ(mojom::Status::kOk, response->status) << response->detail;
+      EXPECT_EQ(1600u, response->image_width);
+      EXPECT_EQ(240u, response->image_height);
+      std::string actual;
+      for (const auto& word : response->words) {
+        actual += word->text + " ";
+        EXPECT_GE(word->confidence, 0);
+        EXPECT_LE(word->confidence, 100);
+        EXPECT_GT(word->width, 0);
+        EXPECT_GT(word->height, 0);
+        EXPECT_LE(word->left + word->width, 1600);
+        EXPECT_LE(word->top + word->height, 240);
