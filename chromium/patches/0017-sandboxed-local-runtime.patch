diff --git a/chrome/test/base/stainless_image_description_probe.cc b/chrome/test/base/stainless_image_description_probe.cc
new file mode 100644
index 0000000000000000000000000000000000000000..289e7eb62682d0d301bbdc53b4c6808c2bb2703c
--- /dev/null
+++ b/chrome/test/base/stainless_image_description_probe.cc
@@ -0,0 +1,72 @@
+#include <iostream>
+#include <sstream>
+#include <string>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/json/json_writer.h"
+#include "base/values.h"
+#include "chrome/services/stainless_local/image_description.h"
+
+int main(int argc, char** argv) {
+  if (argc != 3) {
+    std::cerr
+        << "Provide the owned P6 raster and raw-description fixture paths\n";
+    return 2;
+  }
+  std::string image;
+  std::string raw;
+  if (!base::ReadFileToStringWithMaxSize(base::FilePath(argv[1]), &image,
+                                         50331712) ||
+      !base::ReadFileToStringWithMaxSize(base::FilePath(argv[2]), &raw,
+                                         32768)) {
+    std::cerr << "Could not read bounded owned description fixtures\n";
+    return 1;
+  }
+  std::istringstream input(image);
+  std::string magic, dimensions, maximum;
+  std::getline(input, magic);
+  std::getline(input, dimensions);
+  std::getline(input, maximum);
+  std::istringstream size(dimensions);
+  uint32_t width = 0, height = 0;
+  if (magic != "P6" || maximum != "255" || !(size >> width >> height) ||
+      !width || width > 4096 || !height || height > 4096) {
+    std::cerr << "Invalid bounded synthetic P6 raster\n";
+    return 1;
+  }
+  const size_t offset = magic.size() + dimensions.size() + maximum.size() + 3;
+  const auto source = base::as_byte_span(image).subspan(offset);
+  if (source.size() != static_cast<uint64_t>(width) * height * 3) {
+    std::cerr << "Synthetic raster length disagrees with dimensions\n";
+    return 1;
+  }
+  std::vector<uint8_t> rgba(static_cast<size_t>(width) * height * 4);
+  for (size_t pixel = 0; pixel < source.size() / 3; ++pixel) {
+    for (size_t channel = 0; channel < 3; ++channel) {
+      rgba[pixel * 4 + channel] = source[pixel * 3 + channel];
+    }
+    rgba[pixel * 4 + 3] = 255;
+  }
+  auto color =
+      stainless_local::MeasureUniformImageColor(rgba, width, height, width * 4);
+  if (!color.has_value()) {
+    std::cerr << color.error() << '\n';
+    return 1;
+  }
+  auto text = stainless_local::CompleteImageDescription(raw, *color);
+  if (!text.has_value()) {
+    std::cerr << text.error() << '\n';
+    return 1;
+  }
+  auto result = base::WriteJson(
+      base::DictValue().Set("text", *text).Set("uniform", color->uniform));
+  if (!result) {
+    std::cerr << "Could not serialize native description fixture result\n";
+    return 1;
+  }
+  std::cout << *result << '\n';
+  return 0;
+}
