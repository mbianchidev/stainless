+                     const std::string& language, mojom::ImagePtr image,
+                     ReadImageTextCallback callback);
+
+  const base::FilePath libraries_;
+  scoped_refptr<base::SequencedTaskRunner> runner_;
+  mojo::Receiver<mojom::LocalWorker> receiver_;
+};
