+#include "base/strings/string_util.h"
+#include "base/task/bind_post_task.h"
+#include "base/task/thread_pool.h"
+#include "base/threading/scoped_blocking_call.h"
+#include "base/threading/thread_restrictions.h"
+#include "base/types/expected.h"
+#include "chrome/services/stainless_local/image_description.h"
+#include "chrome/services/stainless_local/public/stainless_local_runtime.h"
+#include "crypto/hash.h"
+#include "third_party/sentencepiece/src/src/sentencepiece_processor.h"
+#include "third_party/skia/include/codec/SkCodec.h"
+#include "third_party/skia/include/codec/SkJpegDecoder.h"
+#include "third_party/skia/include/codec/SkPngRustDecoder.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "third_party/skia/include/core/SkData.h"
+#include "third_party/skia/include/core/SkImageInfo.h"
+#include "third_party/webrtc_overrides/stainless_vad.h"
+
+namespace stainless_local {
+namespace {
+
+constexpr size_t kMaximumTextBytes = 8192;
+constexpr size_t kMaximumOutputBytes = 1048576;
+constexpr uint32_t kMaximumImageAxis = 4096;
+constexpr uint64_t kMaximumImagePixels = 16777216;
+constexpr size_t kMaximumEncodedBytes = 16777216;
+
+mojom::ResultPtr Failure(mojom::Status status, const char* detail) {
+  auto result = mojom::Result::New();
+  result->status = status;
+  result->detail = detail;
+  return result;
+}
+
+mojom::Status NativeStatus(int32_t value) {
+  switch (value) {
+    case STAINLESS_RUNTIME_OK:
+      return mojom::Status::kOk;
+    case STAINLESS_RUNTIME_INVALID_INPUT:
+      return mojom::Status::kInvalidInput;
+    case STAINLESS_RUNTIME_INVALID_MODEL:
+      return mojom::Status::kInvalidModel;
+    case STAINLESS_RUNTIME_RESOURCE_LIMIT:
+      return mojom::Status::kResourceLimit;
+    case STAINLESS_RUNTIME_OUTPUT_REJECTED:
+    case STAINLESS_RUNTIME_FAILED:
+    default:
+      return mojom::Status::kFailed;
+  }
+}
+
+bool BoundedText(std::string_view text, size_t maximum) {
+  return !text.empty() && text.size() <= maximum &&
+         text.find('\0') == std::string_view::npos && base::IsStringUTF8(text);
+}
+
+bool BoundedImage(uint32_t width, uint32_t height) {
+  return width && height && width <= kMaximumImageAxis &&
+         height <= kMaximumImageAxis &&
+         static_cast<uint64_t>(width) * height <= kMaximumImagePixels;
+}
+
+struct DecodedImage {
+  SkBitmap decoded;
+  mojom::ImagePtr source;
+  uint32_t width = 0;
+  uint32_t height = 0;
+  uint32_t stride = 0;
+
+  base::span<const uint8_t> pixels() const {
+    if (source) {
+      return source->get_bitmap()->pixels;
+    }
+    return UNSAFE_TODO(
+        base::span(static_cast<const uint8_t*>(decoded.getPixels()),
+                   decoded.computeByteSize()));
+  }
+};
+
+base::expected<DecodedImage, mojom::ResultPtr> DecodeImage(
+    mojom::ImagePtr image) {
+  if (!image) {
+    return base::unexpected(
+        Failure(mojom::Status::kInvalidInput, "Missing local image input"));
+  }
+  DecodedImage result;
+  if (image->is_encoded()) {
+    const auto& encoded = image->get_encoded();
+    if (!encoded.size() || encoded.size() > kMaximumEncodedBytes) {
+      return base::unexpected(Failure(mojom::Status::kInvalidInput,
+                                      "Encoded local image exceeds limits"));
+    }
+    constexpr SkCodecs::Decoder decoders[] = {SkJpegDecoder::Decoder(),
+                                              SkPngRustDecoder::Decoder()};
+    auto codec = SkCodec::MakeFromData(
+        SkData::MakeWithoutCopy(encoded.data(), encoded.size()), decoders);
+    if (!codec || codec->dimensions().width() <= 0 ||
+        codec->dimensions().height() <= 0 ||
+        !BoundedImage(codec->dimensions().width(),
+                      codec->dimensions().height())) {
+      return base::unexpected(Failure(mojom::Status::kInvalidInput,
+                                      "Unsupported or oversized local image"));
+    }
+    result.width = codec->dimensions().width();
+    result.height = codec->dimensions().height();
+    const auto info =
+        SkImageInfo::Make(result.width, result.height, kRGBA_8888_SkColorType,
+                          kUnpremul_SkAlphaType);
+    SkCodec::Options options;
+    options.fMaxDecodeMemory = kMaximumImagePixels * 4;
+    if (!result.decoded.tryAllocPixels(info) ||
+        codec->getPixels(info, result.decoded.getPixels(),
+                         result.decoded.rowBytes(),
+                         &options) != SkCodec::kSuccess) {
+      return base::unexpected(
+          Failure(mojom::Status::kInvalidInput, "Local image decoding failed"));
+    }
+    result.stride = result.decoded.rowBytes();
+  } else {
+    const auto& bitmap = image->get_bitmap();
+    if (!bitmap || !BoundedImage(bitmap->width, bitmap->height) ||
+        bitmap->stride != bitmap->width * 4 ||
+        bitmap->pixels.size() !=
+            static_cast<uint64_t>(bitmap->stride) * bitmap->height) {
+      return base::unexpected(Failure(mojom::Status::kInvalidInput,
+                                      "Invalid local bitmap geometry"));
+    }
+    result.width = bitmap->width;
+    result.height = bitmap->height;
+    result.stride = bitmap->stride;
+    result.source = std::move(image);
+  }
+  return result;
+}
+
+std::optional<std::string> ReadTokenizer(mojom::ModelFile& model) {
+  struct stat info;
+  const int descriptor = model.file.GetPlatformFile();
+  const int flags = fcntl(descriptor, F_GETFL);
+  if (!model.size || model.size > 16777216 || flags < 0 ||
+      (flags & O_ACCMODE) != O_RDONLY || fstat(descriptor, &info) != 0 ||
+      !S_ISREG(info.st_mode) || info.st_nlink != 1 || info.st_size < 0 ||
+      static_cast<uint64_t>(info.st_size) != model.size) {
+    return std::nullopt;
+  }
+  std::string data(model.size, '\0');
+  if (!model.file.ReadAndCheck(0, base::as_writable_byte_span(data)) ||
+      !std::ranges::equal(crypto::hash::Sha256(data), model.sha256)) {
+    return std::nullopt;
+  }
+  return data;
+}
+
+template <typename Function>
+Function Bind(const base::ScopedNativeLibrary& library, const char* symbol) {
+  if (!library.is_valid()) {
+    return nullptr;
+  }
+  return reinterpret_cast<Function>(library.GetFunctionPointer(symbol));
+}
+
+void LogRuntimeFailure(const base::ScopedNativeLibrary& library,
+                       const char* engine) {
+  if (!library.is_valid()) {
+    LOG(ERROR) << "Stainless " << engine
+               << " runtime load failed: " << library.GetError()->ToString();
+  } else {
+    LOG(ERROR) << "Stainless " << engine
+               << " runtime has an invalid fixed C ABI";
+  }
+}
+
+StainlessModelFile NativeModel(const mojom::ModelFile& source) {
+  StainlessModelFile file = {};
+  file.name = {source.name.data(), source.name.size()};
+  file.descriptor = source.file.GetPlatformFile();
+  file.size = source.size;
+  base::span(file.sha256).copy_from(source.sha256);
+  return file;
+}
+
+struct TokenSink {
+  std::vector<std::string> tokens;
+  size_t bytes = 0;
+};
+
+int32_t EmitToken(void* context, StainlessText token) {
+  auto& sink = *static_cast<TokenSink*>(context);
+  if (!token.data || !token.size || token.size > 65536 - sink.bytes ||
+      sink.tokens.size() >= 128) {
+    return 0;
+  }
+  const auto text = UNSAFE_TODO(std::string_view(token.data, token.size));
+  if (!BoundedText(text, 65536)) {
+    return 0;
+  }
+  sink.bytes += token.size;
+  sink.tokens.emplace_back(text);
+  return 1;
+}
+
+struct WordSink {
+  mojom::ResultPtr result;
+  size_t bytes = 0;
+};
+
+int32_t EmitWord(void* context, const StainlessOcrWord* value) {
+  auto& sink = *static_cast<WordSink*>(context);
+  if (!value) {
+    return 0;
+  }
+  const auto& word = value->text;
+  const auto confidence = value->confidence;
+  const auto left = value->left, top = value->top;
+  const auto width = value->width, height = value->height;
+  if (!word.data || !word.size ||
+      word.size > kMaximumOutputBytes - sink.bytes ||
+      sink.result->words.size() >= 16384 || !std::isfinite(confidence) ||
+      confidence < 0 || confidence > 100 || left < 0 || top < 0 || width <= 0 ||
+      height <= 0 ||
+      static_cast<uint64_t>(left) + width > sink.result->image_width ||
+      static_cast<uint64_t>(top) + height > sink.result->image_height ||
+      !value->line_index || !std::isfinite(value->line_confidence) ||
+      value->line_confidence < 0 || value->line_confidence > 100 ||
+      value->line_left < 0 || value->line_top < 0 || value->line_width <= 0 ||
+      value->line_height <= 0 ||
+      static_cast<uint64_t>(value->line_left) + value->line_width >
+          sink.result->image_width ||
+      static_cast<uint64_t>(value->line_top) + value->line_height >
+          sink.result->image_height) {
+    return 0;
+  }
+  const auto text = UNSAFE_TODO(std::string_view(word.data, word.size));
+  if (!BoundedText(text, kMaximumOutputBytes)) {
+    return 0;
+  }
+  sink.bytes += word.size;
+  auto output = mojom::Word::New();
+  output->text = text;
+  output->confidence = confidence;
+  output->left = left;
+  output->top = top;
+  output->width = width;
+  output->height = height;
+  output->line_index = value->line_index;
+  output->line_left = value->line_left;
+  output->line_top = value->line_top;
+  output->line_width = value->line_width;
+  output->line_height = value->line_height;
+  output->line_confidence = value->line_confidence;
+  sink.result->words.push_back(std::move(output));
+  return 1;
+}
+
+}  // namespace
+
+LocalWorker::LocalWorker(mojo::PendingReceiver<mojom::LocalWorker> receiver)
+    : libraries_(base::apple::FrameworkBundlePath().AppendASCII("Libraries")),
+      runner_(base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_BLOCKING,
+           base::TaskShutdownBehavior::CONTINUE_ON_SHUTDOWN})),
+      receiver_(this, std::move(receiver)) {}
+
+LocalWorker::~LocalWorker() = default;
+
+void LocalWorker::Translate(mojom::TranslationModelPtr model,
+                            const std::string& text,
+                            TranslateCallback callback) {
+  auto replies = base::SplitOnceCallback(std::move(callback));
+  if (!runner_->PostTask(
+          FROM_HERE,
+          base::BindOnce(
+              &LocalWorker::RunTranslation, libraries_, std::move(model), text,
+              base::BindPostTaskToCurrentDefault(std::move(replies.first))))) {
+    std::move(replies.second)
+        .Run(Failure(mojom::Status::kFailed,
+                     "Local translation worker is stopping"));
+  }
+}
+
+void LocalWorker::RunTranslation(const base::FilePath& libraries,
+                                 mojom::TranslationModelPtr model,
+                                 const std::string& text,
+                                 TranslateCallback callback) {
+  if (!model || model->files.size() < 3 || model->files.size() > 4 ||
+      !model->source_tokenizer || !model->target_tokenizer ||
+      model->source_tokenizer->name != "source.spm" ||
+      model->target_tokenizer->name != "target.spm" ||
+      !BoundedText(text, kMaximumTextBytes)) {
+    std::move(callback).Run(Failure(mojom::Status::kInvalidInput,
+                                    "Invalid local translation request"));
+    return;
+  }
+  base::ScopedBlockingCall blocking(FROM_HERE, base::BlockingType::MAY_BLOCK);
+  auto source_data = ReadTokenizer(*model->source_tokenizer);
+  auto target_data = ReadTokenizer(*model->target_tokenizer);
+  sentencepiece::SentencePieceProcessor source_tokenizer;
+  sentencepiece::SentencePieceProcessor target_tokenizer;
+  if (!source_data || !target_data ||
+      !source_tokenizer.LoadFromSerializedProto(*source_data).ok() ||
+      !target_tokenizer.LoadFromSerializedProto(*target_data).ok()) {
+    std::move(callback).Run(Failure(mojom::Status::kInvalidModel,
+                                    "Invalid verified tokenizer data"));
+    return;
+  }
+  std::vector<std::string> pieces;
+  if (!source_tokenizer.Encode(text, &pieces).ok() || pieces.empty() ||
+      pieces.size() >= 1024) {
+    std::move(callback).Run(Failure(mojom::Status::kInvalidInput,
+                                    "Local translation input is too large"));
+    return;
+  }
+  pieces.emplace_back("</s>");
+  base::ScopedNativeLibrary library(
+      libraries.AppendASCII("libstainless_translation.dylib"));
+  const auto version = Bind<decltype(&stainless_translation_abi_version)>(
+      library, "stainless_translation_abi_version");
+  const auto create = Bind<decltype(&stainless_translation_create)>(
+      library, "stainless_translation_create");
+  const auto run = Bind<decltype(&stainless_translation_run)>(
+      library, "stainless_translation_run");
+  const auto destroy = Bind<decltype(&stainless_translation_destroy)>(
+      library, "stainless_translation_destroy");
+  if (!library.is_valid() || !version || !create || !run || !destroy ||
+      version() != 1) {
+    LogRuntimeFailure(library, "translation");
+    std::move(callback).Run(
+        Failure(mojom::Status::kUnavailable,
+                "Bundled translation runtime is unavailable"));
+    return;
+  }
+  std::vector<StainlessModelFile> files;
+  for (const auto& member : model->files) {
+    if (!member || !BoundedText(member->name, 64)) {
+      std::move(callback).Run(
+          Failure(mojom::Status::kInvalidModel, "Invalid model member"));
+      return;
+    }
+    StainlessModelFile file = {};
+    file.name = {member->name.data(), member->name.size()};
+    file.descriptor = member->file.GetPlatformFile();
+    file.size = member->size;
+    base::span(file.sha256).copy_from(member->sha256);
+    files.push_back(file);
+  }
+  StainlessRuntimeError error = {};
+  std::unique_ptr<StainlessTranslator, decltype(destroy)> engine(
+      create(files.data(), files.size(), 2, &error), destroy);
+  if (!engine) {
+    std::move(callback).Run(Failure(error.code == STAINLESS_RUNTIME_OK
+                                        ? mojom::Status::kFailed
+                                        : NativeStatus(error.code),
+                                    "Verified translation model load failed"));
+    return;
+  }
+  std::vector<StainlessText> input;
+  for (const auto& piece : pieces) {
+    input.push_back({piece.data(), piece.size()});
+  }
+  TokenSink sink;
+  const auto status = run(engine.get(), input.data(), input.size(), 128,
+                          EmitToken, &sink, &error);
+  engine.reset();
+  auto result = mojom::Result::New();
+  result->status = NativeStatus(status);
+  if (status != STAINLESS_RUNTIME_OK ||
+      !target_tokenizer.Decode(sink.tokens, &result->text).ok() ||
+      !BoundedText(result->text, 65536)) {
+    std::move(callback).Run(
+        Failure(status == STAINLESS_RUNTIME_OK ? mojom::Status::kFailed
+                                               : NativeStatus(status),
+                "Local translation did not produce a complete bounded result"));
+    return;
+  }
+  std::move(callback).Run(std::move(result));
+}
+
+void LocalWorker::ReadImageText(mojom::ModelFilePtr model,
+                                const std::string& language,
+                                mojom::ImagePtr image,
+                                ReadImageTextCallback callback) {
+  auto replies = base::SplitOnceCallback(std::move(callback));
+  if (!runner_->PostTask(
+          FROM_HERE,
+          base::BindOnce(
+              &LocalWorker::RunOcr, libraries_, std::move(model), language,
+              std::move(image),
+              base::BindPostTaskToCurrentDefault(std::move(replies.first))))) {
+    std::move(replies.second)
+        .Run(Failure(mojom::Status::kFailed, "Local OCR worker is stopping"));
+  }
+}
+
+void LocalWorker::RunOcr(const base::FilePath& libraries,
+                         mojom::ModelFilePtr model, const std::string& language,
+                         mojom::ImagePtr image,
+                         ReadImageTextCallback callback) {
+  if (!model || !image || !BoundedText(language, 3) ||
+      model->name != language + ".traineddata" ||
+      (language != "eng" && language != "ita" && language != "fra" &&
+       language != "deu" && language != "spa")) {
+    std::move(callback).Run(
+        Failure(mojom::Status::kInvalidInput, "Invalid local OCR request"));
+    return;
+  }
+  base::ScopedBlockingCall blocking(FROM_HERE, base::BlockingType::MAY_BLOCK);
+  auto decoded = DecodeImage(std::move(image));
+  if (!decoded.has_value()) {
+    std::move(callback).Run(std::move(decoded.error()));
+    return;
+  }
+  const auto pixels = decoded->pixels();
+  base::ScopedNativeLibrary library(
+      libraries.AppendASCII("libstainless_ocr.dylib"));
+  const auto version = Bind<decltype(&stainless_ocr_abi_version)>(
+      library, "stainless_ocr_abi_version");
+  const auto create =
+      Bind<decltype(&stainless_ocr_create)>(library, "stainless_ocr_create");
+  const auto run =
+      Bind<decltype(&stainless_ocr_run)>(library, "stainless_ocr_run");
+  const auto destroy =
+      Bind<decltype(&stainless_ocr_destroy)>(library, "stainless_ocr_destroy");
+  if (!library.is_valid() || !version || !create || !run || !destroy ||
+      version() != 2) {
+    LogRuntimeFailure(library, "OCR");
+    std::move(callback).Run(Failure(mojom::Status::kUnavailable,
+                                    "Bundled OCR runtime is unavailable"));
+    return;
+  }
+  StainlessRuntimeError error = {};
+  std::unique_ptr<StainlessOcr, decltype(destroy)> engine(
+      create(model->file.GetPlatformFile(), model->size, model->sha256.data(),
+             {language.data(), language.size()}, &error),
+      destroy);
+  if (!engine) {
+    std::move(callback).Run(Failure(error.code == STAINLESS_RUNTIME_OK
+                                        ? mojom::Status::kFailed
+                                        : NativeStatus(error.code),
+                                    "Verified OCR model load failed"));
+    return;
+  }
+  WordSink sink;
+  sink.result = mojom::Result::New();
+  sink.result->image_width = decoded->width;
+  sink.result->image_height = decoded->height;
+  const auto status =
+      run(engine.get(), pixels.data(), pixels.size(), decoded->width,
+          decoded->height, decoded->stride, EmitWord, &sink, &error);
+  engine.reset();
+  if (status != STAINLESS_RUNTIME_OK) {
+    std::move(callback).Run(Failure(NativeStatus(status),
+                                    "Local OCR did not complete successfully"));
+    return;
+  }
+  sink.result->status = mojom::Status::kOk;
+  std::move(callback).Run(std::move(sink.result));
+}
+
+void LocalWorker::RecognizeSpeech(mojom::ModelFilePtr model,
+                                  const std::vector<int16_t>& pcm,
+                                  const std::string& language,
+                                  RecognizeSpeechCallback callback) {
+  auto replies = base::SplitOnceCallback(std::move(callback));
+  if (!runner_->PostTask(FROM_HERE,
+                         base::BindOnce(&LocalWorker::RunSpeech, libraries_,
+                                        std::move(model), pcm, language,
+                                        base::BindPostTaskToCurrentDefault(
+                                            std::move(replies.first))))) {
+    std::move(replies.second)
+        .Run(
+            Failure(mojom::Status::kFailed, "Local speech worker is stopping"));
+  }
+}
+
+void LocalWorker::RunSpeech(const base::FilePath& libraries,
+                            mojom::ModelFilePtr model,
+                            const std::vector<int16_t>& pcm,
+                            const std::string& language,
+                            RecognizeSpeechCallback callback) {
+  if (!model || model->name != "model.bin" || pcm.empty() ||
+      pcm.size() > 480000 ||
+      (language != "en" && language != "it" && language != "fr" &&
+       language != "de" && language != "es")) {
+    std::move(callback).Run(
+        Failure(mojom::Status::kInvalidInput, "Invalid local speech request"));
+    return;
+  }
+  auto voiced = ContainsSpeech(pcm);
+  if (!voiced.has_value()) {
+    std::move(callback).Run(Failure(mojom::Status::kFailed,
+                                    "Local speech activity detection failed"));
+    return;
+  }
+  if (!*voiced) {
+    std::move(callback).Run(Failure(mojom::Status::kNoSpeech,
+                                    "No supported speech activity detected"));
+    return;
+  }
+  base::ScopedBlockingCall blocking(FROM_HERE, base::BlockingType::MAY_BLOCK);
+  base::ScopedNativeLibrary library(
+      libraries.AppendASCII("libstainless_speech.dylib"));
+  const auto version = Bind<decltype(&stainless_speech_abi_version)>(
+      library, "stainless_speech_abi_version");
+  const auto create = Bind<decltype(&stainless_speech_create)>(
+      library, "stainless_speech_create");
+  const auto run =
+      Bind<decltype(&stainless_speech_run)>(library, "stainless_speech_run");
+  const auto destroy = Bind<decltype(&stainless_speech_destroy)>(
+      library, "stainless_speech_destroy");
+  if (!library.is_valid() || !version || !create || !run || !destroy ||
+      version() != 1) {
+    LogRuntimeFailure(library, "speech");
+    std::move(callback).Run(Failure(mojom::Status::kUnavailable,
+                                    "Bundled speech runtime is unavailable"));
+    return;
+  }
+  StainlessModelFile file = {};
+  file.descriptor = model->file.GetPlatformFile();
+  file.size = model->size;
+  base::span(file.sha256).copy_from(model->sha256);
+  StainlessRuntimeError error = {};
+  std::unique_ptr<StainlessSpeech, decltype(destroy)> engine(
+      create(&file, 2, &error), destroy);
+  if (!engine) {
+    std::move(callback).Run(
+        Failure(error.code == STAINLESS_RUNTIME_OK ? mojom::Status::kFailed
+                                                   : NativeStatus(error.code),
+                "Verified local speech model initialization failed"));
+    return;
+  }
+  TokenSink sink;
+  StainlessSpeechMetadata metrics = {};
+  const auto status = run(engine.get(), pcm.data(), pcm.size(),
+                          {language.data(), language.size()}, EmitToken, &sink,
+                          &metrics, &error);
+  engine.reset();
+  if (status != STAINLESS_RUNTIME_OK) {
+    std::move(callback).Run(Failure(
+        NativeStatus(status), "Local speech did not complete successfully"));
+    return;
+  }
+  if (metrics.no_speech > 1 || metrics.has_metrics > 1 ||
+      !std::isfinite(metrics.average_log_probability) ||
+      !std::isfinite(metrics.no_speech_probability) ||
+      metrics.no_speech_probability < 0 || metrics.no_speech_probability > 1) {
+    std::move(callback).Run(Failure(mojom::Status::kFailed,
+                                    "Local speech returned invalid metrics"));
+    return;
+  }
+  auto result = mojom::Result::New();
+  result->status =
+      metrics.no_speech ? mojom::Status::kNoSpeech : mojom::Status::kOk;
+  result->speech = mojom::SpeechMetrics::New();
+  result->speech->has_metrics = metrics.has_metrics;
+  result->speech->average_log_probability = metrics.average_log_probability;
+  result->speech->no_speech_probability = metrics.no_speech_probability;
+  for (const auto& text : sink.tokens) {
+    result->text += text;
+  }
+  if ((metrics.no_speech && !result->text.empty()) ||
+      (!metrics.no_speech && !BoundedText(result->text, 32768))) {
+    std::move(callback).Run(
+        Failure(mojom::Status::kFailed,
+                "Local speech returned an invalid final transcript"));
+    return;
+  }
+  std::move(callback).Run(std::move(result));
+}
+
+void LocalWorker::DescribeImage(mojom::ModelFilePtr model,
+                                mojom::ModelFilePtr projector,
+                                mojom::ImagePtr image,
+                                DescribeImageCallback callback) {
+  auto replies = base::SplitOnceCallback(std::move(callback));
+  if (!runner_->PostTask(
+          FROM_HERE,
+          base::BindOnce(
+              &LocalWorker::RunDescription, libraries_, std::move(model),
+              std::move(projector), std::move(image),
+              base::BindPostTaskToCurrentDefault(std::move(replies.first))))) {
+    std::move(replies.second)
+        .Run(Failure(mojom::Status::kFailed,
+                     "Local image-description worker is stopping"));
+  }
+}
+
+void LocalWorker::RunDescription(const base::FilePath& libraries,
+                                 mojom::ModelFilePtr model,
+                                 mojom::ModelFilePtr projector,
+                                 mojom::ImagePtr image,
+                                 DescribeImageCallback callback) {
+  if (!model || !projector || model->sha256.size() != 32 ||
+      projector->sha256.size() != 32) {
+    std::move(callback).Run(Failure(mojom::Status::kInvalidInput,
+                                    "Invalid local image-description request"));
+    return;
+  }
+  base::ScopedBlockingCall blocking(FROM_HERE, base::BlockingType::MAY_BLOCK);
+  auto decoded = DecodeImage(std::move(image));
+  if (!decoded.has_value()) {
+    std::move(callback).Run(std::move(decoded.error()));
+    return;
+  }
+  const auto pixels = decoded->pixels();
+  auto color = MeasureUniformImageColor(pixels, decoded->width, decoded->height,
+                                        decoded->stride);
+  if (!color.has_value()) {
+    std::move(callback).Run(Failure(mojom::Status::kInvalidInput,
+                                    "Invalid local image-description raster"));
+    return;
+  }
+  base::ScopedNativeLibrary library(
+      libraries.AppendASCII("libstainless_vision.dylib"));
+  const auto version = Bind<decltype(&stainless_vision_abi_version)>(
+      library, "stainless_vision_abi_version");
+  const auto create = Bind<decltype(&stainless_vision_create)>(
+      library, "stainless_vision_create");
+  const auto run =
+      Bind<decltype(&stainless_vision_run)>(library, "stainless_vision_run");
+  const auto destroy = Bind<decltype(&stainless_vision_destroy)>(
+      library, "stainless_vision_destroy");
+  if (!library.is_valid() || !version || !create || !run || !destroy ||
+      version() != 1) {
+    LogRuntimeFailure(library, "image-description");
+    std::move(callback).Run(
+        Failure(mojom::Status::kUnavailable,
+                "Bundled image-description runtime is unavailable"));
+    return;
+  }
+  const auto text_model = NativeModel(*model);
+  const auto image_model = NativeModel(*projector);
+  StainlessRuntimeError error = {};
+  std::unique_ptr<StainlessVision, decltype(destroy)> engine(
+      create(&text_model, &image_model, 2, &error), destroy);
+  if (!engine) {
+    std::move(callback).Run(
+        Failure(error.code == STAINLESS_RUNTIME_OK ? mojom::Status::kFailed
+                                                   : NativeStatus(error.code),
+                "Verified local description model initialization failed"));
+    return;
+  }
+  TokenSink sink;
+  uint32_t generated_tokens = 0;
+  const auto status = run(engine.get(), pixels.data(), pixels.size(),
+                          decoded->width, decoded->height, decoded->stride,
+                          EmitToken, &sink, &generated_tokens, &error);
+  engine.reset();
+  if (status != STAINLESS_RUNTIME_OK) {
+    std::move(callback).Run(
+        Failure(NativeStatus(status),
+                "Local image description did not complete successfully"));
+    return;
+  }
+  std::string raw;
+  for (const auto& text : sink.tokens) {
+    raw += text;
+  }
+  if (!generated_tokens || generated_tokens > 256 || !BoundedText(raw, 32768)) {
+    std::move(callback).Run(
+        Failure(mojom::Status::kFailed,
+                "Local image description returned an invalid bounded result"));
+    return;
+  }
+  auto final = CompleteImageDescription(raw, *color);
+  if (!final.has_value()) {
+    std::move(callback).Run(
+        Failure(mojom::Status::kFailed,
+                "Local image description did not contain valid final text"));
+    return;
+  }
+  auto result = mojom::Result::New();
+  result->status = mojom::Status::kOk;
+  result->text = std::move(*final);
+  result->image_width = decoded->width;
+  result->image_height = decoded->height;
+  result->description = mojom::DescriptionEvidence::New();
+  result->description->raw_text = std::move(raw);
+  result->description->generated_tokens = generated_tokens;
+  result->description->measured_uniform_color = color->uniform;
+  std::move(callback).Run(std::move(result));
+}
+
+}  // namespace stainless_local
