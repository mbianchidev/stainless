+IN_PROC_BROWSER_TEST_F(StainlessCommandPaletteBrowserTest,
+                       SearchAndLiveAvailability) {
+  auto* palette = Open(browser());
+  ASSERT_TRUE(palette);
+  Query(palette, u"  n\u00e9W   w\u00edNDow  ");
+  EXPECT_TRUE(HasCommand(palette, IDC_NEW_WINDOW));
+  EXPECT_TRUE(HasCommand(palette, IDC_NEW_INCOGNITO_WINDOW));
+  Query(palette, u"n\u00e9W\tT\u00c1b");
+  EXPECT_TRUE(HasCommand(palette, IDC_NEW_TAB));
+  EXPECT_FALSE(HasCommand(palette, IDC_NEW_WINDOW));
+
+  for (auto query : {u"not-a-command", u"javascript:", u"chrome://", u"sync",
+                     u"DevTools", u"extension updates"}) {
+    Query(palette, query);
+    EXPECT_EQ(0u, palette->RowCount());
+    EXPECT_EQ(l10n_util::GetStringUTF16(IDS_STAINLESS_COMMAND_PALETTE_EMPTY),
+              Status(palette));
+  }
+  Query(palette, u"find");
+  EXPECT_TRUE(HasCommand(palette, IDC_FIND));
+  Action(browser(), IDC_FIND)->SetVisible(false);
+  EXPECT_FALSE(HasCommand(palette, IDC_FIND));
+  Key(palette, ui::VKEY_RETURN);
+  EXPECT_FALSE(chrome::CanCloseFind(browser()));
+  EXPECT_FALSE(palette->GetWidget()->IsClosed());
+  Action(browser(), IDC_FIND)->SetVisible(true);
+  Query(palette, u"");
+  EXPECT_TRUE(HasCommand(palette, IDC_FIND));
+  Close(palette);
+}
