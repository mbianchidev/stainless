+class StainlessCommandPaletteIncognitoBrowserTest
+    : public StainlessCommandPaletteBrowserTest {
+ public:
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    StainlessCommandPaletteBrowserTest::SetUpCommandLine(command_line);
+    command_line->AppendSwitchASCII("stainless-managed-mode", "incognito");
+    command_line->AppendSwitch("incognito");
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(StainlessCommandPaletteIncognitoBrowserTest,
+                       ForcedModeCommandsStayUnavailable) {
+  ASSERT_TRUE(browser()->GetProfile()->IsOffTheRecord());
+  browser()->GetProfile()->GetOriginalProfile()->GetPrefs()->SetInteger(
+      policy::policy_prefs::kIncognitoModeAvailability, 0);
+  auto* palette = Open(browser());
+  ASSERT_TRUE(palette);
+  EXPECT_FALSE(HasCommand(palette, IDC_NEW_WINDOW));
+  EXPECT_FALSE(HasCommand(palette, IDC_OPTIONS));
+  EXPECT_FALSE(HasCommand(palette, IDC_SHOW_BOOKMARK_MANAGER));
+  EXPECT_FALSE(HasCommand(palette, IDC_RESTORE_TAB));
+  EXPECT_TRUE(HasCommand(palette, IDC_NEW_TAB));
+  EXPECT_TRUE(HasCommand(palette, IDC_SHOW_DOWNLOADS));
+  Query(palette, u"settings");
+  EXPECT_EQ(0u, palette->RowCount());
+  Key(palette, ui::VKEY_RETURN);
+  EXPECT_FALSE(palette->GetWidget()->IsClosed());
+  Close(palette);
+  RunCommand(browser(), IDC_NEW_TAB);
+  EXPECT_TRUE(browser()
+                  ->GetTabStripModel()
+                  ->GetActiveWebContents()
+                  ->GetBrowserContext()
+                  ->IsOffTheRecord());
+}
+
+class StainlessCommandPaletteSafeModeBrowserTest
+    : public StainlessCommandPaletteBrowserTest {
+ public:
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    StainlessCommandPaletteBrowserTest::SetUpCommandLine(command_line);
+    command_line->AppendSwitchASCII("stainless-managed-mode", "standard");
+    command_line->AppendSwitch(stainless::kStartupSafeMode);
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(StainlessCommandPaletteSafeModeBrowserTest,
+                       RestorationCannotBeReenabledThroughPalette) {
+  ASSERT_TRUE(stainless::IsStartupSafeMode());
+  auto* palette = Open(browser());
+  ASSERT_TRUE(palette);
+  // Even a stale controller cannot restore a previous session in Safe Mode.
+  chrome::BrowserCommandController::From(browser())->UpdateCommandEnabled(
+      IDC_RESTORE_TAB, true);
+  EXPECT_FALSE(HasCommand(palette, IDC_RESTORE_TAB));
+  EXPECT_TRUE(HasCommand(palette, IDC_FIND));
+  Query(palette, u"reopen");
+  EXPECT_EQ(0u, palette->RowCount());
+  Key(palette, ui::VKEY_RETURN);
+  EXPECT_FALSE(palette->GetWidget()->IsClosed());
+  Close(palette);
+  RunCommand(browser(), IDC_NEW_TAB);
+}
