+IN_PROC_BROWSER_TEST_F(StainlessCommandPaletteBrowserTest,
+                       NativeMenuKeyboardFocusAndDismissal) {
+  NSEvent* event = [NSEvent keyEventWithType:NSEventTypeKeyDown
+                                    location:NSZeroPoint
+                               modifierFlags:NSEventModifierFlagCommand |
+                                             NSEventModifierFlagShift
+                                   timestamp:0
+                                windowNumber:0
+                                     context:nil
+                                  characters:@"P"
+                 charactersIgnoringModifiers:@"p"
+                                   isARepeat:NO
+                                     keyCode:kVK_ANSI_P];
+  const auto command = CommandForKeyEvent(event);
+  EXPECT_EQ(IDC_SHOW_COMMAND_PALETTE, command.chrome_command);
+  EXPECT_TRUE(command.from_main_menu);
+  auto* original_focus = BrowserView::GetBrowserViewForBrowser(browser())
+                             ->GetFocusManager()
+                             ->GetFocusedView();
+  ASSERT_TRUE(original_focus);
+  ASSERT_TRUE(chrome::ExecuteCommand(browser(), command.chrome_command));
+  auto* palette = Palette(browser());
+  ASSERT_TRUE(palette);
+  EXPECT_EQ(Search(palette), palette->GetFocusManager()->GetFocusedView());
+  EXPECT_TRUE(Search(palette)->IsDrawn());
+  ui::AXNodeData search_data;
+  Search(palette)->GetViewAccessibility().GetAccessibleNodeData(&search_data);
+  EXPECT_EQ(
+      l10n_util::GetStringUTF16(IDS_STAINLESS_COMMAND_PALETTE_SEARCH),
+      search_data.GetString16Attribute(ax::mojom::StringAttribute::kName));
+
+  EXPECT_EQ(palette, Open(browser()));
+  Key(palette, ui::VKEY_DOWN);
+  EXPECT_EQ(Table(palette), palette->GetFocusManager()->GetFocusedView());
+  EXPECT_EQ(0u, Table(palette)->GetFirstSelectedRow());
+  Key(palette, ui::VKEY_DOWN);
+  EXPECT_EQ(1u, Table(palette)->GetFirstSelectedRow());
+  Key(palette, ui::VKEY_UP);
+  EXPECT_EQ(0u, Table(palette)->GetFirstSelectedRow());
+  palette->GetFocusManager()->AdvanceFocus(true);
+  EXPECT_EQ(Search(palette), palette->GetFocusManager()->GetFocusedView());
+  Key(palette, ui::VKEY_ESCAPE);
+  ASSERT_TRUE(base::test::RunUntil([&] { return !Palette(browser()); }));
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(original_focus, BrowserView::GetBrowserViewForBrowser(browser())
+                                ->GetFocusManager()
+                                ->GetFocusedView());
+}
