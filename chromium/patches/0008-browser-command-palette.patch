+namespace {
+
+// This is deliberately not the browser's complete command registry.
+constexpr std::array kCommands = {
+    IDC_NEW_TAB,
+    IDC_NEW_WINDOW,
+    IDC_NEW_INCOGNITO_WINDOW,
+    IDC_CLOSE_TAB,
+    IDC_DUPLICATE_TAB,
+    IDC_RESTORE_TAB,
+    IDC_FIND,
+    IDC_BACK,
+    IDC_FORWARD,
+    IDC_RELOAD,
+    IDC_ZOOM_PLUS,
+    IDC_ZOOM_MINUS,
+    IDC_ZOOM_NORMAL,
+    IDC_FOCUS_LOCATION,
+    IDC_BOOKMARK_THIS_TAB,
+    IDC_SHOW_BOOKMARK_MANAGER,
+    IDC_SHOW_HISTORY,
+    IDC_SHOW_DOWNLOADS,
+    IDC_OPTIONS,
+};
+
+bool IsEligibleOwner(BrowserWindowInterface* browser) {
+  if (!browser || browser->IsDeleteScheduled() ||
+      browser->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+      browser->GetProfile()->IsGuestSession() ||
+      browser->GetProfile()->IsSystemProfile() ||
+      !chrome::SupportsCommand(browser, IDC_SHOW_COMMAND_PALETTE) ||
+      !chrome::IsCommandEnabled(browser, IDC_SHOW_COMMAND_PALETTE)) {
+    return false;
+  }
+  auto* tabs = browser->GetTabStripModel();
+  if (!tabs || tabs->active_index() == TabStripModel::kNoTab ||
+      tabs->IsTabBlocked(tabs->active_index()) ||
+      tabs->GetActiveWebContents()->GetBrowserContext() !=
+          browser->GetProfile()) {
+    return false;
+  }
+  auto* owner = BrowserView::GetBrowserViewForBrowser(browser);
+  if (!owner || !owner->GetWidget() || owner->GetWidget()->IsClosed()) {
+    return false;
+  }
+  auto* palette =
+      StainlessCommandPaletteView::Get(browser->GetUnownedUserDataHost());
+  for (auto* widget :
+       views::Widget::GetAllOwnedWidgets(owner->GetWidget()->GetNativeView())) {
+    if ((!palette || widget != palette->GetWidget()) && !widget->IsClosed() &&
+        widget->IsVisible() && widget->widget_delegate() &&
+        widget->widget_delegate()->GetModalType() !=
+            ui::mojom::ModalType::kNone) {
+      return false;
+    }
+  }
+  return true;
+}
+
+actions::ActionItem* GetAction(BrowserWindowInterface* browser, int command) {
+  auto action_id = chrome::GetActionIdForCommandId(command);
+  auto* browser_actions = BrowserActions::From(browser);
+  if (!action_id || !browser_actions || !browser_actions->root_action_item()) {
+    return nullptr;
+  }
+  return actions::ActionManager::Get().FindAction(
+      *action_id, browser_actions->root_action_item());
+}
+
+bool CanExecute(BrowserWindowInterface* browser, int command) {
+  if (!std::ranges::contains(kCommands, command) || !IsEligibleOwner(browser) ||
+      (command == IDC_RESTORE_TAB && stainless::IsStartupSafeMode()) ||
+      !chrome::SupportsCommand(browser, command) ||
+      !chrome::IsCommandEnabled(browser, command)) {
+    return false;
+  }
+  auto* action = GetAction(browser, command);
+  return action && action->GetVisible() && action->GetEnabled() &&
+         !action->GetText().empty();
+}
+
+}  // namespace
+
+// static
+void StainlessCommandPaletteView::AfterClose(
+    base::WeakPtr<BrowserWindowInterface> browser,
+    std::optional<int> command,
+    std::unique_ptr<views::ViewTracker> return_focus) {
+  if (!browser || browser->IsDeleteScheduled()) {
+    return;
+  }
+  if (command) {
+    // The native modal is gone. Recheck the same owner, not the active window.
+    if (!CanExecute(browser.get(), *command) ||
+        !chrome::ExecuteCommand(browser.get(), *command)) {
+      LOG(WARNING) << "Stainless command palette: command " << *command
+                   << " became unavailable before dispatch";
+      if (auto* palette = StainlessCommandPaletteView::Show(browser.get())) {
+        palette->ShowUnavailable();
+      }
+    }
+    return;
+  }
+  if (auto* view = return_focus->view();
+      view && view->IsDrawn() && view->IsFocusable()) {
+    view->RequestFocus();
+  } else if (auto* contents =
+                 browser->GetTabStripModel()->GetActiveWebContents()) {
+    contents->Focus();
+  }
+}
+
+DEFINE_USER_DATA(StainlessCommandPaletteView);
+
+// static
+StainlessCommandPaletteView* StainlessCommandPaletteView::Show(
+    BrowserWindowInterface* browser) {
+  if (!IsEligibleOwner(browser)) {
+    LOG(WARNING) << "Stainless command palette is unavailable for this window";
+    return nullptr;
+  }
+  if (auto* palette = Get(browser->GetUnownedUserDataHost())) {
+    if (!palette->GetWidget()->IsClosed()) {
+      palette->GetWidget()->Activate();
+      palette->search_->RequestFocus();
+    }
+    return palette;
+  }
+  auto* palette = new StainlessCommandPaletteView(browser);
+  auto* widget = constrained_window::CreateBrowserModalDialogViews(
+      palette, browser->GetWindow()->GetNativeWindow());
+  palette->widget_observation_.Observe(widget);
+  widget->Show();
+  return palette;
+}
+
+StainlessCommandPaletteView::StainlessCommandPaletteView(
+    BrowserWindowInterface* browser)
+    : browser_(browser), return_focus_(std::make_unique<views::ViewTracker>()) {
+  registration_.emplace(browser->GetUnownedUserDataHost(), *this);
+  return_focus_->SetView(BrowserView::GetBrowserViewForBrowser(browser)
+                             ->GetFocusManager()
+                             ->GetFocusedView());
+  browser_close_subscription_ = browser->RegisterBrowserDidClose(
+      base::BindRepeating(&StainlessCommandPaletteView::OnBrowserClosed,
+                          base::Unretained(this)));
+
+  SetTitle(l10n_util::GetStringUTF16(IDS_STAINLESS_COMMAND_PALETTE));
+  SetModalType(ui::mojom::ModalType::kWindow);
+  SetButtons(static_cast<int>(ui::mojom::DialogButton::kCancel));
+  SetButtonLabel(
+      ui::mojom::DialogButton::kCancel,
+      l10n_util::GetStringUTF16(IDS_STAINLESS_COMMAND_PALETTE_CLOSE));
+  SetDefaultButton(ui::mojom::DialogButton::kNone);
+  set_margins(ChromeLayoutProvider::Get()->GetDialogInsetsForContentType(
+      views::DialogContentType::kControl, views::DialogContentType::kControl));
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(),
+      ChromeLayoutProvider::Get()->GetDistanceMetric(
+          views::DISTANCE_RELATED_CONTROL_VERTICAL)));
+
+  search_ = AddChildView(std::make_unique<views::Textfield>());
+  search_->SetPlaceholderText(
+      l10n_util::GetStringUTF16(IDS_STAINLESS_COMMAND_PALETTE_SEARCH));
+  search_->GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_STAINLESS_COMMAND_PALETTE_SEARCH));
+  search_->set_controller(this);
+
+  ui::TableColumn command(0, ui::TableColumn::LEFT, -1, 1);
+  command.title =
+      l10n_util::GetStringUTF16(IDS_STAINLESS_COMMAND_PALETTE_COMMAND);
+  ui::TableColumn shortcut(1, ui::TableColumn::RIGHT, 130, 0);
+  shortcut.title =
+      l10n_util::GetStringUTF16(IDS_STAINLESS_COMMAND_PALETTE_SHORTCUT);
+  auto table = std::make_unique<views::TableView>(
+      this, std::vector{command, shortcut}, views::TableType::kTextOnly, true);
+  table_ = table.get();
+  table_->SetSelectOnRemove(false);
+  table_->set_observer(this);
+  table_->GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_STAINLESS_COMMAND_PALETTE_RESULTS));
+  auto* scroll = AddChildView(
+      views::TableView::CreateScrollViewWithTable(std::move(table)));
+  scroll->ClipHeightTo(280, 280);
+  scroll->SetHorizontalScrollBarMode(
+      views::ScrollView::ScrollBarMode::kDisabled);
+  scroll->SetAllowKeyboardScrolling(false);
+
+  status_ = AddChildView(std::make_unique<views::Label>(
+      std::u16string(), views::style::CONTEXT_LABEL,
+      views::style::STYLE_SECONDARY));
+  status_->SetMultiLine(true);
+  status_->SetHorizontalAlignment(gfx::HorizontalAlignment::ALIGN_LEFT);
+  status_->GetViewAccessibility().SetRole(ax::mojom::Role::kStatus);
+  status_->GetViewAccessibility().SetLiveRegionContainer(
+      views::ViewAccessibility::LiveRegionStatus::kPolite);
+  SetPreferredSize(gfx::Size(560, 430));
+
+  search_subscription_ = search_->AddTextChangedCallback(base::BindRepeating(
+      &StainlessCommandPaletteView::Refresh, base::Unretained(this), true));
+  for (int command_id : kCommands) {
+    if (auto* action = GetAction(browser, command_id)) {
+      action_subscriptions_.push_back(action->AddActionChangedCallback(
+          base::BindRepeating(&StainlessCommandPaletteView::Refresh,
+                              base::Unretained(this), false)));
+    }
+  }
+  if (auto* action = GetAction(browser, IDC_SHOW_COMMAND_PALETTE)) {
+    action_subscriptions_.push_back(action->AddActionChangedCallback(
+        base::BindRepeating(&StainlessCommandPaletteView::Refresh,
+                            base::Unretained(this), false)));
+  }
+  Refresh(true);
+}
+
+StainlessCommandPaletteView::~StainlessCommandPaletteView() {
+  table_->set_observer(nullptr);
+  table_->SetModel(nullptr);
+}
+
+views::View* StainlessCommandPaletteView::GetInitiallyFocusedView() {
+  return search_;
+}
+
+size_t StainlessCommandPaletteView::RowCount() const {
+  return results_.size();
+}
+
+std::u16string StainlessCommandPaletteView::GetText(size_t row,
+                                                    int column_id) const {
+  return column_id == 0 ? results_.at(row).label : results_.at(row).shortcut;
+}
+
+void StainlessCommandPaletteView::SetObserver(
+    ui::TableModelObserver* observer) {
+  model_observer_ = observer;
+}
+
+void StainlessCommandPaletteView::Refresh(bool query_changed) {
+  if (!browser_ || pending_command_ ||
+      (GetWidget() && GetWidget()->IsClosed())) {
+    return;
+  }
+  std::optional<int> selected;
+  if (auto row = table_->GetFirstSelectedRow(); row && *row < results_.size()) {
+    selected = results_[*row].command_id;
+  }
+  auto terms =
+      base::SplitStringPiece(search_->GetText(), base::kWhitespaceUTF16,
+                             base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  std::vector<Result> results;
+  for (int command : kCommands) {
+    if (!CanExecute(browser_, command)) {
+      continue;
+    }
+    auto* action = GetAction(browser_, command);
+    auto label = chrome::GetCleanText(action->GetText());
+    if (std::ranges::all_of(terms, [&label](std::u16string_view term) {
+          return base::i18n::StringSearchIgnoringCaseAndAccents(
+              term, label, nullptr, nullptr);
+        })) {
+      auto accelerator = action->GetAccelerator();
+      results.push_back({command, std::move(label),
+                         accelerator.key_code() == ui::VKEY_UNKNOWN
+                             ? std::u16string()
+                             : accelerator.GetShortcutText()});
+    }
+  }
+  if (!query_changed && results == results_) {
+    return;
+  }
+  results_ = std::move(results);
+  if (model_observer_) {
+    model_observer_->OnModelChanged();
+  }
+  std::optional<size_t> row;
+  if (query_changed && !results_.empty()) {
+    row = 0;
+  } else if (selected) {
+    auto it = std::ranges::find(results_, *selected, &Result::command_id);
+    if (it != results_.end()) {
+      row = std::distance(results_.begin(), it);
+    }
+  }
+  table_->Select(row);
+  status_->SetText(
+      results_.empty()
+          ? l10n_util::GetStringUTF16(IDS_STAINLESS_COMMAND_PALETTE_EMPTY)
+          : l10n_util::GetStringFUTF16(
+                IDS_STAINLESS_COMMAND_PALETTE_HINT,
+                base::NumberToString16(results_.size())));
+  if (!query_changed && selected && !row) {
+    ShowUnavailable();
+  }
+}
+
+void StainlessCommandPaletteView::OnSelectionChanged() {}
+
+void StainlessCommandPaletteView::OnDoubleClick() {
+  ActivateSelected();
+}
+
+void StainlessCommandPaletteView::OnKeyDown(ui::KeyboardCode key_code) {
+  if (key_code == ui::VKEY_RETURN) {
+    ActivateSelected();
+  }
+}
+
+bool StainlessCommandPaletteView::HandleKeyEvent(views::Textfield* sender,
+                                                 const ui::KeyEvent& event) {
+  if (event.type() != ui::EventType::kKeyPressed || event.IsShiftDown() ||
+      event.IsControlDown() || event.IsAltDown() || event.IsCommandDown() ||
+      sender->IsIMEComposing()) {
+    return false;
+  }
+  switch (event.key_code()) {
+    case ui::VKEY_RETURN:
+      ActivateSelected();
+      return true;
+    case ui::VKEY_DOWN:
+    case ui::VKEY_UP:
+      if (!results_.empty()) {
+        table_->Select(event.key_code() == ui::VKEY_DOWN ? 0
+                                                         : results_.size() - 1);
+        table_->RequestFocus();
+      }
+      return true;
+    default:
+      return false;
+  }
+}
+
+void StainlessCommandPaletteView::ActivateSelected() {
+  if (pending_command_ || GetWidget()->IsClosed()) {
+    LOG(WARNING) << "Stainless command palette: activation is already pending";
+    return;
+  }
+  auto row = table_->GetFirstSelectedRow();
+  if (!row && results_.empty()) {
+    LOG(WARNING) << "Stainless command palette: no matching available commands";
+    return;
+  }
+  if (!browser_ || !row || *row >= results_.size() ||
+      !CanExecute(browser_, results_[*row].command_id)) {
+    LOG(WARNING) << "Stainless command palette: no available selected command";
+    Refresh(false);
+    ShowUnavailable();
+    return;
+  }
+  pending_command_ = results_[*row].command_id;
+  GetWidget()->CloseWithReason(
+      views::Widget::ClosedReason::kAcceptButtonClicked);
+}
+
+void StainlessCommandPaletteView::ShowUnavailable() {
+  status_->SetText(
+      l10n_util::GetStringUTF16(IDS_STAINLESS_COMMAND_PALETTE_UNAVAILABLE));
+}
+
+void StainlessCommandPaletteView::OnBrowserClosed(
+    BrowserWindowInterface* browser) {
+  pending_command_.reset();
+  action_subscriptions_.clear();
+  registration_.reset();
+  browser_ = nullptr;
+  GetWidget()->Close();
+}
+
+void StainlessCommandPaletteView::OnWidgetDestroyed(views::Widget* widget) {
+  widget_observation_.Reset();
+  auto browser = browser_ ? browser_->GetWeakPtr()
+                          : base::WeakPtr<BrowserWindowInterface>();
+  registration_.reset();
+  action_subscriptions_.clear();
+  browser_close_subscription_ = {};
+  browser_ = nullptr;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&StainlessCommandPaletteView::AfterClose,
+                                std::move(browser), pending_command_,
+                                std::move(return_focus_)));
+}
+
+namespace chrome {
+
+void ShowCommandPalette(BrowserWindowInterface* browser) {
+  StainlessCommandPaletteView::Show(browser);
+}
+
+}  // namespace chrome
