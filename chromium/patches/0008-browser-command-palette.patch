+IN_PROC_BROWSER_TEST_F(StainlessCommandPaletteBrowserTest,
+                       OwningBrowserModalAndCloseGuards) {
+  auto* other = CreateBrowser(browser()->GetProfile());
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      other, GURL("data:text/html,<title>Other fixture</title>")));
+  const int count = browser()->GetTabStripModel()->count();
+  const int other_count = other->GetTabStripModel()->count();
+  RunCommand(browser(), IDC_NEW_TAB);
+  EXPECT_EQ(count + 1, browser()->GetTabStripModel()->count());
+  EXPECT_EQ(other_count, other->GetTabStripModel()->count());
+
+  auto* popup = CreateBrowserForPopup(browser()->GetProfile());
+  EXPECT_EQ(nullptr, StainlessCommandPaletteView::Show(popup));
+  CloseBrowserSynchronously(popup);
+  browser()->GetTabStripModel()->SetTabBlocked(
+      browser()->GetTabStripModel()->active_index(), true);
+  EXPECT_EQ(nullptr, StainlessCommandPaletteView::Show(browser()));
+  browser()->GetTabStripModel()->SetTabBlocked(
+      browser()->GetTabStripModel()->active_index(), false);
+
+  auto dialog = std::make_unique<views::DialogDelegate>();
+  dialog->SetModalType(ui::mojom::ModalType::kWindow);
+  auto* modal = constrained_window::CreateBrowserModalDialogViews(
+      std::move(dialog), browser()->GetWindow()->GetNativeWindow());
+  modal->Show();
+  EXPECT_EQ(nullptr, StainlessCommandPaletteView::Show(browser()));
+  modal->Close();
+  base::RunLoop().RunUntilIdle();
+
+  auto* palette = Open(other);
+  ASSERT_TRUE(palette);
+  views::ViewTracker tracker;
+  tracker.SetView(palette);
+  CloseBrowserSynchronously(other);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(nullptr, tracker.view());
+}
+
+IN_PROC_BROWSER_TEST_F(StainlessCommandPaletteBrowserTest,
+                       ExistingBrowserActionsActuallyDispatch) {
+  RunCommand(browser(), IDC_FIND);
+  EXPECT_TRUE(chrome::CanCloseFind(browser()));
+  chrome::CloseFind(browser());
+  for (auto [command, url] :
+       {std::pair{IDC_SHOW_DOWNLOADS, "chrome://downloads/"},
+        std::pair{IDC_SHOW_HISTORY, "chrome://history/"},
+        std::pair{IDC_SHOW_BOOKMARK_MANAGER, "chrome://bookmarks/"},
+        std::pair{IDC_OPTIONS, "chrome://settings/"}}) {
+    RunCommand(browser(), command);
+    ASSERT_TRUE(base::test::RunUntil([&] {
+      auto* contents = browser()->GetTabStripModel()->GetActiveWebContents();
+      return contents->GetLastCommittedURL() == GURL(url) &&
+             !contents->IsLoading();
+    }));
+    EXPECT_EQ(browser()->GetProfile(), browser()
+                                           ->GetTabStripModel()
+                                           ->GetActiveWebContents()
+                                           ->GetBrowserContext());
+  }
+  const int count = browser()->GetTabStripModel()->count();
+  RunCommand(browser(), IDC_DUPLICATE_TAB);
+  EXPECT_EQ(count + 1, browser()->GetTabStripModel()->count());
+  RunCommand(browser(), IDC_CLOSE_TAB);
+  EXPECT_EQ(count, browser()->GetTabStripModel()->count());
+}
