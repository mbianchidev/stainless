+class StainlessCommandPaletteBrowserTest : public InProcessBrowserTest {
+ public:
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    command_line->AppendSwitchASCII("headless", "new");
+    command_line->AppendSwitch("use-mock-keychain");
+    command_line->AppendSwitchASCII("lang", "en-US");
+  }
+
+  void SetUpOnMainThread() override {
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(
+        browser(), GURL("data:text/html,<title>Palette fixture</title>"
+                        "<p>synthetic browsing fixture</p>")));
+  }
+
+  StainlessCommandPaletteView* Palette(BrowserWindowInterface* owner) {
+    return StainlessCommandPaletteView::Get(owner->GetUnownedUserDataHost());
+  }
+
+  StainlessCommandPaletteView* Open(BrowserWindowInterface* owner) {
+    EXPECT_TRUE(chrome::ExecuteCommand(owner, IDC_SHOW_COMMAND_PALETTE));
+    return Palette(owner);
+  }
+
+  void Query(StainlessCommandPaletteView* palette, std::u16string_view text) {
+    palette->search_->SetText(text);
+  }
+
+  bool HasCommand(StainlessCommandPaletteView* palette, int command) {
+    return std::ranges::contains(
+        palette->results_, command,
+        &StainlessCommandPaletteView::Result::command_id);
+  }
+
+  void SelectCommand(StainlessCommandPaletteView* palette, int command) {
+    auto it =
+        std::ranges::find(palette->results_, command,
+                          &StainlessCommandPaletteView::Result::command_id);
+    ASSERT_NE(it, palette->results_.end());
+    palette->table_->Select(std::distance(palette->results_.begin(), it));
+  }
+
+  actions::ActionItem* Action(BrowserWindowInterface* owner, int command) {
+    return actions::ActionManager::Get().FindAction(
+        *chrome::GetActionIdForCommandId(command),
+        BrowserActions::From(owner)->root_action_item());
+  }
+
+  void Key(StainlessCommandPaletteView* palette, ui::KeyboardCode key) {
+    ui::KeyEvent event(ui::EventType::kKeyPressed, key, ui::EF_NONE);
+    auto* focused = palette->GetFocusManager()->GetFocusedView();
+    ASSERT_TRUE(focused);
+    if (!focused->OnKeyPressed(event)) {
+      palette->GetFocusManager()->ProcessAccelerator(ui::Accelerator(key, 0));
+    }
+  }
+
+  views::Textfield* Search(StainlessCommandPaletteView* palette) {
+    return palette->search_;
+  }
+
+  views::TableView* Table(StainlessCommandPaletteView* palette) {
+    return palette->table_;
+  }
+
+  std::u16string Status(StainlessCommandPaletteView* palette) {
+    return palette->status_->GetText();
+  }
+
+  void Close(StainlessCommandPaletteView* palette) {
+    palette->GetWidget()->Close();
+    base::RunLoop().RunUntilIdle();
+  }
+
+  void RunCommand(BrowserWindowInterface* owner, int command) {
+    auto* palette = Open(owner);
+    ASSERT_TRUE(palette);
+    SelectCommand(palette, command);
+    Key(palette, ui::VKEY_RETURN);
+    ASSERT_TRUE(base::test::RunUntil([&] { return !Palette(owner); }));
+    base::RunLoop().RunUntilIdle();
+  }
+};
