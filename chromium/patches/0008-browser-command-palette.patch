+IN_PROC_BROWSER_TEST_F(StainlessCommandPaletteBrowserTest,
+                       DisabledAndDispatchRaceDoNotExecute) {
+  auto* controller = chrome::BrowserCommandController::From(browser());
+  const int count = browser()->GetTabStripModel()->count();
+  auto* palette = Open(browser());
+  ASSERT_TRUE(palette);
+  Query(palette, u"new tab");
+  controller->UpdateCommandEnabled(IDC_NEW_TAB, false);
+  EXPECT_FALSE(HasCommand(palette, IDC_NEW_TAB));
+  Key(palette, ui::VKEY_RETURN);
+  EXPECT_EQ(count, browser()->GetTabStripModel()->count());
+  EXPECT_FALSE(palette->GetWidget()->IsClosed());
+  controller->UpdateCommandEnabled(IDC_NEW_TAB, true);
+  Query(palette, u"new tab");
+  SelectCommand(palette, IDC_NEW_TAB);
+  Key(palette, ui::VKEY_RETURN);
+  controller->UpdateCommandEnabled(IDC_NEW_TAB, false);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(count, browser()->GetTabStripModel()->count());
+  ASSERT_TRUE(Palette(browser()));
+  EXPECT_EQ(
+      l10n_util::GetStringUTF16(IDS_STAINLESS_COMMAND_PALETTE_UNAVAILABLE),
+      Status(Palette(browser())));
+  controller->UpdateCommandEnabled(IDC_NEW_TAB, true);
+  Close(Palette(browser()));
+  RunCommand(browser(), IDC_NEW_TAB);
+  EXPECT_EQ(count + 1, browser()->GetTabStripModel()->count());
+}
