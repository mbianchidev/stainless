diff --git a/chrome/browser/stainless_startup/safe_storage_key.cc b/chrome/browser/stainless_startup/safe_storage_key.cc
new file mode 100644
index 0000000000000000000000000000000000000000..7d46a3493f3f1f36a1a6c207c319249e376161a1
--- /dev/null
+++ b/chrome/browser/stainless_startup/safe_storage_key.cc
@@ -0,0 +1,115 @@
+// Copyright 2026 Synctune Open
+
+#include "chrome/browser/stainless_startup/safe_storage_key.h"
+
+#include <algorithm>
+#include <array>
+#include <string>
+
+#include "base/command_line.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/files/important_file_writer.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/logging.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/values.h"
+#include "components/os_crypt/common/os_crypt_switches.h"
+#include "crypto/random.h"
+
+namespace stainless {
+namespace {
+
+constexpr int kRecordVersion = 1;
+constexpr size_t kMaxRecordBytes = 4096;
+constexpr size_t kKeyIdBytes = 16;
+
+bool IsKeyId(const std::string& key_id) {
+  return key_id.size() == 2 * kKeyIdBytes &&
+         std::ranges::all_of(key_id, [](char c) {
+           return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
+         });
+}
+
+bool WriteRecord(const base::FilePath& record, const std::string& key_id) {
+  base::DictValue dict;
+  dict.Set("version", kRecordVersion);
+  dict.Set("key_id", key_id);
+  std::optional<std::string> json = base::WriteJson(dict);
+  return json &&
+         base::ImportantFileWriter::WriteFileAtomically(record, *json + "\n");
+}
+
+}  // namespace
+
+std::optional<std::string> ReadSafeStorageKeyId(
+    const base::FilePath& user_data_dir) {
+  std::string contents;
+  if (!base::ReadFileToStringWithMaxSize(
+          user_data_dir.Append(kSafeStorageKeyFileName), &contents,
+          kMaxRecordBytes)) {
+    return std::nullopt;
+  }
+  std::optional<base::DictValue> dict =
+      base::JSONReader::ReadDict(contents, base::JSON_PARSE_RFC);
+  if (!dict || dict->size() != 2 ||
+      dict->FindInt("version") != kRecordVersion) {
+    return std::nullopt;
+  }
+  const std::string* key_id = dict->FindString("key_id");
+  if (!key_id || (*key_id != kLegacySafeStorageKeyId && !IsKeyId(*key_id))) {
+    return std::nullopt;
+  }
+  return *key_id;
+}
+
+bool SelectSafeStorageKey(const base::FilePath& user_data_dir,
+                          base::CommandLine& command_line) {
+  // Only this function chooses the key; a launch argument cannot.
+  command_line.RemoveSwitch(os_crypt::switches::kStainlessSafeStorageKey);
+  const std::string managed_mode =
+      command_line.GetSwitchValueASCII("stainless-managed-mode");
+  if (user_data_dir.empty() || managed_mode == "incognito" ||
+      managed_mode == "guest") {
+    // Fresh temporary roots keep no saved passwords or persistent cookies.
+    return true;
+  }
+  const base::FilePath record = user_data_dir.Append(kSafeStorageKeyFileName);
+  std::optional<std::string> key_id;
+  if (base::PathExists(record)) {
+    key_id = ReadSafeStorageKeyId(user_data_dir);
+    if (!key_id) {
+      LOG(ERROR) << "The Stainless Safe Storage key record " << record
+                 << " is unreadable. Stainless will not start this profile, "
+                    "because another key would make its saved passwords and "
+                    "cookies unreadable. Restore the file from a backup.";
+      return false;
+    }
+  } else {
+    // A root that already holds Chromium data was encrypted with the shared
+    // item; changing its key would hide that data.
+    const bool fresh =
+        !base::PathExists(user_data_dir.AppendASCII("Local State")) &&
+        !base::PathExists(user_data_dir.AppendASCII("Default"));
+    if (fresh) {
+      std::array<uint8_t, kKeyIdBytes> bytes;
+      crypto::RandBytes(bytes);
+      key_id = base::HexEncodeLower(bytes);
+    } else {
+      key_id = kLegacySafeStorageKeyId;
+    }
+    if (!WriteRecord(record, *key_id)) {
+      LOG(ERROR) << "Cannot record the Stainless Safe Storage key in "
+                 << record << "; Stainless will not start this profile";
+      return false;
+    }
+  }
+  if (*key_id != kLegacySafeStorageKeyId) {
+    command_line.AppendSwitchASCII(os_crypt::switches::kStainlessSafeStorageKey,
+                                   *key_id);
+  }
+  return true;
+}
+
+}  // namespace stainless
diff --git a/chrome/browser/stainless_startup/safe_storage_key.h b/chrome/browser/stainless_startup/safe_storage_key.h
new file mode 100644
index 0000000000000000000000000000000000000000..bcef2e17be6a6b7683bb0c80bc466c8ab09e1cd8
--- /dev/null
+++ b/chrome/browser/stainless_startup/safe_storage_key.h
@@ -0,0 +1,41 @@
+// Copyright 2026 Synctune Open
+
+#ifndef CHROME_BROWSER_STAINLESS_STARTUP_SAFE_STORAGE_KEY_H_
+#define CHROME_BROWSER_STAINLESS_STARTUP_SAFE_STORAGE_KEY_H_
+
+#include <optional>
+#include <string>
+
+namespace base {
+class CommandLine;
+class FilePath;
+}  // namespace base
+
+namespace stainless {
+
+// Versioned per-root record naming the Keychain item that protects this root's
+// Safe Storage key: {"version":1,"key_id":"<32 lowercase hex>"}, or
+// {"version":1,"key_id":"legacy"} for a root created before per-root keys,
+// which keeps the shared "Stainless Safe Storage" / "Stainless" item.
+inline constexpr char kSafeStorageKeyFileName[] = "Stainless Safe Storage Key";
+inline constexpr char kLegacySafeStorageKeyId[] = "legacy";
+
+// Browser process only. Call after acquiring the process singleton and before
+// OSCrypt starts. A new persistent root gets its own random key ID; a root that
+// already holds Chromium data keeps the shared legacy item; fresh managed
+// Incognito and Guest roots use the shared item without a record. A root key
+// is passed to OSCrypt with os_crypt::switches::kStainlessSafeStorageKey.
+// Returns false, and the browser must not start, when the record is unreadable
+// or cannot be written: another key would hide the root's saved passwords and
+// cookies.
+bool SelectSafeStorageKey(const base::FilePath& user_data_dir,
+                          base::CommandLine& command_line);
+
+// The recorded key ID, kLegacySafeStorageKeyId, or std::nullopt when there is
+// no valid record.
+std::optional<std::string> ReadSafeStorageKeyId(
+    const base::FilePath& user_data_dir);
+
+}  // namespace stainless
+
+#endif  // CHROME_BROWSER_STAINLESS_STARTUP_SAFE_STORAGE_KEY_H_
