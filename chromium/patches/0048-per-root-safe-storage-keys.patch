diff --git a/components/os_crypt/async/browser/stainless_safe_storage_key_unittest.mm b/components/os_crypt/async/browser/stainless_safe_storage_key_unittest.mm
new file mode 100644
index 0000000000000000000000000000000000000000..8f6c9bf13badbac3cfeff2b9019a19b49c873f19
--- /dev/null
+++ b/components/os_crypt/async/browser/stainless_safe_storage_key_unittest.mm
@@ -0,0 +1,158 @@
+// Copyright 2026 Synctune Open
+
+#include <map>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/containers/to_vector.h"
+#include "base/memory/ptr_util.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/synchronization/lock.h"
+#include "base/test/scoped_command_line.h"
+#include "base/test/task_environment.h"
+#include "base/test/test_future.h"
+#include "components/os_crypt/async/browser/keychain_key_provider.h"
+#include "components/os_crypt/async/browser/os_crypt_async.h"
+#include "components/os_crypt/async/common/encryptor.h"
+#include "components/os_crypt/common/os_crypt_switches.h"
+#include "crypto/apple/fake_keychain_v2.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace os_crypt_async {
+namespace {
+
+constexpr char kRootA[] = "0123456789abcdef0123456789abcdef";
+constexpr char kRootB[] = "fedcba9876543210fedcba9876543210";
+
+// Stores generic passwords per service and account, like the real Keychain.
+// The stock fake returns one fixed password for every account.
+class AccountKeychain final : public crypto::apple::FakeKeychainV2 {
+ public:
+  AccountKeychain() : FakeKeychainV2("test-access-group") {}
+
+  base::expected<std::vector<uint8_t>, OSStatus> FindGenericPassword(
+      std::string_view service_name,
+      std::string_view account_name) override {
+    base::AutoLock lock(lock_);
+    requested_.emplace_back(account_name);
+    auto it = items_.find({std::string(service_name), std::string(account_name)});
+    if (it == items_.end()) {
+      return base::unexpected(errSecItemNotFound);
+    }
+    return it->second;
+  }
+
+  OSStatus AddGenericPassword(std::string_view service_name,
+                              std::string_view account_name,
+                              base::span<const uint8_t> password) override {
+    base::AutoLock lock(lock_);
+    items_[{std::string(service_name), std::string(account_name)}] =
+        base::ToVector(password);
+    return noErr;
+  }
+
+  std::vector<std::string> requested() const {
+    base::AutoLock lock(lock_);
+    return requested_;
+  }
+
+  size_t item_count() const {
+    base::AutoLock lock(lock_);
+    return items_.size();
+  }
+
+ private:
+  mutable base::Lock lock_;
+  std::map<std::pair<std::string, std::string>, std::vector<uint8_t>> items_;
+  std::vector<std::string> requested_;
+};
+
+}  // namespace
+
+class StainlessSafeStorageKeyTest : public testing::Test {
+ protected:
+  // The encryptor a browser for the root with `key_id` would get. An empty
+  // `key_id` is a root that uses the shared legacy item.
+  scoped_refptr<Encryptor> EncryptorFor(const std::string& key_id) {
+    base::test::ScopedCommandLine command_line;
+    if (!key_id.empty()) {
+      command_line.GetProcessCommandLine()->AppendSwitchASCII(
+          os_crypt::switches::kStainlessSafeStorageKey, key_id);
+    }
+    std::vector<std::pair<OSCryptAsync::Precedence,
+                          std::unique_ptr<KeyProvider>>>
+        providers;
+    providers.emplace_back(
+        10u, base::WrapUnique(new KeychainKeyProvider(&keychain_)));
+    OSCryptAsync os_crypt(std::move(providers));
+    base::test::TestFuture<scoped_refptr<Encryptor>> encryptor;
+    os_crypt.GetInstance(encryptor.GetCallback());
+    return encryptor.Take();
+  }
+
+  static std::string Encrypt(const Encryptor& encryptor) {
+    std::string ciphertext;
+    EXPECT_TRUE(encryptor.EncryptString("synthetic cookie", &ciphertext));
+    return ciphertext;
+  }
+
+  static bool Decrypts(const Encryptor& encryptor,
+                       const std::string& ciphertext) {
+    std::string plaintext;
+    return encryptor.DecryptString(ciphertext, &plaintext) &&
+           plaintext == "synthetic cookie";
+  }
+
+  base::test::TaskEnvironment task_environment_{
+      base::test::TaskEnvironment::MainThreadType::UI};
+  AccountKeychain keychain_;
+};
+
+namespace {
+
+TEST_F(StainlessSafeStorageKeyTest, EachRootUsesItsOwnKeychainItem) {
+  scoped_refptr<Encryptor> root_a = EncryptorFor(kRootA);
+  ASSERT_TRUE(root_a);
+  const std::string from_a = Encrypt(*root_a);
+
+  scoped_refptr<Encryptor> root_b = EncryptorFor(kRootB);
+  ASSERT_TRUE(root_b);
+  EXPECT_FALSE(Decrypts(*root_b, from_a));
+  const std::string from_b = Encrypt(*root_b);
+  EXPECT_FALSE(Decrypts(*root_a, from_b));
+
+  scoped_refptr<Encryptor> legacy = EncryptorFor(std::string());
+  ASSERT_TRUE(legacy);
+  EXPECT_FALSE(Decrypts(*legacy, from_a));
+  EXPECT_FALSE(Decrypts(*legacy, from_b));
+
+  // A later browser for root A reads the same item and keeps its data.
+  scoped_refptr<Encryptor> root_a_again = EncryptorFor(kRootA);
+  ASSERT_TRUE(root_a_again);
+  EXPECT_TRUE(Decrypts(*root_a_again, from_a));
+
+  EXPECT_EQ(3u, keychain_.item_count());
+  const std::vector<std::string> expected = {
+      std::string("Stainless ") + kRootA, std::string("Stainless ") + kRootB,
+      "Stainless", std::string("Stainless ") + kRootA};
+  EXPECT_EQ(expected, keychain_.requested());
+}
+
+TEST_F(StainlessSafeStorageKeyTest, MalformedKeyIdNeverFallsBackToShared) {
+  for (const char* key_id :
+       {"legacy", "0123", "0123456789ABCDEF0123456789ABCDEF",
+        "0123456789abcdef0123456789abcdeg",
+        "0123456789abcdef0123456789abcdef0"}) {
+    SCOPED_TRACE(key_id);
+    scoped_refptr<Encryptor> encryptor = EncryptorFor(key_id);
+    ASSERT_TRUE(encryptor);
+    std::string ciphertext;
+    EXPECT_FALSE(encryptor->EncryptString("synthetic cookie", &ciphertext));
+  }
+  EXPECT_TRUE(keychain_.requested().empty());
+  EXPECT_EQ(0u, keychain_.item_count());
+}
