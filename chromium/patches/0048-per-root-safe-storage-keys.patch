+// Stainless: the account of this root's Safe Storage item. A root with its
+// own key uses "Stainless <key ID>"; otherwise the shared "Stainless" item.
+// A malformed key ID returns nullopt rather than falling back to the shared
+// item, which would hide the root's data behind the wrong key.
+std::optional<std::string> StainlessAccountName(
+    const std::string& shared_account) {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch(os_crypt::switches::kStainlessSafeStorageKey)) {
+    return shared_account;
+  }
+  const std::string key_id = command_line->GetSwitchValueASCII(
+      os_crypt::switches::kStainlessSafeStorageKey);
+  if (key_id.size() != 32 || !std::ranges::all_of(key_id, [](char c) {
+        return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
+      })) {
+    return std::nullopt;
+  }
+  return shared_account + " " + key_id;
+}
