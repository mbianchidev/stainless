@@ -0,0 +1,111 @@
+// Copyright 2026 Synctune Open
+
+#include "chrome/browser/stainless_startup/safe_storage_key.h"
+
+#include <optional>
+#include <string>
+
+#include "base/command_line.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/path_service.h"
+#include "base/threading/thread_restrictions.h"
+#include "chrome/common/chrome_paths.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "components/os_crypt/common/os_crypt_switches.h"
+#include "content/public/test/browser_test.h"
+
+namespace {
+
+constexpr char kRecordedKey[] = "00112233445566778899aabbccddeeff";
+
+base::FilePath UserDataDir() {
+  return base::PathService::CheckedGet(chrome::DIR_USER_DATA);
+}
+
+std::optional<std::string> RecordedKeyId() {
+  base::ScopedAllowBlockingForTesting allow_blocking;
+  return stainless::ReadSafeStorageKeyId(UserDataDir());
+}
+
+std::string SelectedKeyId() {
+  return base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+      os_crypt::switches::kStainlessSafeStorageKey);
+}
+
+}  // namespace
+
+using StainlessFreshRootSafeStorageKeyBrowserTest = InProcessBrowserTest;
+
+IN_PROC_BROWSER_TEST_F(StainlessFreshRootSafeStorageKeyBrowserTest,
+                       PRE_FreshRootKeepsItsOwnKey) {
+  std::optional<std::string> key_id = RecordedKeyId();
+  ASSERT_TRUE(key_id);
+  EXPECT_EQ(32u, key_id->size());
+  EXPECT_NE(stainless::kLegacySafeStorageKeyId, *key_id);
+  EXPECT_EQ(*key_id, SelectedKeyId());
+}
+
+IN_PROC_BROWSER_TEST_F(StainlessFreshRootSafeStorageKeyBrowserTest,
+                       FreshRootKeepsItsOwnKey) {
+  // The second launch of the same root reuses the recorded key.
+  std::optional<std::string> key_id = RecordedKeyId();
+  ASSERT_TRUE(key_id);
+  EXPECT_EQ(32u, key_id->size());
+  EXPECT_EQ(*key_id, SelectedKeyId());
+}
+
+class StainlessRecordedSafeStorageKeyBrowserTest : public InProcessBrowserTest {
+ protected:
+  bool SetUpUserDataDirectory() override {
+    return base::WriteFile(
+        UserDataDir().Append(stainless::kSafeStorageKeyFileName),
+        std::string("{\"version\":1,\"key_id\":\"") + kRecordedKey + "\"}\n");
+  }
+
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    InProcessBrowserTest::SetUpCommandLine(command_line);
+    // A launch argument cannot select another root's key.
+    command_line->AppendSwitchASCII(
+        os_crypt::switches::kStainlessSafeStorageKey,
+        "ffeeddccbbaa99887766554433221100");
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(StainlessRecordedSafeStorageKeyBrowserTest,
+                       UsesTheRecordedKeyOnly) {
+  EXPECT_EQ(kRecordedKey, RecordedKeyId());
+  EXPECT_EQ(kRecordedKey, SelectedKeyId());
+}
+
+// A root that held Chromium data before per-root keys keeps the shared item.
+class StainlessLegacyRootSafeStorageKeyBrowserTest
+    : public InProcessBrowserTest {
+ protected:
+  bool SetUpUserDataDirectory() override {
+    return base::WriteFile(UserDataDir().AppendASCII("Local State"), "{}");
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(StainlessLegacyRootSafeStorageKeyBrowserTest,
+                       KeepsTheSharedItem) {
+  EXPECT_EQ(stainless::kLegacySafeStorageKeyId, RecordedKeyId());
+  EXPECT_FALSE(base::CommandLine::ForCurrentProcess()->HasSwitch(
+      os_crypt::switches::kStainlessSafeStorageKey));
+}
+
+class StainlessTemporaryRootSafeStorageKeyBrowserTest
+    : public InProcessBrowserTest {
+ protected:
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    InProcessBrowserTest::SetUpCommandLine(command_line);
+    command_line->AppendSwitchASCII("stainless-managed-mode", "incognito");
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(StainlessTemporaryRootSafeStorageKeyBrowserTest,
+                       ManagedIncognitoRecordsNoKey) {
+  EXPECT_FALSE(RecordedKeyId());
+  EXPECT_FALSE(base::CommandLine::ForCurrentProcess()->HasSwitch(
+      os_crypt::switches::kStainlessSafeStorageKey));
+}
