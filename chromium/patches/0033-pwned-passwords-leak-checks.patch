@@ -0,0 +1,52 @@
+// Copyright 2026 Synctune Open
+
+#include "components/password_manager/core/browser/leak_detection/stainless_pwned_passwords.h"
+
+#include <string>
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace password_manager::stainless {
+namespace {
+
+TEST(StainlessPwnedPasswordsTest, SplitsUppercaseSha1Digest) {
+  const PwnedPasswordsQuery query = MakePwnedPasswordsQuery(u"password");
+  EXPECT_EQ("5BAA6", query.prefix);
+  EXPECT_EQ("1E4C9B93F3F0682250B6CF8331B7EE68FD8", query.suffix);
+
+  // Passwords are hashed as UTF-8, matching the published hash sets.
+  const PwnedPasswordsQuery unicode =
+      MakePwnedPasswordsQuery(u"p\u00e4ssw\u00f6rd");
+  EXPECT_EQ("F517D", unicode.prefix);
+  EXPECT_EQ("DF1D32A112FF1AD55C66D1B12CB38E7E8F7", unicode.suffix);
+}
+
+TEST(StainlessPwnedPasswordsTest, FindsCountsAndIgnoresPadding) {
+  const std::string suffix = "1E4C9B93F3F0682250B6CF8331B7EE68FD8";
+  const std::string response =
+      "0018A45C4D1DEF81644B54AB7F969B88D65:10\r\n" + suffix +
+      ":52256179\r\n00D4F6E8FA6EECAD2A3AA415EEC418D38EC:0\r\n";
+  EXPECT_EQ(52256179u, FindPwnedPasswordCount(response, suffix));
+  EXPECT_EQ(0u, FindPwnedPasswordCount(response,
+                                       "00D4F6E8FA6EECAD2A3AA415EEC418D38EC"));
+  EXPECT_EQ(0u, FindPwnedPasswordCount(response,
+                                       "FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF"));
+}
+
+TEST(StainlessPwnedPasswordsTest, RejectsMalformedResponses) {
+  const std::string suffix = "1E4C9B93F3F0682250B6CF8331B7EE68FD8";
+  for (const char* response :
+       {"", "\r\n", "<html>error</html>",
+        "1e4c9b93f3f0682250b6cf8331b7ee68fd8:3",
+        "1E4C9B93F3F0682250B6CF8331B7EE68FD8:", "1E4C9B93:3",
+        "1E4C9B93F3F0682250B6CF8331B7EE68FD8:-1",
+        "1E4C9B93F3F0682250B6CF8331B7EE68FD8:3x"}) {
+    EXPECT_FALSE(FindPwnedPasswordCount(response, suffix)) << response;
+  }
+  EXPECT_FALSE(FindPwnedPasswordCount(suffix + ":1", "SHORT"));
+  EXPECT_FALSE(FindPwnedPasswordCount(
+      std::string(kMaxPwnedPasswordsResponseBytes + 1, 'A'), suffix));
+}
