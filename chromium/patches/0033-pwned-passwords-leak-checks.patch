@@ -0,0 +1,79 @@
+// Copyright 2026 Synctune Open
+
+#include "components/password_manager/core/browser/leak_detection/stainless_pwned_passwords.h"
+
+#include "base/containers/span.h"
+#include "base/hash/sha1.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+
+namespace password_manager::stainless {
+
+namespace {
+
+constexpr size_t kSuffixLength = 40 - kPwnedPasswordsPrefixLength;
+
+bool IsUpperHex(std::string_view value) {
+  for (char c : value) {
+    if (!base::IsAsciiDigit(c) && !(c >= 'A' && c <= 'F')) {
+      return false;
+    }
+  }
+  return true;
+}
+
+}  // namespace
+
+PwnedPasswordsQuery MakePwnedPasswordsQuery(std::u16string_view password) {
+  std::string utf8 = base::UTF16ToUTF8(password);
+  const std::string digest =
+      base::HexEncode(base::SHA1Hash(base::as_byte_span(utf8)));
+  utf8.assign(utf8.size(), '\0');
+  return {digest.substr(0, kPwnedPasswordsPrefixLength),
+          digest.substr(kPwnedPasswordsPrefixLength)};
+}
+
+std::optional<uint64_t> FindPwnedPasswordCount(std::string_view response,
+                                               std::string_view suffix) {
+  if (response.size() > kMaxPwnedPasswordsResponseBytes ||
+      suffix.size() != kSuffixLength) {
+    return std::nullopt;
+  }
+  uint64_t found = 0;
+  size_t lines = 0;
+  size_t start = 0;
+  while (start < response.size()) {
+    size_t end = response.find('\n', start);
+    if (end == std::string_view::npos) {
+      end = response.size();
+    }
+    std::string_view line = base::TrimWhitespaceASCII(
+        response.substr(start, end - start), base::TRIM_ALL);
+    start = end + 1;
+    if (line.empty()) {
+      continue;
+    }
+    const size_t colon = line.find(':');
+    if (colon != kSuffixLength) {
+      return std::nullopt;
+    }
+    const std::string_view line_suffix = line.substr(0, colon);
+    uint64_t count = 0;
+    if (!IsUpperHex(line_suffix) ||
+        !base::StringToUint64(line.substr(colon + 1), &count)) {
+      return std::nullopt;
+    }
+    ++lines;
+    if (line_suffix == suffix) {
+      found = count;
+    }
+  }
+  // Every one of the 2^20 ranges is non-empty; an empty body is an error page.
+  if (lines == 0) {
+    return std::nullopt;
+  }
+  return found;
+}
+
+}  // namespace password_manager::stainless
