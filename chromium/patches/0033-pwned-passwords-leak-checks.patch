@@ -0,0 +1,38 @@
+// Copyright 2026 Synctune Open
+
+#ifndef COMPONENTS_PASSWORD_MANAGER_CORE_BROWSER_LEAK_DETECTION_STAINLESS_PWNED_PASSWORDS_H_
+#define COMPONENTS_PASSWORD_MANAGER_CORE_BROWSER_LEAK_DETECTION_STAINLESS_PWNED_PASSWORDS_H_
+
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+
+namespace password_manager::stainless {
+
+// Have I Been Pwned "Pwned Passwords" k-anonymity range endpoint. Only the
+// first five hexadecimal characters of a password's SHA-1 digest are sent.
+inline constexpr char kPwnedPasswordsRangeUrl[] =
+    "https://api.pwnedpasswords.com/range/";
+inline constexpr size_t kPwnedPasswordsPrefixLength = 5;
+// Real and padded range responses are well below this bound.
+inline constexpr size_t kMaxPwnedPasswordsResponseBytes = 512 * 1024;
+
+struct PwnedPasswordsQuery {
+  // Uppercase hexadecimal SHA-1 digest split into the 5-character prefix that
+  // is sent and the 35-character suffix that never leaves this device.
+  std::string prefix;
+  std::string suffix;
+};
+
+PwnedPasswordsQuery MakePwnedPasswordsQuery(std::u16string_view password);
+
+// Looks up `suffix` in a range response ("SUFFIX:COUNT" lines). Returns the
+// breach count, 0 when absent or present only as zero-count padding, and
+// nullopt when the response is malformed.
+std::optional<uint64_t> FindPwnedPasswordCount(std::string_view response,
+                                               std::string_view suffix);
+
+}  // namespace password_manager::stainless
+
+#endif  // COMPONENTS_PASSWORD_MANAGER_CORE_BROWSER_LEAK_DETECTION_STAINLESS_PWNED_PASSWORDS_H_
diff --git a/components/password_manager/core/browser/leak_detection/stainless_pwned_passwords_check.cc b/components/password_manager/core/browser/leak_detection/stainless_pwned_passwords_check.cc
new file mode 100644
index 0000000000000000000000000000000000000000..290bd68aee1f2627179bf7d80dfbe14d2ae9e492
--- /dev/null
+++ b/components/password_manager/core/browser/leak_detection/stainless_pwned_passwords_check.cc
@@ -0,0 +1,190 @@
+// Copyright 2026 Synctune Open
+
+#include "components/password_manager/core/browser/leak_detection/stainless_pwned_passwords_check.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "components/password_manager/core/browser/leak_detection/bulk_leak_check_delegate_interface.h"
+#include "components/password_manager/core/browser/leak_detection/leak_detection_types.h"
+#include "components/password_manager/core/browser/password_form.h"
+#include "net/base/load_flags.h"
+#include "net/base/net_errors.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "url/gurl.h"
+
+namespace password_manager::stainless {
+
+namespace {
+
+// Each saved password costs one request; keep the bulk check polite.
+constexpr size_t kMaxConcurrentRequests = 4;
+
+constexpr net::NetworkTrafficAnnotationTag kTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("stainless_pwned_passwords", R"(
+        semantics {
+          sender: "Stainless password breach check"
+          description:
+            "Checks whether a password appears in Have I Been Pwned's "
+            "Pwned Passwords collection using its k-anonymity range API."
+          trigger:
+            "Only when the user turned on password breach checks: after a "
+            "successful sign-in with a password, when the user edits a saved "
+            "password, or when the user runs Checkup in Password Manager."
+          data:
+            "The first five hexadecimal characters of the SHA-1 digest of "
+            "the password. No username, website or full hash is sent. The "
+            "response is padded so its size does not reveal the prefix."
+          destination: OTHER
+          destination_other: "api.pwnedpasswords.com"
+        }
+        policy {
+          cookies_allowed: NO
+          setting:
+            "Password Manager > Settings > Check passwords against known "
+            "data breaches. Off by default."
+          policy_exception_justification: "Stainless-specific feature."
+        })");
+
+}  // namespace
+
+PwnedPasswordsRangeRequest::PwnedPasswordsRangeRequest() = default;
+PwnedPasswordsRangeRequest::~PwnedPasswordsRangeRequest() = default;
+
+void PwnedPasswordsRangeRequest::Start(network::SharedURLLoaderFactory* factory,
+                                       const std::string& prefix,
+                                       std::string suffix,
+                                       Callback callback) {
+  suffix_ = std::move(suffix);
+  callback_ = std::move(callback);
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = GURL(std::string(kPwnedPasswordsRangeUrl) + prefix);
+  request->method = "GET";
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->load_flags = net::LOAD_DISABLE_CACHE;
+  request->headers.SetHeader("Add-Padding", "true");
+  loader_ =
+      network::SimpleURLLoader::Create(std::move(request), kTrafficAnnotation);
+  loader_->SetTimeoutDuration(base::Seconds(30));
+  loader_->SetRetryOptions(1,
+                           network::SimpleURLLoader::RETRY_ON_NETWORK_CHANGE |
+                               network::SimpleURLLoader::RETRY_ON_5XX);
+  loader_->DownloadToString(
+      factory,
+      base::BindOnce(&PwnedPasswordsRangeRequest::OnComplete,
+                     base::Unretained(this)),
+      kMaxPwnedPasswordsResponseBytes);
+}
+
+void PwnedPasswordsRangeRequest::OnComplete(std::optional<std::string> body) {
+  const int net_error = loader_->NetError();
+  loader_.reset();
+  std::optional<uint64_t> count;
+  if (body) {
+    count = FindPwnedPasswordCount(*body, suffix_);
+  }
+  if (!count) {
+    LOG(WARNING) << "Stainless password breach check failed: "
+                 << (body ? "unexpected response"
+                          : net::ErrorToShortString(net_error));
+  }
+  std::move(callback_).Run(count);
+}
+
+PwnedPasswordsLeakCheck::PwnedPasswordsLeakCheck(
+    scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory)
+    : url_loader_factory_(std::move(url_loader_factory)) {}
+
+PwnedPasswordsLeakCheck::~PwnedPasswordsLeakCheck() = default;
+
+void PwnedPasswordsLeakCheck::Start(LeakDetectionInitiator,
+                                    const PasswordForm& credentials,
+                                    LeakDetectionCallback callback) {
+  PwnedPasswordsQuery query =
+      MakePwnedPasswordsQuery(credentials.password_value.value());
+  request_.Start(
+      url_loader_factory_.get(), query.prefix, std::move(query.suffix),
+      base::BindOnce(&PwnedPasswordsLeakCheck::OnComplete,
+                     weak_factory_.GetWeakPtr(), std::move(callback)));
+}
+
+void PwnedPasswordsLeakCheck::OnComplete(LeakDetectionCallback callback,
+                                         std::optional<uint64_t> count) {
+  if (!count) {
+    std::move(callback).Run(
+        base::unexpected(LeakDetectionError::kNetworkError));
+    return;
+  }
+  std::move(callback).Run(IsLeaked(*count > 0));
+}
+
+PwnedPasswordsBulkLeakCheck::Pending::Pending(LeakCheckCredential credential,
+                                              PwnedPasswordsQuery query)
+    : credential(std::move(credential)), query(std::move(query)) {}
+PwnedPasswordsBulkLeakCheck::Pending::Pending(Pending&&) = default;
+PwnedPasswordsBulkLeakCheck::Pending&
+PwnedPasswordsBulkLeakCheck::Pending::operator=(Pending&&) = default;
+PwnedPasswordsBulkLeakCheck::Pending::~Pending() = default;
+
+PwnedPasswordsBulkLeakCheck::PwnedPasswordsBulkLeakCheck(
+    BulkLeakCheckDelegateInterface* delegate,
+    scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory)
+    : delegate_(delegate), url_loader_factory_(std::move(url_loader_factory)) {}
+
+PwnedPasswordsBulkLeakCheck::~PwnedPasswordsBulkLeakCheck() = default;
+
+void PwnedPasswordsBulkLeakCheck::CheckCredentials(
+    LeakDetectionInitiator,
+    std::vector<LeakCheckCredential> credentials) {
+  for (LeakCheckCredential& credential : credentials) {
+    PwnedPasswordsQuery query =
+        MakePwnedPasswordsQuery(credential.password().value());
+    queue_.emplace_back(std::move(credential), std::move(query));
+  }
+  StartRequests();
+}
+
+size_t PwnedPasswordsBulkLeakCheck::GetPendingChecksCount() const {
+  return queue_.size() + running_.size();
+}
+
+void PwnedPasswordsBulkLeakCheck::StartRequests() {
+  while (!queue_.empty() && running_.size() < kMaxConcurrentRequests) {
+    Pending pending = std::move(queue_.front());
+    queue_.pop_front();
+    running_.emplace_back();
+    auto request = std::prev(running_.end());
+    const std::string prefix = pending.query.prefix;
+    std::string suffix = pending.query.suffix;
+    request->Start(url_loader_factory_.get(), prefix, std::move(suffix),
+                   base::BindOnce(&PwnedPasswordsBulkLeakCheck::OnComplete,
+                                  weak_factory_.GetWeakPtr(), request,
+                                  std::move(pending)));
+  }
+}
+
+void PwnedPasswordsBulkLeakCheck::OnComplete(
+    std::list<PwnedPasswordsRangeRequest>::iterator request,
+    Pending pending,
+    std::optional<uint64_t> count) {
+  running_.erase(request);
+  if (!count) {
+    // Stop the remaining lookups. The delegate may delete this object, so
+    // nothing may run after notifying it.
+    queue_.clear();
+    running_.clear();
+    delegate_->OnError(LeakDetectionError::kNetworkError);
+    return;
+  }
+  // Queue the next lookups first so the pending count stays accurate; the
+  // delegate deletes this object after the last credential.
+  StartRequests();
+  delegate_->OnFinishedCredential(std::move(pending.credential),
+                                  IsLeaked(*count > 0));
+}
+
+}  // namespace password_manager::stainless
