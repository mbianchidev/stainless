+// Copyright 2026 Synctune Open
+
+#ifndef COMPONENTS_PASSWORD_MANAGER_CORE_BROWSER_LEAK_DETECTION_STAINLESS_PWNED_PASSWORDS_CHECK_H_
+#define COMPONENTS_PASSWORD_MANAGER_CORE_BROWSER_LEAK_DETECTION_STAINLESS_PWNED_PASSWORDS_CHECK_H_
+
+#include <deque>
+#include <list>
+#include <map>
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "components/password_manager/core/browser/leak_detection/bulk_leak_check.h"
+#include "components/password_manager/core/browser/leak_detection/leak_detection_check.h"
+#include "components/password_manager/core/browser/leak_detection/stainless_pwned_passwords.h"
+
+namespace network {
+class SharedURLLoaderFactory;
+class SimpleURLLoader;
+}  // namespace network
+
+namespace password_manager {
+
+class BulkLeakCheckDelegateInterface;
+
+namespace stainless {
+
+// Fetches one Pwned Passwords range. Reports nullopt for network, HTTP or
+// format errors, otherwise the breach count for `suffix`.
+class PwnedPasswordsRangeRequest {
+ public:
+  using Callback = base::OnceCallback<void(std::optional<uint64_t> count)>;
+
+  PwnedPasswordsRangeRequest();
+  PwnedPasswordsRangeRequest(const PwnedPasswordsRangeRequest&) = delete;
+  PwnedPasswordsRangeRequest& operator=(const PwnedPasswordsRangeRequest&) =
+      delete;
+  ~PwnedPasswordsRangeRequest();
+
+  void Start(network::SharedURLLoaderFactory* factory,
+             const std::string& prefix,
+             std::string suffix,
+             Callback callback);
+
+ private:
+  void OnComplete(std::optional<std::string> body);
+
+  std::unique_ptr<network::SimpleURLLoader> loader_;
+  std::string suffix_;
+  Callback callback_;
+};
+
+// Single credential check used after a successful sign-in.
+class PwnedPasswordsLeakCheck : public LeakDetectionCheck {
+ public:
+  explicit PwnedPasswordsLeakCheck(
+      scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory);
+  ~PwnedPasswordsLeakCheck() override;
+
+  // LeakDetectionCheck:
+  void Start(LeakDetectionInitiator initiator,
+             const PasswordForm& credentials,
+             LeakDetectionCallback callback) override;
+
+ private:
+  void OnComplete(LeakDetectionCallback callback,
+                  std::optional<uint64_t> count);
+
+  scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory_;
+  PwnedPasswordsRangeRequest request_;
+  base::WeakPtrFactory<PwnedPasswordsLeakCheck> weak_factory_{this};
+};
+
+// Saved-password check started from Password Manager's Checkup page.
+class PwnedPasswordsBulkLeakCheck : public BulkLeakCheck {
+ public:
+  PwnedPasswordsBulkLeakCheck(
+      BulkLeakCheckDelegateInterface* delegate,
+      scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory);
+  ~PwnedPasswordsBulkLeakCheck() override;
+
+  // BulkLeakCheck:
+  void CheckCredentials(LeakDetectionInitiator initiator,
+                        std::vector<LeakCheckCredential> credentials) override;
+  size_t GetPendingChecksCount() const override;
+
+ private:
+  struct Pending {
+    Pending(LeakCheckCredential credential, PwnedPasswordsQuery query);
+    Pending(Pending&&);
+    Pending& operator=(Pending&&);
+    ~Pending();
+
+    LeakCheckCredential credential;
+    PwnedPasswordsQuery query;
+  };
+
+  void StartRequests();
+  void OnComplete(std::list<PwnedPasswordsRangeRequest>::iterator request,
+                  Pending pending,
+                  std::optional<uint64_t> count);
+
+  raw_ptr<BulkLeakCheckDelegateInterface> delegate_;
+  scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory_;
+  std::deque<Pending> queue_;
+  std::list<PwnedPasswordsRangeRequest> running_;
+  base::WeakPtrFactory<PwnedPasswordsBulkLeakCheck> weak_factory_{this};
+};
+
+}  // namespace stainless
+}  // namespace password_manager
+
+#endif  // COMPONENTS_PASSWORD_MANAGER_CORE_BROWSER_LEAK_DETECTION_STAINLESS_PWNED_PASSWORDS_CHECK_H_
