+  // Occupies the global broker with another document's admitted OCR job, so
+  // PDF work submitted afterwards stays queued until ReleaseBroker().
+  void HoldBroker() {
+    blocker_ = content::WebContents::Create(
+        content::WebContents::CreateParams(browser()->GetProfile()));
+    ASSERT_TRUE(content::NavigateToURL(
+        blocker_.get(),
+        embedded_test_server()->GetURL("one.test", "/blocker")));
+    held_ = stainless_local::LocalBroker::Get().Submit(
+        blocker_->GetPrimaryMainFrame(), stainless_local::Feature::kOcr,
+        held_admission_.GetCallback(), held_reply_.GetCallback());
+    ASSERT_TRUE(held_admission_.Wait());
+  }
+
+  void ReleaseBroker() {
+    stainless_local::LocalBroker::Get().Cancel(held_);
+    held_ = {};
+    ASSERT_TRUE(held_reply_.Wait());
+  }
+
+  void WaitUntilQueued() {
+    ASSERT_TRUE(base::test::RunUntil([&] {
+      return RuntimeStatus() == "Waiting for bounded local PDF OCR admission";
+    })) << RuntimeStatus();
+  }
