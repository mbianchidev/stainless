+IN_PROC_BROWSER_TEST_F(StainlessOcrBrowserTest,
+                       MANUAL_PdfOcrRunsOfflineWithoutNetworkRequests) {
+  EnableAndSeed("ocr-eng");
+  content::ScopedAccessibilityModeOverride ax_mode(contents(),
+                                                   ui::kAXModeComplete);
+  ASSERT_TRUE(Navigate("case-0.pdf"));
+  base::Lock lock;
+  std::vector<GURL> requests;
+  content::URLLoaderInterceptor offline(base::BindLambdaForTesting(
+      [&](content::URLLoaderInterceptor::RequestParams* params) {
+        const auto& url = params->url_request.url;
+        if (!url.SchemeIsHTTPOrHTTPS() && !url.SchemeIsWSOrWSS()) {
+          return false;
+        }
+        {
+          base::AutoLock locked(lock);
+          requests.push_back(url);
+        }
+        params->client->OnComplete(
+            network::URLLoaderCompletionStatus(net::ERR_INTERNET_DISCONNECTED));
+        return true;
+      }));
+  content::NetworkConnectionChangeSimulator().SetConnectionType(
+      net::NetworkChangeNotifier::CONNECTION_NONE);
+  Choose("eng");
+  const std::u16string expected = u"The red robot holds three blue boxes.";
+  ASSERT_TRUE(WaitForText(expected));
+  CheckPdfAx(expected);
+  EXPECT_EQ("Local PDF OCR completed", RuntimeStatus());
+  base::AutoLock locked(lock);
+  EXPECT_TRUE(requests.empty()) << requests.front();
+}
+
+IN_PROC_BROWSER_TEST_F(StainlessOcrBrowserTest,
+                       MANUAL_NavigationCancelsQueuedPdfOcrWithoutLateText) {
+  EnableAndSeed("ocr-eng");
+  ASSERT_NO_FATAL_FAILURE(HoldBroker());
+  content::ScopedAccessibilityModeOverride ax_mode(contents(),
+                                                   ui::kAXModeComplete);
+  ASSERT_TRUE(Navigate("case-0.pdf"));
+  Choose("eng");
+  ASSERT_NO_FATAL_FAILURE(WaitUntilQueued());
+  ASSERT_TRUE(Navigate("existing-text.pdf"));
+  ASSERT_NO_FATAL_FAILURE(ReleaseBroker());
+  base::RunLoop().RunUntilIdle();
+  const std::u16string author = u"Existing author text stays intact.";
+  EXPECT_EQ(Words(author), Words(PageText()));
+  EXPECT_FALSE(Pdf()->SearchifyStarted());
+  EXPECT_FALSE(View());
+  // A stale queued job would hold the broker until its deadline, so a fresh
+  // document only reads its text promptly if navigation released it.
+  ASSERT_TRUE(Navigate("case-0.pdf"));
+  Choose("eng");
+  const std::u16string expected = u"The red robot holds three blue boxes.";
+  ASSERT_TRUE(WaitForText(expected));
+  CheckPdfAx(expected);
+}
+
