+    EXPECT_NE(private_service, service_.get());
+    EXPECT_EQ(false, private_service->GetStatus().FindBool("available"));
+    EXPECT_EQ(false, private_service->GetStatus().FindBool("connected"));
+  }
+  EXPECT_EQ(previous_connections, connections_);
+  EXPECT_EQ(0u, SentFrames("register"));
+  EXPECT_EQ(0, Subscriptions());
