+  EXPECT_EQ("", SubscriptionJson());
+  ASSERT_NO_FATAL_FAILURE(NotifyChannel(lost_channel, "owned-stale-identity"));
+  ASSERT_TRUE(base::test::RunUntil([&] { return Acks(102) == 1; }));
+  EXPECT_EQ(0, ReceivedPushes());
+
+  ASSERT_NO_FATAL_FAILURE(SubscribeWithGrantedPermission(vapid_));
+  EXPECT_NE(lost_endpoint, endpoint_);
+  ASSERT_NO_FATAL_FAILURE(Notify("owned-new-identity"));
+  ASSERT_TRUE(base::test::RunUntil([&] { return Acks(100) == 1; }));
+  ASSERT_TRUE(base::test::RunUntil([&] { return ReceivedPushes() == 1; }));
