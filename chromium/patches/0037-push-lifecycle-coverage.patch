+  EXPECT_EQ(false, service_->GetStatus().FindBool("connected"));
+  ASSERT_NO_FATAL_FAILURE(GrantNotificationPermission());
+  const auto error = SubscribeError();
+  EXPECT_NE("unexpected-success", error);
+  EXPECT_FALSE(error.empty());
+  EXPECT_EQ("", SubscriptionJson());
+  EXPECT_EQ(0, Subscriptions());
+  EXPECT_EQ(0, connections_);
+  EXPECT_EQ(0u, SentFrames("register"));
+}
