+  ASSERT_NO_FATAL_FAILURE(GrantNotificationPermission());
+  EXPECT_EQ(false, service_->GetStatus().FindBool("enabled"));
+  EXPECT_NE("unexpected-success", SubscribeError());
+  ASSERT_EQ(true, content::EvalJs(contents(), R"JS(
+    (async () => {
+      await window.registration.showNotification('Fictional local reminder', {
+        body: 'Owned local notification', tag: 'owned-local'
+      });
+      new Notification('Fictional page notice');
+      return true;
+    })()
+  )JS"));
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return notifications_
+                   ->GetDisplayedNotificationsForType(
+                       NotificationHandler::Type::WEB_PERSISTENT)
+                   .size() == 1 &&
+           notifications_
+                   ->GetDisplayedNotificationsForType(
+                       NotificationHandler::Type::WEB_NON_PERSISTENT)
+                   .size() == 1;
+  }));
+  EXPECT_EQ(0, connections_);
+  EXPECT_TRUE(frames_.empty());
+}
