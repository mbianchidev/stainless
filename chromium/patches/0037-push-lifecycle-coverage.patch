+class StainlessPushPersistenceBrowserTest
+    : public StainlessPushMessagingBrowserTest {
+ protected:
+  static base::FilePath FixtureFile(std::string_view name) {
+    base::FilePath directory;
+    CHECK(base::PathService::Get(chrome::DIR_USER_DATA, &directory));
+    return directory.AppendASCII(name);
+  }
+
+  // The restarted browser must reach the same origins and provider address.
+  uint16_t ServerPort() override {
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    std::string text;
+    unsigned port = 0;
+    if (base::ReadFileToString(FixtureFile("owned-push-port"), &text) &&
+        base::StringToUint(text, &port) && port <= 65535) {
+      return static_cast<uint16_t>(port);
+    }
+    return 0;
+  }
+
+  void ServerStarted() override {
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    ASSERT_TRUE(base::WriteFile(FixtureFile("owned-push-port"),
+                                base::NumberToString(server_.port())));
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(StainlessPushPersistenceBrowserTest,
+                       PRE_EncryptedSubscriptionSurvivesRestart) {
+  ASSERT_NO_FATAL_FAILURE(Enable());
+  ASSERT_NO_FATAL_FAILURE(SubscribeWithGrantedPermission());
+  ASSERT_NO_FATAL_FAILURE(Notify("owned-before-restart"));
+  ASSERT_TRUE(base::test::RunUntil([&] { return Acks(100) == 1; }));
+  base::ScopedAllowBlockingForTesting allow_blocking;
+  std::string state;
+  ASSERT_TRUE(base::ReadFileToString(
+      browser()->GetProfile()->GetPath().AppendASCII("StainlessPushState"),
+      &state));
+  for (const auto& secret : {endpoint_, channel_, std::string(kFixtureUaid)}) {
+    EXPECT_EQ(std::string::npos, state.find(secret)) << secret;
+  }
+  ASSERT_TRUE(base::WriteFile(FixtureFile("owned-push-subscription"),
+                              SubscriptionJson()));
+  // Quit with Push still enabled, as a user restarting the browser would.
+  disable_on_teardown_ = false;
+}
+
+IN_PROC_BROWSER_TEST_F(StainlessPushPersistenceBrowserTest,
+                       EncryptedSubscriptionSurvivesRestart) {
+  std::string saved;
+  {
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    ASSERT_TRUE(
+        base::ReadFileToString(FixtureFile("owned-push-subscription"), &saved));
+  }
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return service_->GetStatus().FindBool("connected") == true &&
+           Subscriptions() == 1;
+  }));
+  auto parsed = base::JSONReader::Read(saved, base::JSON_PARSE_RFC);
+  ASSERT_TRUE(parsed && parsed->is_dict());
+  const auto* endpoint = parsed->GetDict().FindString("endpoint");
+  ASSERT_TRUE(endpoint);
+  endpoint_ = *endpoint;
+  channel_ = GURL(endpoint_).ExtractFileName();
+  EXPECT_TRUE(std::ranges::any_of(frames_, [](const auto& frame) {
+    const auto* type = frame.FindString("messageType");
+    const auto* uaid = frame.FindString("uaid");
+    return type && *type == "hello" && uaid && *uaid == kFixtureUaid;
+  }));
+  EXPECT_TRUE(SentControl("register", channel_));
+  EXPECT_EQ(saved, SubscriptionJson());
+  ASSERT_NO_FATAL_FAILURE(Notify("owned-after-restart"));
+  ASSERT_TRUE(base::test::RunUntil([&] { return Acks(100) == 1; }));
+  ASSERT_TRUE(base::test::RunUntil([&] { return ReceivedPushes() == 1; }));
+  EXPECT_EQ("payload-less",
+            content::EvalJs(contents(), "window.receivedPush[0]"));
+}
