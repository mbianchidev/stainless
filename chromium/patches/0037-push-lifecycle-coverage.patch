+IN_PROC_BROWSER_TEST_F(StainlessPushMessagingBrowserTest,
+                       ServerIdentityLossClearsSubscriptionsBeforeDelivery) {
+  ASSERT_NO_FATAL_FAILURE(Enable());
+  ASSERT_NO_FATAL_FAILURE(SubscribeWithGrantedPermission());
+  const auto lost_channel = channel_;
+  const auto lost_endpoint = endpoint_;
+  // The provider dropped this UAID, for example after its stored backlog limit.
+  behavior_->SetUaid("0123456789abcdef0123456789abcdef");
+  const int previous_connections = connections_;
+  disconnect_.Run();
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return connections_ > previous_connections &&
+           service_->GetStatus().FindBool("connected") == true &&
+           Subscriptions() == 0;
