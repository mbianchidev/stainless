+// Server-side choices the test changes while the peer runs on its own thread.
+class PeerBehavior : public base::RefCountedThreadSafe<PeerBehavior> {
+ public:
+  PeerBehavior() = default;
+
+  void SetUaid(std::string uaid) {
+    base::AutoLock lock(lock_);
+    uaid_ = std::move(uaid);
+  }
+  std::string Uaid() {
+    base::AutoLock lock(lock_);
+    return uaid_;
+  }
+  void SetRegisterStatus(int status) {
+    base::AutoLock lock(lock_);
+    register_status_ = status;
+  }
+  int RegisterStatus() {
+    base::AutoLock lock(lock_);
+    return register_status_;
+  }
+
+ private:
+  friend class base::RefCountedThreadSafe<PeerBehavior>;
+  ~PeerBehavior() = default;
+
+  base::Lock lock_;
+  std::string uaid_ GUARDED_BY(lock_) = kFixtureUaid;
+  int register_status_ GUARDED_BY(lock_) = 200;
+};
