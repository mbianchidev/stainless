+IN_PROC_BROWSER_TEST_F(StainlessPushMessagingBrowserTest,
+                       PermissionRevocationRemovesOnlyThatOriginsSubscription) {
+  ASSERT_NO_FATAL_FAILURE(Enable());
+  auto* first = contents();
+  ASSERT_NO_FATAL_FAILURE(SubscribeWithGrantedPermission());
+  const auto first_channel = channel_;
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), server_.GetURL("other.test", "/fixture/"),
+      WindowOpenDisposition::kNewForegroundTab,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  auto* second = contents();
+  ASSERT_NE(first, second);
+  ASSERT_NO_FATAL_FAILURE(RegisterFixtureWorker(second));
+  ASSERT_NO_FATAL_FAILURE(SubscribeWithGrantedPermission({}, second));
+  const auto second_channel = channel_;
+  ASSERT_NE(first_channel, second_channel);
+  EXPECT_EQ(2, Subscriptions());
+
+  const auto first_origin = server_.GetURL("page.test", "/");
+  HostContentSettingsMapFactory::GetForProfile(browser()->GetProfile())
+      ->SetContentSettingDefaultScope(first_origin, first_origin,
+                                      ContentSettingsType::NOTIFICATIONS,
+                                      CONTENT_SETTING_BLOCK);
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return SentControl("unregister", first_channel) && Subscriptions() == 1;
+  }));
+  EXPECT_FALSE(SentControl("unregister", second_channel));
+  EXPECT_EQ("", SubscriptionJson(first));
+  EXPECT_NE("", SubscriptionJson(second));
+
+  ASSERT_NO_FATAL_FAILURE(NotifyChannel(first_channel, "owned-revoked"));
+  ASSERT_TRUE(base::test::RunUntil([&] { return Acks(102) == 1; }));
+  ASSERT_NO_FATAL_FAILURE(NotifyChannel(second_channel, "owned-still-allowed"));
+  ASSERT_TRUE(base::test::RunUntil([&] { return Acks(100) == 1; }));
+  ASSERT_TRUE(
+      base::test::RunUntil([&] { return ReceivedPushes(second) == 1; }));
+  EXPECT_EQ(0, ReceivedPushes(first));
+}
