+IN_PROC_BROWSER_TEST_F(StainlessPushMessagingBrowserTest,
+                       WorkerAndSiteDataRemovalUnregisterTheirChannels) {
+  ASSERT_NO_FATAL_FAILURE(Enable());
+  ASSERT_NO_FATAL_FAILURE(SubscribeWithGrantedPermission());
+  const auto worker_channel = channel_;
+  ASSERT_EQ(true,
+            content::EvalJs(contents(), "window.registration.unregister()"));
+  // The controlled page keeps the registration alive until it leaves.
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), GURL("about:blank")));
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return SentControl("unregister", worker_channel) && Subscriptions() == 0;
+  }));
+
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), server_.GetURL("page.test", "/fixture/")));
+  ASSERT_NO_FATAL_FAILURE(RegisterFixtureWorker(contents()));
+  ASSERT_NO_FATAL_FAILURE(SubscribeWithGrantedPermission());
+  const auto site_channel = channel_;
+  ASSERT_NE(worker_channel, site_channel);
+  auto* remover = browser()->GetProfile()->GetBrowsingDataRemover();
+  content::BrowsingDataRemoverCompletionObserver removed(remover);
+  remover->RemoveAndReply(base::Time(), base::Time::Max(),
+                          chrome_browsing_data_remover::DATA_TYPE_SITE_DATA,
+                          chrome_browsing_data_remover::ALL_ORIGIN_TYPES,
+                          &removed);
+  removed.BlockUntilCompletion();
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return SentControl("unregister", site_channel) && Subscriptions() == 0;
+  }));
+  ASSERT_NO_FATAL_FAILURE(NotifyChannel(site_channel, "owned-after-removal"));
+  ASSERT_TRUE(base::test::RunUntil([&] { return Acks(102) == 1; }));
+}
