+  ASSERT_TRUE(offline.ShutdownAndWaitUntilComplete());
+  ASSERT_TRUE(
+      service_->Configure(unreachable, server_.GetURL("push.test", "/"), true)
+          .has_value());
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    const auto status = service_->GetStatus();
+    const auto* error = status.FindString("error");
+    return error && !error->empty();
