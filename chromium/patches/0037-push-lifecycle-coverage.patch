+IN_PROC_BROWSER_TEST_F(StainlessPushMessagingBrowserTest,
+                       CopiedProfileNeverReusesThePushIdentity) {
+  ASSERT_NO_FATAL_FAILURE(Enable());
+  ASSERT_NO_FATAL_FAILURE(SubscribeWithGrantedPermission());
+  base::test::TestFuture<void> committed;
+  browser()->GetProfile()->GetPrefs()->CommitPendingWrite(
+      committed.GetCallback());
+  ASSERT_TRUE(committed.Wait());
+  const auto source = browser()->GetProfile()->GetPath();
+  const auto copied = source.DirName().AppendASCII("OwnedCopiedPushProfile");
+  {
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    ASSERT_TRUE(base::CreateDirectory(copied));
+    for (const char* name : {"Preferences", "StainlessPushState"}) {
+      ASSERT_TRUE(
+          base::CopyFile(source.AppendASCII(name), copied.AppendASCII(name)))
+          << name;
+    }
+  }
+  const int previous_connections = connections_;
+  const size_t previous_hellos = SentFrames("hello");
+  auto& copy = profiles::testing::CreateProfileSync(
+      g_browser_process->profile_manager(), copied);
+  auto* copied_service = stainless::GetPushMessagingService(&copy);
+  ASSERT_TRUE(copied_service);
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    const auto status = copied_service->GetStatus();
+    const auto* error = status.FindString("error");
+    return error && error->find("Copied profile") != std::string::npos;
+  }));
+  EXPECT_EQ(false, copied_service->GetStatus().FindBool("enabled"));
+  EXPECT_EQ(false, copied_service->GetStatus().FindBool("connected"));
+  EXPECT_EQ(0, Subscriptions(copied_service));
+  EXPECT_EQ(previous_connections, connections_);
+  EXPECT_EQ(previous_hellos, SentFrames("hello"));
+  EXPECT_EQ(true, service_->GetStatus().FindBool("connected"));
+  EXPECT_EQ(1, Subscriptions());
+  EXPECT_NE("", SubscriptionJson());
+}
