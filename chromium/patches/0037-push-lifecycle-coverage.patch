+IN_PROC_BROWSER_TEST_F(StainlessPushMessagingBrowserTest,
+                       DeletedProfileUnregistersAndRemovesItsPushState) {
+  ASSERT_NO_FATAL_FAILURE(Enable());
+  ASSERT_NO_FATAL_FAILURE(SubscribeWithGrantedPermission());
+  const auto kept_channel = channel_;
+  auto* manager = g_browser_process->profile_manager();
+  const auto path = manager->user_data_dir().AppendASCII("OwnedDeletedPush");
+  auto& doomed = profiles::testing::CreateProfileSync(manager, path);
+  auto* doomed_browser = CreateBrowser(&doomed);
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      doomed_browser, server_.GetURL("page.test", "/fixture/")));
+  auto* tab = doomed_browser->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_NO_FATAL_FAILURE(RegisterFixtureWorker(tab));
+  ASSERT_NO_FATAL_FAILURE(Enable(stainless::GetPushMessagingService(&doomed)));
+  ASSERT_NO_FATAL_FAILURE(SubscribeWithGrantedPermission({}, tab));
+  const auto doomed_channel = channel_;
+  const auto state = path.AppendASCII("StainlessPushState");
+  {
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    ASSERT_TRUE(base::PathExists(state));
+  }
+  manager->GetDeleteProfileHelper().MaybeScheduleProfileForDeletion(
+      path, base::DoNothing(), ProfileMetrics::DELETE_PROFILE_SETTINGS);
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return SentControl("unregister", doomed_channel); }));
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    return !base::PathExists(state);
+  }));
+  EXPECT_FALSE(SentControl("unregister", kept_channel));
+  EXPECT_EQ(true, service_->GetStatus().FindBool("connected"));
+  EXPECT_EQ(1, Subscriptions());
+}
