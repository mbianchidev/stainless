+
+namespace {
+
+std::u16string Text(int message_id) {
+  return l10n_util::GetStringUTF16(message_id);
+}
+
+bool CanOwn(BrowserWindowInterface* browser) {
+  if (!browser || browser->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+      !browser->GetProfile() || browser->GetProfile()->IsOffTheRecord() ||
+      !browser->GetTabStripModel() ||
+      !browser->GetTabStripModel()->GetActiveWebContents()) {
+    return false;
+  }
+  auto* owner = BrowserView::GetBrowserViewForBrowser(browser);
+  return owner && owner->GetWidget() && !owner->GetWidget()->IsClosed();
+}
+
+views::Label* AddLabel(views::View* parent,
+                       const std::u16string& text,
+                       bool heading = false) {
+  auto* label = parent->AddChildView(std::make_unique<views::Label>(
+      text,
+      heading ? views::style::CONTEXT_DIALOG_BODY_TEXT
+              : views::style::CONTEXT_LABEL,
+      heading ? views::style::STYLE_EMPHASIZED : views::style::STYLE_PRIMARY));
+  label->SetMultiLine(true);
+  label->SetHorizontalAlignment(gfx::HorizontalAlignment::ALIGN_LEFT);
+  return label;
+}
+
+}  // namespace
+
+// static
+StainlessSiteCompatibilityView* StainlessSiteCompatibilityView::Show(
+    BrowserWindowInterface* browser) {
+  if (!CanOwn(browser)) {
+    LOG(WARNING) << "Site Compatibility needs a live normal window of a "
+                    "regular profile with an open tab";
+    return nullptr;
+  }
+  auto contents = std::make_unique<StainlessSiteCompatibilityView>(browser);
+  StainlessSiteCompatibilityView* view = contents.get();
+  auto dialog = std::make_unique<views::DialogDelegate>();
+  dialog->SetTitle(Text(IDS_STAINLESS_SITE_COMPATIBILITY_TITLE));
+  dialog->SetModalType(ui::mojom::ModalType::kWindow);
+  dialog->SetButtons(static_cast<int>(ui::mojom::DialogButton::kCancel));
+  dialog->SetButtonLabel(ui::mojom::DialogButton::kCancel,
+                         Text(IDS_STAINLESS_COMMAND_PALETTE_CLOSE));
+  dialog->SetDefaultButton(static_cast<int>(ui::mojom::DialogButton::kNone));
+  dialog->set_fixed_width(ChromeLayoutProvider::Get()->GetDistanceMetric(
+      views::DISTANCE_MODAL_DIALOG_PREFERRED_WIDTH));
+  dialog->set_margins(ChromeLayoutProvider::Get()->GetDialogInsetsForContentType(
+      views::DialogContentType::kText, views::DialogContentType::kControl));
+  if (view->add_->GetEnabled()) {
+    dialog->SetInitiallyFocusedView(view->add_);
+  } else {
+    dialog->SetInitiallyFocusedView(view->table_);
+  }
+  dialog->SetContentsView(std::move(contents));
+  auto* widget = views::DialogDelegate::CreateDialogWidget(
+      std::move(dialog), gfx::NativeWindow(),
+      BrowserView::GetBrowserViewForBrowser(browser)
+          ->GetWidget()
+          ->GetNativeView());
+  widget->Show();
+  return view;
+}
+
+StainlessSiteCompatibilityView::StainlessSiteCompatibilityView(
+    BrowserWindowInterface* browser)
+    : browser_(browser->GetWeakPtr()) {
+  const auto* layout = ChromeLayoutProvider::Get();
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(),
+      layout->GetDistanceMetric(views::DISTANCE_RELATED_CONTROL_VERTICAL)));
+  const std::u16string browser_name = stainless::SiteCompatibilityBrowserName();
+  AddLabel(this, l10n_util::GetStringFUTF16(
+                     IDS_STAINLESS_SITE_COMPATIBILITY_INTRO, browser_name));
+
+  site_ = AddLabel(this, std::u16string(), /*heading=*/true);
+  status_ = AddLabel(this, std::u16string());
+
+  auto* controls = AddChildView(std::make_unique<views::View>());
+  controls->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal, gfx::Insets(),
+      layout->GetDistanceMetric(views::DISTANCE_RELATED_BUTTON_HORIZONTAL)));
+  duration_model_ = std::make_unique<ui::SimpleComboboxModel>(
+      std::vector<ui::SimpleComboboxModel::Item>{
+          ui::SimpleComboboxModel::Item(
+              Text(IDS_STAINLESS_SITE_COMPATIBILITY_ONE_DAY)),
+          ui::SimpleComboboxModel::Item(
+              Text(IDS_STAINLESS_SITE_COMPATIBILITY_SEVEN_DAYS)),
+          ui::SimpleComboboxModel::Item(
+              Text(IDS_STAINLESS_SITE_COMPATIBILITY_THIRTY_DAYS)),
+      });
+  static_assert(stainless::kSiteCompatibilityDurations.size() == 3);
+  duration_ = controls->AddChildView(
+      std::make_unique<views::Combobox>(duration_model_.get()));
+  duration_->SetSelectedIndex(1);
+  duration_->GetViewAccessibility().SetName(
+      Text(IDS_STAINLESS_SITE_COMPATIBILITY_DURATION));
+  add_ = controls->AddChildView(std::make_unique<views::MdTextButton>(
+      base::BindRepeating(&StainlessSiteCompatibilityView::AddOverride,
+                          base::Unretained(this)),
+      l10n_util::GetStringFUTF16(IDS_STAINLESS_SITE_COMPATIBILITY_ADD,
+                                 browser_name)));
+  remove_active_site_ =
+      controls->AddChildView(std::make_unique<views::MdTextButton>(
+          base::BindRepeating(&StainlessSiteCompatibilityView::RemoveActiveSite,
+                              base::Unretained(this)),
+          Text(IDS_STAINLESS_SITE_COMPATIBILITY_REMOVE_CURRENT)));
+
+  AddLabel(this, Text(IDS_STAINLESS_SITE_COMPATIBILITY_ACTIVE),
+           /*heading=*/true);
+  empty_ = AddLabel(this, Text(IDS_STAINLESS_SITE_COMPATIBILITY_NONE));
+  std::vector<ui::TableColumn> columns = {
+      {IDS_STAINLESS_SITE_COMPATIBILITY_SITE_COLUMN, ui::TableColumn::LEFT, -1,
+       1},
+      {IDS_STAINLESS_SITE_COMPATIBILITY_EXPIRES_COLUMN, ui::TableColumn::LEFT,
+       140, 0},
+  };
+  auto table = std::make_unique<views::TableView>(
+      this, columns, views::TableType::kTextOnly, /*single_selection=*/true);
+  table_ = table.get();
+  table_->set_observer(this);
+  table_->GetViewAccessibility().SetName(
+      Text(IDS_STAINLESS_SITE_COMPATIBILITY_TABLE));
+  auto* scroll = AddChildView(
+      views::TableView::CreateScrollViewWithTable(std::move(table)));
+  scroll->ClipHeightTo(120, 120);
+  scroll->SetHorizontalScrollBarMode(
+      views::ScrollView::ScrollBarMode::kDisabled);
+  remove_selected_ = AddChildView(std::make_unique<views::MdTextButton>(
+      base::BindRepeating(&StainlessSiteCompatibilityView::RemoveSelected,
+                          base::Unretained(this)),
+      Text(IDS_STAINLESS_SITE_COMPATIBILITY_REMOVE_SELECTED)));
+  AddLabel(this, Text(IDS_STAINLESS_SITE_COMPATIBILITY_DELTA_COLUMN),
+           /*heading=*/true);
+  delta_ = AddLabel(this, stainless::SiteCompatibilityDelta());
+
+  stainless::PruneSiteCompatibilityOverrides(prefs(), base::Time::Now());
+  registrar_.Init(&prefs());
+  registrar_.Add(stainless::kSiteCompatibilityOverrides,
+                 base::BindRepeating(&StainlessSiteCompatibilityView::Refresh,
+                                     base::Unretained(this)));
+  Refresh();
+}
+
+StainlessSiteCompatibilityView::~StainlessSiteCompatibilityView() {
+  table_->set_observer(nullptr);
+}
+
+PrefService& StainlessSiteCompatibilityView::prefs() const {
+  return *browser_->GetProfile()->GetPrefs();
+}
+
+GURL StainlessSiteCompatibilityView::ActiveURL() const {
+  content::WebContents* contents =
+      browser_ ? browser_->GetTabStripModel()->GetActiveWebContents()
+               : nullptr;
+  return contents ? contents->GetLastCommittedURL() : GURL();
+}
+
+void StainlessSiteCompatibilityView::Refresh() {
+  if (!browser_) {
+    return;
+  }
+  const base::Time now = base::Time::Now();
+  overrides_ = stainless::GetSiteCompatibilityOverrides(prefs(), now);
+  active_site_ = stainless::SiteCompatibilitySite(ActiveURL());
+  auto active = std::ranges::find_if(overrides_, [&](const auto& entry) {
+    return active_site_ == entry.site;
+  });
+  const bool overridden = active != overrides_.end();
+  site_->SetText(
+      active_site_
+          ? l10n_util::GetStringFUTF16(
+                IDS_STAINLESS_SITE_COMPATIBILITY_CURRENT_SITE,
+                base::UTF8ToUTF16(*active_site_))
+          : Text(IDS_STAINLESS_SITE_COMPATIBILITY_UNSUPPORTED));
+  status_->SetVisible(active_site_.has_value());
+  status_->SetText(
+      overridden ? l10n_util::GetStringFUTF16(
+                       IDS_STAINLESS_SITE_COMPATIBILITY_OVERRIDE_STATUS,
+                       stainless::SiteCompatibilityBrowserName(),
+                       base::TimeFormatShortDate(active->expires))
+                 : Text(IDS_STAINLESS_SITE_COMPATIBILITY_STAINLESS_STATUS));
+  duration_->SetEnabled(active_site_.has_value());
+  add_->SetEnabled(active_site_.has_value());
+  remove_active_site_->SetEnabled(overridden);
+  empty_->SetVisible(overrides_.empty());
+  if (model_observer_) {
+    model_observer_->OnModelChanged();
+  }
+  UpdateSelection();
+}
+
+void StainlessSiteCompatibilityView::UpdateSelection() {
+  std::optional<size_t> row = table_->GetFirstSelectedRow();
+  const bool selected = row && *row < overrides_.size();
+  remove_selected_->SetEnabled(selected);
+  delta_->SetText(selected ? overrides_[*row].delta
+                           : stainless::SiteCompatibilityDelta());
+}
+
+size_t StainlessSiteCompatibilityView::RowCount() const {
+  return overrides_.size();
+}
+
+std::u16string StainlessSiteCompatibilityView::GetText(size_t row,
+                                                       int column_id) const {
+  if (row >= overrides_.size()) {
+    return std::u16string();
+  }
+  return column_id == IDS_STAINLESS_SITE_COMPATIBILITY_EXPIRES_COLUMN
+             ? base::TimeFormatShortDate(overrides_[row].expires)
+             : base::UTF8ToUTF16(overrides_[row].site);
+}
+
+std::u16string StainlessSiteCompatibilityView::GetTooltip(size_t row) const {
+  return row < overrides_.size() ? overrides_[row].delta : std::u16string();
+}
+
+void StainlessSiteCompatibilityView::SetObserver(
+    ui::TableModelObserver* observer) {
+  model_observer_ = observer;
+}
+
+void StainlessSiteCompatibilityView::OnSelectionChanged() {
+  UpdateSelection();
+}
+
+void StainlessSiteCompatibilityView::AddOverride() {
+  std::optional<size_t> index = duration_->GetSelectedIndex();
+  if (!browser_ || !active_site_ || !index ||
+      *index >= stainless::kSiteCompatibilityDurations.size()) {
+    return;
+  }
+  const std::string site = *active_site_;
+  if (stainless::AddSiteCompatibilityOverride(
+          prefs(), ActiveURL(), stainless::kSiteCompatibilityDurations[*index],
+          base::Time::Now())) {
+    ReloadIfActiveSite(site);
+  }
+}
+
+void StainlessSiteCompatibilityView::RemoveActiveSite() {
+  if (!browser_ || !active_site_) {
+    return;
+  }
+  const std::string site = *active_site_;
+  stainless::RemoveSiteCompatibilityOverride(prefs(), site);
+  ReloadIfActiveSite(site);
+}
+
+void StainlessSiteCompatibilityView::RemoveSelected() {
+  std::optional<size_t> row = table_->GetFirstSelectedRow();
+  if (!browser_ || !row || *row >= overrides_.size()) {
+    return;
+  }
+  const std::string site = overrides_[*row].site;
+  stainless::RemoveSiteCompatibilityOverride(prefs(), site);
+  ReloadIfActiveSite(site);
+}
+
+void StainlessSiteCompatibilityView::ReloadIfActiveSite(std::string_view site) {
+  if (!browser_ || active_site_ != site) {
+    return;
+  }
+  if (content::WebContents* contents =
+          browser_->GetTabStripModel()->GetActiveWebContents()) {
+    contents->GetController().Reload(content::ReloadType::NORMAL,
+                                     /*check_for_repost=*/true);
+  }
+}
+
+namespace chrome {
+
+void ShowSiteCompatibility(BrowserWindowInterface* browser) {
+  StainlessSiteCompatibilityView::Show(browser);
+}
+
+}  // namespace chrome
+
+BEGIN_METADATA(StainlessSiteCompatibilityView)
+END_METADATA
