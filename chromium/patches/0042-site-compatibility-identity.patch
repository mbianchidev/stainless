+// Lists and edits expiring per-site Google Chrome identity overrides for a
+// regular profile. Changing the active tab's site reloads that tab so the new
+// identity applies.
+class StainlessSiteCompatibilityView : public views::View,
+                                       public ui::TableModel,
+                                       public views::TableViewObserver {
+  METADATA_HEADER(StainlessSiteCompatibilityView, views::View)
+
+ public:
+  // Returns nullptr and logs why when the window cannot own the dialog.
+  static StainlessSiteCompatibilityView* Show(BrowserWindowInterface* browser);
+
+  explicit StainlessSiteCompatibilityView(BrowserWindowInterface* browser);
+  ~StainlessSiteCompatibilityView() override;
+
+  // ui::TableModel:
+  size_t RowCount() const override;
+  std::u16string GetText(size_t row, int column_id) const override;
+  std::u16string GetTooltip(size_t row) const override;
+  void SetObserver(ui::TableModelObserver* observer) override;
+
+  // views::TableViewObserver:
+  void OnSelectionChanged() override;
+
+ private:
+  friend class StainlessSiteCompatibilityBrowserTest;
+
+  PrefService& prefs() const;
+  GURL ActiveURL() const;
+  void Refresh();
+  void UpdateSelection();
+  void AddOverride();
+  void RemoveActiveSite();
+  void RemoveSelected();
+  void ReloadIfActiveSite(std::string_view site);
+
+  base::WeakPtr<BrowserWindowInterface> browser_;
+  std::optional<std::string> active_site_;
+  std::vector<stainless::SiteCompatibilityOverride> overrides_;
+  raw_ptr<views::Label> site_ = nullptr;
+  raw_ptr<views::Label> status_ = nullptr;
+  std::unique_ptr<ui::SimpleComboboxModel> duration_model_;
+  raw_ptr<views::Combobox> duration_ = nullptr;
+  raw_ptr<views::MdTextButton> add_ = nullptr;
+  raw_ptr<views::MdTextButton> remove_active_site_ = nullptr;
+  raw_ptr<views::Label> empty_ = nullptr;
+  raw_ptr<views::TableView> table_ = nullptr;
+  raw_ptr<views::MdTextButton> remove_selected_ = nullptr;
+  raw_ptr<views::Label> delta_ = nullptr;
+  raw_ptr<ui::TableModelObserver> model_observer_ = nullptr;
+  PrefChangeRegistrar registrar_;
+  base::WeakPtrFactory<StainlessSiteCompatibilityView> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_STAINLESS_SITE_COMPATIBILITY_VIEW_H_
