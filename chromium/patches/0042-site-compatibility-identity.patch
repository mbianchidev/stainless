diff --git a/chrome/browser/ui/views/stainless_site_compatibility_browsertest.cc b/chrome/browser/ui/views/stainless_site_compatibility_browsertest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..7e83ea2e44e477dc8e953655223835526841ab6f
--- /dev/null
+++ b/chrome/browser/ui/views/stainless_site_compatibility_browsertest.cc
@@ -0,0 +1,229 @@
+// Copyright 2026 Synctune Open
+
+#include "chrome/browser/ui/views/stainless_site_compatibility_view.h"
+
+#include <string>
+
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/test/run_until.h"
+#include "base/time/time.h"
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/browser/infobars/infobar_spec.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/stainless_site_compatibility/site_compatibility.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "components/embedder_support/user_agent_utils.h"
+#include "components/infobars/content/content_infobar_manager.h"
+#include "components/infobars/core/infobar.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "content/public/test/test_navigation_observer.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "ui/views/controls/table/table_view.h"
+#include "ui/views/view_utils.h"
+#include "ui/views/widget/widget.h"
+#include "ui/views/window/dialog_delegate.h"
+
+class StainlessSiteCompatibilityBrowserTest : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    ASSERT_TRUE(embedded_test_server()->Start());
+  }
+
+  // 127.0.0.1 and localhost are separate sites and secure contexts, so
+  // navigator.userAgentData is available on both.
+  GURL OverriddenURL() {
+    return embedded_test_server()->GetURL("127.0.0.1",
+                                          "/echoheader?User-Agent");
+  }
+  GURL OtherURL() {
+    return embedded_test_server()->GetURL("localhost",
+                                          "/echoheader?User-Agent");
+  }
+
+  PrefService& prefs() { return *browser()->GetProfile()->GetPrefs(); }
+  content::WebContents* contents() {
+    return browser()->GetTabStripModel()->GetActiveWebContents();
+  }
+
+  struct Identity {
+    std::string header;
+    std::string script;
+    std::string brands;
+  };
+
+  Identity Load(const GURL& url) {
+    EXPECT_TRUE(ui_test_utils::NavigateToURL(browser(), url));
+    return ReadIdentity();
+  }
+
+  Identity ReadIdentity() {
+    return {
+        content::EvalJs(contents(), "document.body.innerText").ExtractString(),
+        content::EvalJs(contents(), "navigator.userAgent").ExtractString(),
+        content::EvalJs(contents(),
+                        "navigator.userAgentData.brands.map(b => b.brand)"
+                        ".sort().join(',')")
+            .ExtractString(),
+    };
+  }
+
+  int CompatibilityNotices() {
+    int count = 0;
+    for (infobars::InfoBar* infobar :
+         infobars::ContentInfoBarManager::FromWebContents(contents())
+             ->infobars()) {
+      count += infobar->delegate()->GetIdentifier() ==
+               infobars::InfoBarDelegate::
+                   STAINLESS_SITE_COMPATIBILITY_INFOBAR_DELEGATE;
+    }
+    return count;
+  }
+
+  StainlessSiteCompatibilityView* FindDialog() {
+    auto* owner = BrowserView::GetBrowserViewForBrowser(browser());
+    for (views::Widget* widget : views::Widget::GetAllOwnedWidgets(
+             owner->GetWidget()->GetNativeView())) {
+      if (!widget->IsClosed() && widget->widget_delegate()) {
+        if (auto* view = views::AsViewClass<StainlessSiteCompatibilityView>(
+                widget->widget_delegate()->GetContentsView())) {
+          return view;
+        }
+      }
+    }
+    return nullptr;
+  }
+
+  void AddFromDialog(StainlessSiteCompatibilityView* view) {
+    view->AddOverride();
+  }
+  void RemoveFirstFromDialog(StainlessSiteCompatibilityView* view) {
+    view->table_->Select(0);
+    view->RemoveSelected();
+  }
+  size_t DialogRows(StainlessSiteCompatibilityView* view) {
+    return view->RowCount();
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(StainlessSiteCompatibilityBrowserTest,
+                       DefaultIdentityIsStainless) {
+  const std::string token = embedder_support::GetStainlessProductToken();
+  EXPECT_TRUE(base::StartsWith(token, "Stainless/"));
+  EXPECT_TRUE(base::EndsWith(token, ".0.0.0"));
+  Identity identity = Load(OtherURL());
+  EXPECT_EQ(embedder_support::GetUserAgent(), identity.header);
+  EXPECT_TRUE(base::EndsWith(identity.header, " " + token));
+  EXPECT_EQ(identity.header, identity.script);
+  EXPECT_NE(std::string::npos, identity.brands.find("Stainless"));
+  EXPECT_EQ(std::string::npos, identity.brands.find("Google Chrome"));
+  EXPECT_EQ(0, CompatibilityNotices());
+}
+
+IN_PROC_BROWSER_TEST_F(StainlessSiteCompatibilityBrowserTest,
+                       OverrideAppliesOnlyToItsSite) {
+  const base::Time now = base::Time::Now();
+  ASSERT_TRUE(stainless::AddSiteCompatibilityOverride(
+      prefs(), OverriddenURL(), base::Days(7), now));
+  auto recorded =
+      stainless::GetSiteCompatibilityOverride(prefs(), OverriddenURL(), now);
+  ASSERT_TRUE(recorded);
+  EXPECT_EQ("127.0.0.1", recorded->site);
+  EXPECT_EQ(now + base::Days(7), recorded->expires);
+  EXPECT_EQ(stainless::SiteCompatibilityDelta(), recorded->delta);
+  EXPECT_NE(std::u16string::npos,
+            recorded->delta.find(base::UTF8ToUTF16(
+                embedder_support::GetStainlessProductToken())));
+
+  Identity chrome = Load(OverriddenURL());
+  const std::string chrome_ua = embedder_support::GetUserAgent(
+      embedder_support::UserAgentIdentity::kChrome);
+  EXPECT_EQ(chrome_ua, chrome.header);
+  EXPECT_EQ(chrome_ua, chrome.script);
+  EXPECT_EQ(std::string::npos, chrome.header.find("Stainless"));
+  EXPECT_NE(std::string::npos, chrome.brands.find("Google Chrome"));
+  EXPECT_EQ(std::string::npos, chrome.brands.find("Stainless"));
+  EXPECT_EQ(1, CompatibilityNotices());
+
+  // Reloading the same site does not repeat the notice.
+  content::TestNavigationObserver reload(contents());
+  chrome::Reload(browser(), WindowOpenDisposition::kCurrentTab);
+  reload.Wait();
+  EXPECT_LE(CompatibilityNotices(), 1);
+  EXPECT_EQ(chrome_ua, ReadIdentity().header);
+
+  Identity stainless = Load(OtherURL());
+  EXPECT_EQ(embedder_support::GetUserAgent(), stainless.header);
+  EXPECT_NE(std::string::npos, stainless.brands.find("Stainless"));
+  EXPECT_EQ(0, CompatibilityNotices());
+}
+
+IN_PROC_BROWSER_TEST_F(StainlessSiteCompatibilityBrowserTest,
+                       OverridesExpireAndRejectUnboundedOrUnsupportedInput) {
+  const base::Time now = base::Time::Now();
+  EXPECT_FALSE(stainless::AddSiteCompatibilityOverride(
+      prefs(), OverriddenURL(), base::Days(31), now));
+  EXPECT_FALSE(stainless::AddSiteCompatibilityOverride(
+      prefs(), OverriddenURL(), base::TimeDelta(), now));
+  EXPECT_FALSE(stainless::AddSiteCompatibilityOverride(
+      prefs(), GURL("file:///tmp/page.html"), base::Days(1), now));
+  EXPECT_EQ("example.com", stainless::SiteCompatibilitySite(
+                               GURL("https://a.b.example.com/path")));
+
+  ASSERT_TRUE(stainless::AddSiteCompatibilityOverride(
+      prefs(), OverriddenURL(), base::Days(1), now - base::Days(2)));
+  EXPECT_FALSE(
+      stainless::GetSiteCompatibilityOverride(prefs(), OverriddenURL(), now));
+  Identity identity = Load(OverriddenURL());
+  EXPECT_EQ(embedder_support::GetUserAgent(), identity.header);
+  EXPECT_EQ(0, CompatibilityNotices());
+
+  stainless::PruneSiteCompatibilityOverrides(prefs(), now);
+  EXPECT_TRUE(prefs().GetDict(stainless::kSiteCompatibilityOverrides).empty());
+}
+
+IN_PROC_BROWSER_TEST_F(StainlessSiteCompatibilityBrowserTest,
+                       DialogAddsAndRemovesTheActiveSiteOverride) {
+  Load(OverriddenURL());
+  ASSERT_TRUE(chrome::ExecuteCommand(browser(), IDC_SHOW_SITE_COMPATIBILITY));
+  StainlessSiteCompatibilityView* view = FindDialog();
+  ASSERT_TRUE(view);
+  EXPECT_EQ(0u, DialogRows(view));
+
+  content::TestNavigationObserver added(contents());
+  AddFromDialog(view);
+  added.Wait();
+  EXPECT_EQ(1u, DialogRows(view));
+  EXPECT_EQ(embedder_support::GetUserAgent(
+                embedder_support::UserAgentIdentity::kChrome),
+            ReadIdentity().header);
+
+  content::TestNavigationObserver removed(contents());
+  RemoveFirstFromDialog(view);
+  removed.Wait();
+  EXPECT_EQ(0u, DialogRows(view));
+  EXPECT_EQ(embedder_support::GetUserAgent(), ReadIdentity().header);
+}
+
+IN_PROC_BROWSER_TEST_F(StainlessSiteCompatibilityBrowserTest,
+                       PrivateWindowsKeepTheStainlessIdentity) {
+  ASSERT_TRUE(stainless::AddSiteCompatibilityOverride(
+      prefs(), OverriddenURL(), base::Days(7), base::Time::Now()));
+  BrowserWindowInterface* incognito = CreateIncognitoBrowser();
+  EXPECT_FALSE(chrome::IsCommandEnabled(incognito, IDC_SHOW_SITE_COMPATIBILITY));
+  EXPECT_FALSE(StainlessSiteCompatibilityView::Show(incognito));
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(incognito, OverriddenURL()));
+  EXPECT_EQ(embedder_support::GetUserAgent(),
+            content::EvalJs(incognito->GetTabStripModel()->GetActiveWebContents(),
+                            "document.body.innerText")
+                .ExtractString());
+}
