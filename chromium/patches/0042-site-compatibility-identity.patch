diff --git a/chrome/browser/stainless_site_compatibility/site_compatibility.cc b/chrome/browser/stainless_site_compatibility/site_compatibility.cc
new file mode 100644
index 0000000000000000000000000000000000000000..7256fa930049c440a994d430ab2cfee3fe1dbbb8
--- /dev/null
+++ b/chrome/browser/stainless_site_compatibility/site_compatibility.cc
@@ -0,0 +1,152 @@
+// Copyright 2026 Synctune Open
+
+#include "chrome/browser/stainless_site_compatibility/site_compatibility.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/json/values_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/values.h"
+#include "chrome/grit/branded_strings.h"
+#include "components/embedder_support/user_agent_utils.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/pref_service.h"
+#include "components/prefs/scoped_user_pref_update.h"
+#include "net/base/registry_controlled_domains/registry_controlled_domain.h"
+#include "ui/base/l10n/l10n_util.h"
+#include "url/gurl.h"
+
+namespace stainless {
+namespace {
+
+constexpr char kIdentity[] = "identity";
+constexpr char kChromeIdentity[] = "chrome";
+constexpr char kCreated[] = "created";
+constexpr char kExpires[] = "expires";
+constexpr char kDelta[] = "delta";
+
+std::optional<SiteCompatibilityOverride> Parse(const std::string& site,
+                                               const base::Value& value,
+                                               base::Time now) {
+  const base::DictValue* entry = value.GetIfDict();
+  if (!entry) {
+    return std::nullopt;
+  }
+  const std::string* identity = entry->FindString(kIdentity);
+  const std::string* delta = entry->FindString(kDelta);
+  std::optional<base::Time> created = base::ValueToTime(entry->Find(kCreated));
+  std::optional<base::Time> expires = base::ValueToTime(entry->Find(kExpires));
+  if (!identity || *identity != kChromeIdentity || !delta || !created ||
+      !expires || *expires <= now || *expires <= *created ||
+      *expires - *created > kMaxSiteCompatibilityDuration) {
+    return std::nullopt;
+  }
+  return SiteCompatibilityOverride{site, *created, *expires,
+                                   base::UTF8ToUTF16(*delta)};
+}
+
+}  // namespace
+
+void RegisterSiteCompatibilityProfilePrefs(PrefRegistrySimple* registry) {
+  registry->RegisterDictionaryPref(kSiteCompatibilityOverrides);
+}
+
+std::optional<std::string> SiteCompatibilitySite(const GURL& url) {
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS() || url.host().empty()) {
+    return std::nullopt;
+  }
+  std::string site = net::registry_controlled_domains::GetDomainAndRegistry(
+      url, net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES);
+  return site.empty() ? std::string(url.host()) : site;
+}
+
+std::vector<SiteCompatibilityOverride> GetSiteCompatibilityOverrides(
+    const PrefService& prefs,
+    base::Time now) {
+  std::vector<SiteCompatibilityOverride> overrides;
+  for (const auto [site, value] : prefs.GetDict(kSiteCompatibilityOverrides)) {
+    if (auto entry = Parse(site, value, now)) {
+      overrides.push_back(std::move(*entry));
+    }
+  }
+  std::ranges::sort(overrides, {}, &SiteCompatibilityOverride::site);
+  return overrides;
+}
+
+std::optional<SiteCompatibilityOverride> GetSiteCompatibilityOverride(
+    const PrefService& prefs,
+    const GURL& url,
+    base::Time now) {
+  std::optional<std::string> site = SiteCompatibilitySite(url);
+  if (!site) {
+    return std::nullopt;
+  }
+  const base::Value* value =
+      prefs.GetDict(kSiteCompatibilityOverrides).Find(*site);
+  return value ? Parse(*site, *value, now) : std::nullopt;
+}
+
+bool AddSiteCompatibilityOverride(PrefService& prefs,
+                                  const GURL& url,
+                                  base::TimeDelta duration,
+                                  base::Time now) {
+  std::optional<std::string> site = SiteCompatibilitySite(url);
+  if (!site || !duration.is_positive() ||
+      duration > kMaxSiteCompatibilityDuration) {
+    return false;
+  }
+  ScopedDictPrefUpdate update(prefs, kSiteCompatibilityOverrides);
+  update->Set(*site,
+              base::DictValue()
+                  .Set(kIdentity, kChromeIdentity)
+                  .Set(kCreated, base::TimeToValue(now))
+                  .Set(kExpires, base::TimeToValue(now + duration))
+                  .Set(kDelta, base::UTF16ToUTF8(SiteCompatibilityDelta())));
+  return true;
+}
+
+void RemoveSiteCompatibilityOverride(PrefService& prefs,
+                                     std::string_view site) {
+  if (prefs.GetDict(kSiteCompatibilityOverrides).contains(site)) {
+    ScopedDictPrefUpdate(prefs, kSiteCompatibilityOverrides)->Remove(site);
+  }
+}
+
+void PruneSiteCompatibilityOverrides(PrefService& prefs, base::Time now) {
+  std::vector<std::string> stale;
+  for (const auto [site, value] : prefs.GetDict(kSiteCompatibilityOverrides)) {
+    if (!Parse(site, value, now)) {
+      stale.push_back(site);
+    }
+  }
+  if (stale.empty()) {
+    return;
+  }
+  ScopedDictPrefUpdate update(prefs, kSiteCompatibilityOverrides);
+  for (const std::string& site : stale) {
+    update->Remove(site);
+  }
+}
+
+blink::UserAgentOverride ChromeIdentityUserAgentOverride() {
+  blink::UserAgentOverride chrome;
+  chrome.ua_string_override = embedder_support::GetUserAgent(
+      embedder_support::UserAgentIdentity::kChrome);
+  chrome.ua_metadata_override = embedder_support::GetUserAgentMetadata(
+      embedder_support::UserAgentIdentity::kChrome);
+  return chrome;
+}
+
+std::u16string SiteCompatibilityBrowserName() {
+  return u"Google Chrome";
+}
+
+std::u16string SiteCompatibilityDelta() {
+  return l10n_util::GetStringFUTF16(
+      IDS_STAINLESS_SITE_COMPATIBILITY_DELTA,
+      base::UTF8ToUTF16(embedder_support::GetStainlessProductToken()),
+      SiteCompatibilityBrowserName());
+}
+
+}  // namespace stainless
diff --git a/chrome/browser/stainless_site_compatibility/site_compatibility.h b/chrome/browser/stainless_site_compatibility/site_compatibility.h
new file mode 100644
index 0000000000000000000000000000000000000000..13db93e136781a97dbae9ffd198a4b05d17ff705
--- /dev/null
+++ b/chrome/browser/stainless_site_compatibility/site_compatibility.h
@@ -0,0 +1,80 @@
+// Copyright 2026 Synctune Open
+
+#ifndef CHROME_BROWSER_STAINLESS_SITE_COMPATIBILITY_SITE_COMPATIBILITY_H_
+#define CHROME_BROWSER_STAINLESS_SITE_COMPATIBILITY_SITE_COMPATIBILITY_H_
+
+#include <array>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/time/time.h"
+#include "third_party/blink/public/common/user_agent/user_agent_metadata.h"
+
+class GURL;
+class PrefRegistrySimple;
+class PrefService;
+
+namespace stainless {
+
+// Profile preference: site -> {identity, created, expires, delta}. It is
+// local to the profile and never synced.
+inline constexpr char kSiteCompatibilityOverrides[] =
+    "stainless.site_compatibility.overrides";
+
+// Every override expires; users choose one of these durations.
+inline constexpr std::array<base::TimeDelta, 3> kSiteCompatibilityDurations = {
+    base::Days(1), base::Days(7), base::Days(30)};
+inline constexpr base::TimeDelta kMaxSiteCompatibilityDuration = base::Days(30);
+
+// The only implemented override: present as Google Chrome to one site.
+struct SiteCompatibilityOverride {
+  std::string site;
+  base::Time created;
+  base::Time expires;
+  // The compatibility and privacy change recorded when the override was added.
+  std::u16string delta;
+};
+
+void RegisterSiteCompatibilityProfilePrefs(PrefRegistrySimple* registry);
+
+// The override key for an http(s) URL: its registrable domain, or its host
+// for IP addresses and hosts without a registry. Other schemes return nullopt.
+std::optional<std::string> SiteCompatibilitySite(const GURL& url);
+
+// Unexpired, well-formed overrides, sorted by site.
+std::vector<SiteCompatibilityOverride> GetSiteCompatibilityOverrides(
+    const PrefService& prefs,
+    base::Time now);
+
+std::optional<SiteCompatibilityOverride> GetSiteCompatibilityOverride(
+    const PrefService& prefs,
+    const GURL& url,
+    base::Time now);
+
+// Adds or replaces the override for `url`'s site, recording the delta. Fails
+// for unsupported URLs and durations outside (0, kMaxSiteCompatibilityDuration].
+bool AddSiteCompatibilityOverride(PrefService& prefs,
+                                  const GURL& url,
+                                  base::TimeDelta duration,
+                                  base::Time now);
+
+void RemoveSiteCompatibilityOverride(PrefService& prefs, std::string_view site);
+
+// Removes expired and malformed entries. Writes only when something changes.
+void PruneSiteCompatibilityOverrides(PrefService& prefs, base::Time now);
+
+// The Google Chrome identity: the reduced user agent string without the
+// Stainless token and client hints that name Google Chrome.
+blink::UserAgentOverride ChromeIdentityUserAgentOverride();
+
+// The compatibility and privacy change an override makes.
+std::u16string SiteCompatibilityDelta();
+
+// The browser an override presents as, kept out of rebranded resources.
+std::u16string SiteCompatibilityBrowserName();
+
+}  // namespace stainless
+
+#endif  // CHROME_BROWSER_STAINLESS_SITE_COMPATIBILITY_SITE_COMPATIBILITY_H_
diff --git a/chrome/browser/stainless_site_compatibility/site_compatibility_tab_helper.cc b/chrome/browser/stainless_site_compatibility/site_compatibility_tab_helper.cc
new file mode 100644
index 0000000000000000000000000000000000000000..68f93ddb8f1bd3619e510d57c3e8d853ef74c216
--- /dev/null
+++ b/chrome/browser/stainless_site_compatibility/site_compatibility_tab_helper.cc
@@ -0,0 +1,98 @@
+// Copyright 2026 Synctune Open
+
+#include "chrome/browser/stainless_site_compatibility/site_compatibility_tab_helper.h"
+
+#include <optional>
+
+#include "base/i18n/time_formatting.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/time/time.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/infobars/browser_infobar_manager.h"
+#include "chrome/browser/infobars/infobar_spec.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/stainless_site_compatibility/site_compatibility.h"
+#include "chrome/grit/branded_strings.h"
+#include "components/infobars/core/infobar_delegate.h"
+#include "components/prefs/pref_service.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/l10n/l10n_util.h"
+
+namespace stainless {
+namespace {
+
+std::optional<SiteCompatibilityOverride> ActiveOverride(
+    content::WebContents* contents,
+    const GURL& url) {
+  Profile* profile = Profile::FromBrowserContext(contents->GetBrowserContext());
+  if (!profile || profile->IsOffTheRecord()) {
+    return std::nullopt;
+  }
+  return GetSiteCompatibilityOverride(*profile->GetPrefs(), url,
+                                      base::Time::Now());
+}
+
+}  // namespace
+
+SiteCompatibilityTabHelper::SiteCompatibilityTabHelper(
+    content::WebContents* contents)
+    : content::WebContentsObserver(contents),
+      content::WebContentsUserData<SiteCompatibilityTabHelper>(*contents) {}
+
+SiteCompatibilityTabHelper::~SiteCompatibilityTabHelper() = default;
+
+void SiteCompatibilityTabHelper::DidStartNavigation(
+    content::NavigationHandle* navigation) {
+  if (!navigation->IsInPrimaryMainFrame() || navigation->IsSameDocument()) {
+    return;
+  }
+  if (ActiveOverride(web_contents(), navigation->GetURL())) {
+    web_contents()->SetUserAgentOverride(ChromeIdentityUserAgentOverride(),
+                                         /*override_in_new_tabs=*/false);
+    navigation->SetIsOverridingUserAgent(true);
+    overriding_ = true;
+  } else if (overriding_) {
+    navigation->SetIsOverridingUserAgent(false);
+    overriding_ = false;
+  }
+}
+
+void SiteCompatibilityTabHelper::DidFinishNavigation(
+    content::NavigationHandle* navigation) {
+  if (!navigation->IsInPrimaryMainFrame() || navigation->IsSameDocument() ||
+      !navigation->HasCommitted() || navigation->IsErrorPage()) {
+    return;
+  }
+  std::optional<SiteCompatibilityOverride> active =
+      overriding_ ? ActiveOverride(web_contents(), navigation->GetURL())
+                  : std::nullopt;
+  if (!active) {
+    noticed_site_.clear();
+    return;
+  }
+  if (noticed_site_ == active->site) {
+    return;
+  }
+  noticed_site_ = active->site;
+  tabs::TabInterface* tab =
+      tabs::TabInterface::MaybeGetFromContents(web_contents());
+  auto* manager = infobars::BrowserInfoBarManager::From(g_browser_process);
+  if (!tab || !manager) {
+    return;
+  }
+  infobars::InfoBarShowParams params;
+  params.message_text = l10n_util::GetStringFUTF16(
+      IDS_STAINLESS_SITE_COMPATIBILITY_INFOBAR, SiteCompatibilityBrowserName(),
+      base::UTF8ToUTF16(active->site),
+      base::TimeFormatShortDate(active->expires));
+  manager->Show(
+      tab,
+      infobars::InfoBarDelegate::STAINLESS_SITE_COMPATIBILITY_INFOBAR_DELEGATE,
+      std::move(params));
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(SiteCompatibilityTabHelper);
+
+}  // namespace stainless
