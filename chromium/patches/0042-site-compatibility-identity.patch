+
+#ifndef CHROME_BROWSER_STAINLESS_SITE_COMPATIBILITY_SITE_COMPATIBILITY_TAB_HELPER_H_
+#define CHROME_BROWSER_STAINLESS_SITE_COMPATIBILITY_SITE_COMPATIBILITY_TAB_HELPER_H_
+
+#include <string>
+
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace stainless {
+
+// Applies an active site compatibility override to main-frame navigations
+// that start on that site, for regular (not off-the-record) profiles. Pages
+// and their frames then receive the Google Chrome identity in requests,
+// navigator.userAgent and client hints. A tab notice names the override the
+// first time each overridden site loads in the tab.
+class SiteCompatibilityTabHelper
+    : public content::WebContentsObserver,
+      public content::WebContentsUserData<SiteCompatibilityTabHelper> {
+ public:
+  SiteCompatibilityTabHelper(const SiteCompatibilityTabHelper&) = delete;
+  SiteCompatibilityTabHelper& operator=(const SiteCompatibilityTabHelper&) =
+      delete;
+  ~SiteCompatibilityTabHelper() override;
+
+  // content::WebContentsObserver:
+  void DidStartNavigation(content::NavigationHandle* navigation) override;
+  void DidFinishNavigation(content::NavigationHandle* navigation) override;
+
+ private:
+  friend class content::WebContentsUserData<SiteCompatibilityTabHelper>;
+  explicit SiteCompatibilityTabHelper(content::WebContents* contents);
+
+  // Whether this helper last turned the WebContents override on, so it never
+  // clears an override another feature (such as DevTools) set.
+  bool overriding_ = false;
+  // The overridden site whose notice this tab already showed.
+  std::string noticed_site_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+}  // namespace stainless
+
+#endif  // CHROME_BROWSER_STAINLESS_SITE_COMPATIBILITY_SITE_COMPATIBILITY_TAB_HELPER_H_
