+#include "third_party/blink/public/web/web_local_frame.h"
+#include "ui/accessibility/ax_role_properties.h"
+#include "url/url_constants.h"
+
+namespace content {
+namespace {
+
+using AnnotationStatus = ax::mojom::ImageAnnotationStatus;
+using ResultStatus = image_annotation::mojom::LocalImageAnnotationStatus;
+
+}  // namespace
+
+AXLocalImageAnnotator::AXLocalImageAnnotator(
+    RenderAccessibilityImpl* accessibility)
+    : RenderFrameObserver(accessibility->render_frame()),
+      accessibility_(accessibility) {}
+
+AXLocalImageAnnotator::~AXLocalImageAnnotator() = default;
+
+void AXLocalImageAnnotator::EnableAnnotations() {
+  if (!remote_.is_bound() && accessibility_->render_frame()) {
+    accessibility_->render_frame()->GetBrowserInterfaceBroker().GetInterface(
+        remote_.BindNewPipeAndPassReceiver());
+    remote_.set_disconnect_handler(base::BindOnce(
+        &AXLocalImageAnnotator::Disconnected, weak_.GetWeakPtr()));
+  }
+}
+
+void AXLocalImageAnnotator::CancelAnnotations() {
+  weak_.InvalidateWeakPtrs();
+  remote_.reset();
+  processor_.reset();
+  active_ = 0;
+  active_source_.clear();
+  waiting_ = false;
+  entries_.clear();
+  eligible_.clear();
+  dirty_.clear();
+  dirty_posted_ = false;
+  viewport_posted_ = false;
+  document_.reset();
+}
+
+uint32_t AXLocalImageAnnotator::GetAXModeToEnableAnnotations() {
+  return ui::AXMode::kLabelImages;
+}
+
+bool AXLocalImageAnnotator::HasAXActionToEnableAnnotations() {
+  return false;
+}
+
+ax::mojom::Action AXLocalImageAnnotator::GetAXActionToEnableAnnotations() {
+  return ax::mojom::Action::kAnnotatePageImages;
+}
+
+void AXLocalImageAnnotator::AddDebuggingAttributes(
+    const std::vector<ui::AXTreeUpdate>&) {}
+
+void AXLocalImageAnnotator::DidChangeScrollOffset(blink::mojom::ScrollType) {
+  ScheduleViewportCheck();
+}
+
+void AXLocalImageAnnotator::OnMainFrameViewportRectangleChanged(
+    const gfx::Rect&) {
+  ScheduleViewportCheck();
+}
+
+void AXLocalImageAnnotator::OnDestruct() {
+  CancelAnnotations();
+}
+
+void AXLocalImageAnnotator::ScheduleViewportCheck() {
+  if (!document_ || eligible_.empty() || viewport_posted_) {
+    return;
+  }
+  viewport_posted_ = true;
+  // Scroll-only AX location messages bypass the normal Annotate callback.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&AXLocalImageAnnotator::RefreshViewport,
+                                weak_.GetWeakPtr()));
+}
+
+void AXLocalImageAnnotator::RefreshViewport() {
+  viewport_posted_ = false;
+  auto* context = accessibility_->GetAXContext();
+  if (!document_ || !context || !context->HasActiveDocument()) {
+    return;
+  }
+  auto self = weak_.GetWeakPtr();
+  context->UpdateAXForAllDocuments();
+  if (self) {
+    MaybeStart();
+  }
+}
+
+bool AXLocalImageAnnotator::Eligible(const blink::WebAXObject& image) const {
+  if (image.IsDetached() || image.IsIgnored()) {
+    return false;
+  }
+  ax::mojom::NameFrom from;
+  std::vector<blink::WebAXObject> sources;
+  const auto name = image.GetName(from, sources);
+  if (from == ax::mojom::NameFrom::kAttributeExplicitlyEmpty ||
+      !base::ContainsOnlyChars(name.Utf8(), base::kWhitespaceASCII)) {
+    return false;
+  }
+  const auto node = image.GetNode();
+  if (node.IsNull() || !node.IsElementNode()) {
+    return false;
+  }
+  const auto bounds = image.GetBoundsInFrameCoordinates();
+  return bounds.width() >= 16 && bounds.height() >= 16;
+}
+
+std::string AXLocalImageAnnotator::SourceFingerprint(
+    const blink::WebAXObject& image) {
+  return crypto::SHA256HashString(image.Url().GetString().Utf8());
+}
+
+void AXLocalImageAnnotator::Annotate(const blink::WebDocument& document,
+                                     ui::AXTreeUpdate* update,
+                                     bool) {
+  if (!accessibility_->GetAccessibilityMode().has_mode(
+          ui::AXMode::kLabelImages) ||
+      accessibility_->GetAccessibilityMode().has_mode(
+          ui::AXMode::kPDFPrinting) ||
+      document.IsNull()) {
+    return;
+  }
+  const auto protocol = document.GetSecurityOrigin().Protocol();
+  if (protocol != url::kHttpScheme && protocol != url::kHttpsScheme &&
+      protocol != url::kFileScheme) {
+    return;
+  }
+  if (!document_ || *document_ != document.Token()) {
+    CancelAnnotations();
+    document_ = document.Token();
+    EnableAnnotations();
+  }
+  std::erase_if(entries_, [&](const auto& entry) {
+    auto image = blink::WebAXObject::FromWebDocumentByID(document, entry.first);
+    if (image.IsDetached()) {
+      eligible_.erase(entry.first);
+      return true;
+    }
+    return false;
+  });
+  std::vector<ui::AXNodeData*> images;
+  accessibility_->GetAXContext()->GetImagesToAnnotate(*update, images);
+  for (auto* node : images) {
+    auto image = blink::WebAXObject::FromWebDocumentByID(document, node->id);
+    if (ui::IsImage(node->role)) {
+      Apply(image, node);
+    } else if (node->GetNameFrom() != ax::mojom::NameFrom::kAttribute &&
+               node->GetStringAttribute(ax::mojom::StringAttribute::kName)
+                   .empty()) {
+      blink::WebAXObject inner;
+      if (AXImageAnnotator::FindInnerImage(image, &inner)) {
+        Apply(inner, node);
+      }
+    }
+  }
+  MaybeStart();
+}
+
+void AXLocalImageAnnotator::Apply(blink::WebAXObject image,
+                                  ui::AXNodeData* node) {
+  if (!Eligible(image)) {
+    eligible_.erase(image.AxID());
+    entries_.erase(image.AxID());
+    node->RemoveStringAttribute(ax::mojom::StringAttribute::kImageAnnotation);
+    node->SetImageAnnotationStatus(AnnotationStatus::kIneligibleForAnnotation);
+    return;
+  }
+  auto& entry = entries_[image.AxID()];
+  const auto source = SourceFingerprint(image);
+  if (!entry.initialized || entry.source != source) {
+    entry = Entry();
+    entry.source = source;
+    entry.initialized = true;
+  }
+  if (entry.status == AnnotationStatus::kAnnotationSucceeded) {
+    node->AddStringAttribute(ax::mojom::StringAttribute::kImageAnnotation,
+                             entry.text);
+  } else if (entry.status != AnnotationStatus::kAnnotationProcessFailed &&
+             active_ != image.AxID()) {
+    eligible_.insert(image.AxID());
+  }
+  node->SetImageAnnotationStatus(entry.status);
+}
+
+void AXLocalImageAnnotator::MaybeStart() {
+  if (!document_ || active_ || waiting_ || !remote_.is_bound() ||
+      !accessibility_->render_frame()) {
+    return;
+  }
+  const auto document = accessibility_->GetMainDocument();
+  if (document.IsNull() || document.Token() != *document_) {
+    return;
+  }
+  auto* frame = document.GetFrame();
+  if (!frame) {
+    return;
+  }
+  const auto viewport = frame->VisibleContentRect();
+  int selected = 0;
+  bool selected_focused = false;
+  for (auto item = eligible_.begin(); item != eligible_.end();) {
+    const auto entry = entries_.find(*item);
+    if (entry == entries_.end() ||
+        entry->second.status == AnnotationStatus::kAnnotationSucceeded ||
+        entry->second.status == AnnotationStatus::kAnnotationProcessFailed) {
+      item = eligible_.erase(item);
+      continue;
+    }
+    auto image = blink::WebAXObject::FromWebDocumentByID(document, *item);
+    if (!Eligible(image)) {
+      entries_.erase(*item);
+      item = eligible_.erase(item);
+      continue;
+    }
+    const bool focused = image.IsFocused();
+    if ((focused || viewport.Intersects(image.GetBoundsInFrameCoordinates())) &&
+        (!selected || (focused && !selected_focused))) {
+      selected = *item;
+      selected_focused = focused;
+    }
+    ++item;
+  }
+  if (!selected) {
+    return;
+  }
+  auto image = blink::WebAXObject::FromWebDocumentByID(document, selected);
+  auto element = image.GetNode().To<blink::WebElement>();
+  const auto size = element.GetImageSize();
+  active_ = selected;
+  active_source_ = entries_[selected].source;
+  eligible_.erase(selected);
+  entries_[selected].status = AnnotationStatus::kAnnotationPending;
+  processor_ =
+      std::make_unique<image_annotation::ImageProcessor>(base::BindRepeating(
+          [](base::WeakPtr<AXLocalImageAnnotator> self, int image_id) {
+            return self ? self->Pixels(image_id) : SkBitmap();
+          },
+          weak_.GetWeakPtr(), selected));
+  MarkDirty(image);
+  remote_->AnnotateImage(processor_->GetPendingRemote(), size,
+                         accessibility_->GetLanguage(),
+                         base::BindOnce(&AXLocalImageAnnotator::Completed,
+                                        weak_.GetWeakPtr(), selected));
+}
+
+SkBitmap AXLocalImageAnnotator::Pixels(int image_id) {
+  if (!document_ || image_id != active_) {
+    return SkBitmap();
+  }
+  const auto document = accessibility_->GetMainDocument();
+  if (document.IsNull() || document.Token() != *document_) {
+    return SkBitmap();
+  }
+  auto image = blink::WebAXObject::FromWebDocumentByID(document, image_id);
+  if (!Eligible(image) || SourceFingerprint(image) != active_source_) {
+    return SkBitmap();
+  }
+  auto element = image.GetNode().To<blink::WebElement>();
+  const auto size = element.GetImageSize();
+  if (size.IsEmpty() || size.width() > 4096 || size.height() > 4096) {
+    return SkBitmap();
+  }
+  auto bitmap = element.ImageContents();
+  if (bitmap.width() > 4096 || bitmap.height() > 4096) {
+    return SkBitmap();
+  }
+  return bitmap;
+}
+
+void AXLocalImageAnnotator::Completed(
+    int image_id,
+    image_annotation::mojom::LocalImageAnnotationResultPtr result) {
+  if (!document_ || active_ != image_id) {
+    return;
+  }
+  const auto source = active_source_;
+  processor_.reset();
+  auto* context = accessibility_->GetAXContext();
+  if (!context || !context->HasActiveDocument()) {
+    active_ = 0;
+    active_source_.clear();
+    return;
+  }
+  auto self = weak_.GetWeakPtr();
+  context->UpdateAXForAllDocuments();
+  if (!self || !document_) {
+    return;
+  }
+  const auto document = accessibility_->GetMainDocument();
+  if (document.IsNull() || document.Token() != *document_) {
+    active_ = 0;
+    active_source_.clear();
+    return;
+  }
+  active_ = 0;
+  active_source_.clear();
+  auto image = blink::WebAXObject::FromWebDocumentByID(document, image_id);
+  if (!Eligible(image) || !entries_.contains(image_id) ||
+      SourceFingerprint(image) != source) {
+    if (Eligible(image)) {
+      auto& entry = entries_[image_id];
+      entry = Entry();
+      entry.source = SourceFingerprint(image);
+      entry.initialized = true;
+      eligible_.insert(image_id);
+    } else {
+      entries_.erase(image_id);
+    }
+    MaybeStart();
+    return;
+  }
+  auto& entry = entries_[image_id];
+  if (result && result->status == ResultStatus::kBusy) {
+    entry.status = AnnotationStatus::kSilentlyEligibleForAnnotation;
+    eligible_.insert(image_id);
+    waiting_ = true;
+    remote_->WaitForAvailability(
+        base::BindOnce(&AXLocalImageAnnotator::Available, weak_.GetWeakPtr()));
+    return;
+  }
+  if (result && result->status == ResultStatus::kOk && !result->text.empty() &&
+      result->text.size() <= 65536 && base::IsStringUTF8(result->text) &&
+      result->text.find('\0') == std::string::npos) {
+    entry.status = AnnotationStatus::kAnnotationSucceeded;
+    entry.text = std::move(result->text);
+  } else {
+    entry.status = AnnotationStatus::kAnnotationProcessFailed;
+  }
+  MarkDirty(image);
+  MaybeStart();
+}
+
+void AXLocalImageAnnotator::Available(bool available) {
+  waiting_ = false;
+  if (available) {
+    MaybeStart();
+  }
+}
+
+void AXLocalImageAnnotator::Disconnected() {
+  remote_.reset();
+  processor_.reset();
+  if (active_) {
+    entries_[active_].status = AnnotationStatus::kAnnotationProcessFailed;
+    const auto document = accessibility_->GetMainDocument();
+    if (!document.IsNull()) {
+      auto image = blink::WebAXObject::FromWebDocumentByID(document, active_);
+      if (!image.IsDetached()) {
+        MarkDirty(image);
+      }
+    }
+  }
+  active_ = 0;
+  active_source_.clear();
+  waiting_ = false;
+}
+
+void AXLocalImageAnnotator::MarkDirty(const blink::WebAXObject& image) {
+  if (image.IsDetached()) {
+    return;
+  }
+  dirty_.insert(image.AxID());
+  if (!dirty_posted_) {
+    dirty_posted_ = true;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(&AXLocalImageAnnotator::FlushDirty, weak_.GetWeakPtr()));
+  }
+}
+
+void AXLocalImageAnnotator::FlushDirty() {
+  dirty_posted_ = false;
+  auto dirty = std::move(dirty_);
+  dirty_.clear();
+  auto* context = accessibility_->GetAXContext();
+  if (!document_ || !context || !context->HasActiveDocument()) {
+    return;
+  }
+  auto self = weak_.GetWeakPtr();
+  context->UpdateAXForAllDocuments();
+  if (!self || !document_) {
+    return;
+  }
+  const auto document = accessibility_->GetMainDocument();
+  if (document.IsNull() || document.Token() != *document_) {
+    return;
+  }
+  bool marked = false;
+  for (int id : dirty) {
+    auto image = blink::WebAXObject::FromWebDocumentByID(document, id);
+    if (image.IsDetached() || !image.IsIncludedInTree()) {
+      continue;
+    }
+    accessibility_->MarkWebAXObjectDirty(image);
+    marked = true;
+    auto parent = image.ParentObject();
+    for (int depth = 0; depth < 3 && !parent.IsDetached(); ++depth) {
+      if (parent.IsIncludedInTree() &&
+          (ui::IsLink(parent.Role()) ||
+           ui::IsPlatformDocument(parent.Role()))) {
+        accessibility_->MarkWebAXObjectDirty(parent);
+      }
+      parent = parent.ParentObject();
+    }
+  }
+  if (marked) {
+    context->ScheduleImmediateSerialization();
+  }
+}
+
+}  // namespace content
