+#ifndef CONTENT_RENDERER_ACCESSIBILITY_ANNOTATIONS_AX_LOCAL_IMAGE_ANNOTATOR_H_
+#define CONTENT_RENDERER_ACCESSIBILITY_ANNOTATIONS_AX_LOCAL_IMAGE_ANNOTATOR_H_
+
+#include <map>
+#include <memory>
+#include <optional>
+#include <set>
+#include <string>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "content/public/renderer/render_frame_observer.h"
+#include "content/renderer/accessibility/annotations/ax_annotator.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "services/image_annotation/public/cpp/image_processor.h"
+#include "services/image_annotation/public/mojom/stainless_local_image_annotation.mojom.h"
+#include "third_party/blink/public/common/tokens/tokens.h"
+
+namespace blink {
+class WebAXObject;
+}
+
+namespace content {
+
+class RenderAccessibilityImpl;
+
+class AXLocalImageAnnotator final : public AXAnnotator,
+                                    public RenderFrameObserver {
+ public:
+  explicit AXLocalImageAnnotator(RenderAccessibilityImpl* accessibility);
+  ~AXLocalImageAnnotator() override;
+  void Annotate(const blink::WebDocument& document,
+                ui::AXTreeUpdate* update,
+                bool load_complete) override;
+  void EnableAnnotations() override;
+  void CancelAnnotations() override;
+  uint32_t GetAXModeToEnableAnnotations() override;
+  bool HasAXActionToEnableAnnotations() override;
+  ax::mojom::Action GetAXActionToEnableAnnotations() override;
+  void AddDebuggingAttributes(
+      const std::vector<ui::AXTreeUpdate>& updates) override;
+  void DidChangeScrollOffset(blink::mojom::ScrollType) override;
+  void OnMainFrameViewportRectangleChanged(const gfx::Rect&) override;
+  void OnDestruct() override;
+
+ private:
+  struct Entry {
+    std::string source;
+    bool initialized = false;
+    ax::mojom::ImageAnnotationStatus status =
+        ax::mojom::ImageAnnotationStatus::kSilentlyEligibleForAnnotation;
+    std::string text;
+  };
+  bool Eligible(const blink::WebAXObject& image) const;
+  static std::string SourceFingerprint(const blink::WebAXObject& image);
+  void Apply(blink::WebAXObject image, ui::AXNodeData* node);
+  void MaybeStart();
+  SkBitmap Pixels(int image_id);
+  void Completed(int image_id,
+                 image_annotation::mojom::LocalImageAnnotationResultPtr result);
+  void Available(bool available);
+  void Disconnected();
+  void MarkDirty(const blink::WebAXObject& image);
+  void FlushDirty();
+  void ScheduleViewportCheck();
+  void RefreshViewport();
+
+  const raw_ptr<RenderAccessibilityImpl> accessibility_;
+  mojo::Remote<image_annotation::mojom::StainlessLocalImageAnnotator> remote_;
+  std::optional<blink::DocumentToken> document_;
+  std::map<int, Entry> entries_;
+  std::set<int> eligible_;
+  std::set<int> dirty_;
+  std::unique_ptr<image_annotation::ImageProcessor> processor_;
+  int active_ = 0;
+  std::string active_source_;
+  bool waiting_ = false;
+  bool dirty_posted_ = false;
+  bool viewport_posted_ = false;
+  base::WeakPtrFactory<AXLocalImageAnnotator> weak_{this};
+};
+
+}  // namespace content
+
+#endif
