@@ -0,0 +1,26 @@
+module image_annotation.mojom;
+
+import "services/image_annotation/public/mojom/image_annotation.mojom";
+import "ui/gfx/geometry/mojom/geometry.mojom";
+
+enum LocalImageAnnotationStatus {
+  kOk,
+  kBusy,
+  kUnavailable,
+  kCancelled,
+  kFailed,
+};
+
+struct LocalImageAnnotationResult {
+  LocalImageAnnotationStatus status;
+  string text;
+  string detail;
+};
+
+// Separate from the Google annotation service. No image URL or source ID.
+interface StainlessLocalImageAnnotator {
+  AnnotateImage(pending_remote<ImageProcessor> processor,
+                gfx.mojom.Size original_size,
+                string language) => (LocalImageAnnotationResult result);
+  WaitForAvailability() => (bool available);
+};
