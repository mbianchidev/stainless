diff --git a/chrome/browser/stainless_local/local_image_description.cc b/chrome/browser/stainless_local/local_image_description.cc
new file mode 100644
index 0000000000000000000000000000000000000000..949eb837812feba805264094d4b0aa70d5d986dc
--- /dev/null
+++ b/chrome/browser/stainless_local/local_image_description.cc
@@ -0,0 +1,474 @@
+#include "chrome/browser/stainless_local/local_image_description.h"
+
+#include <memory>
+#include <optional>
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/timer/timer.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/stainless_local/local_models.h"
+#include "chrome/browser/stainless_local/local_translation.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "content/public/browser/document_user_data.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "mojo/public/cpp/base/big_buffer.h"
+#include "mojo/public/cpp/bindings/receiver_set.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "services/image_annotation/public/mojom/image_annotation.mojom.h"
+#include "ui/accessibility/ax_mode.h"
+
+namespace stainless_local {
+namespace {
+
+using AnnotationStatus = image_annotation::mojom::LocalImageAnnotationStatus;
+using AnnotationResult = image_annotation::mojom::LocalImageAnnotationResult;
+
+const char* Prefix(const std::string& language) {
+  if (language == "it") {
+    return "Descrizione generata automaticamente, potenzialmente inesatta: ";
+  }
+  if (language == "fr") {
+    return "Description générée automatiquement, potentiellement inexacte : ";
+  }
+  if (language == "de") {
+    return "Maschinell erzeugt, möglicherweise ungenau: ";
+  }
+  if (language == "es") {
+    return "Descripción generada automáticamente, posiblemente inexacta: ";
+  }
+  return "Machine-generated, potentially inaccurate: ";
+}
+
+class LocalImageDescriptions final
+    : public content::DocumentUserData<LocalImageDescriptions>,
+      public content::WebContentsObserver,
+      public image_annotation::mojom::StainlessLocalImageAnnotator {
+ public:
+  ~LocalImageDescriptions() override {
+    weak_.InvalidateWeakPtrs();
+    ResolveWaiter(false);
+    Finish(AnnotationStatus::kCancelled,
+           "The image-description document was destroyed", "");
+  }
+
+  void Bind(mojo::PendingReceiver<
+            image_annotation::mojom::StainlessLocalImageAnnotator> receiver) {
+    if (receivers_.size() >= 16) {
+      receiver.ResetWithReason(1, "The local image-description context limit");
+      return;
+    }
+    receivers_.Add(this, std::move(receiver));
+  }
+
+  void AnnotateImage(
+      mojo::PendingRemote<image_annotation::mojom::ImageProcessor> processor,
+      const gfx::Size& original_size,
+      const std::string& language,
+      AnnotateImageCallback reply) override {
+    const auto target = language.size() > 35 ? std::string()
+                        : language.empty()
+                            ? "en"
+                            : NormalizeTranslationLanguage(language);
+    if (!Allowed() || language.size() > 35 || target.empty() ||
+        original_size.IsEmpty() || original_size.width() > 4096 ||
+        original_size.height() > 4096 || !processor.is_valid()) {
+      const char* detail =
+          "Local image descriptions need consent, a supported language and "
+          "an original image bounded to 4096 pixels per axis";
+      Report(detail, true);
+      std::move(reply).Run(
+          AnnotationResult::New(AnnotationStatus::kUnavailable, "", detail));
+      return;
+    }
+    if (operation_) {
+      std::move(reply).Run(AnnotationResult::New(
+          AnnotationStatus::kBusy, "",
+          "This document already has a pending local image description"));
+      return;
+    }
+    if (target != "en" &&
+        !IsLocalFeatureAllowed(&render_frame_host(), Feature::kTranslation)) {
+      const char* detail =
+          "Translated image descriptions need separate local translation "
+          "consent and the selected reviewed language pack";
+      Report(detail, true);
+      std::move(reply).Run(
+          AnnotationResult::New(AnnotationStatus::kUnavailable, "", detail));
+      return;
+    }
+    operation_ = std::make_unique<Operation>();
+    operation_->token = base::UnguessableToken::Create();
+    operation_->target = target;
+    operation_->reply = std::move(reply);
+    operation_->processor.Bind(std::move(processor));
+    const auto token = operation_->token;
+    operation_->processor.set_disconnect_handler(base::BindOnce(
+        &LocalImageDescriptions::LostProcessor, weak_.GetWeakPtr(), token));
+    timeout_.Start(FROM_HERE, base::Seconds(60),
+                   base::BindOnce(&LocalImageDescriptions::Expired,
+                                  weak_.GetWeakPtr(), token));
+    Report("Waiting for bounded local image-description admission", false);
+    const auto job = LocalBroker::Get().Submit(
+        &render_frame_host(), Feature::kImageDescriptions,
+        base::BindOnce(&LocalImageDescriptions::Admitted, weak_.GetWeakPtr(),
+                       token, false),
+        base::BindOnce(&LocalImageDescriptions::Described, weak_.GetWeakPtr(),
+                       token));
+    if (Matches(token)) {
+      operation_->job = job;
+    }
+  }
+
+  void WaitForAvailability(WaitForAvailabilityCallback reply) override {
+    if (waiter_) {
+      LOG(WARNING) << "Duplicate local image-description availability wait";
+      std::move(reply).Run(false);
+      return;
+    }
+    if (!Allowed()) {
+      std::move(reply).Run(false);
+      return;
+    }
+    if (!operation_ && LocalBroker::Get().CanQueueRequest()) {
+      std::move(reply).Run(true);
+      return;
+    }
+    waiter_ = std::move(reply);
+    availability_ = LocalBroker::Get().ObserveAvailability(base::BindRepeating(
+        &LocalImageDescriptions::Available, weak_.GetWeakPtr()));
+  }
+
+ private:
+  friend class content::DocumentUserData<LocalImageDescriptions>;
+  struct Operation {
+    base::UnguessableToken token;
+    base::UnguessableToken job;
+    std::string target;
+    AnnotateImageCallback reply;
+    mojo::Remote<image_annotation::mojom::ImageProcessor> processor;
+    LocalBroker::Ready ready;
+    std::optional<model_storage::Acquired> pack;
+    std::vector<std::string> chunks;
+    size_t chunk = 0;
+    std::string translated;
+  };
+
+  explicit LocalImageDescriptions(content::RenderFrameHost* frame)
+      : content::DocumentUserData<LocalImageDescriptions>(frame),
+        content::WebContentsObserver(
+            content::WebContents::FromRenderFrameHost(frame)) {
+    preferences_.Init(profile()->GetPrefs());
+    for (const char* preference :
+         {kImageDescriptionsEnabled, kTranslationEnabled}) {
+      preferences_.Add(
+          preference,
+          base::BindRepeating(&LocalImageDescriptions::PreferencesChanged,
+                              weak_.GetWeakPtr()));
+    }
+    receivers_.set_disconnect_handler(base::BindRepeating(
+        [](base::WeakPtr<LocalImageDescriptions> service) {
+          if (service && service->receivers_.empty()) {
+            service->ResolveWaiter(false);
+            service->Finish(AnnotationStatus::kCancelled,
+                            "The image-description client disconnected", "");
+          }
+        },
+        weak_.GetWeakPtr()));
+  }
+
+  Profile* profile() const {
+    return Profile::FromBrowserContext(render_frame_host().GetBrowserContext());
+  }
+  bool Allowed() const {
+    auto* contents =
+        content::WebContents::FromRenderFrameHost(&render_frame_host());
+    return IsLocalFeatureAllowed(&render_frame_host(),
+                                 Feature::kImageDescriptions) &&
+           contents &&
+           contents->GetVisibility() == content::Visibility::VISIBLE &&
+           contents->GetAccessibilityMode().has_mode(ui::AXMode::kLabelImages);
+  }
+  bool Matches(const base::UnguessableToken& token) const {
+    return operation_ && operation_->token == token;
+  }
+  void Report(const std::string& detail, bool error) {
+    if (auto* models = LocalModels::GetIfExists(profile())) {
+      models->ReportRuntimeStatus(Feature::kImageDescriptions, detail, error);
+    }
+    if (error) {
+      LOG(ERROR) << "Stainless local image description unavailable";
+    }
+  }
+  void Available() {
+    if (!Allowed()) {
+      ResolveWaiter(false);
+    } else if (!operation_ && LocalBroker::Get().CanQueueRequest()) {
+      ResolveWaiter(true);
+    }
+  }
+  void ResolveWaiter(bool available) {
+    availability_ = {};
+    if (waiter_) {
+      auto reply = std::move(waiter_);
+      std::move(reply).Run(available);
+    }
+  }
+  void PreferencesChanged() {
+    if (!Allowed() ||
+        (operation_ && operation_->target != "en" &&
+         !IsLocalFeatureAllowed(&render_frame_host(), Feature::kTranslation))) {
+      Finish(AnnotationStatus::kCancelled,
+             "Local image-description consent changed", "");
+      ResolveWaiter(false);
+    }
+  }
+  void OnVisibilityChanged(content::Visibility visibility) override {
+    if (visibility != content::Visibility::VISIBLE) {
+      Finish(AnnotationStatus::kCancelled,
+             "Local image descriptions stopped because their tab was hidden",
+             "");
+      ResolveWaiter(false);
+    }
+  }
+  void LostProcessor(base::UnguessableToken token) {
+    if (Matches(token)) {
+      Finish(AnnotationStatus::kCancelled,
+             "The original image processor disconnected", "");
+    }
+  }
+  void Expired(base::UnguessableToken token) {
+    if (Matches(token)) {
+      Finish(AnnotationStatus::kFailed,
+             "The local image-description request timed out after 60 seconds",
+             "");
+    }
+  }
+  void Admitted(base::UnguessableToken token,
+                bool translating,
+                LocalBroker::Ready ready) {
+    if (!Matches(token) || !Allowed()) {
+      LocalBroker::Prepared prepared;
+      prepared.error = "The original image-description document changed";
+      std::move(ready).Run(std::move(prepared));
+      return;
+    }
+    operation_->ready = std::move(ready);
+    auto* models = LocalModels::Get(profile());
+    if (!models) {
+      PreparationFailed("Local image-description setup is unavailable");
+      return;
+    }
+    models->AcquirePack(
+        translating ? "translation-en-" + operation_->target
+                    : "image-description",
+        translating ? Feature::kTranslation : Feature::kImageDescriptions,
+        base::BindOnce(&LocalImageDescriptions::PackReady, weak_.GetWeakPtr(),
+                       token, translating));
+  }
+  void PackReady(base::UnguessableToken token,
+                 bool translating,
+                 base::expected<model_storage::Acquired, std::string> pack) {
+    if (!Matches(token)) {
+      return;
+    }
+    if (!Allowed() || !pack.has_value()) {
+      PreparationFailed(pack.has_value() ? "The original image document changed"
+                                         : pack.error());
+      return;
+    }
+    if (translating) {
+      auto prepared = PrepareLocalTranslationRequest(
+          std::move(*pack), operation_->chunks[operation_->chunk]);
+      auto ready = std::move(operation_->ready);
+      std::move(ready).Run(std::move(prepared));
+      return;
+    }
+    operation_->pack.emplace(std::move(*pack));
+    operation_->processor->GetJpgImageData(base::BindOnce(
+        &LocalImageDescriptions::Pixels, weak_.GetWeakPtr(), token));
+  }
+  void Pixels(base::UnguessableToken token,
+              const std::vector<uint8_t>& bytes,
+              int32_t width,
+              int32_t height) {
+    if (!Matches(token)) {
+      return;
+    }
+    if (!Allowed() || bytes.empty() || bytes.size() > 16777216 || width <= 0 ||
+        width > 4096 || height <= 0 || height > 4096) {
+      PreparationFailed("Image-description pixels exceed their input boundary");
+      return;
+    }
+    operation_->processor.reset();
+    auto request = mojom::DescriptionRequest::New();
+    for (auto& file : operation_->pack->files) {
+      if (file->name == "model.gguf") {
+        request->model = std::move(file);
+      } else if (file->name == "projector.gguf") {
+        request->projector = std::move(file);
+      }
+    }
+    if (!request->model || !request->projector) {
+      PreparationFailed("The verified image-description pack is incomplete");
+      return;
+    }
+    request->image = mojom::Image::NewEncoded(mojo_base::BigBuffer(bytes));
+    LocalBroker::Prepared prepared;
+    prepared.request = mojom::Request::NewDescription(std::move(request));
+    prepared.leases = std::move(operation_->pack->leases);
+    operation_->pack.reset();
+    auto ready = std::move(operation_->ready);
+    Report("Describing the admitted image locally", false);
+    std::move(ready).Run(std::move(prepared));
+  }
+  void PreparationFailed(const std::string& detail) {
+    if (operation_ && operation_->ready) {
+      LocalBroker::Prepared prepared;
+      prepared.error = detail;
+      auto ready = std::move(operation_->ready);
+      std::move(ready).Run(std::move(prepared));
+    }
+  }
+  void Described(base::UnguessableToken token, mojom::ResultPtr result) {
+    if (!Matches(token)) {
+      return;
+    }
+    operation_->job = {};
+    if (!Allowed() || !result || result->status != mojom::Status::kOk) {
+      Finish(result && result->status == mojom::Status::kQueueFull
+                 ? AnnotationStatus::kBusy
+                 : AnnotationStatus::kUnavailable,
+             result && !result->detail.empty() ? result->detail
+                                               : "Local image inference failed",
+             "");
+      return;
+    }
+    if (operation_->target == "en") {
+      Finish(AnnotationStatus::kOk, "Local image description completed",
+             std::move(result->text));
+      return;
+    }
+    operation_->chunks = SplitLocalTranslationText(result->text);
+    if (operation_->chunks.empty()) {
+      Finish(AnnotationStatus::kFailed,
+             "The local description has no bounded translatable text", "");
+      return;
+    }
+    TranslateNext(token);
+  }
+  void TranslateNext(base::UnguessableToken token) {
+    if (!Matches(token)) {
+      return;
+    }
+    if (!Allowed() ||
+        !IsLocalFeatureAllowed(&render_frame_host(), Feature::kTranslation)) {
+      Finish(AnnotationStatus::kCancelled,
+             "Image-description translation lost its original consent", "");
+      return;
+    }
+    if (operation_->chunk == operation_->chunks.size()) {
+      Finish(AnnotationStatus::kOk,
+             "Local image description and translation completed",
+             std::move(operation_->translated));
+      return;
+    }
+    const auto job = LocalBroker::Get().Submit(
+        &render_frame_host(), Feature::kTranslation,
+        base::BindOnce(&LocalImageDescriptions::Admitted, weak_.GetWeakPtr(),
+                       token, true),
+        base::BindOnce(&LocalImageDescriptions::Translated, weak_.GetWeakPtr(),
+                       token));
+    if (Matches(token)) {
+      operation_->job = job;
+    }
+  }
+  void Translated(base::UnguessableToken token, mojom::ResultPtr result) {
+    if (!Matches(token)) {
+      return;
+    }
+    operation_->job = {};
+    if (!Allowed() || !result || result->status != mojom::Status::kOk ||
+        operation_->translated.size() + (result ? result->text.size() : 0) + 1 >
+            32768) {
+      Finish(result && result->status == mojom::Status::kQueueFull
+                 ? AnnotationStatus::kBusy
+                 : AnnotationStatus::kFailed,
+             result && !result->detail.empty()
+                 ? result->detail
+                 : "Local image-description translation failed",
+             "");
+      return;
+    }
+    if (!operation_->translated.empty()) {
+      operation_->translated += ' ';
+    }
+    operation_->translated += result->text;
+    ++operation_->chunk;
+    TranslateNext(token);
+  }
+  void Finish(AnnotationStatus status,
+              const std::string& detail,
+              std::string text) {
+    std::string diagnostic = detail;
+    timeout_.Stop();
+    auto operation = std::move(operation_);
+    if (!operation) {
+      return;
+    }
+    if (!operation->job.is_empty()) {
+      LocalBroker::Get().Cancel(operation->job);
+    }
+    if (operation->ready) {
+      LocalBroker::Prepared prepared;
+      prepared.error = detail;
+      std::move(operation->ready).Run(std::move(prepared));
+    }
+    if (status == AnnotationStatus::kOk && !text.empty()) {
+      text.insert(0, Prefix(operation->target));
+    } else if (status == AnnotationStatus::kOk) {
+      status = AnnotationStatus::kFailed;
+      diagnostic = "The local image description returned no text";
+    }
+    Report(diagnostic, status != AnnotationStatus::kOk &&
+                           status != AnnotationStatus::kBusy &&
+                           status != AnnotationStatus::kCancelled);
+    auto reply = std::move(operation->reply);
+    std::move(reply).Run(
+        AnnotationResult::New(status, std::move(text), diagnostic));
+    Available();
+  }
+
+  std::unique_ptr<Operation> operation_;
+  mojo::ReceiverSet<image_annotation::mojom::StainlessLocalImageAnnotator>
+      receivers_;
+  base::OneShotTimer timeout_;
+  PrefChangeRegistrar preferences_;
+  WaitForAvailabilityCallback waiter_;
+  base::CallbackListSubscription availability_;
+  base::WeakPtrFactory<LocalImageDescriptions> weak_{this};
+  DOCUMENT_USER_DATA_KEY_DECL();
+};
+
+DOCUMENT_USER_DATA_KEY_IMPL(LocalImageDescriptions);
+
+}  // namespace
+
+void BindLocalImageDescriptions(
+    content::RenderFrameHost* frame,
+    mojo::PendingReceiver<image_annotation::mojom::StainlessLocalImageAnnotator>
+        receiver) {
+  if (!IsLocalFeatureAllowed(frame, Feature::kImageDescriptions)) {
+    receiver.ResetWithReason(
+        1, "Local image descriptions require eligible consent");
+    return;
+  }
+  LocalImageDescriptions::GetOrCreateForCurrentDocument(frame)->Bind(
+      std::move(receiver));
+}
