+class StainlessImageDescriptionsBrowserTest : public InProcessBrowserTest {
+ public:
+  void SetUpCommandLine(base::CommandLine* command) override {
+    const auto summary =
+        base::CommandLine::ForCurrentProcess()->GetSwitchValuePath(
+            "test-launcher-summary-output");
+    if (summary.IsAbsolute()) {
+      ASSERT_TRUE(cache_.CreateUniqueTempDirUnderPath(summary.DirName()));
+    } else {
+      ASSERT_TRUE(cache_.CreateUniqueTempDir());
+    }
+    base::FilePath canonical;
+    ASSERT_TRUE(base::NormalizeFilePath(cache_.GetPath(), &canonical));
+    command->AppendSwitchPath("disk-cache-dir", canonical);
+    command->AppendSwitchASCII("headless", "new");
+    command->AppendSwitch("use-mock-keychain");
+    command->AppendSwitch("disable-audio-input");
+    command->AppendSwitch("disable-audio-output");
+    command->AppendSwitchASCII("lang", "en-US");
+  }
+
+  void SetUpOnMainThread() override {
+    ASSERT_TRUE(display::Screen::Get()->IsHeadless());
+    host_resolver()->AddRule("*", "127.0.0.1");
+    {
+      base::ScopedAllowBlockingForTesting blocking;
+      const auto root =
+          base::CommandLine::ForCurrentProcess()->GetSwitchValuePath(
+              "stainless-vision-browser-fixture");
+      ASSERT_TRUE(root.IsAbsolute());
+      for (const char* name : {"red-circle", "blue-square", "blank-white"}) {
+        std::string bytes;
+        ASSERT_TRUE(base::ReadFileToStringWithMaxSize(
+            root.AppendASCII(std::string(name) + ".png"), &bytes, 16777216));
+        images_["/" + std::string(name) + ".png"] = std::move(bytes);
+      }
+    }
+    interceptor_ =
+        std::make_unique<content::URLLoaderInterceptor>(base::BindRepeating(
+            [](std::atomic<size_t>* prohibited,
+               content::URLLoaderInterceptor::RequestParams* params) {
+              const auto& url = params->url_request.url;
+              if (!url.SchemeIsHTTPOrHTTPS() || url.host() == "one.test" ||
+                  url.host() == "two.test") {
+                return false;
+              }
+              ++*prohibited;
+              content::URLLoaderInterceptor::WriteResponse(
+                  "HTTP/1.1 503 Blocked synthetic external request\n\n", "",
+                  params->client.get());
+              return true;
+            },
+            &prohibited_));
+    embedded_test_server()->RegisterRequestHandler(
+        base::BindRepeating(&StainlessImageDescriptionsBrowserTest::Respond,
+                            base::Unretained(this)));
+    ASSERT_TRUE(embedded_test_server()->Start());
+  }
+
+  void TearDownOnMainThread() override {
+    if (auto* models = stainless_local::LocalModels::GetIfExists(
+            browser()->GetProfile())) {
+      ASSERT_TRUE(models->ConfigureFeature("image_descriptions", false, true)
+                      .has_value());
+    }
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), GURL("about:blank")));
+    interceptor_.reset();
+    base::RunLoop().RunUntilIdle();
+    base::ScopedAllowBlockingForTesting blocking;
+    const auto location = stainless_local::model_storage::ResolveLocation(
+        browser()->GetProfile()->GetPath().DirName());
+    ASSERT_TRUE(location.has_value()) << location.error();
+    const auto removed = stainless_local::test::RemoveModelFixtures(*location);
+    ASSERT_TRUE(removed.has_value()) << removed.error();
+  }
+
+  content::WebContents* contents() {
+    return browser()->GetTabStripModel()->GetActiveWebContents();
+  }
+
+  void Seed(const char* pack = "image-description") {
+    base::ScopedAllowBlockingForTesting blocking;
+    const auto root =
+        base::CommandLine::ForCurrentProcess()->GetSwitchValuePath(
+            "stainless-model-pack-fixture");
+    ASSERT_TRUE(root.IsAbsolute());
+    const auto location = stainless_local::model_storage::ResolveLocation(
+        browser()->GetProfile()->GetPath().DirName());
+    ASSERT_TRUE(location.has_value()) << location.error();
+    const auto installed =
+        stainless_local::test::InstallModelFixture(*location, pack, root);
+    ASSERT_TRUE(installed.has_value()) << installed.error();
+  }
+
+  void Enable() {
+    auto* models = stainless_local::LocalModels::Get(browser()->GetProfile());
+    ASSERT_TRUE(models);
+    ASSERT_TRUE(
+        models->ConfigureFeature("image_descriptions", true, true).has_value());
+  }
+
+  void Navigate(const char* path = "/scenes", int count = 5) {
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(
+        browser(), embedded_test_server()->GetURL("one.test", path)));
+    ASSERT_EQ(true, content::EvalJs(contents(), content::JsReplace(R"JS(
+      (async () => {
+        await Promise.all([...document.images].map(image => image.decode()));
+        return document.images.length === $1;
+      })()
+    )JS",
+                                                                   count)));
+  }
+
+  std::vector<std::string> Labels() {
+    std::vector<std::string> labels;
+    for (const auto& node :
+         content::GetAccessibilityTreeSnapshot(contents()).nodes) {
+      if (node.role == ax::mojom::Role::kImage) {
+        auto text = node.GetStringAttribute(
+            ax::mojom::StringAttribute::kImageAnnotation);
+        if (!text.empty()) {
+          labels.push_back(std::move(text));
+        }
+      }
+    }
+    return labels;
+  }
+
+  size_t prohibited() const { return prohibited_.load(); }
+
+  size_t Failed() {
+    size_t failures = 0;
+    for (const auto& node :
+         content::GetAccessibilityTreeSnapshot(contents()).nodes) {
+      if (node.role == ax::mojom::Role::kImage &&
+          node.GetImageAnnotationStatus() ==
+              ax::mojom::ImageAnnotationStatus::kAnnotationProcessFailed) {
+        ++failures;
+      }
+    }
+    return failures;
+  }
+
+  bool Pending() {
+    for (const auto& node :
+         content::GetAccessibilityTreeSnapshot(contents()).nodes) {
+      if (node.role == ax::mojom::Role::kImage &&
+          node.GetImageAnnotationStatus() ==
+              ax::mojom::ImageAnnotationStatus::kAnnotationPending) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  bool RuntimeContains(const char* text) {
+    const auto status =
+        stainless_local::LocalModels::Get(browser()->GetProfile())->Status();
+    const auto* runtime = status.FindList("runtime");
+    if (!runtime) {
+      return false;
+    }
+    for (const auto& feature : *runtime) {
+      const auto* id = feature.GetDict().FindString("id");
+      const auto* detail = feature.GetDict().FindString("status");
+      if (id && *id == "image_descriptions" && detail &&
+          detail->find(text) != std::string::npos) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  std::string DebugState() {
+    return content::GetAccessibilityTreeSnapshot(contents()).ToString() +
+           "\nLocal Services: " +
+           stainless_local::LocalModels::Get(browser()->GetProfile())
+               ->Status()
+               .DebugString();
+  }
+
+ private:
+  std::unique_ptr<net::test_server::HttpResponse> Respond(
+      const net::test_server::HttpRequest& request) {
+    auto response = std::make_unique<net::test_server::BasicHttpResponse>();
+    response->AddCustomHeader(
+        "Content-Security-Policy",
+        "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'");
+    if (request.relative_url == "/scenes") {
+      response->set_content_type("text/html; charset=utf-8");
+      response->set_content(
+          "<!doctype html><html lang=en><style>"
+          "body{margin:0}img{width:120px;height:120px}</style>"
+          "<img id=circle src=/red-circle.png>"
+          "<img id=square src=/blue-square.png>"
+          "<img id=blank src=/blank-white.png>"
+          "<img id=author src=/red-circle.png alt=X>"
+          "<img id=decorative src=/blue-square.png alt=''>");
+    } else if (request.relative_url == "/one" ||
+               request.relative_url == "/one-it") {
+      response->set_content_type("text/html; charset=utf-8");
+      response->set_content(request.relative_url == "/one"
+                                ? "<!doctype html><html lang=en><img id=scene "
+                                  "width=120 height=120 "
+                                  "src=/red-circle.png>"
+                                : "<!doctype html><html lang=it><img id=scene "
+                                  "width=120 height=120 "
+                                  "src=/blue-square.png>");
+    } else if (request.relative_url == "/many") {
+      response->set_content_type("text/html; charset=utf-8");
+      std::string html =
+          "<!doctype html><html lang=en><style>body{margin:0}"
+          "img{width:60px;height:60px}</style>";
+      for (int image = 0; image < 17; ++image) {
+        html += "<img src=/blue-square.png>";
+      }
+      response->set_content(std::move(html));
+    } else if (request.relative_url == "/lazy") {
+      response->set_content_type("text/html; charset=utf-8");
+      response->set_content(
+          "<!doctype html><html lang=en><style>body{margin:0}"
+          "img{width:120px;height:120px}</style>"
+          "<img id=offscreen style='position:absolute;top:2000px' "
+          "src=/red-circle.png>"
+          "<img id=visible tabindex=0 src=/blue-square.png>");
+    } else if (request.relative_url == "/blocker") {
+      response->set_content_type("text/html; charset=utf-8");
+      response->set_content(
+          "<!doctype html><title>Fictional broker owner</title>");
+    } else if (const auto found = images_.find(request.relative_url);
+               found != images_.end()) {
+      response->set_content_type("image/png");
+      response->set_content(found->second);
+    } else {
+      return nullptr;
+    }
+    return response;
+  }
+
+  base::ScopedTempDir cache_;
+  std::map<std::string, std::string> images_;
+  std::atomic<size_t> prohibited_{0};
+  std::unique_ptr<content::URLLoaderInterceptor> interceptor_;
+};
