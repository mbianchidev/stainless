+IN_PROC_BROWSER_TEST_F(StainlessImageDescriptionsBrowserTest,
+                       MANUAL_ActualSceneLabelsPreserveAuthorAltAndDisclaimer) {
+  base::test::ScopedRunLoopTimeout timeout(FROM_HERE, base::Seconds(120));
+  Seed();
+  Enable();
+  content::ScopedAccessibilityModeOverride mode(contents(),
+                                                ui::kAXModeComplete);
+  ASSERT_TRUE(
+      contents()->GetAccessibilityMode().has_mode(ui::AXMode::kLabelImages));
+  ASSERT_NO_FATAL_FAILURE(Navigate());
+  std::vector<std::string> labels;
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    labels = Labels();
+    return labels.size() == 3;
+  }));
+  std::set<std::string> unique;
+  size_t circles = 0;
+  size_t squares = 0;
+  size_t blanks = 0;
+  for (const auto& label : labels) {
+    EXPECT_TRUE(
+        label.starts_with("Machine-generated, potentially inaccurate: "));
+    circles += Circle(label) ? 1 : 0;
+    squares += Square(label) ? 1 : 0;
+    blanks += Blank(label) ? 1 : 0;
+    unique.insert(label);
+  }
+  EXPECT_EQ(1u, circles);
+  EXPECT_EQ(1u, squares);
+  EXPECT_EQ(1u, blanks);
+  EXPECT_EQ(3u, unique.size());
+  bool author = false;
+  for (const auto& node :
+       content::GetAccessibilityTreeSnapshot(contents()).nodes) {
+    if (node.role == ax::mojom::Role::kImage &&
+        node.GetStringAttribute(ax::mojom::StringAttribute::kName) == "X") {
+      author = true;
+      EXPECT_TRUE(
+          node.GetStringAttribute(ax::mojom::StringAttribute::kImageAnnotation)
+              .empty());
+    }
+  }
+  EXPECT_TRUE(author);
+  EXPECT_EQ("X", content::EvalJs(contents(),
+                                 "document.querySelector('#author').alt"));
+  EXPECT_EQ("", content::EvalJs(contents(),
+                                "document.querySelector('#decorative').alt"));
+  EXPECT_EQ(0u, prohibited());
+}
