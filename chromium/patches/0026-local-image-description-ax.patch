+bool Concept(const std::string& text, const char* word) {
+  const auto lower = base::ToLowerASCII(text);
+  const size_t length = std::char_traits<char>::length(word);
+  for (auto offset = lower.find(word); offset != std::string::npos;
+       offset = lower.find(word, offset + 1)) {
+    if ((offset == 0 || !base::IsAsciiAlpha(lower[offset - 1])) &&
+        (offset + length == lower.size() ||
+         !base::IsAsciiAlpha(lower[offset + length]))) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool Circle(const std::string& text) {
+  return Concept(text, "red") &&
+         (Concept(text, "circle") || Concept(text, "circular") ||
+          Concept(text, "disc") || Concept(text, "disk") ||
+          Concept(text, "ball")) &&
+         !Concept(text, "blue") && !Concept(text, "person") &&
+         !Concept(text, "dog") && !Concept(text, "cat");
+}
+
+bool Square(const std::string& text) {
+  return Concept(text, "blue") &&
+         (Concept(text, "square") || Concept(text, "box") ||
+          Concept(text, "rectangle") || Concept(text, "rectangular")) &&
+         !Concept(text, "red") && !Concept(text, "person") &&
+         !Concept(text, "dog") && !Concept(text, "cat");
+}
+
+bool Blank(const std::string& text) {
+  return Concept(text, "white") &&
+         (Concept(text, "blank") || Concept(text, "empty") ||
+          Concept(text, "plain") || Concept(text, "solid") ||
+          Concept(text, "completely")) &&
+         !Concept(text, "red") && !Concept(text, "blue") &&
+         !Concept(text, "person") && !Concept(text, "robot") &&
+         !Concept(text, "dog") && !Concept(text, "cat");
+}
