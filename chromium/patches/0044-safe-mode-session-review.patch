+StainlessSessionReviewView::StainlessSessionReviewView(
+    BrowserWindowInterface* browser)
+    : browser_(browser->GetWeakPtr()) {
+  const auto* layout = ChromeLayoutProvider::Get();
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(),
+      layout->GetDistanceMetric(views::DISTANCE_RELATED_CONTROL_VERTICAL)));
+  AddLabel(this, Text(IDS_STAINLESS_SESSION_REVIEW_INTRO));
+  status_ = AddLabel(this, Text(IDS_STAINLESS_SESSION_REVIEW_LOADING));
+
+  auto* controls = AddChildView(std::make_unique<views::View>());
+  controls->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal, gfx::Insets(),
+      layout->GetDistanceMetric(views::DISTANCE_RELATED_BUTTON_HORIZONTAL)));
+  select_all_ = controls->AddChildView(std::make_unique<views::MdTextButton>(
+      base::BindRepeating(&StainlessSessionReviewView::SetAll,
+                          base::Unretained(this), true),
+      Text(IDS_STAINLESS_SESSION_REVIEW_SELECT_ALL)));
+  select_none_ = controls->AddChildView(std::make_unique<views::MdTextButton>(
+      base::BindRepeating(&StainlessSessionReviewView::SetAll,
+                          base::Unretained(this), false),
+      Text(IDS_STAINLESS_SESSION_REVIEW_SELECT_NONE)));
+
+  auto list = std::make_unique<views::View>();
+  list->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(),
+      layout->GetDistanceMetric(views::DISTANCE_RELATED_CONTROL_VERTICAL)));
+  scroll_ = AddChildView(std::make_unique<views::ScrollView>());
+  list_ = scroll_->SetContents(std::move(list));
+  scroll_->ClipHeightTo(240, 240);
+  scroll_->SetHorizontalScrollBarMode(
+      views::ScrollView::ScrollBarMode::kDisabled);
+  scroll_->GetViewAccessibility().SetName(
+      Text(IDS_STAINLESS_SESSION_REVIEW_LIST));
+  UpdateControls();
+
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::CONTINUE_ON_SHUTDOWN},
+      base::BindOnce(&StainlessSessionReviewView::Read,
+                     browser->GetProfile()->GetPath()),
+      base::BindOnce(&StainlessSessionReviewView::OnRead,
+                     weak_factory_.GetWeakPtr()));
+}
