+// static
+CommandStorageBackend::ReadCommandsResult
+CommandStorageBackend::ReadLastSessionCommandsWithoutCleanup(
+    const base::FilePath& path,
+    CommandStorageManager::SessionType type) {
+  ReadCommandsResult result;
+  result.status = CommandStorageReadStatus::kNoFile;
+  for (const SessionInfo& session : GetSessionFilesSortedByReverseTimestamp(
+           path, type, /*encrypted=*/false)) {
+    const CommandStorageReadStatus marker_status =
+        SessionFileReader::GetMarkerStatus(session.path, /*encryptor=*/nullptr);
+    if (marker_status != CommandStorageReadStatus::kSuccess) {
+      if (result.status == CommandStorageReadStatus::kNoFile) {
+        result.status = marker_status;
+      }
+      continue;
+    }
+    SessionFileReader::ReadResult read =
+        SessionFileReader::Read(session.path, /*encryptor=*/nullptr);
+    result.commands = std::move(read.commands);
+    result.status = read.status;
+    return result;
+  }
+  return result;
+}
