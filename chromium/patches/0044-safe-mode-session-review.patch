+// static
+bool StainlessSessionReviewView::CanShow(BrowserWindowInterface* browser) {
+  if (!stainless::IsStartupSafeMode() || !browser ||
+      browser->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+      !browser->GetProfile() || browser->GetProfile()->IsOffTheRecord()) {
+    return false;
+  }
+  auto* owner = BrowserView::GetBrowserViewForBrowser(browser);
+  return owner && owner->GetWidget() && !owner->GetWidget()->IsClosed();
+}
+
+// static
+StainlessSessionReviewView* StainlessSessionReviewView::Show(
+    BrowserWindowInterface* browser) {
+  if (!CanShow(browser)) {
+    LOG(WARNING) << "Reviewing the previous session needs Safe Mode and a live "
+                    "normal window of a regular profile";
+    return nullptr;
+  }
+  auto contents = std::make_unique<StainlessSessionReviewView>(browser);
+  StainlessSessionReviewView* view = contents.get();
+  auto dialog = std::make_unique<views::DialogDelegate>();
+  dialog->SetTitle(Text(IDS_STAINLESS_SESSION_REVIEW_TITLE));
+  dialog->SetModalType(ui::mojom::ModalType::kWindow);
+  dialog->SetButtons(static_cast<int>(ui::mojom::DialogButton::kOk) |
+                     static_cast<int>(ui::mojom::DialogButton::kCancel));
+  dialog->SetButtonLabel(ui::mojom::DialogButton::kOk,
+                         Text(IDS_STAINLESS_SESSION_REVIEW_REOPEN));
+  dialog->SetButtonEnabled(ui::mojom::DialogButton::kOk, false);
+  dialog->SetDefaultButton(static_cast<int>(ui::mojom::DialogButton::kNone));
+  dialog->SetAcceptCallbackWithClose(base::BindRepeating(
+      [](base::WeakPtr<StainlessSessionReviewView> review) {
+        return !review || review->Restore();
+      },
+      view->weak_factory_.GetWeakPtr()));
+  dialog->set_fixed_width(ChromeLayoutProvider::Get()->GetDistanceMetric(
+      views::DISTANCE_MODAL_DIALOG_PREFERRED_WIDTH));
+  dialog->set_margins(ChromeLayoutProvider::Get()->GetDialogInsetsForContentType(
+      views::DialogContentType::kText, views::DialogContentType::kControl));
+  dialog->SetInitiallyFocusedView(view->scroll_);
+  dialog->SetContentsView(std::move(contents));
+  auto* widget = views::DialogDelegate::CreateDialogWidget(
+      std::move(dialog), gfx::NativeWindow(),
+      BrowserView::GetBrowserViewForBrowser(browser)
+          ->GetWidget()
+          ->GetNativeView());
+  widget->Show();
+  return view;
+}
