+StainlessSessionReviewView::~StainlessSessionReviewView() = default;
+
+// static
+StainlessSessionReviewView::ReadResult StainlessSessionReviewView::Read(
+    const base::FilePath& profile_path) {
+  ReadResult result;
+  sessions::CommandStorageBackend::ReadCommandsResult read =
+      sessions::CommandStorageBackend::ReadLastSessionCommandsWithoutCleanup(
+          profile_path,
+          sessions::CommandStorageManager::SessionType::kSessionRestore);
+  if (read.status == sessions::CommandStorageReadStatus::kNoFile) {
+    return result;
+  }
+  const bool read_error = sessions::IsCommandStorageReadError(read.status);
+  std::vector<std::unique_ptr<sessions::SessionWindow>> windows;
+  SessionID active_window = SessionID::InvalidValue();
+  std::string platform_session_id;
+  std::set<SessionID> discarded_window_ids;
+  sessions::RestoreSessionFromCommands(read.commands, &windows, &active_window,
+                                       &platform_session_id,
+                                       &discarded_window_ids);
+  for (auto& window : windows) {
+    if (window->type != sessions::SessionWindow::TYPE_NORMAL) {
+      continue;
+    }
+    std::erase_if(window->tabs, [](const auto& tab) {
+      return tab->navigations.empty();
+    });
+    if (!window->tabs.empty()) {
+      result.windows.push_back(std::move(window));
+    }
+  }
+  if (read_error) {
+    LOG(WARNING) << "The previous session was only partly readable: "
+                 << static_cast<int>(read.status);
+    result.state =
+        result.windows.empty() ? State::kUnreadable : State::kPartial;
+  } else {
+    result.state = result.windows.empty() ? State::kEmpty : State::kReady;
+  }
+  return result;
+}
+
+void StainlessSessionReviewView::OnRead(ReadResult result) {
+  state_ = result.state;
+  windows_ = std::move(result.windows);
+  for (size_t w = 0; w < windows_.size(); ++w) {
+    const auto& tabs = windows_[w]->tabs;
+    AddLabel(list_,
+             l10n_util::GetStringFUTF16(
+                 IDS_STAINLESS_SESSION_REVIEW_WINDOW,
+                 base::NumberToString16(w + 1),
+                 base::NumberToString16(tabs.size())),
+             /*heading=*/true);
+    for (size_t t = 0; t < tabs.size(); ++t) {
+      const sessions::SerializedNavigationEntry& entry = CurrentEntry(*tabs[t]);
+      const std::u16string url = url_formatter::FormatUrl(entry.virtual_url());
+      auto* checkbox = list_->AddChildView(std::make_unique<views::Checkbox>(
+          entry.title().empty() ? url : entry.title(),
+          base::BindRepeating(&StainlessSessionReviewView::UpdateControls,
+                              base::Unretained(this))));
+      checkbox->SetChecked(true);
+      checkbox->SetTooltipText(url);
+      checkbox->GetViewAccessibility().SetDescription(url);
+      entries_.push_back({w, t, checkbox});
+    }
+  }
+  int message = IDS_STAINLESS_SESSION_REVIEW_READY;
+  switch (state_) {
+    case State::kEmpty:
+      message = IDS_STAINLESS_SESSION_REVIEW_EMPTY;
+      break;
+    case State::kUnreadable:
+      message = IDS_STAINLESS_SESSION_REVIEW_UNREADABLE;
+      break;
+    case State::kPartial:
+      message = IDS_STAINLESS_SESSION_REVIEW_PARTIAL;
+      break;
+    case State::kLoading:
+    case State::kReady:
+      break;
+  }
+  const std::u16string status = Text(message);
+  status_->SetText(status);
+  status_->GetViewAccessibility().AnnounceText(status);
+  UpdateControls();
+  list_->InvalidateLayout();
+}
+
+void StainlessSessionReviewView::SetAll(bool checked) {
+  for (const Entry& entry : entries_) {
+    entry.checkbox->SetChecked(checked);
+  }
+  UpdateControls();
+}
+
+size_t StainlessSessionReviewView::SelectedCount() const {
+  return std::ranges::count_if(
+      entries_, [](const Entry& entry) { return entry.checkbox->GetChecked(); });
+}
+
+void StainlessSessionReviewView::UpdateControls() {
+  const bool any = !entries_.empty();
+  select_all_->SetEnabled(any);
+  select_none_->SetEnabled(any);
+  if (!GetWidget() || !GetWidget()->widget_delegate()) {
+    return;
+  }
+  if (auto* dialog = GetWidget()->widget_delegate()->AsDialogDelegate()) {
+    dialog->SetButtonEnabled(ui::mojom::DialogButton::kOk,
+                             SelectedCount() > 0);
+  }
+}
+
+bool StainlessSessionReviewView::Restore() {
+  if (!browser_ || !CanShow(browser_.get()) || SelectedCount() == 0) {
+    return false;
+  }
+  std::vector<std::unique_ptr<sessions::SessionWindow>> chosen;
+  for (size_t w = 0; w < windows_.size(); ++w) {
+    std::vector<std::unique_ptr<sessions::SessionTab>> kept;
+    for (const Entry& entry : entries_) {
+      if (entry.window == w && entry.checkbox->GetChecked()) {
+        kept.push_back(std::move(windows_[w]->tabs[entry.tab]));
+      }
+    }
+    if (kept.empty()) {
+      continue;
+    }
+    std::unique_ptr<sessions::SessionWindow> window = std::move(windows_[w]);
+    // Groups, splits and app tabs are not recreated: only the chosen tabs and
+    // their navigation history are reopened.
+    for (size_t i = 0; i < kept.size(); ++i) {
+      kept[i]->tab_visual_index = static_cast<int>(i);
+      kept[i]->window_id = window->window_id;
+      kept[i]->group.reset();
+      kept[i]->split_id.reset();
+      kept[i]->extension_app_id.clear();
+    }
+    window->tabs = std::move(kept);
+    window->tab_groups.clear();
+    window->split_tabs.clear();
+    window->selected_tab_index = 0;
+    chosen.push_back(std::move(window));
+  }
+  entries_.clear();
+  windows_.clear();
+  std::vector<const sessions::SessionWindow*> windows;
+  for (const auto& window : chosen) {
+    windows.push_back(window.get());
+  }
+  SessionRestore::RestoreForeignSessionWindows(
+      browser_->GetProfile(), windows.cbegin(), windows.cend(),
+      base::DoNothing());
+  return true;
+}
