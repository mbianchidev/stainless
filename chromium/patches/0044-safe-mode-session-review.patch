+// Safe Mode only. Lists the windows and tabs of the session that Safe Mode kept
+// but did not restore, and reopens only the tabs the user selects, in new
+// windows with their back/forward history. The session files are read without
+// opening, moving or deleting any of them, and nothing is reopened without an
+// explicit choice.
+class StainlessSessionReviewView : public views::View {
+  METADATA_HEADER(StainlessSessionReviewView, views::View)
+
+ public:
+  enum class State { kLoading, kReady, kPartial, kEmpty, kUnreadable };
+
+  // Whether `browser` can own the review: a Safe Mode launch and a live normal
+  // window of a regular profile.
+  static bool CanShow(BrowserWindowInterface* browser);
+
+  // Returns nullptr and logs why when the review is unavailable.
+  static StainlessSessionReviewView* Show(BrowserWindowInterface* browser);
+
+  explicit StainlessSessionReviewView(BrowserWindowInterface* browser);
+  ~StainlessSessionReviewView() override;
+
+ private:
+  friend class StainlessSessionReviewBrowserTest;
+
+  struct Entry {
+    size_t window;
+    size_t tab;
+    raw_ptr<views::Checkbox> checkbox;
+  };
+
+  struct ReadResult {
+    ReadResult();
+    ReadResult(ReadResult&&);
+    ReadResult& operator=(ReadResult&&);
+    ~ReadResult();
+
+    State state = State::kEmpty;
+    std::vector<std::unique_ptr<sessions::SessionWindow>> windows;
+  };
+
+  static ReadResult Read(const base::FilePath& profile_path);
+
+  void OnRead(ReadResult result);
+  void SetAll(bool checked);
+  void UpdateControls();
+  size_t SelectedCount() const;
+  // Reopens the selected tabs. Returns false, keeping the dialog open, when
+  // nothing is selected or the owner closed.
+  bool Restore();
+
+  base::WeakPtr<BrowserWindowInterface> browser_;
+  State state_ = State::kLoading;
+  std::vector<std::unique_ptr<sessions::SessionWindow>> windows_;
+  std::vector<Entry> entries_;
+  raw_ptr<views::Label> status_ = nullptr;
+  raw_ptr<views::ScrollView> scroll_ = nullptr;
+  raw_ptr<views::View> list_ = nullptr;
+  raw_ptr<views::MdTextButton> select_all_ = nullptr;
+  raw_ptr<views::MdTextButton> select_none_ = nullptr;
+  base::WeakPtrFactory<StainlessSessionReviewView> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_STAINLESS_SESSION_REVIEW_VIEW_H_
