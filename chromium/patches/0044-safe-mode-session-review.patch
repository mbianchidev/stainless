diff --git a/chrome/browser/ui/views/stainless_session_review_browsertest.cc b/chrome/browser/ui/views/stainless_session_review_browsertest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..e9aee49e506e74f00c1993dcb9884ef39a184bee
--- /dev/null
+++ b/chrome/browser/ui/views/stainless_session_review_browsertest.cc
@@ -0,0 +1,203 @@
+// Copyright 2026 Synctune Open
+
+#include "chrome/browser/ui/views/stainless_session_review_view.h"
+
+#include <map>
+#include <string>
+
+#include "base/files/file_enumerator.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/path_service.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/test/run_until.h"
+#include "base/threading/thread_restrictions.h"
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/browser/prefs/session_startup_pref.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/stainless_startup/startup_recovery.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/common/chrome_paths.h"
+#include "chrome/common/stainless_switches.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "ui/base/mojom/dialog_button.mojom.h"
+#include "ui/views/controls/button/checkbox.h"
+#include "ui/views/widget/widget.h"
+#include "ui/views/window/dialog_delegate.h"
+#include "url/gurl.h"
+
+namespace {
+
+GURL Page(int number) {
+  return GURL("data:text/html,<title>Synthetic page " +
+              base::NumberToString(number) + "</title>");
+}
+
+base::FilePath UserDataDir() {
+  return base::PathService::CheckedGet(chrome::DIR_USER_DATA);
+}
+
+}  // namespace
+
+// Each PRE_ launch saves an ordinary session. The launch after it starts in
+// automatic Safe Mode, which keeps that session without restoring it.
+class StainlessSessionReviewBrowserTest : public InProcessBrowserTest {
+ protected:
+  using State = StainlessSessionReviewView::State;
+
+  bool SetUpUserDataDirectory() override {
+    if (GetTestPreCount() > 0) {
+      return true;
+    }
+    return base::WriteFile(
+        UserDataDir().Append(stainless::kStartupRecoveryFileName),
+        "{\"version\":1,\"failed_startups\":" +
+            base::NumberToString(stainless::kAutomaticSafeModeThreshold) +
+            "}\n");
+  }
+
+  void SaveSession() {
+    SessionStartupPref::SetStartupPref(
+        browser()->GetProfile(), SessionStartupPref(SessionStartupPref::LAST));
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), Page(1)));
+    for (int page : {2, 3}) {
+      ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+          browser(), Page(page),
+          ui::mojom::WindowOpenDisposition::kNewForegroundTab,
+          ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    }
+    EXPECT_FALSE(stainless::IsStartupSafeMode());
+    EXPECT_FALSE(chrome::IsCommandEnabled(
+        browser(), IDC_STAINLESS_REVIEW_PREVIOUS_SESSION));
+    EXPECT_FALSE(StainlessSessionReviewView::Show(browser()));
+  }
+
+  std::map<base::FilePath, std::string> SessionFiles() {
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    std::map<base::FilePath, std::string> files;
+    base::FileEnumerator sessions(
+        browser()->GetProfile()->GetPath().AppendASCII("Sessions"),
+        /*recursive=*/false, base::FileEnumerator::FILES);
+    for (base::FilePath path = sessions.Next(); !path.empty();
+         path = sessions.Next()) {
+      std::string contents;
+      EXPECT_TRUE(base::ReadFileToString(path, &contents));
+      files[path.BaseName()] = std::move(contents);
+    }
+    return files;
+  }
+
+  StainlessSessionReviewView* OpenLoadedReview() {
+    EXPECT_TRUE(stainless::IsStartupSafeMode());
+    EXPECT_TRUE(chrome::IsCommandEnabled(
+        browser(), IDC_STAINLESS_REVIEW_PREVIOUS_SESSION));
+    StainlessSessionReviewView* review =
+        StainlessSessionReviewView::Show(browser());
+    EXPECT_TRUE(review);
+    if (review) {
+      EXPECT_TRUE(base::test::RunUntil(
+          [&] { return review->state_ != State::kLoading; }));
+    }
+    return review;
+  }
+
+  static State GetState(StainlessSessionReviewView* review) {
+    return review->state_;
+  }
+
+  static std::vector<views::Checkbox*> Checkboxes(
+      StainlessSessionReviewView* review) {
+    std::vector<views::Checkbox*> boxes;
+    for (const auto& entry : review->entries_) {
+      boxes.push_back(entry.checkbox.get());
+    }
+    return boxes;
+  }
+
+  static void SetAll(StainlessSessionReviewView* review, bool checked) {
+    review->SetAll(checked);
+  }
+
+  static bool Restore(StainlessSessionReviewView* review) {
+    return review->Restore();
+  }
+
+  static views::DialogDelegate* Dialog(StainlessSessionReviewView* review) {
+    return review->GetWidget()->widget_delegate()->AsDialogDelegate();
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(StainlessSessionReviewBrowserTest,
+                       PRE_ReopensOnlySelectedTabs) {
+  SaveSession();
+}
+
+IN_PROC_BROWSER_TEST_F(StainlessSessionReviewBrowserTest,
+                       ReopensOnlySelectedTabs) {
+  // Safe Mode kept the previous session but did not restore it.
+  EXPECT_EQ(1, browser()->GetTabStripModel()->count());
+  const auto before = SessionFiles();
+  ASSERT_FALSE(before.empty());
+
+  StainlessSessionReviewView* review = OpenLoadedReview();
+  ASSERT_TRUE(review);
+  EXPECT_EQ(State::kReady, GetState(review));
+  std::vector<views::Checkbox*> boxes = Checkboxes(review);
+  ASSERT_EQ(3u, boxes.size());
+  for (int i = 0; i < 3; ++i) {
+    EXPECT_EQ(u"Synthetic page " + base::NumberToString16(i + 1),
+              boxes[i]->GetText());
+    EXPECT_TRUE(boxes[i]->GetChecked());
+  }
+  EXPECT_TRUE(Dialog(review)->IsDialogButtonEnabled(
+      ui::mojom::DialogButton::kOk));
+  boxes[1]->SetChecked(false);
+
+  ui_test_utils::BrowserCreatedObserver created;
+  Dialog(review)->AcceptDialog();
+  BrowserWindowInterface* restored = created.Wait();
+  ASSERT_TRUE(restored);
+  TabStripModel* tabs = restored->GetTabStripModel();
+  ASSERT_EQ(2, tabs->count());
+  EXPECT_EQ(Page(1), tabs->GetWebContentsAt(0)->GetVisibleURL());
+  EXPECT_EQ(Page(3), tabs->GetWebContentsAt(1)->GetVisibleURL());
+  // The Safe Mode window is unchanged and no session file was rewritten.
+  EXPECT_EQ(1, browser()->GetTabStripModel()->count());
+  EXPECT_EQ(before, SessionFiles());
+}
+
+IN_PROC_BROWSER_TEST_F(StainlessSessionReviewBrowserTest,
+                       PRE_NothingSelectedReopensNothing) {
+  SaveSession();
+}
+
+IN_PROC_BROWSER_TEST_F(StainlessSessionReviewBrowserTest,
+                       NothingSelectedReopensNothing) {
+  StainlessSessionReviewView* review = OpenLoadedReview();
+  ASSERT_TRUE(review);
+  ASSERT_EQ(3u, Checkboxes(review).size());
+  SetAll(review, false);
+  EXPECT_FALSE(Dialog(review)->IsDialogButtonEnabled(
+      ui::mojom::DialogButton::kOk));
+  EXPECT_FALSE(Restore(review));
+  SetAll(review, true);
+  EXPECT_TRUE(Dialog(review)->IsDialogButtonEnabled(
+      ui::mojom::DialogButton::kOk));
+  Dialog(review)->CancelDialog();
+  EXPECT_EQ(1, browser()->GetTabStripModel()->count());
+}
+
+IN_PROC_BROWSER_TEST_F(StainlessSessionReviewBrowserTest,
+                       WithoutPreviousSessionShowsNothingToReopen) {
+  StainlessSessionReviewView* review = OpenLoadedReview();
+  ASSERT_TRUE(review);
+  EXPECT_EQ(State::kEmpty, GetState(review));
+  EXPECT_TRUE(Checkboxes(review).empty());
+  EXPECT_FALSE(Dialog(review)->IsDialogButtonEnabled(
+      ui::mojom::DialogButton::kOk));
+}
