+std::u16string ReplaceShortcuts(Profile* profile,
+                                const ShortcutOverrides& overrides,
+                                const base::DictValue& expected) {
+  auto error = ValidateShortcutOverrides(profile, overrides);
+  if (!error.empty()) {
+    return ReportRejected(std::move(error));
+  }
+  auto current = ReadShortcutOverrides(profile);
+  if (!current.has_value()) {
+    return ReportRejected(current.error());
+  }
+  if (profile->GetPrefs()->GetDict(kKeyboardShortcutsPref) != expected) {
+    return ReportRejected(
+        l10n_util::GetStringUTF16(IDS_STAINLESS_KEYMAP_STALE));
+  }
+  base::DictValue values;
+  for (const auto& [command, key] : overrides) {
+    auto action = std::ranges::find(kShortcutActions, command,
+                                    &BrowserAction::command_id);
+    values.Set(action->pref_key,
+               base::DictValue()
+                   .Set("key", static_cast<int>(key.key_code()))
+                   .Set("modifiers", key.modifiers()));
+  }
+  profile->GetPrefs()->SetDict(kKeyboardShortcutsPref, std::move(values));
+  profile->GetPrefs()->CommitPendingWrite();
+  return {};
+}
