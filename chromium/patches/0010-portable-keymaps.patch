+void StainlessShortcutEditorView::ChooseKeymapFile(bool importing) {
+  if (file_busy_ || keymap_preview_) {
+    return;
+  }
+  if (!browser_ || !chrome::CanExecuteStainlessBrowserAction(
+                       browser_, IDC_SHOW_COMMAND_PALETTE)) {
