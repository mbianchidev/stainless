+  ASSERT_TRUE(HasKeymapPreview(editor));
+  EXPECT_EQ(original, prefs->GetDict(stainless::kKeyboardShortcutsPref));
+  EXPECT_EQ(l10n_util::GetStringUTF16(IDS_STAINLESS_KEYMAP_KEEP),
+            KeymapRow(editor, IDC_FIND));
+  EXPECT_NE(std::u16string::npos,
+            KeymapRow(editor, IDC_SHOW_COMMAND_PALETTE).find(u"Unbound"));
+  EXPECT_NE(
+      std::u16string::npos,
+      KeymapRow(editor, IDC_SHOW_DOWNLOADS).find(u"Default (all aliases)"));
+  auto* cancel = KeymapButton(editor, IDS_STAINLESS_KEYMAP_CANCEL);
+  gfx::Rect cancel_bounds = views::View::ConvertRectToTarget(
+      cancel, editor, cancel->GetLocalBounds());
+  EXPECT_TRUE(editor->GetLocalBounds().Contains(cancel_bounds));
+  Press(KeymapButton(editor, IDS_STAINLESS_KEYMAP_CANCEL));
+  EXPECT_FALSE(HasKeymapPreview(editor));
+  EXPECT_EQ(original, prefs->GetDict(stainless::kKeyboardShortcutsPref));
+  Choose(editor, IDS_STAINLESS_KEYMAP_IMPORT, Fixture(kImport));
+  int notifications = 0;
+  PrefChangeRegistrar registrar;
