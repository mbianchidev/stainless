+      R"(["stainless-keymap",1,[["new_tab","custom",75,22]]])";
+  boundary.resize(65536, ' ');
+  {
+    base::ScopedAllowBlockingForTesting blocking;
+    auto bytes = stainless::ReadShortcutKeymapFile(Fixture(boundary));
+    ASSERT_TRUE(bytes.has_value());
+    EXPECT_TRUE(
+        stainless::PreviewShortcutKeymap(browser(), *bytes).has_value());
+  }
+  boundary.push_back(' ');
+  EXPECT_FALSE(
+      stainless::PreviewShortcutKeymap(browser(), boundary).has_value());
+  auto* editor = Open(browser());
+  ASSERT_TRUE(editor);
+  Choose(editor, IDS_STAINLESS_KEYMAP_IMPORT, Fixture(boundary));
+  EXPECT_FALSE(HasKeymapPreview(editor));
+  EXPECT_EQ(l10n_util::GetStringUTF16(IDS_STAINLESS_KEYMAP_TOO_LARGE),
+            KeymapStatus(editor));
+  Choose(editor, IDS_STAINLESS_KEYMAP_IMPORT,
+         Fixture(R"(["stainless-keymap",9,[["new_tab","default"]]])"));
+  EXPECT_EQ(l10n_util::GetStringUTF16(IDS_STAINLESS_KEYMAP_VERSION),
+            KeymapStatus(editor));
+  EXPECT_EQ(original, prefs->GetDict(stainless::kKeyboardShortcutsPref));
+  Close(editor);
+}
