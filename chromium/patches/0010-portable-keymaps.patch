+  registrar.Add(
+      stainless::kKeyboardShortcutsPref,
+      base::BindRepeating(
+          [](int* notifications, Profile* profile) {
+            ++*notifications;
+            EXPECT_EQ(ui::Accelerator(ui::VKEY_K, kCustomModifiers),
