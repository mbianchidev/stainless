+class StainlessKeymapBrowserTest : public StainlessShortcutEditorBrowserTest {
+ public:
+  void SetUpOnMainThread() override {
+    StainlessShortcutEditorBrowserTest::SetUpOnMainThread();
+    ASSERT_TRUE(files_.CreateUniqueTempDir());
+    ui::SelectFileDialog::SetFactory(
+        std::make_unique<KeymapFileDialogFactory>(&picker_));
+  }
+
+  void TearDownOnMainThread() override {
+    ui::SelectFileDialog::SetFactory(nullptr);
+    picker_.dialog.reset();
+    StainlessShortcutEditorBrowserTest::TearDownOnMainThread();
+  }
+
+  base::FilePath Fixture(std::string_view data) {
+    base::ScopedAllowBlockingForTesting blocking;
+    auto path = files_.GetPath().AppendASCII("Orion-keymap.json");
+    EXPECT_TRUE(base::WriteFile(path, data));
+    return path;
+  }
+
+  std::string Read(const base::FilePath& path) {
+    base::ScopedAllowBlockingForTesting blocking;
+    std::string data;
+    EXPECT_TRUE(base::ReadFileToString(path, &data));
+    return data;
+  }
+
+  void Choose(StainlessShortcutEditorView* editor,
+              int button,
+              std::optional<base::FilePath> path) {
+    picker_.type = ui::SelectFileDialog::SELECT_NONE;
+    Press(KeymapButton(editor, button));
+    ASSERT_EQ(button == IDS_STAINLESS_KEYMAP_IMPORT
+                  ? ui::SelectFileDialog::SELECT_OPEN_FILE
+                  : ui::SelectFileDialog::SELECT_SAVEAS_FILE,
+              picker_.type);
+    EXPECT_EQ(editor->GetWidget()->GetNativeWindow(), picker_.owner);
+    if (button == IDS_STAINLESS_KEYMAP_EXPORT) {
+      EXPECT_EQ(base::FilePath("Stainless-keymap.json"), picker_.suggested);
+    }
+    picker_.dialog->Complete(path);
+    ASSERT_TRUE(WaitForKeymapFile(editor));
+  }
+
+  void Approve(StainlessShortcutEditorView* editor) {
+    ASSERT_TRUE(KeymapButton(editor, IDS_STAINLESS_KEYMAP_APPLY)->GetEnabled())
+        << base::UTF16ToUTF8(KeymapStatus(editor));
+    Press(KeymapButton(editor, IDS_STAINLESS_KEYMAP_APPLY));
+  }
+
+  void ImportThroughEditor(BrowserWindowInterface* owner,
+                           std::string_view data) {
+    auto* editor = Open(owner);
+    ASSERT_TRUE(editor);
+    Choose(editor, IDS_STAINLESS_KEYMAP_IMPORT, Fixture(data));
+    ASSERT_TRUE(HasKeymapPreview(editor));
+    Approve(editor);
+    Close(editor);
+  }
+
+  base::ListValue ExportedRow(std::string_view data, std::string_view action) {
+    auto root = base::JSONReader::ReadList(data, base::JSON_PARSE_RFC);
+    EXPECT_TRUE(root);
+    if (!root || root->size() != 3 || !(*root)[2].is_list()) {
+      return {};
+    }
+    EXPECT_EQ("stainless-keymap", (*root)[0].GetString());
+    EXPECT_EQ(1, (*root)[1].GetInt());
+    EXPECT_EQ(20u, (*root)[2].GetList().size());
+    for (const auto& value : (*root)[2].GetList()) {
+      const auto& row = value.GetList();
+      if (row[0].GetString() == action) {
+        return row.Clone();
+      }
+    }
+    ADD_FAILURE() << "Missing exported action " << action;
+    return {};
+  }
+
+ protected:
+  base::ScopedTempDir files_;
+  PickerState picker_;
+};
