+struct PickerState {
+  scoped_refptr<KeymapFileDialog> dialog;
+  ui::SelectFileDialog::Type type = ui::SelectFileDialog::SELECT_NONE;
+  base::FilePath suggested;
+  gfx::NativeWindow owner;
+};
+
+class KeymapFileDialog final : public ui::SelectFileDialog {
+ public:
+  KeymapFileDialog(Listener* listener,
+                   std::unique_ptr<ui::SelectFilePolicy> policy,
+                   PickerState* state)
+      : SelectFileDialog(listener, std::move(policy)), state_(state) {}
+
+  void Complete(std::optional<base::FilePath> path) {
+    if (listener_) {
+      if (path) {
+        listener_->FileSelected(ui::SelectedFileInfo(*path), 1);
+      } else {
+        listener_->FileSelectionCanceled();
+      }
+    }
+  }
+
+  bool IsRunning(gfx::NativeWindow window) const override { return false; }
+  void ListenerDestroyed() override { listener_ = nullptr; }
+
+ private:
+  ~KeymapFileDialog() override = default;
+  void SelectFileImpl(Type type,
+                      const std::u16string& title,
+                      const base::FilePath& default_path,
+                      const FileTypeInfo* file_types,
+                      int file_type_index,
+                      const base::FilePath::StringType& default_extension,
+                      gfx::NativeWindow owning_window,
+                      const GURL* caller) override {
+    state_->type = type;
+    state_->suggested = default_path;
+    state_->owner = owning_window;
+    EXPECT_EQ(FileTypeInfo::NATIVE_PATH, file_types->allowed_paths);
+    EXPECT_FALSE(file_types->include_all_files);
+  }
+  bool HasMultipleFileTypeChoicesImpl() override { return false; }
+  raw_ptr<PickerState> state_;
+};
+
+class KeymapFileDialogFactory final : public ui::SelectFileDialogFactory {
+ public:
+  explicit KeymapFileDialogFactory(PickerState* state) : state_(state) {}
+
+  ui::SelectFileDialog* Create(
+      ui::SelectFileDialog::Listener* listener,
+      std::unique_ptr<ui::SelectFilePolicy> policy) override {
+    state_->dialog = new KeymapFileDialog(listener, std::move(policy), state_);
+    return state_->dialog.get();
+  }
+
+ private:
+  raw_ptr<PickerState> state_;
+};
+
+constexpr char kImport[] =
+    R"(["stainless-keymap",1,[["new_tab","custom",75,22],)"
+    R"(["command_palette","unbound"],["downloads","default"],)"
+    R"(["duplicate_tab","unbound"]]])";
+
+}  // namespace
