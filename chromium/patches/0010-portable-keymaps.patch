+class StainlessShortcutEditorBrowserTest : public InProcessBrowserTest {
+ public:
+  void SetUpCommandLine(base::CommandLine* command) override;
+  void SetUpOnMainThread() override;
+
+  actions::ActionItem* Action(BrowserWindowInterface* browser, int command) {
+    return actions::ActionManager::Get().FindAction(
+        *chrome::GetActionIdForCommandId(command),
+        BrowserActions::From(browser)->root_action_item());
+  }
+
+  StainlessShortcutEditorView* Editor(BrowserWindowInterface* owner) {
+    return StainlessShortcutEditorView::Get(owner->GetUnownedUserDataHost());
+  }
+
+  StainlessShortcutEditorView* Open(BrowserWindowInterface* owner) {
+    if (!Editor(owner)) {
+      [NativeWindow(owner) makeMainWindow];
+      [NativeWindow(owner) makeKeyWindow];
+      base::RunLoop().RunUntilIdle();
+    }
+    EXPECT_TRUE(chrome::ExecuteCommand(owner, IDC_EDIT_KEYBOARD_SHORTCUTS));
+    auto* editor = Editor(owner);
+    if (editor) {
+      NSWindow* window =
+          editor->GetWidget()->GetNativeWindow().GetNativeNSWindow();
+      [window makeMainWindow];
+      [window makeKeyWindow];
+      EXPECT_TRUE(base::test::RunUntil([&] {
+        return editor->GetWidget()
+            ->GetNativeWindow()
+            .GetNativeNSWindow()
+            .visible;
+      }));
+    }
+    return editor;
+  }
+
+  void Select(StainlessShortcutEditorView* editor, int command) {
+    auto it = std::ranges::find(stainless::kShortcutActions, command,
+                                &stainless::BrowserAction::command_id);
+    ASSERT_NE(it, stainless::kShortcutActions.end());
+    editor->table_->Select(it - stainless::kShortcutActions.begin());
+  }
+
+  void Press(views::View* control) {
+    control->RequestFocus();
+    control->OnKeyPressed(
+        ui::KeyEvent(ui::EventType::kKeyPressed, ui::VKEY_SPACE, 0));
+    control->OnKeyReleased(
+        ui::KeyEvent(ui::EventType::kKeyReleased, ui::VKEY_SPACE, 0));
+    base::RunLoop().RunUntilIdle();
+  }
+
+  bool Record(StainlessShortcutEditorView* editor,
+              int command,
+              ui::KeyboardCode key,
+              int modifiers = kCustomModifiers) {
+    Select(editor, command);
+    Press(editor->record_);
+    EXPECT_EQ(editor->capture_, editor->GetFocusManager()->GetFocusedView());
+    NSWindow* window =
+        editor->GetWidget()->GetNativeWindow().GetNativeNSWindow();
+    NSEvent* event = NativeKey(window, key, modifiers);
+    EXPECT_EQ(NO_COMMAND, CommandForKeyEvent(event).chrome_command);
+    views::ViewTracker lifetime;
+    lifetime.SetView(editor);
+    if (!EventUsesPerformKeyEquivalent(event) ||
+        ![window performKeyEquivalent:event]) {
+      [window sendEvent:event];
+    }
+    bool processed = base::test::RunUntil([&] {
+      return !lifetime.view() || !editor->recording_ ||
+             editor->status_->GetText() !=
+                 l10n_util::GetStringUTF16(IDS_STAINLESS_SHORTCUT_RECORDING);
+    });
+    return processed && lifetime.view();
+  }
+
+  void Apply(StainlessShortcutEditorView* editor) {
+    ASSERT_TRUE(editor->apply_->GetEnabled())
+        << base::UTF16ToUTF8(editor->status_->GetText());
+    Press(editor->apply_);
+  }
+
+  void SetThroughEditor(BrowserWindowInterface* owner,
+                        int command,
+                        ui::KeyboardCode key) {
+    auto* editor = Open(owner);
+    ASSERT_TRUE(editor);
+    ASSERT_TRUE(Record(editor, command, key));
+    Apply(editor);
+    EXPECT_EQ(ui::Accelerator(key, kCustomModifiers),
+              stainless::ShortcutForCommand(owner->GetProfile(), command));
+    Close(editor);
+  }
+
+  void Close(StainlessShortcutEditorView* editor) {
+    auto* browser = editor->browser_.get();
+    NSWindow* window =
+        editor->GetWidget()->GetNativeWindow().GetNativeNSWindow();
+    editor->GetWidget()->Close();
+    ASSERT_TRUE(base::test::RunUntil([&] {
+      return !Editor(browser) && !window.visible &&
+             NativeWindow(browser).attachedSheet != window;
+    })) << "registered="
+        << (Editor(browser) != nullptr) << " visible=" << window.visible
+        << " attached=" << (NativeWindow(browser).attachedSheet == window);
+    base::RunLoop().RunUntilIdle();
+  }
+
+  void RestoreThroughEditor(int command) {
+    auto* editor = Open(browser());
+    ASSERT_TRUE(editor);
+    Select(editor, command);
+    Press(editor->use_default_);
+    Apply(editor);
+    Close(editor);
+  }
+
+  bool Dispatch(BrowserWindowInterface* owner,
+                ui::KeyboardCode key,
+                int modifiers = kCustomModifiers) {
+    NSWindow* window = NativeWindow(owner);
+    NSEvent* event = NativeKey(window, key, modifiers);
+    ChromeCommandDispatcherDelegate* dispatcher =
+        [[ChromeCommandDispatcherDelegate alloc] init];
+    auto result = [dispatcher prePerformKeyEquivalent:event window:window];
+    if (result == ui::PerformKeyEquivalentResult::kUnhandled) {
+      result = [dispatcher postPerformKeyEquivalent:event
+                                             window:window
+                                       isRedispatch:YES];
+    }
+    if (result == ui::PerformKeyEquivalentResult::kPassToMainMenu) {
+      return [NSApp.mainMenu performKeyEquivalent:event];
+    }
+    base::RunLoop().RunUntilIdle();
+    return result == ui::PerformKeyEquivalentResult::kHandled;
+  }
+
+  base::DictValue Binding(ui::KeyboardCode key,
+                          int modifiers = kCustomModifiers) {
+    return base::DictValue()
+        .Set("key", static_cast<int>(key))
+        .Set("modifiers", modifiers);
+  }
+
+  views::MdTextButton* KeymapButton(StainlessShortcutEditorView* editor,
+                                    int message) {
+    switch (message) {
+      case IDS_STAINLESS_KEYMAP_IMPORT:
+        return editor->import_;
+      case IDS_STAINLESS_KEYMAP_EXPORT:
+        return editor->export_;
+      case IDS_STAINLESS_KEYMAP_APPLY:
+        return editor->apply_import_;
+      case IDS_STAINLESS_KEYMAP_CANCEL:
+        return editor->cancel_import_;
+    }
+    return nullptr;
+  }
+
+  bool WaitForKeymapFile(StainlessShortcutEditorView* editor) {
+    return base::test::RunUntil([&] { return !editor->file_busy_; });
+  }
+
+  bool HasKeymapPreview(StainlessShortcutEditorView* editor) {
+    return editor->keymap_preview_.has_value();
+  }
+
+  std::u16string KeymapStatus(StainlessShortcutEditorView* editor) {
+    return std::u16string(editor->status_->GetText());
+  }
+
+  std::u16string KeymapRow(StainlessShortcutEditorView* editor, int command) {
+    auto it = std::ranges::find(stainless::kShortcutActions, command,
+                                &stainless::BrowserAction::command_id);
+    return editor->GetText(it - stainless::kShortcutActions.begin(),
+                           IDS_STAINLESS_KEYMAP_AFTER);
+  }
+};
+
