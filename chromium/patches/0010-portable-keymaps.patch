+          R"(["stainless-keymap",1,[["new_tab","default"],["find","unbound"]]])"));
+  late_conflict.keyEquivalent = @"t";
+  late_conflict.keyEquivalentModifierMask = NSEventModifierFlagCommand;
+  [NSApp.mainMenu addItem:late_conflict];
+  Press(KeymapButton(editor, IDS_STAINLESS_KEYMAP_APPLY));
+  EXPECT_EQ(changed, prefs->GetDict(stainless::kKeyboardShortcutsPref));
+  [NSApp.mainMenu removeItem:late_conflict];
+  Press(KeymapButton(editor, IDS_STAINLESS_KEYMAP_CANCEL));
+  Choose(
+      editor, IDS_STAINLESS_KEYMAP_IMPORT,
+      Fixture(
+          R"(["stainless-keymap",1,[["new_tab","custom",74,22],["find","custom",75,22]]])"));
