+namespace stainless {
+
+namespace {
+
+constexpr char kFormat[] = "stainless-keymap";
+constexpr int kVersion = 1;
+
+std::u16string Error(int message) {
+  return l10n_util::GetStringUTF16(message);
+}
+
+bool EligibleOwner(BrowserWindowInterface* browser) {
+  return chrome::CanExecuteStainlessBrowserAction(browser,
+                                                  IDC_SHOW_COMMAND_PALETTE);
+}
+
+}  // namespace
+
+KeymapData ExportShortcutKeymap(Profile* profile) {
+  auto overrides = ReadShortcutOverrides(profile);
+  if (!overrides.has_value()) {
+    return base::unexpected(overrides.error());
+  }
+  base::ListValue rows;
+  for (const auto& action : kShortcutActions) {
+    base::ListValue row;
+    row.Append(std::string(action.pref_key));
+    auto it = overrides->find(action.command_id);
+    if (it == overrides->end()) {
+      row.Append("default");
+    } else if (it->second.IsEmpty()) {
+      row.Append("unbound");
+    } else {
+      row.Append("custom");
+      row.Append(static_cast<int>(it->second.key_code()));
+      row.Append(it->second.modifiers());
+    }
+    rows.Append(std::move(row));
+  }
+  base::ListValue root;
+  root.Append(kFormat);
+  root.Append(kVersion);
+  root.Append(std::move(rows));
+  std::string data;
+  if (!base::JSONWriter::WriteWithOptions(
+          root, base::JSONWriter::OPTIONS_PRETTY_PRINT, &data)) {
+    return base::unexpected(Error(IDS_STAINLESS_KEYMAP_WRITE_ERROR));
+  }
+  return data + "\n";
+}
+
+base::expected<ShortcutKeymapPreview, std::u16string> PreviewShortcutKeymap(
+    BrowserWindowInterface* browser,
+    std::string_view data) {
+  if (!EligibleOwner(browser)) {
+    return base::unexpected(Error(IDS_STAINLESS_SHORTCUT_UNAVAILABLE));
+  }
+  auto* profile = browser->GetProfile();
+  if (auto error = ShortcutEditingError(profile); !error.empty()) {
+    return base::unexpected(std::move(error));
+  }
+  auto before = ReadShortcutOverrides(profile);
+  if (!before.has_value()) {
+    return base::unexpected(before.error());
+  }
+  if (data.size() > kMaxKeymapBytes) {
+    return base::unexpected(Error(IDS_STAINLESS_KEYMAP_TOO_LARGE));
+  }
+  // Array-only records have no ambiguous duplicate JSON object keys.
+  auto root = base::JSONReader::ReadList(data, base::JSON_PARSE_RFC, 4);
+  if (!root || root->size() != 3 || !(*root)[0].is_string() ||
+      (*root)[0].GetString() != kFormat || !(*root)[1].is_int()) {
+    return base::unexpected(Error(IDS_STAINLESS_KEYMAP_INVALID));
+  }
+  if ((*root)[1].GetInt() != kVersion) {
+    return base::unexpected(Error(IDS_STAINLESS_KEYMAP_VERSION));
+  }
+  auto* rows = (*root)[2].GetIfList();
+  if (!rows || rows->empty() || rows->size() > kShortcutActions.size()) {
+    return base::unexpected(Error(IDS_STAINLESS_KEYMAP_INVALID));
+  }
+  ShortcutKeymapPreview preview;
+  preview.owner = browser->GetWeakPtr();
+  preview.original =
+      profile->GetPrefs()->GetDict(kKeyboardShortcutsPref).Clone();
+  preview.before = *before;
+  preview.after = std::move(*before);
+  for (const auto& value : *rows) {
+    const auto* row = value.GetIfList();
+    if (!row || row->size() < 2 || !(*row)[0].is_string() ||
+        !(*row)[1].is_string()) {
+      return base::unexpected(Error(IDS_STAINLESS_KEYMAP_INVALID));
+    }
+    auto action = std::ranges::find(kShortcutActions, (*row)[0].GetString(),
+                                    &BrowserAction::pref_key);
+    if (action == kShortcutActions.end() ||
+        preview.changes.contains(action->command_id)) {
+      return base::unexpected(Error(IDS_STAINLESS_KEYMAP_INVALID));
+    }
+    const int command = action->command_id;
+    const auto& state = (*row)[1].GetString();
+    if (state == "default" && row->size() == 2) {
+      preview.changes.emplace(command, std::nullopt);
+      preview.after.erase(command);
+    } else if (state == "unbound" && row->size() == 2) {
+      preview.changes.emplace(command, ui::Accelerator());
+      preview.after[command] = ui::Accelerator();
+    } else if (state == "custom" && row->size() == 4 && (*row)[2].is_int() &&
+               (*row)[3].is_int()) {
+      auto key = ParseShortcutBinding(
+          command, base::DictValue()
+                       .Set("key", (*row)[2].GetInt())
+                       .Set("modifiers", (*row)[3].GetInt()));
+      if (!key.has_value() || key->IsEmpty()) {
+        return base::unexpected(key.has_value()
+                                    ? Error(IDS_STAINLESS_KEYMAP_INVALID)
+                                    : key.error());
+      }
+      preview.changes.emplace(command, *key);
+      preview.after[command] = *key;
+    } else {
+      return base::unexpected(Error(IDS_STAINLESS_KEYMAP_INVALID));
+    }
+  }
+  return preview;
+}
+
+std::u16string ValidateShortcutKeymap(const ShortcutKeymapPreview& preview) {
+  auto* browser = preview.owner.get();
+  if (!EligibleOwner(browser)) {
+    return Error(IDS_STAINLESS_SHORTCUT_UNAVAILABLE);
+  }
+  auto* profile = browser->GetProfile();
+  if (auto error = ShortcutEditingError(profile); !error.empty()) {
+    return error;
+  }
+  if (profile->GetPrefs()->GetDict(kKeyboardShortcutsPref) !=
+      preview.original) {
+    return Error(IDS_STAINLESS_KEYMAP_STALE);
+  }
+  if (auto error = ValidateShortcutOverrides(profile, preview.after);
+      !error.empty()) {
+    return error;
+  }
+  auto* focus =
+      BrowserView::GetBrowserViewForBrowser(browser)->GetFocusManager();
+  auto conflict = [focus](int command, const ui::Accelerator& key) {
+    if (!key.IsEmpty() && focus->HasPriorityHandler(key)) {
+      auto action = std::ranges::find(kShortcutActions, command,
+                                      &BrowserAction::command_id);
+      return base::UTF8ToUTF16(action->pref_key) + u": " +
+             Error(IDS_STAINLESS_SHORTCUT_CONFLICT);
+    }
+    return std::u16string();
+  };
+  for (const auto& [command, key] : preview.after) {
+    if (auto error = conflict(command, key); !error.empty()) {
+      return error;
+    }
+  }
+  for (const auto& [command, key] : preview.changes) {
+    if (!key) {
+      auto validation = ValidateShortcutInConfiguration(
+          profile, preview.after, command, DefaultShortcut(command));
+      if (!validation.empty()) {
+        auto action = std::ranges::find(kShortcutActions, command,
+                                        &BrowserAction::command_id);
+        return base::UTF8ToUTF16(action->pref_key) + u": " + validation;
+      }
+      if (auto error = conflict(command, DefaultShortcut(command));
+          !error.empty()) {
+        return error;
+      }
+    }
+  }
+  return {};
+}
+
+std::u16string ApplyShortcutKeymap(const ShortcutKeymapPreview& preview) {
+  if (auto error = ValidateShortcutKeymap(preview); !error.empty()) {
+    return error;
+  }
+  return ReplaceShortcuts(preview.owner->GetProfile(), preview.after,
+                          preview.original);
+}
+
+KeymapData ReadShortcutKeymapFile(const base::FilePath& path) {
+  struct stat info;
+  if (stat(path.value().c_str(), &info) != 0 || !S_ISREG(info.st_mode)) {
+    return base::unexpected(Error(IDS_STAINLESS_KEYMAP_READ_ERROR));
+  }
+  if (info.st_size > static_cast<int64_t>(kMaxKeymapBytes)) {
+    return base::unexpected(Error(IDS_STAINLESS_KEYMAP_TOO_LARGE));
+  }
+  std::string data;
+  const bool read =
+      base::ReadFileToStringWithMaxSize(path, &data, kMaxKeymapBytes + 1);
+  if (data.size() > kMaxKeymapBytes) {
+    return base::unexpected(Error(IDS_STAINLESS_KEYMAP_TOO_LARGE));
+  }
+  if (!read) {
+    return base::unexpected(Error(IDS_STAINLESS_KEYMAP_READ_ERROR));
+  }
+  return data;
+}
+
+std::u16string WriteShortcutKeymapFile(const base::FilePath& path,
+                                       std::string_view data) {
+  if (!base::ImportantFileWriter::WriteFileAtomically(path, data)) {
+    return Error(IDS_STAINLESS_KEYMAP_WRITE_ERROR);
+  }
+  return {};
+}
+
+}  // namespace stainless
