+        l10n_util::GetStringUTF16(IDS_STAINLESS_SHORTCUT_UNAVAILABLE));
+    return;
+  }
+  if (importing) {
+    auto error = stainless::ShortcutEditingError(browser_->GetProfile());
+    if (!error.empty()) {
+      ShowKeymapError(error);
+      return;
+    }
+  }
+  SetRecording(false);
+  pending_.reset();
+  confirming_reset_ = false;
+  reset_->SetText(l10n_util::GetStringUTF16(IDS_STAINLESS_SHORTCUT_RESET));
+  DetachFileDialog();
+  importing_file_ = importing;
+  file_busy_ = true;
+  Refresh();
+  ShowStatus(IDS_STAINLESS_KEYMAP_BUSY);
+  file_dialog_ = ui::SelectFileDialog::Create(
+      this, std::make_unique<ChromeSelectFilePolicy>(
+                browser_->GetTabStripModel()->GetActiveWebContents()));
+  ui::SelectFileDialog::FileTypeInfo types;
+  types.extensions = {{FILE_PATH_LITERAL("json")}};
+  types.keep_extension_visible = true;
+  file_dialog_->SelectFile(
+      importing ? ui::SelectFileDialog::SELECT_OPEN_FILE
+                : ui::SelectFileDialog::SELECT_SAVEAS_FILE,
+      l10n_util::GetStringUTF16(importing ? IDS_STAINLESS_KEYMAP_IMPORT
+                                          : IDS_STAINLESS_KEYMAP_EXPORT),
+      importing ? base::FilePath()
+                : base::FilePath(FILE_PATH_LITERAL("Stainless-keymap.json")),
+      &types, 1, FILE_PATH_LITERAL("json"), GetWidget()->GetNativeWindow());
+}
+
+void StainlessShortcutEditorView::FileSelected(const ui::SelectedFileInfo& file,
+                                               int index) {
+  if (!browser_ || !file_busy_ || GetWidget()->IsClosed()) {
+    return;
+  }
+  const auto path = file.path();
+  if (!path.IsAbsolute() || path.ReferencesParent() || file.url ||
+      file.virtual_path) {
+    file_busy_ = false;
+    Refresh();
+    ShowKeymapError(l10n_util::GetStringUTF16(
+        importing_file_ ? IDS_STAINLESS_KEYMAP_READ_ERROR
+                        : IDS_STAINLESS_KEYMAP_WRITE_ERROR));
+    return;
+  }
+  if (importing_file_) {
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+        base::BindOnce(&stainless::ReadShortcutKeymapFile, path),
+        base::BindOnce(&StainlessShortcutEditorView::KeymapRead,
+                       weak_factory_.GetWeakPtr()));
+  } else {
+    auto data = stainless::ExportShortcutKeymap(browser_->GetProfile());
+    if (!data.has_value()) {
+      KeymapWritten(data.error());
+      return;
+    }
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE,
+        {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+         base::TaskShutdownBehavior::BLOCK_SHUTDOWN},
+        base::BindOnce(
+            [](const base::FilePath& path, const std::string& data) {
+              auto error = stainless::WriteShortcutKeymapFile(path, data);
+              if (!error.empty()) {
+                LOG(ERROR) << "Stainless keymap export failed: "
+                           << base::UTF16ToUTF8(error);
+              }
+              return error;
+            },
+            path, std::move(*data)),
+        base::BindOnce(&StainlessShortcutEditorView::KeymapWritten,
+                       weak_factory_.GetWeakPtr()));
+  }
+}
+
+void StainlessShortcutEditorView::FileSelectionCanceled() {
+  file_busy_ = false;
+  Refresh();
+  ShowStatus(IDS_STAINLESS_KEYMAP_CANCELED);
+}
+
+void StainlessShortcutEditorView::KeymapRead(stainless::KeymapData data) {
+  file_busy_ = false;
+  if (!browser_ || GetWidget()->IsClosed()) {
+    return;
+  }
+  if (!data.has_value()) {
+    Refresh();
+    ShowKeymapError(data.error());
+    return;
+  }
+  auto preview = stainless::PreviewShortcutKeymap(browser_, *data);
+  if (!preview.has_value()) {
+    Refresh();
+    ShowKeymapError(preview.error());
+    return;
+  }
+  keymap_preview_ = std::move(*preview);
+  Refresh();
+  table_->RequestFocus();
+}
+
+void StainlessShortcutEditorView::KeymapWritten(std::u16string error) {
+  file_busy_ = false;
+  Refresh();
+  if (error.empty()) {
+    ShowStatus(IDS_STAINLESS_KEYMAP_EXPORTED);
+  } else {
+    ShowKeymapError(error);
+  }
+}
+
+void StainlessShortcutEditorView::ApplyKeymap() {
+  if (!keymap_preview_) {
+    return;
+  }
+  auto error = stainless::ApplyShortcutKeymap(*keymap_preview_);
+  if (!error.empty()) {
+    Refresh();
+    ShowKeymapError(error);
+    return;
+  }
+  keymap_preview_.reset();
+  Refresh();
+  ShowStatus(browser_->GetProfile()->IsOffTheRecord()
+                 ? IDS_STAINLESS_SHORTCUT_PRIVATE_APPLIED
+                 : IDS_STAINLESS_SHORTCUT_APPLIED);
+  import_->RequestFocus();
+}
+
+void StainlessShortcutEditorView::CancelKeymap() {
+  keymap_preview_.reset();
+  Refresh();
+  ShowStatus(IDS_STAINLESS_KEYMAP_CANCELED);
+  import_->RequestFocus();
+}
+
+void StainlessShortcutEditorView::ShowKeymapError(const std::u16string& error) {
+  LOG(WARNING) << "Stainless keymap operation rejected: "
+               << base::UTF16ToUTF8(error);
+  status_->SetText(error);
+}
+
+void StainlessShortcutEditorView::DetachFileDialog() {
+  if (file_dialog_) {
+    file_dialog_->ListenerDestroyed();
+    file_dialog_.reset();
+  }
+}
