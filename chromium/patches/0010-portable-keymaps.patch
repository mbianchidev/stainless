+IN_PROC_BROWSER_TEST_F(StainlessKeymapBrowserTest,
+                       NativeRoundTripRequiresPreviewAndExplicitApproval) {
+  SetThroughEditor(browser(), IDC_FIND, ui::VKEY_J);
