+  EXPECT_EQ(base::ListValue().Append("command_palette").Append("unbound"),
+            ExportedRow(data, "command_palette"));
+  EXPECT_EQ(base::ListValue().Append("duplicate_tab").Append("unbound"),
+            ExportedRow(data, "duplicate_tab"));
+  EXPECT_EQ(base::ListValue().Append("settings").Append("default"),
+            ExportedRow(data, "settings"));
+  EXPECT_EQ(std::string::npos,
