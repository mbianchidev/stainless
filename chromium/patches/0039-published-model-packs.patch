+// Resolves only the reviewed release hosts through real DNS, so the published
+// asset is reachable while every other host stays on loopback.
+class StainlessLocalModelsLiveBrowserTest
+    : public StainlessLocalModelsBrowserTest {
+ public:
+  void SetUpOnMainThread() override {
+    host_resolver()->ClearRules();
+    for (const char* host :
+         {"github.com", "release-assets.githubusercontent.com",
+          "objects.githubusercontent.com"}) {
+      host_resolver()->AllowDirectLookup(host);
+    }
+    host_resolver()->AddRule("*", "127.0.0.1");
+    StainlessLocalModelsBrowserTest::SetUpOnMainThread();
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(StainlessLocalModelsLiveBrowserTest,
+                       MANUAL_PublishedReleaseAssetInstallsThenWorksOffline) {
+  base::test::ScopedRunLoopTimeout deadline(FROM_HERE, base::Minutes(2));
+  base::ScopedAllowBlockingForTesting allow_blocking;
+  auto* models = LocalModels::Get(browser()->GetProfile());
+  ASSERT_TRUE(models);
+  ASSERT_TRUE(models->ConfigureFeature("ocr", true, true).has_value());
+  const auto& pack = OcrPack();
+  const GURL target(pack.url);
+  ASSERT_EQ("github.com", target.host());
+  std::atomic<int> requests = 0;
+  std::atomic<int> offline_requests = 0;
+  std::atomic<bool> offline = false;
+  content::URLLoaderInterceptor observer(base::BindLambdaForTesting(
+      [&](content::URLLoaderInterceptor::RequestParams* request) {
+        const auto& url = request->url_request.url;
+        if (offline && (url.SchemeIsHTTPOrHTTPS() || url.SchemeIsWSOrWSS())) {
+          ++offline_requests;
+          request->client->OnComplete(network::URLLoaderCompletionStatus(
+              net::ERR_INTERNET_DISCONNECTED));
+          return true;
+        }
+        if (url == target) {
+          ++requests;
+          EXPECT_EQ(network::mojom::CredentialsMode::kOmit,
+                    request->url_request.credentials_mode);
+          EXPECT_TRUE(request->url_request.referrer.is_empty());
+          EXPECT_FALSE(request->url_request.headers.HasHeader("Cookie"));
+          EXPECT_TRUE(request->url_request.load_flags &
+                      net::LOAD_DISABLE_CACHE);
+        }
+        return false;
+      }));
+  ASSERT_NO_FATAL_FAILURE(InstallThroughSettings(models, pack));
   EXPECT_EQ(1, requests.load());
+  offline = true;
   base::test::TestFuture<base::expected<model_storage::Acquired, std::string>>
       acquired;
   models->AcquirePack(pack.id, Feature::kOcr, acquired.GetCallback());
   ASSERT_TRUE(acquired.Get().has_value()) << acquired.Get().error();
   EXPECT_FALSE(acquired.Get()->files.empty());
   EXPECT_EQ(1, requests.load());
+  EXPECT_EQ(0, offline_requests.load());
 }
 
