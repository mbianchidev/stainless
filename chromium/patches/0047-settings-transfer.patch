+      layout->GetDistanceMetric(views::DISTANCE_RELATED_BUTTON_HORIZONTAL)));
+  export_ = controls->AddChildView(std::make_unique<views::MdTextButton>(
+      base::BindRepeating(&StainlessSettingsTransferView::ChooseFile,
+                          base::Unretained(this), false),
+      Text(IDS_STAINLESS_SETTINGS_EXPORT)));
