+std::u16string StainlessSettingsTransferView::GetTooltip(size_t row) const {
+  if (!preview_ || row >= preview_->rows.size()) {
+    return std::u16string();
+  }
+  const stainless::SettingsTransferRow& setting = preview_->rows[row];
+  return l10n_util::GetStringFUTF16(
+      IDS_STAINLESS_SETTINGS_ROW_TOOLTIP,
+      stainless::SettingsTransferLabel(setting.id),
+      stainless::SettingsTransferValueLabel(setting.id, setting.current),
+      stainless::SettingsTransferValueLabel(setting.id, setting.proposed));
+}
