+  raw_ptr<views::MdTextButton> export_ = nullptr;
+  raw_ptr<views::MdTextButton> import_ = nullptr;
+  raw_ptr<views::Label> status_ = nullptr;
+  raw_ptr<views::TableView> table_ = nullptr;
+  raw_ptr<views::ScrollView> table_scroll_ = nullptr;
+  raw_ptr<views::MdTextButton> apply_ = nullptr;
+  raw_ptr<views::MdTextButton> cancel_ = nullptr;
+  raw_ptr<ui::TableModelObserver> model_observer_ = nullptr;
+  base::WeakPtrFactory<StainlessSettingsTransferView> weak_factory_{this};
+};
