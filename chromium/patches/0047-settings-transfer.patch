+IN_PROC_BROWSER_TEST_F(StainlessSettingsTransferBrowserTest,
+                       StrictParsingRejectsMalformedFiles) {
+  for (const char* data : {
+           R"([])",
+           R"({"stainless-settings":1})",
+           R"(["stainless-settings",2,[["spell_check",true]]])",
+           R"(["stainless-settings",1.0,[["spell_check",true]]])",
+           R"(["stainless-keymap",1,[["spell_check",true]]])",
+           R"(["stainless-settings",1,[]])",
+           R"(["stainless-settings",1,[["spell_check",true]],"extra"])",
+           R"(["stainless-settings",1,[["spell_check",true],)"
+           R"(["spell_check",false]]])",
+           R"(["stainless-settings",1,[["homepage","https://example.test/"]]])",
+           R"(["stainless-settings",1,[["spell_check","true"]]])",
+           R"(["stainless-settings",1,[["spell_check",true,1]]])",
+           R"(["stainless-settings",1,[["default_font_size",8]]])",
+           R"(["stainless-settings",1,[["default_font_size",20.5]]])",
+           R"(["stainless-settings",1,[["restore_on_startup","urls"]]])",
+           R"(["stainless-settings",1,[["spell_check",true],]])",
+           "[\"stainless-settings\",1,[[\"spell_check\",true]]] // note",
+       }) {
+    SCOPED_TRACE(data);
+    EXPECT_FALSE(stainless::PreviewSettings(browser(), data).has_value());
+  }
+  const std::string too_large(stainless::kMaxSettingsTransferBytes + 1, ' ');
+  EXPECT_FALSE(stainless::PreviewSettings(browser(), too_large).has_value());
+  ExpectUntouched();
+}
