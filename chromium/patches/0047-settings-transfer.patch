+// Copyright 2026 Synctune Open
+
+#ifndef CHROME_BROWSER_UI_VIEWS_STAINLESS_SETTINGS_TRANSFER_H_
+#define CHROME_BROWSER_UI_VIEWS_STAINLESS_SETTINGS_TRANSFER_H_
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/memory/weak_ptr.h"
+#include "base/types/expected.h"
+#include "base/values.h"
+
+class BrowserWindowInterface;
+class Profile;
+
+namespace stainless {
+
+// Version 1 settings files: ["stainless-settings", 1, [[id, value], ...]].
+inline constexpr char kSettingsTransferFormat[] = "stainless-settings";
+inline constexpr int kSettingsTransferVersion = 1;
+inline constexpr size_t kMaxSettingsTransferBytes = 16 * 1024;
+
+struct SettingsTransferRow {
+  SettingsTransferRow();
+  SettingsTransferRow(const SettingsTransferRow&);
+  SettingsTransferRow& operator=(const SettingsTransferRow&);
+  ~SettingsTransferRow();
+
+  std::string id;
+  // Transfer representations: a boolean, an enum name or an integer.
+  base::Value current;
+  base::Value proposed;
+  // Policy, an extension or the browser fixes this setting.
+  bool locked = false;
+
+  bool Changes() const { return current != proposed; }
+};
+
+struct SettingsTransferPreview {
+  SettingsTransferPreview();
+  SettingsTransferPreview(SettingsTransferPreview&&);
+  SettingsTransferPreview& operator=(SettingsTransferPreview&&);
+  ~SettingsTransferPreview();
+
+  base::WeakPtr<BrowserWindowInterface> owner;
+  // The settings listed in the file, in the allowlist's order.
+  std::vector<SettingsTransferRow> rows;
+
+  bool Applicable() const;
+  size_t ChangeCount() const;
+};
+
+using SettingsTransferData = base::expected<std::string, std::u16string>;
+
+// The supported setting identifiers, in display order.
+std::vector<std::string> SettingsTransferIds();
+
+// Localized name of a setting and of one of its transfer values.
+std::u16string SettingsTransferLabel(std::string_view id);
+std::u16string SettingsTransferValueLabel(std::string_view id,
+                                          const base::Value& value);
+
+// Empty when `profile` may import settings; otherwise why it cannot.
+std::u16string SettingsImportUnavailableReason(Profile* profile);
+
+// Serializes every supported setting's effective value.
+SettingsTransferData ExportSettings(Profile* profile);
+
+// Parses `data` strictly and compares it with the current values. Nothing
+// changes until ApplySettings().
+base::expected<SettingsTransferPreview, std::u16string> PreviewSettings(
+    BrowserWindowInterface* browser,
+    std::string_view data);
+
+// Rechecks the owner, import availability, locks and that every current value
+// still matches the preview, then sets all listed values. Returns an error and
+// changes nothing on any mismatch.
+std::u16string ApplySettings(const SettingsTransferPreview& preview);
+
+SettingsTransferData ReadSettingsFile(const base::FilePath& path);
+std::u16string WriteSettingsFile(const base::FilePath& path,
+                                 std::string_view data);
+
+}  // namespace stainless
+
+#endif  // CHROME_BROWSER_UI_VIEWS_STAINLESS_SETTINGS_TRANSFER_H_
