+
+void StainlessSettingsTransferView::ChooseFile(bool importing) {
+  if (!browser_ || file_busy_ || !CanOwn(browser_.get())) {
+    return;
+  }
+  if (importing) {
+    const std::u16string unavailable =
+        stainless::SettingsImportUnavailableReason(browser_->GetProfile());
+    if (!unavailable.empty()) {
+      ShowStatus(unavailable);
+      return;
+    }
+  }
+  SetPreview(std::nullopt);
+  DetachFileDialog();
+  importing_file_ = importing;
+  file_busy_ = true;
+  UpdateControls();
+  ShowStatus(Text(IDS_STAINLESS_SETTINGS_BUSY));
+  file_dialog_ = ui::SelectFileDialog::Create(
+      this, std::make_unique<ChromeSelectFilePolicy>(
+                browser_->GetTabStripModel()->GetActiveWebContents()));
+  ui::SelectFileDialog::FileTypeInfo types;
+  types.extensions = {{FILE_PATH_LITERAL("json")}};
+  types.keep_extension_visible = true;
+  file_dialog_->SelectFile(
+      importing ? ui::SelectFileDialog::SELECT_OPEN_FILE
+                : ui::SelectFileDialog::SELECT_SAVEAS_FILE,
+      Text(importing ? IDS_STAINLESS_SETTINGS_IMPORT
+                     : IDS_STAINLESS_SETTINGS_EXPORT),
+      importing ? base::FilePath()
+                : base::FilePath(FILE_PATH_LITERAL("Stainless-settings.json")),
+      &types, 1, FILE_PATH_LITERAL("json"), GetWidget()->GetNativeWindow());
+}
+
+void StainlessSettingsTransferView::FileSelected(
+    const ui::SelectedFileInfo& file,
+    int index) {
+  if (!browser_ || !file_busy_ || !GetWidget() || GetWidget()->IsClosed()) {
+    return;
+  }
+  const base::FilePath path = file.path();
+  if (!path.IsAbsolute() || path.ReferencesParent() || file.url ||
+      file.virtual_path) {
+    file_busy_ = false;
+    UpdateControls();
+    ShowStatus(Text(importing_file_ ? IDS_STAINLESS_SETTINGS_READ_ERROR
+                                    : IDS_STAINLESS_SETTINGS_WRITE_ERROR));
+    return;
+  }
+  if (importing_file_) {
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+        base::BindOnce(&stainless::ReadSettingsFile, path),
+        base::BindOnce(&StainlessSettingsTransferView::FileRead,
+                       weak_factory_.GetWeakPtr()));
+    return;
+  }
+  stainless::SettingsTransferData data =
+      stainless::ExportSettings(browser_->GetProfile());
+  if (!data.has_value()) {
+    FileWritten(data.error());
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::BLOCK_SHUTDOWN},
+      base::BindOnce(
+          [](const base::FilePath& path, const std::string& data) {
+            std::u16string error = stainless::WriteSettingsFile(path, data);
+            if (!error.empty()) {
+              LOG(ERROR) << "Stainless settings export failed: "
+                         << base::UTF16ToUTF8(error);
+            }
+            return error;
+          },
+          path, std::move(*data)),
+      base::BindOnce(&StainlessSettingsTransferView::FileWritten,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void StainlessSettingsTransferView::FileSelectionCanceled() {
+  file_busy_ = false;
+  UpdateControls();
+  ShowStatus(Text(IDS_STAINLESS_SETTINGS_CANCELED));
+}
+
+void StainlessSettingsTransferView::FileRead(
+    stainless::SettingsTransferData data) {
+  file_busy_ = false;
+  if (!browser_ || !GetWidget() || GetWidget()->IsClosed()) {
+    return;
+  }
+  if (!data.has_value()) {
+    UpdateControls();
+    ShowStatus(data.error());
+    return;
+  }
+  auto preview = stainless::PreviewSettings(browser_.get(), *data);
+  if (!preview.has_value()) {
+    UpdateControls();
+    ShowStatus(preview.error());
+    return;
+  }
+  const bool applicable = preview->Applicable();
+  const size_t changes = preview->ChangeCount();
+  const bool locked = changes > 0 && !applicable;
+  SetPreview(std::move(*preview));
+  ShowStatus(locked ? Text(IDS_STAINLESS_SETTINGS_PREVIEW_LOCKED)
+             : changes == 0
+                 ? Text(IDS_STAINLESS_SETTINGS_PREVIEW_NO_CHANGES)
+                 : l10n_util::GetStringFUTF16(
+                       IDS_STAINLESS_SETTINGS_PREVIEW_READY,
+                       base::NumberToString16(changes)));
+}
+
+void StainlessSettingsTransferView::FileWritten(std::u16string error) {
+  file_busy_ = false;
+  UpdateControls();
+  ShowStatus(error.empty() ? Text(IDS_STAINLESS_SETTINGS_EXPORTED) : error);
+}
+
+void StainlessSettingsTransferView::ApplyPreview() {
+  if (!preview_) {
+    return;
+  }
+  const std::u16string error = stainless::ApplySettings(*preview_);
+  if (!error.empty()) {
+    LOG(WARNING) << "Stainless settings import rejected: "
+                 << base::UTF16ToUTF8(error);
+    SetPreview(std::nullopt);
+    ShowStatus(error);
+    return;
+  }
+  SetPreview(std::nullopt);
+  ShowStatus(Text(IDS_STAINLESS_SETTINGS_APPLIED));
+}
+
+void StainlessSettingsTransferView::CancelPreview() {
+  SetPreview(std::nullopt);
+  ShowStatus(Text(IDS_STAINLESS_SETTINGS_IMPORT_CANCELED));
+}
+
+void StainlessSettingsTransferView::SetPreview(
+    std::optional<stainless::SettingsTransferPreview> preview) {
+  preview_ = std::move(preview);
+  if (model_observer_) {
+    model_observer_->OnModelChanged();
+  }
+  UpdateControls();
+}
+
+void StainlessSettingsTransferView::ShowStatus(const std::u16string& text) {
+  status_->SetText(text);
+  status_->GetViewAccessibility().AnnounceText(text);
+}
+
+void StainlessSettingsTransferView::UpdateControls() {
+  const bool previewing = preview_.has_value();
+  const bool can_import =
+      browser_ &&
+      stainless::SettingsImportUnavailableReason(browser_->GetProfile())
+          .empty();
+  export_->SetEnabled(browser_ && !file_busy_ && !previewing);
+  import_->SetEnabled(can_import && !file_busy_ && !previewing);
+  table_scroll_->SetVisible(previewing);
+  apply_->SetVisible(previewing);
+  cancel_->SetVisible(previewing);
+  apply_->SetEnabled(previewing && preview_->Applicable());
+  cancel_->SetEnabled(previewing);
+  InvalidateLayout();
+}
+
+void StainlessSettingsTransferView::DetachFileDialog() {
+  if (file_dialog_) {
+    file_dialog_->ListenerDestroyed();
+    file_dialog_.reset();
+  }
+}
+
+namespace chrome {
+
+void ShowStainlessSettingsTransfer(BrowserWindowInterface* browser) {
+  StainlessSettingsTransferView::Show(browser);
+}
+
+}  // namespace chrome
+
+BEGIN_METADATA(StainlessSettingsTransferView)
+END_METADATA
