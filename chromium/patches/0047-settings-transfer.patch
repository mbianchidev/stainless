+StainlessSettingsTransferView::StainlessSettingsTransferView(
+    BrowserWindowInterface* browser)
+    : browser_(browser->GetWeakPtr()) {
+  const auto* layout = ChromeLayoutProvider::Get();
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(),
+      layout->GetDistanceMetric(views::DISTANCE_RELATED_CONTROL_VERTICAL)));
+  AddLabel(this, Text(IDS_STAINLESS_SETTINGS_INTRO));
