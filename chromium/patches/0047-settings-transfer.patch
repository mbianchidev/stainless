+
+namespace stainless {
+
+namespace {
+
+enum class Store { kProfile, kLocalState };
+enum class Kind { kBool, kChoice, kRange };
+
+struct Choice {
+  const char* name;
+  int value;
+  int label;
+};
+
+// session.restore_on_startup: SessionStartupPref's persisted values.
+constexpr auto kStartupChoices = std::to_array<Choice>({
+    {"new_tab", 5, IDS_STAINLESS_SETTINGS_STARTUP_NEW_TAB},
+    {"continue", 1, IDS_STAINLESS_SETTINGS_STARTUP_CONTINUE},
+    {"specific_pages", 4, IDS_STAINLESS_SETTINGS_STARTUP_SPECIFIC},
+    {"continue_and_specific_pages", 6,
+     IDS_STAINLESS_SETTINGS_STARTUP_CONTINUE_AND_SPECIFIC},
+});
+
+// content_settings::CookieControlsMode.
+constexpr auto kCookieChoices = std::to_array<Choice>({
+    {"default", 0, IDS_STAINLESS_SETTINGS_COOKIES_DEFAULT},
+    {"block_third_party_in_incognito", 2,
+     IDS_STAINLESS_SETTINGS_COOKIES_INCOGNITO},
+    {"block_third_party", 1, IDS_STAINLESS_SETTINGS_COOKIES_BLOCK},
+});
+
+constexpr auto kMemoryLimitChoices = std::to_array<Choice>({
+    {"off", 0, IDS_STAINLESS_RESOURCE_LIMIT_OFF},
+    {"512_mb", 512, IDS_STAINLESS_RESOURCE_LIMIT_512},
+    {"1_gb", 1024, IDS_STAINLESS_RESOURCE_LIMIT_1024},
+    {"2_gb", 2048, IDS_STAINLESS_RESOURCE_LIMIT_2048},
+    {"4_gb", 4096, IDS_STAINLESS_RESOURCE_LIMIT_4096},
+});
+
+struct Spec {
+  const char* id;
+  const char* pref;
+  Store store;
+  Kind kind;
+  int label;
+  base::span<const Choice> choices = {};
+  int min = 0;
+  int max = 0;
+};
+
+// The complete allowlist. URLs, paths, accounts, credentials, keys, site
+// lists and browsing data are deliberately absent.
+const std::array<Spec, 14>& Specs() {
+  static const std::array<Spec, 14> specs = {{
+      {"restore_on_startup", prefs::kRestoreOnStartup, Store::kProfile,
+       Kind::kChoice, IDS_STAINLESS_SETTINGS_RESTORE_ON_STARTUP,
+       kStartupChoices},
+      {"lazy_tab_restoration", prefs::kStainlessLazyTabRestoration,
+       Store::kProfile, Kind::kBool, IDS_STAINLESS_SETTINGS_LAZY_RESTORE},
+      {"show_home_button", prefs::kShowHomeButton, Store::kProfile,
+       Kind::kBool, IDS_STAINLESS_SETTINGS_HOME_BUTTON},
+      {"show_bookmarks_bar", bookmarks::prefs::kShowBookmarkBar,
+       Store::kProfile, Kind::kBool, IDS_STAINLESS_SETTINGS_BOOKMARKS_BAR},
+      {"warn_before_quitting", prefs::kConfirmToQuitEnabled, Store::kProfile,
+       Kind::kBool, IDS_STAINLESS_SETTINGS_CONFIRM_QUIT},
+      {"ask_where_to_save_downloads", prefs::kPromptForDownload,
+       Store::kProfile, Kind::kBool, IDS_STAINLESS_SETTINGS_DOWNLOAD_PROMPT},
+      {"spell_check", spellcheck::prefs::kSpellCheckEnable, Store::kProfile,
+       Kind::kBool, IDS_STAINLESS_SETTINGS_SPELL_CHECK},
+      {"default_font_size", prefs::kWebKitDefaultFontSize, Store::kProfile,
+       Kind::kRange, IDS_STAINLESS_SETTINGS_FONT_SIZE, {}, 9, 72},
+      {"minimum_font_size", prefs::kWebKitMinimumFontSize, Store::kProfile,
+       Kind::kRange, IDS_STAINLESS_SETTINGS_MINIMUM_FONT_SIZE, {}, 0, 24},
+      {"cookie_controls", prefs::kCookieControlsMode, Store::kProfile,
+       Kind::kChoice, IDS_STAINLESS_SETTINGS_COOKIES, kCookieChoices},
+      {"do_not_track", prefs::kEnableDoNotTrack, Store::kProfile, Kind::kBool,
+       IDS_STAINLESS_SETTINGS_DO_NOT_TRACK},
+      {"password_breach_checks",
+       password_manager::prefs::kPasswordLeakDetectionEnabled,
+       Store::kProfile, Kind::kBool, IDS_STAINLESS_SETTINGS_BREACH_CHECKS},
+      {"threat_lists", stainless_threats::kThreatProtectionEnabled,
+       Store::kLocalState, Kind::kBool, IDS_STAINLESS_SETTINGS_THREAT_LISTS},
+      {"background_tab_memory_limit", prefs::kStainlessBackgroundTabMemoryLimit,
+       Store::kProfile, Kind::kChoice, IDS_STAINLESS_SETTINGS_MEMORY_LIMIT,
+       kMemoryLimitChoices},
+  }};
+  return specs;
+}
+
+const Spec* FindSpec(std::string_view id) {
+  for (const Spec& spec : Specs()) {
+    if (id == spec.id) {
+      return &spec;
+    }
+  }
+  return nullptr;
+}
+
+std::u16string Error(int message_id) {
+  return l10n_util::GetStringUTF16(message_id);
+}
+
+std::u16string SettingError(int message_id, std::string_view id) {
+  const Spec* spec = FindSpec(id);
+  return l10n_util::GetStringFUTF16(
+      message_id, spec ? l10n_util::GetStringUTF16(spec->label)
+                       : std::u16string(id.begin(), id.end()));
+}
+
+PrefService* PrefsFor(const Spec& spec, Profile* profile) {
+  if (spec.store == Store::kLocalState) {
+    return g_browser_process ? g_browser_process->local_state() : nullptr;
+  }
+  return profile ? profile->GetPrefs() : nullptr;
+}
+
+// The transfer representation of the current effective value, or nullopt when
+// the stored value is outside what version 1 can express.
+std::optional<base::Value> Current(const Spec& spec, PrefService& prefs) {
+  const base::Value& value = prefs.GetValue(spec.pref);
+  switch (spec.kind) {
+    case Kind::kBool:
+      if (value.is_bool()) {
+        return base::Value(value.GetBool());
+      }
+      break;
+    case Kind::kChoice:
+      if (value.is_int()) {
+        for (const Choice& choice : spec.choices) {
+          if (choice.value == value.GetInt()) {
+            return base::Value(choice.name);
+          }
+        }
+      }
+      break;
+    case Kind::kRange:
+      if (value.is_int() && value.GetInt() >= spec.min &&
+          value.GetInt() <= spec.max) {
+        return base::Value(value.GetInt());
+      }
+      break;
+  }
+  return std::nullopt;
+}
+
+bool Valid(const Spec& spec, const base::Value& value) {
+  switch (spec.kind) {
+    case Kind::kBool:
+      return value.is_bool();
+    case Kind::kChoice:
+      return value.is_string() &&
+             std::ranges::any_of(spec.choices, [&](const Choice& choice) {
+               return value.GetString() == choice.name;
+             });
+    case Kind::kRange:
+      return value.is_int() && value.GetInt() >= spec.min &&
+             value.GetInt() <= spec.max;
+  }
+  NOTREACHED();
+}
+
+void Set(const Spec& spec, PrefService& prefs, const base::Value& value) {
+  switch (spec.kind) {
+    case Kind::kBool:
+      prefs.SetBoolean(spec.pref, value.GetBool());
+      return;
+    case Kind::kChoice:
+      for (const Choice& choice : spec.choices) {
+        if (value.GetString() == choice.name) {
+          prefs.SetInteger(spec.pref, choice.value);
+          return;
+        }
+      }
+      NOTREACHED();
+    case Kind::kRange:
+      prefs.SetInteger(spec.pref, value.GetInt());
+      return;
+  }
+}
+
+}  // namespace
+
+SettingsTransferRow::SettingsTransferRow() = default;
+SettingsTransferRow::SettingsTransferRow(const SettingsTransferRow&) = default;
+SettingsTransferRow& SettingsTransferRow::operator=(
+    const SettingsTransferRow&) = default;
+SettingsTransferRow::~SettingsTransferRow() = default;
+
+SettingsTransferPreview::SettingsTransferPreview() = default;
+SettingsTransferPreview::SettingsTransferPreview(SettingsTransferPreview&&) =
+    default;
+SettingsTransferPreview& SettingsTransferPreview::operator=(
+    SettingsTransferPreview&&) = default;
+SettingsTransferPreview::~SettingsTransferPreview() = default;
+
+bool SettingsTransferPreview::Applicable() const {
+  return ChangeCount() > 0 &&
+         std::ranges::none_of(rows, [](const SettingsTransferRow& row) {
+           return row.locked && row.Changes();
+         });
+}
+
+size_t SettingsTransferPreview::ChangeCount() const {
+  return std::ranges::count_if(
+      rows, [](const SettingsTransferRow& row) { return row.Changes(); });
+}
+
+std::vector<std::string> SettingsTransferIds() {
+  std::vector<std::string> ids;
+  for (const Spec& spec : Specs()) {
+    ids.push_back(spec.id);
+  }
+  return ids;
+}
+
+std::u16string SettingsTransferLabel(std::string_view id) {
+  const Spec* spec = FindSpec(id);
+  return spec ? l10n_util::GetStringUTF16(spec->label) : std::u16string();
+}
+
+std::u16string SettingsTransferValueLabel(std::string_view id,
+                                          const base::Value& value) {
+  const Spec* spec = FindSpec(id);
+  if (!spec || !Valid(*spec, value)) {
+    return std::u16string();
+  }
+  switch (spec->kind) {
+    case Kind::kBool:
+      return Error(value.GetBool() ? IDS_STAINLESS_SETTINGS_ON
+                                   : IDS_STAINLESS_SETTINGS_OFF);
+    case Kind::kChoice:
+      for (const Choice& choice : spec->choices) {
+        if (value.GetString() == choice.name) {
+          return Error(choice.label);
+        }
+      }
+      return std::u16string();
+    case Kind::kRange:
+      return base::NumberToString16(value.GetInt());
+  }
+  NOTREACHED();
+}
+
+std::u16string SettingsImportUnavailableReason(Profile* profile) {
+  if (!profile) {
+    return Error(IDS_STAINLESS_SETTINGS_UNAVAILABLE);
+  }
+  if (profile->IsOffTheRecord()) {
+    return Error(IDS_STAINLESS_SETTINGS_IMPORT_PRIVATE);
+  }
+  if (IsStartupSafeMode()) {
+    return Error(IDS_STAINLESS_SETTINGS_IMPORT_SAFE_MODE);
+  }
+  return std::u16string();
+}
+
+SettingsTransferData ExportSettings(Profile* profile) {
+  base::ListValue settings;
+  for (const Spec& spec : Specs()) {
+    PrefService* prefs = PrefsFor(spec, profile);
+    std::optional<base::Value> value =
+        prefs ? Current(spec, *prefs) : std::nullopt;
+    if (!value) {
+      return base::unexpected(
+          SettingError(IDS_STAINLESS_SETTINGS_EXPORT_UNSUPPORTED, spec.id));
+    }
+    settings.Append(base::ListValue().Append(spec.id).Append(std::move(*value)));
+  }
+  base::ListValue root;
+  root.Append(kSettingsTransferFormat);
+  root.Append(kSettingsTransferVersion);
+  root.Append(std::move(settings));
+  std::string data;
+  if (!base::JSONWriter::WriteWithOptions(
+          root, base::JSONWriter::OPTIONS_PRETTY_PRINT, &data) ||
+      data.size() > kMaxSettingsTransferBytes) {
+    return base::unexpected(Error(IDS_STAINLESS_SETTINGS_WRITE_ERROR));
+  }
+  return data;
+}
+
+base::expected<SettingsTransferPreview, std::u16string> PreviewSettings(
+    BrowserWindowInterface* browser,
+    std::string_view data) {
+  Profile* profile = browser ? browser->GetProfile() : nullptr;
+  std::u16string unavailable = SettingsImportUnavailableReason(profile);
+  if (!unavailable.empty()) {
+    return base::unexpected(std::move(unavailable));
+  }
+  if (data.size() > kMaxSettingsTransferBytes) {
+    return base::unexpected(Error(IDS_STAINLESS_SETTINGS_TOO_LARGE));
+  }
+  auto root = base::JSONReader::ReadList(data, base::JSON_PARSE_RFC, 4);
+  if (!root || root->size() != 3 || !(*root)[0].is_string() ||
+      (*root)[0].GetString() != kSettingsTransferFormat ||
+      !(*root)[1].is_int() || !(*root)[2].is_list()) {
+    return base::unexpected(Error(IDS_STAINLESS_SETTINGS_INVALID));
+  }
+  if ((*root)[1].GetInt() != kSettingsTransferVersion) {
+    return base::unexpected(Error(IDS_STAINLESS_SETTINGS_UNSUPPORTED_VERSION));
+  }
+  const base::ListValue& records = (*root)[2].GetList();
+  if (records.empty() || records.size() > Specs().size()) {
+    return base::unexpected(Error(IDS_STAINLESS_SETTINGS_INVALID));
+  }
+  std::map<std::string, base::Value> proposed;
+  for (const base::Value& record : records) {
+    if (!record.is_list() || record.GetList().size() != 2 ||
+        !record.GetList()[0].is_string()) {
+      return base::unexpected(Error(IDS_STAINLESS_SETTINGS_INVALID));
+    }
+    const std::string& id = record.GetList()[0].GetString();
+    const Spec* spec = FindSpec(id);
+    if (!spec) {
+      return base::unexpected(
+          SettingError(IDS_STAINLESS_SETTINGS_UNKNOWN, id));
+    }
+    if (!Valid(*spec, record.GetList()[1])) {
+      return base::unexpected(
+          SettingError(IDS_STAINLESS_SETTINGS_INVALID_VALUE, id));
+    }
+    if (!proposed.emplace(id, record.GetList()[1].Clone()).second) {
+      return base::unexpected(
+          SettingError(IDS_STAINLESS_SETTINGS_DUPLICATE, id));
+    }
+  }
+  SettingsTransferPreview preview;
+  preview.owner = browser->GetWeakPtr();
+  for (const Spec& spec : Specs()) {
+    auto it = proposed.find(spec.id);
+    if (it == proposed.end()) {
+      continue;
+    }
+    PrefService* prefs = PrefsFor(spec, profile);
+    std::optional<base::Value> current =
+        prefs ? Current(spec, *prefs) : std::nullopt;
+    if (!current) {
+      return base::unexpected(
+          SettingError(IDS_STAINLESS_SETTINGS_EXPORT_UNSUPPORTED, spec.id));
+    }
+    SettingsTransferRow row;
+    row.id = spec.id;
+    row.current = std::move(*current);
+    row.proposed = std::move(it->second);
+    row.locked = !prefs->IsUserModifiablePreference(spec.pref);
+    preview.rows.push_back(std::move(row));
+  }
+  return preview;
+}
+
+std::u16string ApplySettings(const SettingsTransferPreview& preview) {
+  BrowserWindowInterface* browser = preview.owner.get();
+  Profile* profile = browser ? browser->GetProfile() : nullptr;
+  std::u16string unavailable = SettingsImportUnavailableReason(profile);
+  if (!unavailable.empty()) {
+    return unavailable;
+  }
+  if (!preview.Applicable()) {
+    return Error(IDS_STAINLESS_SETTINGS_NOTHING_TO_APPLY);
+  }
+  // Recheck everything before the first write so that a stale or locked
+  // setting rejects the whole import.
+  for (const SettingsTransferRow& row : preview.rows) {
+    const Spec* spec = FindSpec(row.id);
+    PrefService* prefs = spec ? PrefsFor(*spec, profile) : nullptr;
+    if (!prefs) {
+      return Error(IDS_STAINLESS_SETTINGS_UNAVAILABLE);
+    }
+    std::optional<base::Value> current = Current(*spec, *prefs);
+    if (!current || *current != row.current) {
+      return Error(IDS_STAINLESS_SETTINGS_STALE);
+    }
+    if (row.Changes() && !prefs->IsUserModifiablePreference(spec->pref)) {
+      return SettingError(IDS_STAINLESS_SETTINGS_LOCKED, row.id);
+    }
+  }
+  for (const SettingsTransferRow& row : preview.rows) {
+    if (row.Changes()) {
+      const Spec& spec = *FindSpec(row.id);
+      Set(spec, *PrefsFor(spec, profile), row.proposed);
+    }
+  }
+  return std::u16string();
+}
+
+SettingsTransferData ReadSettingsFile(const base::FilePath& path) {
+  struct stat info;
+  if (stat(path.value().c_str(), &info) != 0 || !S_ISREG(info.st_mode)) {
+    return base::unexpected(Error(IDS_STAINLESS_SETTINGS_READ_ERROR));
+  }
+  if (info.st_size > static_cast<int64_t>(kMaxSettingsTransferBytes)) {
+    return base::unexpected(Error(IDS_STAINLESS_SETTINGS_TOO_LARGE));
+  }
+  std::string data;
+  const bool read = base::ReadFileToStringWithMaxSize(
+      path, &data, kMaxSettingsTransferBytes + 1);
+  if (data.size() > kMaxSettingsTransferBytes) {
+    return base::unexpected(Error(IDS_STAINLESS_SETTINGS_TOO_LARGE));
+  }
+  if (!read) {
+    return base::unexpected(Error(IDS_STAINLESS_SETTINGS_READ_ERROR));
+  }
+  return data;
+}
+
+std::u16string WriteSettingsFile(const base::FilePath& path,
+                                 std::string_view data) {
+  if (!base::ImportantFileWriter::WriteFileAtomically(path, data)) {
+    return Error(IDS_STAINLESS_SETTINGS_WRITE_ERROR);
+  }
+  return std::u16string();
+}
+
+}  // namespace stainless
