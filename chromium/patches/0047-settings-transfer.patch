+size_t StainlessSettingsTransferView::RowCount() const {
+  return preview_ ? preview_->rows.size() : 0;
+}
+
+std::u16string StainlessSettingsTransferView::GetText(size_t row,
+                                                      int column_id) const {
+  if (!preview_ || row >= preview_->rows.size()) {
+    return std::u16string();
+  }
+  const stainless::SettingsTransferRow& setting = preview_->rows[row];
+  switch (column_id) {
+    case IDS_STAINLESS_SETTINGS_SETTING_COLUMN:
+      return stainless::SettingsTransferLabel(setting.id);
+    case IDS_STAINLESS_SETTINGS_CURRENT_COLUMN:
+      return stainless::SettingsTransferValueLabel(setting.id,
+                                                   setting.current);
+    case IDS_STAINLESS_SETTINGS_AFTER_COLUMN:
+      return stainless::SettingsTransferValueLabel(setting.id,
+                                                   setting.proposed);
+    default:
+      if (setting.locked && setting.Changes()) {
+        return Text(IDS_STAINLESS_SETTINGS_ROW_LOCKED);
+      }
+      return Text(setting.Changes() ? IDS_STAINLESS_SETTINGS_ROW_CHANGE
+                                    : IDS_STAINLESS_SETTINGS_ROW_SAME);
+  }
+}
