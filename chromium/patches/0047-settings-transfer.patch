+  auto preview = stainless::PreviewSettings(incognito, kImport);
+  ASSERT_FALSE(preview.has_value());
+  EXPECT_EQ(l10n_util::GetStringUTF16(IDS_STAINLESS_SETTINGS_IMPORT_PRIVATE),
+            preview.error());
+  StainlessSettingsTransferView* view =
+      StainlessSettingsTransferView::Show(incognito);
+  ASSERT_TRUE(view);
+  EXPECT_FALSE(ImportEnabled(view));
+  EXPECT_TRUE(stainless::ExportSettings(incognito->GetProfile()).has_value());
+  ExpectUntouched();
+}
