+// static
+StainlessSettingsTransferView* StainlessSettingsTransferView::Show(
+    BrowserWindowInterface* browser) {
+  if (!CanOwn(browser)) {
+    LOG(WARNING) << "Settings Transfer needs a live normal window with a tab";
+    return nullptr;
+  }
+  auto contents = std::make_unique<StainlessSettingsTransferView>(browser);
+  StainlessSettingsTransferView* view = contents.get();
+  auto dialog = std::make_unique<views::DialogDelegate>();
+  dialog->SetTitle(Text(IDS_STAINLESS_SETTINGS_TITLE));
+  dialog->SetModalType(ui::mojom::ModalType::kWindow);
+  dialog->SetButtons(static_cast<int>(ui::mojom::DialogButton::kCancel));
+  dialog->SetButtonLabel(ui::mojom::DialogButton::kCancel,
+                         Text(IDS_STAINLESS_COMMAND_PALETTE_CLOSE));
+  dialog->SetDefaultButton(static_cast<int>(ui::mojom::DialogButton::kNone));
+  dialog->set_fixed_width(ChromeLayoutProvider::Get()->GetDistanceMetric(
+      views::DISTANCE_MODAL_DIALOG_PREFERRED_WIDTH));
+  dialog->set_margins(ChromeLayoutProvider::Get()->GetDialogInsetsForContentType(
+      views::DialogContentType::kText, views::DialogContentType::kControl));
+  dialog->SetInitiallyFocusedView(view->export_);
+  dialog->SetContentsView(std::move(contents));
+  auto* widget = views::DialogDelegate::CreateDialogWidget(
+      std::move(dialog), gfx::NativeWindow(),
+      BrowserView::GetBrowserViewForBrowser(browser)
+          ->GetWidget()
+          ->GetNativeView());
+  widget->Show();
+  return view;
+}
