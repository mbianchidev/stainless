+    base::FilePath path = files_.GetPath().AppendASCII("Orion-settings.json");
+    EXPECT_TRUE(base::WriteFile(path, data));
+    return path;
+  }
+
+  std::string Read(const base::FilePath& path) {
+    base::ScopedAllowBlockingForTesting blocking;
+    std::string data;
+    EXPECT_TRUE(base::ReadFileToString(path, &data));
+    return data;
+  }
+
+  StainlessSettingsTransferView* Open() {
+    EXPECT_TRUE(chrome::IsCommandEnabled(browser(),
+                                         IDC_STAINLESS_SETTINGS_TRANSFER));
+    return StainlessSettingsTransferView::Show(browser());
+  }
+
+  // Presses Export or Import, answers the picker with `path` and waits for the
+  // file operation to finish.
+  void Choose(StainlessSettingsTransferView* view,
+              bool importing,
+              std::optional<base::FilePath> path) {
+    picker_.type = ui::SelectFileDialog::SELECT_NONE;
+    view->ChooseFile(importing);
+    ASSERT_EQ(importing ? ui::SelectFileDialog::SELECT_OPEN_FILE
+                        : ui::SelectFileDialog::SELECT_SAVEAS_FILE,
+              picker_.type);
+    if (!importing) {
+      EXPECT_EQ(base::FilePath("Stainless-settings.json"), picker_.suggested);
+    }
+    picker_.dialog->Complete(path);
+    ASSERT_TRUE(base::test::RunUntil([&] { return !view->file_busy_; }));
+  }
+
+  static bool Previewing(StainlessSettingsTransferView* view) {
+    return view->preview_.has_value();
+  }
+  static bool CanApply(StainlessSettingsTransferView* view) {
+    return view->apply_->GetVisible() && view->apply_->GetEnabled();
+  }
+  static void Apply(StainlessSettingsTransferView* view) {
+    view->ApplyPreview();
+  }
+  static void Cancel(StainlessSettingsTransferView* view) {
+    view->CancelPreview();
+  }
+  static std::u16string Status(StainlessSettingsTransferView* view) {
+    return std::u16string(view->status_->GetText());
+  }
+  static bool ImportEnabled(StainlessSettingsTransferView* view) {
+    return view->import_->GetEnabled();
+  }
+
+  void ExpectUntouched() {
+    EXPECT_FALSE(prefs().GetBoolean(prefs::kShowHomeButton));
+    EXPECT_FALSE(prefs().GetBoolean(prefs::kStainlessLazyTabRestoration));
+    EXPECT_EQ(16, prefs().GetInteger(prefs::kWebKitDefaultFontSize));
+  }
+
+  void LockHomeButton() {
+    policy::PolicyMap policies;
+    policies.Set(policy::key::kShowHomeButton, policy::POLICY_LEVEL_MANDATORY,
+                 policy::POLICY_SCOPE_USER, policy::POLICY_SOURCE_PLATFORM,
+                 base::Value(false), nullptr);
+    provider_.UpdateChromePolicy(policies);
+  }
+
+  testing::NiceMock<policy::MockConfigurationPolicyProvider> provider_;
+  base::ScopedTempDir files_;
+  PickerState picker_;
+};
+
+IN_PROC_BROWSER_TEST_F(StainlessSettingsTransferBrowserTest,
+                       ExportWritesOnlyTheAllowlist) {
+  prefs().SetBoolean(prefs::kShowHomeButton, true);
+  prefs().SetInteger(prefs::kWebKitDefaultFontSize, 18);
+  prefs().SetInteger(prefs::kStainlessBackgroundTabMemoryLimit, 1024);
+  StainlessSettingsTransferView* view = Open();
+  ASSERT_TRUE(view);
+  const base::FilePath path = files_.GetPath().AppendASCII("export.json");
+  Choose(view, /*importing=*/false, path);
+  EXPECT_EQ(l10n_util::GetStringUTF16(IDS_STAINLESS_SETTINGS_EXPORTED),
+            Status(view));
+
+  const std::string data = Read(path);
+  auto root = base::JSONReader::ReadList(data, base::JSON_PARSE_RFC);
+  ASSERT_TRUE(root);
+  ASSERT_EQ(3u, root->size());
+  EXPECT_EQ("stainless-settings", (*root)[0].GetString());
+  EXPECT_EQ(1, (*root)[1].GetInt());
+  std::vector<std::string> ids;
+  base::DictValue values;
+  for (const base::Value& record : (*root)[2].GetList()) {
+    ids.push_back(record.GetList()[0].GetString());
+    values.Set(record.GetList()[0].GetString(), record.GetList()[1].Clone());
+  }
+  EXPECT_EQ(stainless::SettingsTransferIds(), ids);
+  EXPECT_EQ(true, values.FindBool("show_home_button"));
+  EXPECT_EQ(18, values.FindInt("default_font_size"));
+  EXPECT_EQ("1_gb", *values.FindString("background_tab_memory_limit"));
+  // No profile location, URL or account data.
+  const std::string profile_path =
+      browser()->GetProfile()->GetPath().AsUTF8Unsafe();
+  EXPECT_EQ(std::string::npos, data.find(profile_path));
+  EXPECT_EQ(std::string::npos, data.find("://"));
+
+  // The exported file round-trips into a preview without changes.
+  auto preview = stainless::PreviewSettings(browser(), data);
+  ASSERT_TRUE(preview.has_value());
+  EXPECT_EQ(ids.size(), preview->rows.size());
+  EXPECT_EQ(0u, preview->ChangeCount());
+}
