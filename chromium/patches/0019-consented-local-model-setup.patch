+    return;
+  }
+  models->CancelInstall(
+      base::BindOnce(&StainlessLocalServicesHandler::ModelReply,
+                     weak_.GetWeakPtr(), args[0].Clone()));
+}
+
+void StainlessLocalServicesHandler::RemoveModel(const base::ListValue& args) {
