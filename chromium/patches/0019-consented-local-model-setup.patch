+class StainlessLocalModelsBrowserTest : public InProcessBrowserTest {
+ public:
+  void SetUpCommandLine(base::CommandLine* command) override {
+    ASSERT_TRUE(cache_.CreateUniqueTempDir());
+    base::FilePath canonical;
+    ASSERT_TRUE(base::NormalizeFilePath(cache_.GetPath(), &canonical));
+    command->AppendSwitchPath("disk-cache-dir", canonical);
+    command->AppendSwitchASCII("headless", "new");
+    command->AppendSwitch("use-mock-keychain");
+    command->AppendSwitchASCII("lang", "en-US");
+  }
+
+  void SetUpOnMainThread() override {
+    ASSERT_TRUE(display::Screen::Get()->IsHeadless());
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(
+        browser(), GURL("stainless://settings/localServices")));
+    ASSERT_TRUE(content::ExecJs(contents(), R"(
+      window.findModelPage = function find(root) {
+        const page = root.querySelector('settings-local-services-page');
+        if (page) return page;
+        for (const element of root.querySelectorAll('*')) {
+          if (element.shadowRoot) {
+            const result = find(element.shadowRoot);
+            if (result) return result;
+          }
+        }
+        return null;
+      };
+      window.modelsReady = new Promise((resolve, reject) => {
+        const deadline = performance.now() + 10000;
+        function check() {
+          const page = window.findModelPage(document);
+          if (page?.shadowRoot.querySelector('[data-feature="ocr"]')) {
+            resolve(true);
+          } else if (performance.now() > deadline) {
+            reject(new Error('Actual model Settings controls did not load'));
+          } else {
+            requestAnimationFrame(check);
+          }
+        }
+        check();
+      });
+    )"));
+    ASSERT_EQ(true, content::EvalJs(contents(), "modelsReady"));
+  }
+
+  content::WebContents* contents() {
+    return browser()->GetTabStripModel()->GetActiveWebContents();
+  }
+
+  bool Key(ui::KeyboardCode key) {
+    return ui_test_utils::SendKeyPressSync(browser(), key, false, false, false,
+                                           false);
+  }
+
+  bool Wait(std::string_view expression) {
+    return base::test::RunUntil([&] {
+      return content::EvalJs(contents(), std::string(expression)).ExtractBool();
+    });
+  }
+
+  const ModelPack& OcrPack() {
+    const auto found =
+        std::ranges::find(ModelCatalog(), "ocr-eng", &ModelPack::id);
+    CHECK(found != ModelCatalog().end());
+    return *found;
+  }
+
+  base::expected<model_storage::Location, std::string> CacheLocation() {
+    return model_storage::ResolveLocation(
+        browser()->GetProfile()->GetPath().DirName());
+  }
+
+  void TearDownOnMainThread() override {
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    auto location = CacheLocation();
+    if (location.has_value() && base::PathExists(location->leaf)) {
+      auto inventory = model_storage::Inspect(*location, false);
+      if (inventory.has_value()) {
+        for (const auto& pack : inventory->packs) {
+          auto* models = LocalModels::Get(browser()->GetProfile());
+          ASSERT_TRUE(models);
+          base::test::TestFuture<base::expected<base::DictValue, std::string>>
+              removed;
+          models->Remove(pack.archive_sha256, true, removed.GetCallback());
+          EXPECT_TRUE(removed.Get().has_value()) << removed.Get().error();
+        }
+      }
+    }
+  }
+
+ private:
+  base::ScopedTempDir cache_;
+};
