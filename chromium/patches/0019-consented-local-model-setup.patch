+IN_PROC_BROWSER_TEST_F(StainlessLocalModelsBrowserTest,
+                       UnpublishedAndForeignRedirectFailuresStayExplicit) {
+  auto* models = LocalModels::Get(browser()->GetProfile());
+  ASSERT_TRUE(models);
+  ASSERT_TRUE(models->ConfigureFeature("ocr", true, true).has_value());
+  const GURL target(OcrPack().url);
+  std::atomic<int> mode = 0;
+  std::atomic<int> unexpected = 0;
+  content::URLLoaderInterceptor interceptor(base::BindLambdaForTesting(
+      [&](content::URLLoaderInterceptor::RequestParams* request) {
+        if (request->url_request.url == target) {
+          if (mode == 0) {
+            content::URLLoaderInterceptor::WriteResponse(
+                "HTTP/1.1 404 Not Found\nContent-Type: text/plain\n\n", "",
+                request->client.get());
+          } else {
+            net::RedirectInfo redirect;
+            redirect.status_code = 302;
+            redirect.new_method = "GET";
+            redirect.new_url =
+                GURL("https://foreign.example.test/unreviewed-model");
+            auto response = network::mojom::URLResponseHead::New();
+            response->headers = base::MakeRefCounted<
+                net::HttpResponseHeaders>(net::HttpUtil::AssembleRawHeaders(
+                "HTTP/1.1 302 Found\n"
+                "Location: https://foreign.example.test/unreviewed-model\n\n"));
+            request->client->OnReceiveRedirect(redirect, std::move(response));
+          }
+          return true;
+        }
+        if (request->url_request.url.host() == "foreign.example.test") {
+          ++unexpected;
+          content::URLLoaderInterceptor::WriteResponse(
+              "HTTP/1.1 500 Unexpected\n\n", "", request->client.get());
+          return true;
+        }
+        return false;
+      }));
+  for (int attempt = 0; attempt < 2; ++attempt) {
+    mode.store(attempt);
+    base::test::TestFuture<base::expected<base::DictValue, std::string>> result;
+    models->Install(OcrPack().id, "ocr", true, result.GetCallback());
+    ASSERT_FALSE(result.Get().has_value());
+    EXPECT_NE(
+        std::string::npos,
+        result.Get().error().find(attempt == 0 ? "not published or is missing"
+                                               : "unreviewed redirect"));
+    EXPECT_FALSE(models->Ready(OcrPack().id));
+  }
+  EXPECT_EQ(0, unexpected.load());
+}
+
+IN_PROC_BROWSER_TEST_F(
+    StainlessLocalModelsBrowserTest,
+    MANUAL_ActualAnonymousCompiledAssetDownloadAndOfflineAcquisition) {
+  base::ScopedAllowBlockingForTesting allow_blocking;
+  auto* models = LocalModels::Get(browser()->GetProfile());
+  ASSERT_TRUE(models);
+  ASSERT_TRUE(models->ConfigureFeature("ocr", true, true).has_value());
+  const auto directory =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValuePath(
+          "stainless-model-pack-fixture");
+  ASSERT_TRUE(directory.IsAbsolute());
+  const auto& pack = OcrPack();
+  const GURL target(pack.url);
+  std::string body;
+  ASSERT_TRUE(base::ReadFileToStringWithMaxSize(
+      directory.AppendASCII(target.ExtractFileName()), &body,
+      static_cast<size_t>(pack.archive_bytes)));
+  ASSERT_EQ(pack.archive_bytes, body.size());
+  std::atomic<int> requests = 0;
+  content::URLLoaderInterceptor interceptor(base::BindLambdaForTesting(
+      [&](content::URLLoaderInterceptor::RequestParams* request) {
+        if (request->url_request.url != target) {
+          return false;
+        }
+        ++requests;
+        EXPECT_EQ(network::mojom::CredentialsMode::kOmit,
+                  request->url_request.credentials_mode);
+        EXPECT_TRUE(request->url_request.referrer.is_empty());
+        EXPECT_FALSE(request->url_request.headers.HasHeader("Authorization"));
+        EXPECT_FALSE(request->url_request.headers.HasHeader("Cookie"));
+        EXPECT_FALSE(request->url_request.headers.HasHeader("Referer"));
+        EXPECT_TRUE(request->url_request.load_flags & net::LOAD_DISABLE_CACHE);
+        EXPECT_TRUE(request->url_request.load_flags & net::LOAD_BYPASS_CACHE);
+        content::URLLoaderInterceptor::WriteResponse(
+            "HTTP/1.1 200 OK\nContent-Type: application/zip\n"
+            "Content-Length: " +
+                base::NumberToString(body.size()) + "\n\n",
+            body, request->client.get());
+        return true;
+      }));
+  ASSERT_TRUE(Wait(R"(
+    !window.findModelPage(document).shadowRoot
+        .querySelector('[data-pack="ocr-eng"]').disabled
+  )"));
+  ASSERT_TRUE(content::ExecJs(contents(), R"(
+    window.findModelPage(document).shadowRoot
+        .querySelector('[data-pack="ocr-eng"]').focus();
+  )"));
+  ASSERT_TRUE(Key(ui::VKEY_RETURN));
+  ASSERT_TRUE(Wait(R"(
+    window.findModelPage(document).shadowRoot.querySelector('#modelDialog').open
+  )"));
+  ASSERT_TRUE(content::ExecJs(contents(), R"(
+    window.findModelPage(document).shadowRoot
+        .querySelector('#modelDialog input[type="checkbox"]').focus();
+  )"));
+  ASSERT_TRUE(Key(ui::VKEY_SPACE));
+  ASSERT_TRUE(Wait(R"(
+    !window.findModelPage(document).shadowRoot
+        .querySelector('#modelDialog .action-button').disabled
+  )"));
+  ASSERT_TRUE(content::ExecJs(contents(), R"(
+    window.findModelPage(document).shadowRoot
+        .querySelector('#modelDialog .action-button').focus();
+  )"));
+  ASSERT_TRUE(Key(ui::VKEY_RETURN));
+  ASSERT_TRUE(base::test::RunUntil([&] { return models->Ready(pack.id); }));
+  EXPECT_EQ(1, requests.load());
+  base::test::TestFuture<base::expected<model_storage::Acquired, std::string>>
+      acquired;
+  models->AcquirePack(pack.id, Feature::kOcr, acquired.GetCallback());
+  ASSERT_TRUE(acquired.Get().has_value()) << acquired.Get().error();
+  EXPECT_FALSE(acquired.Get()->files.empty());
+  EXPECT_EQ(1, requests.load());
+}
