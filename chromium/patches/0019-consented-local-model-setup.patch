+IN_PROC_BROWSER_TEST_F(StainlessLocalModelsBrowserTest,
+                       SettingsConsentIsIndependentAndCreatesNoCache) {
+  base::ScopedAllowBlockingForTesting allow_blocking;
+  auto* models = LocalModels::Get(browser()->GetProfile());
+  ASSERT_TRUE(models);
+  auto location = CacheLocation();
+  ASSERT_TRUE(location.has_value());
+  std::atomic<int> requests = 0;
+  content::URLLoaderInterceptor interceptor(base::BindLambdaForTesting(
+      [&](content::URLLoaderInterceptor::RequestParams* request) {
+        if (request->url_request.url.host() != "github.com") {
+          return false;
+        }
+        ++requests;
+        content::URLLoaderInterceptor::WriteResponse(
+            "HTTP/1.1 404 Not Found\nContent-Type: text/plain\n\n", "",
+            request->client.get());
+        return true;
+      }));
+  base::test::TestFuture<base::expected<base::DictValue, std::string>> rejected;
+  models->Install(OcrPack().id, "ocr", true, rejected.GetCallback());
+  EXPECT_FALSE(rejected.Get().has_value());
+  EXPECT_EQ(0, requests.load());
+  EXPECT_FALSE(base::PathExists(location->leaf));
+  auto* private_profile =
+      browser()->GetProfile()->GetPrimaryOTRProfile(/*create_if_needed=*/true);
+  EXPECT_EQ(nullptr, LocalModels::Get(private_profile));
+  EXPECT_FALSE(base::PathExists(location->leaf));
+  EXPECT_EQ(true, content::EvalJs(contents(), R"(
+    window.findModelPage(document).shadowRoot
+        .querySelector('[data-pack="ocr-eng"]').disabled
+  )"));
+  EXPECT_EQ(0, requests.load());
+  EXPECT_FALSE(base::PathExists(location->leaf));
+  EXPECT_FALSE(browser()->GetProfile()->GetPrefs()->GetBoolean(kOcrEnabled));
+  EXPECT_EQ(true, content::EvalJs(contents(), R"(
+    (() => {
+      const input = window.findModelPage(document).shadowRoot
+          .querySelector('[data-feature="ocr"]');
+      input.focus();
+      return input === window.findModelPage(document).shadowRoot.activeElement;
+    })()
+  )"));
+  ASSERT_TRUE(Key(ui::VKEY_SPACE));
+  ASSERT_TRUE(Wait(R"(
+    window.findModelPage(document).shadowRoot
+        .querySelector('[data-feature="ocr"]').checked
+  )"));
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return browser()->GetProfile()->GetPrefs()->GetBoolean(kOcrEnabled);
+  }));
+  EXPECT_FALSE(browser()->GetProfile()->GetPrefs()->GetBoolean(kSpeechEnabled));
+  EXPECT_FALSE(
+      browser()->GetProfile()->GetPrefs()->GetBoolean(kCaptionsEnabled));
+  ASSERT_TRUE(Wait(R"(
+    !window.findModelPage(document).shadowRoot
+        .querySelector('[data-pack="ocr-eng"]').disabled
+  )"));
+  ASSERT_TRUE(content::ExecJs(contents(), R"(
+    window.findModelPage(document).shadowRoot
+        .querySelector('[data-pack="ocr-eng"]').focus();
+  )"));
+  ASSERT_TRUE(Key(ui::VKEY_RETURN));
+  ASSERT_TRUE(Wait(R"(
+    window.findModelPage(document).shadowRoot.querySelector('#modelDialog').open
+  )"));
+  EXPECT_EQ(true, content::EvalJs(contents(), R"(
+    window.findModelPage(document).shadowRoot
+        .querySelector('#modelDialog .action-button').disabled
+  )"));
+  ASSERT_TRUE(Key(ui::VKEY_ESCAPE));
+  ASSERT_TRUE(Wait(R"(
+    !window.findModelPage(document).shadowRoot.querySelector('#modelDialog').open
+  )"));
+  EXPECT_EQ(true, content::EvalJs(contents(), R"(
+    (() => {
+      const root = window.findModelPage(document).shadowRoot;
+      return root.activeElement === root.querySelector('[data-pack="ocr-eng"]');
+    })()
+  )"));
+  EXPECT_EQ(0, requests.load());
+  EXPECT_FALSE(base::PathExists(location->leaf));
+  base::test::TestFuture<base::expected<base::DictValue, std::string>>
+      no_download_consent;
+  models->Install(OcrPack().id, "ocr", false,
+                  no_download_consent.GetCallback());
+  EXPECT_FALSE(no_download_consent.Get().has_value());
+  EXPECT_EQ(0, requests.load());
+  EXPECT_FALSE(base::PathExists(location->leaf));
+}
