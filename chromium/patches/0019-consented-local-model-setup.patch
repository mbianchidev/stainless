+void StainlessLocalServicesHandler::ModelReply(
+    base::Value callback, base::expected<base::DictValue, std::string> result) {
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  if (!result.has_value()) {
+    RejectJavascriptCallback(callback, base::Value(result.error()));
+    return;
+  }
+  ResolveJavascriptCallback(callback, std::move(*result));
+}
