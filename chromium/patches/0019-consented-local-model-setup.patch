+      case 'image_descriptions': return 'Local machine-generated image descriptions';
+      default: return id;
+    }
+  }
+
+  private modelsVisible_(): boolean {
+    return this.isConnected &&
+        Router.getInstance().getCurrentRoute() === routes.LOCAL_SERVICES;
+  }
+
+  protected async onModelFeatureChange_(event: Event) {
+    const control = event.currentTarget as HTMLInputElement;
+    const feature = control.dataset['feature'];
+    if (!feature) {
+      this.modelError_ = 'The selected local feature is invalid.';
+      return;
+    }
+    ++this.modelsRequest_;
+    try {
+      const status = await sendWithPromise<ModelStatus>(
+          'stainlessConfigureModelFeature', {
+            feature, enabled: control.checked, consent: control.checked,
+          });
+      if (!this.modelsVisible_()) {
+        return;
+      }
+      this.models_ = status;
+      this.modelError_ = '';
+    } catch (error) {
+      if (!this.modelsVisible_()) {
+        return;
+      }
+      control.checked = !control.checked;
+      this.modelError_ = String(error);
+      await this.updateComplete;
+      this.$.modelError.focus();
+    }
+  }
+
+  protected modelFeatureFor_(pack: ModelPackStatus): string|null {
+    const features = this.models_?.features ?? [];
+    if (pack.feature === 'speech') {
+      return features.find(
+          value => value.enabled &&
+              (value.id === 'speech' || value.id === 'captions'))?.id ?? null;
+    }
+    const id = pack.feature === 'image_description' ?
+        'image_descriptions' : pack.feature;
+    return features.some(value => value.id === id && value.enabled) ? id : null;
+  }
