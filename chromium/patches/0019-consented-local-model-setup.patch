+#ifndef CHROME_BROWSER_STAINLESS_LOCAL_LOCAL_MODELS_H_
+#define CHROME_BROWSER_STAINLESS_LOCAL_LOCAL_MODELS_H_
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/time/time.h"
+#include "base/values.h"
+#include "chrome/browser/stainless_local/local_broker.h"
+#include "chrome/browser/stainless_local/model_storage.h"
+#include "components/keyed_service/core/keyed_service.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "services/network/public/cpp/simple_url_loader_stream_consumer.h"
+
+class Profile;
+class GURL;
+namespace net {
+struct RedirectInfo;
+}
+namespace network {
+class SimpleURLLoader;
+namespace mojom {
+class URLResponseHead;
+}
+}  // namespace network
+
+namespace stainless_local {
+
+class LocalModels final : public KeyedService,
+                          public network::SimpleURLLoaderStreamConsumer {
+ public:
+  using Reply =
+      base::OnceCallback<void(base::expected<base::DictValue, std::string>)>;
+  using AcquireReply = base::OnceCallback<void(
+      base::expected<model_storage::Acquired, std::string>)>;
+
+  static LocalModels* Get(Profile* profile);
+  explicit LocalModels(Profile* profile);
+  ~LocalModels() override;
+  void Shutdown() override;
+
+  base::DictValue Status();
+  base::expected<void, std::string> ConfigureFeature(const std::string& feature,
+                                                     bool enabled,
+                                                     bool consent);
+  void Install(const std::string& pack_id, const std::string& feature,
+               bool consent, Reply reply);
+  void CancelInstall(Reply reply);
+  void Remove(const std::string& archive_sha256, bool consent, Reply reply);
+  void AcquirePack(const std::string& pack_id, Feature feature,
+                   AcquireReply reply);
+  bool Ready(const std::string& pack_id) const;
+
+ private:
+  struct Operation;
+  void Refresh();
+  void OnInspected(
+      base::expected<model_storage::Inventory, std::string> result);
+  void OnReserved(
+      base::expected<std::unique_ptr<model_storage::Transaction>, std::string>
+          result);
+  void OnDataReceived(std::string_view bytes,
+                      base::OnceClosure resume) override;
+  void OnComplete(bool success) override;
+  void OnRetry(base::OnceClosure start_retry) override;
+  void OnWritten(base::OnceClosure resume,
+                 base::expected<void, std::string> result);
+  void OnInstalled(base::expected<void, std::string> result);
+  void Cleanup(std::string error);
+  void OnCleaned(std::string error, base::expected<void, std::string> result);
+  void OnRedirect(const GURL& previous, const net::RedirectInfo& redirect,
+                  const network::mojom::URLResponseHead& response,
+                  std::vector<std::string>* removed_headers);
+  void PreferencesChanged();
+  bool Permitted(Feature feature) const;
+
+  raw_ptr<Profile> profile_;
+  base::expected<model_storage::Location, std::string> location_;
+  std::optional<model_storage::Inventory> inventory_;
+  scoped_refptr<base::SequencedTaskRunner> storage_;
+  std::unique_ptr<Operation> operation_;
+  std::unique_ptr<network::SimpleURLLoader> loader_;
+  PrefChangeRegistrar preferences_;
+  std::string error_;
+  base::TimeTicks inspected_at_;
+  bool inspecting_ = false;
+  bool shutting_down_ = false;
+  base::WeakPtrFactory<LocalModels> weak_{this};
+};
+
+}  // namespace stainless_local
+
+#endif
