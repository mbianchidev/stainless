+#include "base/path_service.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/task/thread_pool.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/profiles/profile_keyed_service_factory.h"
+#include "chrome/browser/profiles/profile_selections.h"
+#include "chrome/common/chrome_paths.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/storage_partition.h"
+#include "net/base/load_flags.h"
+#include "net/base/net_errors.h"
+#include "net/http/http_response_headers.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "net/url_request/redirect_info.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "services/network/public/mojom/fetch_api.mojom.h"
+#include "services/network/public/mojom/url_response_head.mojom.h"
+#include "url/gurl.h"
+
+namespace stainless_local {
+namespace {
+
+constexpr std::array<std::pair<std::string_view, Feature>, 5> kFeatures = {{
+    {"translation", Feature::kTranslation},
+    {"ocr", Feature::kOcr},
+    {"speech", Feature::kSpeech},
+    {"captions", Feature::kCaptions},
+    {"image_descriptions", Feature::kImageDescriptions},
+}};
+
+constexpr auto kModelTraffic =
+    net::DefineNetworkTrafficAnnotation("stainless_consented_local_model", R"(
+      semantics {
+        sender: "Stainless optional local model setup"
+        description:
+          "Downloads a source-compiled, hash-pinned data-only model pack after "
+          "explicit native Settings consent. Models run locally without "
+          "inference-content uploads or remote inference."
+        trigger: "The regular-profile user confirms a named model download."
+        data:
+          "The fixed asset name reveals a feature/language selection. Ordinary "
+          "IP, timing and User-Agent metadata are visible to GitHub/CDN. No "
+          "cookies, referrer, private update token or inference content."
+        destination: OTHER
+        destination_other:
+          "github.com and its exact reviewed release-asset CDN hosts."
+      }
+      policy {
+        cookies_allowed: NO
+        setting: "Off by default; separate per-profile feature and download consent."
+        policy_exception_justification:
+          "An explicit optional user download without a cloud fallback."
+      })");
+
+const ModelPack* FindPack(std::string_view id) {
+  const auto found = std::ranges::find(ModelCatalog(), id, &ModelPack::id);
+  return found == ModelCatalog().end() ? nullptr : &*found;
+}
+
+std::optional<Feature> FindFeature(std::string_view id) {
+  for (const auto& [name, feature] : kFeatures) {
+    if (name == id) {
+      return feature;
+    }
+  }
+  return std::nullopt;
+}
+
+bool Matches(const ModelPack& pack, Feature feature) {
+  switch (feature) {
+    case Feature::kTranslation:
+      return pack.feature == "translation";
+    case Feature::kOcr:
+      return pack.feature == "ocr";
+    case Feature::kSpeech:
+    case Feature::kCaptions:
+      return pack.feature == "speech";
+    case Feature::kImageDescriptions:
+      return pack.feature == "image_description";
+  }
+}
+
+bool DownloadDestination(const GURL& url) {
+  return url.is_valid() && url.SchemeIs("https") && !url.has_username() &&
+         !url.has_password() && !url.has_ref() &&
+         (!url.has_port() || url.EffectiveIntPort() == 443) &&
+         (url.host() == "github.com" ||
+          url.host() == "release-assets.githubusercontent.com" ||
+          url.host() == "objects.githubusercontent.com");
+}
+
+base::expected<model_storage::Location, std::string> Location() {
+  base::FilePath root;
+  if (!base::PathService::Get(chrome::DIR_USER_DATA, &root)) {
+    return base::unexpected("The active user-data root could not be resolved");
+  }
+  return model_storage::ResolveLocation(root);
+}
+
+class ModelFactory final : public ProfileKeyedServiceFactory {
+ public:
+  static ModelFactory* Get() {
+    static base::NoDestructor<ModelFactory> factory;
+    return factory.get();
+  }
+  LocalModels* ForProfile(Profile* profile) {
+    return static_cast<LocalModels*>(
+        GetServiceForBrowserContext(profile, true));
+  }
+  ModelFactory()
+      : ProfileKeyedServiceFactory(
+            "StainlessLocalModels",
+            ProfileSelections::Builder()
+                .WithRegular(ProfileSelection::kOriginalOnly)
+                .WithGuest(ProfileSelection::kNone)
+                .WithSystem(ProfileSelection::kNone)
+                .Build()) {}
+
+ private:
+  std::unique_ptr<KeyedService> BuildServiceInstanceForBrowserContext(
+      content::BrowserContext* context) const override {
+    return std::make_unique<LocalModels>(Profile::FromBrowserContext(context));
+  }
+};
+
+}  // namespace
+
+struct LocalModels::Operation {
+  std::string pack_id;
+  Feature feature;
+  std::string state = "preparing";
+  uint64_t received = 0;
+  bool cancelling = false;
+  bool cleaning = false;
+  bool installing = false;
+  bool committed_before_cancel = false;
+  std::shared_ptr<model_storage::Transaction> transaction;
+  Reply reply;
+  Reply cancel_reply;
+};
+
+LocalModels* LocalModels::Get(Profile* profile) {
+  return IsEligibleProfile(profile) ? ModelFactory::Get()->ForProfile(profile)
+                                    : nullptr;
+}
+
+LocalModels::LocalModels(Profile* profile)
+    : profile_(profile),
+      location_(Location()),
+      storage_(base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+           base::TaskShutdownBehavior::BLOCK_SHUTDOWN})) {
+  preferences_.Init(profile_->GetPrefs());
+  for (const auto& [name, feature] : kFeatures) {
+    preferences_.Add(FeaturePreference(feature),
+                     base::BindRepeating(&LocalModels::PreferencesChanged,
+                                         weak_.GetWeakPtr()));
+  }
+}
+
+LocalModels::~LocalModels() { Shutdown(); }
+
+void LocalModels::Shutdown() {
+  if (shutting_down_) {
+    return;
+  }
+  shutting_down_ = true;
+  weak_.InvalidateWeakPtrs();
+  preferences_.RemoveAll();
+  loader_.reset();
+  if (operation_ && operation_->transaction) {
+    auto transaction = operation_->transaction;
+    transaction->cancelled->store(true);
+    if (!storage_->PostTask(
+            FROM_HERE,
+            base::BindOnce(
+                [](std::shared_ptr<model_storage::Transaction> value) {
+                  auto result = model_storage::Cancel(*value);
+                  if (!result.has_value()) {
+                    LOG(ERROR) << "Stainless model setup: shutdown "
+                                  "cleanup failed; owned reservation retained";
+                  }
+                },
+                std::move(transaction)))) {
+      LOG(ERROR)
+          << "Stainless model setup: shutdown cleanup could not be queued";
+    }
+  }
+  operation_.reset();
+}
+
+bool LocalModels::Permitted(Feature feature) const {
+  return !shutting_down_ && IsEligibleProfile(profile_) &&
+         profile_->GetPrefs()->GetBoolean(FeaturePreference(feature));
+}
+
+base::expected<void, std::string> LocalModels::ConfigureFeature(
+    const std::string& id, bool enabled, bool consent) {
+  const auto feature = FindFeature(id);
+  if (!IsEligibleProfile(profile_) || !feature || (enabled && !consent)) {
+    return base::unexpected(
+        "Explicit eligible-profile feature consent is required");
+  }
+  profile_->GetPrefs()->SetBoolean(FeaturePreference(*feature), enabled);
+  return {};
+}
+
+void LocalModels::PreferencesChanged() {
+  if (operation_ && !Permitted(operation_->feature)) {
+    operation_->cancelling = true;
+    if (operation_->transaction) {
+      operation_->transaction->cancelled->store(true);
+      if (!operation_->installing) {
+        Cleanup("Model setup was cancelled because feature consent changed");
+      }
+    }
+  }
+}
+
+base::DictValue LocalModels::Status() {
+  if (!inspecting_ && !operation_ &&
+      (inspected_at_.is_null() ||
+       base::TimeTicks::Now() - inspected_at_ >= base::Seconds(5))) {
+    Refresh();
+  }
+  base::ListValue features;
+  for (const auto& [id, feature] : kFeatures) {
+    features.Append(base::DictValue()
+                        .Set("id", std::string(id))
+                        .Set("enabled", Permitted(feature)));
+  }
+  base::ListValue packs;
+  for (const auto& pack : ModelCatalog()) {
+    std::string state = error_.empty() ? "not installed" : "error";
+    if (inventory_) {
+      for (const auto& stored : inventory_->packs) {
+        if (stored.current && stored.archive_sha256 == pack.archive_sha256) {
+          state = stored.state;
+        }
+      }
+    }
+    if (operation_ && operation_->pack_id == pack.id) {
+      state = operation_->state;
+    } else if (inspecting_) {
+      state = "verifying";
+    }
+    base::ListValue languages;
+    for (const auto& language : pack.languages) {
+      languages.Append(language);
+    }
+    packs.Append(
+        base::DictValue()
+            .Set("id", pack.id)
+            .Set("feature", pack.feature)
+            .Set("name", pack.name)
+            .Set("url", pack.url)
+            .Set("license", pack.license)
+            .Set("archive", pack.archive_sha256)
+            .Set("archiveBytes", base::NumberToString(pack.archive_bytes))
+            .Set("unpackedBytes", base::NumberToString(pack.unpacked_bytes))
+            .Set("languages", std::move(languages))
+            .Set("state", state));
+  }
+  base::ListValue versions;
+  if (inventory_) {
+    for (const auto& item : inventory_->packs) {
+      versions.Append(base::DictValue()
+                          .Set("id", item.id)
+                          .Set("archive", item.archive_sha256)
+                          .Set("state", item.state)
+                          .Set("bytes", base::NumberToString(item.bytes))
+                          .Set("current", item.current));
+    }
+  }
+  return base::DictValue()
+      .Set("available", IsEligibleProfile(profile_) && location_.has_value())
+      .Set("inspecting", inspecting_)
+      .Set("busy", operation_ != nullptr)
+      .Set("error", location_.has_value() ? error_ : location_.error())
+      .Set("path", location_.has_value() ? location_->leaf.value() : "")
+      .Set("limitBytes",
+           base::NumberToString(model_storage::kMaximumCacheBytes))
+      .Set("storedBytes",
+           inventory_ ? base::NumberToString(inventory_->stored_bytes) : "")
+      .Set("reservedBytes",
+           inventory_ ? base::NumberToString(inventory_->reserved_bytes) : "")
+      .Set("receivedBytes",
+           operation_ ? base::NumberToString(operation_->received) : "0")
+      .Set("features", std::move(features))
+      .Set("packs", std::move(packs))
+      .Set("versions", std::move(versions));
+}
+
+void LocalModels::Refresh() {
+  if (!IsEligibleProfile(profile_) || !location_.has_value() || inspecting_) {
+    return;
+  }
+  inspecting_ = true;
+  if (!storage_->PostTaskAndReplyWithResult(
+          FROM_HERE,
+          base::BindOnce(&model_storage::Inspect, *location_,
+                         !inventory_.has_value()),
+          base::BindOnce(&LocalModels::OnInspected, weak_.GetWeakPtr()))) {
+    inspecting_ = false;
+    error_ = "Model cache verification could not be scheduled";
+    LOG(ERROR) << "Stainless model setup: inspection scheduling failed";
+  }
+}
+
+void LocalModels::OnInspected(
+    base::expected<model_storage::Inventory, std::string> result) {
+  inspecting_ = false;
+  inspected_at_ = base::TimeTicks::Now();
+  if (!result.has_value()) {
+    error_ = result.error();
+    inventory_.reset();
+    return;
+  }
+  inventory_ = std::move(*result);
+  error_.clear();
+}
+
+bool LocalModels::Ready(const std::string& id) const {
+  const auto* pack = FindPack(id);
+  return pack && error_.empty() && inventory_ &&
+         std::ranges::any_of(inventory_->packs, [&](const auto& item) {
+           return item.current && item.archive_sha256 == pack->archive_sha256 &&
+                  item.state == "ready";
+         });
+}
+
+void LocalModels::Install(const std::string& id, const std::string& feature_id,
+                          bool consent, Reply reply) {
+  const auto* pack = FindPack(id);
+  const auto feature = FindFeature(feature_id);
+  if (!pack || !feature || !Matches(*pack, *feature) || !Permitted(*feature) ||
+      !consent || !location_.has_value() || operation_) {
+    std::move(reply).Run(
+        base::unexpected("A named compiled pack, enabled feature and explicit "
+                         "download consent are required"));
+    return;
+  }
+  if (!DownloadDestination(GURL(pack->url)) ||
+      !pack->url.starts_with("https://github.com/mbianchidev/stainless/"
+                             "releases/download/stainless-models-v1/")) {
+    std::move(reply).Run(
+        base::unexpected("The compiled model destination is invalid"));
+    return;
+  }
+  operation_ = std::make_unique<Operation>();
+  operation_->pack_id = id;
+  operation_->feature = *feature;
+  operation_->reply = std::move(reply);
+  error_.clear();
+  if (!storage_->PostTaskAndReplyWithResult(
+          FROM_HERE, base::BindOnce(&model_storage::Reserve, *location_, *pack),
+          base::BindOnce(&LocalModels::OnReserved, weak_.GetWeakPtr()))) {
+    OnReserved(base::unexpected("Model reservation could not be scheduled"));
+  }
+}
+
+void LocalModels::OnReserved(
+    base::expected<std::unique_ptr<model_storage::Transaction>, std::string>
+        result) {
+  if (!operation_) {
+    LOG(ERROR) << "Stainless model setup: orphan reservation completion";
+    return;
+  }
+  if (!result.has_value()) {
+    auto reply = std::move(operation_->reply);
+    auto cancelled = std::move(operation_->cancel_reply);
+    error_ = result.error();
+    operation_.reset();
+    std::move(reply).Run(base::unexpected(error_));
+    if (cancelled) {
+      std::move(cancelled).Run(base::unexpected(error_));
+    }
+    return;
+  }
+  operation_->transaction =
+      std::shared_ptr<model_storage::Transaction>(std::move(*result));
+  if (operation_->cancelling || !Permitted(operation_->feature)) {
+    Cleanup("Model setup was cancelled");
+    return;
+  }
+  operation_->state = "downloading";
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = GURL(operation_->transaction->pack.url);
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->referrer = GURL();
+  request->do_not_prompt_for_login = true;
+  request->load_flags = net::LOAD_BYPASS_CACHE | net::LOAD_DISABLE_CACHE |
+                        net::LOAD_DO_NOT_SAVE_COOKIES |
+                        net::LOAD_DO_NOT_USE_EMBEDDED_IDENTITY;
+  loader_ = network::SimpleURLLoader::Create(std::move(request), kModelTraffic);
+  loader_->SetTimeoutDuration(base::Minutes(15));
+  loader_->SetOnRedirectCallback(
+      base::BindRepeating(&LocalModels::OnRedirect, weak_.GetWeakPtr()));
+  loader_->DownloadAsStream(profile_->GetDefaultStoragePartition()
+                                ->GetURLLoaderFactoryForBrowserProcess()
+                                .get(),
+                            this);
+}
+
+void LocalModels::OnRedirect(const GURL&, const net::RedirectInfo& redirect,
+                             const network::mojom::URLResponseHead&,
+                             std::vector<std::string>* removed) {
+  if (!DownloadDestination(redirect.new_url)) {
+    Cleanup("Model download refused an unreviewed redirect destination");
+    return;
+  }
+  for (const char* name :
+       {"Authorization", "Proxy-Authorization", "Cookie", "Referer"}) {
+    removed->emplace_back(name);
+  }
+}
+
+void LocalModels::OnDataReceived(std::string_view bytes,
+                                 base::OnceClosure resume) {
+  if (!operation_ || !operation_->transaction ||
+      !Permitted(operation_->feature) || bytes.size() > 1048576 ||
+      bytes.size() >
+          operation_->transaction->pack.archive_bytes - operation_->received) {
+    Cleanup("Model download exceeded its exact byte limit or lost consent");
+    return;
+  }
+  operation_->received += bytes.size();
+  if (!storage_->PostTaskAndReplyWithResult(
+          FROM_HERE,
+          base::BindOnce(
+              [](std::shared_ptr<model_storage::Transaction> transaction,
+                 std::string bytes) -> base::expected<void, std::string> {
+                if (transaction->cancelled->load() ||
+                    !transaction->archive_file.WriteAtCurrentPosAndCheck(
+                        base::as_byte_span(bytes))) {
+                  return base::unexpected(
+                      "Model download data could not be written");
+                }
+                return {};
+              },
+              operation_->transaction, std::string(bytes)),
+          base::BindOnce(&LocalModels::OnWritten, weak_.GetWeakPtr(),
+                         std::move(resume)))) {
+    Cleanup("Model download writing could not be scheduled");
+  }
+}
+
+void LocalModels::OnWritten(base::OnceClosure resume,
+                            base::expected<void, std::string> result) {
+  if (!operation_ || operation_->cleaning) {
+    return;
+  }
+  if (!result.has_value()) {
+    Cleanup(result.error());
+    return;
+  }
+  std::move(resume).Run();
+}
+
+void LocalModels::OnComplete(bool success) {
+  if (!operation_ || !operation_->transaction) {
+    return;
+  }
+  int response = 0;
+  if (loader_->ResponseInfo() && loader_->ResponseInfo()->headers) {
+    response = loader_->ResponseInfo()->headers->response_code();
+  }
+  if (!success ||
+      operation_->received != operation_->transaction->pack.archive_bytes) {
+    Cleanup(response == 404
+                ? "Model asset is not published or is missing"
+                : "Model download failed or returned incomplete data");
+    return;
+  }
+  loader_.reset();
+  operation_->state = "verifying";
+  operation_->installing = true;
+  if (!storage_->PostTaskAndReplyWithResult(
+          FROM_HERE,
+          base::BindOnce(
+              [](std::shared_ptr<model_storage::Transaction> transaction) {
+                return model_storage::Install(*transaction);
+              },
+              operation_->transaction),
+          base::BindOnce(&LocalModels::OnInstalled, weak_.GetWeakPtr()))) {
+    operation_->installing = false;
+    Cleanup("Model verification could not be scheduled");
+  }
+}
+
+void LocalModels::OnRetry(base::OnceClosure) {
+  Cleanup("Automatic model download retries are not enabled");
+}
+
+void LocalModels::OnInstalled(base::expected<void, std::string> result) {
+  operation_->installing = false;
+  if (operation_->cancelling && result.has_value()) {
+    operation_->committed_before_cancel = true;
+    Cleanup(
+        "Model installation completed before cancellation; remove the pack "
+        "explicitly");
+    return;
+  }
+  if (!result.has_value()) {
+    Cleanup(result.error());
+    return;
+  }
+  auto reply = std::move(operation_->reply);
+  operation_.reset();
+  inventory_.reset();
+  inspected_at_ = {};
+  Refresh();
+  std::move(reply).Run(Status());
+}
+
+void LocalModels::Cleanup(std::string error) {
+  if (!operation_ || operation_->cleaning) {
+    return;
+  }
+  loader_.reset();
+  operation_->cleaning = true;
+  operation_->state = "cancelling";
+  if (!operation_->transaction) {
+    operation_->cancelling = true;
+    return;
+  }
+  operation_->transaction->cancelled->store(true);
+  const std::string retained_error = error;
+  if (!storage_->PostTaskAndReplyWithResult(
+          FROM_HERE,
+          base::BindOnce(
+              [](std::shared_ptr<model_storage::Transaction> transaction) {
+                return model_storage::Cancel(*transaction);
+              },
+              operation_->transaction),
+          base::BindOnce(&LocalModels::OnCleaned, weak_.GetWeakPtr(),
+                         std::move(error)))) {
+    OnCleaned(
+        retained_error,
+        base::unexpected(
+            "Cleanup could not be scheduled; owned reservation retained"));
+  }
+}
+
+void LocalModels::OnCleaned(std::string error,
+                            base::expected<void, std::string> result) {
+  auto reply = std::move(operation_->reply);
+  auto cancel_reply = std::move(operation_->cancel_reply);
+  const bool committed_before_cancel = operation_->committed_before_cancel;
+  operation_.reset();
+  error_ = result.has_value() ? std::move(error) : result.error();
+  inventory_.reset();
+  inspected_at_ = {};
+  std::move(reply).Run(base::unexpected(error_));
+  if (cancel_reply) {
+    if (result.has_value() && !committed_before_cancel) {
+      std::move(cancel_reply).Run(Status());
+    } else {
+      std::move(cancel_reply).Run(base::unexpected(error_));
+    }
+  }
+}
+
+void LocalModels::CancelInstall(Reply reply) {
+  if (!operation_ || operation_->cancel_reply) {
+    std::move(reply).Run(
+        base::unexpected("There is no cancellable model setup"));
+    return;
+  }
+  operation_->cancel_reply = std::move(reply);
+  operation_->cancelling = true;
+  if (operation_->transaction) {
+    operation_->transaction->cancelled->store(true);
+    if (!operation_->installing) {
+      Cleanup("Model setup was cancelled");
+    } else {
+      operation_->state = "cancelling";
+    }
+  }
+}
+
+void LocalModels::Remove(const std::string& hash, bool consent, Reply reply) {
+  if (!IsEligibleProfile(profile_) || !location_.has_value() || !consent ||
+      operation_) {
+    std::move(reply).Run(
+        base::unexpected("Confirm owned cache removal; all profiles in this "
+                         "root lose the selected pack"));
+    return;
+  }
+  auto replies = base::SplitOnceCallback(std::move(reply));
+  if (!storage_->PostTaskAndReplyWithResult(
+          FROM_HERE, base::BindOnce(&model_storage::Remove, *location_, hash),
+          base::BindOnce(
+              [](base::WeakPtr<LocalModels> owner, Reply reply,
+                 base::expected<void, std::string> result) {
+                if (!owner) {
+                  return;
+                }
+                if (!result.has_value()) {
+                  std::move(reply).Run(base::unexpected(result.error()));
+                  return;
+                }
+                owner->inventory_.reset();
+                owner->inspected_at_ = {};
+                owner->Refresh();
+                std::move(reply).Run(owner->Status());
+              },
+              weak_.GetWeakPtr(), std::move(replies.first)))) {
+    std::move(replies.second)
+        .Run(base::unexpected("Owned model removal could not be scheduled"));
+  }
+}
+
+void LocalModels::AcquirePack(const std::string& id, Feature feature,
+                              AcquireReply reply) {
+  const auto* pack = FindPack(id);
+  if (!pack || !Matches(*pack, feature) || !Permitted(feature) ||
+      !location_.has_value()) {
+    std::move(reply).Run(
+        base::unexpected("The local feature/model lacks profile consent"));
+    return;
+  }
+  auto replies = base::SplitOnceCallback(std::move(reply));
+  if (!storage_->PostTaskAndReplyWithResult(
+          FROM_HERE, base::BindOnce(&model_storage::Acquire, *location_, id),
+          base::BindOnce(
+              [](base::WeakPtr<LocalModels> owner, Feature feature,
+                 AcquireReply reply,
+                 base::expected<model_storage::Acquired, std::string> result) {
+                if (!owner || !owner->Permitted(feature)) {
+                  std::move(reply).Run(
+                      base::unexpected("Model authorization expired"));
+                  return;
+                }
+                std::move(reply).Run(std::move(result));
+              },
+              weak_.GetWeakPtr(), feature, std::move(replies.first)))) {
+    std::move(replies.second)
+        .Run(base::unexpected(
+            "Verified model acquisition could not be scheduled"));
+  }
+}
+
+}  // namespace stainless_local
