+void StainlessLocalServicesHandler::GetModelStatus(
+    const base::ListValue& args) {
+  if (!ValidateRequest(args, 1)) {
+    return;
+  }
+  auto* models = Models(web_ui());
+  if (!models) {
+    ResolveJavascriptCallback(
+        args[0],
+        base::DictValue()
+            .Set("available", false)
+            .Set("busy", false)
+            .Set("inspecting", false)
+            .Set("error",
+                 "Local model setup is unavailable in this browsing mode")
+            .Set("features", base::ListValue())
+            .Set("packs", base::ListValue())
+            .Set("versions", base::ListValue())
+            .Set("storedBytes", "")
+            .Set("reservedBytes", "")
+            .Set("receivedBytes", "0")
+            .Set("limitBytes", "4294967296")
+            .Set("path", ""));
+    return;
+  }
+  ResolveJavascriptCallback(args[0], models->Status());
+}
+
+void StainlessLocalServicesHandler::ConfigureModelFeature(
+    const base::ListValue& args) {
+  if (!ValidateRequest(args, 2)) {
+    return;
+  }
+  const auto* value = args[1].GetIfDict();
+  const auto* feature = value ? value->FindString("feature") : nullptr;
+  const auto enabled = value ? value->FindBool("enabled") : std::nullopt;
+  const auto consent = value ? value->FindBool("consent") : std::nullopt;
+  auto* models = Models(web_ui());
+  if (!value || value->size() != 3 || !feature || !enabled || !consent ||
+      !models) {
+    RejectJavascriptCallback(
+        args[0], base::Value("Valid local feature consent is required"));
+    return;
+  }
+  const auto result = models->ConfigureFeature(*feature, *enabled, *consent);
+  if (!result.has_value()) {
+    RejectJavascriptCallback(args[0], base::Value(result.error()));
+    return;
+  }
+  ResolveJavascriptCallback(args[0], models->Status());
+}
+
+void StainlessLocalServicesHandler::InstallModel(const base::ListValue& args) {
+  if (!ValidateRequest(args, 2)) {
+    return;
+  }
+  const auto* value = args[1].GetIfDict();
+  const auto* pack = value ? value->FindString("pack") : nullptr;
+  const auto* feature = value ? value->FindString("feature") : nullptr;
+  const auto consent = value ? value->FindBool("consent") : std::nullopt;
+  auto* models = Models(web_ui());
+  if (!value || value->size() != 3 || !pack || !feature || !consent ||
+      !models) {
+    RejectJavascriptCallback(
+        args[0], base::Value("Confirm the exact model pack download"));
+    return;
+  }
+  models->Install(*pack, *feature, *consent,
+                  base::BindOnce(&StainlessLocalServicesHandler::ModelReply,
+                                 weak_.GetWeakPtr(), args[0].Clone()));
+}
+
+void StainlessLocalServicesHandler::CancelModel(const base::ListValue& args) {
+  if (!ValidateRequest(args, 1)) {
+    return;
+  }
+  auto* models = Models(web_ui());
+  if (!models) {
+    RejectJavascriptCallback(args[0],
