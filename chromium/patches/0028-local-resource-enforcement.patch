+// Linked only into this dedicated test executable, never the browser app.
+class SyntheticResourceWorker final : public mojom::LocalWorker {
+ public:
+  explicit SyntheticResourceWorker(
+      mojo::PendingReceiver<mojom::LocalWorker> receiver)
+      : receiver_(this, std::move(receiver)) {}
+
+  void Translate(mojom::TranslationModelPtr,
+                 const std::string& text,
+                 TranslateCallback reply) override {
+    if (reply_ || (text != kGrow && text != kWait && text != kAllocation)) {
+      std::move(reply).Run(Refused());
+      return;
+    }
+    if (text == kAllocation) {
+      auto result = mojom::Result::New();
+      result->status = mojom::Status::kResourceLimit;
+      result->detail = "Synthetic native allocation limit before RSS cutoff";
+      std::move(reply).Run(std::move(result));
+      return;
+    }
+    reply_ = std::move(reply);
+    if (text == kWait) {
+      return;
+    }
+    uint64_t entropy = 0x535441494e4c4553;
+    memory_.reserve(65);
+    for (int chunk = 0; chunk < 65; ++chunk) {
+      memory_.push_back(
+          base::HeapArray<uint64_t>::Uninit(33554432 / sizeof(uint64_t)));
+      for (auto& word : memory_.back()) {
+        entropy ^= entropy << 13;
+        entropy ^= entropy >> 7;
+        entropy ^= entropy << 17;
+        word = entropy;
+      }
+    }
+  }
+
+  void ReadImageText(mojom::ModelFilePtr,
+                     const std::string&,
+                     mojom::ImagePtr,
+                     ReadImageTextCallback reply) override {
+    std::move(reply).Run(Refused());
+  }
+  void RecognizeSpeech(mojom::ModelFilePtr,
+                       const std::vector<int16_t>&,
+                       const std::string&,
+                       RecognizeSpeechCallback reply) override {
+    std::move(reply).Run(Refused());
+  }
+  void DescribeImage(mojom::ModelFilePtr,
+                     mojom::ModelFilePtr,
+                     mojom::ImagePtr,
+                     DescribeImageCallback reply) override {
+    std::move(reply).Run(Refused());
+  }
+
+ private:
+  mojo::Receiver<mojom::LocalWorker> receiver_;
+  TranslateCallback reply_;
+  std::vector<base::HeapArray<uint64_t>> memory_;
+};
+
+auto CreateSyntheticWorker(mojo::PendingReceiver<mojom::LocalWorker> receiver) {
+  return std::make_unique<SyntheticResourceWorker>(std::move(receiver));
+}
