+IN_PROC_BROWSER_TEST_F(StainlessLocalResourceBrowserTest,
+                       MANUAL_RequestAndQueueDeadlinesIncludeWaiting) {
+  base::test::ScopedRunLoopTimeout timeout(FROM_HERE, base::Seconds(75));
+  base::test::TestFuture<mojom::ResultPtr> first;
+  base::test::TestFuture<mojom::ResultPtr> second;
+  const auto started = base::TimeTicks::Now();
+  Submit(kWait, first.GetCallback());
+  const auto queued = base::TimeTicks::Now();
+  QueueWaiting(second.GetCallback());
+  base::ScopedAllowBlockingForTesting blocking;
+  base::ScopedNativeLibrary sandbox(
+      base::FilePath("/usr/lib/libsandbox.1.dylib"));
+  ASSERT_TRUE(sandbox.is_valid());
+  const auto sandbox_check = reinterpret_cast<int (*)(int, const char*, int)>(
+      sandbox.GetFunctionPointer("sandbox_check"));
+  ASSERT_TRUE(sandbox_check);
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return process_.IsValid() && !created_.is_null() &&
+           process_.CreationTime() == created_ &&
+           sandbox_check(process_.Pid(), nullptr, 0) == 1;
+  }));
+  ASSERT_TRUE(first.Get());
+  const auto first_elapsed = base::TimeTicks::Now() - started;
+  EXPECT_EQ(mojom::Status::kTimedOut, first.Get()->status);
+  ASSERT_TRUE(second.Get());
+  const auto second_elapsed = base::TimeTicks::Now() - queued;
+  EXPECT_EQ(mojom::Status::kTimedOut, second.Get()->status);
+  EXPECT_GE(first_elapsed, base::Seconds(60));
+  EXPECT_LE(first_elapsed, base::Seconds(61));
+  EXPECT_GE(second_elapsed, base::Seconds(60));
+  EXPECT_LE(second_elapsed, base::Seconds(61));
+  CheckVisibleBudgetError("60 seconds");
+  ASSERT_TRUE(first.Get()->worker_usage);
+  const auto& usage = *first.Get()->worker_usage;
+  EXPECT_GT(usage.samples, 1u);
+  EXPECT_LE(usage.maximum_sample_gap_microseconds, 250000u);
+  LOG(INFO) << "Stainless synthetic deadline proof: active_ms="
+            << first_elapsed.InMilliseconds()
+            << " queued_ms=" << second_elapsed.InMilliseconds()
+            << " samples=" << usage.samples
+            << " maximum_gap_us=" << usage.maximum_sample_gap_microseconds;
+}
+
+int RunResourceTests(int argc, char** argv) {
+  base::CommandLine::Init(argc, argv);
+  base::CommandLine::ForCurrentProcess()->AppendSwitchASCII(
+      "test-launcher-jobs", "1");
+  ChromeTestSuiteRunner runner;
+  ResourceLauncher delegate(&runner);
+  return LaunchChromeTests(1, &delegate, argc, argv);
+}
+
+}  // namespace stainless_local
+
+int main(int argc, char** argv) {
+  return stainless_local::RunResourceTests(argc, argv);
+}
