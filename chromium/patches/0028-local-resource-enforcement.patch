+constexpr uint64_t kGiB = 1073741824;
+constexpr char kGrow[] = "fictional bounded RSS probe";
+constexpr char kWait[] = "fictional bounded deadline probe";
+constexpr char kAllocation[] = "fictional native allocation failure";
+constexpr char kModel[] = "fictional resource-test model";
+
+mojom::ResultPtr Refused() {
+  auto result = mojom::Result::New();
+  result->status = mojom::Status::kInvalidInput;
+  result->detail = "Unsupported synthetic resource-test operation";
+  return result;
+}
