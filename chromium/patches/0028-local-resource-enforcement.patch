+class StainlessLocalResourceBrowserTest
+    : public InProcessBrowserTest,
+      public content::ServiceProcessHost::Observer {
+ public:
+  void SetUpCommandLine(base::CommandLine* command) override {
+    const auto summary =
+        base::CommandLine::ForCurrentProcess()->GetSwitchValuePath(
+            "test-launcher-summary-output");
+    ASSERT_TRUE(summary.IsAbsolute());
+    ASSERT_TRUE(cache_.CreateUniqueTempDirUnderPath(summary.DirName()));
+    ASSERT_TRUE(data_.CreateUniqueTempDirUnderPath(summary.DirName()));
+    base::FilePath canonical;
+    ASSERT_TRUE(base::NormalizeFilePath(cache_.GetPath(), &canonical));
+    command->AppendSwitchPath("disk-cache-dir", canonical);
+    command->AppendSwitchASCII("headless", "new");
+    command->AppendSwitch("use-mock-keychain");
+    command->AppendSwitch("disable-audio-input");
+    command->AppendSwitch("disable-audio-output");
+    command->AppendSwitchASCII("lang", "en-US");
+  }
+
+  void SetUpOnMainThread() override {
+    ASSERT_TRUE(display::Screen::Get()->IsHeadless());
+    content::ServiceProcessHost::AddObserver(this);
+    ASSERT_TRUE(embedded_test_server()->Start());
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(
+        browser(), embedded_test_server()->GetURL("/empty.html")));
+    {
+      base::ScopedAllowBlockingForTesting blocking;
+      model_ = data_.GetPath().AppendASCII("synthetic-model");
+      ASSERT_TRUE(base::WriteFile(model_, kModel));
+    }
+    auto* models = LocalModels::Get(browser()->GetProfile());
+    ASSERT_TRUE(models);
+    ASSERT_TRUE(
+        models->ConfigureFeature("translation", true, true).has_value());
+  }
+
+  void TearDownOnMainThread() override {
+    memory_safety_.Stop();
+    for (const auto& id : jobs_) {
+      LocalBroker::Get().Cancel(id);
+    }
+    pending_.Reset();
+    EXPECT_TRUE(base::test::RunUntil([&] {
+      for (const auto& info :
+           content::ServiceProcessHost::GetRunningProcessInfo()) {
+        if (info.IsService<mojom::LocalWorker>()) {
+          return false;
+        }
+      }
+      return true;
+    }));
+    content::ServiceProcessHost::RemoveObserver(this);
+  }
+
+  content::RenderFrameHost* frame() {
+    return browser()
+        ->GetTabStripModel()
+        ->GetActiveWebContents()
+        ->GetPrimaryMainFrame();
+  }
+
+  void Submit(const char* mode, LocalBroker::Reply reply) {
+    jobs_.push_back(LocalBroker::Get().Submit(
+        frame(), Feature::kTranslation,
+        base::BindOnce(&StainlessLocalResourceBrowserTest::Prepare,
+                       base::Unretained(this), mode),
+        std::move(reply)));
+    ASSERT_FALSE(jobs_.back().is_empty());
+  }
+
+  void QueueWaiting(LocalBroker::Reply reply) {
+    jobs_.push_back(LocalBroker::Get().Submit(
+        frame(), Feature::kTranslation,
+        base::BindOnce(
+            [](StainlessLocalResourceBrowserTest* test,
+               LocalBroker::Ready ready) { test->pending_ = std::move(ready); },
+            base::Unretained(this)),
+        std::move(reply)));
+    ASSERT_FALSE(jobs_.back().is_empty());
+  }
+
+  void Prepare(const char* mode, LocalBroker::Ready ready) {
+    base::ScopedAllowBlockingForTesting blocking;
+    auto make_file = [&](const char* name) {
+      auto file = mojom::ModelFile::New();
+      file->name = name;
+      file->file =
+          base::File(model_, base::File::FLAG_OPEN | base::File::FLAG_READ);
+      CHECK(file->file.IsValid());
+      file->size = std::char_traits<char>::length(kModel);
+      const auto hash = crypto::hash::Sha256(kModel);
+      file->sha256.assign(hash.begin(), hash.end());
+      return file;
+    };
+    auto model = mojom::TranslationModel::New();
+    for (const char* name :
+         {"model.bin", "config.json", "shared_vocabulary.json"}) {
+      model->files.push_back(make_file(name));
+    }
+    model->source_tokenizer = make_file("source.spm");
+    model->target_tokenizer = make_file("target.spm");
+    auto request = mojom::TranslationRequest::New();
+    request->model = std::move(model);
+    request->text = mode;
+    LocalBroker::Prepared prepared;
+    prepared.request = mojom::Request::NewTranslation(std::move(request));
+    std::move(ready).Run(std::move(prepared));
+  }
+
+  void OnServiceProcessLaunched(
+      const content::ServiceProcessInfo& info) override {
+    if (info.IsService<mojom::LocalWorker>()) {
+      process_ = info.GetProcess().Duplicate();
+      created_ = process_.CreationTime();
+      service_id_ = info.service_process_id();
+    }
+  }
+  void OnServiceProcessTerminatedNormally(
+      const content::ServiceProcessInfo& info) override {
+    Exited(info);
+  }
+  void OnServiceProcessCrashed(
+      const content::ServiceProcessInfo& info) override {
+    Exited(info);
+  }
+
+  void Exited(const content::ServiceProcessInfo& info) {
+    if (service_id_ && info.service_process_id() == *service_id_) {
+      exited_ = base::TimeTicks::Now();
+    }
+  }
+
+  void StartMemorySafetyGuard() {
+    memory_safety_.Start(
+        FROM_HERE, base::Milliseconds(200),
+        base::BindRepeating(
+            [](StainlessLocalResourceBrowserTest* test) {
+              if (base::SysInfo::AmountOfAvailablePhysicalMemory().InBytes() <
+                  4 * kGiB) {
+                ADD_FAILURE() << "Aborting owned probe at host memory floor";
+                for (const auto& id : test->jobs_) {
+                  LocalBroker::Get().Cancel(id);
+                }
+                test->memory_safety_.Stop();
+              }
+            },
+            base::Unretained(this)));
+  }
+
+  void CheckVisibleBudgetError(const char* expected) {
+    const auto status = LocalModels::Get(browser()->GetProfile())->Status();
+    const auto* runtime = status.FindList("runtime");
+    ASSERT_TRUE(runtime);
+    bool visible_error = false;
+    for (const auto& item : *runtime) {
+      const auto* id = item.GetDict().FindString("id");
+      const auto* detail = item.GetDict().FindString("status");
+      if (id && *id == "translation" && detail) {
+        visible_error = item.GetDict().FindBool("error").value_or(false) &&
+                        detail->find(expected) != std::string::npos;
+      }
+    }
+    EXPECT_TRUE(visible_error) << status.DebugString();
+  }
+
+ protected:
+  base::Process process_;
+  base::Time created_;
+  std::optional<content::ServiceProcessId> service_id_;
+  base::TimeTicks exited_;
+  LocalBroker::Ready pending_;
+
+ private:
+  base::ScopedTempDir cache_;
+  base::ScopedTempDir data_;
+  base::FilePath model_;
+  std::vector<base::UnguessableToken> jobs_;
+  base::RepeatingTimer memory_safety_;
+};
+
+IN_PROC_BROWSER_TEST_F(
+    StainlessLocalResourceBrowserTest,
+    MANUAL_ActualRssCutoffTerminatesOwnedWorkerAndReportsResourceError) {
+  base::test::ScopedRunLoopTimeout timeout(FROM_HERE, base::Seconds(30));
+  if (base::SysInfo::AmountOfAvailablePhysicalMemory().InBytes() < 8 * kGiB) {
+    GTEST_SKIP() << "The bounded 2 GiB probe needs 8 GiB available host RAM";
+  }
+  StartMemorySafetyGuard();
+  base::test::TestFuture<mojom::ResultPtr> result;
+  Submit(kGrow, result.GetCallback());
+  const auto& observed = result.Get();
+  ASSERT_TRUE(observed);
+  EXPECT_EQ(mojom::Status::kResourceLimit, observed->status)
+      << observed->detail;
+  EXPECT_TRUE(observed->text.empty());
+  ASSERT_TRUE(observed->worker_usage);
+  const auto& usage = *observed->worker_usage;
+  EXPECT_GT(usage.sampled_peak_rss_bytes, 2147483648u);
+  EXPECT_GT(usage.samples, 1u);
+  EXPECT_LE(usage.maximum_sample_gap_microseconds, 250000u);
+  ASSERT_GT(usage.resource_limit_observed_at_microseconds, 0u);
+  ASSERT_GE(usage.termination_requested_at_microseconds,
+            usage.resource_limit_observed_at_microseconds);
+  EXPECT_LE(usage.termination_requested_at_microseconds -
+                usage.resource_limit_observed_at_microseconds,
+            1000000u);
+  ASSERT_TRUE(process_.IsValid());
+  ASSERT_FALSE(created_.is_null());
+  ASSERT_TRUE(base::test::RunUntil([&] { return !exited_.is_null(); }));
+  const auto exit_us = exited_.since_origin().InMicroseconds();
+  ASSERT_GE(static_cast<uint64_t>(exit_us),
+            usage.resource_limit_observed_at_microseconds);
+  EXPECT_LE(static_cast<uint64_t>(exit_us) -
+                usage.resource_limit_observed_at_microseconds,
+            1000000u);
+  CheckVisibleBudgetError("resource");
+  const auto visible_us =
+      base::TimeTicks::Now().since_origin().InMicroseconds();
+  ASSERT_GE(static_cast<uint64_t>(visible_us),
+            usage.resource_limit_observed_at_microseconds);
+  EXPECT_LE(static_cast<uint64_t>(visible_us) -
+                usage.resource_limit_observed_at_microseconds,
+            1000000u);
+  LOG(INFO) << "Stainless synthetic RSS proof: peak="
+            << usage.sampled_peak_rss_bytes << " samples=" << usage.samples
+            << " maximum_gap_us=" << usage.maximum_sample_gap_microseconds
+            << " cutoff_to_exit_us="
+            << static_cast<uint64_t>(exit_us) -
+                   usage.resource_limit_observed_at_microseconds
+            << " cutoff_to_visible_status_us="
+            << static_cast<uint64_t>(visible_us) -
+                   usage.resource_limit_observed_at_microseconds;
+}
