diff --git a/tools/grit/grit/format/data_pack.py b/tools/grit/grit/format/data_pack.py
index 66c929a313..aca7892ced 100755
--- a/tools/grit/grit/format/data_pack.py
+++ b/tools/grit/grit/format/data_pack.py
@@ -9,6 +9,7 @@ files.
 
 import collections
 import os
+import re
 import struct
 import sys
 
@@ -96,6 +97,8 @@ def _FormatInternal(root, lang, gender):
       ):
         value = _GetGenderDedupedValue(node, lang, gender)
         if value is not None:
+          if isinstance(node, message.MessageNode):
+            value = _StainlessMessage(root.source, node.attrs['name'], value)
           resource_id = id_map[node.GetTextualIds()[0]]
           data[resource_id] = value
           root.info.append(
@@ -104,6 +107,31 @@ def _FormatInternal(root, lang, gender):
   return data
 
 
+def _StainlessMessage(source, name, value):
+  if not source or os.path.basename(source) not in (
+      'chromium_strings.grd', 'generated_resources.grd',
+      'components_chromium_strings.grd', 'components_strings.grd'):
+    return value
+  if name.startswith('IDS_IMPORT_') or '_IMPORT_FROM_' in name:
+    return value
+  binary = isinstance(value, bytes)
+  text = value.decode('utf-8') if binary else value
+  if name == 'IDS_VERSION_UI_LICENSE':
+    parts = re.split(r'(<a\b[^>]*>.*?</a>)', text, flags=re.DOTALL)
+    text = ''.join(part if index % 2 else part.replace('Chromium', 'Stainless')
+                   for index, part in enumerate(parts))
+    return text.encode('utf-8') if binary else text
+  if any(part in name for part in (
+      '_COPYRIGHT', '_COMPANY_NAME', '_LICENSE', '_TERMS_OF_SERVICE')):
+    return value
+  text = re.sub(
+      r'Google Chrome for Testing|Chrome for Testing|Google Chrome|'
+      r'(?<![A-Za-z0-9_])Chromium(?!OS)|'
+      r'(?<![A-Za-z0-9_])Chrome(?![A-Za-z0-9_]| Web Store)',
+      'Stainless', text)
+  return text.encode('utf-8') if binary else text
+
+
 # Many strings don't get separate translations per gender. We don't want to
 # store 4 copies of every string if we don't need to. This function checks if a
 # string in a gender translation already exists in the default translation for
diff --git a/tools/grit/grit/format/data_pack_unittest.py b/tools/grit/grit/format/data_pack_unittest.py
index 6a5c3cce8a..bce95c234f 100755
--- a/tools/grit/grit/format/data_pack_unittest.py
+++ b/tools/grit/grit/format/data_pack_unittest.py
@@ -21,6 +21,88 @@ from grit.format import data_pack
 
 
 class FormatDataPackUnittest(unittest.TestCase):
+  def testStainlessBrandingCoversIncludedSettingsMessages(self):
+    xml = '''<grit latest_public_release="0" current_release="1">
+      <outputs><output filename="strings.pak" type="data_package" /></outputs>
+      <release seq="1"><messages>
+        <message name="IDS_SETTINGS_ABOUT_PROGRAM">About Chromium</message>
+        <message name="IDS_SETTINGS_AI_PAGE_TITLE">AI in Chrome</message>
+        <message name="IDS_IMPORT_FROM_GOOGLE_CHROME">Google Chrome</message>
+      </messages></release>
+    </grit>'''
+    grd = grd_reader.Parse(io.StringIO(xml), '.')
+    grd.SetOutputLanguage('en')
+    grd.RunGatherers()
+    grd.InitializeIds()
+    for node in grd:
+      node.source = 'chrome/app/settings_chromium_strings.grdp'
+    grd.source = 'chrome/app/chromium_strings.grd'
+    self.assertEqual(
+        list(data_pack._FormatInternal(
+            grd, 'en', constants.DEFAULT_GENDER).values()),
+        ['About Stainless', 'AI in Stainless', 'Google Chrome'])
+    grd.source = 'chrome/app/generated_resources.grd'
+    self.assertEqual(
+        list(data_pack._FormatInternal(
+            grd, 'en', constants.DEFAULT_GENDER).values()),
+        ['About Stainless', 'AI in Stainless', 'Google Chrome'])
+
+  def testStainlessBrandingPreservesIdsAndNotices(self):
+    xml = '''<grit latest_public_release="0" current_release="1">
+      <outputs><output filename="strings.pak" type="data_package" /></outputs>
+      <release seq="1"><messages>
+        <message name="IDS_PRODUCT_NAME">Chromium</message>
+        <message name="IDS_ABOUT_BROWSER">About Chromium</message>
+        <message name="IDS_ABOUT_VERSION_COPYRIGHT">The Chromium Authors</message>
+      </messages></release>
+    </grit>'''
+    grd = grd_reader.Parse(io.StringIO(xml), '.')
+    grd.SetOutputLanguage('en')
+    grd.RunGatherers()
+    grd.InitializeIds()
+    before = data_pack._FormatInternal(grd, 'en', constants.DEFAULT_GENDER)
+    for node in grd:
+      node.source = 'chrome/app/chromium_strings.grd'
+    after = data_pack._FormatInternal(grd, 'en', constants.DEFAULT_GENDER)
+    self.assertEqual(set(before), set(after))
+    self.assertEqual(list(after.values()), [
+        'Stainless', 'About Stainless', 'The Chromium Authors'])
+
