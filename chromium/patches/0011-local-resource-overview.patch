+
+bool EligibleOwner(BrowserWindowInterface* browser) {
+  if (!chrome::CanExecuteStainlessBrowserAction(browser,
+                                                IDC_SHOW_COMMAND_PALETTE) ||
+      !chrome::SupportsCommand(browser, IDC_SHOW_RESOURCE_OVERVIEW) ||
+      !chrome::IsCommandEnabled(browser, IDC_SHOW_RESOURCE_OVERVIEW)) {
+    return false;
+  }
+  auto* browser_actions = BrowserActions::From(browser);
+  if (!browser_actions || !browser_actions->root_action_item()) {
+    return false;
+  }
+  auto* action = actions::ActionManager::Get().FindAction(
+      kActionShowResourceOverview, browser_actions->root_action_item());
+  return action && action->GetVisible() && action->GetEnabled();
+}
+
+}  // namespace
+
+DEFINE_USER_DATA(StainlessResourceOverviewView);
+
+StainlessResourceOverviewView* StainlessResourceOverviewView::Show(
+    BrowserWindowInterface* browser) {
+  if (!EligibleOwner(browser)) {
+    LOG(WARNING) << "Stainless Resource Overview requires an available, live "
+                    "normal browser window; close blocking dialogs and retry";
+    return nullptr;
+  }
+  if (auto* overview = Get(browser->GetUnownedUserDataHost())) {
+    if (overview->closing_ || overview->GetWidget()->IsClosed()) {
+      LOG(WARNING) << "Stainless Resource Overview is closing; retry shortly";
+      return nullptr;
+    }
+    overview->GetWidget()->Activate();
+    overview->table_->RequestFocus();
+    return overview;
+  }
+  auto* owner = BrowserView::GetBrowserViewForBrowser(browser);
+  auto contents = std::make_unique<StainlessResourceOverviewView>(browser);
+  auto* overview = contents.get();
+  auto dialog = std::make_unique<views::DialogDelegate>();
+  dialog->SetTitle(Text(IDS_STAINLESS_RESOURCES_TITLE));
+  dialog->SetButtons(static_cast<int>(ui::mojom::DialogButton::kCancel));
+  dialog->SetButtonLabel(ui::mojom::DialogButton::kCancel,
+                         Text(IDS_STAINLESS_COMMAND_PALETTE_CLOSE));
+  dialog->SetDefaultButton(static_cast<int>(ui::mojom::DialogButton::kNone));
+  dialog->set_margins(
+      ChromeLayoutProvider::Get()->GetDialogInsetsForContentType(
+          views::DialogContentType::kControl,
+          views::DialogContentType::kControl));
+  dialog->SetInitiallyFocusedView(overview->table_);
+  dialog->SetContentsView(std::move(contents));
+  auto* widget = views::DialogDelegate::CreateDialogWidget(
+      std::move(dialog), gfx::NativeWindow(),
+      owner->GetWidget()->GetNativeView());
+  overview->widget_observation_.Observe(widget);
+  widget->Show();
+  browser->GetTabStripModel()->AddObserver(overview);
+  task_manager::TaskManagerInterface::GetTaskManager()->AddObserver(overview);
+  overview->RefreshRows();
+  return overview;
+}
+
+StainlessResourceOverviewView::StainlessResourceOverviewView(
+    BrowserWindowInterface* browser)
+    : task_manager::TaskManagerObserver(
+          base::Seconds(1),
+          task_manager::REFRESH_TYPE_CPU |
+              task_manager::REFRESH_TYPE_MEMORY_FOOTPRINT),
+      browser_(browser->GetWeakPtr()),
+      return_focus_(std::make_unique<views::ViewTracker>()) {
+  registration_.emplace(browser->GetUnownedUserDataHost(), *this);
+  auto* focus =
+      BrowserView::GetBrowserViewForBrowser(browser)->GetFocusManager();
+  return_focus_->SetView(focus->GetFocusedView() ? focus->GetFocusedView()
+                                                 : focus->GetStoredFocusView());
+  browser_close_subscription_ = browser->RegisterBrowserDidClose(
+      base::BindRepeating(&StainlessResourceOverviewView::OnBrowserClosed,
+                          base::Unretained(this)));
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(),
+      ChromeLayoutProvider::Get()->GetDistanceMetric(
+          views::DISTANCE_RELATED_CONTROL_VERTICAL)));
+  auto label = [this](int message) {
+    auto* view = AddChildView(std::make_unique<views::Label>(Text(message)));
+    view->SetMultiLine(true);
+    view->SetHorizontalAlignment(gfx::HorizontalAlignment::ALIGN_LEFT);
+    return view;
+  };
+  label(browser->GetProfile()->IsOffTheRecord()
+            ? IDS_STAINLESS_RESOURCES_PRIVATE
+            : IDS_STAINLESS_RESOURCES_NORMAL);
+  label(IDS_STAINLESS_RESOURCES_EXPLANATION);
+  std::vector<ui::TableColumn> columns = {
+      {IDS_STAINLESS_RESOURCES_TASK, ui::TableColumn::LEFT, -1, 1},
+      {IDS_STAINLESS_RESOURCES_PID, ui::TableColumn::RIGHT, 90, 0},
+      {IDS_STAINLESS_RESOURCES_ATTRIBUTION, ui::TableColumn::LEFT, 230, 0},
+      {IDS_STAINLESS_RESOURCES_CPU, ui::TableColumn::RIGHT, 100, 0},
+      {IDS_STAINLESS_RESOURCES_MEMORY, ui::TableColumn::RIGHT, 180, 0},
+  };
+  auto table = std::make_unique<views::TableView>(
+      this, columns, views::TableType::kTextOnly, true);
+  table_ = table.get();
+  table_->SetSelectOnRemove(false);
+  table_->GetViewAccessibility().SetName(Text(IDS_STAINLESS_RESOURCES_TABLE));
+  auto* scroll = AddChildView(
+      views::TableView::CreateScrollViewWithTable(std::move(table)));
+  scroll->ClipHeightTo(300, 300);
+  scroll->SetHorizontalScrollBarMode(
+      views::ScrollView::ScrollBarMode::kDisabled);
+  scroll->SetAllowKeyboardScrolling(false);
+  label(IDS_STAINLESS_RESOURCES_HINT);
+  status_ = label(IDS_STAINLESS_RESOURCES_PARTIAL);
+  status_->GetViewAccessibility().SetRole(ax::mojom::Role::kStatus);
+  status_->GetViewAccessibility().SetLiveRegionContainer(
+      views::ViewAccessibility::LiveRegionStatus::kPolite);
+  SetPreferredSize(gfx::Size(980, 600));
+}
+
+StainlessResourceOverviewView::~StainlessResourceOverviewView() {
+  StopObserving();
+  table_->SetModel(nullptr);
+}
+
+size_t StainlessResourceOverviewView::RowCount() const {
+  return rows_.size();
+}
+
+std::u16string StainlessResourceOverviewView::FormatCPU(
+    std::optional<double> value,
+    bool sampled) {
+  if (!sampled) {
+    return Text(IDS_STAINLESS_RESOURCES_COLLECTING);
+  }
+  return value && std::isfinite(*value) && *value >= 0
+             ? base::FormatDouble(*value, 1)
+             : Text(IDS_STAINLESS_RESOURCES_UNAVAILABLE);
+}
+
+std::u16string StainlessResourceOverviewView::FormatMemory(
+    std::optional<base::ByteSize> value,
+    bool sampled) {
+  if (!sampled) {
+    return Text(IDS_STAINLESS_RESOURCES_COLLECTING);
+  }
+  return value ? base::FormatDouble(value->InMiBF(), 1)
+               : Text(IDS_STAINLESS_RESOURCES_UNAVAILABLE);
+}
+
+std::u16string StainlessResourceOverviewView::GetText(size_t row,
+                                                      int column_id) const {
+  const auto& item = rows_.at(row);
+  switch (column_id) {
+    case IDS_STAINLESS_RESOURCES_TASK:
+      return item.title;
+    case IDS_STAINLESS_RESOURCES_PID:
+      return item.process_id ? base::NumberToString16(*item.process_id)
+                             : Text(IDS_STAINLESS_RESOURCES_UNAVAILABLE);
+    case IDS_STAINLESS_RESOURCES_ATTRIBUTION:
+      return item.attribution;
+    case IDS_STAINLESS_RESOURCES_CPU:
+      return FormatCPU(item.cpu, item.sampled || item.task_id == -1);
+    case IDS_STAINLESS_RESOURCES_MEMORY:
+      return FormatMemory(item.memory, item.sampled || item.task_id == -1);
+    default:
+      NOTREACHED();
+  }
+}
+
+std::u16string StainlessResourceOverviewView::GetTooltip(size_t row) const {
+  return GetText(row, IDS_STAINLESS_RESOURCES_TASK) + u"\n" +
+         GetText(row, IDS_STAINLESS_RESOURCES_ATTRIBUTION) + u"\n" +
+         Text(IDS_STAINLESS_RESOURCES_CPU) + u": " +
+         GetText(row, IDS_STAINLESS_RESOURCES_CPU) + u"\n" +
+         Text(IDS_STAINLESS_RESOURCES_MEMORY) + u": " +
+         GetText(row, IDS_STAINLESS_RESOURCES_MEMORY);
+}
+
+void StainlessResourceOverviewView::SetObserver(
+    ui::TableModelObserver* observer) {
+  model_observer_ = observer;
+}
+
+void StainlessResourceOverviewView::RefreshRows(
+    std::optional<task_manager::TaskId> removing) {
+  auto* manager = observed_task_manager();
+  if (closing_ || !browser_ || browser_->IsDeleteScheduled() || !manager) {
+    return;
+  }
+  std::optional<std::pair<task_manager::TaskId, SessionID>> selected;
+  if (auto row = table_->GetFirstSelectedRow(); row && *row < rows_.size()) {
+    selected = std::pair(rows_[*row].task_id, rows_[*row].tab_id);
+  }
+  std::map<SessionID, std::u16string> owned_tabs;
+  // Provider titles can contain other profiles' URLs. Read only owned tabs.
+  auto* strip = browser_->GetTabStripModel();
+  for (int index = 0; index < strip->count(); ++index) {
+    auto* contents = strip->GetWebContentsAt(index);
+    if (contents->IsBeingDestroyed() ||
+        contents->GetBrowserContext() != browser_->GetProfile()) {
+      continue;
+    }
+    auto id = sessions::SessionTabHelper::IdForTab(contents);
+    if (id.is_valid()) {
+      owned_tabs.emplace(id, contents->GetTitle().empty()
+                                 ? Text(IDS_STAINLESS_RESOURCES_UNTITLED)
+                                 : contents->GetTitle());
+    }
+  }
+  std::vector<Row> rows;
+  std::map<base::ProcessId, size_t> processes;
+  std::set<SessionID> reported_tabs;
+  for (auto id : manager->GetTaskIdsList()) {
+    if (id == removing || !manager->IsTaskValid(id)) {
+      continue;
+    }
+    auto type = manager->GetType(id);
+    auto tab = manager->GetTabId(id);
+    int title_message = 0;
+    if (type == task_manager::Task::BROWSER) {
+      title_message = IDS_STAINLESS_RESOURCES_BROWSER;
+    } else if (type == task_manager::Task::GPU) {
+      title_message = IDS_STAINLESS_RESOURCES_GPU;
+    } else if (type == task_manager::Task::UTILITY) {
+      title_message = IDS_STAINLESS_RESOURCES_UTILITY;
+    } else if (type == task_manager::Task::RENDERER &&
+               owned_tabs.contains(tab)) {
+      auto* host = content::RenderProcessHost::FromID(
+          manager->GetChildProcessUniqueId(id));
+      if (!host || !host->IsInitializedAndNotDead() ||
+          host->GetBrowserContext() != browser_->GetProfile()) {
+        continue;
+      }
+    } else {
+      continue;
+    }
+    auto pid = manager->GetProcessId(id);
+    if (pid == base::kNullProcessId) {
+      continue;
+    }
+    auto [it, inserted] = processes.emplace(pid, rows.size());
+    if (inserted) {
+      Row row;
+      row.task_id = id;
+      row.process_id = pid;
+      row.title = title_message ? Text(title_message) : std::u16string();
+      row.attribution =
+          Text(title_message ? IDS_STAINLESS_RESOURCES_SHARED
+                             : IDS_STAINLESS_RESOURCES_RENDERER_COST);
+      row.sampled = sampled_tasks_.contains(id);
+      if (row.sampled) {
+        row.cpu = manager->GetPlatformIndependentCPUUsageIfAvailable(id);
+        row.memory = manager->GetMemoryFootprintUsage(id);
+      }
+      rows.push_back(std::move(row));
+    }
+    if (!title_message) {
+      auto& row = rows[it->second];
+      if (!std::ranges::contains(row.tabs, tab)) {
+        row.tabs.push_back(tab);
+      }
+      reported_tabs.insert(tab);
+    }
+  }
+  for (auto& row : rows) {
+    if (!row.tabs.empty()) {
+      std::vector<std::u16string> titles;
+      for (auto tab : row.tabs) {
+        titles.push_back(owned_tabs.at(tab));
+      }
+      row.title = l10n_util::GetStringFUTF16(IDS_STAINLESS_RESOURCES_RENDERER,
+                                             base::JoinString(titles, u"; "));
+    }
+  }
+  for (const auto& [tab, title] : owned_tabs) {
+    if (!reported_tabs.contains(tab)) {
+      Row row;
+      row.tab_id = tab;
+      row.tabs.push_back(tab);
+      row.title = title;
+      row.attribution = Text(IDS_STAINLESS_RESOURCES_NO_RENDERER);
+      rows.push_back(std::move(row));
+    }
+  }
+  const bool same_rows =
+      std::ranges::equal(rows, rows_, [](const Row& left, const Row& right) {
+        return left.task_id == right.task_id && left.tab_id == right.tab_id;
+      });
+  rows_ = std::move(rows);
+  if (model_observer_) {
+    if (!same_rows) {
+      model_observer_->OnModelChanged();
+    } else if (!rows_.empty()) {
+      model_observer_->OnItemsChanged(0, rows_.size());
+    }
+  }
+  if (!same_rows) {
+    std::optional<size_t> selection;
+    if (selected) {
+      for (size_t index = 0; index < rows_.size(); ++index) {
+        if (*selected == std::pair(rows_[index].task_id, rows_[index].tab_id)) {
+          selection = index;
+          break;
+        }
+      }
+    }
+    table_->Select(selection);
+  }
+  status_->SetText(std::ranges::any_of(rows_,
+                                       [](const Row& row) {
+                                         return !row.sampled || !row.cpu ||
+                                                !std::isfinite(*row.cpu) ||
+                                                *row.cpu < 0 || !row.memory;
+                                       })
+                       ? Text(IDS_STAINLESS_RESOURCES_PARTIAL)
+                       : std::u16string());
+}
+
+void StainlessResourceOverviewView::OnTaskAdded(task_manager::TaskId id) {
+  sampled_tasks_.erase(id);
+  RefreshRows();
+}
+
+void StainlessResourceOverviewView::OnTaskToBeRemoved(task_manager::TaskId id) {
+  sampled_tasks_.erase(id);
+  RefreshRows(id);
+}
+
+void StainlessResourceOverviewView::OnTasksRefreshedWithBackgroundCalculations(
+    const task_manager::TaskIdList& task_ids) {
+  sampled_tasks_ = std::set(task_ids.begin(), task_ids.end());
+  RefreshRows();
+}
+
+void StainlessResourceOverviewView::OnTabStripModelChanged(
+    TabStripModel* model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  RefreshRows();
+}
+
+void StainlessResourceOverviewView::OnTabChangedAt(tabs::TabInterface* tab,
+                                                   TabChangeType change_type) {
+  RefreshRows();
+}
+
+void StainlessResourceOverviewView::StopObserving() {
+  TabStripModelObserver::StopObservingAll(this);
+  if (auto* manager = observed_task_manager()) {
+    manager->RemoveObserver(this);
+  }
+  sampled_tasks_.clear();
+  rows_.clear();
+  if (model_observer_) {
+    model_observer_->OnModelChanged();
+  }
+}
+
+void StainlessResourceOverviewView::OnTabStripModelDestroyed(
+    TabStripModel* model) {
+  closing_ = true;
+  StopObserving();
+  registration_.reset();
+  browser_.reset();
+  GetWidget()->Close();
+}
+
+void StainlessResourceOverviewView::OnBrowserClosed(
+    BrowserWindowInterface* browser) {
+  closing_ = true;
+  StopObserving();
+  registration_.reset();
+  browser_.reset();
+  GetWidget()->Close();
+}
+
+void StainlessResourceOverviewView::OnWidgetClosing(views::Widget* widget) {
+  closing_ = true;
+  StopObserving();
+}
+
+void StainlessResourceOverviewView::OnWidgetDestroyed(views::Widget* widget) {
+  StopObserving();
+  widget_observation_.Reset();
+  registration_.reset();
+  browser_close_subscription_ = {};
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::WeakPtr<BrowserWindowInterface> browser,
+             std::unique_ptr<views::ViewTracker> focus) {
+            if (!browser || browser->IsDeleteScheduled()) {
+              return;
+            }
+            if (focus->view() && focus->view()->IsDrawn() &&
+                focus->view()->IsFocusable()) {
+              focus->view()->RequestFocus();
+            } else if (auto* contents = browser->GetTabStripModel()
+                                            ->GetActiveWebContents()) {
+              contents->Focus();
+            }
+          },
+          browser_, std::move(return_focus_)));
+  browser_.reset();
+}
+
+namespace chrome {
+
+void ShowResourceOverview(BrowserWindowInterface* browser) {
+  StainlessResourceOverviewView::Show(browser);
+}
+
+}  // namespace chrome
+
+BEGIN_METADATA(StainlessResourceOverviewView)
+END_METADATA
