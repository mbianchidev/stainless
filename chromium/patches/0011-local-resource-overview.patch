+IN_PROC_BROWSER_TEST_F(StainlessResourceOverviewBrowserTest,
+                       LiveTitlesMovesRemovalAndOwnerLifetime) {
+  auto* view = Open(browser());
+  ASSERT_TRUE(view);
+  chrome::AddTabAt(browser(),
+                   embedded_test_server()->GetURL("gamma.test", "/moving"), -1,
+                   true);
+  auto* contents = browser()->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_TRUE(content::WaitForLoadStop(contents));
+  ASSERT_TRUE(content::ExecJs(contents, "document.title = 'Orion moving';"));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return VisibleText(view).contains(u"Orion moving"); }));
+  auto row = RowForProcess(
+      view, contents->GetPrimaryMainFrame()->GetProcess()->GetProcess().Pid());
+  ASSERT_TRUE(row);
+  Table(view)->Select(row);
+  ASSERT_TRUE(content::ExecJs(contents, "document.title = 'Orion renamed';"));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return VisibleText(view).contains(u"Orion renamed"); }));
+  EXPECT_FALSE(VisibleText(view).contains(u"Orion moving"));
+  auto selected = Table(view)->GetFirstSelectedRow();
+  ASSERT_TRUE(selected);
+  EXPECT_TRUE(view->GetText(*selected, IDS_STAINLESS_RESOURCES_TASK)
+                  .contains(u"Orion renamed"));
+
+  auto* other = CreateBrowser(browser()->GetProfile());
+  Navigate(other, "delta.test", "/destination", "Orion destination");
+  auto* destination_view = Open(other);
+  ASSERT_TRUE(destination_view);
+  auto detached =
+      browser()->GetTabStripModel()->DetachWebContentsAtForInsertion(
+          browser()->GetTabStripModel()->GetIndexOfWebContents(contents));
+  other->GetTabStripModel()->AppendWebContents(std::move(detached), true);
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return !VisibleText(view).contains(u"Orion renamed") &&
+           VisibleText(destination_view).contains(u"Orion renamed");
+  }));
+  EXPECT_FALSE(Table(view)->GetFirstSelectedRow());
+  other->GetTabStripModel()->CloseWebContents(contents, CLOSE_NONE);
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return !VisibleText(destination_view).contains(u"Orion renamed");
+  }));
+  views::ViewTracker lifetime;
+  lifetime.SetView(destination_view);
+  CloseBrowserSynchronously(other);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(nullptr, lifetime.view());
+  EXPECT_TRUE(task_manager::TaskManagerInterface::GetTaskManager()
+                  ->IsResourceRefreshEnabled(task_manager::REFRESH_TYPE_CPU));
+  Close(view);
+}
