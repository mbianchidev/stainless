+IN_PROC_BROWSER_TEST_F(StainlessResourceOverviewBrowserTest,
+                       OtherWindowsProfilesAndPrivateDetailsStayHidden) {
+  auto* same_profile = CreateBrowser(browser()->GetProfile());
+  Navigate(same_profile, "alpha.test", "/hidden-window", "Hidden window");
+  auto* private_browser = CreateIncognitoBrowser(browser()->GetProfile());
+  Navigate(private_browser, "alpha.test", "/hidden-private", "Hidden private");
+  auto& different_profile = profiles::testing::CreateProfileSync(
+      g_browser_process->profile_manager(),
+      browser()->GetProfile()->GetPath().DirName().AppendASCII(
+          "OrionIdentity"));
+  auto* other = CreateBrowser(&different_profile);
+  Navigate(other, "alpha.test", "/hidden-identity", "Hidden identity");
+
+  auto* normal = Open(browser());
+  ASSERT_TRUE(normal);
+  auto pid = browser()
+                 ->GetTabStripModel()
+                 ->GetActiveWebContents()
+                 ->GetPrimaryMainFrame()
+                 ->GetProcess()
+                 ->GetProcess()
+                 .Pid();
+  ASSERT_TRUE(base::test::RunUntil([&] { return Collected(normal, pid); }));
+  EXPECT_EQ(pid, same_profile->GetTabStripModel()
+                     ->GetActiveWebContents()
+                     ->GetPrimaryMainFrame()
+                     ->GetProcess()
+                     ->GetProcess()
+                     .Pid());
+  EXPECT_TRUE(VisibleText(normal).contains(u"Orion owned"));
+  for (auto hidden :
+       {u"Hidden window", u"Hidden private", u"Hidden identity",
+        u"hidden-window", u"hidden-private", u"hidden-identity"}) {
+    EXPECT_FALSE(VisibleText(normal).contains(hidden));
+  }
+  VerifyMeasurements(normal);
+  auto* private_view = Open(private_browser);
+  ASSERT_TRUE(private_view);
+  auto private_pid = private_browser->GetTabStripModel()
+                         ->GetActiveWebContents()
+                         ->GetPrimaryMainFrame()
+                         ->GetProcess()
+                         ->GetProcess()
+                         .Pid();
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return Collected(private_view, private_pid); }));
+  EXPECT_NE(pid, private_pid);
+  EXPECT_TRUE(VisibleText(private_view).contains(u"Hidden private"));
+  EXPECT_FALSE(VisibleText(private_view).contains(u"Orion owned"));
+  EXPECT_FALSE(VisibleText(private_view).contains(u"Hidden window"));
+  EXPECT_FALSE(VisibleText(private_view).contains(u"Hidden identity"));
+  Close(normal);
+  EXPECT_TRUE(task_manager::TaskManagerInterface::GetTaskManager()
+                  ->IsResourceRefreshEnabled(task_manager::REFRESH_TYPE_CPU));
+  VerifyMeasurements(private_view);
+  Close(private_view);
+  EXPECT_FALSE(task_manager::TaskManagerInterface::GetTaskManager()
+                   ->IsResourceRefreshEnabled(task_manager::REFRESH_TYPE_CPU));
+}
