+class StainlessResourceOverviewBrowserTest : public InProcessBrowserTest {
+ public:
+  void SetUpCommandLine(base::CommandLine* command) override {
+    command->AppendSwitchASCII("headless", "new");
+    command->AppendSwitch("use-mock-keychain");
+    command->AppendSwitchASCII("lang", "en-US");
+    command->AppendSwitch("process-per-site");
+  }
+
+  void SetUpOnMainThread() override {
+    ASSERT_TRUE(display::Screen::Get()->IsHeadless());
+    host_resolver()->AddRule("*.test", "127.0.0.1");
+    embedded_test_server()->RegisterRequestHandler(base::BindRepeating(
+        [](const net::test_server::HttpRequest&)
+            -> std::unique_ptr<net::test_server::HttpResponse> {
+          auto response =
+              std::make_unique<net::test_server::BasicHttpResponse>();
+          response->set_code(net::HTTP_OK);
+          response->set_content_type("text/html");
+          response->set_content(
+              "<title>Resource fixture</title><p>Fictional local workload</p>");
+          return response;
+        }));
+    ASSERT_TRUE(embedded_test_server()->Start());
+    Navigate(browser(), "alpha.test", "/owned", "Orion owned");
+  }
+
+  void Navigate(BrowserWindowInterface* owner,
+                std::string_view host,
+                std::string_view path,
+                std::string_view title) {
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(
+        owner, embedded_test_server()->GetURL(host, path)));
+    ASSERT_TRUE(
+        content::ExecJs(owner->GetTabStripModel()->GetActiveWebContents(),
+                        content::JsReplace("document.title = $1;", title)));
+  }
+
+  StainlessResourceOverviewView* Overview(BrowserWindowInterface* owner) {
+    return StainlessResourceOverviewView::Get(owner->GetUnownedUserDataHost());
+  }
+
+  StainlessResourceOverviewView* Open(BrowserWindowInterface* owner) {
+    EXPECT_TRUE(chrome::ExecuteCommand(owner, IDC_SHOW_RESOURCE_OVERVIEW));
+    auto* view = Overview(owner);
+    if (view) {
+      NSWindow* window =
+          view->GetWidget()->GetNativeWindow().GetNativeNSWindow();
+      EXPECT_TRUE(base::test::RunUntil([&] { return window.visible; }));
+    }
+    return view;
+  }
+
+  void Close(StainlessResourceOverviewView* view) {
+    auto owner = view->browser_;
+    view->GetWidget()->Close();
+    ASSERT_TRUE(base::test::RunUntil([&] { return !Overview(owner.get()); }));
+    base::RunLoop().RunUntilIdle();
+  }
+
+  std::u16string Text(int message) {
+    return l10n_util::GetStringUTF16(message);
+  }
+
+  std::u16string VisibleText(StainlessResourceOverviewView* view) {
+    std::u16string text;
+    for (size_t row = 0; row < view->RowCount(); ++row) {
+      text += view->GetTooltip(row);
+    }
+    return text;
+  }
+
+  std::optional<size_t> RowForProcess(StainlessResourceOverviewView* view,
+                                      base::ProcessId pid) {
+    for (size_t index = 0; index < view->rows_.size(); ++index) {
+      if (view->rows_[index].process_id == pid) {
+        return index;
+      }
+    }
+    return std::nullopt;
+  }
+
+  std::optional<size_t> UnmeasuredRow(StainlessResourceOverviewView* view,
+                                      SessionID tab) {
+    for (size_t index = 0; index < view->rows_.size(); ++index) {
+      if (view->rows_[index].task_id == -1 &&
+          view->rows_[index].tab_id == tab) {
+        return index;
+      }
+    }
+    return std::nullopt;
+  }
+
+  bool Collected(StainlessResourceOverviewView* view, base::ProcessId pid) {
+    auto index = RowForProcess(view, pid);
+    if (!index) {
+      return false;
+    }
+    const auto& row = view->rows_[*index];
+    return row.sampled && row.cpu && std::isfinite(*row.cpu) && row.memory;
+  }
+
+  void VerifyMeasurements(StainlessResourceOverviewView* view) {
+    auto* manager = task_manager::TaskManagerInterface::GetTaskManager();
+    std::set<base::ProcessId> processes;
+    for (size_t index = 0; index < view->rows_.size(); ++index) {
+      const auto& row = view->rows_[index];
+      if (!row.process_id) {
+        continue;
+      }
+      EXPECT_TRUE(processes.insert(*row.process_id).second);
+      ASSERT_TRUE(manager->IsTaskValid(row.task_id));
+      EXPECT_EQ(*row.process_id, manager->GetProcessId(row.task_id));
+      if (row.sampled) {
+        EXPECT_EQ(row.cpu, manager->GetPlatformIndependentCPUUsageIfAvailable(
+                               row.task_id));
+      }
+      if (row.sampled && row.cpu && std::isfinite(*row.cpu)) {
+        EXPECT_DOUBLE_EQ(*row.cpu,
+                         manager->GetPlatformIndependentCPUUsage(row.task_id));
+        EXPECT_EQ(base::FormatDouble(*row.cpu, 1),
+                  view->GetText(index, IDS_STAINLESS_RESOURCES_CPU));
+        EXPECT_EQ(row.memory, manager->GetMemoryFootprintUsage(row.task_id));
+        if (row.memory) {
+          EXPECT_EQ(base::FormatDouble(row.memory->InMiBF(), 1),
+                    view->GetText(index, IDS_STAINLESS_RESOURCES_MEMORY));
+        }
+        LOG(INFO) << "RESOURCE_FIXTURE task=" << row.task_id
+                  << " pid=" << *row.process_id << " cpu_percent=" << *row.cpu
+                  << " memory_bytes="
+                  << (row.memory ? std::to_string(row.memory->InBytes())
+                                 : "unavailable")
+                  << " label=" << base::UTF16ToUTF8(row.title)
+                  << " attribution=" << base::UTF16ToUTF8(row.attribution);
+      }
+    }
+  }
+
+  void VerifyUnknownUnits() {
+    auto unavailable = Text(IDS_STAINLESS_RESOURCES_UNAVAILABLE);
+    auto collecting = Text(IDS_STAINLESS_RESOURCES_COLLECTING);
+    EXPECT_EQ(collecting, StainlessResourceOverviewView::FormatCPU(0, false));
+    EXPECT_EQ(unavailable,
+              StainlessResourceOverviewView::FormatCPU(std::nullopt, true));
+    for (double value : {-1.0, std::numeric_limits<double>::infinity(),
+                         std::numeric_limits<double>::quiet_NaN()}) {
+      EXPECT_EQ(unavailable,
+                StainlessResourceOverviewView::FormatCPU(value, true));
+    }
+    EXPECT_EQ(base::FormatDouble(0, 1),
+              StainlessResourceOverviewView::FormatCPU(0, true));
+    EXPECT_EQ(base::FormatDouble(127.5, 1),
+              StainlessResourceOverviewView::FormatCPU(127.5, true));
+    EXPECT_EQ(unavailable,
+              StainlessResourceOverviewView::FormatMemory(std::nullopt, true));
+    EXPECT_EQ(collecting, StainlessResourceOverviewView::FormatMemory(
+                              base::ByteSize(0), false));
+    EXPECT_EQ(
+        base::FormatDouble(0, 1),
+        StainlessResourceOverviewView::FormatMemory(base::ByteSize(0), true));
+    EXPECT_EQ(base::FormatDouble(1.5, 1),
+              StainlessResourceOverviewView::FormatMemory(
+                  base::ByteSize(1572864), true));
+  }
+
+  void VerifySamplerFailure() {
+    auto runner =
+        base::ThreadPool::CreateSequencedTaskRunner({base::MayBlock()});
+    auto shared = base::MakeRefCounted<task_manager::SharedSampler>(runner);
+    task_manager::TaskGroup group(base::kNullProcessHandle,
+                                  base::kNullProcessId, false,
+                                  base::DoNothing(), shared, runner);
+    base::test::TestFuture<std::optional<double>> received;
+    auto sampler = base::MakeRefCounted<task_manager::TaskGroupSampler>(
+        base::Process(), runner, received.GetRepeatingCallback(),
+        base::BindRepeating([](base::ByteSize) {}),
+        base::BindRepeating([](int) {}), base::BindRepeating([](int) {}),
+        base::BindRepeating([](base::Process::Priority) {}));
+    for (int cycle = 0; cycle < 2; ++cycle) {
+      sampler->Refresh(task_manager::REFRESH_TYPE_CPU);
+      ASSERT_TRUE(received.Wait());
+      auto value = received.Take();
+      EXPECT_FALSE(value.has_value());
+      group.set_platform_independent_cpu_usage(value);
+      EXPECT_EQ(
+          Text(IDS_STAINLESS_RESOURCES_UNAVAILABLE),
+          StainlessResourceOverviewView::FormatCPU(group.cpu_usage(), true));
+      EXPECT_DOUBLE_EQ(0, group.platform_independent_cpu_usage());
+    }
+    group.set_footprint(base::MiB(8));
+    group.set_footprint(std::nullopt);
+    EXPECT_EQ(Text(IDS_STAINLESS_RESOURCES_UNAVAILABLE),
+              StainlessResourceOverviewView::FormatMemory(
+                  group.footprint_bytes(), true));
+  }
+
+  views::TableView* Table(StainlessResourceOverviewView* view) {
+    return view->table_;
+  }
+
+  void Key(StainlessResourceOverviewView* view, ui::KeyboardCode code) {
+    ui::KeyEvent event(ui::EventType::kKeyPressed, code, ui::EF_NONE);
+    auto* focused = view->GetFocusManager()->GetFocusedView();
+    ASSERT_TRUE(focused);
+    if (!focused->OnKeyPressed(event)) {
+      view->GetFocusManager()->ProcessAccelerator(ui::Accelerator(code, 0));
+    }
+  }
+
+  actions::ActionItem* ResourceAction(BrowserWindowInterface* owner) {
+    return actions::ActionManager::Get().FindAction(
+        kActionShowResourceOverview,
+        BrowserActions::From(owner)->root_action_item());
+  }
+};
