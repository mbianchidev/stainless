+IN_PROC_BROWSER_TEST_F(StainlessResourceOverviewBrowserTest,
+                       OwnedWorkloadsUseRealSharedProcessSamples) {
+  auto* first = browser()->GetTabStripModel()->GetActiveWebContents();
+  chrome::AddTabAt(browser(),
+                   embedded_test_server()->GetURL("alpha.test", "/second"), -1,
+                   true);
+  auto* second = browser()->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_TRUE(content::WaitForLoadStop(second));
+  ASSERT_TRUE(content::ExecJs(second, "document.title = 'Orion second';"));
+  ASSERT_EQ(first->GetPrimaryMainFrame()->GetProcess(),
+            second->GetPrimaryMainFrame()->GetProcess());
+  for (auto* contents : {first, second}) {
+    ASSERT_TRUE(content::ExecJs(contents, R"JS(
+      window.resourceBuffer = new Uint8Array(8 * 1024 * 1024);
+      window.resourceBuffer.fill(17);
+      window.resourceTicks = 0;
+      window.resourceTimer = setInterval(() => {
+        const end = performance.now() + 3;
+        while (performance.now() < end) ++window.resourceTicks;
+      }, 100);
+    )JS"));
+    EXPECT_EQ(8388608, content::EvalJs(contents, "resourceBuffer.byteLength"));
+  }
+  auto* view = Open(browser());
+  ASSERT_TRUE(view);
+  const auto pid =
+      first->GetPrimaryMainFrame()->GetProcess()->GetProcess().Pid();
+  ASSERT_TRUE(base::test::RunUntil([&] { return Collected(view, pid); }));
+  auto row = RowForProcess(view, pid);
+  ASSERT_TRUE(row);
+  EXPECT_TRUE(view->GetText(*row, IDS_STAINLESS_RESOURCES_TASK)
+                  .contains(u"Orion owned"));
+  EXPECT_TRUE(view->GetText(*row, IDS_STAINLESS_RESOURCES_TASK)
+                  .contains(u"Orion second"));
+  EXPECT_EQ(Text(IDS_STAINLESS_RESOURCES_RENDERER_COST),
+            view->GetText(*row, IDS_STAINLESS_RESOURCES_ATTRIBUTION));
+  auto browser_row = RowForProcess(view, base::GetCurrentProcId());
+  ASSERT_TRUE(browser_row);
+  EXPECT_EQ(Text(IDS_STAINLESS_RESOURCES_SHARED),
+            view->GetText(*browser_row, IDS_STAINLESS_RESOURCES_ATTRIBUTION));
+
+  ASSERT_TRUE(content::ExecJs(
+      second, content::JsReplace(
+                  R"JS(
+        new Promise(resolve => {
+          const frame = document.createElement('iframe');
+          frame.onload = resolve;
+          frame.src = $1;
+          document.body.append(frame);
+        });
+      )JS",
+                  embedded_test_server()->GetURL("beta.test", "/frame"))));
+  auto* frame = content::ChildFrameAt(second->GetPrimaryMainFrame(), 0);
+  ASSERT_TRUE(frame);
+  ASSERT_NE(second->GetPrimaryMainFrame()->GetProcess(), frame->GetProcess());
+  auto frame_pid = frame->GetProcess()->GetProcess().Pid();
+  ASSERT_TRUE(base::test::RunUntil([&] { return Collected(view, frame_pid); }));
+  auto frame_row = RowForProcess(view, frame_pid);
+  ASSERT_TRUE(frame_row);
+  EXPECT_TRUE(view->GetText(*frame_row, IDS_STAINLESS_RESOURCES_TASK)
+                  .contains(u"Orion second"));
+  EXPECT_FALSE(VisibleText(view).contains(u"beta.test"));
+  VerifyMeasurements(view);
+  EXPECT_TRUE(chrome::SupportsCommand(browser(), IDC_TASK_MANAGER));
+  EXPECT_TRUE(chrome::IsCommandEnabled(browser(), IDC_TASK_MANAGER));
+  Close(view);
+  auto* manager = task_manager::TaskManagerInterface::GetTaskManager();
+  EXPECT_FALSE(
+      manager->IsResourceRefreshEnabled(task_manager::REFRESH_TYPE_CPU));
+  EXPECT_FALSE(manager->IsResourceRefreshEnabled(
+      task_manager::REFRESH_TYPE_MEMORY_FOOTPRINT));
+}
