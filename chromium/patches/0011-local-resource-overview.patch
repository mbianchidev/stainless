+  EXPECT_TRUE([menu itemWithTag:IDC_SHOW_RESOURCE_OVERVIEW]);
+  ui::AXNodeData data;
+  Table(view)->GetViewAccessibility().GetAccessibleNodeData(&data);
+  EXPECT_EQ(Text(IDS_STAINLESS_RESOURCES_TABLE),
+            data.GetString16Attribute(ax::mojom::StringAttribute::kName));
+  Table(view)->RequestFocus();
+  Key(view, ui::VKEY_DOWN);
+  EXPECT_TRUE(Table(view)->GetFirstSelectedRow());
+  const auto count = browser()->GetTabStripModel()->count();
+  Key(view, ui::VKEY_RETURN);
+  EXPECT_EQ(count, browser()->GetTabStripModel()->count());
+  EXPECT_FALSE(view->GetWidget()->IsClosed());
+  view->GetFocusManager()->AdvanceFocus(false);
+  EXPECT_NE(Table(view), view->GetFocusManager()->GetFocusedView());
+  view->GetFocusManager()->AdvanceFocus(true);
+  EXPECT_EQ(Table(view), view->GetFocusManager()->GetFocusedView());
+  Key(view, ui::VKEY_ESCAPE);
+  ASSERT_TRUE(base::test::RunUntil([&] { return !Overview(browser()); }));
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return original_focus == (BrowserView::GetBrowserViewForBrowser(browser())
+                                      ->GetWidget()
+                                      ->IsActive()
+                                  ? owner_focus->GetFocusedView()
+                                  : owner_focus->GetStoredFocusView());
+  }));
+  auto* popup = CreateBrowserForPopup(browser()->GetProfile());
+  EXPECT_EQ(nullptr, StainlessResourceOverviewView::Show(popup));
+  CloseBrowserSynchronously(popup);
+  ResourceAction(browser())->SetVisible(false);
+  EXPECT_EQ(nullptr, StainlessResourceOverviewView::Show(browser()));
+  ResourceAction(browser())->SetVisible(true);
+  auto* controller = chrome::BrowserCommandController::From(browser());
+  controller->UpdateCommandEnabled(IDC_SHOW_RESOURCE_OVERVIEW, false);
+  EXPECT_EQ(nullptr, StainlessResourceOverviewView::Show(browser()));
+  controller->UpdateCommandEnabled(IDC_SHOW_RESOURCE_OVERVIEW, true);
+  browser()->GetTabStripModel()->SetTabBlocked(
+      browser()->GetTabStripModel()->active_index(), true);
+  EXPECT_EQ(nullptr, StainlessResourceOverviewView::Show(browser()));
+  browser()->GetTabStripModel()->SetTabBlocked(
+      browser()->GetTabStripModel()->active_index(), false);
+  auto dialog = std::make_unique<views::DialogDelegate>();
+  dialog->SetModalType(ui::mojom::ModalType::kWindow);
+  auto params = views::DialogDelegate::GetDialogWidgetInitParams(
+      dialog.get(), gfx::NativeWindow(),
+      BrowserView::GetBrowserViewForBrowser(browser())
+          ->GetWidget()
+          ->GetNativeView(),
+      gfx::Rect());
+  params.ownership = views::Widget::InitParams::CLIENT_OWNS_WIDGET;
+  auto modal = std::make_unique<views::Widget>();
+  modal->Init(std::move(params));
+  modal->Show();
+  EXPECT_EQ(nullptr, StainlessResourceOverviewView::Show(browser()));
+  modal->Close();
+  base::RunLoop().RunUntilIdle();
+  modal.reset();
+}
+
+IN_PROC_BROWSER_TEST_F(StainlessResourceOverviewBrowserTest,
+                       SamplerFailuresRemainUnknownInsteadOfZero) {
+  VerifySamplerFailure();
+}
