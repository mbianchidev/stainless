+#include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+#include "components/sessions/core/session_id.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/base/models/table_model.h"
+#include "ui/base/unowned_user_data/scoped_unowned_user_data.h"
+#include "ui/views/view.h"
+#include "ui/views/widget/widget_observer.h"
+
+class BrowserWindowInterface;
+class StainlessResourceOverviewBrowserTest;
+
+namespace views {
+class Label;
+class TableView;
+class ViewTracker;
+}  // namespace views
+
+class StainlessResourceOverviewView : public views::View,
+                                      public ui::TableModel,
+                                      public task_manager::TaskManagerObserver,
+                                      public TabStripModelObserver,
+                                      public views::WidgetObserver {
+  METADATA_HEADER(StainlessResourceOverviewView, views::View)
+
+ public:
+  DECLARE_USER_DATA(StainlessResourceOverviewView);
+  static StainlessResourceOverviewView* Show(BrowserWindowInterface* browser);
+
+  explicit StainlessResourceOverviewView(BrowserWindowInterface* browser);
+  ~StainlessResourceOverviewView() override;
+
+  size_t RowCount() const override;
+  std::u16string GetText(size_t row, int column_id) const override;
+  std::u16string GetTooltip(size_t row) const override;
+  void SetObserver(ui::TableModelObserver* observer) override;
+  void OnTaskAdded(task_manager::TaskId id) override;
+  void OnTaskToBeRemoved(task_manager::TaskId id) override;
+  void OnTasksRefreshedWithBackgroundCalculations(
+      const task_manager::TaskIdList& task_ids) override;
+  void OnTabStripModelChanged(
+      TabStripModel* model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+  void OnTabChangedAt(tabs::TabInterface* tab,
+                      TabChangeType change_type) override;
+  void OnTabStripModelDestroyed(TabStripModel* model) override;
+  void OnWidgetClosing(views::Widget* widget) override;
+  void OnWidgetDestroyed(views::Widget* widget) override;
+
+ private:
+  friend class StainlessResourceOverviewBrowserTest;
+
+  struct Row {
+    task_manager::TaskId task_id = -1;
+    SessionID tab_id = SessionID::InvalidValue();
+    std::optional<base::ProcessId> process_id;
+    std::u16string title;
+    std::u16string attribution;
+    std::vector<SessionID> tabs;
+    bool sampled = false;
+    std::optional<double> cpu;
+    std::optional<base::ByteSize> memory;
+  };
+
+  static std::u16string FormatCPU(std::optional<double> value, bool sampled);
+  static std::u16string FormatMemory(std::optional<base::ByteSize> value,
+                                     bool sampled);
+  void RefreshRows(std::optional<task_manager::TaskId> removing = std::nullopt);
+  void StopObserving();
+  void OnBrowserClosed(BrowserWindowInterface* browser);
+
+  base::WeakPtr<BrowserWindowInterface> browser_;
+  raw_ptr<views::TableView> table_ = nullptr;
+  raw_ptr<views::Label> status_ = nullptr;
+  raw_ptr<ui::TableModelObserver> model_observer_ = nullptr;
+  std::vector<Row> rows_;
+  std::set<task_manager::TaskId> sampled_tasks_;
+  std::unique_ptr<views::ViewTracker> return_focus_;
+  std::optional<ui::ScopedUnownedUserData<StainlessResourceOverviewView>>
+      registration_;
+  base::CallbackListSubscription browser_close_subscription_;
+  base::ScopedObservation<views::Widget, views::WidgetObserver>
+      widget_observation_{this};
+  bool closing_ = false;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_STAINLESS_RESOURCE_OVERVIEW_VIEW_H_
