+  stream.SendAudioToSpeechRecognitionService(std::move(audio), std::nullopt);
+  ASSERT_TRUE(
+      base::test::RunUntil([&] { return ready || !diagnostic.empty(); }));
+  ASSERT_TRUE(diagnostic.empty()) << diagnostic;
+  CheckElapsedSession(stream, base::Minutes(5) - base::Seconds(1));
+  EXPECT_FALSE(reason.has_value());
+  EXPECT_FALSE(disposed);
+  EXPECT_TRUE(diagnostic.empty());
+  EXPECT_TRUE(LocalBroker::Get()
+                  .ReservedSessionForProfile(browser()->GetProfile())
+                  .has_value());
+  CheckElapsedSession(stream, base::Minutes(5) + base::Seconds(1));
+  ASSERT_TRUE(
+      base::test::RunUntil([&] { return disposed && reason.has_value(); }));
+  EXPECT_EQ(static_cast<uint32_t>(
+                media::mojom::LocalSpeechDisconnectReason::kAborted),
+            *reason);
+  EXPECT_NE(std::string::npos, diagnostic.find("five-minute"));
+  ASSERT_NO_FATAL_FAILURE(WaitForRelease());
+  ASSERT_NO_FATAL_FAILURE(WaitForActivationExpiry());
+  const auto denied = Start();
+  ASSERT_TRUE(denied.FindList("errors"));
+  ASSERT_EQ(1u, denied.FindList("errors")->size());
+  EXPECT_EQ("service-not-allowed",
+            denied.FindList("errors")->front().GetString());
+  ASSERT_TRUE(BeginRecognition("en-US", true, true));
+  ASSERT_EQ(true, content::EvalJs(contents(), "speechAudioStarted",
+                                  content::EXECUTE_SCRIPT_NO_USER_GESTURE));
+  ASSERT_TRUE(content::ExecJs(contents(), "recognition.abort()"));
+  const auto restarted = EndRecognition();
+  ASSERT_TRUE(restarted.FindList("errors"));
+  ASSERT_EQ(1u, restarted.FindList("errors")->size());
+  EXPECT_EQ("aborted", restarted.FindList("errors")->front().GetString());
+  ASSERT_NO_FATAL_FAILURE(WaitForRelease());
+  EXPECT_EQ(0, FeatureRequests());
+}
+
 INSTANTIATE_TEST_SUITE_P(LocalOnlyModes,
                          StainlessLocalSpeechApiBrowserTest,
                          testing::Bool());
