+  enum class Cancellation { kAbort, kHide, kMicrophoneRevoke, kDisable };
+
+  void CancellationCase(Cancellation action) {
+    base::test::ScopedRunLoopTimeout deadline(FROM_HERE, base::Minutes(2));
+    SimulateMicrophoneDecision();
+    Enable();
+    ASSERT_NO_FATAL_FAILURE(Seed());
+    base::DictValue fixture;
+    ASSERT_NO_FATAL_FAILURE(FrozenSpeechCase(fixture));
+    ASSERT_TRUE(BeginRecognition(*fixture.FindString("language"), true));
+    ASSERT_NO_FATAL_FAILURE(WaitForInference());
+    const int before = content::EvalJs(contents(), "speechState.results",
+                                       content::EXECUTE_SCRIPT_NO_USER_GESTURE)
+                           .ExtractInt();
+    const char* expected = "aborted";
+    switch (action) {
+      case Cancellation::kAbort:
+        ASSERT_TRUE(content::ExecJs(contents(), "recognition.abort()"));
+        break;
+      case Cancellation::kHide:
+        contents()->WasHidden();
+        break;
+      case Cancellation::kMicrophoneRevoke: {
+        const auto origin = contents()->GetLastCommittedURL();
+        HostContentSettingsMapFactory::GetForProfile(browser()->GetProfile())
+            ->SetContentSettingDefaultScope(
+                origin, origin, ContentSettingsType::MEDIASTREAM_MIC,
+                CONTENT_SETTING_BLOCK);
+        expected = "not-allowed";
+        break;
+      }
+      case Cancellation::kDisable:
+        ASSERT_TRUE(LocalModels::Get(browser()->GetProfile())
+                        ->ConfigureFeature("speech", false, false)
+                        .has_value());
+        expected = "service-not-allowed";
+        break;
+    }
+    const auto result = EndRecognition();
+    if (action == Cancellation::kHide) {
+      contents()->WasShown();
+    }
+    ASSERT_TRUE(result.FindList("errors"));
+    ASSERT_EQ(1u, result.FindList("errors")->size());
+    EXPECT_EQ(expected, result.FindList("errors")->front().GetString());
+    EXPECT_EQ(1, result.FindInt("ends"));
+    EXPECT_EQ(before, result.FindInt("results"));
+    ASSERT_NO_FATAL_FAILURE(WaitForRelease());
+    EXPECT_EQ(before, content::EvalJs(contents(), "speechState.results",
+                                      content::EXECUTE_SCRIPT_NO_USER_GESTURE));
+    EXPECT_EQ(0, FeatureRequests());
+  }
