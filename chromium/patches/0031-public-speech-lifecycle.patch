+  void ExpectFrozenSpeech(const base::DictValue& result,
+                          const base::DictValue& fixture) {
+    ASSERT_TRUE(result.FindList("errors"));
+    EXPECT_TRUE(result.FindList("errors")->empty());
+    EXPECT_TRUE(result.FindBool("final").value_or(false));
+    EXPECT_GT(result.FindInt("results").value_or(0), 0);
+    const auto* text = result.FindString("text");
+    ASSERT_TRUE(text);
+    EXPECT_GE(
+        content::EvalJs(contents(),
+                        content::JsReplace(
+                            R"(
+        (() => {
+          const words = $1.toLowerCase().normalize('NFD')
+              .replace(/\p{Diacritic}/gu, '').match(/[\p{Letter}\p{Number}]+/gu) || [];
+          return $2
+              .filter(group => group.some(word => words.includes(word))).length;
+        })()
+      )",
+                            *text, fixture.FindList("content_words")->Clone()),
+                        content::EXECUTE_SCRIPT_NO_USER_GESTURE)
+            .ExtractInt(),
+        4);
+  }
