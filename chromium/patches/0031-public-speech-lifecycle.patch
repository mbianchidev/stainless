+IN_PROC_BROWSER_TEST_P(
+    StainlessLocalSpeechApiBrowserTest,
+    MANUAL_InstallUnmaskDoesNotSurviveConsentOrDocumentChanges) {
+  Enable();
+  ASSERT_NO_FATAL_FAILURE(Seed());
+  EXPECT_EQ("downloadable", Available());
+  EXPECT_EQ("true", Install(true));
+  EXPECT_EQ("available", Available());
+  ASSERT_TRUE(LocalModels::Get(browser()->GetProfile())
+                  ->ConfigureFeature("speech", false, false)
+                  .has_value());
+  EXPECT_EQ("downloadable", Available());
+  Enable();
+  EXPECT_EQ("NotAllowedError", Install(false));
+  EXPECT_EQ("downloadable", Available());
+  EXPECT_EQ("true", Install(true));
+  EXPECT_EQ("available", Available());
+  const auto origin = contents()->GetLastCommittedURL();
+  auto* settings =
+      HostContentSettingsMapFactory::GetForProfile(browser()->GetProfile());
+  settings->SetContentSettingDefaultScope(origin, origin,
+                                          ContentSettingsType::MEDIASTREAM_MIC,
+                                          CONTENT_SETTING_BLOCK);
+  EXPECT_EQ("downloadable", Available());
+  EXPECT_EQ("NotAllowedError", Install(false));
+  settings->SetContentSettingDefaultScope(origin, origin,
+                                          ContentSettingsType::MEDIASTREAM_MIC,
+                                          CONTENT_SETTING_ASK);
+  EXPECT_EQ("true", Install(true));
+  EXPECT_EQ("available", Available());
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("/empty.html?next-document")));
+  EXPECT_EQ("downloadable", Available());
+  EXPECT_EQ("NotAllowedError", Install(false));
+  EXPECT_EQ(0, Prompts());
+  EXPECT_EQ(0, FeatureRequests());
+}
