+// Stainless builds lead with their own release and keep Chromium's version as
+// the engine version, filling the slots Chromium uses for its build labels.
+constexpr std::string_view kStainlessVersion =
+    BUILDFLAG(STAINLESS_PRODUCT_VERSION);
+constexpr bool kShowStainlessVersion = !kStainlessVersion.empty();
+
+std::u16string StainlessBuildLabel() {
+  return l10n_util::GetStringFUTF16(
+      IDS_STAINLESS_VERSION_BUILD,
+      base::NumberToString16(BUILDFLAG(STAINLESS_PRODUCT_BUILD)));
+}
+
+std::u16string StainlessEngineLabel() {
+  std::u16string label = l10n_util::GetStringFUTF16(
+      IDS_STAINLESS_VERSION_POWERED_BY,
+      base::UTF8ToUTF16(base::StrCat({"Chromium ",
+                                      version_info::GetVersionNumber(),
+                                      GetVersionInformationalSuffix()})));
+  if (std::string modifier = GetProductModifier(); !modifier.empty()) {
+    label += u" " + base::UTF8ToUTF16(modifier);
+  }
+  return label;
+}
+
