+using performance_manager::PerformanceManager;
+using performance_manager::freezing::CannotFreezeReason;
+using performance_manager::policies::CannotDiscardReason;
+using performance_manager::policies::DiscardEligibilityPolicy;
+
+int ReasonMessage(CannotDiscardReason reason) {
+  switch (reason) {
+    case CannotDiscardReason::kVisible:
+    case CannotDiscardReason::kRecentlyVisible:
+    case CannotDiscardReason::kActiveTab:
+      return IDS_STAINLESS_RESOURCES_REASON_VISIBLE;
+    case CannotDiscardReason::kAudible:
+    case CannotDiscardReason::kRecentlyAudible:
+    case CannotDiscardReason::kPictureInPicture:
+      return IDS_STAINLESS_RESOURCES_REASON_MEDIA;
+    case CannotDiscardReason::kCapturingVideo:
+    case CannotDiscardReason::kCapturingAudio:
+    case CannotDiscardReason::kBeingMirrored:
+    case CannotDiscardReason::kCapturingWindow:
+    case CannotDiscardReason::kCapturingDisplay:
+      return IDS_STAINLESS_RESOURCES_REASON_CAPTURE;
+    case CannotDiscardReason::kConnectedToBluetooth:
+    case CannotDiscardReason::kConnectedToUSB:
+      return IDS_STAINLESS_RESOURCES_REASON_DEVICE;
+    case CannotDiscardReason::kFormInteractions:
+    case CannotDiscardReason::kUserEdits:
+      return IDS_STAINLESS_RESOURCES_REASON_INPUT;
+    case CannotDiscardReason::kPdf:
+      return IDS_STAINLESS_RESOURCES_REASON_PDF;
+    case CannotDiscardReason::kDevToolsOpen:
+      return IDS_STAINLESS_RESOURCES_REASON_DEVTOOLS;
+    case CannotDiscardReason::kPinnedTab:
+      return IDS_STAINLESS_RESOURCES_REASON_PINNED;
+    case CannotDiscardReason::kOptedOut:
+    case CannotDiscardReason::kExtensionProtected:
+    case CannotDiscardReason::kWebApp:
+      return IDS_STAINLESS_RESOURCES_REASON_KEPT_ACTIVE;
+    case CannotDiscardReason::kNotATab:
+    case CannotDiscardReason::kAlreadyDiscarded:
+    case CannotDiscardReason::kDiscardAttempted:
+    case CannotDiscardReason::kNoMainFrame:
+    case CannotDiscardReason::kNotWebOrInternal:
+    case CannotDiscardReason::kInvalidURL:
+    case CannotDiscardReason::kNotificationsEnabled:
+    case CannotDiscardReason::kBackgroundActivity:
+    case CannotDiscardReason::kGlicShared:
+      return IDS_STAINLESS_RESOURCES_REASON_UNCHECKED;
+  }
+  NOTREACHED();
+}
+
+// Ending a renderer is explicit, so visibility and keep-active preferences do
+// not block it. Lost input, media, capture, devices, DevTools and unchecked
+// pages still do.
+bool BlocksEnding(CannotDiscardReason reason) {
+  switch (reason) {
+    case CannotDiscardReason::kVisible:
+    case CannotDiscardReason::kRecentlyVisible:
+    case CannotDiscardReason::kActiveTab:
+    case CannotDiscardReason::kPinnedTab:
+    case CannotDiscardReason::kOptedOut:
+    case CannotDiscardReason::kExtensionProtected:
+    case CannotDiscardReason::kWebApp:
+    case CannotDiscardReason::kNotificationsEnabled:
+    case CannotDiscardReason::kBackgroundActivity:
+    case CannotDiscardReason::kGlicShared:
+      return false;
+    default:
+      return true;
+  }
+}
+
+int WaitMessage(CannotFreezeReason reason) {
+  switch (reason) {
+    case CannotFreezeReason::kVisible:
+    case CannotFreezeReason::kRecentlyVisible:
+      return IDS_STAINLESS_RESOURCES_WAIT_RECENT;
+    case CannotFreezeReason::kAudible:
+    case CannotFreezeReason::kRecentlyAudible:
+      return IDS_STAINLESS_RESOURCES_REASON_MEDIA;
+    case CannotFreezeReason::kCapturingVideo:
+    case CannotFreezeReason::kCapturingAudio:
+    case CannotFreezeReason::kBeingMirrored:
+    case CannotFreezeReason::kCapturingWindow:
+    case CannotFreezeReason::kCapturingDisplay:
+      return IDS_STAINLESS_RESOURCES_REASON_CAPTURE;
+    case CannotFreezeReason::kConnectedToUsbDevice:
+    case CannotFreezeReason::kConnectedToBluetoothDevice:
+    case CannotFreezeReason::kConnectedToHidDevice:
+    case CannotFreezeReason::kConnectedToSerialPort:
+      return IDS_STAINLESS_RESOURCES_REASON_DEVICE;
+    case CannotFreezeReason::kHoldingWebLock:
+    case CannotFreezeReason::kHoldingIndexedDBLock:
+    case CannotFreezeReason::kHoldingBlockingIndexedDBLock:
+      return IDS_STAINLESS_RESOURCES_WAIT_LOCK;
+    case CannotFreezeReason::kWebRTC:
+      return IDS_STAINLESS_RESOURCES_WAIT_WEBRTC;
+    case CannotFreezeReason::kLoading:
+      return IDS_STAINLESS_RESOURCES_WAIT_LOADING;
+    case CannotFreezeReason::kNotificationPermission:
+      return IDS_STAINLESS_RESOURCES_WAIT_NOTIFICATIONS;
+    case CannotFreezeReason::kFreezingOriginTrialOptOut:
+    case CannotFreezeReason::kOptedOut:
+    case CannotFreezeReason::kWebUI:
+      return IDS_STAINLESS_RESOURCES_REASON_KEPT_ACTIVE;
+    case CannotFreezeReason::kMostRecentlyUsed:
+      return 0;
+  }
+  NOTREACHED();
+}
+
+base::WeakPtr<performance_manager::PageNode> PageNodeFor(
+    content::WebContents* contents) {
+  if (!contents || !PerformanceManager::IsAvailable()) {
+    return nullptr;
+  }
+  return PerformanceManager::GetPrimaryPageNodeForWebContents(contents);
+}
+
+bool IsBackgroundTab(content::WebContents* contents) {
+  auto* tab = tabs::TabInterface::MaybeGetFromContents(contents);
+  return tab && !tab->IsActivated() &&
+         contents->GetVisibility() != content::Visibility::VISIBLE;
+}
+
+// Holds a freezing vote while its tab stays in the background.
+class PausedTab : public content::WebContentsUserData<PausedTab>,
+                  public content::WebContentsObserver {
+ public:
+  ~PausedTab() override = default;
+
+  void OnVisibilityChanged(content::Visibility visibility) override {
+    if (visibility == content::Visibility::VISIBLE) {
+      // Selecting a paused tab resumes it. This deletes `this`.
+      web_contents()->RemoveUserData(UserDataKey());
+    }
+  }
+
+ private:
+  friend class content::WebContentsUserData<PausedTab>;
+
+  explicit PausedTab(content::WebContents* contents)
+      : content::WebContentsUserData<PausedTab>(*contents),
+        content::WebContentsObserver(contents),
+        vote_(contents) {}
+
+  performance_manager::freezing::FreezingVote vote_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(PausedTab);
+
+class ResourceLimiterImpl : public KeyedService,
+                            public ResourceLimiter,
+                            public task_manager::TaskManagerObserver {
+ public:
+  explicit ResourceLimiterImpl(Profile* profile)
+      : task_manager::TaskManagerObserver(
+            kResourceLimitInterval,
+            task_manager::REFRESH_TYPE_MEMORY_FOOTPRINT),
+        profile_(profile) {
+    registrar_.Init(profile->GetPrefs());
+    registrar_.Add(prefs::kStainlessBackgroundTabMemoryLimit,
+                   base::BindRepeating(&ResourceLimiterImpl::Update,
+                                       base::Unretained(this)));
+    // Start sampling after profile creation, not during it.
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&ResourceLimiterImpl::Update,
+                                  weak_factory_.GetWeakPtr()));
+  }
+
+  ~ResourceLimiterImpl() override { Shutdown(); }
+
+  // KeyedService:
+  void Shutdown() override {
+    registrar_.RemoveAll();
+    if (auto* manager = observed_task_manager()) {
+      manager->RemoveObserver(this);
+    }
+    weak_factory_.InvalidateWeakPtrs();
+  }
+
+  // ResourceLimiter:
+  const Outcome* last_outcome() const override {
+    return last_outcome_ ? &*last_outcome_ : nullptr;
+  }
+  base::CallbackListSubscription AddOutcomeCallback(
+      base::RepeatingClosure callback) override {
+    return callbacks_.Add(std::move(callback));
+  }
+  bool IsSampling() const override {
+    return observed_task_manager() != nullptr;
+  }
+
+  // task_manager::TaskManagerObserver:
+  void OnTasksRefreshedWithBackgroundCalculations(
+      const task_manager::TaskIdList& task_ids) override {
+    Enforce(task_ids);
+  }
+
+ private:
+  int LimitMB() const {
+    return profile_->GetPrefs()->GetInteger(
+        prefs::kStainlessBackgroundTabMemoryLimit);
+  }
+
+  void Update() {
+    auto* manager = observed_task_manager();
+    if (LimitMB() > 0 && !manager) {
+      task_manager::TaskManagerInterface::GetTaskManager()->AddObserver(this);
+    } else if (LimitMB() <= 0 && manager) {
+      manager->RemoveObserver(this);
+    }
+    if (LimitMB() <= 0 && last_outcome_) {
+      last_outcome_.reset();
+      callbacks_.Notify();
+    }
+  }
+
+  void Enforce(const task_manager::TaskIdList& task_ids) {
+    auto* manager = observed_task_manager();
+    const int limit = LimitMB();
+    if (!manager || limit <= 0) {
+      return;
+    }
+    const base::ByteSize limit_bytes =
+        base::MiB(static_cast<uint64_t>(limit));
+    std::set<content::RenderProcessHost*> seen;
+    std::vector<std::pair<Outcome, std::vector<base::WeakPtr<content::WebContents>>>>
+        decisions;
+    for (auto id : task_ids) {
+      if (!manager->IsTaskValid(id) ||
+          manager->GetType(id) != task_manager::Task::RENDERER) {
+        continue;
+      }
+      std::optional<base::ByteSize> footprint =
+          manager->GetMemoryFootprintUsage(id);
+      if (!footprint || *footprint <= limit_bytes) {
+        continue;
+      }
+      auto* host = content::RenderProcessHost::FromID(
+          manager->GetChildProcessUniqueId(id));
+      if (!host || !host->IsInitializedAndNotDead() ||
+          !seen.insert(host).second ||
+          Profile::FromBrowserContext(host->GetBrowserContext())
+                  ->GetOriginalProfile() != profile_) {
+        continue;
+      }
+      std::set<content::WebContents*> pages;
+      host->ForEachRenderFrameHost([&pages](content::RenderFrameHost* frame) {
+        pages.insert(content::WebContents::FromRenderFrameHost(frame));
+      });
+      Outcome outcome;
+      outcome.time = base::Time::Now();
+      outcome.footprint = *footprint;
+      std::vector<base::WeakPtr<content::WebContents>> targets;
+      auto add = [&outcome](int message) {
+        if (message && !std::ranges::contains(outcome.reasons, message)) {
+          outcome.reasons.push_back(message);
+        }
+      };
+      for (content::WebContents* page : pages) {
+        if (!page || page->IsBeingDestroyed()) {
+          continue;
+        }
+        if (!tabs::TabInterface::MaybeGetFromContents(page)) {
+          add(IDS_STAINLESS_RESOURCES_REASON_OUTSIDE);
+          continue;
+        }
+        outcome.titles.push_back(page->GetTitle());
+        if (!IsBackgroundTab(page)) {
+          add(IDS_STAINLESS_RESOURCES_REASON_VISIBLE);
+        }
+        for (int message : DiscardRefusals(page, /*ending=*/false)) {
+          add(message);
+        }
+        targets.push_back(page->GetWeakPtr());
+      }
+      outcome.enforced = outcome.reasons.empty() && !targets.empty();
+      decisions.emplace_back(std::move(outcome), std::move(targets));
+    }
+    if (decisions.empty()) {
+      return;
+    }
+    // Discarding replaces web contents and renderers, so act after sampling.
+    for (auto& [outcome, targets] : decisions) {
+      if (outcome.enforced) {
+        for (const auto& target : targets) {
+          auto* unit =
+              target ? resource_coordinator::TabLifecycleUnitExternal::
+                           FromWebContents(target.get())
+                     : nullptr;
+          if (!unit ||
+              !unit->DiscardTab(::mojom::LifecycleUnitDiscardReason::EXTERNAL)) {
+            outcome.enforced = false;
+            outcome.reasons.push_back(IDS_STAINLESS_RESOURCES_REASON_UNCHECKED);
+          }
+        }
+      }
+      LOG(WARNING) << "Background tab memory limit of " << limit << " MB "
+                   << (outcome.enforced ? "hibernated" : "not enforced for")
+                   << " a renderer using " << outcome.footprint.InMiB()
+                   << " MB";
+      last_outcome_ = std::move(outcome);
+    }
+    callbacks_.Notify();
+  }
+
+  const raw_ptr<Profile> profile_;
+  PrefChangeRegistrar registrar_;
+  std::optional<Outcome> last_outcome_;
+  base::RepeatingClosureList callbacks_;
+  base::WeakPtrFactory<ResourceLimiterImpl> weak_factory_{this};
+};
+
+class ResourceLimiterFactory final : public ProfileKeyedServiceFactory {
+ public:
+  static ResourceLimiterFactory* Get() {
+    static base::NoDestructor<ResourceLimiterFactory> factory;
+    return factory.get();
+  }
+
+  ResourceLimiterFactory()
+      : ProfileKeyedServiceFactory(
+            "StainlessResourceLimiter",
+            ProfileSelections::Builder()
+                .WithRegular(ProfileSelection::kOriginalOnly)
+                .WithGuest(ProfileSelection::kNone)
+                .WithSystem(ProfileSelection::kNone)
+                .Build()) {}
+
+  ResourceLimiterImpl* ForProfile(Profile* profile) {
+    return static_cast<ResourceLimiterImpl*>(
+        GetServiceForBrowserContext(profile, /*create=*/true));
+  }
+
+ private:
+  std::unique_ptr<KeyedService> BuildServiceInstanceForBrowserContext(
+      content::BrowserContext* context) const override {
+    return std::make_unique<ResourceLimiterImpl>(
+        Profile::FromBrowserContext(context));
+  }
+
+  bool ServiceIsCreatedWithBrowserContext() const override { return true; }
+};
+
+}  // namespace
+
+std::vector<int> DiscardRefusals(content::WebContents* contents, bool ending) {
+  std::vector<int> messages;
+  auto add = [&messages](int message) {
+    if (!std::ranges::contains(messages, message)) {
+      messages.push_back(message);
+    }
+  };
+  base::WeakPtr<performance_manager::PageNode> node = PageNodeFor(contents);
+  auto* policy = node ? DiscardEligibilityPolicy::GetFromGraph(
+                            PerformanceManager::GetGraph())
+                      : nullptr;
+  if (!policy) {
+    add(IDS_STAINLESS_RESOURCES_REASON_UNCHECKED);
+    return messages;
+  }
+  std::vector<CannotDiscardReason> reasons;
+  policy->CanDiscard(node.get(), DiscardEligibilityPolicy::DiscardReason::URGENT,
+                     /*ignore_recent_visibility=*/true, &reasons);
+  for (auto reason : reasons) {
+    if (!ending || BlocksEnding(reason)) {
+      add(ReasonMessage(reason));
+    }
+  }
+  contents->GetPrimaryMainFrame()->ForEachRenderFrameHostWithAction(
+      [&add](content::RenderFrameHost* frame) {
+        if (frame->CouldDisplayBeforeUnloadDialog()) {
+          add(IDS_STAINLESS_RESOURCES_REASON_INPUT);
+          return content::RenderFrameHost::FrameIterationAction::kStop;
+        }
+        return content::RenderFrameHost::FrameIterationAction::kContinue;
+      });
+  return messages;
+}
+
+bool PauseTab(content::WebContents* contents) {
+  if (!contents || !IsBackgroundTab(contents) || !PageNodeFor(contents)) {
+    return false;
+  }
+  PausedTab::CreateForWebContents(contents);
+  return true;
+}
+
+void ResumeTab(content::WebContents* contents) {
+  if (contents) {
+    contents->RemoveUserData(PausedTab::UserDataKey());
+  }
+}
+
+bool IsTabPaused(content::WebContents* contents) {
+  return contents && PausedTab::FromWebContents(contents);
+}
+
+bool IsTabFrozen(content::WebContents* contents) {
+  base::WeakPtr<performance_manager::PageNode> node = PageNodeFor(contents);
+  return node && node->GetLifecycleState() ==
+                     performance_manager::PageNode::LifecycleState::kFrozen;
+}
+
+std::vector<int> PauseWaitReasons(content::WebContents* contents) {
+  std::vector<int> messages;
+  base::WeakPtr<performance_manager::PageNode> node = PageNodeFor(contents);
+  if (!node) {
+    messages.push_back(IDS_STAINLESS_RESOURCES_REASON_UNCHECKED);
+    return messages;
+  }
+  const auto details =
+      performance_manager::freezing::GetCanFreezeDetailsForPageNode(node.get());
+  for (CannotFreezeReason reason : details.cannot_freeze_reasons) {
+    const int message = WaitMessage(reason);
+    if (message && !std::ranges::contains(messages, message)) {
+      messages.push_back(message);
+    }
+  }
+  if (messages.empty() &&
+      !details.cannot_freeze_reasons_connected_pages.empty()) {
+    messages.push_back(IDS_STAINLESS_RESOURCES_WAIT_CONNECTED);
+  }
+  return messages;
+}
+
+void RegisterResourceLimitProfilePrefs(
+    user_prefs::PrefRegistrySyncable* registry) {
+  registry->RegisterIntegerPref(prefs::kStainlessBackgroundTabMemoryLimit, 0);
+}
+
+ResourceLimiter::Outcome::Outcome() = default;
+ResourceLimiter::Outcome::Outcome(const Outcome&) = default;
+ResourceLimiter::Outcome& ResourceLimiter::Outcome::operator=(const Outcome&) =
+    default;
+ResourceLimiter::Outcome::~Outcome() = default;
+
+// static
+ResourceLimiter* ResourceLimiter::ForProfile(Profile* profile) {
+  return profile ? ResourceLimiterFactory::Get()->ForProfile(
+                       profile->GetOriginalProfile())
+                 : nullptr;
+}
+
+void EnsureResourceLimiterFactory() {
+  ResourceLimiterFactory::Get();
+}
+
+}  // namespace stainless
