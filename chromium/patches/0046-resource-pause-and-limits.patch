+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "ui/views/controls/combobox/combobox.h"
+
+class StainlessResourceControlsBrowserTest : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    ASSERT_TRUE(embedded_test_server()->Start());
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(
+        browser(), embedded_test_server()->GetURL("a.test", "/title1.html")));
+  }
+
+  // Opens `host` in a background tab of `owner` and waits for it to load.
+  content::WebContents* OpenBackground(BrowserWindowInterface* owner,
+                                       const char* host) {
+    EXPECT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        owner, embedded_test_server()->GetURL(host, "/title2.html"),
+        ui::mojom::WindowOpenDisposition::kNewBackgroundTab,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    TabStripModel* tabs = owner->GetTabStripModel();
+    return tabs->GetWebContentsAt(tabs->count() - 1);
+  }
+
+  content::WebContents* active() {
+    return browser()->GetTabStripModel()->GetActiveWebContents();
+  }
+
+  PrefService& prefs() { return *browser()->GetProfile()->GetPrefs(); }
+
+  static views::Combobox* Limit(StainlessResourceOverviewView* overview) {
+    return overview->limit_;
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(StainlessResourceControlsBrowserTest,
+                       PausedBackgroundTabFreezesAndSelectingResumesIt) {
+  EXPECT_FALSE(stainless::PauseTab(active()));
+  EXPECT_FALSE(stainless::IsTabPaused(active()));
+
+  content::WebContents* background = OpenBackground(browser(), "b.test");
+  ASSERT_TRUE(stainless::PauseTab(background));
+  EXPECT_TRUE(stainless::IsTabPaused(background));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return stainless::IsTabFrozen(background); }));
+
+  // Selecting the tab drops the pause for good.
+  browser()->GetTabStripModel()->ActivateTabAt(
+      browser()->GetTabStripModel()->GetIndexOfWebContents(background));
+  EXPECT_FALSE(stainless::IsTabPaused(background));
+  EXPECT_TRUE(base::test::RunUntil(
+      [&] { return !stainless::IsTabFrozen(background); }));
+  EXPECT_EQ(u"Title Of Awesomeness", background->GetTitle());
+}
+
+IN_PROC_BROWSER_TEST_F(StainlessResourceControlsBrowserTest,
+                       ResumeUnfreezesAndRecentlyShownTabsWait) {
+  content::WebContents* background = OpenBackground(browser(), "b.test");
+  ASSERT_TRUE(stainless::PauseTab(background));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return stainless::IsTabFrozen(background); }));
+  stainless::ResumeTab(background);
+  EXPECT_FALSE(stainless::IsTabPaused(background));
+  EXPECT_TRUE(base::test::RunUntil(
+      [&] { return !stainless::IsTabFrozen(background); }));
+
+  // A tab that was just shown keeps running and says why.
+  content::WebContents* shown = active();
+  browser()->GetTabStripModel()->ActivateTabAt(
+      browser()->GetTabStripModel()->GetIndexOfWebContents(background));
+  ASSERT_TRUE(stainless::PauseTab(shown));
+  EXPECT_FALSE(stainless::IsTabFrozen(shown));
+  EXPECT_TRUE(std::ranges::contains(stainless::PauseWaitReasons(shown),
+                             IDS_STAINLESS_RESOURCES_WAIT_RECENT));
+}
+
+IN_PROC_BROWSER_TEST_F(StainlessResourceControlsBrowserTest,
+                       MemoryLimitIsOffByDefaultAndSamplesOnlyWhenOn) {
+  stainless::ResourceLimiter* limiter =
+      stainless::ResourceLimiter::ForProfile(browser()->GetProfile());
+  ASSERT_TRUE(limiter);
+  EXPECT_EQ(0, prefs().GetInteger(prefs::kStainlessBackgroundTabMemoryLimit));
+  EXPECT_FALSE(limiter->IsSampling());
+  prefs().SetInteger(prefs::kStainlessBackgroundTabMemoryLimit, 512);
+  EXPECT_TRUE(limiter->IsSampling());
+  prefs().SetInteger(prefs::kStainlessBackgroundTabMemoryLimit, 0);
+  EXPECT_FALSE(limiter->IsSampling());
+
+  // Private windows use their profile's limiter and cannot change the limit.
+  BrowserWindowInterface* incognito = CreateIncognitoBrowser();
+  EXPECT_EQ(limiter, stainless::ResourceLimiter::ForProfile(
+                         incognito->GetProfile()));
+  StainlessResourceOverviewView* overview =
+      StainlessResourceOverviewView::Show(incognito);
+  ASSERT_TRUE(overview);
+  EXPECT_FALSE(Limit(overview)->GetEnabled());
+}
+
+IN_PROC_BROWSER_TEST_F(StainlessResourceControlsBrowserTest,
+                       MemoryLimitHibernatesOnlySafeBackgroundTabs) {
+  content::WebContents* foreground = active();
+  tabs::TabInterface* safe =
+      tabs::TabInterface::GetFromContents(OpenBackground(browser(), "b.test"));
+  content::WebContents* guarded = OpenBackground(browser(), "c.test");
+  content::PrepContentsForBeforeUnloadTest(guarded);
+  ASSERT_TRUE(content::ExecJs(guarded,
+                              "window.onbeforeunload = () => 'Unsaved';"));
+
+  StainlessResourceOverviewView* overview =
+      StainlessResourceOverviewView::Show(browser());
+  ASSERT_TRUE(overview);
+  // Every renderer is above 1 MB. Only the limit's own values are offered in
+  // the UI; this exercises enforcement quickly.
+  prefs().SetInteger(prefs::kStainlessBackgroundTabMemoryLimit, 1);
+  stainless::ResourceLimiter* limiter =
+      stainless::ResourceLimiter::ForProfile(browser()->GetProfile());
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return safe->GetContents()->WasDiscarded(); }));
+  ASSERT_TRUE(limiter->last_outcome());
+
+  // The selected tab and the tab with a "Leave site?" handler keep running.
+  EXPECT_FALSE(foreground->WasDiscarded());
+  EXPECT_FALSE(guarded->WasDiscarded());
+  EXPECT_EQ(foreground, active());
+  prefs().SetInteger(prefs::kStainlessBackgroundTabMemoryLimit, 0);
+  EXPECT_FALSE(limiter->last_outcome());
+  // Let the window close at the end of the test.
+  EXPECT_TRUE(content::ExecJs(guarded, "window.onbeforeunload = null;"));
+}
