+void StainlessResourceOverviewView::Pause() {
+  const Row* row = SelectedRow();
+  auto contents = row && row->task_id != -1
+                      ? OwnedContents(*row)
+                      : std::vector<content::WebContents*>();
+  if (contents.empty()) {
+    outcome_->SetText(Text(IDS_STAINLESS_RESOURCES_SELECT));
+    return;
+  }
+  std::vector<std::u16string> paused;
+  std::vector<std::u16string> waiting;
+  std::vector<std::u16string> refused;
+  for (auto* item : contents) {
+    if (!stainless::PauseTab(item)) {
+      refused.push_back(TabRefusal(item, {IDS_STAINLESS_RESOURCES_REASON_VISIBLE}));
+      continue;
+    }
+    paused.push_back(OwnedTabTitle(item));
+    if (!stainless::IsTabFrozen(item)) {
+      if (auto reasons = stainless::PauseWaitReasons(item); !reasons.empty()) {
+        waiting.push_back(TabRefusal(item, reasons));
+      }
+    }
+  }
+  std::vector<std::u16string> outcome;
+  if (!paused.empty()) {
+    outcome.push_back(l10n_util::GetStringFUTF16(
+        IDS_STAINLESS_RESOURCES_PAUSED, base::JoinString(paused, u"; ")));
+  }
+  if (!waiting.empty()) {
+    outcome.push_back(l10n_util::GetStringFUTF16(
+        IDS_STAINLESS_RESOURCES_PAUSE_WAITING, base::JoinString(waiting, u" ")));
+  }
+  if (!refused.empty()) {
+    outcome.push_back(l10n_util::GetStringFUTF16(
+        IDS_STAINLESS_RESOURCES_NOT_PAUSED, base::JoinString(refused, u" ")));
+  }
+  outcome_->SetText(base::JoinString(outcome, u" "));
+  RefreshRows();
+}
+
+void StainlessResourceOverviewView::Resume() {
+  const Row* row = SelectedRow();
+  auto contents = row && row->task_id != -1
+                      ? OwnedContents(*row)
+                      : std::vector<content::WebContents*>();
+  std::vector<std::u16string> resumed;
+  for (auto* item : contents) {
+    if (stainless::IsTabPaused(item)) {
+      stainless::ResumeTab(item);
+      resumed.push_back(OwnedTabTitle(item));
+    }
+  }
+  outcome_->SetText(
+      resumed.empty()
+          ? Text(IDS_STAINLESS_RESOURCES_NOTHING_TO_RESUME)
+          : l10n_util::GetStringFUTF16(IDS_STAINLESS_RESOURCES_RESUMED,
+                                       base::JoinString(resumed, u"; ")));
+  RefreshRows();
+}
+
+void StainlessResourceOverviewView::LimitChosen() {
+  std::optional<size_t> index = limit_->GetSelectedIndex();
+  if (!browser_ || !index ||
+      *index >= stainless::kBackgroundTabMemoryLimits.size()) {
+    return;
+  }
+  PrefService* prefs = browser_->GetProfile()->GetOriginalProfile()->GetPrefs();
+  if (prefs->IsUserModifiablePreference(
+          prefs::kStainlessBackgroundTabMemoryLimit)) {
+    prefs->SetInteger(prefs::kStainlessBackgroundTabMemoryLimit,
+                      stainless::kBackgroundTabMemoryLimits[*index]);
+  }
+}
+
+void StainlessResourceOverviewView::UpdateLimit() {
+  if (!browser_) {
+    return;
+  }
+  Profile* profile = browser_->GetProfile();
+  PrefService* prefs = profile->GetOriginalProfile()->GetPrefs();
+  const int value = prefs->GetInteger(prefs::kStainlessBackgroundTabMemoryLimit);
+  const auto it = std::ranges::find(stainless::kBackgroundTabMemoryLimits, value);
+  if (it != stainless::kBackgroundTabMemoryLimits.end()) {
+    limit_->SetSelectedIndex(static_cast<size_t>(
+        std::distance(stainless::kBackgroundTabMemoryLimits.begin(), it)));
+  }
+  // Private windows show their profile's limit without changing it.
+  limit_->SetEnabled(!profile->IsOffTheRecord() &&
+                     prefs->IsUserModifiablePreference(
+                         prefs::kStainlessBackgroundTabMemoryLimit));
+  auto* limiter = stainless::ResourceLimiter::ForProfile(profile);
+  const auto* last = limiter ? limiter->last_outcome() : nullptr;
+  std::u16string text = Text(value > 0 ? IDS_STAINLESS_RESOURCES_LIMIT_ON
+                                       : IDS_STAINLESS_RESOURCES_LIMIT_EXPLANATION);
+  if (value > 0 && last) {
+    std::vector<std::u16string> reasons;
+    for (int message : last->reasons) {
+      reasons.push_back(Text(message));
+    }
+    const std::u16string titles = base::JoinString(last->titles, u"; ");
+    const std::u16string memory =
+        FormatMemory(last->footprint, /*sampled=*/true);
+    text += u" " + (last->enforced
+                        ? l10n_util::GetStringFUTF16(
+                              IDS_STAINLESS_RESOURCES_LIMIT_ENFORCED, titles,
+                              memory)
+                        : l10n_util::GetStringFUTF16(
+                              IDS_STAINLESS_RESOURCES_LIMIT_NOT_ENFORCED,
+                              titles, memory,
+                              base::JoinString(reasons, u"; ")));
+  }
+  limit_status_->SetText(text);
+}
