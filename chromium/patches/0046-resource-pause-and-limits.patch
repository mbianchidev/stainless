@@ -0,0 +1,92 @@
+// Copyright 2026 Synctune Open
+
+#ifndef CHROME_BROWSER_STAINLESS_RESOURCES_RESOURCE_CONTROLS_H_
+#define CHROME_BROWSER_STAINLESS_RESOURCES_RESOURCE_CONTROLS_H_
+
+#include <array>
+#include <string>
+#include <vector>
+
+#include "base/byte_size.h"
+#include "base/callback_list.h"
+#include "base/functional/callback_forward.h"
+#include "base/time/time.h"
+
+class Profile;
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+namespace user_prefs {
+class PrefRegistrySyncable;
+}  // namespace user_prefs
+
+namespace stainless {
+
+// Message IDs for each reason Chromium's urgent-discard protections, or a page
+// that could ask "Leave site?", give against hibernating (`ending` false) or
+// ending (`ending` true) `contents`. Empty when the action loses no state.
+std::vector<int> DiscardRefusals(content::WebContents* contents, bool ending);
+
+// Pausing votes, through Chromium's freezing policy, to freeze a background
+// tab. Chromium keeps the page running while it is visible, plays audio,
+// captures, uses devices or WebRTC, holds locks or loads, and freezes it once
+// none of those apply. Selecting the tab resumes it for good. Returns false for
+// a selected or visible tab.
+bool PauseTab(content::WebContents* contents);
+void ResumeTab(content::WebContents* contents);
+bool IsTabPaused(content::WebContents* contents);
+// Whether Chromium has actually frozen the page.
+bool IsTabFrozen(content::WebContents* contents);
+// Message IDs explaining why a paused tab is still running.
+std::vector<int> PauseWaitReasons(content::WebContents* contents);
+
+// Allowed values of prefs::kStainlessBackgroundTabMemoryLimit, in MB. 0 is off.
+inline constexpr std::array<int, 5> kBackgroundTabMemoryLimits = {0, 512, 1024,
+                                                              2048, 4096};
+
+void RegisterResourceLimitProfilePrefs(
+    user_prefs::PrefRegistrySyncable* registry);
+
+inline constexpr base::TimeDelta kResourceLimitInterval = base::Seconds(10);
+
+// Enforces a profile's opt-in background tab memory limit. While the limit is
+// on, it samples renderer memory every kResourceLimitInterval and hibernates a
+// renderer above the limit only when every page it hosts is a background tab
+// of this profile, or of its private windows, that DiscardRefusals() allows.
+// Anything else keeps running and is reported as not enforced.
+class ResourceLimiter {
+ public:
+  struct Outcome {
+    Outcome();
+    Outcome(const Outcome&);
+    Outcome& operator=(const Outcome&);
+    ~Outcome();
+
+    base::Time time;
+    bool enforced = false;
+    base::ByteSize footprint;
+    std::vector<std::u16string> titles;
+    // Message IDs of why the limit was not enforced.
+    std::vector<int> reasons;
+  };
+
+  // Null for profiles without a limiter, such as Guest and system profiles.
+  static ResourceLimiter* ForProfile(Profile* profile);
+
+  virtual ~ResourceLimiter() = default;
+
+  // The most recent renderer found above the limit, if any.
+  virtual const Outcome* last_outcome() const = 0;
+  virtual base::CallbackListSubscription AddOutcomeCallback(
+      base::RepeatingClosure callback) = 0;
+  virtual bool IsSampling() const = 0;
+};
+
+// Creates the limiter factory so limiters start with their profiles.
+void EnsureResourceLimiterFactory();
+
+}  // namespace stainless
+
+#endif  // CHROME_BROWSER_STAINLESS_RESOURCES_RESOURCE_CONTROLS_H_
