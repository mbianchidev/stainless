diff --git a/chrome/browser/ui/webui/settings/stainless_threat_protection_handler.cc b/chrome/browser/ui/webui/settings/stainless_threat_protection_handler.cc
new file mode 100644
index 0000000000000000000000000000000000000000..19b2e116a62844ac324f837c8ae93e460e89219e
--- /dev/null
+++ b/chrome/browser/ui/webui/settings/stainless_threat_protection_handler.cc
@@ -0,0 +1,78 @@
+// Copyright 2026 Synctune Open
+
+#include "chrome/browser/ui/webui/settings/stainless_threat_protection_handler.h"
+
+#include "base/functional/bind.h"
+#include "chrome/browser/stainless_threats/threat_list_service.h"
+#include "content/public/browser/web_ui.h"
+
+namespace settings {
+
+namespace {
+
+base::DictValue UnavailableStatus() {
+  return base::DictValue()
+      .Set("enabled", false)
+      .Set("loaded", false)
+      .Set("updating", false)
+      .Set("domainCount", 0)
+      .Set("sources", base::ListValue());
+}
+
+}  // namespace
+
+StainlessThreatProtectionHandler::StainlessThreatProtectionHandler() = default;
+StainlessThreatProtectionHandler::~StainlessThreatProtectionHandler() = default;
+
+void StainlessThreatProtectionHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "stainlessGetThreatProtectionStatus",
+      base::BindRepeating(&StainlessThreatProtectionHandler::HandleGetStatus,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "stainlessUpdateThreatLists",
+      base::BindRepeating(&StainlessThreatProtectionHandler::HandleUpdateNow,
+                          base::Unretained(this)));
+}
+
+void StainlessThreatProtectionHandler::OnJavascriptAllowed() {
+  if (auto* service = stainless_threats::ThreatListService::Get()) {
+    subscription_ = service->AddStatusObserver(
+        base::BindRepeating(&StainlessThreatProtectionHandler::OnStatusChanged,
+                            base::Unretained(this)));
+  }
+}
+
+void StainlessThreatProtectionHandler::OnJavascriptDisallowed() {
+  subscription_ = {};
+}
+
+void StainlessThreatProtectionHandler::HandleGetStatus(
+    const base::ListValue& args) {
+  if (args.size() != 1) {
+    return;
+  }
+  AllowJavascript();
+  auto* service = stainless_threats::ThreatListService::Get();
+  ResolveJavascriptCallback(
+      args[0], service ? service->GetStatus() : UnavailableStatus());
+}
+
+void StainlessThreatProtectionHandler::HandleUpdateNow(
+    const base::ListValue& args) {
+  if (!args.empty()) {
+    return;
+  }
+  if (auto* service = stainless_threats::ThreatListService::Get()) {
+    service->UpdateNow();
+  }
+}
+
+void StainlessThreatProtectionHandler::OnStatusChanged() {
+  if (auto* service = stainless_threats::ThreatListService::Get()) {
+    FireWebUIListener("stainless-threat-protection-status-changed",
+                      service->GetStatus());
+  }
+}
+
+}  // namespace settings
