+    content::BrowserContext* context) {
+  auto* allowlist =
+      static_cast<ThreatAllowlist*>(context->GetUserData(kAllowlistKey));
+  if (!allowlist) {
+    auto created = std::make_unique<ThreatAllowlist>();
+    allowlist = created.get();
+    context->SetUserData(kAllowlistKey, std::move(created));
+  }
+  return allowlist;
+}
+
+ThreatAllowlist::ThreatAllowlist() = default;
+ThreatAllowlist::~ThreatAllowlist() = default;
+
+bool ThreatAllowlist::Contains(const std::string& domain) const {
+  return domains_.contains(domain);
+}
+
+void ThreatAllowlist::Add(const std::string& domain) {
+  domains_.insert(domain);
+}
+
+ThreatControllerClient::ThreatControllerClient(
+    content::WebContents* web_contents,
+    const GURL& request_url,
+    std::string listed_domain)
+    : SecurityInterstitialControllerClient(
+          web_contents,
+          CreateMetricsHelper(request_url),
+          user_prefs::UserPrefs::Get(web_contents->GetBrowserContext()),
+          g_browser_process->GetApplicationLocale(),
+          GURL(chrome::kChromeUINewTabURL),
+          /*settings_page_helper=*/nullptr),
+      listed_domain_(std::move(listed_domain)) {}
+
+ThreatControllerClient::~ThreatControllerClient() = default;
+
+void ThreatControllerClient::Proceed() {
+  ThreatAllowlist::GetOrCreate(web_contents()->GetBrowserContext())
+      ->Add(listed_domain_);
+  Reload();
+}
+
+// static
+const security_interstitials::SecurityInterstitialPage::TypeID
+    ThreatBlockingPage::kTypeForTesting = &ThreatBlockingPage::kTypeForTesting;
+
+ThreatBlockingPage::ThreatBlockingPage(content::WebContents* web_contents,
+                                       const GURL& request_url,
+                                       std::string listed_domain)
+    : security_interstitials::SecurityInterstitialPage(
+          web_contents,
+          request_url,
+          std::make_unique<ThreatControllerClient>(web_contents,
+                                                   request_url,
+                                                   listed_domain)),
+      listed_domain_(std::move(listed_domain)) {}
+
+ThreatBlockingPage::~ThreatBlockingPage() = default;
+
+security_interstitials::SecurityInterstitialPage::TypeID
+ThreatBlockingPage::GetTypeForTesting() {
+  return kTypeForTesting;
+}
+
+void ThreatBlockingPage::CommandReceived(const std::string& command) {
+  if (command == "\"pageLoadComplete\"") {
+    return;
+  }
+  int value = 0;
+  if (!base::StringToInt(command, &value)) {
+    LOG(WARNING) << "Ignoring malformed threat warning command";
+    return;
+  }
+  switch (
+      static_cast<security_interstitials::SecurityInterstitialCommand>(value)) {
+    case security_interstitials::CMD_DONT_PROCEED:
+      controller()->GoBack();
+      break;
+    case security_interstitials::CMD_PROCEED:
+      controller()->Proceed();
+      break;
+    default:
+      // Reporting, help-center and settings commands are not offered here.
+      break;
+  }
+}
+
+void ThreatBlockingPage::PopulateInterstitialStrings(
+    base::DictValue& load_time_data) {
+  const std::u16string host = base::EscapeForHTML(
+      security_interstitials::common_string_util::GetFormattedHostName(
+          request_url()));
+  const std::u16string listed =
+      base::EscapeForHTML(base::UTF8ToUTF16(listed_domain_));
+  load_time_data.Set("type", "SAFEBROWSING");
+  load_time_data.Set("billing", false);
+  load_time_data.Set("phishing", true);
+  load_time_data.Set("overridable", true);
+  load_time_data.Set("hide_primary_button", false);
+  load_time_data.Set(security_interstitials::kDisplayCheckBox, false);
+  load_time_data.Set(security_interstitials::kBoxChecked, false);
+  load_time_data.Set(security_interstitials::kDisplayEnhancedProtectionMessage,
+                     false);
+  load_time_data.Set("optInLink", "");
+  load_time_data.Set("enhancedProtectionMessage", "");
+  load_time_data.Set("tabTitle",
+                     l10n_util::GetStringUTF16(IDS_SAFEBROWSING_HEADING));
+  load_time_data.Set("heading",
+                     l10n_util::GetStringUTF16(IDS_STAINLESS_THREAT_HEADING));
+  load_time_data.Set(
+      "primaryParagraph",
+      l10n_util::GetStringFUTF16(IDS_STAINLESS_THREAT_PRIMARY_PARAGRAPH, host));
+  load_time_data.Set("explanationParagraph",
+                     l10n_util::GetStringFUTF16(
+                         IDS_STAINLESS_THREAT_EXPLANATION_PARAGRAPH, listed));
+  load_time_data.Set(
+      "finalParagraph",
+      l10n_util::GetStringUTF16(IDS_STAINLESS_THREAT_FINAL_PARAGRAPH));
+  load_time_data.Set(
+      "openDetails",
+      l10n_util::GetStringUTF16(IDS_SAFEBROWSING_V3_OPEN_DETAILS_BUTTON));
+  load_time_data.Set(
+      "closeDetails",
+      l10n_util::GetStringUTF16(IDS_SAFEBROWSING_V3_CLOSE_DETAILS_BUTTON));
+  load_time_data.Set(
+      "primaryButtonText",
+      l10n_util::GetStringUTF16(IDS_SAFEBROWSING_OVERRIDABLE_SAFETY_BUTTON));
+}
+
+}  // namespace stainless_threats
