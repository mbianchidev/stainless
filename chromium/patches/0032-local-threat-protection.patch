+#include "content/public/browser/navigation_throttle_registry.h"
+#include "content/public/browser/web_contents.h"
+#include "net/base/net_errors.h"
+
+namespace stainless_threats {
+
+// static
+void ThreatNavigationThrottle::MaybeCreateAndAdd(
+    content::NavigationThrottleRegistry& registry) {
+  if (!registry.GetNavigationHandle().GetWebContents()) {
+    return;
+  }
+  registry.AddThrottle(std::make_unique<ThreatNavigationThrottle>(registry));
+}
+
+ThreatNavigationThrottle::ThreatNavigationThrottle(
+    content::NavigationThrottleRegistry& registry)
+    : content::NavigationThrottle(registry) {}
+
+ThreatNavigationThrottle::~ThreatNavigationThrottle() = default;
+
+content::NavigationThrottle::ThrottleCheckResult
+ThreatNavigationThrottle::WillStartRequest() {
+  return Check();
+}
+
+content::NavigationThrottle::ThrottleCheckResult
+ThreatNavigationThrottle::WillRedirectRequest() {
+  return Check();
+}
+
+const char* ThreatNavigationThrottle::GetNameForLogging() {
+  return "StainlessThreatNavigationThrottle";
+}
+
+content::NavigationThrottle::ThrottleCheckResult
+ThreatNavigationThrottle::Check() {
+  ThreatListService* service = ThreatListService::Get();
+  content::NavigationHandle* handle = navigation_handle();
+  if (!service) {
+    return PROCEED;
+  }
+  const std::optional<std::string> listed = service->Match(handle->GetURL());
+  if (!listed) {
+    return PROCEED;
+  }
+  content::WebContents* web_contents = handle->GetWebContents();
+  if (ThreatAllowlist::GetOrCreate(web_contents->GetBrowserContext())
+          ->Contains(*listed)) {
+    return PROCEED;
+  }
+  LOG(WARNING) << "Stainless threat protection blocked a navigation to a "
+                  "listed domain";
+  if (!handle->IsInPrimaryMainFrame()) {
+    // Prerenders, fenced frames and subframes cannot show a warning page.
+    return ThrottleCheckResult(CANCEL, net::ERR_BLOCKED_BY_CLIENT);
+  }
+  auto page = std::make_unique<ThreatBlockingPage>(web_contents,
+                                                   handle->GetURL(), *listed);
+  std::optional<std::string> html = page->GetHTMLContents();
+  security_interstitials::SecurityInterstitialTabHelper::AssociateBlockingPage(
+      handle, std::move(page));
+  return ThrottleCheckResult(CANCEL, net::ERR_BLOCKED_BY_CLIENT, html);
+}
+
+}  // namespace stainless_threats
