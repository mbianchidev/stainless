diff --git a/chrome/browser/stainless_threats/threat_list.cc b/chrome/browser/stainless_threats/threat_list.cc
new file mode 100644
index 0000000000000000000000000000000000000000..d8383aae224df2dc037c00e00d1778f7df314471
--- /dev/null
+++ b/chrome/browser/stainless_threats/threat_list.cc
@@ -0,0 +1,206 @@
+// Copyright 2026 Synctune Open
+
+#include "chrome/browser/stainless_threats/threat_list.h"
+
+#include <algorithm>
+#include <array>
+#include <utility>
+
+#include "base/containers/span.h"
+#include "base/strings/string_util.h"
+#include "crypto/hash.h"
+#include "net/base/ip_address.h"
+#include "net/base/registry_controlled_domains/registry_controlled_domain.h"
+
+namespace stainless_threats {
+
+namespace {
+
+constexpr size_t kMaxDomainLength = 253;
+constexpr size_t kMaxLabelLength = 63;
+
+uint64_t HashDomain(std::string_view domain) {
+  const std::array<uint8_t, crypto::hash::kSha256Size> digest =
+      crypto::hash::Sha256(domain);
+  uint64_t value = 0;
+  for (size_t i = 0; i < sizeof(value); ++i) {
+    value = (value << 8) | digest[i];
+  }
+  return value;
+}
+
+bool IsValidDomain(std::string_view domain) {
+  if (domain.empty() || domain.size() > kMaxDomainLength ||
+      domain.find('.') == std::string_view::npos) {
+    return false;
+  }
+  net::IPAddress address;
+  if (address.AssignFromIPLiteral(domain)) {
+    return false;
+  }
+  size_t label_length = 0;
+  for (size_t i = 0; i < domain.size(); ++i) {
+    const char c = domain[i];
+    if (c == '.') {
+      if (label_length == 0 || domain[i - 1] == '-') {
+        return false;
+      }
+      label_length = 0;
+      continue;
+    }
+    const bool valid =
+        base::IsAsciiLower(c) || base::IsAsciiDigit(c) || c == '-' || c == '_';
+    if (!valid || (label_length == 0 && c == '-') ||
+        ++label_length > kMaxLabelLength) {
+      return false;
+    }
+  }
+  return label_length > 0 && domain.back() != '-';
+}
+
+}  // namespace
+
+ParsedList::ParsedList() = default;
+ParsedList::ParsedList(ParsedList&&) = default;
+ParsedList& ParsedList::operator=(ParsedList&&) = default;
+ParsedList::~ParsedList() = default;
+
+std::optional<std::string> NormalizeListLine(std::string_view line) {
+  line = base::TrimWhitespaceASCII(line, base::TRIM_ALL);
+  if (line.empty() || line.front() == '#' || line.front() == '!' ||
+      line.front() == '[') {
+    return std::nullopt;
+  }
+  // Strip trailing comments.
+  if (const size_t comment = line.find('#');
+      comment != std::string_view::npos) {
+    line = base::TrimWhitespaceASCII(line.substr(0, comment), base::TRIM_ALL);
+  }
+  // Hosts-file format: "0.0.0.0 example.com".
+  if (const size_t space = line.find_first_of(" \t");
+      space != std::string_view::npos) {
+    const std::string_view address = line.substr(0, space);
+    if (address != "0.0.0.0" && address != "127.0.0.1" && address != "::" &&
+        address != "::1") {
+      return std::nullopt;
+    }
+    line = base::TrimWhitespaceASCII(line.substr(space + 1), base::TRIM_ALL);
+    if (line.find_first_of(" \t") != std::string_view::npos) {
+      return std::nullopt;
+    }
+  }
+  // Adblock domain rules: "||example.com^".
+  if (line.starts_with("||")) {
+    line.remove_prefix(2);
+    if (!line.ends_with('^')) {
+      return std::nullopt;
+    }
+    line.remove_suffix(1);
+  }
+  if (line.starts_with("*.")) {
+    line.remove_prefix(2);
+  }
+  if (line.ends_with('.')) {
+    line.remove_suffix(1);
+  }
+  std::string domain = base::ToLowerASCII(line);
+  if (!IsValidDomain(domain)) {
+    return std::nullopt;
+  }
+  return domain;
+}
+
+std::optional<ParsedList> ParseList(std::string_view text, size_t min_entries) {
+  if (text.size() > kMaxListBytes) {
+    return std::nullopt;
+  }
+  ParsedList parsed;
+  size_t start = 0;
+  while (start < text.size()) {
+    size_t end = text.find('\n', start);
+    if (end == std::string_view::npos) {
+      end = text.size();
+    }
+    const std::string_view line = text.substr(start, end - start);
+    start = end + 1;
+    const std::string_view trimmed =
+        base::TrimWhitespaceASCII(line, base::TRIM_ALL);
+    if (trimmed.empty() || trimmed.front() == '#' || trimmed.front() == '!' ||
+        trimmed.front() == '[') {
+      continue;
+    }
+    std::optional<std::string> domain = NormalizeListLine(trimmed);
+    if (!domain) {
+      ++parsed.rejected_lines;
+      continue;
+    }
+    if (parsed.domains.size() >= kMaxListEntries) {
+      return std::nullopt;
+    }
+    parsed.domains.push_back(std::move(*domain));
+  }
+  if (parsed.domains.size() < min_entries) {
+    return std::nullopt;
+  }
+  return parsed;
+}
+
+ThreatList::ThreatList() = default;
+
+ThreatList::ThreatList(const std::vector<std::vector<std::string>>& lists) {
+  size_t total = 0;
+  for (const auto& list : lists) {
+    total += list.size();
+  }
+  hashes_.reserve(total);
+  for (const auto& list : lists) {
+    for (const std::string& domain : list) {
+      hashes_.push_back(HashDomain(domain));
+    }
+  }
+  std::ranges::sort(hashes_);
+  hashes_.erase(std::unique(hashes_.begin(), hashes_.end()), hashes_.end());
+  hashes_.shrink_to_fit();
+}
+
+ThreatList::ThreatList(ThreatList&&) = default;
+ThreatList& ThreatList::operator=(ThreatList&&) = default;
+ThreatList::~ThreatList() = default;
+
+bool ThreatList::Contains(std::string_view domain) const {
+  return std::ranges::binary_search(hashes_, HashDomain(domain));
+}
+
+std::optional<std::string> ThreatList::Match(std::string_view host) const {
+  if (hashes_.empty()) {
+    return std::nullopt;
+  }
+  std::string normalized = base::ToLowerASCII(host);
+  if (!normalized.empty() && normalized.back() == '.') {
+    normalized.pop_back();
+  }
+  if (!IsValidDomain(normalized)) {
+    return std::nullopt;
+  }
+  const std::string registrable =
+      net::registry_controlled_domains::GetDomainAndRegistry(
+          normalized,
+          net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES);
+  if (registrable.empty()) {
+    return std::nullopt;
+  }
+  std::string_view candidate = normalized;
+  while (candidate.size() >= registrable.size()) {
+    if (Contains(candidate)) {
+      return std::string(candidate);
+    }
+    const size_t dot = candidate.find('.');
+    if (dot == std::string_view::npos) {
+      break;
+    }
+    candidate.remove_prefix(dot + 1);
+  }
+  return std::nullopt;
+}
+
+}  // namespace stainless_threats
diff --git a/chrome/browser/stainless_threats/threat_list.h b/chrome/browser/stainless_threats/threat_list.h
new file mode 100644
index 0000000000000000000000000000000000000000..b203fb518dc0444b4b4d8bf2eeff4b7cd4b822f7
--- /dev/null
+++ b/chrome/browser/stainless_threats/threat_list.h
@@ -0,0 +1,68 @@
+// Copyright 2026 Synctune Open
+
+#ifndef CHROME_BROWSER_STAINLESS_THREATS_THREAT_LIST_H_
+#define CHROME_BROWSER_STAINLESS_THREATS_THREAT_LIST_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace stainless_threats {
+
+// Downloaded list files larger than this are rejected without parsing.
+inline constexpr size_t kMaxListBytes = 32 * 1024 * 1024;
+// Bounds the in-memory set even if a provider publishes an unexpected list.
+inline constexpr size_t kMaxListEntries = 4 * 1024 * 1024;
+
+struct ParsedList {
+  ParsedList();
+  ParsedList(ParsedList&&);
+  ParsedList& operator=(ParsedList&&);
+  ~ParsedList();
+
+  std::vector<std::string> domains;
+  size_t rejected_lines = 0;
+};
+
+// Normalizes one domain-list, hosts-file, wildcard or adblock-style line into
+// a lowercase domain. Returns nullopt for comments, blank lines, IP addresses
+// and anything that is not a syntactically valid multi-label domain.
+std::optional<std::string> NormalizeListLine(std::string_view line);
+
+// Parses a whole list. Returns nullopt when the input is too large or yields
+// fewer than `min_entries` valid domains, so a truncated or replaced file can
+// never silently empty the active protection.
+std::optional<ParsedList> ParseList(std::string_view text, size_t min_entries);
+
+// A compact, immutable set of listed domains. Domains are stored as 64-bit
+// prefixes of their SHA-256 digests; matching happens only on this device.
+class ThreatList {
+ public:
+  ThreatList();
+  explicit ThreatList(const std::vector<std::vector<std::string>>& lists);
+  ThreatList(ThreatList&&);
+  ThreatList& operator=(ThreatList&&);
+  ThreatList(const ThreatList&) = delete;
+  ThreatList& operator=(const ThreatList&) = delete;
+  ~ThreatList();
+
+  // Returns the listed domain matching `host` or one of its parent domains,
+  // walking up to and including the host's registrable domain. Public
+  // suffixes and bare top-level domains never match.
+  std::optional<std::string> Match(std::string_view host) const;
+
+  size_t size() const { return hashes_.size(); }
+  bool empty() const { return hashes_.empty(); }
+
+ private:
+  bool Contains(std::string_view domain) const;
+
+  std::vector<uint64_t> hashes_;
+};
+
+}  // namespace stainless_threats
+
+#endif  // CHROME_BROWSER_STAINLESS_THREATS_THREAT_LIST_H_
diff --git a/chrome/browser/stainless_threats/threat_list_service.cc b/chrome/browser/stainless_threats/threat_list_service.cc
new file mode 100644
index 0000000000000000000000000000000000000000..236d443f3af655f2a12f69a8dee781b771e34f65
--- /dev/null
+++ b/chrome/browser/stainless_threats/threat_list_service.cc
@@ -0,0 +1,519 @@
+// Copyright 2026 Synctune Open
+
+#include "chrome/browser/stainless_threats/threat_list_service.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/files/file_util.h"
+#include "base/files/important_file_writer.h"
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/logging.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/task/thread_pool.h"
+#include "components/prefs/pref_service.h"
+#include "net/base/load_flags.h"
+#include "net/base/net_errors.h"
+#include "net/http/http_response_headers.h"
+#include "net/http/http_status_code.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "services/network/public/mojom/url_response_head.mojom.h"
+#include "url/gurl.h"
+#include "url/url_constants.h"
+
+namespace stainless_threats {
+
+namespace {
+
+ThreatListService* g_instance = nullptr;
+
+constexpr char kMetadataFile[] = "metadata.json";
+constexpr size_t kMaxMetadataBytes = 64 * 1024;
+constexpr int64_t kMaxDownloadBytes = static_cast<int64_t>(kMaxListBytes);
+
+constexpr net::NetworkTrafficAnnotationTag kTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("stainless_threat_lists", R"(
+        semantics {
+          sender: "Stainless threat protection"
+          description:
+            "Downloads public phishing and malware domain lists so that "
+            "navigations can be matched against them on this device."
+          trigger:
+            "Shortly after startup and every six hours while threat "
+            "protection is on, or when the user asks to update the lists."
+          data:
+            "None. The request contains no URL the user visited, no cookies "
+            "and no credentials. The list host sees the IP address."
+          destination: OTHER
+          destination_other:
+            "HaGeZi DNS blocklist mirrors (jsDelivr, GitHub, Codeberg, "
+            "GitLab) and CERT Polska."
+        }
+        policy {
+          cookies_allowed: NO
+          setting:
+            "Settings > Privacy and security > Security > Block known "
+            "phishing and malware sites."
+          policy_exception_justification: "Stainless-specific feature."
+        })");
+
+struct LoadedLists {
+  ThreatList list;
+  std::vector<size_t> entries;
+};
+
+base::FilePath ListPath(const base::FilePath& directory,
+                        const ThreatListSource& source) {
+  return directory.AppendASCII(std::string(source.id) + ".txt");
+}
+
+base::FilePath PartPath(const base::FilePath& directory,
+                        const ThreatListSource& source) {
+  return directory.AppendASCII(std::string(source.id) + ".download");
+}
+
+LoadedLists LoadLists(const base::FilePath& directory) {
+  LoadedLists result;
+  std::vector<std::vector<std::string>> lists;
+  for (const ThreatListSource& source : ThreatListSources()) {
+    std::string text;
+    std::optional<ParsedList> parsed;
+    if (base::ReadFileToStringWithMaxSize(ListPath(directory, source), &text,
+                                          kMaxListBytes)) {
+      parsed = ParseList(text, 1);
+    }
+    result.entries.push_back(parsed ? parsed->domains.size() : 0);
+    if (parsed) {
+      lists.push_back(std::move(parsed->domains));
+    }
+  }
+  result.list = ThreatList(lists);
+  return result;
+}
+
+std::optional<base::DictValue> LoadMetadata(const base::FilePath& directory) {
+  std::string json;
+  if (!base::ReadFileToStringWithMaxSize(directory.AppendASCII(kMetadataFile),
+                                         &json, kMaxMetadataBytes)) {
+    return std::nullopt;
+  }
+  return base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+}
+
+// Validates a finished download and atomically replaces the cached list.
+std::optional<size_t> ValidateAndInstall(base::FilePath part,
+                                         base::FilePath destination,
+                                         size_t min_entries) {
+  std::string text;
+  std::optional<ParsedList> parsed;
+  if (base::ReadFileToStringWithMaxSize(part, &text, kMaxListBytes)) {
+    parsed = ParseList(text, min_entries);
+  }
+  if (!parsed || !base::ReplaceFile(part, destination, nullptr)) {
+    base::DeleteFile(part);
+    return std::nullopt;
+  }
+  return parsed->domains.size();
+}
+
+void WriteMetadata(base::FilePath directory, std::string json) {
+  if (!base::CreateDirectory(directory) ||
+      !base::ImportantFileWriter::WriteFileAtomically(
+          directory.AppendASCII(kMetadataFile), json)) {
+    LOG(ERROR) << "Stainless threat protection: cannot save list metadata";
+  }
+}
+
+}  // namespace
+
+struct ThreatListService::SourceState {
+  std::string etag;
+  base::Time last_success;
+  size_t entries = 0;
+  std::string error;
+};
+
+struct ThreatListService::LoadResult {
+  LoadedLists lists;
+  std::optional<base::DictValue> metadata;
+};
+
+const std::vector<ThreatListSource>& ThreatListSources() {
+  static const base::NoDestructor<std::vector<ThreatListSource>> sources({
+      {"hagezi-tif-mini",
+       "HaGeZi Threat Intelligence Feeds (mini)",
+       "GPL-3.0",
+       {"https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/wildcard/"
+        "tif.mini-onlydomains.txt",
+        "https://raw.githubusercontent.com/hagezi/dns-blocklists/main/"
+        "wildcard/tif.mini-onlydomains.txt",
+        "https://codeberg.org/hagezi/mirror2/raw/branch/main/dns-blocklists/"
+        "wildcard/tif.mini-onlydomains.txt",
+        "https://gitlab.com/hagezi/mirror/-/raw/main/dns-blocklists/wildcard/"
+        "tif.mini-onlydomains.txt"},
+       10000},
+      {"cert-pl",
+       "CERT Polska warning list",
+       "Free use, no attribution",
+       {"https://hole.cert.pl/domains/v2/domains.txt"},
+       1000},
+  });
+  return *sources;
+}
+
+ThreatListService::ThreatListService(PrefService* local_state,
+                                     base::FilePath directory,
+                                     LoaderFactoryGetter loader_factory)
+    : local_state_(local_state),
+      directory_(std::move(directory)),
+      loader_factory_(std::move(loader_factory)),
+      file_task_runner_(base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+           base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN})),
+      sources_(ThreatListSources().size()) {
+  registrar_.Init(local_state_);
+  registrar_.Add(kThreatProtectionEnabled,
+                 base::BindRepeating(&ThreatListService::OnEnabledChanged,
+                                     base::Unretained(this)));
+  file_task_runner_->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::FilePath directory) {
+            if (!base::CreateDirectory(directory)) {
+              LOG(ERROR) << "Stainless threat protection: cannot create the "
+                            "list directory";
+            }
+            return LoadResult{LoadLists(directory), LoadMetadata(directory)};
+          },
+          directory_),
+      base::BindOnce(&ThreatListService::OnCachedListsLoaded,
+                     weak_factory_.GetWeakPtr()));
+}
+
+ThreatListService::~ThreatListService() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (g_instance == this) {
+    g_instance = nullptr;
+  }
+}
+
+// static
+ThreatListService* ThreatListService::Get() {
+  return g_instance;
+}
+
+// static
+void ThreatListService::SetInstance(ThreatListService* service) {
+  g_instance = service;
+}
+
+bool ThreatListService::IsEnabled() const {
+  return local_state_->GetBoolean(kThreatProtectionEnabled);
+}
+
+std::optional<std::string> ThreatListService::Match(const GURL& url) const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!IsEnabled() || !url.SchemeIsHTTPOrHTTPS() || !url.has_host()) {
+    return std::nullopt;
+  }
+  return list_.Match(url.host());
+}
+
+base::DictValue ThreatListService::GetStatus() const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  base::ListValue sources;
+  const auto& specs = ThreatListSources();
+  for (size_t i = 0; i < specs.size(); ++i) {
+    sources.Append(
+        base::DictValue()
+            .Set("name", specs[i].name)
+            .Set("license", specs[i].license)
+            .Set("entries", static_cast<int>(sources_[i].entries))
+            .Set("lastUpdated",
+                 sources_[i].last_success.is_null()
+                     ? 0.0
+                     : sources_[i].last_success.InMillisecondsFSinceUnixEpoch())
+            .Set("error", sources_[i].error));
+  }
+  return base::DictValue()
+      .Set("enabled", IsEnabled())
+      .Set("loaded", loaded_)
+      .Set("updating", updating_)
+      .Set("domainCount", static_cast<int>(list_.size()))
+      .Set("sources", std::move(sources));
+}
+
+base::CallbackListSubscription ThreatListService::AddStatusObserver(
+    base::RepeatingClosure callback) {
+  return status_observers_.Add(std::move(callback));
+}
+
+void ThreatListService::UpdateNow() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (IsEnabled() && loaded_ && !updating_) {
+    StartUpdate(/*forced=*/true);
+  }
+}
+
+void ThreatListService::OnEnabledChanged() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (IsEnabled()) {
+    if (loaded_ && !updating_) {
+      ScheduleUpdate(base::Seconds(1));
+    }
+  } else {
+    timer_.Stop();
+    loader_.reset();
+    updating_ = false;
+  }
+  NotifyStatus();
+}
+
+void ThreatListService::OnCachedListsLoaded(LoadResult result) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  list_ = std::move(result.lists.list);
+  const auto& specs = ThreatListSources();
+  for (size_t i = 0; i < specs.size(); ++i) {
+    sources_[i].entries = result.lists.entries[i];
+    const base::DictValue* entry =
+        result.metadata ? result.metadata->FindDict(specs[i].id) : nullptr;
+    // Metadata without a matching cached list would suppress a needed fetch.
+    if (!entry || sources_[i].entries == 0) {
+      continue;
+    }
+    if (const std::string* etag = entry->FindString("etag")) {
+      sources_[i].etag = *etag;
+    }
+    if (std::optional<double> last = entry->FindDouble("lastSuccess")) {
+      const base::Time time = base::Time::FromMillisecondsSinceUnixEpoch(*last);
+      // Ignore timestamps from the future so a bad clock cannot stop updates.
+      if (time <= base::Time::Now()) {
+        sources_[i].last_success = time;
+      }
+    }
+  }
+  loaded_ = true;
+  NotifyStatus();
+  if (IsEnabled()) {
+    ScheduleUpdate(kStartupDelay);
+  }
+}
+
+void ThreatListService::ScheduleUpdate(base::TimeDelta delay) {
+  timer_.Start(FROM_HERE, delay,
+               base::BindOnce(&ThreatListService::StartUpdate,
+                              base::Unretained(this), /*forced=*/false));
+}
+
+void ThreatListService::StartUpdate(bool forced) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!IsEnabled() || updating_) {
+    return;
+  }
+  timer_.Stop();
+  updating_ = true;
+  forced_update_ = forced;
+  changed_during_update_ = false;
+  source_index_ = 0;
+  NotifyStatus();
+  FetchNext();
+}
+
+void ThreatListService::FetchNext() {
+  const auto& specs = ThreatListSources();
+  const base::Time now = base::Time::Now();
+  while (source_index_ < specs.size()) {
+    const SourceState& state = sources_[source_index_];
+    if (forced_update_ || state.entries == 0 || state.last_success.is_null() ||
+        now - state.last_success >= kRefreshInterval) {
+      url_index_ = 0;
+      FetchUrl();
+      return;
+    }
+    ++source_index_;
+  }
+  FinishUpdate();
+}
+
+void ThreatListService::FetchUrl() {
+  const ThreatListSource& source = ThreatListSources()[source_index_];
+  scoped_refptr<network::SharedURLLoaderFactory> factory =
+      loader_factory_.Run();
+  if (!factory) {
+    FinishSource("Network is unavailable");
+    return;
+  }
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = GURL(source.urls[url_index_]);
+  request->method = "GET";
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->load_flags = net::LOAD_DISABLE_CACHE;
+  const SourceState& state = sources_[source_index_];
+  if (!state.etag.empty() && state.entries > 0) {
+    request->headers.SetHeader("If-None-Match", state.etag);
+  }
+  loader_ =
+      network::SimpleURLLoader::Create(std::move(request), kTrafficAnnotation);
+  loader_->SetTimeoutDuration(base::Minutes(2));
+  loader_->SetAllowHttpErrorResults(true);
+  loader_->SetRetryOptions(1,
+                           network::SimpleURLLoader::RETRY_ON_NETWORK_CHANGE);
+  loader_->DownloadToFile(factory.get(),
+                          base::BindOnce(&ThreatListService::OnDownloaded,
+                                         weak_factory_.GetWeakPtr()),
+                          PartPath(directory_, source), kMaxDownloadBytes);
+}
+
+void ThreatListService::OnDownloaded(base::FilePath path) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  const ThreatListSource& source = ThreatListSources()[source_index_];
+  const int net_error = loader_->NetError();
+  const network::mojom::URLResponseHead* head = loader_->ResponseInfo();
+  const int code = head && head->headers ? head->headers->response_code() : 0;
+  const bool secure_final_url =
+      loader_->GetFinalURL().SchemeIs(url::kHttpsScheme);
+  std::optional<std::string> etag;
+  if (head && head->headers) {
+    etag = head->headers->GetNormalizedHeader("ETag");
+  }
+  loader_.reset();
+
+  auto discard = [this, &source]() {
+    file_task_runner_->PostTask(
+        FROM_HERE, base::GetDeleteFileCallback(PartPath(directory_, source)));
+  };
+  if (net_error != net::OK || path.empty()) {
+    discard();
+    FinishSource(net::ErrorToShortString(net_error));
+    return;
+  }
+  if (!secure_final_url) {
+    discard();
+    FinishSource("Insecure list redirect");
+    return;
+  }
+  if (code == net::HTTP_NOT_MODIFIED && sources_[source_index_].entries > 0) {
+    discard();
+    sources_[source_index_].last_success = base::Time::Now();
+    FinishSource(std::string());
+    return;
+  }
+  if (code != net::HTTP_OK) {
+    discard();
+    FinishSource("HTTP " + base::NumberToString(code));
+    return;
+  }
+  sources_[source_index_].etag = etag.value_or(std::string());
+  file_task_runner_->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(&ValidateAndInstall, path, ListPath(directory_, source),
+                     source.min_entries),
+      base::BindOnce(&ThreatListService::OnValidated,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void ThreatListService::OnValidated(std::optional<size_t> entries) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!updating_) {
+    return;
+  }
+  if (!entries) {
+    sources_[source_index_].etag.clear();
+    FinishSource("Downloaded list was malformed or incomplete");
+    return;
+  }
+  sources_[source_index_].entries = *entries;
+  sources_[source_index_].last_success = base::Time::Now();
+  changed_during_update_ = true;
+  FinishSource(std::string());
+}
+
+void ThreatListService::FinishSource(std::string error) {
+  if (!updating_) {
+    return;
+  }
+  const ThreatListSource& source = ThreatListSources()[source_index_];
+  if (!error.empty() && url_index_ + 1 < source.urls.size()) {
+    ++url_index_;
+    FetchUrl();
+    return;
+  }
+  if (!error.empty()) {
+    LOG(WARNING) << "Stainless threat protection: " << source.name
+                 << " update failed: " << error
+                 << ". The previous list stays active.";
+  }
+  sources_[source_index_].error = std::move(error);
+  ++source_index_;
+  FetchNext();
+}
+
+void ThreatListService::FinishUpdate() {
+  updating_ = false;
+  forced_update_ = false;
+  SaveMetadata();
+  if (changed_during_update_) {
+    ReloadLists();
+  }
+  base::TimeDelta next = kRefreshInterval;
+  const base::Time now = base::Time::Now();
+  for (const SourceState& state : sources_) {
+    if (!state.error.empty() || state.last_success.is_null()) {
+      next = std::min(next, kRetryInterval);
+    } else {
+      next = std::min(next, state.last_success + kRefreshInterval - now);
+    }
+  }
+  ScheduleUpdate(std::max(next, base::Minutes(1)));
+  NotifyStatus();
+}
+
+void ThreatListService::ReloadLists() {
+  file_task_runner_->PostTaskAndReplyWithResult(
+      FROM_HERE, base::BindOnce(&LoadLists, directory_),
+      base::BindOnce(
+          [](base::WeakPtr<ThreatListService> service, LoadedLists lists) {
+            if (!service) {
+              return;
+            }
+            service->list_ = std::move(lists.list);
+            for (size_t i = 0; i < lists.entries.size(); ++i) {
+              service->sources_[i].entries = lists.entries[i];
+            }
+            service->NotifyStatus();
+          },
+          weak_factory_.GetWeakPtr()));
+}
+
+void ThreatListService::SaveMetadata() {
+  base::DictValue metadata;
+  const auto& specs = ThreatListSources();
+  for (size_t i = 0; i < specs.size(); ++i) {
+    if (sources_[i].last_success.is_null()) {
+      continue;
+    }
+    metadata.Set(
+        specs[i].id,
+        base::DictValue()
+            .Set("etag", sources_[i].etag)
+            .Set("lastSuccess",
+                 sources_[i].last_success.InMillisecondsFSinceUnixEpoch()));
+  }
+  std::optional<std::string> json = base::WriteJson(metadata);
+  if (json) {
+    file_task_runner_->PostTask(
+        FROM_HERE, base::BindOnce(&WriteMetadata, directory_, *json));
+  }
+}
+
+void ThreatListService::NotifyStatus() {
+  status_observers_.Notify();
+}
+
+}  // namespace stainless_threats
