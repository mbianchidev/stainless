+// Copyright 2026 Synctune Open
+
+#include "chrome/browser/stainless_threats/threat_protection_main_parts.h"
+
+#include "base/files/file_path.h"
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/path_service.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/stainless_threats/threat_list_service.h"
+#include "chrome/common/chrome_paths.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+
+namespace stainless_threats {
+
+ThreatProtectionMainParts::ThreatProtectionMainParts() = default;
+ThreatProtectionMainParts::~ThreatProtectionMainParts() = default;
+
+void ThreatProtectionMainParts::PreProfileInit() {
+  base::FilePath user_data;
+  if (!base::PathService::Get(chrome::DIR_USER_DATA, &user_data)) {
+    LOG(ERROR) << "Stainless threat protection is unavailable: no user-data "
+                  "directory";
+    return;
+  }
+  service_ = std::make_unique<ThreatListService>(
+      g_browser_process->local_state(), user_data.Append(kThreatListsDirectory),
+      base::BindRepeating(
+          []() -> scoped_refptr<network::SharedURLLoaderFactory> {
+            return g_browser_process
+                       ? g_browser_process->shared_url_loader_factory()
+                       : nullptr;
+          }));
+  ThreatListService::SetInstance(service_.get());
+}
+
+void ThreatProtectionMainParts::PostMainMessageLoopRun() {
+  ThreatListService::SetInstance(nullptr);
+  service_.reset();
+}
+
+}  // namespace stainless_threats
