+std::unique_ptr<security_interstitials::MetricsHelper> CreateMetricsHelper(
+    const GURL& url) {
+  security_interstitials::MetricsHelper::ReportDetails details;
+  details.metric_prefix = "stainless_threat";
+  return std::make_unique<security_interstitials::MetricsHelper>(
+      url, details, /*history_service=*/nullptr);
