+// Copyright 2026 Synctune Open
+
+#ifndef CHROME_BROWSER_STAINLESS_THREATS_THREAT_LIST_SERVICE_H_
+#define CHROME_BROWSER_STAINLESS_THREATS_THREAT_LIST_SERVICE_H_
+
+#include <cstddef>
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/callback_list.h"
+#include "base/files/file_path.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/sequence_checker.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "base/values.h"
+#include "chrome/browser/stainless_threats/threat_list.h"
+#include "chrome/browser/stainless_threats/threat_protection_prefs.h"
+#include "components/prefs/pref_change_registrar.h"
+
+class GURL;
+class PrefService;
+
+namespace network {
+class SharedURLLoaderFactory;
+class SimpleURLLoader;
+}  // namespace network
+
+namespace stainless_threats {
+
+// Name of the directory, inside the user-data directory, holding the cached
+// list files and their fetch metadata.
+inline constexpr base::FilePath::CharType kThreatListsDirectory[] =
+    FILE_PATH_LITERAL("Stainless Threat Lists");
+
+inline constexpr base::TimeDelta kRefreshInterval = base::Hours(6);
+inline constexpr base::TimeDelta kRetryInterval = base::Minutes(30);
+inline constexpr base::TimeDelta kStartupDelay = base::Seconds(30);
+
+struct ThreatListSource {
+  std::string_view id;
+  std::string_view name;
+  std::string_view license;
+  std::vector<std::string_view> urls;
+  // Downloads yielding fewer valid domains are rejected as truncated.
+  size_t min_entries;
+};
+
+// The reviewed, non-Google providers. Order defines mirror fallback.
+const std::vector<ThreatListSource>& ThreatListSources();
+
+// Downloads public phishing/malware domain lists from the providers above
+// and matches navigations against them on this device. No browsing data is
+// sent anywhere: list requests carry no URL, cookie or credential, and the
+// providers only see the browser's IP address and a fixed User-Agent.
+class ThreatListService {
+ public:
+  using LoaderFactoryGetter =
+      base::RepeatingCallback<scoped_refptr<network::SharedURLLoaderFactory>()>;
+
+  ThreatListService(PrefService* local_state,
+                    base::FilePath directory,
+                    LoaderFactoryGetter loader_factory);
+  ThreatListService(const ThreatListService&) = delete;
+  ThreatListService& operator=(const ThreatListService&) = delete;
+  ~ThreatListService();
+
+  // Returns the browser-wide instance, or null before startup or after
+  // shutdown. Navigations proceed unchecked while it is unavailable.
+  static ThreatListService* Get();
+  static void SetInstance(ThreatListService* service);
+
+  bool IsEnabled() const;
+  // Returns the listed domain when `url` is an http(s) URL whose host or a
+  // parent domain is on a loaded list.
+  std::optional<std::string> Match(const GURL& url) const;
+  base::DictValue GetStatus() const;
+  // Starts an update now, ignoring the refresh interval. No-op while disabled
+  // or while an update is already running.
+  void UpdateNow();
+
+  // Notifies when list, update or error status changes.
+  base::CallbackListSubscription AddStatusObserver(
+      base::RepeatingClosure callback);
+
+ private:
+  struct SourceState;
+  struct LoadResult;
+
+  void OnEnabledChanged();
+  void OnCachedListsLoaded(LoadResult result);
+  void ScheduleUpdate(base::TimeDelta delay);
+  void StartUpdate(bool forced);
+  void FetchNext();
+  void FetchUrl();
+  void OnDownloaded(base::FilePath path);
+  void OnValidated(std::optional<size_t> entries);
+  void FinishSource(std::string error);
+  void FinishUpdate();
+  void ReloadLists();
+  void SaveMetadata();
+  void NotifyStatus();
+
+  raw_ptr<PrefService> local_state_;
+  const base::FilePath directory_;
+  LoaderFactoryGetter loader_factory_;
+  scoped_refptr<base::SequencedTaskRunner> file_task_runner_;
+  PrefChangeRegistrar registrar_;
+  base::OneShotTimer timer_;
+
+  ThreatList list_;
+  bool loaded_ = false;
+  std::vector<SourceState> sources_;
+  bool updating_ = false;
+  bool forced_update_ = false;
+  bool changed_during_update_ = false;
+  size_t source_index_ = 0;
+  size_t url_index_ = 0;
+  std::unique_ptr<network::SimpleURLLoader> loader_;
+  base::RepeatingClosureList status_observers_;
+
+  SEQUENCE_CHECKER(sequence_checker_);
+  base::WeakPtrFactory<ThreatListService> weak_factory_{this};
+};
+
+}  // namespace stainless_threats
+
+#endif  // CHROME_BROWSER_STAINLESS_THREATS_THREAT_LIST_SERVICE_H_
diff --git a/chrome/browser/stainless_threats/threat_list_unittest.cc b/chrome/browser/stainless_threats/threat_list_unittest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..3a2cd1f831b0e538507585e935b7e1b03915d08a
--- /dev/null
