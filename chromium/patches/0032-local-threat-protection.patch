@@ -0,0 +1,82 @@
+// Copyright 2026 Synctune Open
+
+#include "chrome/browser/stainless_threats/threat_list.h"
+
+#include <string>
+#include <vector>
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace stainless_threats {
+namespace {
+
+TEST(StainlessThreatListTest, NormalizesSupportedListFormats) {
+  EXPECT_EQ("example.test", NormalizeListLine("Example.Test"));
+  EXPECT_EQ("example.test", NormalizeListLine("0.0.0.0 example.test"));
+  EXPECT_EQ("example.test", NormalizeListLine("127.0.0.1\texample.test"));
+  EXPECT_EQ("example.test", NormalizeListLine("||example.test^"));
+  EXPECT_EQ("example.test", NormalizeListLine("*.example.test"));
+  EXPECT_EQ("example.test", NormalizeListLine("example.test. # note"));
+  EXPECT_EQ("a_b.example.test", NormalizeListLine("a_b.example.test"));
+}
+
+TEST(StainlessThreatListTest, RejectsCommentsAddressesAndMalformedLines) {
+  for (const char* line :
+       {"", "   ", "# comment", "! adblock comment", "[Adblock Plus]",
+        "localhost", "192.0.2.1", "0.0.0.0 192.0.2.1", "10.0.0.1 example.test",
+        "0.0.0.0 example.test extra", "||example.test", "-bad.example.test",
+        "bad-.example.test", "bad..example.test", ".example.test",
+        "exa mple.test", "example.test/path", "http://example.test",
+        "ex*ample.test"}) {
+    EXPECT_FALSE(NormalizeListLine(line).has_value()) << line;
+  }
+  EXPECT_FALSE(
+      NormalizeListLine(std::string(64, 'a') + ".example.test").has_value());
+  EXPECT_FALSE(NormalizeListLine(std::string(250, 'a') + ".test").has_value());
+}
+
+TEST(StainlessThreatListTest, ParseRequiresMinimumValidEntries) {
+  const std::string text =
+      "# Title: synthetic\n\none.example.test\n0.0.0.0 two.example.test\n"
+      "not a domain\r\nthree.example.test\r\n";
+  std::optional<ParsedList> parsed = ParseList(text, 3);
+  ASSERT_TRUE(parsed);
+  EXPECT_EQ((std::vector<std::string>{"one.example.test", "two.example.test",
+                                      "three.example.test"}),
+            parsed->domains);
+  EXPECT_EQ(1u, parsed->rejected_lines);
+  EXPECT_FALSE(ParseList(text, 4));
+  EXPECT_FALSE(ParseList("", 1));
+  EXPECT_FALSE(ParseList(std::string(kMaxListBytes + 1, 'a'), 0));
+}
+
+TEST(StainlessThreatListTest, MatchesHostAndParentsUpToRegistrableDomain) {
+  const ThreatList list(
+      {{"phish.example.test", "evil.example"}, {"bad.github.io", "co.uk"}});
+  EXPECT_EQ(4u, list.size());
+
+  EXPECT_EQ("phish.example.test", list.Match("phish.example.test"));
+  EXPECT_EQ("phish.example.test", list.Match("login.PHISH.example.test."));
+  EXPECT_EQ("evil.example", list.Match("a.b.evil.example"));
+  EXPECT_EQ("bad.github.io", list.Match("www.bad.github.io"));
+
+  EXPECT_FALSE(list.Match("example.test"));
+  EXPECT_FALSE(list.Match("safe.example.test"));
+  EXPECT_FALSE(list.Match("notevil.example"));
+  EXPECT_FALSE(list.Match("good.github.io"));
+  // A listed public suffix must never block every site under it.
+  EXPECT_FALSE(list.Match("shop.co.uk"));
+  EXPECT_FALSE(list.Match("192.0.2.1"));
+  EXPECT_FALSE(list.Match(""));
+}
+
+TEST(StainlessThreatListTest, DeduplicatesAcrossSources) {
+  const ThreatList list({{"one.example.test", "two.example.test"},
+                         {"two.example.test", "one.example.test"}});
+  EXPECT_EQ(2u, list.size());
+  EXPECT_TRUE(ThreatList().empty());
+  EXPECT_FALSE(ThreatList().Match("one.example.test"));
+}
+
+}  // namespace
+}  // namespace stainless_threats
