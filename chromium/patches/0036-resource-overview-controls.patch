+// page that could ask "Leave site?", give against hibernating or ending.
+std::vector<int> Refusals(content::WebContents* contents, bool ending) {
+  std::vector<int> messages;
+  auto add = [&messages](int message) {
+    if (!std::ranges::contains(messages, message)) {
+      messages.push_back(message);
+    }
+  };
+  base::WeakPtr<performance_manager::PageNode> node;
+  if (PerformanceManager::IsAvailable()) {
+    node = PerformanceManager::GetPrimaryPageNodeForWebContents(contents);
+  }
+  auto* policy = node ? DiscardEligibilityPolicy::GetFromGraph(
+                            PerformanceManager::GetGraph())
+                      : nullptr;
+  if (!policy) {
+    add(IDS_STAINLESS_RESOURCES_REASON_UNCHECKED);
+    return messages;
+  }
+  std::vector<CannotDiscardReason> reasons;
+  policy->CanDiscard(node.get(), DiscardEligibilityPolicy::DiscardReason::URGENT,
+                     /*ignore_recent_visibility=*/true, &reasons);
+  for (auto reason : reasons) {
+    if (!ending || BlocksEnding(reason)) {
+      add(ReasonMessage(reason));
+    }
+  }
+  contents->GetPrimaryMainFrame()->ForEachRenderFrameHostWithAction(
+      [&add](content::RenderFrameHost* frame) {
+        if (frame->CouldDisplayBeforeUnloadDialog()) {
+          add(IDS_STAINLESS_RESOURCES_REASON_INPUT);
+          return content::RenderFrameHost::FrameIterationAction::kStop;
+        }
+        return content::RenderFrameHost::FrameIterationAction::kContinue;
+      });
