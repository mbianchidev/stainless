+const StainlessResourceOverviewView::Row*
+StainlessResourceOverviewView::SelectedRow() const {
+  auto row = table_->GetFirstSelectedRow();
+  return row && *row < rows_.size() ? &rows_[*row] : nullptr;
+}
+
+std::vector<content::WebContents*> StainlessResourceOverviewView::OwnedContents(
+    const Row& row) const {
+  std::vector<content::WebContents*> contents;
+  if (closing_ || !browser_ || browser_->IsDeleteScheduled()) {
+    return contents;
+  }
+  auto* strip = browser_->GetTabStripModel();
+  for (int index = 0; index < strip->count(); ++index) {
+    auto* item = strip->GetWebContentsAt(index);
+    if (!item->IsBeingDestroyed() &&
+        item->GetBrowserContext() == browser_->GetProfile() &&
+        std::ranges::contains(row.tabs,
+                              sessions::SessionTabHelper::IdForTab(item))) {
+      contents.push_back(item);
+    }
+  }
+  return contents;
+}
+
+void StainlessResourceOverviewView::SelectTab(content::WebContents* contents) {
+  auto id = sessions::SessionTabHelper::IdForTab(contents);
+  for (size_t index = 0; index < rows_.size(); ++index) {
+    if (std::ranges::contains(rows_[index].tabs, id)) {
+      table_->Select(index);
+      return;
+    }
+  }
+}
+
+void StainlessResourceOverviewView::OnSelectionChanged() {
+  UpdateControls();
+}
+
+void StainlessResourceOverviewView::UpdateControls() {
+  const Row* row = SelectedRow();
+  const bool renderer = row && row->task_id != -1 && !row->tabs.empty();
+  auto* focus = GetFocusManager();
+  auto* focused = focus ? focus->GetFocusedView() : nullptr;
+  hibernate_->SetEnabled(renderer);
+  end_process_->SetEnabled(renderer);
+  wake_->SetEnabled(row && row->task_id == -1);
+  if (focused && !focused->GetEnabled() &&
+      (focused == hibernate_ || focused == wake_ || focused == end_process_)) {
+    table_->RequestFocus();
+  }
+}
+
+void StainlessResourceOverviewView::Hibernate() {
+  const Row* row = SelectedRow();
+  auto contents = row && row->task_id != -1
+                      ? OwnedContents(*row)
+                      : std::vector<content::WebContents*>();
+  if (contents.empty()) {
+    outcome_->SetText(Text(IDS_STAINLESS_RESOURCES_SELECT));
+    return;
+  }
+  std::vector<std::u16string> refusals;
+  for (auto* item : contents) {
+    if (auto messages = Refusals(item, /*ending=*/false); !messages.empty()) {
+      refusals.push_back(TabRefusal(item, messages));
+    }
+  }
+  if (!refusals.empty()) {
+    outcome_->SetText(
+        l10n_util::GetStringFUTF16(IDS_STAINLESS_RESOURCES_NOT_HIBERNATED,
+                                   base::JoinString(refusals, u" ")));
+    return;
+  }
+  // Discarding replaces each tab's contents and refreshes `rows_`.
+  std::vector<std::pair<tabs::TabHandle, std::u16string>> handles;
+  for (auto* item : contents) {
+    handles.emplace_back(tabs::TabInterface::GetFromContents(item)->GetHandle(),
+                         OwnedTabTitle(item));
+  }
+  std::vector<std::u16string> hibernated;
+  std::vector<std::u16string> failed;
+  for (const auto& [handle, title] : handles) {
+    auto* tab = handle.Get();
+    auto* unit = tab ? resource_coordinator::TabLifecycleUnitExternal::
+                           FromWebContents(tab->GetContents())
+                     : nullptr;
+    if (unit && unit->DiscardTab(::mojom::LifecycleUnitDiscardReason::EXTERNAL)) {
+      hibernated.push_back(title);
+    } else {
+      failed.push_back(title);
+    }
+  }
+  if (closing_) {
+    return;
+  }
+  std::u16string outcome;
+  if (!hibernated.empty()) {
+    outcome = l10n_util::GetStringFUTF16(IDS_STAINLESS_RESOURCES_HIBERNATED,
+                                         base::JoinString(hibernated, u"; "));
+  }
+  if (!failed.empty()) {
+    outcome += (outcome.empty() ? u"" : u" ") +
+               l10n_util::GetStringFUTF16(
+                   IDS_STAINLESS_RESOURCES_HIBERNATE_FAILED,
+                   base::JoinString(failed, u"; "));
+  }
+  outcome_->SetText(outcome);
+  if (auto* tab = handles.front().first.Get()) {
+    SelectTab(tab->GetContents());
+  }
+}
+
+void StainlessResourceOverviewView::Wake() {
+  const Row* row = SelectedRow();
+  auto contents = row && row->task_id == -1
+                      ? OwnedContents(*row)
+                      : std::vector<content::WebContents*>();
+  if (contents.empty()) {
+    outcome_->SetText(Text(IDS_STAINLESS_RESOURCES_SELECT));
+    return;
+  }
+  std::vector<std::u16string> woken;
+  for (auto* item : contents) {
+    auto& controller = item->GetController();
+    if (item->IsCrashed()) {
+      // Like the crash page's Reload, ask before resubmitting form data.
+      controller.Reload(content::ReloadType::NORMAL,
+                        /*check_for_repost=*/true);
+    } else if (item->WasDiscarded() || controller.NeedsReload()) {
+      // Restores the hibernated entry, as activating the tab would.
+      controller.SetNeedsReload();
+      controller.LoadIfNecessary();
+    } else {
+      continue;
+    }
+    woken.push_back(OwnedTabTitle(item));
+  }
+  outcome_->SetText(
+      woken.empty()
+          ? Text(IDS_STAINLESS_RESOURCES_NOTHING_TO_WAKE)
+          : l10n_util::GetStringFUTF16(IDS_STAINLESS_RESOURCES_WOKEN,
+                                       base::JoinString(woken, u"; ")));
+}
+
+void StainlessResourceOverviewView::EndProcess() {
+  const Row* row = SelectedRow();
+  auto* manager = observed_task_manager();
+  if (!row || row->task_id == -1 || row->tabs.empty() || !row->process_id ||
+      !manager || closing_ || !browser_ || browser_->IsDeleteScheduled()) {
+    outcome_->SetText(Text(IDS_STAINLESS_RESOURCES_SELECT));
+    return;
+  }
+  const auto task = row->task_id;
+  const auto pid = *row->process_id;
+  const auto pid_text = base::NumberToString16(pid);
+  auto* host = content::RenderProcessHost::FromID(
+      manager->GetChildProcessUniqueId(task));
+  if (!host || !host->IsInitializedAndNotDead() ||
+      host->GetBrowserContext() != browser_->GetProfile()) {
+    outcome_->SetText(Text(IDS_STAINLESS_RESOURCES_SELECT));
+    return;
+  }
+  std::map<SessionID, content::WebContents*> owned;
+  auto* strip = browser_->GetTabStripModel();
+  for (int index = 0; index < strip->count(); ++index) {
+    auto* item = strip->GetWebContentsAt(index);
+    if (!item->IsBeingDestroyed() &&
+        item->GetBrowserContext() == browser_->GetProfile()) {
+      owned.emplace(sessions::SessionTabHelper::IdForTab(item), item);
+    }
+  }
+  // Every task and frame in the process must belong to this window's tabs;
+  // only page-owned dedicated workers and restartable service workers may run
+  // alongside them.
+  bool outside = false;
+  for (auto id : manager->GetTaskIdsList()) {
+    if (!manager->IsTaskValid(id) || manager->GetProcessId(id) != pid) {
+      continue;
+    }
+    switch (manager->GetType(id)) {
+      case task_manager::Task::RENDERER:
+        outside |= !owned.contains(manager->GetTabId(id));
+        break;
+      case task_manager::Task::DEDICATED_WORKER:
+      case task_manager::Task::SERVICE_WORKER:
+        break;
+      default:
+        outside = true;
+    }
+  }
+  std::vector<content::WebContents*> affected;
+  host->ForEachRenderFrameHost([&](content::RenderFrameHost* frame) {
+    auto* contents = content::WebContents::FromRenderFrameHost(frame);
+    auto it = contents ? owned.find(sessions::SessionTabHelper::IdForTab(
+                             contents))
+                       : owned.end();
+    if (it == owned.end() || it->second != contents) {
+      outside = true;
+    } else if (!std::ranges::contains(affected, contents)) {
+      affected.push_back(contents);
+    }
+  });
+  std::vector<std::u16string> refusals;
+  if (outside || affected.empty()) {
+    refusals.push_back(Text(IDS_STAINLESS_RESOURCES_REASON_OUTSIDE));
+  }
+  for (auto* item : affected) {
+    if (auto messages = Refusals(item, /*ending=*/true); !messages.empty()) {
+      refusals.push_back(TabRefusal(item, messages));
+    }
+  }
+  if (!refusals.empty()) {
+    outcome_->SetText(l10n_util::GetStringFUTF16(
+        IDS_STAINLESS_RESOURCES_NOT_ENDED, pid_text,
+        base::JoinString(refusals, u" ")));
+    return;
+  }
+  std::vector<std::u16string> titles;
+  for (auto* item : affected) {
+    titles.push_back(OwnedTabTitle(item));
+  }
+  if (!manager->IsTaskKillable(task) || !manager->KillTask(task)) {
+    outcome_->SetText(
+        l10n_util::GetStringFUTF16(IDS_STAINLESS_RESOURCES_END_FAILED, pid_text));
+    return;
+  }
+  outcome_->SetText(l10n_util::GetStringFUTF16(
+      IDS_STAINLESS_RESOURCES_ENDED, pid_text, base::JoinString(titles, u"; ")));
 }
 
