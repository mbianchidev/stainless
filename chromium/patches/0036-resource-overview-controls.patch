+IN_PROC_BROWSER_TEST_F(StainlessResourceOverviewBrowserTest,
+                       EndProcessStopsOnlyThisWindowsRenderers) {
+  auto* active = browser()->GetTabStripModel()->GetActiveWebContents();
+  auto* other = CreateBrowser(browser()->GetProfile());
+  Navigate(other, "alpha.test", "/hidden-window", "Hidden window");
+  ASSERT_EQ(Pid(active), Pid(other->GetTabStripModel()->GetActiveWebContents()));
+  auto* ending = AddBackgroundTab("gamma.test", "/ending", "Orion ending");
+  auto* view = Open(browser());
+  ASSERT_TRUE(view);
+  const auto shared_pid = Pid(active);
+  const auto ending_pid = Pid(ending);
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return RowForProcess(view, shared_pid) && RowForProcess(view, ending_pid);
+  }));
+  Table(view)->Select(RowForProcess(view, shared_pid));
+  Press(EndButton(view));
+  EXPECT_TRUE(
+      Outcome(view).contains(Text(IDS_STAINLESS_RESOURCES_REASON_OUTSIDE)));
+  EXPECT_FALSE(Outcome(view).contains(u"Hidden window"));
+  EXPECT_TRUE(
+      active->GetPrimaryMainFrame()->GetProcess()->IsInitializedAndNotDead());
+
+  Table(view)->Select(RowForProcess(view, ending_pid));
+  content::RenderProcessHostWatcher exited(
+      ending->GetPrimaryMainFrame()->GetProcess(),
+      content::RenderProcessHostWatcher::WATCH_FOR_PROCESS_EXIT);
+  Press(EndButton(view));
+  exited.Wait();
+  EXPECT_FALSE(exited.did_exit_normally());
+  EXPECT_EQ(l10n_util::GetStringFUTF16(IDS_STAINLESS_RESOURCES_ENDED,
+                                       base::NumberToString16(ending_pid),
+                                       u"Orion ending"),
+            Outcome(view));
+  const auto tab = sessions::SessionTabHelper::IdForTab(ending);
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return ending->IsCrashed() && UnmeasuredRow(view, tab); }));
+  EXPECT_FALSE(active->IsCrashed());
+  Table(view)->Select(UnmeasuredRow(view, tab));
+  Press(WakeButton(view));
+  ASSERT_TRUE(content::WaitForLoadStop(ending));
+  EXPECT_FALSE(ending->IsCrashed());
+  EXPECT_TRUE(ending->GetPrimaryMainFrame()->IsRenderFrameLive());
+  Close(view);
+}
