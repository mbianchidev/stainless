+IN_PROC_BROWSER_TEST_F(StainlessResourceOverviewBrowserTest,
+                       HibernateRefusesUnsafeTabsAndWakesHibernatedOnes) {
+  auto* strip = browser()->GetTabStripModel();
+  auto* active = strip->GetActiveWebContents();
+  auto* background =
+      AddBackgroundTab("beta.test", "/hibernate", "Orion background");
+  auto* view = Open(browser());
+  ASSERT_TRUE(view);
+  const auto active_pid = Pid(active);
+  const auto background_pid = Pid(background);
+  ASSERT_NE(active_pid, background_pid);
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return RowForProcess(view, active_pid) &&
+           RowForProcess(view, background_pid);
+  }));
+  Table(view)->Select(RowForProcess(view, base::GetCurrentProcId()));
+  EXPECT_FALSE(HibernateButton(view)->GetEnabled());
+  EXPECT_FALSE(WakeButton(view)->GetEnabled());
+  EXPECT_FALSE(EndButton(view)->GetEnabled());
+
+  Table(view)->Select(RowForProcess(view, active_pid));
+  Table(view)->RequestFocus();
+  view->GetFocusManager()->AdvanceFocus(false);
+  EXPECT_EQ(HibernateButton(view), view->GetFocusManager()->GetFocusedView());
+  Press(HibernateButton(view));
+  EXPECT_TRUE(Outcome(view).contains(u"Orion owned"));
+  EXPECT_TRUE(
+      Outcome(view).contains(Text(IDS_STAINLESS_RESOURCES_REASON_VISIBLE)));
+  EXPECT_FALSE(active->WasDiscarded());
+
+  LeaveSite(background, true);
+  Table(view)->Select(RowForProcess(view, background_pid));
+  Press(HibernateButton(view));
+  EXPECT_TRUE(Outcome(view).contains(u"Orion background"));
+  EXPECT_TRUE(
+      Outcome(view).contains(Text(IDS_STAINLESS_RESOURCES_REASON_INPUT)));
+  Press(EndButton(view));
+  EXPECT_TRUE(
+      Outcome(view).contains(Text(IDS_STAINLESS_RESOURCES_REASON_INPUT)));
+  EXPECT_TRUE(background->GetPrimaryMainFrame()
+                  ->GetProcess()
+                  ->IsInitializedAndNotDead());
+  EXPECT_FALSE(background->WasDiscarded());
+  LeaveSite(background, false);
+
+  const int index = strip->GetIndexOfWebContents(background);
+  Press(HibernateButton(view));
+  auto* hibernated = strip->GetWebContentsAt(index);
+  EXPECT_TRUE(hibernated->WasDiscarded());
+  EXPECT_FALSE(hibernated->GetPrimaryMainFrame()->IsRenderFrameLive());
+  EXPECT_EQ(l10n_util::GetStringFUTF16(IDS_STAINLESS_RESOURCES_HIBERNATED,
+                                       u"Orion background"),
+            Outcome(view));
+  EXPECT_EQ(-1, SelectedTask(view));
+  EXPECT_FALSE(HibernateButton(view)->GetEnabled());
+  EXPECT_EQ(active, strip->GetActiveWebContents());
+  Press(WakeButton(view));
+  ASSERT_TRUE(content::WaitForLoadStop(hibernated));
+  EXPECT_TRUE(hibernated->GetPrimaryMainFrame()->IsRenderFrameLive());
+  EXPECT_EQ(embedded_test_server()->GetURL("beta.test", "/hibernate"),
+            hibernated->GetLastCommittedURL());
+  EXPECT_EQ(true, content::EvalJs(hibernated, "document.wasDiscarded"));
+  EXPECT_EQ(active, strip->GetActiveWebContents());
+  Close(view);
+}
