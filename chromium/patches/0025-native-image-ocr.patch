+          views::DialogContentType::kControl));
+  dialog->SetInitiallyFocusedView(result->change_);
+  dialog->SetContentsView(std::move(view));
+  auto* widget = views::DialogDelegate::CreateDialogWidget(
+      std::move(dialog), gfx::NativeWindow(),
+      owner->GetWidget()->GetNativeView());
+  result->widget_.Observe(widget);
+  widget->Show();
+  result->controller_->SelectContextImage();
+}
+
+StainlessImageOcrView::StainlessImageOcrView(BrowserWindowInterface* browser,
+                                             content::RenderFrameHost* frame)
+    : content::WebContentsObserver(
+          content::WebContents::FromRenderFrameHost(frame)
+              ->GetOutermostWebContents()),
+      browser_(browser->GetWeakPtr()),
+      document_(frame->GetWeakDocumentPtr()),
+      controller_(stainless_local::LocalImageOcr::Get(frame)->GetWeakPtr()),
+      chosen_(browser->GetProfile()->GetPrefs()->GetString(
+          stainless_local::kOcrLanguage)),
+      return_focus_(std::make_unique<views::ViewTracker>()) {
+  registration_.emplace(browser->GetUnownedUserDataHost(), *this);
+  auto* focus =
+      BrowserView::GetBrowserViewForBrowser(browser)->GetFocusManager();
+  return_focus_->SetView(focus->GetFocusedView() ? focus->GetFocusedView()
+                                                 : focus->GetStoredFocusView());
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(), 8));
+  auto* explanation = AddChildView(std::make_unique<views::Label>(
+      l10n_util::GetStringUTF16(IDS_STAINLESS_IMAGE_OCR_EXPLANATION)));
+  explanation->SetMultiLine(true);
+  explanation->SetHorizontalAlignment(gfx::HorizontalAlignment::ALIGN_LEFT);
+  language_ = AddChildView(std::make_unique<views::Label>());
+  language_->SetHorizontalAlignment(gfx::HorizontalAlignment::ALIGN_LEFT);
+  auto* controls = AddChildView(std::make_unique<views::View>());
+  controls->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal, gfx::Insets(), 8));
+  change_ = controls->AddChildView(std::make_unique<views::MdTextButton>(
+      base::BindRepeating(&StainlessImageOcrView::ChangeLanguage,
+                          base::Unretained(this)),
+      l10n_util::GetStringUTF16(IDS_STAINLESS_IMAGE_OCR_CHANGE_LANGUAGE)));
+  extract_ = controls->AddChildView(std::make_unique<views::MdTextButton>(
+      base::BindRepeating(&StainlessImageOcrView::Extract,
+                          base::Unretained(this)),
+      l10n_util::GetStringUTF16(IDS_STAINLESS_IMAGE_OCR_EXTRACT)));
+  stop_ = controls->AddChildView(std::make_unique<views::MdTextButton>(
+      base::BindRepeating(&StainlessImageOcrView::Stop, base::Unretained(this)),
+      l10n_util::GetStringUTF16(IDS_STAINLESS_TRANSLATION_STOP)));
+  status_ = AddChildView(std::make_unique<views::Label>());
+  status_->SetMultiLine(true);
+  status_->SetHorizontalAlignment(gfx::HorizontalAlignment::ALIGN_LEFT);
+  status_->SetFocusBehavior(FocusBehavior::ALWAYS);
+  status_->GetViewAccessibility().SetRole(ax::mojom::Role::kStatus);
+  status_->GetViewAccessibility().SetLiveRegionContainer(
+      views::ViewAccessibility::LiveRegionStatus::kPolite);
+  output_ = AddChildView(std::make_unique<views::Textarea>());
+  output_->SetReadOnly(true);
+  output_->SetPreferredSize(gfx::Size(580, 200));
+  output_->GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_STAINLESS_IMAGE_OCR_OUTPUT));
+  AddChildView(std::make_unique<views::MdTextButton>(
+      base::BindRepeating(&StainlessImageOcrView::OpenSettings,
+                          base::Unretained(this)),
+      l10n_util::GetStringUTF16(IDS_STAINLESS_TRANSLATION_SETUP)));
+  state_subscription_ = controller_->Observe(base::BindRepeating(
+      &StainlessImageOcrView::StateChanged, weak_.GetWeakPtr()));
+  SetPreferredSize(gfx::Size(620, 420));
+  Refresh();
+}
