@@ -0,0 +1,175 @@
+#include "chrome/renderer/stainless_image_ocr_source.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/logging.h"
+#include "base/memory/weak_ptr.h"
+#include "base/task/thread_pool.h"
+#include "content/public/renderer/render_frame.h"
+#include "content/public/renderer/render_frame_observer.h"
+#include "mojo/public/cpp/base/big_buffer.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "third_party/blink/public/common/tokens/tokens.h"
+#include "third_party/blink/public/web/web_document.h"
+#include "third_party/blink/public/web/web_element.h"
+#include "third_party/blink/public/web/web_local_frame.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "ui/gfx/codec/png_codec.h"
+
+namespace stainless_local {
+namespace {
+
+using Status = chrome::mojom::StainlessImageSourceStatus;
+using Result = chrome::mojom::StainlessImageSourceResult;
+using ResultPtr = chrome::mojom::StainlessImageSourceResultPtr;
+
+bool Bounded(const gfx::Size& size) {
+  return size.width() > 0 && size.width() <= 4096 && size.height() > 0 &&
+         size.height() <= 4096;
+}
+
+ResultPtr Failure(Status status) {
+  auto result = Result::New();
+  result->status = status;
+  return result;
+}
+
+ResultPtr Encode(const SkBitmap& bitmap) {
+  if (!Bounded(gfx::Size(bitmap.width(), bitmap.height())) ||
+      bitmap.drawsNothing()) {
+    return Failure(Status::kTooLarge);
+  }
+  SkBitmap normalized;
+  const SkBitmap* input = &bitmap;
+  if (bitmap.colorType() != kN32_SkColorType) {
+    if (!normalized.tryAllocN32Pixels(bitmap.width(), bitmap.height()) ||
+        !bitmap.readPixels(normalized.pixmap(), 0, 0)) {
+      return Failure(Status::kFailed);
+    }
+    input = &normalized;
+  }
+  auto encoded =
+      gfx::PNGCodec::EncodeBGRASkBitmap(*input, /*discard_transparency=*/false);
+  if (!encoded || encoded->empty()) {
+    return Failure(Status::kFailed);
+  }
+  if (encoded->size() > 16777216) {
+    return Failure(Status::kTooLarge);
+  }
+  auto result = Result::New();
+  result->status = Status::kOk;
+  result->size = gfx::Size(bitmap.width(), bitmap.height());
+  result->png = mojo_base::BigBuffer(base::span(*encoded));
+  return result;
+}
+
+class ImageOcrSource final : public content::RenderFrameObserver,
+                             public chrome::mojom::StainlessImageOcrSource {
+ public:
+  ImageOcrSource(
+      content::RenderFrame* frame,
+      blink::WebElement image,
+      mojo::PendingReceiver<chrome::mojom::StainlessImageOcrSource> receiver)
+      : content::RenderFrameObserver(frame),
+        document_(frame->GetWebFrame()->GetDocument().Token()),
+        image_(std::move(image)),
+        size_(image_.GetImageSize()),
+        receiver_(this, std::move(receiver)) {
+    receiver_.set_disconnect_handler(
+        base::BindOnce(&ImageOcrSource::OnDestruct, base::Unretained(this)));
+  }
+  ~ImageOcrSource() override = default;
+
+  void ReadPng(ReadPngCallback reply) override {
+    if (!Current()) {
+      std::move(reply).Run(Failure(Status::kChanged));
+      return;
+    }
+    if (busy_) {
+      LOG(WARNING) << "Stainless image OCR source already has a pixel request";
+      std::move(reply).Run(Failure(Status::kFailed));
+      return;
+    }
+    if (!Bounded(size_) || image_.GetImageSize() != size_) {
+      std::move(reply).Run(Failure(Status::kTooLarge));
+      return;
+    }
+    SkBitmap bitmap = image_.ImageContents();
+    if (bitmap.drawsNothing()) {
+      std::move(reply).Run(Failure(Status::kNoImage));
+      return;
+    }
+    if (!Bounded(gfx::Size(bitmap.width(), bitmap.height()))) {
+      std::move(reply).Run(Failure(Status::kTooLarge));
+      return;
+    }
+    if (gfx::Size(bitmap.width(), bitmap.height()) != size_) {
+      std::move(reply).Run(Failure(Status::kResolutionUnavailable));
+      return;
+    }
+    busy_ = true;
+    auto replies = base::SplitOnceCallback(std::move(reply));
+    if (!base::ThreadPool::PostTaskAndReplyWithResult(
+            FROM_HERE, {base::TaskPriority::USER_VISIBLE},
+            base::BindOnce(&Encode, std::move(bitmap)),
+            base::BindOnce(&ImageOcrSource::Encoded, weak_.GetWeakPtr(),
+                           std::move(replies.first)))) {
+      busy_ = false;
+      LOG(ERROR) << "Stainless image OCR encoding task could not be posted";
+      std::move(replies.second).Run(Failure(Status::kFailed));
+    }
+  }
+
+ private:
+  bool Current() const {
+    return render_frame() && !image_.IsNull() && image_.IsConnected() &&
+           render_frame()->GetWebFrame()->GetDocument().Token() == document_ &&
+           image_.GetDocument().Token() == document_;
+  }
+  void Encoded(ReadPngCallback reply, ResultPtr result) {
+    busy_ = false;
+    std::move(reply).Run(Current() ? std::move(result)
+                                   : Failure(Status::kChanged));
+  }
+  void DidCreateNewDocument() override { delete this; }
+  void OnDestruct() override { delete this; }
+
+  const blink::DocumentToken document_;
+  blink::WebElement image_;
+  const gfx::Size size_;
+  bool busy_ = false;
+  mojo::Receiver<chrome::mojom::StainlessImageOcrSource> receiver_;
+  base::WeakPtrFactory<ImageOcrSource> weak_{this};
+};
+
+}  // namespace
+
+chrome::mojom::StainlessImageSourceInfoPtr SelectImageOcrSource(
+    content::RenderFrame* frame,
+    mojo::PendingReceiver<chrome::mojom::StainlessImageOcrSource> receiver) {
+  auto info = chrome::mojom::StainlessImageSourceInfo::New();
+  info->status = Status::kNoImage;
+  if (!frame || frame->GetWebFrame()->GetDocument().IsNull()) {
+    return info;
+  }
+  auto node = frame->GetWebFrame()->ContextMenuImageNode();
+  if (node.IsNull() || !node.IsElementNode()) {
+    return info;
+  }
+  auto image = node.To<blink::WebElement>();
+  info->original_size = image.GetImageSize();
+  if (info->original_size.IsEmpty()) {
+    return info;
+  }
+  if (!Bounded(info->original_size)) {
+    info->status = Status::kTooLarge;
+    return info;
+  }
+  new ImageOcrSource(frame, std::move(image), std::move(receiver));
+  info->status = Status::kOk;
+  return info;
+}
+
+}  // namespace stainless_local
