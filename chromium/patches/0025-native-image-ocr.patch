+StainlessImageOcrView::~StainlessImageOcrView() = default;
+
+void StainlessImageOcrView::StateChanged() {
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&StainlessImageOcrView::Refresh, weak_.GetWeakPtr()));
+}
+
+void StainlessImageOcrView::Refresh() {
+  if (!controller_ || !browser_ || Owner(document_) != browser_.get()) {
+    if (GetWidget()) {
+      GetWidget()->Close();
+    }
+    return;
+  }
+  using Phase = stainless_local::LocalImageOcr::Phase;
+  const auto& state = controller_->state();
+  const bool running = state.phase == Phase::kRunning;
+  language_->SetText(l10n_util::GetStringFUTF16(
+      IDS_STAINLESS_IMAGE_OCR_LANGUAGE,
+      chosen_.empty()
+          ? l10n_util::GetStringUTF16(IDS_STAINLESS_OCR_LANGUAGE_CHOOSE)
+          : base::UTF8ToUTF16(chosen_)));
+  change_->SetEnabled(!running && !changing_language_);
+  extract_->SetEnabled(controller_->CanStart() && !chosen_.empty() &&
+                       !changing_language_);
+  stop_->SetEnabled(running);
+  status_->SetText(
+      state.detail.empty()
+          ? l10n_util::GetStringUTF16(IDS_STAINLESS_IMAGE_OCR_SELECTING)
+          : base::UTF8ToUTF16(state.detail));
+  const auto text = base::UTF8ToUTF16(state.text);
+  if (output_->GetText() != text) {
+    output_->SetText(text);
+  }
+  if (focus_output_ &&
+      (state.phase == Phase::kComplete || state.phase == Phase::kError)) {
+    focus_output_ = false;
+    if (state.phase == Phase::kComplete && !text.empty()) {
+      output_->RequestFocus();
+    } else {
+      status_->RequestFocus();
+    }
+  }
+}
+
+void StainlessImageOcrView::ChangeLanguage() {
+  if (!controller_ || controller_->state().phase ==
+                          stainless_local::LocalImageOcr::Phase::kRunning) {
+    Refresh();
+    return;
+  }
+  changing_language_ = true;
+  Refresh();
+  chrome::ChooseLocalOcrLanguage(
+      document_, base::BindOnce(&StainlessImageOcrView::LanguageChosen,
+                                weak_.GetWeakPtr()));
+}
+
+void StainlessImageOcrView::LanguageChosen(
+    std::optional<std::string> language) {
+  changing_language_ = false;
+  if (language) {
+    chosen_ = std::move(*language);
+  }
+  Refresh();
+  if (GetWidget() && !GetWidget()->IsClosed()) {
+    (extract_->GetEnabled() ? extract_ : change_)->RequestFocus();
+  }
+}
+
+void StainlessImageOcrView::Extract() {
+  if (controller_) {
+    extract_->SetEnabled(false);
+    change_->SetEnabled(false);
+    focus_output_ = true;
+    controller_->Start(chosen_);
+  }
+}
+
+void StainlessImageOcrView::Stop() {
+  focus_output_ = false;
+  if (controller_) {
+    controller_->Stop();
+  }
+}
+
+void StainlessImageOcrView::OpenSettings() {
+  open_settings_ = true;
+  GetWidget()->Close();
+}
+
+void StainlessImageOcrView::DidFinishNavigation(content::NavigationHandle*) {
+  Refresh();
+}
+
+void StainlessImageOcrView::OnVisibilityChanged(
+    content::Visibility visibility) {
+  if (visibility == content::Visibility::HIDDEN && GetWidget()) {
+    GetWidget()->Close();
+  }
+}
+
+void StainlessImageOcrView::WebContentsDestroyed() {
+  if (GetWidget()) {
+    GetWidget()->Close();
+  }
+}
+
+void StainlessImageOcrView::OnWidgetDestroyed(views::Widget*) {
+  weak_.InvalidateWeakPtrs();
+  widget_.Reset();
+  registration_.reset();
+  state_subscription_ = {};
+  auto controller = controller_;
+  auto browser = browser_;
+  auto focus = std::move(return_focus_);
+  const bool settings = open_settings_;
+  if (controller) {
+    controller->Close();
+  }
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&RestoreOcrFocus, browser, settings, std::move(focus)));
 }
 
