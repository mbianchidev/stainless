+  std::unique_ptr<net::test_server::HttpResponse> RespondImage(
+      const net::test_server::HttpRequest& request) {
+    auto response = std::make_unique<net::test_server::BasicHttpResponse>();
+    response->AddCustomHeader(
+        "Content-Security-Policy",
+        "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'");
+    if (request.relative_url == "/blocker") {
+      response->set_content_type("text/html; charset=utf-8");
+      response->set_content(
+          "<!doctype html><title>Fictional broker owner</title>");
+    } else if (request.relative_url == "/image-page") {
+      response->set_content_type("text/html; charset=utf-8");
+      response->set_content(
+          "<!doctype html><html lang=en><style>"
+          "body{margin:0}img{display:block;width:400px;height:60px}"
+          "</style><img id=scan src=/scan.png "
+          "alt='Fictional author label stays unchanged'>"
+          "<img id=blank src=/blank.png alt='Fictional blank image'>");
+    } else if (request.relative_url == "/scan.png" ||
+               request.relative_url == "/blank.png") {
+      base::AutoLock lock(image_lock_);
+      response->set_content_type("image/png");
+      if (request.relative_url == "/scan.png") {
+        ++scan_requests_;
+        response->set_content(scan_);
+      } else {
+        response->set_content(blank_);
+      }
+    } else {
+      return nullptr;
+    }
+    return response;
+  }
+
+  base::Lock image_lock_;
+  std::string scan_ GUARDED_BY(image_lock_);
+  std::string blank_ GUARDED_BY(image_lock_);
+  size_t scan_requests_ GUARDED_BY(image_lock_) = 0;
+};
