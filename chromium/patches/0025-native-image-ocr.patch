+module chrome.mojom;
+
+import "mojo/public/mojom/base/big_buffer.mojom";
+import "ui/gfx/geometry/mojom/geometry.mojom";
+
+enum StainlessImageSourceStatus {
+  kOk,
+  kNoImage,
+  kChanged,
+  kTooLarge,
+  kResolutionUnavailable,
+  kFailed,
+};
+
+struct StainlessImageSourceInfo {
+  StainlessImageSourceStatus status;
+  gfx.mojom.Size original_size;
+};
+
+struct StainlessImageSourceResult {
+  StainlessImageSourceStatus status;
+  gfx.mojom.Size size;
+  mojo_base.mojom.BigBuffer png;
+};
+
+// Only the browser receives this original-document/context-node descriptor.
+// Selecting it does not produce pixels. ReadPng follows native broker admission.
+interface StainlessImageOcrSource {
+  ReadPng() => (StainlessImageSourceResult result);
+};
