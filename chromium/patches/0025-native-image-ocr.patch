diff --git a/chrome/browser/stainless_local/local_image_ocr.cc b/chrome/browser/stainless_local/local_image_ocr.cc
new file mode 100644
index 0000000000000000000000000000000000000000..b41772058d8c9e2ff251aa86a011b29ae90ed049
--- /dev/null
+++ b/chrome/browser/stainless_local/local_image_ocr.cc
@@ -0,0 +1,342 @@
+#include "chrome/browser/stainless_local/local_image_ocr.h"
+
+#include <algorithm>
+#include <array>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/stainless_local/local_models.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/render_frame_host.h"
+#include "third_party/blink/public/common/associated_interfaces/associated_interface_provider.h"
+
+namespace stainless_local {
+namespace {
+
+using SourceStatus = chrome::mojom::StainlessImageSourceStatus;
+
+const char* SourceError(SourceStatus status) {
+  switch (status) {
+    case SourceStatus::kOk:
+      return "";
+    case SourceStatus::kNoImage:
+      return "The selected context node has no readable decoded image";
+    case SourceStatus::kChanged:
+      return "The original document or selected image is no longer available";
+    case SourceStatus::kTooLarge:
+      return "Image OCR is limited to 4096 pixels per axis and 16 MiB encoded "
+             "PNG";
+    case SourceStatus::kResolutionUnavailable:
+      return "Original-resolution decoded pixels are unavailable; no thumbnail "
+             "OCR was performed";
+    case SourceStatus::kFailed:
+      return "The selected image could not be encoded for local OCR";
+  }
+}
+
+}  // namespace
+
+LocalImageOcr* LocalImageOcr::Get(content::RenderFrameHost* frame) {
+  return frame ? GetOrCreateForCurrentDocument(frame) : nullptr;
+}
+
+LocalImageOcr::LocalImageOcr(content::RenderFrameHost* frame)
+    : content::DocumentUserData<LocalImageOcr>(frame) {
+  preferences_.Init(profile()->GetPrefs());
+  preferences_.Add(kOcrEnabled,
+                   base::BindRepeating(&LocalImageOcr::PreferencesChanged,
+                                       weak_.GetWeakPtr()));
+}
+
+LocalImageOcr::~LocalImageOcr() {
+  weak_.InvalidateWeakPtrs();
+  CancelCurrent();
+}
+
+base::WeakPtr<LocalImageOcr> LocalImageOcr::GetWeakPtr() {
+  return weak_.GetWeakPtr();
+}
+
+Profile* LocalImageOcr::profile() const {
+  return Profile::FromBrowserContext(render_frame_host().GetBrowserContext());
+}
+
+bool LocalImageOcr::Allowed() const {
+  return IsLocalFeatureAllowed(&render_frame_host(), Feature::kOcr);
+}
+
+bool LocalImageOcr::CanStart() const {
+  return Allowed() && source_ready_ && !operation_;
+}
+
+base::CallbackListSubscription LocalImageOcr::Observe(
+    base::RepeatingClosure callback) {
+  return changed_.Add(std::move(callback));
+}
+
+void LocalImageOcr::Status(Phase phase, const std::string& detail) {
+  state_.phase = phase;
+  state_.detail = detail;
+  if (auto* models = LocalModels::GetIfExists(profile())) {
+    models->ReportRuntimeStatus(Feature::kOcr, detail, phase == Phase::kError);
+  }
+  if (phase == Phase::kError) {
+    LOG(ERROR) << "Stainless local image OCR is unavailable";
+  }
+  changed_.Notify();
+}
+
+void LocalImageOcr::SelectContextImage() {
+  CancelCurrent();
+  source_.reset();
+  frame_.reset();
+  source_ready_ = false;
+  result_.reset();
+  state_.text.clear();
+  if (!Allowed()) {
+    Status(
+        Phase::kError,
+        "Enable local OCR in a regular profile before extracting image text");
+    return;
+  }
+  state_.language = profile()->GetPrefs()->GetString(kOcrLanguage);
+  render_frame_host().GetRemoteAssociatedInterfaces()->GetInterface(&frame_);
+  frame_.set_disconnect_handler(
+      base::BindOnce(&LocalImageOcr::SourceGone, weak_.GetWeakPtr()));
+  auto self = GetWeakPtr();
+  Status(Phase::kSelecting,
+         "Selecting the original image without copying pixels");
+  if (!self || !frame_.is_bound()) {
+    return;
+  }
+  frame_->SelectStainlessImageOcrSource(
+      source_.BindNewPipeAndPassReceiver(),
+      base::BindOnce(&LocalImageOcr::Selected, weak_.GetWeakPtr()));
+}
+
+void LocalImageOcr::Selected(chrome::mojom::StainlessImageSourceInfoPtr info) {
+  if (!Allowed() || !info || info->status != SourceStatus::kOk ||
+      info->original_size.IsEmpty() || info->original_size.width() > 4096 ||
+      info->original_size.height() > 4096) {
+    source_.reset();
+    Status(Phase::kError, info && info->status != SourceStatus::kOk
+                              ? SourceError(info->status)
+                              : "The original image is no longer eligible");
+    return;
+  }
+  source_ready_ = true;
+  state_.image_size = info->original_size;
+  source_.set_disconnect_handler(
+      base::BindOnce(&LocalImageOcr::SourceGone, weak_.GetWeakPtr()));
+  Status(Phase::kReady,
+         "Choose an installed OCR language, then extract locally");
+}
+
+void LocalImageOcr::SourceGone() {
+  source_ready_ = false;
+  CancelCurrent();
+  result_.reset();
+  state_.text.clear();
+  Status(Phase::kError, SourceError(SourceStatus::kChanged));
+}
+
+void LocalImageOcr::PreferencesChanged() {
+  if (!Allowed()) {
+    CancelCurrent();
+    source_ready_ = false;
+    source_.reset();
+    result_.reset();
+    state_.text.clear();
+    Status(Phase::kError, "Local image OCR was disabled for this profile");
+  }
+}
+
+void LocalImageOcr::Start(const std::string& language) {
+  if (operation_) {
+    LOG(WARNING) << "Stainless image OCR already has an active native request";
+    Status(Phase::kRunning, "Local image OCR is already running; use Stop");
+    return;
+  }
+  if (!Allowed() || !source_ready_) {
+    Status(Phase::kError,
+           "Image OCR needs its original active document and a ready image");
+    return;
+  }
+  auto* models = LocalModels::Get(profile());
+  if (!models) {
+    Status(Phase::kError, "OCR model setup is unavailable in this mode");
+    return;
+  }
+  const auto selected = models->SetOcrLanguage(language);
+  if (!selected.has_value() || language.empty()) {
+    Status(Phase::kError, selected.has_value()
+                              ? "Choose an installed OCR language first"
+                              : selected.error());
+    return;
+  }
+  state_.language = language;
+  state_.text.clear();
+  result_.reset();
+  operation_ = std::make_unique<Operation>();
+  const auto token = base::UnguessableToken::Create();
+  operation_->token = token;
+  operation_->language = language;
+  auto self = GetWeakPtr();
+  Status(Phase::kRunning, "Waiting for bounded local image OCR admission");
+  if (!self || !Matches(token)) {
+    return;
+  }
+  const auto job = LocalBroker::Get().Submit(
+      &render_frame_host(), Feature::kOcr,
+      base::BindOnce(&LocalImageOcr::Admitted, weak_.GetWeakPtr(), token),
+      base::BindOnce(&LocalImageOcr::Completed, weak_.GetWeakPtr(), token));
+  if (Matches(token)) {
+    operation_->job = job;
+  }
+}
+
+bool LocalImageOcr::Matches(const base::UnguessableToken& token) const {
+  return operation_ && operation_->token == token;
+}
+
+void LocalImageOcr::Admitted(base::UnguessableToken token,
+                             LocalBroker::Ready ready) {
+  if (!Matches(token) || !Allowed()) {
+    LocalBroker::Prepared prepared;
+    prepared.error = "The original image OCR document changed before admission";
+    std::move(ready).Run(std::move(prepared));
+    return;
+  }
+  operation_->ready = std::move(ready);
+  auto* models = LocalModels::Get(profile());
+  if (!models) {
+    PreparationFailed("Image OCR model setup is unavailable");
+    return;
+  }
+  models->AcquirePack(
+      "ocr-" + operation_->language, Feature::kOcr,
+      base::BindOnce(&LocalImageOcr::PackReady, weak_.GetWeakPtr(), token));
+}
+
+void LocalImageOcr::PackReady(
+    base::UnguessableToken token,
+    base::expected<model_storage::Acquired, std::string> pack) {
+  if (!Matches(token)) {
+    return;
+  }
+  if (!Allowed() || !source_ready_ || !pack.has_value()) {
+    PreparationFailed(pack.has_value() ? "The original image OCR source changed"
+                                       : pack.error());
+    return;
+  }
+  operation_->pack.emplace(std::move(*pack));
+  source_->ReadPng(
+      base::BindOnce(&LocalImageOcr::PixelsReady, weak_.GetWeakPtr(), token));
+}
+
+void LocalImageOcr::PixelsReady(
+    base::UnguessableToken token,
+    chrome::mojom::StainlessImageSourceResultPtr pixels) {
+  if (!Matches(token)) {
+    return;
+  }
+  constexpr std::array<uint8_t, 8> kPng = {137, 80, 78, 71, 13, 10, 26, 10};
+  if (!Allowed() || !pixels || pixels->status != SourceStatus::kOk ||
+      pixels->size.IsEmpty() || pixels->size.width() > 4096 ||
+      pixels->size.height() > 4096 || pixels->png.size() < kPng.size() ||
+      pixels->png.size() > 16777216 ||
+      !std::ranges::equal(base::span(pixels->png).first(kPng.size()), kPng)) {
+    PreparationFailed(pixels && pixels->status != SourceStatus::kOk
+                          ? SourceError(pixels->status)
+                          : "The original image OCR pixels failed their PNG or "
+                            "size boundary");
+    return;
+  }
+  auto prepared =
+      PrepareLocalOcrRequest(std::move(*operation_->pack), operation_->language,
+                             mojom::Image::NewEncoded(std::move(pixels->png)));
+  operation_->pack.reset();
+  auto ready = std::move(operation_->ready);
+  Status(Phase::kRunning, "Reading the admitted original image with local OCR");
+  std::move(ready).Run(std::move(prepared));
+}
+
+void LocalImageOcr::PreparationFailed(const std::string& detail) {
+  if (operation_ && operation_->ready) {
+    LocalBroker::Prepared prepared;
+    prepared.error = detail;
+    auto ready = std::move(operation_->ready);
+    std::move(ready).Run(std::move(prepared));
+  }
+}
+
+void LocalImageOcr::Completed(base::UnguessableToken token,
+                              mojom::ResultPtr result) {
+  if (!Matches(token)) {
+    return;
+  }
+  operation_.reset();
+  if (!Allowed() || !result || result->status != mojom::Status::kOk) {
+    Status(Phase::kError, result && !result->detail.empty()
+                              ? result->detail
+                              : "Local image OCR failed or lost its document");
+    return;
+  }
+  uint32_t previous_line = 0;
+  for (const auto& word : result->words) {
+    const char* separator = state_.text.empty()                 ? ""
+                            : previous_line == word->line_index ? " "
+                                                                : "\n";
+    const size_t separator_bytes = state_.text.empty() ? 0 : 1;
+    if (state_.text.size() + word->text.size() + separator_bytes > 1048576) {
+      state_.text.clear();
+      Status(Phase::kError, "Local image OCR text exceeds its bounded output");
+      return;
+    }
+    state_.text += separator;
+    state_.text += word->text;
+    previous_line = word->line_index;
+  }
+  state_.image_size = gfx::Size(result->image_width, result->image_height);
+  result_ = std::move(result);
+  Status(Phase::kComplete,
+         state_.text.empty()
+             ? "Local OCR found no readable image text"
+             : "Image text extracted locally; OCR may contain errors");
+}
+
+void LocalImageOcr::CancelCurrent() {
+  auto operation = std::move(operation_);
+  if (!operation) {
+    return;
+  }
+  if (!operation->job.is_empty()) {
+    LocalBroker::Get().Cancel(operation->job);
+  }
+  if (operation->ready) {
+    LocalBroker::Prepared prepared;
+    prepared.error = "The native image OCR operation was cancelled";
+    std::move(operation->ready).Run(std::move(prepared));
+  }
+}
+
+void LocalImageOcr::Stop() {
+  CancelCurrent();
+  Status(Phase::kStopped, "Local image OCR stopped");
+}
+
+void LocalImageOcr::Close() {
+  CancelCurrent();
+  source_ready_ = false;
+  source_.reset();
+  frame_.reset();
+  result_.reset();
+  state_.text.clear();
+  Status(Phase::kStopped, "Local image OCR closed");
+}
+
+DOCUMENT_USER_DATA_KEY_IMPL(LocalImageOcr);
+
+}  // namespace stainless_local
