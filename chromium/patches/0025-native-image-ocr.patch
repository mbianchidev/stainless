@@ -0,0 +1,90 @@
+#ifndef CHROME_BROWSER_STAINLESS_LOCAL_LOCAL_IMAGE_OCR_H_
+#define CHROME_BROWSER_STAINLESS_LOCAL_LOCAL_IMAGE_OCR_H_
+
+#include <memory>
+#include <optional>
+#include <string>
+
+#include "base/callback_list.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/stainless_local/local_ocr.h"
+#include "chrome/common/chrome_render_frame.mojom.h"
+#include "chrome/common/stainless_local_image.mojom.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "content/public/browser/document_user_data.h"
+#include "mojo/public/cpp/bindings/associated_remote.h"
+#include "mojo/public/cpp/bindings/remote.h"
+
+namespace stainless_local {
+
+class LocalImageOcr final : public content::DocumentUserData<LocalImageOcr> {
+ public:
+  enum class Phase {
+    kSelecting,
+    kReady,
+    kRunning,
+    kComplete,
+    kStopped,
+    kError
+  };
+  struct State {
+    Phase phase = Phase::kSelecting;
+    std::string language;
+    std::string detail;
+    std::string text;
+    gfx::Size image_size;
+  };
+
+  static LocalImageOcr* Get(content::RenderFrameHost* frame);
+  ~LocalImageOcr() override;
+  base::WeakPtr<LocalImageOcr> GetWeakPtr();
+  const State& state() const { return state_; }
+  const mojom::Result* result() const { return result_.get(); }
+  bool Allowed() const;
+  bool CanStart() const;
+  void SelectContextImage();
+  void Start(const std::string& language);
+  void Stop();
+  void Close();
+  base::CallbackListSubscription Observe(base::RepeatingClosure callback);
+
+ private:
+  friend class content::DocumentUserData<LocalImageOcr>;
+  struct Operation {
+    base::UnguessableToken token;
+    base::UnguessableToken job;
+    LocalBroker::Ready ready;
+    std::optional<model_storage::Acquired> pack;
+    std::string language;
+  };
+  explicit LocalImageOcr(content::RenderFrameHost* frame);
+  Profile* profile() const;
+  void Selected(chrome::mojom::StainlessImageSourceInfoPtr info);
+  void SourceGone();
+  void PreferencesChanged();
+  void Admitted(base::UnguessableToken token, LocalBroker::Ready ready);
+  void PackReady(base::UnguessableToken token,
+                 base::expected<model_storage::Acquired, std::string> pack);
+  void PixelsReady(base::UnguessableToken token,
+                   chrome::mojom::StainlessImageSourceResultPtr pixels);
+  void PreparationFailed(const std::string& detail);
+  void Completed(base::UnguessableToken token, mojom::ResultPtr result);
+  bool Matches(const base::UnguessableToken& token) const;
+  void CancelCurrent();
+  void Status(Phase phase, const std::string& detail);
+
+  State state_;
+  bool source_ready_ = false;
+  mojom::ResultPtr result_;
+  std::unique_ptr<Operation> operation_;
+  mojo::AssociatedRemote<chrome::mojom::ChromeRenderFrame> frame_;
+  mojo::Remote<chrome::mojom::StainlessImageOcrSource> source_;
+  base::RepeatingClosureList changed_;
+  PrefChangeRegistrar preferences_;
+  base::WeakPtrFactory<LocalImageOcr> weak_{this};
+  DOCUMENT_USER_DATA_KEY_DECL();
+};
+
+}  // namespace stainless_local
+
+#endif
