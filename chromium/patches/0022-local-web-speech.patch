+IN_PROC_BROWSER_TEST_F(
+    StainlessLocalWorkerBrowserTest,
+    StreamingReservationRequiresConsentAndRejectsUnrelatedWork) {
+  auto* prefs = browser()->GetProfile()->GetPrefs();
+  base::test::TestFuture<mojom::Status> stopped;
+  EXPECT_FALSE(
+      LocalBroker::Get()
+          .ReserveSession(frame(), Feature::kSpeech, stopped.GetCallback())
+          .has_value());
+  prefs->SetBoolean(kSpeechEnabled, true);
+  prefs->SetBoolean(kOcrEnabled, true);
+  auto session = LocalBroker::Get().ReserveSession(frame(), Feature::kSpeech,
+                                                   stopped.GetCallback());
+  ASSERT_TRUE(session.has_value());
+  EXPECT_EQ(Feature::kSpeech, LocalBroker::Get().ReservedSessionForProfile(
+                                  browser()->GetProfile()));
+  base::test::TestFuture<mojom::ResultPtr> unrelated;
+  int opened = 0;
+  EXPECT_TRUE(LocalBroker::Get()
+                  .Submit(frame(), Feature::kOcr,
+                          base::BindLambdaForTesting(
+                              [&](LocalBroker::Ready) { ++opened; }),
+                          unrelated.GetCallback())
+                  .is_empty());
+  EXPECT_EQ(mojom::Status::kQueueFull, unrelated.Get()->status);
+  EXPECT_EQ(0, opened);
+  base::test::TestFuture<LocalBroker::Ready> admitted;
+  base::test::TestFuture<mojom::ResultPtr> result;
+  const auto job = LocalBroker::Get().Submit(frame(), Feature::kSpeech,
+                                             admitted.GetCallback(),
+                                             result.GetCallback(), *session);
+  ASSERT_FALSE(job.is_empty());
+  ASSERT_TRUE(admitted.Wait());
+  prefs->SetBoolean(kSpeechEnabled, false);
+  EXPECT_EQ(mojom::Status::kNotAllowed, stopped.Get());
+  EXPECT_EQ(mojom::Status::kNotAllowed, result.Get()->status);
+  EXPECT_FALSE(
+      LocalBroker::Get().ReservedSessionForProfile(browser()->GetProfile()));
+}
