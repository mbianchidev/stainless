+void LocalBroker::StopSession(base::UnguessableToken id,
+                              mojom::Status reason,
+                              bool notify) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!session_ || session_->id != id) {
+    return;
+  }
+  auto stopped = std::move(session_->stopped);
+  session_.reset();
+  std::vector<base::UnguessableToken> cancelled;
+  if (active_ && active_->session == id && !active_->stopping) {
+    cancelled.push_back(active_->id);
+  }
+  for (const auto& job : queued_) {
+    if (job->session == id) {
+      cancelled.push_back(job->id);
+    }
+  }
+  for (const auto& job : cancelled) {
+    Stop(job, reason);
+  }
+  if (notify && stopped) {
+    std::move(stopped).Run(reason);
+  }
