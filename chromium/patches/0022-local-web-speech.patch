+#include "components/content_settings/core/browser/content_settings_observer.h"
+#include "components/content_settings/core/browser/host_content_settings_map.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/document_user_data.h"
+#include "content/public/browser/permission_controller.h"
+#include "content/public/browser/permission_descriptor_util.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/security_principal.h"
+#include "content/public/browser/site_instance.h"
+#include "content/public/browser/web_contents.h"
+#include "media/mojo/mojom/speech_recognition.mojom.h"
+#include "media/mojo/mojom/speech_recognition_error.mojom.h"
+#include "media/mojo/mojom/speech_recognition_error_code.mojom.h"
+#include "media/mojo/mojom/speech_recognizer.mojom.h"
+#include "mojo/public/cpp/bindings/receiver_set.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "net/base/schemeful_site.h"
+#include "services/network/public/mojom/permissions_policy/permissions_policy_feature.mojom.h"
+#include "third_party/blink/public/common/permissions/permission_utils.h"
+#include "third_party/icu/source/common/unicode/uchar.h"
+#include "third_party/icu/source/common/unicode/uloc.h"
+#include "third_party/icu/source/common/unicode/unistr.h"
+#include "third_party/icu/source/common/unicode/utypes.h"
+
+namespace stainless_local {
+namespace {
+
+class LocalSpeechDocument final
+    : public content::DocumentUserData<LocalSpeechDocument>,
+      public media::mojom::SpeechRecognitionContext,
+      public content_settings::Observer {
+ public:
+  using Availability = media::mojom::AvailabilityStatus;
+  using AvailabilityReply = base::OnceCallback<void(Availability)>;
+
+  bool QueryContext() {
+    auto& frame = render_frame_host();
+    const auto& origin = frame.GetLastCommittedOrigin();
+    return frame.IsActive() && frame.IsRenderFrameLive() &&
+           !frame.IsErrorDocument() && !frame.IsNestedWithinFencedFrame() &&
+           !origin.opaque() &&
+           (origin.scheme() == "https" || origin.scheme() == "http" ||
+            origin.scheme() == "file") &&
+           frame.IsFeatureEnabled(network::mojom::PermissionsPolicyFeature::
+                                      kOnDeviceSpeechRecognition) &&
+           net::SchemefulSite(origin) ==
+               net::SchemefulSite(
+                   frame.GetMainFrame()->GetLastCommittedOrigin());
+  }
+
+  bool OriginAuthorized() {
+    return unmasked_ || SpeechMicrophoneGranted(&render_frame_host());
+  }
+
+  bool Supported(const std::vector<std::string>& languages,
+                 media::mojom::SpeechRecognitionQuality quality) const {
+    return !languages.empty() && languages.size() <= 100 &&
+           quality == media::mojom::SpeechRecognitionQuality::kCommand &&
+           std::ranges::all_of(languages, [](const auto& language) {
+             return NormalizeSpeechLanguage(language).has_value();
+           });
+  }
+
+  void Available(const std::vector<std::string>& languages,
+                 media::mojom::SpeechRecognitionQuality quality,
+                 AvailabilityReply reply) {
+    if (!QueryContext() || !Supported(languages, quality)) {
+      std::move(reply).Run(Availability::kUnavailable);
+    } else if (!OriginAuthorized()) {
+      std::move(reply).Run(Availability::kDownloadable);
+    } else {
+      EffectiveModel(std::move(reply));
+    }
+  }
+
+  void Install(const std::vector<std::string>& languages,
+               media::mojom::SpeechRecognitionQuality quality,
+               base::OnceCallback<void(bool, bool)> reply) {
+    if (!QueryContext()) {
+      std::move(reply).Run(false, true);
+      return;
+    }
+    if (languages.empty() || languages.size() > 100) {
+      std::move(reply).Run(false, false);
+      return;
+    }
+    if (!OriginAuthorized()) {
+      if (!render_frame_host().ConsumeTransientUserActivation()) {
+        std::move(reply).Run(false, true);
+        return;
+      }
+      unmasked_ = true;
+    }
+    if (!Supported(languages, quality)) {
+      std::move(reply).Run(false, false);
+      return;
+    }
+    EffectiveModel(base::BindOnce(
+        [](base::OnceCallback<void(bool, bool)> reply, Availability status) {
+          std::move(reply).Run(status == Availability::kAvailable, false);
+        },
+        std::move(reply)));
+  }
+
+  void EffectiveModel(AvailabilityReply reply) {
+    if (!OriginAuthorized() || !SpeechDocumentAllowed(&render_frame_host()) ||
+        checking_ >= 16) {
+      std::move(reply).Run(Availability::kUnavailable);
+      return;
+    }
+    auto* models = LocalModels::Get(
+        Profile::FromBrowserContext(render_frame_host().GetBrowserContext()));
+    if (!models) {
+      std::move(reply).Run(Availability::kUnavailable);
+      return;
+    }
+    if (models->Installing("speech-multilingual")) {
+      std::move(reply).Run(Availability::kDownloading);
+      return;
+    }
+    ++checking_;
+    models->AcquirePack(
+        "speech-multilingual", Feature::kSpeech,
+        base::BindOnce(
+            [](base::WeakPtr<LocalSpeechDocument> owner,
+               AvailabilityReply reply,
+               base::expected<model_storage::Acquired, std::string> acquired) {
+              if (!owner) {
+                return;
+              }
+              --owner->checking_;
+              if (!owner->OriginAuthorized() ||
+                  !SpeechDocumentAllowed(&owner->render_frame_host())) {
+                std::move(reply).Run(Availability::kUnavailable);
+                return;
+              }
+              if (!acquired.has_value()) {
+                if (auto* models =
+                        LocalModels::GetIfExists(Profile::FromBrowserContext(
+                            owner->render_frame_host().GetBrowserContext()))) {
+                  models->ReportRuntimeStatus(
+                      Feature::kSpeech,
+                      "Native speech setup is required; no web-call download "
+                      "was started",
+                      true);
+                }
+                std::move(reply).Run(Availability::kDownloadable);
+                return;
+              }
+              acquired->Close(base::BindOnce(
+                  [](base::WeakPtr<LocalSpeechDocument> owner,
+                     AvailabilityReply reply) {
+                    if (owner) {
+                      std::move(reply).Run(
+                          owner->OriginAuthorized() &&
+                                  SpeechDocumentAllowed(
+                                      &owner->render_frame_host())
+                              ? Availability::kAvailable
+                              : Availability::kUnavailable);
+                    }
+                  },
+                  owner, std::move(reply)));
+            },
+            weak_.GetWeakPtr(), std::move(reply)));
+  }
+
+  void OnContentSettingChanged(const ContentSettingsPattern& primary,
+                               const ContentSettingsPattern& secondary,
+                               ContentSettingsTypeSet types) override {
+    if (types.Contains(ContentSettingsType::MEDIASTREAM_MIC) &&
+        primary.Matches(
+            render_frame_host().GetLastCommittedOrigin().GetURL()) &&
+        secondary.Matches(render_frame_host()
+                              .GetMainFrame()
+                              ->GetLastCommittedOrigin()
+                              .GetURL())) {
+      unmasked_ = false;
+    }
+  }
+  void Bind(
+      mojo::PendingReceiver<media::mojom::SpeechRecognitionContext> receiver) {
+    if (receivers_.size() >= 16) {
+      receiver.ResetWithReason(
+          static_cast<uint32_t>(
+              media::mojom::LocalSpeechDisconnectReason::kServiceNotAllowed),
+          "The local speech context limit was reached");
+      return;
+    }
+    receivers_.Add(this, std::move(receiver));
+  }
+
+  bool CheckStart() {
+    if (!SpeechDocumentAllowed(&render_frame_host())) {
+      LOG(ERROR) << "Stainless local speech: feature, policy or storage "
+                    "context denied";
+      return false;
+    }
+    if (content::WebContents::FromRenderFrameHost(&render_frame_host())
+            ->GetVisibility() != content::Visibility::VISIBLE) {
+      LOG(ERROR) << "Stainless local speech: hidden document denied";
+      return false;
+    }
+    if (activation_required_ &&
+        !render_frame_host().ConsumeTransientUserActivation()) {
+      LOG(ERROR) << "Stainless local speech: fresh start activation required";
+      return false;
+    }
+    activation_required_ = false;
+    return true;
+  }
+
+  void RequireActivation() { activation_required_ = true; }
+
+  void BindRecognizer(
+      mojo::PendingReceiver<media::mojom::SpeechRecognitionRecognizer> receiver,
+      mojo::PendingRemote<media::mojom::SpeechRecognitionRecognizerClient>
+          client,
+      media::mojom::SpeechRecognitionOptionsPtr options,
+      BindRecognizerCallback callback) override {
+    if (!SpeechDocumentAllowed(&render_frame_host()) || streams_.size() >= 16) {
+      receiver.ResetWithReason(
+          static_cast<uint32_t>(
+              media::mojom::LocalSpeechDisconnectReason::kServiceNotAllowed),
+          "Local speech is unavailable or the context limit was reached");
+      std::move(callback).Run(false);
+      return;
+    }
+    const auto id = base::UnguessableToken::Create();
+    const auto document = render_frame_host().GetWeakDocumentPtr();
+    streams_.emplace(
+        id, std::make_unique<LocalSpeechStream>(
+                document, Feature::kSpeech, std::move(options),
+                std::move(receiver), std::move(client),
+                base::BindRepeating(
+                    [](content::WeakDocumentPtr document,
+                       const std::string& diagnostic, bool error) {
+                      if (auto* frame = document.AsRenderFrameHostIfValid()) {
+                        if (auto* models = LocalModels::GetIfExists(
+                                Profile::FromBrowserContext(
+                                    frame->GetBrowserContext()))) {
+                          models->ReportRuntimeStatus(Feature::kSpeech,
+                                                      diagnostic, error);
+                        }
+                      }
+                    },
+                    document),
+                base::BindRepeating(
+                    [](base::WeakPtr<LocalSpeechDocument> owner) {
+                      if (owner) {
+                        owner->activation_required_ = true;
+                      }
+                    },
+                    weak_.GetWeakPtr()),
+                base::BindOnce(
+                    [](base::WeakPtr<LocalSpeechDocument> owner,
+                       base::UnguessableToken id) {
+                      if (owner) {
+                        owner->streams_.erase(id);
+                      }
+                    },
+                    weak_.GetWeakPtr(), id)));
+    std::move(callback).Run(false);
+  }
+
+  void BindWebSpeechRecognizer(
+      mojo::PendingReceiver<media::mojom::SpeechRecognitionSession> receiver,
+      mojo::PendingRemote<media::mojom::SpeechRecognitionSessionClient> client,
+      mojo::PendingReceiver<media::mojom::SpeechRecognitionAudioForwarder>,
+      int32_t,
+      int32_t,
+      media::mojom::SpeechRecognitionOptionsPtr,
+      bool) override {
+    mojo::Remote<media::mojom::SpeechRecognitionSessionClient> remote(
+        std::move(client));
+    remote->ErrorOccurred(media::mojom::SpeechRecognitionError::New(
+        media::mojom::SpeechRecognitionErrorCode::kServiceNotAllowed,
+        media::mojom::SpeechAudioErrorDetails::kNone));
+    remote->Ended();
+    receiver.ResetWithReason(
+        static_cast<uint32_t>(
+            media::mojom::LocalSpeechDisconnectReason::kServiceNotAllowed),
+        "Track input is not supported by local Web Speech");
+  }
+
+ private:
+  friend class content::DocumentUserData<LocalSpeechDocument>;
+  explicit LocalSpeechDocument(content::RenderFrameHost* frame)
+      : content::DocumentUserData<LocalSpeechDocument>(frame) {
+    auto* profile = Profile::FromBrowserContext(frame->GetBrowserContext());
+    preferences_.Init(profile->GetPrefs());
+    preferences_.Add(
+        kSpeechEnabled,
+        base::BindRepeating(
+            [](base::WeakPtr<LocalSpeechDocument> owner) {
+              if (owner && !Profile::FromBrowserContext(
+                                owner->render_frame_host().GetBrowserContext())
+                                ->GetPrefs()
+                                ->GetBoolean(kSpeechEnabled)) {
+                owner->unmasked_ = false;
+              }
+            },
+            weak_.GetWeakPtr()));
+    settings_.Observe(HostContentSettingsMapFactory::GetForProfile(profile));
+  }
+
+  mojo::ReceiverSet<media::mojom::SpeechRecognitionContext> receivers_;
+  std::map<base::UnguessableToken, std::unique_ptr<LocalSpeechStream>> streams_;
+  bool activation_required_ = false;
+  bool unmasked_ = false;
+  size_t checking_ = 0;
+  PrefChangeRegistrar preferences_;
+  base::ScopedObservation<HostContentSettingsMap, content_settings::Observer>
+      settings_{this};
+  base::WeakPtrFactory<LocalSpeechDocument> weak_{this};
+  DOCUMENT_USER_DATA_KEY_DECL();
+};
+
+DOCUMENT_USER_DATA_KEY_IMPL(LocalSpeechDocument);
+
+}  // namespace
+
+std::optional<std::string> NormalizeSpeechLanguage(std::string_view tag) {
+  if (tag.empty() || tag.size() > 128 ||
+      tag.find('\0') != std::string_view::npos) {
+    return std::nullopt;
+  }
+  const std::string value(tag);
+  std::array<char, ULOC_FULLNAME_CAPACITY> locale = {};
+  int32_t parsed = 0;
+  UErrorCode error = U_ZERO_ERROR;
+  uloc_forLanguageTag(value.c_str(), locale.data(), locale.size(), &parsed,
+                      &error);
+  if (U_FAILURE(error) || parsed != static_cast<int32_t>(value.size())) {
+    return std::nullopt;
+  }
+  std::array<char, ULOC_LANG_CAPACITY> language = {};
+  uloc_getLanguage(locale.data(), language.data(), language.size(), &error);
+  if (U_FAILURE(error)) {
+    return std::nullopt;
+  }
+  std::string result(language.data());
+  if (result == "jv") {
+    result = "jw";
+  }
+  return IsSpeechModelLanguage(result) ? std::optional(std::move(result))
+                                       : std::nullopt;
+}
+
+std::string UnformatSpeechTranscript(const std::string& text) {
+  const auto input = icu::UnicodeString::fromUTF8(text);
+  std::vector<UChar32> characters;
+  for (int32_t index = 0; index < input.length();) {
+    const auto value = input.char32At(index);
+    characters.push_back(value);
+    index += U16_LENGTH(value);
+  }
+  icu::UnicodeString output;
+  for (size_t index = 0; index < characters.size(); ++index) {
+    const auto value = characters[index];
+    const auto previous = index > 0 ? characters[index - 1] : 0;
+    const auto next = index + 1 < characters.size() ? characters[index + 1] : 0;
+    if (u_ispunct(value)) {
+      const bool word_internal =
+          u_isalnum(previous) && u_isalnum(next) &&
+          (value == '\'' || value == 0x2019 || value == '-' ||
+           value == 0x2010 || value == 0x2011);
+      const bool numeric_separator =
+          u_isdigit(previous) && u_isdigit(next) &&
+          (value == '.' || value == ',' || value == ':' || value == '/');
+      const bool numeric_sign =
+          (value == '-' || value == '+') && u_isdigit(next) &&
+          (index == 0 || u_isUWhiteSpace(previous) || previous == '(');
+      const bool numeric_suffix =
+          u_isdigit(previous) &&
+          (value == '%' || value == 0x2030 || value == 0x2031);
+      if (!word_internal && !numeric_separator && !numeric_sign &&
+          !numeric_suffix) {
+        continue;
+      }
+    }
+    output.append(value);
+  }
+  std::string result;
+  output.toUTF8String(result);
+  return result;
+}
+
+std::optional<std::string> SelectedSpeechLanguage(Profile* profile,
+                                                  std::string_view requested) {
+  if (!profile) {
+    return std::nullopt;
+  }
+  if (!requested.empty()) {
+    return NormalizeSpeechLanguage(requested);
+  }
+  const auto& preference = profile->GetPrefs()->GetString(kSpeechLanguage);
+  return NormalizeSpeechLanguage(preference.empty()
+                                     ? g_browser_process->GetApplicationLocale()
+                                     : preference);
+}
+
+bool SpeechDocumentAllowed(content::RenderFrameHost* frame) {
+  if (!IsLocalFeatureAllowed(frame, Feature::kSpeech) ||
+      !frame->IsFeatureEnabled(network::mojom::PermissionsPolicyFeature::
+                                   kOnDeviceSpeechRecognition)) {
+    return false;
+  }
+  auto* profile = Profile::FromBrowserContext(frame->GetBrowserContext());
+  auto* main = frame->GetMainFrame();
+  return !main->GetSiteInstance()->GetSecurityPrincipal().IsGuest() &&
+         main->GetStoragePartition() == profile->GetDefaultStoragePartition();
+}
+
+bool SpeechMicrophoneGranted(content::RenderFrameHost* frame) {
+  return frame && frame->GetBrowserContext()
+                          ->GetPermissionController()
+                          ->GetPermissionStatusForCurrentDocument(
+                              content::PermissionDescriptorUtil::
+                                  CreatePermissionDescriptorForPermissionType(
+                                      blink::PermissionType::AUDIO_CAPTURE),
+                              frame) == blink::mojom::PermissionStatus::GRANTED;
+}
+
+bool CheckLocalSpeechStart(content::RenderFrameHost* frame) {
+  return frame && LocalSpeechDocument::GetOrCreateForCurrentDocument(frame)
+                      ->CheckStart();
+}
+
+void RequireNewSpeechActivation(content::WeakDocumentPtr document) {
+  if (auto* frame = document.AsRenderFrameHostIfValid()) {
+    LocalSpeechDocument::GetOrCreateForCurrentDocument(frame)
+        ->RequireActivation();
+  }
+}
+
+void QueryLocalSpeechAvailability(
+    content::RenderFrameHost* frame,
+    const std::vector<std::string>& languages,
+    media::mojom::SpeechRecognitionQuality quality,
+    base::OnceCallback<void(media::mojom::AvailabilityStatus)> reply) {
+  if (!frame) {
+    std::move(reply).Run(media::mojom::AvailabilityStatus::kUnavailable);
+    return;
+  }
+  LocalSpeechDocument::GetOrCreateForCurrentDocument(frame)->Available(
+      languages, quality, std::move(reply));
+}
+
+void ConfirmLocalSpeechInstallation(
+    content::RenderFrameHost* frame,
+    const std::vector<std::string>& languages,
+    media::mojom::SpeechRecognitionQuality quality,
+    base::OnceCallback<void(bool, bool)> reply) {
+  if (!frame) {
+    std::move(reply).Run(false, true);
+    return;
+  }
+  LocalSpeechDocument::GetOrCreateForCurrentDocument(frame)->Install(
+      languages, quality, std::move(reply));
+}
+
+void BindLocalWebSpeechContext(
+    content::GlobalRenderFrameHostId id,
+    content::WeakDocumentPtr document,
+    mojo::PendingReceiver<media::mojom::SpeechRecognitionContext> receiver) {
+  auto* frame = content::RenderFrameHost::FromID(id);
+  if (!frame || document.AsRenderFrameHostIfValid() != frame ||
+      !SpeechDocumentAllowed(frame)) {
+    receiver.ResetWithReason(
+        static_cast<uint32_t>(
+            media::mojom::LocalSpeechDisconnectReason::kServiceNotAllowed),
+        "The original local speech document is unavailable");
+    return;
+  }
+  LocalSpeechDocument::GetOrCreateForCurrentDocument(frame)->Bind(
+      std::move(receiver));
+}
+
+}  // namespace stainless_local
