+  ASSERT_TRUE(speech.has_value());
+  contents->WasHidden();
+  ASSERT_TRUE(speech_stopped.Wait());
+  EXPECT_EQ(mojom::Status::kCancelled, speech_stopped.Get());
+  EXPECT_FALSE(
