+#include "base/test/run_until.h"
+#include "url/gurl.h"
+
+namespace stainless_local::test {
+
+base::expected<void, std::string> InstallModelFixture(
+    const model_storage::Location& location,
+    const std::string& id,
+    const base::FilePath& directory) {
+  if (!directory.IsAbsolute() || directory.ReferencesParent()) {
+    return base::unexpected(
+        "A synthetic absolute model fixture directory is required");
+  }
+  const auto& catalog = ModelCatalog();
+  const auto pack = std::ranges::find(catalog, id, &ModelPack::id);
+  if (pack == catalog.end()) {
+    return base::unexpected(
+        "The requested fixture model is not in the compiled catalog");
+  }
+  auto reserved = model_storage::Reserve(location, *pack);
+  if (!reserved.has_value()) {
+    return base::unexpected(reserved.error());
+  }
+  auto& transaction = **reserved;
+  auto failed = [&](std::string message) -> base::expected<void, std::string> {
+    auto removed = model_storage::Cancel(transaction);
+    if (!removed.has_value()) {
+      message += "; fixture cleanup failed: " + removed.error();
+    }
+    return base::unexpected(std::move(message));
+  };
+  base::File input(directory.AppendASCII(GURL(pack->url).ExtractFileName()),
+                   base::File::FLAG_OPEN | base::File::FLAG_READ);
+  if (!input.IsValid()) {
+    return failed("The prepared synthetic model archive could not be opened");
+  }
+  std::array<uint8_t, 65536> bytes;
+  while (true) {
+    const auto count = input.ReadAtCurrentPos(bytes);
+    if (!count.has_value()) {
+      return failed("The synthetic model archive could not be read");
+    }
+    if (!*count) {
+      break;
+    }
+    if (!transaction.archive_file.WriteAtCurrentPosAndCheck(
+            base::span(bytes).first(*count))) {
+      return failed("The synthetic model archive could not be staged");
+    }
+  }
+  auto installed = model_storage::Install(transaction);
+  return installed.has_value() ? base::expected<void, std::string>()
+                               : failed(installed.error());
+}
+
+base::expected<void, std::string> RemoveModelFixtures(
+    const model_storage::Location& location) {
+  if (!base::PathExists(location.leaf)) {
+    return {};
+  }
+  auto inventory = model_storage::Inspect(location, false);
+  if (!inventory.has_value()) {
+    return base::unexpected(inventory.error());
+  }
+  std::string failure;
+  {
+    base::File lease(location.leaf.AppendASCII(".lease"),
+                     base::File::FLAG_OPEN | base::File::FLAG_READ);
+    if (!lease.IsValid()) {
+      return base::unexpected(
+          "The synthetic model cache has no readable owner lease");
+    }
+    const bool ready = base::test::RunUntil([&] {
+      if (flock(lease.GetPlatformFile(), LOCK_EX | LOCK_NB) == 0) {
+        if (flock(lease.GetPlatformFile(), LOCK_UN) != 0) {
+          failure = "The synthetic model cleanup lease could not be released";
+        }
+        return true;
+      }
+      if (errno != EWOULDBLOCK && errno != EAGAIN) {
+        failure = "The synthetic model cleanup lease failed";
+        return true;
+      }
+      return false;
+    });
+    if (!ready || !failure.empty()) {
+      return base::unexpected(
+          failure.empty() ? "The synthetic model is still in use" : failure);
+    }
+  }
+  for (const auto& pack : inventory->packs) {
+    auto removed = model_storage::Remove(location, pack.archive_sha256);
+    if (!removed.has_value()) {
+      return base::unexpected(removed.error());
+    }
+  }
+  return {};
+}
+
+}  // namespace stainless_local::test
