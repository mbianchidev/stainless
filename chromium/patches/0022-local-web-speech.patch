+class SyntheticMicrophonePermissionContext
+    : public MediaStreamDevicePermissionContext {
+ public:
+  explicit SyntheticMicrophonePermissionContext(Profile* profile, bool allow)
+      : MediaStreamDevicePermissionContext(
+            profile,
+            ContentSettingsType::MEDIASTREAM_MIC),
+        allow_(allow) {}
+
+  void DecidePermission(
+      std::unique_ptr<permissions::PermissionRequestData> request,
+      permissions::BrowserPermissionCallback callback) override {
+    ++decisions;
+    NotifyPermissionSet(
+        *request, std::move(callback), true, nullptr,
+        permissions::PermissionPromptDecision{
+            .overall_decision =
+                allow_ ? PermissionDecision::kAllow : PermissionDecision::kDeny,
+            .is_final = true});
+  }
+
+  int decisions = 0;
+
+ private:
+  const bool allow_;
+};
