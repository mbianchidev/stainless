+void SodaSpeechRecognitionEngineImpl::OnRecognizerDisconnectedWithReason(
+    uint32_t reason,
+    const std::string&) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(main_sequence_checker_);
+  if (!is_start_recognition_) {
+    return;
+  }
+  using Local = media::mojom::LocalSpeechDisconnectReason;
+  using Error = media::mojom::SpeechRecognitionErrorCode;
+  switch (reason) {
+    case static_cast<uint32_t>(Local::kNoSpeech):
+      Abort(Error::kNoSpeech);
+      return;
+    case static_cast<uint32_t>(Local::kAudioCapture):
+      Abort(Error::kAudioCapture);
+      return;
+    case static_cast<uint32_t>(Local::kNotAllowed):
+      Abort(Error::kNotAllowed);
+      return;
+    case static_cast<uint32_t>(Local::kServiceNotAllowed):
+      Abort(Error::kServiceNotAllowed);
+      return;
+    case static_cast<uint32_t>(Local::kLanguageNotSupported):
+      Abort(Error::kLanguageNotSupported);
+      return;
+    case static_cast<uint32_t>(Local::kPhrasesNotSupported):
+      Abort(Error::kPhrasesNotSupported);
+      return;
+    default:
+      Abort(Error::kAborted);
+  }
+}
