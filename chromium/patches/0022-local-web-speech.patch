+void StainlessLocalServicesHandler::SetSpeechLanguage(
+    const base::ListValue& args) {
+  if (!ValidateRequest(args, 2)) {
+    return;
+  }
+  auto* models = Models(web_ui());
+  if (!models || !args[1].is_string() || args[1].GetString().size() > 128) {
+    RejectJavascriptCallback(
+        args[0], base::Value("Choose a bounded supported speech language"));
+    return;
+  }
+  auto result = models->SetSpeechLanguage(args[1].GetString());
+  if (!result.has_value()) {
+    RejectJavascriptCallback(args[0], base::Value(result.error()));
+    return;
+  }
+  ResolveJavascriptCallback(args[0], models->Status());
+}
+
+void StainlessLocalServicesHandler::CancelLocalSession(
+    const base::ListValue& args) {
+  if (!ValidateRequest(args, 1)) {
+    return;
+  }
+  auto* models = Models(web_ui());
+  auto* profile = Profile::FromBrowserContext(
+      web_ui()->GetWebContents()->GetBrowserContext());
+  if (!models ||
+      !stainless_local::LocalBroker::Get().CancelSessionForProfile(profile)) {
+    RejectJavascriptCallback(
+        args[0], base::Value("This profile has no cancellable local session"));
+    return;
+  }
+  ResolveJavascriptCallback(args[0], models->Status());
+}
