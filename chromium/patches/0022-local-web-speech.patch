+LocalSpeechStream::LocalSpeechStream(
+    content::WeakDocumentPtr document,
+    Feature feature,
+    media::mojom::SpeechRecognitionOptionsPtr options,
+    mojo::PendingReceiver<media::mojom::SpeechRecognitionRecognizer> receiver,
+    mojo::PendingRemote<media::mojom::SpeechRecognitionRecognizerClient> client,
+    Report report,
+    base::RepeatingClosure limited,
+    base::OnceClosure dispose)
+    : document_(document),
+      feature_(feature),
+      options_(std::move(options)),
+      client_(std::move(client)),
+      report_(std::move(report)),
+      limited_(std::move(limited)),
+      dispose_(std::move(dispose)) {
+  receiver_.Bind(std::move(receiver));
+  receiver_.set_disconnect_handler(
+      base::BindOnce(&LocalSpeechStream::Disconnected, weak_.GetWeakPtr()));
+  client_.set_disconnect_handler(
+      base::BindOnce(&LocalSpeechStream::Disconnected, weak_.GetWeakPtr()));
+}
+
+LocalSpeechStream::~LocalSpeechStream() {
+  weak_.InvalidateWeakPtrs();
+  CancelWork();
+}
+
+bool LocalSpeechStream::Allowed() const {
+  auto* frame = document_.AsRenderFrameHostIfValid();
+  if (!IsLocalFeatureAllowed(frame, feature_)) {
+    return false;
+  }
+  return feature_ == Feature::kCaptions ||
+         (SpeechDocumentAllowed(frame) && SpeechMicrophoneGranted(frame) &&
+          content::WebContents::FromRenderFrameHost(frame)->GetVisibility() ==
+              content::Visibility::VISIBLE);
+}
+
+bool LocalSpeechStream::Begin() {
+  if (!Allowed()) {
+    auto* frame = document_.AsRenderFrameHostIfValid();
+    Fail(
+        !frame || content::WebContents::FromRenderFrameHost(frame)
+                          ->GetVisibility() != content::Visibility::VISIBLE
+            ? Reason::kAborted
+        : SpeechDocumentAllowed(frame) && !SpeechMicrophoneGranted(frame)
+            ? Reason::kNotAllowed
+            : Reason::kServiceNotAllowed,
+        "Local recognition lost microphone, feature or document authorization");
+    return false;
+  }
+  if (!options_ || options_->is_server_based ||
+      (feature_ == Feature::kSpeech && options_->enable_formatting) ||
+      options_->allow_multi_language ||
+      (options_->recognition_context &&
+       !options_->recognition_context->phrases.empty())) {
+    Fail(options_ && options_->recognition_context &&
+                 !options_->recognition_context->phrases.empty()
+             ? Reason::kPhrasesNotSupported
+             : Reason::kServiceNotAllowed,
+         "The selected local speech option is unsupported; no cloud fallback");
+    return false;
+  }
+  auto* frame = document_.AsRenderFrameHostIfValid();
+  const auto language = SelectedSpeechLanguage(
+      Profile::FromBrowserContext(frame->GetBrowserContext()),
+      options_->language.value_or(""));
+  if (!language) {
+    Fail(Reason::kLanguageNotSupported,
+         "The requested or profile speech language is unsupported");
+    return false;
+  }
+  language_ = *language;
+  auto reservation = LocalBroker::Get().ReserveSession(
+      frame, feature_,
+      base::BindOnce(
+          [](base::WeakPtr<LocalSpeechStream> stream, mojom::Status status) {
+            if (stream) {
+              stream->Fail(
+                  status == mojom::Status::kNotAllowed
+                      ? Reason::kServiceNotAllowed
+                      : Reason::kAborted,
+                  "The local streaming session stopped or lost authorization");
+            }
+          },
+          weak_.GetWeakPtr()));
+  if (!reservation.has_value()) {
+    Fail(Reason::kServiceNotAllowed,
+         "Local inference is busy or unavailable; use native Stop/Pause "
+         "controls");
+    return false;
+  }
+  reservation_ = *reservation;
+  started_ = base::TimeTicks::Now();
+  last_voice_ = started_;
+  monitor_.Start(FROM_HERE, base::Milliseconds(200), this,
+                 &LocalSpeechStream::Monitor);
+  report_.Run("Checking the consented local speech model", false);
+  auto* models =
+      LocalModels::Get(Profile::FromBrowserContext(frame->GetBrowserContext()));
+  if (!models) {
+    Fail(Reason::kServiceNotAllowed,
+         "The consented local speech model is unavailable");
+    return false;
+  }
+  models->AcquirePack(
+      "speech-multilingual", feature_,
+      base::BindOnce(&LocalSpeechStream::ModelChecked, weak_.GetWeakPtr()));
+  return !closed_;
+}
+
+void LocalSpeechStream::ModelChecked(
+    base::expected<model_storage::Acquired, std::string> acquired) {
+  if (closed_) {
+    return;
+  }
+  if (!acquired.has_value()) {
+    Fail(Reason::kServiceNotAllowed, acquired.error());
+    return;
+  }
+  acquired->Close(
+      base::BindOnce(&LocalSpeechStream::ModelReady, weak_.GetWeakPtr()));
+}
+
+void LocalSpeechStream::ModelReady() {
+  if (closed_) {
+    return;
+  }
+  model_ready_ = true;
+  report_.Run("Listening locally; no cloud fallback", false);
+  if (stopping_ && pcm_.empty()) {
+    NormalEnd();
+  } else if (stopping_ || (voiced_ && pcm_.size() >= kSegmentSamples)) {
+    Decode();
+  }
+}
+
+void LocalSpeechStream::SendAudioToSpeechRecognitionService(
+    media::mojom::AudioDataS16Ptr buffer,
+    std::optional<base::TimeDelta>) {
+  if (closed_ || stopping_) {
+    return;
+  }
+  if (started_.is_null() && !Begin()) {
+    return;
+  }
+  if (!Allowed()) {
+    Monitor();
+    return;
+  }
+  if (!buffer || buffer->sample_rate != 16000 || buffer->channel_count != 1 ||
+      buffer->frame_count <= 0 || buffer->frame_count > 16000 ||
+      buffer->data.size() != static_cast<size_t>(buffer->frame_count)) {
+    Fail(Reason::kAudioCapture,
+         "Local speech requires bounded 16 kHz mono PCM");
+    return;
+  }
+  if (buffer->data.size() > kPcmLimit - in_flight_samples_ - pcm_.size()) {
+    Fail(Reason::kAborted,
+         "Local recognition cannot keep up; the 30-second PCM buffer is full");
+    return;
+  }
+  auto voice = ContainsSpeech(buffer->data);
+  if (!voice.has_value()) {
+    Fail(Reason::kAudioCapture, voice.error());
+    return;
+  }
+  if (*voice) {
+    last_voice_ = base::TimeTicks::Now();
+    voiced_ = true;
+  }
+  if (pcm_.empty()) {
+    first_sample_ = input_samples_;
+  }
+  input_samples_ += buffer->data.size();
+  pcm_.insert(pcm_.end(), buffer->data.begin(), buffer->data.end());
+  if (!voiced_ && pcm_.size() > 8000) {
+    first_sample_ += pcm_.size() - 8000;
+    pcm_.erase(pcm_.begin(), pcm_.end() - 8000);
+  }
+  if (!in_flight_samples_ && voiced_ &&
+      (pcm_.size() >= kSegmentSamples ||
+       base::TimeTicks::Now() - last_voice_ >= base::Milliseconds(500))) {
+    Decode();
+  }
+}
+
+void LocalSpeechStream::Decode() {
+  if (closed_ || !model_ready_ || in_flight_samples_ || pcm_.empty()) {
+    return;
+  }
+  if (!Allowed()) {
+    Monitor();
+    return;
+  }
+  if (!voiced_) {
+    pcm_.clear();
+    if (stopping_) {
+      NormalEnd();
+    }
+    return;
+  }
+  auto* frame = document_.AsRenderFrameHostIfValid();
+  auto* models =
+      LocalModels::Get(Profile::FromBrowserContext(frame->GetBrowserContext()));
+  if (!models) {
+    Fail(Reason::kServiceNotAllowed,
+         "Local speech models are unavailable in this mode");
+    return;
+  }
+  in_flight_samples_ = pcm_.size();
+  voiced_ = false;
+  auto pcm = std::exchange(pcm_, {});
+  const size_t count = pcm.size();
+  report_.Run("Recognizing local audio", false);
+  job_ = LocalBroker::Get().Submit(
+      frame, feature_,
+      base::BindOnce(
+          [](base::WeakPtr<LocalModels> models,
+             content::WeakDocumentPtr document, Feature feature,
+             std::vector<int16_t> pcm, std::string language,
+             LocalBroker::Ready ready) {
+            if (!models || !document.AsRenderFrameHostIfValid()) {
+              LocalBroker::Prepared prepared;
+              prepared.error =
+                  "The speech document changed before model admission";
+              std::move(ready).Run(std::move(prepared));
+              return;
+            }
+            models->AcquirePack(
+                "speech-multilingual", feature,
+                base::BindOnce(
+                    [](content::WeakDocumentPtr document,
+                       std::vector<int16_t> pcm, std::string language,
+                       LocalBroker::Ready ready,
+                       base::expected<model_storage::Acquired, std::string>
+                           acquired) {
+                      LocalBroker::Prepared prepared;
+                      if (!acquired.has_value() ||
+                          !document.AsRenderFrameHostIfValid()) {
+                        prepared.error =
+                            acquired.has_value()
+                                ? "The local speech document changed"
+                                : acquired.error();
+                        std::move(ready).Run(std::move(prepared));
+                        return;
+                      }
+                      auto request = mojom::SpeechRequest::New();
+                      for (auto& file : acquired->files) {
+                        if (file->name == "model.bin") {
+                          request->model = std::move(file);
+                          break;
+                        }
+                      }
+                      request->language = std::move(language);
+                      request->pcm = std::move(pcm);
+                      prepared.leases = std::move(acquired->leases);
+                      if (!request->model) {
+                        prepared.error =
+                            "The verified speech pack is missing its model";
+                      } else {
+                        prepared.request =
+                            mojom::Request::NewSpeech(std::move(request));
+                      }
+                      std::move(ready).Run(std::move(prepared));
+                    },
+                    document, std::move(pcm), std::move(language),
+                    std::move(ready)));
+          },
+          models->GetWeakPtr(), document_, feature_, std::move(pcm), language_),
+      base::BindOnce(&LocalSpeechStream::Decoded, weak_.GetWeakPtr(), count,
+                     first_sample_),
+      reservation_);
+}
+
+void LocalSpeechStream::Decoded(size_t samples,
+                                uint64_t first_sample,
+                                mojom::ResultPtr result) {
+  job_ = {};
+  in_flight_samples_ = 0;
+  if (closed_ || !Allowed()) {
+    Monitor();
+    return;
+  }
+  if (!result || (result->status != mojom::Status::kOk &&
+                  result->status != mojom::Status::kNoSpeech)) {
+    const bool aborted =
+        result && (result->status == mojom::Status::kCancelled ||
+                   result->status == mojom::Status::kResourceLimit ||
+                   result->status == mojom::Status::kTimedOut ||
+                   result->status == mojom::Status::kFailed);
+    Fail(aborted ? Reason::kAborted : Reason::kServiceNotAllowed,
+         result && !result->detail.empty() ? result->detail
+                                           : "Local speech inference failed");
+    return;
+  }
+  if (result->status == mojom::Status::kOk) {
+    auto text = feature_ == Feature::kSpeech
+                    ? UnformatSpeechTranscript(result->text)
+                    : std::move(result->text);
+    if (!text.empty()) {
+      media::SpeechRecognitionResult transcription(text, true);
+      transcription.confidence =
+          static_cast<float>(std::exp(result->speech->average_log_probability));
+      media::TimingInformation timing;
+      timing.audio_start_time =
+          base::Microseconds(first_sample * 1000000 / 16000);
+      timing.audio_end_time =
+          base::Microseconds((first_sample + samples) * 1000000 / 16000);
+      transcription.timing_information = std::move(timing);
+      client_->OnSpeechRecognitionRecognitionEvent(
+          transcription,
+          base::BindOnce(
+              [](base::WeakPtr<LocalSpeechStream> stream, bool keep) {
+                if (stream && !keep) {
+                  stream->Disconnected();
+                }
+              },
+              weak_.GetWeakPtr()));
+    }
+  }
+  report_.Run(
+      stopping_ ? "Finishing admitted local audio" : "Listening locally",
+      false);
+  if (stopping_ && pcm_.empty()) {
+    NormalEnd();
+  } else if (stopping_ || pcm_.size() >= kSegmentSamples) {
+    Decode();
+  }
+}
+
+void LocalSpeechStream::MarkDone() {
+  if (closed_ || stopping_) {
+    return;
+  }
+  stopping_ = true;
+  if (in_flight_samples_) {
+    return;
+  }
+  if (pcm_.empty()) {
+    NormalEnd();
+  } else {
+    Decode();
+  }
+}
+
+void LocalSpeechStream::OnLanguageChanged(const std::string& language) {
+  if (!closed_ && language != options_->language.value_or("")) {
+    Fail(Reason::kServiceNotAllowed,
+         "Stop the local session before changing its speech language");
+  }
+}
+
+void LocalSpeechStream::OnMaskOffensiveWordsChanged(bool mask) {
+  if (mask && !closed_) {
+    Fail(Reason::kServiceNotAllowed,
+         "Local speech does not implement offensive-word masking");
+  }
+}
+
+void LocalSpeechStream::UpdateRecognitionContext(
+    const media::SpeechRecognitionRecognitionContext& context) {
+  if (!closed_ && !context.phrases.empty()) {
+    Fail(Reason::kPhrasesNotSupported,
+         "Local speech does not implement contextual phrases");
+  }
+}
+
+void LocalSpeechStream::Monitor() {
+  if (closed_) {
+    return;
+  }
+  auto* frame = document_.AsRenderFrameHostIfValid();
+  if (!frame ||
+      (feature_ == Feature::kSpeech &&
+       content::WebContents::FromRenderFrameHost(frame)->GetVisibility() !=
+           content::Visibility::VISIBLE)) {
+    Fail(Reason::kAborted, "The speech document was hidden or destroyed");
+    return;
+  }
+  if (feature_ == Feature::kSpeech && !SpeechMicrophoneGranted(frame)) {
+    Fail(Reason::kNotAllowed, "The microphone permission was revoked");
+    return;
+  }
+  if (!Allowed()) {
+    Fail(Reason::kServiceNotAllowed,
+         "The local speech feature or policy was disabled");
+    return;
+  }
+  if (!started_.is_null() &&
+      base::TimeTicks::Now() - started_ >= base::Minutes(5)) {
+    limited_.Run();
+    Fail(Reason::kAborted,
+         "The five-minute speech session ended; a new user activation is "
+         "required");
+  } else if (!stopping_ && !last_voice_.is_null() &&
+             base::TimeTicks::Now() - last_voice_ >= base::Seconds(30)) {
+    limited_.Run();
+    Fail(Reason::kNoSpeech, "No speech was detected for thirty seconds");
+  }
+}
+
+void LocalSpeechStream::CancelWork() {
+  monitor_.Stop();
+  const auto job = std::exchange(job_, {});
+  if (!job.is_empty()) {
+    LocalBroker::Get().Cancel(job);
+  }
+  const auto reservation = std::exchange(reservation_, {});
+  if (!reservation.is_empty()) {
+    LocalBroker::Get().ReleaseSession(reservation);
+  }
+  std::ranges::fill(pcm_, 0);
+  pcm_.clear();
+  in_flight_samples_ = 0;
+}
+
+void LocalSpeechStream::NormalEnd() {
+  if (closed_) {
+    return;
+  }
+  closed_ = true;
+  CancelWork();
+  report_.Run("Local speech stopped", false);
+  client_->OnSpeechRecognitionStopped();
+}
+
+void LocalSpeechStream::Fail(Reason reason, const std::string& diagnostic) {
+  if (closed_) {
+    return;
+  }
+  closed_ = true;
+  weak_.InvalidateWeakPtrs();
+  CancelWork();
+  LOG(ERROR) << "Stainless local speech: bounded session stopped";
+  report_.Run(diagnostic, true);
+  receiver_.ResetWithReason(static_cast<uint32_t>(reason), diagnostic);
+  if (dispose_) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, std::move(dispose_));
+  }
+}
+
+void LocalSpeechStream::Disconnected() {
+  if (!closed_) {
+    closed_ = true;
+    weak_.InvalidateWeakPtrs();
+    CancelWork();
+    report_.Run("Local speech aborted", false);
+  }
+  if (dispose_) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, std::move(dispose_));
+  }
+}
+
+}  // namespace stainless_local
