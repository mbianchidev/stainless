+void SpeechRecognition::RejectLocalStart(
+    media::mojom::blink::SpeechRecognitionErrorCode error,
+    const String& diagnostic) {
+  started_ = true;
+  stopping_ = false;
+  GetExecutionContext()
+      ->GetTaskRunner(TaskType::kMiscPlatformAPI)
+      ->PostTask(
+          FROM_HERE,
+          BindOnce(
+              [](SpeechRecognition* recognition,
+                 media::mojom::blink::SpeechRecognitionErrorCode error,
+                 String diagnostic) {
+                if (!recognition || !recognition->GetExecutionContext() ||
+                    !recognition->started_) {
+                  return;
+                }
+                recognition->DispatchEvent(
+                    *SpeechRecognitionErrorEvent::Create(error, diagnostic));
+                recognition->Ended();
+              },
+              WrapWeakPersistent(this), error, diagnostic));
+}
