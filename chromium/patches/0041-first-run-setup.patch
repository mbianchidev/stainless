@@ -0,0 +1,261 @@
+// Copyright 2026 Synctune Open
+
+#include "chrome/browser/ui/views/stainless_onboarding_view.h"
+
+#include <optional>
+#include <utility>
+
+#include "base/functional/bind.h"
