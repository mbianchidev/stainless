+// import dialog. Skip changes nothing, which keeps DuckDuckGo search.
+class StainlessOnboardingView : public views::View,
+                                public TemplateURLServiceObserver {
+  METADATA_HEADER(StainlessOnboardingView, views::View)
+
+ public:
+  // Shows the dialog over a normal, regular-profile window. Returns nullptr
