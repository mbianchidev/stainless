+#include "components/password_manager/core/common/password_manager_pref_names.h"
+#include "components/prefs/pref_service.h"
+#include "components/search_engines/template_url.h"
+#include "ui/base/l10n/l10n_util.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/base/models/simple_combobox_model.h"
+#include "ui/base/mojom/dialog_button.mojom.h"
+#include "ui/base/mojom/ui_base_types.mojom-shared.h"
+#include "ui/gfx/text_constants.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/controls/button/checkbox.h"
+#include "ui/views/controls/button/md_text_button.h"
+#include "ui/views/controls/combobox/combobox.h"
+#include "ui/views/controls/label.h"
+#include "ui/views/layout/box_layout.h"
+#include "ui/views/style/typography.h"
+#include "ui/views/widget/widget.h"
+#include "ui/views/window/dialog_delegate.h"
+
+namespace {
+
+std::u16string Text(int message_id) {
+  return l10n_util::GetStringUTF16(message_id);
+}
+
+bool CanOwn(BrowserWindowInterface* browser) {
+  if (!browser || browser->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+    return false;
+  }
+  Profile* profile = browser->GetProfile();
+  if (!profile || profile->IsOffTheRecord() || profile->IsGuestSession() ||
+      profile->IsSystemProfile()) {
+    return false;
+  }
+  auto* owner = BrowserView::GetBrowserViewForBrowser(browser);
+  return owner && owner->GetWidget() && !owner->GetWidget()->IsClosed();
+}
+
+views::Label* AddLabel(views::View* parent, int message_id, bool heading) {
+  auto* label = parent->AddChildView(std::make_unique<views::Label>(
+      Text(message_id), heading ? views::style::CONTEXT_DIALOG_BODY_TEXT
+                                : views::style::CONTEXT_LABEL,
+      heading ? views::style::STYLE_EMPHASIZED : views::style::STYLE_PRIMARY));
+  label->SetMultiLine(true);
+  label->SetHorizontalAlignment(gfx::HorizontalAlignment::ALIGN_LEFT);
+  return label;
+}
+
+}  // namespace
+
+// static
+views::Widget* StainlessOnboardingView::Show(BrowserWindowInterface* browser) {
+  if (!CanOwn(browser)) {
+    LOG(WARNING) << "Stainless setup needs a live normal window of a regular "
+                    "profile; open one and retry";
+    return nullptr;
+  }
+  auto contents = std::make_unique<StainlessOnboardingView>(browser);
+  StainlessOnboardingView* view = contents.get();
+  auto dialog = std::make_unique<views::DialogDelegate>();
+  dialog->SetTitle(Text(IDS_STAINLESS_ONBOARDING_TITLE));
+  dialog->SetModalType(ui::mojom::ModalType::kWindow);
+  dialog->SetButtonLabel(ui::mojom::DialogButton::kOk,
+                         Text(IDS_STAINLESS_ONBOARDING_SAVE));
+  dialog->SetButtonLabel(ui::mojom::DialogButton::kCancel,
+                         Text(IDS_STAINLESS_ONBOARDING_SKIP));
+  dialog->SetDefaultButton(static_cast<int>(ui::mojom::DialogButton::kOk));
+  dialog->SetAcceptCallback(base::BindOnce(&StainlessOnboardingView::Apply,
+                                           view->weak_factory_.GetWeakPtr()));
+  dialog->SetExtraView(std::make_unique<views::MdTextButton>(
+      base::BindRepeating(&StainlessOnboardingView::SaveAndReviewImport,
+                          view->weak_factory_.GetWeakPtr()),
+      Text(IDS_STAINLESS_ONBOARDING_IMPORT_BUTTON)));
+  dialog->set_fixed_width(ChromeLayoutProvider::Get()->GetDistanceMetric(
+      views::DISTANCE_MODAL_DIALOG_PREFERRED_WIDTH));
+  dialog->set_margins(ChromeLayoutProvider::Get()->GetDialogInsetsForContentType(
+      views::DialogContentType::kText, views::DialogContentType::kControl));
+  dialog->SetInitiallyFocusedView(view->search_);
+  dialog->SetContentsView(std::move(contents));
+  auto* widget = views::DialogDelegate::CreateDialogWidget(
+      std::move(dialog), gfx::NativeWindow(),
+      BrowserView::GetBrowserViewForBrowser(browser)
+          ->GetWidget()
+          ->GetNativeView());
+  widget->Show();
+  return widget;
+}
+
+StainlessOnboardingView::StainlessOnboardingView(
+    BrowserWindowInterface* browser)
+    : browser_(browser->GetWeakPtr()), profile_(browser->GetProfile()) {
+  const auto* layout = ChromeLayoutProvider::Get();
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(),
+      layout->GetDistanceMetric(views::DISTANCE_RELATED_CONTROL_VERTICAL)));
+
+  AddLabel(this, IDS_STAINLESS_ONBOARDING_INTRO, /*heading=*/false);
+
+  AddLabel(this, IDS_STAINLESS_ONBOARDING_SEARCH, /*heading=*/true);
+  search_model_ = std::make_unique<ui::SimpleComboboxModel>(
+      std::vector<ui::SimpleComboboxModel::Item>());
+  search_ = AddChildView(std::make_unique<views::Combobox>(search_model_.get()));
+  search_->GetViewAccessibility().SetName(
+      Text(IDS_STAINLESS_ONBOARDING_SEARCH));
+
+  AddLabel(this, IDS_STAINLESS_ONBOARDING_PRIVACY, /*heading=*/true);
+  PrefService* local_state = g_browser_process->local_state();
+  threats_ = AddChildView(std::make_unique<views::Checkbox>(
+      Text(IDS_STAINLESS_ONBOARDING_THREATS)));
+  threats_->SetChecked(
+      local_state->GetBoolean(stainless_threats::kThreatProtectionEnabled));
+  threats_->SetEnabled(local_state->IsUserModifiablePreference(
+      stainless_threats::kThreatProtectionEnabled));
+  threats_->SetMultiLine(true);
+
+  PrefService* prefs = profile_->GetPrefs();
+  breaches_ = AddChildView(std::make_unique<views::Checkbox>(
+      Text(IDS_STAINLESS_ONBOARDING_BREACHES)));
+  breaches_->SetChecked(
+      prefs->GetBoolean(password_manager::prefs::kPasswordLeakDetectionEnabled));
+  breaches_->SetEnabled(prefs->IsUserModifiablePreference(
+      password_manager::prefs::kPasswordLeakDetectionEnabled));
+  breaches_->SetMultiLine(true);
+
+  default_browser_ = AddChildView(std::make_unique<views::Checkbox>(
+      Text(IDS_STAINLESS_ONBOARDING_DEFAULT_BROWSER)));
+  default_browser_->SetMultiLine(true);
+
+  AddLabel(this, IDS_STAINLESS_ONBOARDING_DATA, /*heading=*/true);
+  AddLabel(this, IDS_STAINLESS_ONBOARDING_IMPORT_TEXT, /*heading=*/false);
+  AddLabel(this, IDS_STAINLESS_ONBOARDING_LOCAL_SERVICES, /*heading=*/false);
+
+  if (auto* service = TemplateURLServiceFactory::GetForProfile(profile_)) {
+    search_observation_.Observe(service);
+    if (!service->loaded()) {
+      service->Load();
+    }
+  }
+  RefreshSearchEngines();
+}
+
+StainlessOnboardingView::~StainlessOnboardingView() = default;
+
+void StainlessOnboardingView::OnTemplateURLServiceChanged() {
+  RefreshSearchEngines();
+}
+
+void StainlessOnboardingView::OnTemplateURLServiceShuttingDown() {
+  search_observation_.Reset();
+  RefreshSearchEngines();
+}
+
+void StainlessOnboardingView::RefreshSearchEngines() {
+  TemplateURLService* service = search_observation_.GetSource();
+  std::u16string selected;
+  if (std::optional<size_t> index = search_->GetSelectedIndex();
+      index && *index < engine_keywords_.size()) {
+    selected = engine_keywords_[*index];
+  }
+  engine_keywords_.clear();
+  std::vector<ui::SimpleComboboxModel::Item> items;
+  std::optional<size_t> selected_index;
+  if (service && service->loaded()) {
+    const TemplateURL* current = service->GetDefaultSearchProvider();
+    if (selected.empty() && current) {
+      selected = current->keyword();
+    }
+    for (TemplateURL* engine : service->GetTemplateURLs()) {
+      if (engine != current &&
+          (engine->prepopulate_id() <= 0 || !service->CanMakeDefault(engine))) {
+        continue;
+      }
+      if (engine->keyword() == selected) {
+        selected_index = engine_keywords_.size();
+      }
+      engine_keywords_.push_back(engine->keyword());
+      items.emplace_back(engine->short_name());
+    }
+  }
+  search_model_->UpdateItemList(std::move(items));
+  search_->SetSelectedIndex(selected_index);
+  search_->SetEnabled(service && service->loaded() &&
+                      !service->is_default_search_managed() &&
+                      !engine_keywords_.empty());
+}
+
+void StainlessOnboardingView::Apply() {
+  TemplateURLService* service = search_observation_.GetSource();
+  std::optional<size_t> index = search_->GetSelectedIndex();
+  if (service && service->loaded() && search_->GetEnabled() && index &&
+      *index < engine_keywords_.size()) {
+    TemplateURL* engine =
+        service->GetTemplateURLForKeyword(engine_keywords_[*index]);
+    if (engine && engine != service->GetDefaultSearchProvider() &&
+        service->CanMakeDefault(engine)) {
+      service->SetUserSelectedDefaultSearchProvider(engine);
+    }
+  }
+  PrefService* local_state = g_browser_process->local_state();
+  if (threats_->GetEnabled() &&
+      local_state->GetBoolean(stainless_threats::kThreatProtectionEnabled) !=
+          threats_->GetChecked()) {
+    local_state->SetBoolean(stainless_threats::kThreatProtectionEnabled,
+                            threats_->GetChecked());
+  }
+  PrefService* prefs = profile_->GetPrefs();
+  if (breaches_->GetEnabled() &&
+      prefs->GetBoolean(
+          password_manager::prefs::kPasswordLeakDetectionEnabled) !=
+          breaches_->GetChecked()) {
+    prefs->SetBoolean(password_manager::prefs::kPasswordLeakDetectionEnabled,
+                      breaches_->GetChecked());
+  }
+  if (default_browser_->GetChecked()) {
+    base::MakeRefCounted<shell_integration::DefaultBrowserWorker>()
+        ->StartSetAsDefault(base::DoNothing());
+  }
+}
+
+void StainlessOnboardingView::SaveAndReviewImport() {
+  Apply();
+  base::WeakPtr<BrowserWindowInterface> browser = browser_;
+  GetWidget()->Close();
+  if (browser) {
+    chrome::ShowSettingsSubPage(browser.get(), chrome::kImportDataSubPage);
+  }
+}
+
+namespace chrome {
+
+void ShowStainlessOnboarding(BrowserWindowInterface* browser) {
+  StainlessOnboardingView::Show(browser);
+}
+
+}  // namespace chrome
+
+BEGIN_METADATA(StainlessOnboardingView)
+END_METADATA
