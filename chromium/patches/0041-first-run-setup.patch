+  void RefreshSearchEngines();
+  // Applies only the controls whose value differs from the current setting.
+  void Apply();
+  void SaveAndReviewImport();
+
+  base::WeakPtr<BrowserWindowInterface> browser_;
+  raw_ptr<Profile> profile_;
+  // Keywords of the selectable prepopulated engines, in combobox order.
+  std::vector<std::u16string> engine_keywords_;
+  std::unique_ptr<ui::SimpleComboboxModel> search_model_;
+  raw_ptr<views::Combobox> search_ = nullptr;
+  raw_ptr<views::Checkbox> threats_ = nullptr;
+  raw_ptr<views::Checkbox> breaches_ = nullptr;
+  raw_ptr<views::Checkbox> default_browser_ = nullptr;
+  base::ScopedObservation<TemplateURLService, TemplateURLServiceObserver>
+      search_observation_{this};
+  base::WeakPtrFactory<StainlessOnboardingView> weak_factory_{this};
+};
