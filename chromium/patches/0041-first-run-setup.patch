diff --git a/chrome/browser/ui/views/stainless_onboarding_browsertest.cc b/chrome/browser/ui/views/stainless_onboarding_browsertest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..63fdb35c4b9f339880a9ea637fb50285db6638a3
--- /dev/null
+++ b/chrome/browser/ui/views/stainless_onboarding_browsertest.cc
@@ -0,0 +1,167 @@
+// Copyright 2026 Synctune Open
+
+#include "chrome/browser/ui/views/stainless_onboarding_view.h"
+
+#include <optional>
+#include <string>
+
+#include "base/command_line.h"
+#include "base/run_loop.h"
+#include "base/test/run_until.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/search_engines/template_url_service_factory.h"
+#include "chrome/browser/stainless_threats/threat_protection_prefs.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/startup/infobar_utils.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/search_test_utils.h"
+#include "components/password_manager/core/common/password_manager_pref_names.h"
+#include "components/prefs/pref_service.h"
+#include "components/search_engines/template_url.h"
+#include "components/search_engines/template_url_service.h"
+#include "content/public/test/browser_test.h"
+#include "ui/views/controls/button/checkbox.h"
+#include "ui/views/controls/combobox/combobox.h"
+#include "ui/views/view_utils.h"
+#include "ui/views/widget/widget.h"
+#include "ui/views/window/dialog_delegate.h"
+
+class StainlessOnboardingBrowserTest : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    search_test_utils::WaitForTemplateURLServiceToLoad(search_engines());
+  }
+
+  TemplateURLService* search_engines() {
+    return TemplateURLServiceFactory::GetForProfile(browser()->GetProfile());
+  }
+
+  views::Widget* FindSetup(BrowserWindowInterface* browser) {
+    auto* owner = BrowserView::GetBrowserViewForBrowser(browser);
+    for (views::Widget* widget : views::Widget::GetAllOwnedWidgets(
+             owner->GetWidget()->GetNativeView())) {
+      if (!widget->IsClosed() && widget->widget_delegate() &&
+          views::IsViewClass<StainlessOnboardingView>(
+              widget->widget_delegate()->GetContentsView())) {
+        return widget;
+      }
+    }
+    return nullptr;
+  }
+
+  StainlessOnboardingView* SetupView(views::Widget* widget) {
+    return views::AsViewClass<StainlessOnboardingView>(
+        widget->widget_delegate()->GetContentsView());
+  }
+
+  views::Combobox* search(StainlessOnboardingView* view) {
+    return view->search_;
+  }
+  views::Checkbox* threats(StainlessOnboardingView* view) {
+    return view->threats_;
+  }
+  views::Checkbox* breaches(StainlessOnboardingView* view) {
+    return view->breaches_;
+  }
+  views::Checkbox* default_browser(StainlessOnboardingView* view) {
+    return view->default_browser_;
+  }
+  const std::vector<std::u16string>& keywords(StainlessOnboardingView* view) {
+    return view->engine_keywords_;
+  }
+
+  bool ThreatsEnabled() {
+    return g_browser_process->local_state()->GetBoolean(
+        stainless_threats::kThreatProtectionEnabled);
+  }
+  bool BreachChecksEnabled() {
+    return browser()->GetProfile()->GetPrefs()->GetBoolean(
+        password_manager::prefs::kPasswordLeakDetectionEnabled);
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(StainlessOnboardingBrowserTest,
+                       SkipKeepsDuckDuckGoAndChangesNothing) {
+  ASSERT_EQ(u"DuckDuckGo",
+            search_engines()->GetDefaultSearchProvider()->short_name());
+  const bool threats_before = ThreatsEnabled();
+  views::Widget* widget = StainlessOnboardingView::Show(browser());
+  ASSERT_TRUE(widget);
+  StainlessOnboardingView* view = SetupView(widget);
+  ASSERT_TRUE(search(view)->GetSelectedIndex());
+  EXPECT_EQ(search_engines()->GetDefaultSearchProvider()->keyword(),
+            keywords(view)[*search(view)->GetSelectedIndex()]);
+  EXPECT_EQ(threats_before, threats(view)->GetChecked());
+  EXPECT_FALSE(breaches(view)->GetChecked());
+  EXPECT_FALSE(default_browser(view)->GetChecked());
+
+  // Skip, even after changing controls, applies nothing.
+  threats(view)->SetChecked(!threats_before);
+  breaches(view)->SetChecked(true);
+  widget->widget_delegate()->AsDialogDelegate()->CancelDialog();
+  ASSERT_TRUE(base::test::RunUntil([&] { return !FindSetup(browser()); }));
+  EXPECT_EQ(u"DuckDuckGo",
+            search_engines()->GetDefaultSearchProvider()->short_name());
+  EXPECT_EQ(threats_before, ThreatsEnabled());
+  EXPECT_FALSE(BreachChecksEnabled());
+}
+
+IN_PROC_BROWSER_TEST_F(StainlessOnboardingBrowserTest,
+                       SaveAppliesOnlyTheChosenSettings) {
+  views::Widget* widget = StainlessOnboardingView::Show(browser());
+  ASSERT_TRUE(widget);
+  StainlessOnboardingView* view = SetupView(widget);
+  ASSERT_GT(keywords(view).size(), 1u);
+  const std::u16string current =
+      search_engines()->GetDefaultSearchProvider()->keyword();
+  std::optional<size_t> other;
+  for (size_t i = 0; i < keywords(view).size(); ++i) {
+    if (keywords(view)[i] != current) {
+      other = i;
+      break;
+    }
+  }
+  ASSERT_TRUE(other);
+  search(view)->SetSelectedIndex(*other);
+  const bool threats_before = ThreatsEnabled();
+  threats(view)->SetChecked(!threats_before);
+  breaches(view)->SetChecked(true);
+  widget->widget_delegate()->AsDialogDelegate()->AcceptDialog();
+  ASSERT_TRUE(base::test::RunUntil([&] { return !FindSetup(browser()); }));
+
+  EXPECT_NE(current, search_engines()->GetDefaultSearchProvider()->keyword());
+  EXPECT_EQ(!threats_before, ThreatsEnabled());
+  EXPECT_TRUE(BreachChecksEnabled());
+}
+
+IN_PROC_BROWSER_TEST_F(StainlessOnboardingBrowserTest,
+                       OffersSetupOnlyOnFirstRun) {
+  const base::CommandLine& command_line =
+      *base::CommandLine::ForCurrentProcess();
+  AddInfoBarsIfNecessary(browser(), browser()->GetProfile(), command_line,
+                         chrome::startup::IsFirstRun::kNo, false, false,
+                         false);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_FALSE(FindSetup(browser()));
+
+  AddInfoBarsIfNecessary(browser(), browser()->GetProfile(), command_line,
+                         chrome::startup::IsFirstRun::kYes, false, false,
+                         false);
+  ASSERT_TRUE(base::test::RunUntil([&] { return FindSetup(browser()); }));
+  FindSetup(browser())->widget_delegate()->AsDialogDelegate()->CancelDialog();
+}
+
+IN_PROC_BROWSER_TEST_F(StainlessOnboardingBrowserTest,
+                       PrivateWindowsCannotOwnSetup) {
+  BrowserWindowInterface* incognito = CreateIncognitoBrowser();
+  EXPECT_FALSE(StainlessOnboardingView::Show(incognito));
+  AddInfoBarsIfNecessary(incognito, incognito->GetProfile(),
+                         *base::CommandLine::ForCurrentProcess(),
+                         chrome::startup::IsFirstRun::kYes, false, false,
+                         false);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_FALSE(FindSetup(incognito));
+}
