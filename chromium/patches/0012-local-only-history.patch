+IN_PROC_BROWSER_TEST_F(StainlessHistoryPrivacyBrowserTest,
+                       DiagnosticUploadsHaveNoBackendOrConsentOverride) {
+  static base::NoDestructor<ChromeCrashReporterClient> crash_client;
+  EXPECT_FALSE(crash_client->GetCollectStatsConsent());
+  EXPECT_TRUE(crash_client->GetUploadUrl().empty());
+  bool crash_uploads = true;
+  EXPECT_TRUE(crash_client->ReportingIsEnforcedByPolicy(&crash_uploads));
+  EXPECT_FALSE(crash_uploads);
+  EXPECT_EQ(nullptr,
+            feedback::FeedbackUploaderFactoryChrome::GetForBrowserContext(
+                browser()->GetProfile()));
+  auto feedback_function =
+      base::MakeRefCounted<extensions::FeedbackPrivateSendFeedbackFunction>();
+  const auto error = extensions::api_test_utils::RunFunctionAndReturnError(
+      feedback_function, std::string(R"JSON([{
+        "description": "Fictional diagnostic fixture",
+        "pageUrl": "http://fictional-history.invalid/saved-before-restart",
+        "sendTabTitles": true,
+        "sendHistograms": true
+      }, true])JSON"),
+      browser()->GetProfile());
+  EXPECT_EQ(
+      "Feedback uploads are unavailable in this browser. "
+      "No diagnostic data was collected or sent.",
+      error);
+  TestingPrefServiceSimple preferences;
+  preferences.registry()->RegisterBooleanPref(
+      metrics::prefs::kMetricsReportingEnabled, true);
+  ChromeTracingDelegate tracing(preferences);
+  EXPECT_FALSE(tracing.IsRecordingAllowed(
+      content::TracingDelegate::IsLocalScenario(false),
+      base::TimeTicks::Now()));
+  EXPECT_TRUE(tracing.IsRecordingAllowed(
+      content::TracingDelegate::IsLocalScenario(true), base::TimeTicks::Now()));
+  auto* incognito = CreateIncognitoBrowser(browser()->GetProfile());
+  EXPECT_EQ(nullptr,
+            WebHistoryServiceFactory::GetForProfile(incognito->GetProfile()));
+  EXPECT_EQ(nullptr,
+            feedback::FeedbackUploaderFactoryChrome::GetForBrowserContext(
+                incognito->GetProfile()));
+  CloseBrowserSynchronously(incognito);
+  CheckReportingDisabled();
+}
