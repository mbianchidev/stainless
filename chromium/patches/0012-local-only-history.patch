+class StainlessHistoryPrivacyBrowserTest : public InProcessBrowserTest {
+ public:
+  void SetUp() override {
+    embedded_test_server()->RegisterRequestHandler(
+        base::BindRepeating(&StainlessHistoryPrivacyBrowserTest::HandleRequest,
+                            base::Unretained(this)));
+    ASSERT_TRUE(embedded_test_server()->InitializeAndListen());
+    InProcessBrowserTest::SetUp();
+  }
+
+  void SetUpCommandLine(base::CommandLine* command) override {
+    command->AppendSwitchASCII("headless", "new");
+    command->AppendSwitch("use-mock-keychain");
+    command->RemoveSwitch("metrics-recording-only");
+    command->AppendSwitchASCII("lang", "en-US");
+    command->AppendSwitch("force-enable-metrics-reporting");
+    command->AppendSwitch("enable-experimental-extension-apis");
+    command->AppendSwitchASCII(
+        "uma-server-url",
+        embedded_test_server()->GetURL("/diagnostics/uma").spec());
+    command->AppendSwitchASCII(
+        "uma-insecure-server-url",
+        embedded_test_server()->GetURL("/diagnostics/insecure").spec());
+    command->AppendSwitchASCII(
+        "ukm-server-url",
+        embedded_test_server()->GetURL("/diagnostics/ukm").spec());
+  }
+
+  void SetUpOnMainThread() override {
+    ASSERT_TRUE(display::Screen::Get()->IsHeadless());
+    embedded_test_server()->StartAcceptingConnections();
+    browser()->GetProfile()->GetPrefs()->SetBoolean(
+        prefs::kExtensionsUIDeveloperMode, true);
+  }
+
+  void TearDownOnMainThread() override {
+    ASSERT_TRUE(embedded_test_server()->ShutdownAndWaitUntilComplete());
+  }
+
+  std::unique_ptr<net::test_server::HttpResponse> HandleRequest(
+      const net::test_server::HttpRequest& request) {
+    if (request.relative_url.starts_with("/diagnostics/")) {
+      ++diagnostic_requests_;
+    }
+    if (request.relative_url == "/second") {
+      base::AutoLock lock(referrer_lock_);
+      auto header = request.headers.find("Referer");
+      referrer_ = header == request.headers.end() ? "" : header->second;
+    }
+    auto response = std::make_unique<net::test_server::BasicHttpResponse>();
+    response->set_code(net::HTTP_OK);
+    response->set_content_type("text/html");
+    response->set_content(
+        "<title>Fictional local history</title>"
+        "<a id='next' href='/second'>Next fictional page</a>");
+    return response;
+  }
+
+  history::QueryURLAndVisitsResult Query(const GURL& url) {
+    base::CancelableTaskTracker tracker;
+    base::test::TestFuture<history::QueryURLAndVisitsResult> result;
+    HistoryServiceFactory::GetForProfile(browser()->GetProfile(),
+                                         ServiceAccessType::EXPLICIT_ACCESS)
+        ->QueryURLAndVisits(url, history::VisitQuery404sPolicy::kInclude404s,
+                            result.GetCallback(), &tracker);
+    return result.Take();
+  }
+
+  std::string Referrer() {
+    base::AutoLock lock(referrer_lock_);
+    return referrer_;
+  }
+
+  void FlushHistory() {
+    base::test::TestFuture<void> flushed;
+    HistoryServiceFactory::GetForProfile(browser()->GetProfile(),
+                                         ServiceAccessType::EXPLICIT_ACCESS)
+        ->FlushForTest(flushed.GetCallback());
+    ASSERT_TRUE(flushed.Wait());
+  }
+
+  void CheckReportingDisabled() {
+    auto* manager = g_browser_process->GetMetricsServicesManager();
+    ASSERT_TRUE(manager);
+    g_browser_process->local_state()->SetBoolean(
+        metrics::prefs::kMetricsReportingEnabled, true);
+    manager->UpdateUploadPermissions(true);
+    EXPECT_FALSE(manager->IsMetricsConsentGiven());
+    EXPECT_FALSE(manager->IsMetricsReportingEnabled());
+    ASSERT_TRUE(g_browser_process->metrics_service());
+    EXPECT_FALSE(g_browser_process->metrics_service()->reporting_active());
+    EXPECT_FALSE(g_browser_process->metrics_service()->recording_active());
+    EXPECT_EQ(nullptr,
+              SyncServiceFactory::GetForProfile(browser()->GetProfile()));
+    EXPECT_EQ(nullptr,
+              WebHistoryServiceFactory::GetForProfile(browser()->GetProfile()));
+    EXPECT_EQ(0, diagnostic_requests_.load());
+  }
+
+  scoped_refptr<const extensions::Extension> Load(
+      extensions::TestExtensionDir& directory,
+      bool should_succeed = true) {
+    auto installer =
+        extensions::UnpackedInstaller::Create(browser()->GetProfile());
+    installer->set_be_noisy_on_failure(false);
+    base::test::TestFuture<const extensions::Extension*, base::FilePath,
+                           std::u16string>
+        completion;
+    installer->set_completion_callback(
+        completion.GetCallback<const extensions::Extension*,
+                               const base::FilePath&, const std::u16string&>());
+    installer->Load(directory.UnpackedPath());
+    EXPECT_TRUE(completion.Wait());
+    auto* extension = completion.Get<0>();
+    if (should_succeed) {
+      EXPECT_TRUE(extension) << completion.Get<2>();
+      EXPECT_TRUE(completion.Get<2>().empty());
+    } else {
+      EXPECT_FALSE(extension);
+      EXPECT_FALSE(completion.Get<2>().empty());
+    }
+    return extension;
+  }
+
+  void WriteOptionalExtension(extensions::TestExtensionDir& directory) {
+    directory.WriteManifest(R"JSON({
+      "name": "Fictional history boundary",
+      "version": "1",
+      "manifest_version": 3,
+      "permissions": ["storage"],
+      "optional_permissions":
+          ["history", "topSites", "sessions", "downloads"]
+    })JSON");
+    directory.WriteFile(FILE_PATH_LITERAL("page.html"),
+                        "<title>Fictional extension</title>");
+  }
+
+  void CheckNamespacesHidden(content::WebContents* contents) {
+    EXPECT_EQ("false,false,false,false,false", content::EvalJs(contents, R"JS(
+          ['history', 'topSites', 'sessions', 'downloads', 'debugger']
+              .map(name => typeof chrome[name] !== 'undefined').join(',');
+        )JS"));
+    EXPECT_EQ("local-only", content::EvalJs(contents, R"JS(
+      (async () => {
+        await chrome.storage.local.set({fictional: 'local-only'});
+        return (await chrome.storage.local.get('fictional')).fictional;
+      })();
+    )JS"));
+  }
+
+ private:
+  std::atomic<int> diagnostic_requests_{0};
+  base::Lock referrer_lock_;
+  std::string referrer_ GUARDED_BY(referrer_lock_);
+};
