+IN_PROC_BROWSER_TEST_F(StainlessHistoryPrivacyBrowserTest,
+                       PreviouslyGrantedHistoryPermissionsRemainUnavailable) {
+  extensions::TestExtensionDir directory;
+  WriteOptionalExtension(directory);
+  auto extension = Load(directory);
+  ASSERT_TRUE(extension);
+  // Simulate old grants, including debugger, which cannot be optional.
+  auto active = extension->permissions_data()->active_permissions().Clone();
+  auto apis = active->apis().Clone();
+  for (auto permission : {extensions::mojom::APIPermissionID::kHistory,
+                          extensions::mojom::APIPermissionID::kTopSites,
+                          extensions::mojom::APIPermissionID::kSessions,
+                          extensions::mojom::APIPermissionID::kDownloads,
+                          extensions::mojom::APIPermissionID::kDebugger}) {
+    apis.insert(permission);
+  }
+  active->SetAPIPermissions(std::move(apis));
+  extension->permissions_data()->SetPermissions(
+      std::move(active),
+      extension->permissions_data()->withheld_permissions().Clone());
+  for (auto permission :
+       {"history", "topSites", "sessions", "downloads", "debugger"}) {
+    ASSERT_TRUE(
+        extension->permissions_data()->active_permissions().HasAPIPermission(
+            permission))
+        << permission;
+  }
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), extension->GetResourceURL("page.html")));
+  CheckNamespacesHidden(browser()->GetTabStripModel()->GetActiveWebContents());
+  auto* api = extensions::ExtensionAPI::GetSharedInstance();
+  auto* contents = browser()->GetTabStripModel()->GetActiveWebContents();
+  for (auto name :
+       {"history.search", "history.getVisits", "history.onVisited",
+        "history.onVisitRemoved", "topSites.get", "sessions.getRecentlyClosed",
+        "sessions.getDevices", "sessions.onChanged", "downloads.search",
+        "downloads.onCreated", "debugger.sendCommand"}) {
+    auto availability = api->IsAvailable(
+        name, extension.get(),
+        extensions::mojom::ContextType::kPrivilegedExtension,
+        extension->GetResourceURL("page.html"),
+        extensions::CheckAliasStatus::NOT_ALLOWED,
+        /*context_id=*/0,
+        extensions::BrowserFrameContextData(contents->GetPrimaryMainFrame()));
+    EXPECT_FALSE(availability.is_available()) << name;
+  }
+  CheckReportingDisabled();
+}
