+IN_PROC_BROWSER_TEST_F(StainlessHistoryPrivacyBrowserTest,
+                       SavedPageIconsNeverSendHistoryToARemoteFallback) {
+  const GURL url("http://fictional-history.invalid/icon-sentinel");
+  auto* history = HistoryServiceFactory::GetForProfile(
+      browser()->GetProfile(), ServiceAccessType::EXPLICIT_ACCESS);
+  history->AddPage(url, base::Time::Now(), history::SOURCE_BROWSED);
+  FlushHistory();
+  auto* icons =
+      LargeIconServiceFactory::GetForBrowserContext(browser()->GetProfile());
+  ASSERT_TRUE(icons);
+  static_cast<favicon::LargeIconServiceImpl*>(icons)->SetServerUrlForTesting(
+      embedded_test_server()->GetURL("/diagnostics/favicon"));
+  base::test::TestFuture<favicon_base::GoogleFaviconServerRequestStatus> result;
+  icons->GetLargeIconOrFallbackStyleFromGoogleServerSkippingLocalCache(
+      url, false, TRAFFIC_ANNOTATION_FOR_TESTS, result.GetCallback());
+  EXPECT_EQ(favicon_base::GoogleFaviconServerRequestStatus::
+                FAILURE_TARGET_URL_SKIPPED,
+            result.Take());
+  base::CancelableTaskTracker tracker;
+  base::test::TestFuture<bool> fallback;
+  icons->GetLargeIconRawBitmapOrFallbackStyleForPageUrl(
+      url, 16, 16,
+      base::BindOnce(
+          [](base::test::TestFuture<bool>* future,
+             const favicon_base::LargeIconResult& result) {
+            future->SetValue(result.fallback_icon_style != nullptr);
+          },
+          base::Unretained(&fallback)),
+      &tracker);
+  EXPECT_TRUE(fallback.Get());
+  CheckReportingDisabled();
+}
