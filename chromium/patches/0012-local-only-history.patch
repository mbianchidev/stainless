+IN_PROC_BROWSER_TEST_F(StainlessHistoryPrivacyBrowserTest,
+                       ExtensionsCannotRequestHistoryCapabilities) {
+  extensions::TestExtensionDir directory;
+  WriteOptionalExtension(directory);
+  auto extension = Load(directory);
+  ASSERT_TRUE(extension);
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), extension->GetResourceURL("page.html")));
+  auto* contents = browser()->GetTabStripModel()->GetActiveWebContents();
+  CheckNamespacesHidden(contents);
+  auto* management =
+      extensions::ExtensionManagementFactory::GetForBrowserContext(
+          browser()->GetProfile());
+  browser()->GetProfile()->GetPrefs()->SetDict(
+      extensions::pref_names::kExtensionManagement,
+      base::DictValue().Set(
+          extension->id(), base::DictValue()
+                               .Set("installation_mode", "allowed")
+                               .Set("blocked_permissions", base::ListValue())));
+  auto blocked = management->GetBlockedPermissions(extension.get());
+  for (auto permission : {extensions::mojom::APIPermissionID::kHistory,
+                          extensions::mojom::APIPermissionID::kTopSites,
+                          extensions::mojom::APIPermissionID::kSessions,
+                          extensions::mojom::APIPermissionID::kDownloads,
+                          extensions::mojom::APIPermissionID::kDebugger}) {
+    EXPECT_TRUE(blocked->HasAPIPermission(permission));
+  }
+  for (auto permission : {"history", "topSites", "sessions", "downloads"}) {
+    SCOPED_TRACE(permission);
+    EXPECT_EQ(false, content::EvalJs(contents, content::JsReplace(R"JS(
+          (async () => {
+            try {
+              return await chrome.permissions.request({permissions: [$1]});
+            } catch (error) {
+              if (!String(error).includes('policy')) throw error;
+              return false;
+            }
+          })();
+        )JS",
+                                                                  permission)));
+  }
+  for (auto permission :
+       {"history", "topSites", "sessions", "downloads", "debugger"}) {
+    SCOPED_TRACE(permission);
+    extensions::TestExtensionDir required;
+    required.WriteManifest(
+        base::DictValue()
+            .Set("name", "Fictional denied history client")
+            .Set("version", "1")
+            .Set("manifest_version", 3)
+            .Set("permissions", base::ListValue().Append(permission)));
+    EXPECT_EQ(nullptr, Load(required, false));
+  }
+  CheckReportingDisabled();
+}
