+#include "base/command_line.h"
+
+namespace stainless {
+
+inline constexpr char kStartupSafeMode[] = "stainless-startup-safe-mode";
+
+inline bool IsStartupSafeMode() {
+  return base::CommandLine::ForCurrentProcess()->HasSwitch(kStartupSafeMode);
