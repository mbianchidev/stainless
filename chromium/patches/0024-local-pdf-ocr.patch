diff --git a/components/pdf/common/stainless_local_ocr.mojom b/components/pdf/common/stainless_local_ocr.mojom
new file mode 100644
index 0000000000000000000000000000000000000000..12268fa21ae2e829d50ed996b6c94340f1407e66
--- /dev/null
+++ b/components/pdf/common/stainless_local_ocr.mojom
@@ -0,0 +1,42 @@
+module pdf.mojom;
+
+import "mojo/public/mojom/base/big_buffer.mojom";
+import "mojo/public/mojom/base/unguessable_token.mojom";
+import "services/screen_ai/public/mojom/screen_ai_service.mojom";
+
+enum StainlessOcrStatus {
+  kOk,
+  kUnavailable,
+  kInvalidInput,
+  kCancelled,
+  kFailed,
+};
+
+struct StainlessOcrBitmap {
+  uint32 width;
+  uint32 height;
+  uint32 stride;
+  mojo_base.mojom.BigBuffer rgba;
+};
+
+struct StainlessOcrGrant {
+  StainlessOcrStatus status;
+  mojo_base.mojom.UnguessableToken? token;
+  string detail;
+};
+
+struct StainlessOcrResult {
+  StainlessOcrStatus status;
+  string detail;
+  screen_ai.mojom.VisualAnnotation? annotation;
+};
+
+// Bound to the requesting PDF document, never to a renderer-selected profile,
+// language, model path or service endpoint. Pixel production follows admission.
+interface StainlessLocalOcr {
+  GetMaxImageDimension() => (uint32 max_dimension);
+  RequestSlot() => (StainlessOcrGrant grant);
+  PerformOcr(mojo_base.mojom.UnguessableToken token,
+             StainlessOcrBitmap image) => (StainlessOcrResult result);
+  CancelSlot(mojo_base.mojom.UnguessableToken token);
+};
