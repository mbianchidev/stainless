+
+namespace stainless_local {
+namespace {
+
+using PdfStatus = pdf::mojom::StainlessOcrStatus;
+
+const char* OcrLanguageTag(const std::string& language) {
+  if (language == "eng") {
+    return "en";
+  }
+  if (language == "ita") {
+    return "it";
+  }
+  if (language == "fra") {
+    return "fr";
+  }
+  if (language == "deu") {
+    return "de";
+  }
+  if (language == "spa") {
+    return "es";
+  }
+  return nullptr;
+}
+
+screen_ai::mojom::VisualAnnotationPtr Annotation(const mojom::Result& result,
+                                                 const std::string& language) {
+  auto annotation = screen_ai::mojom::VisualAnnotation::New();
+  std::map<uint32_t, screen_ai::mojom::LineBoxPtr> lines;
+  for (const auto& source : result.words) {
+    auto& line = lines[source->line_index];
+    if (!line) {
+      line = screen_ai::mojom::LineBox::New();
+      line->language = OcrLanguageTag(language);
+      line->block_id = 0;
+      line->paragraph_id = source->line_index;
+      line->bounding_box = gfx::Rect(source->line_left, source->line_top,
+                                     source->line_width, source->line_height);
+      line->bounding_box_angle = 0;
+      line->confidence = source->line_confidence;
+    }
+    if (!line->text_line.empty()) {
+      line->text_line += " ";
+    }
+    line->text_line += source->text;
+    auto word = screen_ai::mojom::WordBox::New();
+    word->word = source->text;
+    word->language = OcrLanguageTag(language);
+    word->bounding_box =
+        gfx::Rect(source->left, source->top, source->width, source->height);
+    word->bounding_box_angle = 0;
+    word->direction = screen_ai::mojom::Direction::DIRECTION_LEFT_TO_RIGHT;
+    word->confidence = source->confidence;
+    if (!line->words.empty()) {
+      auto& previous = line->words.back();
+      const int gap = word->bounding_box.x() - previous->bounding_box.right();
+      if (gap > 0) {
+        previous->whitespace_bounding_box =
+            gfx::Rect(previous->bounding_box.right(), line->bounding_box.y(),
+                      gap, line->bounding_box.height());
+      }
+    }
+    line->words.push_back(std::move(word));
+  }
+  for (auto& [index, line] : lines) {
+    annotation->lines.push_back(std::move(line));
+  }
+  return annotation;
+}
+
+class LocalPdfOcr final : public content::DocumentUserData<LocalPdfOcr>,
+                          public pdf::mojom::StainlessLocalOcr {
+ public:
+  ~LocalPdfOcr() override {
+    weak_.InvalidateWeakPtrs();
+    CancelCurrent("The local OCR document was destroyed");
+  }
+
+  void Bind(mojo::PendingReceiver<pdf::mojom::StainlessLocalOcr> receiver,
+            OcrLanguagePicker picker,
+            OcrNotice notice) {
+    if (receivers_.size() >= 16) {
+      receiver.ResetWithReason(1, "The local OCR context limit was reached");
+      return;
+    }
+    picker_ = std::move(picker);
+    notice_ = std::move(notice);
+    receivers_.Add(this, std::move(receiver));
+  }
+
+  void GetMaxImageDimension(GetMaxImageDimensionCallback reply) override {
+    if (!Allowed()) {
+      std::move(reply).Run(0);
+      return;
+    }
+    const auto language = profile()->GetPrefs()->GetString(kOcrLanguage);
+    if (OcrLanguageTag(language)) {
+      std::move(reply).Run(4096);
+      return;
+    }
+    if (language_replies_.size() >= 16 || !picker_) {
+      Report("Choose an installed OCR language in Local Services Settings",
+             true);
+      std::move(reply).Run(0);
+      return;
+    }
+    language_replies_.push_back(std::move(reply));
+    if (language_replies_.size() == 1) {
+      picker_.Run(
+          render_frame_host().GetWeakDocumentPtr(),
+          base::BindOnce(&LocalPdfOcr::LanguageChosen, weak_.GetWeakPtr()));
+    }
+  }
+
+  void RequestSlot(RequestSlotCallback reply) override {
+    const auto language = profile()->GetPrefs()->GetString(kOcrLanguage);
+    if (!Allowed() || !OcrLanguageTag(language) || operation_) {
+      const std::string detail =
+          operation_ ? "This PDF already has a pending OCR image"
+                     : "Local PDF OCR needs consent and an installed selected "
+                       "OCR language";
+      Report(detail, true);
+      std::move(reply).Run(pdf::mojom::StainlessOcrGrant::New(
+          PdfStatus::kUnavailable, std::nullopt, detail));
+      return;
+    }
+    const auto token = base::UnguessableToken::Create();
+    operation_ = std::make_unique<Operation>();
+    operation_->token = token;
+    operation_->language = language;
+    operation_->grant = std::move(reply);
+    Report("Waiting for bounded local PDF OCR admission", false);
+    const auto job = LocalBroker::Get().Submit(
+        &render_frame_host(), Feature::kOcr,
+        base::BindOnce(&LocalPdfOcr::Admitted, weak_.GetWeakPtr(), token),
+        base::BindOnce(&LocalPdfOcr::Completed, weak_.GetWeakPtr(), token));
+    if (Matches(token)) {
+      operation_->job = job;
+    }
+  }
+
+  void PerformOcr(const base::UnguessableToken& token,
+                  pdf::mojom::StainlessOcrBitmapPtr image,
+                  PerformOcrCallback reply) override {
+    if (!Allowed() || !Matches(token) || !operation_->ready ||
+        !operation_->pack || operation_->result) {
+      std::move(reply).Run(pdf::mojom::StainlessOcrResult::New(
+          PdfStatus::kCancelled, "The PDF OCR admission is no longer active",
+          nullptr));
+      return;
+    }
+    if (!image || !image->width || image->width > 4096 || !image->height ||
+        image->height > 4096 || image->stride != image->width * 4 ||
+        image->rgba.size() !=
+            static_cast<uint64_t>(image->stride) * image->height) {
+      Report("The PDF OCR bitmap exceeds its dimensions or stride boundary",
+             true);
+      std::move(reply).Run(pdf::mojom::StainlessOcrResult::New(
+          PdfStatus::kInvalidInput,
+          "The PDF OCR bitmap exceeds its dimensions or stride boundary",
+          nullptr));
+      CancelCurrent("The PDF renderer supplied an invalid bounded OCR image");
+      return;
+    }
+    operation_->result = std::move(reply);
+    auto bitmap = mojom::Bitmap::New();
+    bitmap->width = image->width;
+    bitmap->height = image->height;
+    bitmap->stride = image->stride;
+    bitmap->pixels = std::move(image->rgba);
+    auto prepared = PrepareLocalOcrRequest(
+        std::move(*operation_->pack), operation_->language,
+        mojom::Image::NewBitmap(std::move(bitmap)));
+    operation_->pack.reset();
+    auto ready = std::move(operation_->ready);
+    Report("Reading the admitted PDF image with local OCR", false);
+    std::move(ready).Run(std::move(prepared));
+  }
+
+  void CancelSlot(const base::UnguessableToken& token) override {
+    if (Matches(token)) {
+      CancelCurrent("The PDF renderer cancelled its local OCR image");
+    }
+  }
+
+ private:
+  friend class content::DocumentUserData<LocalPdfOcr>;
+  struct Operation {
+    base::UnguessableToken token;
+    base::UnguessableToken job;
+    std::string language;
+    RequestSlotCallback grant;
+    PerformOcrCallback result;
+    LocalBroker::Ready ready;
+    std::optional<model_storage::Acquired> pack;
+  };
+
+  explicit LocalPdfOcr(content::RenderFrameHost* frame)
+      : content::DocumentUserData<LocalPdfOcr>(frame) {
+    receivers_.set_disconnect_handler(base::BindRepeating(
+        [](base::WeakPtr<LocalPdfOcr> owner) {
+          if (owner && owner->receivers_.empty()) {
+            owner->CancelCurrent("The PDF OCR client disconnected");
+          }
+        },
+        weak_.GetWeakPtr()));
+  }
+
+  Profile* profile() {
+    return Profile::FromBrowserContext(render_frame_host().GetBrowserContext());
+  }
+  bool Allowed() {
+    return render_frame_host().GetProcess()->IsPdf() &&
+           pdf::PDFDocumentHelper::GetForCurrentDocument(
+               &render_frame_host()) &&
+           IsLocalFeatureAllowed(&render_frame_host(), Feature::kOcr);
+  }
+  bool Matches(const base::UnguessableToken& token) const {
+    return operation_ && operation_->token == token;
+  }
+  void Report(const std::string& detail, bool error) {
+    if (auto* models = LocalModels::GetIfExists(profile())) {
+      models->ReportRuntimeStatus(Feature::kOcr, detail, error);
+    }
+    if (error) {
+      LOG(ERROR) << "Stainless local OCR: bounded PDF operation unavailable";
+    }
+    if (notice_) {
+      notice_.Run(render_frame_host().GetWeakDocumentPtr(), detail, error);
+    }
+  }
+  void LanguageChosen(std::optional<std::string> language) {
+    bool selected = false;
+    if (Allowed() && language) {
+      if (auto* models = LocalModels::Get(profile())) {
+        const auto result = models->SetOcrLanguage(*language);
+        selected = result.has_value() && !language->empty();
+        if (!result.has_value()) {
+          Report(result.error(), true);
+        }
+      }
+    }
+    auto replies = std::move(language_replies_);
+    language_replies_.clear();
+    for (auto& reply : replies) {
+      std::move(reply).Run(selected ? 4096 : 0);
+    }
+  }
+  void Admitted(base::UnguessableToken token, LocalBroker::Ready ready) {
+    if (!Allowed() || !Matches(token)) {
+      LocalBroker::Prepared prepared;
+      prepared.error = "The original PDF OCR document changed before admission";
+      std::move(ready).Run(std::move(prepared));
+      return;
+    }
+    operation_->ready = std::move(ready);
+    auto* models = LocalModels::Get(profile());
+    if (!models) {
+      PreparationFailed("Local OCR model setup is unavailable in this mode");
+      return;
+    }
+    models->AcquirePack(
+        "ocr-" + operation_->language, Feature::kOcr,
+        base::BindOnce(&LocalPdfOcr::PackReady, weak_.GetWeakPtr(), token));
+  }
+  void PackReady(base::UnguessableToken token,
+                 base::expected<model_storage::Acquired, std::string> pack) {
+    if (!Matches(token)) {
+      return;
+    }
+    if (!Allowed() || !pack.has_value()) {
+      PreparationFailed(pack.has_value() ? "The PDF OCR document changed"
+                                         : pack.error());
+      return;
+    }
+    operation_->pack.emplace(std::move(*pack));
+    auto reply = std::move(operation_->grant);
+    std::move(reply).Run(
+        pdf::mojom::StainlessOcrGrant::New(PdfStatus::kOk, token, ""));
+  }
+  void PreparationFailed(const std::string& error) {
+    if (operation_ && operation_->ready) {
+      auto ready = std::move(operation_->ready);
+      LocalBroker::Prepared prepared;
+      prepared.error = error;
+      std::move(ready).Run(std::move(prepared));
+    }
+  }
+  void Completed(base::UnguessableToken token, mojom::ResultPtr result) {
+    if (!Matches(token)) {
+      return;
+    }
+    auto operation = std::move(operation_);
+    const bool success =
+        Allowed() && result && result->status == mojom::Status::kOk;
+    const std::string detail =
+        success ? "Local PDF OCR completed"
+        : result && !result->detail.empty()
+            ? result->detail
+            : "Local PDF OCR failed or lost its document owner";
+    Report(detail, !success);
+    if (operation->grant) {
+      std::move(operation->grant)
+          .Run(pdf::mojom::StainlessOcrGrant::New(PdfStatus::kUnavailable,
+                                                  std::nullopt, detail));
+    }
+    if (operation->result) {
+      std::move(operation->result)
+          .Run(pdf::mojom::StainlessOcrResult::New(
+              success ? PdfStatus::kOk : PdfStatus::kFailed,
+              success ? "" : detail,
+              success ? Annotation(*result, operation->language) : nullptr));
+    }
+    if (operation->ready) {
+      LocalBroker::Prepared prepared;
+      prepared.error = detail;
+      std::move(operation->ready).Run(std::move(prepared));
+    }
+  }
+  void CancelCurrent(const std::string& detail) {
+    auto operation = std::move(operation_);
+    if (!operation) {
+      return;
+    }
+    if (!operation->job.is_empty()) {
+      LocalBroker::Get().Cancel(operation->job);
+    }
+    if (operation->ready) {
+      LocalBroker::Prepared prepared;
+      prepared.error = detail;
+      std::move(operation->ready).Run(std::move(prepared));
+    }
+    if (operation->grant) {
+      std::move(operation->grant)
+          .Run(pdf::mojom::StainlessOcrGrant::New(PdfStatus::kCancelled,
+                                                  std::nullopt, detail));
+    }
+    if (operation->result) {
+      std::move(operation->result)
+          .Run(pdf::mojom::StainlessOcrResult::New(PdfStatus::kCancelled,
+                                                   detail, nullptr));
+    }
+  }
+
+  mojo::ReceiverSet<pdf::mojom::StainlessLocalOcr> receivers_;
+  OcrLanguagePicker picker_;
+  OcrNotice notice_;
+  std::vector<GetMaxImageDimensionCallback> language_replies_;
+  std::unique_ptr<Operation> operation_;
+  base::WeakPtrFactory<LocalPdfOcr> weak_{this};
+  DOCUMENT_USER_DATA_KEY_DECL();
+};
+
+DOCUMENT_USER_DATA_KEY_IMPL(LocalPdfOcr);
+
+}  // namespace
+
+LocalBroker::Prepared PrepareLocalOcrRequest(model_storage::Acquired pack,
+                                             const std::string& language,
+                                             mojom::ImagePtr image) {
+  LocalBroker::Prepared prepared;
+  auto request = mojom::OcrRequest::New();
+  for (auto& file : pack.files) {
+    if (file->name == language + ".traineddata") {
+      request->model = std::move(file);
+      break;
+    }
+  }
+  if (!request->model || !OcrLanguageTag(language)) {
+    prepared.error = "The verified selected OCR pack layout is unavailable";
+    return prepared;
+  }
+  request->language = language;
+  request->image = std::move(image);
+  prepared.leases = std::move(pack.leases);
+  prepared.request = mojom::Request::NewOcr(std::move(request));
+  return prepared;
+}
+
+void BindLocalPdfOcr(
+    content::RenderFrameHost* frame,
+    mojo::PendingReceiver<pdf::mojom::StainlessLocalOcr> receiver,
+    OcrLanguagePicker picker,
+    OcrNotice notice) {
+  if (!frame || !frame->IsActive() || !frame->IsRenderFrameLive() ||
+      !frame->GetProcess()->IsPdf()) {
+    receiver.ResetWithReason(1,
+                             "Local PDF OCR requires its original PDF frame");
+    return;
+  }
+  LocalPdfOcr::GetOrCreateForCurrentDocument(frame)->Bind(
+      std::move(receiver), std::move(picker), std::move(notice));
+}
+
+}  // namespace stainless_local
