+namespace {
+
+BrowserWindowInterface* Owner(content::WeakDocumentPtr document) {
+  auto* frame = document.AsRenderFrameHostIfValid();
+  if (!frame || !stainless_local::IsLocalFeatureAllowed(
+                    frame, stainless_local::Feature::kOcr)) {
+    return nullptr;
+  }
+  auto* contents = content::WebContents::FromRenderFrameHost(frame)
+                       ->GetOutermostWebContents();
+  // PDF requests can originate in a preview that is not a tab.
+  auto* tab = tabs::TabInterface::MaybeGetFromContents(contents);
+  auto* browser = tab ? tab->GetBrowserWindowInterface() : nullptr;
+  return chrome::CanOpenStainlessLocalControls(browser) &&
+                 browser->GetProfile() == frame->GetBrowserContext() &&
+                 browser->GetTabStripModel()->GetActiveWebContents() == contents
+             ? browser
+             : nullptr;
+}
+
+bool OtherModal(views::Widget* owner, views::Widget* current = nullptr) {
+  for (views::Widget* widget :
+       views::Widget::GetAllOwnedWidgets(owner->GetNativeView())) {
+    if (widget != current && !widget->IsClosed() && widget->IsVisible() &&
+        widget->widget_delegate() &&
+        widget->widget_delegate()->GetModalType() !=
+            ui::mojom::ModalType::kNone) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace
+
+DEFINE_USER_DATA(StainlessOcrLanguageView);
+
+void StainlessOcrLanguageView::Choose(content::WeakDocumentPtr document,
+                                      stainless_local::OcrLanguageReply reply) {
+  auto* browser = Owner(document);
+  auto* owner =
+      browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+  if (!owner || !owner->GetWidget() || owner->GetWidget()->IsClosed()) {
+    LOG(WARNING)
+        << "Stainless OCR language picker lost its native document owner";
+    std::move(reply).Run(std::nullopt);
+    return;
+  }
+  auto* existing = Get(browser->GetUnownedUserDataHost());
+  if (existing && !existing->GetWidget()->IsClosed() &&
+      existing->replies_.size() < 16) {
+    existing->replies_.push_back(std::move(reply));
+    existing->GetWidget()->Activate();
+    return;
+  }
+  if (existing || OtherModal(owner->GetWidget())) {
+    LOG(WARNING)
+        << "Stainless OCR language picker has no available modal owner";
+    std::move(reply).Run(std::nullopt);
+    return;
+  }
+  auto dialog = std::make_unique<views::DialogDelegate>();
+  auto view = std::make_unique<StainlessOcrLanguageView>(
+      browser, document, dialog.get(), std::move(reply));
+  auto* result = view.get();
+  dialog->SetTitle(l10n_util::GetStringUTF16(IDS_STAINLESS_OCR_LANGUAGE_TITLE));
+  dialog->SetButtons(static_cast<int>(ui::mojom::DialogButton::kOk) |
+                     static_cast<int>(ui::mojom::DialogButton::kCancel));
+  dialog->SetButtonLabel(
+      ui::mojom::DialogButton::kOk,
+      l10n_util::GetStringUTF16(IDS_STAINLESS_OCR_LANGUAGE_USE));
+  dialog->SetButtonLabel(
+      ui::mojom::DialogButton::kCancel,
+      l10n_util::GetStringUTF16(IDS_STAINLESS_COMMAND_PALETTE_CLOSE));
+  dialog->SetDefaultButton(static_cast<int>(ui::mojom::DialogButton::kNone));
+  dialog->SetModalType(ui::mojom::ModalType::kWindow);
+  dialog->set_margins(
+      ChromeLayoutProvider::Get()->GetDialogInsetsForContentType(
+          views::DialogContentType::kControl,
+          views::DialogContentType::kControl));
+  dialog->SetAcceptCallbackWithClose(base::BindRepeating(
+      [](base::WeakPtr<StainlessOcrLanguageView> view) {
+        return view && view->Accept();
+      },
+      result->weak_.GetWeakPtr()));
+  dialog->SetInitiallyFocusedView(result->languages_);
+  dialog->SetContentsView(std::move(view));
+  auto* widget = views::DialogDelegate::CreateDialogWidget(
+      std::move(dialog), gfx::NativeWindow(),
+      owner->GetWidget()->GetNativeView());
+  result->widget_.Observe(widget);
+  result->Refresh();
+  widget->Show();
+}
+
+StainlessOcrLanguageView::StainlessOcrLanguageView(
+    BrowserWindowInterface* browser,
+    content::WeakDocumentPtr document,
+    views::DialogDelegate* dialog,
+    stainless_local::OcrLanguageReply reply)
+    : content::WebContentsObserver(content::WebContents::FromRenderFrameHost(
+                                       document.AsRenderFrameHostIfValid())
+                                       ->GetOutermostWebContents()),
+      browser_(browser->GetWeakPtr()),
+      document_(document),
+      dialog_(dialog),
+      return_focus_(std::make_unique<views::ViewTracker>()) {
+  registration_.emplace(browser->GetUnownedUserDataHost(), *this);
+  replies_.push_back(std::move(reply));
+  auto* focus =
+      BrowserView::GetBrowserViewForBrowser(browser)->GetFocusManager();
+  return_focus_->SetView(focus->GetFocusedView() ? focus->GetFocusedView()
+                                                 : focus->GetStoredFocusView());
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(), 8));
+  auto* explanation = AddChildView(std::make_unique<views::Label>(
+      l10n_util::GetStringUTF16(IDS_STAINLESS_OCR_LANGUAGE_EXPLANATION)));
+  explanation->SetMultiLine(true);
+  explanation->SetHorizontalAlignment(gfx::HorizontalAlignment::ALIGN_LEFT);
+  languages_ = AddChildView(std::make_unique<views::Combobox>(
+      std::make_unique<ui::SimpleComboboxModel>(
+          std::vector<ui::SimpleComboboxModel::Item>{
+              ui::SimpleComboboxModel::Item(l10n_util::GetStringUTF16(
+                  IDS_STAINLESS_OCR_LANGUAGE_CHOOSE))})));
+  languages_->GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_STAINLESS_OCR_LANGUAGE_TITLE));
+  languages_->SetCallback(base::BindRepeating(
+      &StainlessOcrLanguageView::Refresh, base::Unretained(this)));
+  status_ = AddChildView(std::make_unique<views::Label>());
+  status_->SetMultiLine(true);
+  status_->SetHorizontalAlignment(gfx::HorizontalAlignment::ALIGN_LEFT);
+  status_->GetViewAccessibility().SetRole(ax::mojom::Role::kStatus);
+  status_->GetViewAccessibility().SetLiveRegionContainer(
+      views::ViewAccessibility::LiveRegionStatus::kPolite);
+  AddChildView(std::make_unique<views::MdTextButton>(
+      base::BindRepeating(&StainlessOcrLanguageView::OpenSettings,
+                          base::Unretained(this)),
+      l10n_util::GetStringUTF16(IDS_STAINLESS_TRANSLATION_SETUP)));
+  SetPreferredSize(gfx::Size(580, 280));
+}
+
+StainlessOcrLanguageView::~StainlessOcrLanguageView() = default;
+
+void StainlessOcrLanguageView::Refresh() {
+  refresh_.Stop();
+  auto* browser = Owner(document_);
+  if (!browser || browser_.get() != browser) {
+    if (GetWidget()) {
+      GetWidget()->Close();
+    }
+    return;
+  }
+  auto* models = stainless_local::LocalModels::Get(browser->GetProfile());
+  const auto status = models->Status();
+  const bool checking = status.FindBool("inspecting").value_or(false);
+  const auto selected = languages_->GetSelectedIndex().value_or(0);
+  const std::string previous = selected < codes_.size() ? codes_[selected] : "";
+  std::vector<std::string> codes{""};
+  std::vector<ui::SimpleComboboxModel::Item> labels;
+  labels.emplace_back(
+      l10n_util::GetStringUTF16(IDS_STAINLESS_OCR_LANGUAGE_CHOOSE));
+  const std::array<std::pair<const char*, int>, 5> choices = {
+      {{"eng", IDS_STAINLESS_TRANSLATION_EN},
+       {"ita", IDS_STAINLESS_TRANSLATION_IT},
+       {"fra", IDS_STAINLESS_TRANSLATION_FR},
+       {"deu", IDS_STAINLESS_TRANSLATION_DE},
+       {"spa", IDS_STAINLESS_TRANSLATION_ES}}};
+  for (const auto& [code, label] : choices) {
+    if (models->Ready(std::string("ocr-") + code)) {
+      codes.emplace_back(code);
+      labels.emplace_back(l10n_util::GetStringUTF16(label));
+    }
+  }
+  if (codes != codes_) {
+    codes_ = std::move(codes);
+    languages_->SetOwnedModel(
+        std::make_unique<ui::SimpleComboboxModel>(std::move(labels)));
+    size_t index = 0;
+    for (size_t candidate = 1; candidate < codes_.size(); ++candidate) {
+      if (codes_[candidate] == previous) {
+        index = candidate;
+      }
+    }
+    languages_->SetSelectedIndex(index);
+  }
+  const auto index = languages_->GetSelectedIndex().value_or(0);
+  dialog_->SetButtonEnabled(ui::mojom::DialogButton::kOk,
+                            index > 0 && index < codes_.size() && !checking);
+  status_->SetText(l10n_util::GetStringUTF16(
+      checking             ? IDS_STAINLESS_OCR_LANGUAGE_CHECKING
+      : codes_.size() == 1 ? IDS_STAINLESS_OCR_LANGUAGE_NO_PACKS
+                           : IDS_STAINLESS_OCR_LANGUAGE_EXPLANATION));
+  if (checking) {
+    refresh_.Start(FROM_HERE, base::Milliseconds(500), this,
+                   &StainlessOcrLanguageView::Refresh);
+  }
+}
+
+bool StainlessOcrLanguageView::Accept() {
+  auto* browser = Owner(document_);
+  const auto index = languages_->GetSelectedIndex().value_or(0);
+  if (!browser || index == 0 || index >= codes_.size() ||
+      !stainless_local::LocalModels::Get(browser->GetProfile())
+           ->Ready("ocr-" + codes_[index])) {
+    status_->SetText(
+        l10n_util::GetStringUTF16(IDS_STAINLESS_OCR_LANGUAGE_NO_PACKS));
+    return false;
+  }
+  chosen_ = codes_[index];
+  return true;
+}
+
+void StainlessOcrLanguageView::OpenSettings() {
+  open_settings_ = true;
+  GetWidget()->Close();
+}
+
+void StainlessOcrLanguageView::DidFinishNavigation(content::NavigationHandle*) {
+  if (!Owner(document_) && GetWidget()) {
+    GetWidget()->Close();
+  }
+}
+
+void StainlessOcrLanguageView::WebContentsDestroyed() {
+  if (GetWidget()) {
+    GetWidget()->Close();
+  }
+}
+
+void StainlessOcrLanguageView::OnWidgetDestroyed(views::Widget*) {
+  weak_.InvalidateWeakPtrs();
+  refresh_.Stop();
+  widget_.Reset();
+  registration_.reset();
+  auto replies = std::move(replies_);
+  auto browser = browser_;
+  auto focus = std::move(return_focus_);
+  const bool settings = open_settings_;
+  const auto chosen = chosen_;
+  for (auto& reply : replies) {
+    std::move(reply).Run(chosen);
+  }
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::WeakPtr<BrowserWindowInterface> browser, bool settings,
+             std::unique_ptr<views::ViewTracker> focus) {
+            if (!browser || browser->IsDeleteScheduled()) {
+              return;
+            }
+            if (settings) {
+              chrome::ShowSettingsSubPage(browser.get(), "localServices");
+            } else if (focus->view() && focus->view()->IsDrawn() &&
+                       focus->view()->IsFocusable()) {
+              focus->view()->RequestFocus();
+            } else if (auto* contents = browser->GetTabStripModel()
+                                            ->GetActiveWebContents()) {
+              contents->Focus();
+            }
+          },
+          browser, settings, std::move(focus)));
+}
+
+namespace chrome {
+
+void ChooseLocalOcrLanguage(content::WeakDocumentPtr document,
+                            stainless_local::OcrLanguageReply reply) {
+  StainlessOcrLanguageView::Choose(document, std::move(reply));
+}
+
+void ShowLocalOcrNotice(content::WeakDocumentPtr document,
+                        const std::string& detail,
+                        bool error) {
+  if (!error) {
+    return;
+  }
+  auto* browser = Owner(document);
+  auto* owner =
+      browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+  if (!owner || !owner->GetWidget() || OtherModal(owner->GetWidget())) {
+    LOG(WARNING) << "Stainless OCR error remains available in Local Services "
+                    "Settings; no current native dialog owner";
+    return;
+  }
+  auto dialog = std::make_unique<views::DialogDelegate>();
+  dialog->SetTitle(l10n_util::GetStringUTF16(IDS_STAINLESS_OCR_ERROR_TITLE));
+  dialog->SetButtons(static_cast<int>(ui::mojom::DialogButton::kOk) |
+                     static_cast<int>(ui::mojom::DialogButton::kCancel));
+  dialog->SetButtonLabel(
+      ui::mojom::DialogButton::kOk,
+      l10n_util::GetStringUTF16(IDS_STAINLESS_TRANSLATION_SETUP));
+  dialog->SetButtonLabel(
+      ui::mojom::DialogButton::kCancel,
+      l10n_util::GetStringUTF16(IDS_STAINLESS_COMMAND_PALETTE_CLOSE));
+  auto label = std::make_unique<views::Label>(base::UTF8ToUTF16(detail));
+  label->SetMultiLine(true);
+  label->SetPreferredSize(gfx::Size(540, 130));
+  label->GetViewAccessibility().SetRole(ax::mojom::Role::kAlert);
+  dialog->SetContentsView(std::move(label));
+  dialog->SetAcceptCallback(base::BindOnce(
+      [](base::WeakPtr<BrowserWindowInterface> browser) {
+        if (browser && !browser->IsDeleteScheduled()) {
+          chrome::ShowSettingsSubPage(browser.get(), "localServices");
+        }
+      },
+      browser->GetWeakPtr()));
+  views::DialogDelegate::CreateDialogWidget(std::move(dialog),
+                                            gfx::NativeWindow(),
+                                            owner->GetWidget()->GetNativeView())
+      ->Show();
+}
+
+}  // namespace chrome
+
+BEGIN_METADATA(StainlessOcrLanguageView)
+END_METADATA
