+TEST_P(PDFiumOnDemandSearchifierTest, LocalAdmissionPrecedesBitmapProduction) {
+  auto* engine = CreateEngine(FILE_PATH_LITERAL("image_alt_text.pdf"));
+  ASSERT_TRUE(engine);
+  PDFiumPage& page = GetPDFiumPage(*engine, 0);
+  page.GetPage();
+  const size_t candidates = page.GetImageObjectIndices().size();
+  auto* searchifier = engine->GetSearchifierForTesting();
+  ASSERT_TRUE(searchifier);
+  base::test::TestFuture<base::OnceCallback<void(bool)>> first;
+  size_t requested = 0;
+  size_t cancelled = 0;
+  StartSearchify(
+      false,
+      base::BindLambdaForTesting(
+          [&](base::OnceCallback<void(bool)> reply) {
+            if (++requested == 1) {
+              first.SetValue(std::move(reply));
+            } else {
+              std::move(reply).Run(true);
+            }
+          }),
+      base::BindLambdaForTesting([&] { ++cancelled; }));
+  ASSERT_TRUE(first.Wait());
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(candidates, PendingImages(searchifier));
+  EXPECT_EQ(0, performed_ocrs());
+  EXPECT_TRUE(GetPageText(page).empty());
+  std::move(first.Take()).Run(true);
+  ASSERT_TRUE(WaitForIdleState(searchifier));
+  EXPECT_EQ(2u, requested);
+  EXPECT_EQ(0u, cancelled);
+  EXPECT_EQ(2, performed_ocrs());
+  EXPECT_EQ("OCR Text 0\r\nOCR Text 1", GetPageText(page));
+}
