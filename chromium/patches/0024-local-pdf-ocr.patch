+class StainlessOcrBrowserTest : public InProcessBrowserTest {
+ public:
+  void SetUpCommandLine(base::CommandLine* command) override {
+    const auto summary =
+        base::CommandLine::ForCurrentProcess()->GetSwitchValuePath(
+            "test-launcher-summary-output");
+    if (summary.IsAbsolute()) {
+      ASSERT_TRUE(cache_.CreateUniqueTempDirUnderPath(summary.DirName()));
+    } else {
+      ASSERT_TRUE(cache_.CreateUniqueTempDir());
+    }
+    base::FilePath canonical;
+    ASSERT_TRUE(base::NormalizeFilePath(cache_.GetPath(), &canonical));
+    command->AppendSwitchPath("disk-cache-dir", canonical);
+    command->AppendSwitchASCII("headless", "new");
+    command->AppendSwitch("use-mock-keychain");
+    command->AppendSwitch("disable-audio-input");
+    command->AppendSwitch("disable-audio-output");
+    command->AppendSwitchASCII("lang", "en-US");
+  }
+
+  void SetUpOnMainThread() override {
+    ASSERT_TRUE(display::Screen::Get()->IsHeadless());
+    host_resolver()->AddRule("*", "127.0.0.1");
+    embedded_test_server()->RegisterRequestHandler(base::BindRepeating(
+        &StainlessOcrBrowserTest::Respond, base::Unretained(this)));
+    ASSERT_TRUE(embedded_test_server()->Start());
+  }
+
+  void TearDownOnMainThread() override {
+    weak_.InvalidateWeakPtrs();
+    poll_.Stop();
+    if (auto* view = View()) {
+      view->GetWidget()->CloseNow();
+    }
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), GURL("about:blank")));
+    base::RunLoop().RunUntilIdle();
+    base::ScopedAllowBlockingForTesting blocking;
+    auto location = stainless_local::model_storage::ResolveLocation(
+        browser()->GetProfile()->GetPath().DirName());
+    ASSERT_TRUE(location.has_value()) << location.error();
+    const auto removed = stainless_local::test::RemoveModelFixtures(*location);
+    ASSERT_TRUE(removed.has_value()) << removed.error();
+  }
+
+  content::WebContents* contents() {
+    return browser()->GetTabStripModel()->GetActiveWebContents();
+  }
+
+  StainlessOcrLanguageView* View() {
+    return StainlessOcrLanguageView::Get(browser()->GetUnownedUserDataHost());
+  }
+
+  pdf::PDFDocumentHelper* Pdf() {
+    return pdf::PDFDocumentHelper::MaybeGetForFullPagePdf(*contents());
+  }
+
+  bool Navigate(const char* name) {
+    std::string bytes;
+    {
+      base::ScopedAllowBlockingForTesting blocking;
+      const auto root =
+          base::CommandLine::ForCurrentProcess()->GetSwitchValuePath(
+              "stainless-pdf-ocr-fixture");
+      if (!root.IsAbsolute() ||
+          !base::ReadFileToStringWithMaxSize(root.AppendASCII(name), &bytes,
+                                             1024 * 1024)) {
+        ADD_FAILURE() << "Provide the owned synthetic PDF fixture directory";
+        return false;
+      }
+    }
+    {
+      base::AutoLock lock(pdf_lock_);
+      pdf_ = std::move(bytes);
+    }
+    if (!ui_test_utils::NavigateToURL(
+            browser(),
+            embedded_test_server()->GetURL("one.test", "/scan.pdf"))) {
+      return false;
+    }
+    return base::test::RunUntil(
+        [&] { return Pdf() && Pdf()->IsDocumentLoadComplete(); });
+  }
+
+  void EnableAndSeed(const char* id) {
+    {
+      base::ScopedAllowBlockingForTesting blocking;
+      const auto root =
+          base::CommandLine::ForCurrentProcess()->GetSwitchValuePath(
+              "stainless-model-pack-fixture");
+      ASSERT_TRUE(root.IsAbsolute());
+      auto location = stainless_local::model_storage::ResolveLocation(
+          browser()->GetProfile()->GetPath().DirName());
+      ASSERT_TRUE(location.has_value()) << location.error();
+      const auto installed =
+          stainless_local::test::InstallModelFixture(*location, id, root);
+      ASSERT_TRUE(installed.has_value()) << installed.error();
+    }
+    auto* models = stainless_local::LocalModels::Get(browser()->GetProfile());
+    ASSERT_TRUE(models);
+    ASSERT_TRUE(models->ConfigureFeature("ocr", true, true).has_value());
+    ASSERT_TRUE(base::test::RunUntil([&] { return models->Ready(id); }));
+  }
+
+  void Choose(const std::string& code) {
+    ASSERT_TRUE(base::test::RunUntil([&] { return View(); }));
+    auto* view = View();
+    EXPECT_EQ(0u, view->languages_->GetSelectedIndex());
+    EXPECT_FALSE(view->dialog_->GetOkButton()->GetEnabled());
+    ui::AXNodeData data;
+    view->languages_->GetViewAccessibility().GetAccessibleNodeData(&data);
+    EXPECT_FALSE(
+        data.GetString16Attribute(ax::mojom::StringAttribute::kName).empty());
+    ASSERT_TRUE(base::test::RunUntil([&] {
+      return std::ranges::find(view->codes_, code) != view->codes_.end();
+    }));
+    const auto index =
+        std::ranges::find(view->codes_, code) - view->codes_.begin();
+    view->languages_->MenuSelectionAt(index);
+    ASSERT_TRUE(view->dialog_->GetOkButton()->GetEnabled());
+    stainless_local::test::ActivateNativeControl(view->dialog_->GetOkButton());
+    ASSERT_TRUE(base::test::RunUntil([&] { return !View(); }));
+  }
+
+  std::u16string PageText() {
+    base::test::TestFuture<std::u16string> text;
+    CHECK(Pdf());
+    Pdf()->GetPageText(0, text.GetCallback<const std::u16string&>());
+    return text.Get();
+  }
+
+  bool WaitForText(const std::u16string& expected) {
+    wanted_ = Words(expected);
+    observed_.clear();
+    ReadText();
+    const bool ready =
+        base::test::RunUntil([&] { return Words(observed_) == wanted_; });
+    poll_.Stop();
+    return ready;
+  }
+
+  void CheckPdfAx(const std::u16string& expected) {
+    std::vector<ui::AXNodeData> nodes;
+    std::string diagnostic;
+    ASSERT_TRUE(base::test::RunUntil([&] {
+      content::FindAccessibilityNodeCriteria criteria;
+      criteria.role = ax::mojom::Role::kPdfRoot;
+      auto* root = content::FindAccessibilityNode(contents(), criteria);
+      if (!root) {
+        diagnostic =
+            content::GetAccessibilityTreeSnapshot(contents()).ToString();
+        return false;
+      }
+      auto snapshot = content::GetAccessibilityTreeSnapshotFromId(
+          root->GetTreeData().tree_id);
+      diagnostic = snapshot.ToString();
+      std::u16string text;
+      nodes.clear();
+      for (const auto& node : snapshot.nodes) {
+        if (node.role == ax::mojom::Role::kStaticText) {
+          text += node.GetString16Attribute(ax::mojom::StringAttribute::kName);
+          text += u" ";
+          nodes.push_back(node);
+        }
+      }
+      const auto actual = Words(text);
+      const auto wanted = Words(expected);
+      return std::search(actual.begin(), actual.end(), wanted.begin(),
+                         wanted.end()) != actual.end();
+    })) << diagnostic;
+    ASSERT_FALSE(nodes.empty());
+    for (const auto& node : nodes) {
+      if (!node.GetString16Attribute(ax::mojom::StringAttribute::kName)
+               .empty()) {
+        EXPECT_FALSE(node.relative_bounds.bounds.IsEmpty());
+      }
+    }
+  }
+
+  void CheckLanguage(const char* pack,
+                     const char* language,
+                     const char* file,
+                     const std::u16string& expected,
+                     const std::u16string& search) {
+    EnableAndSeed(pack);
+    content::ScopedAccessibilityModeOverride ax_mode(contents(),
+                                                     ui::kAXModeComplete);
+    auto* prefs = browser()->GetProfile()->GetPrefs();
+    EXPECT_TRUE(prefs->GetString(stainless_local::kOcrLanguage).empty());
+    ASSERT_TRUE(Navigate(file));
+    EXPECT_TRUE(PageText().empty());
+    Choose(language);
+    EXPECT_EQ(language, prefs->GetString(stainless_local::kOcrLanguage));
+    ASSERT_TRUE(WaitForText(expected));
+    EXPECT_EQ(Words(expected), Words(PageText()));
+    EXPECT_TRUE(Pdf()->SearchifyStarted());
+    int ordinal = 0;
+    EXPECT_EQ(1, ui_test_utils::FindInPage(contents(), search, true, false,
+                                           &ordinal, nullptr));
+    EXPECT_EQ(1, ordinal);
+    CheckPdfAx(expected);
+  }
+
+  void CancelChoice() {
+    ASSERT_TRUE(base::test::RunUntil([&] { return View(); }));
+    stainless_local::test::ActivateNativeControl(
+        View()->dialog_->GetCancelButton());
+    ASSERT_TRUE(base::test::RunUntil([&] { return !View(); }));
+  }
+
+ private:
+  void ReadText() {
+    if (Pdf()) {
+      Pdf()->GetPageText(0, base::BindOnce(&StainlessOcrBrowserTest::OnText,
+                                           weak_.GetWeakPtr()));
+    }
+  }
+
+  void OnText(const std::u16string& text) {
+    observed_ = text;
+    if (Words(observed_) != wanted_) {
+      poll_.Start(FROM_HERE, base::Milliseconds(100), this,
+                  &StainlessOcrBrowserTest::ReadText);
+    }
+  }
+
+  std::unique_ptr<net::test_server::HttpResponse> Respond(
+      const net::test_server::HttpRequest& request) {
+    if (request.relative_url != "/scan.pdf") {
+      return nullptr;
+    }
+    auto response = std::make_unique<net::test_server::BasicHttpResponse>();
+    response->set_content_type("application/pdf");
+    base::AutoLock lock(pdf_lock_);
+    response->set_content(pdf_);
+    return response;
+  }
+
+  base::ScopedTempDir cache_;
+  base::Lock pdf_lock_;
+  std::string pdf_ GUARDED_BY(pdf_lock_);
+  std::vector<std::u16string> wanted_;
+  std::u16string observed_;
+  base::OneShotTimer poll_;
+  base::WeakPtrFactory<StainlessOcrBrowserTest> weak_{this};
+};
+
+IN_PROC_BROWSER_TEST_F(StainlessOcrBrowserTest,
+                       MANUAL_FirstUseLanguageAndActualSelectablePdfText) {
+  CheckLanguage("ocr-eng", "eng", "case-0.pdf",
+                u"The red robot holds three blue boxes.", u"robot");
