 void PdfViewWebPluginClient::PerformOcr(
     const SkBitmap& image,
     base::OnceCallback<void(screen_ai::mojom::VisualAnnotationPtr)> callback) {
   ConnectOcrIfNeeded();
+#if BUILDFLAG(IS_MAC)
+  if (!local_ocr_slot_ || image.drawsNothing() ||
+      image.width() <= 0 || image.width() > 4096 ||
+      image.height() <= 0 || image.height() > 4096) {
+    LOG(ERROR) << "Local PDF OCR has no admitted bounded bitmap";
+    CancelOcrSlot();
+    OnOcrDisconnected();
+    return;
+  }
+  auto bitmap = pdf::mojom::StainlessOcrBitmap::New();
+  bitmap->width = image.width();
+  bitmap->height = image.height();
+  bitmap->stride = bitmap->width * 4;
+  bitmap->rgba = mojo_base::BigBuffer(
+      static_cast<size_t>(bitmap->stride) * bitmap->height);
+  if (!image.readPixels(
+          SkImageInfo::Make(image.width(), image.height(),
+                            kRGBA_8888_SkColorType, kUnpremul_SkAlphaType),
+          bitmap->rgba.data(), bitmap->stride, 0, 0)) {
+    LOG(ERROR) << "Local PDF OCR bitmap conversion failed";
+    CancelOcrSlot();
+    OnOcrDisconnected();
+    return;
+  }
+  const auto token = *std::exchange(local_ocr_slot_, std::nullopt);
+  local_ocr_->PerformOcr(
+      token, std::move(bitmap),
+      base::BindOnce(
+          [](base::WeakPtr<PdfViewWebPluginClient> client,
+             base::OnceCallback<void(screen_ai::mojom::VisualAnnotationPtr)>
+                 callback,
+             pdf::mojom::StainlessOcrResultPtr result) {
+            if (!client) {
+              return;
+            }
+            if (!result ||
+                result->status != pdf::mojom::StainlessOcrStatus::kOk ||
+                !result->annotation) {
+              LOG(ERROR) << "Local PDF OCR did not return a usable annotation";
+              client->OnOcrDisconnected();
+              return;
+            }
+            std::move(callback).Run(std::move(result->annotation));
+          }, weak_factory_.GetWeakPtr(), std::move(callback)));
+#else
   screen_ai_annotator_->PerformOcrAndReturnAnnotation(image,
                                                       std::move(callback));
+#endif
 }
 
