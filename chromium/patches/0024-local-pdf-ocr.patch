+std::vector<std::u16string> Words(const std::u16string& value) {
+  const auto lower = base::i18n::ToLower(value);
+  base::i18n::BreakIterator words(lower, base::i18n::BreakIterator::BREAK_WORD);
+  CHECK(words.Init());
+  std::vector<std::u16string> result;
+  while (words.Advance()) {
+    if (words.IsWord()) {
+      result.emplace_back(words.GetString());
+    }
+  }
+  return result;
+}
