+IN_PROC_BROWSER_TEST_F(StainlessCaptionBrowserTest,
+                       MANUAL_CaptionPcmWindowPreservesIngressHeadroom) {
+  ASSERT_NO_FATAL_FAILURE(Enable("captions"));
+  ASSERT_NO_FATAL_FAILURE(Seed("speech-multilingual"));
+  std::string encoded;
+  {
+    base::ScopedAllowBlockingForTesting blocking;
+    const auto wave =
+        base::CommandLine::ForCurrentProcess()->GetSwitchValuePath(
+            "stainless-speech-api-wave");
+    ASSERT_TRUE(wave.IsAbsolute());
+    ASSERT_TRUE(base::ReadFileToStringWithMaxSize(
+        wave.ReplaceExtension(FILE_PATH_LITERAL(".pcm")), &encoded, 960000));
+  }
+  ASSERT_EQ("23c914c5b1ff6fb7d3e517b004e7d9b52e56f25ef701f00e790789de6a8a2a59",
+            base::HexEncodeLower(crypto::hash::Sha256(encoded)));
+  ASSERT_EQ(0u, encoded.size() % sizeof(int16_t));
+  std::vector<int16_t> pcm(encoded.size() / sizeof(int16_t));
+  base::as_writable_byte_span(pcm).copy_from(base::as_byte_span(encoded));
+  ASSERT_GE(pcm.size(), 32000u);
+  auto* frame = contents()->GetPrimaryMainFrame();
+  auto options = media::mojom::SpeechRecognitionOptions::New();
+  options->language = "en-US";
+  options->is_server_based = false;
+  options->allow_multi_language = false;
+  options->enable_formatting = true;
+  options->recognition_mode = media::mojom::SpeechRecognitionMode::kCaption;
+  options->recognizer_client_type =
+      media::mojom::RecognizerClientType::kLiveCaption;
+  mojo::Remote<media::mojom::SpeechRecognitionRecognizer> recognizer;
+  auto receiver = recognizer.BindNewPipeAndPassReceiver();
+  mojo::PendingRemote<media::mojom::SpeechRecognitionRecognizerClient> client;
+  auto client_receiver = client.InitWithNewPipeAndPassReceiver();
+  std::optional<uint32_t> reason;
+  recognizer.set_disconnect_with_reason_handler(base::BindLambdaForTesting(
+      [&](uint32_t value, const std::string&) { reason = value; }));
+  std::string diagnostic;
+  bool disposed = false;
+  stainless_local::LocalSpeechStream stream(
+      frame->GetWeakDocumentPtr(), stainless_local::Feature::kCaptions,
+      std::move(options), std::move(receiver), std::move(client),
+      base::BindLambdaForTesting([&](const std::string& status, bool error) {
+        if (error) {
+          diagnostic = status;
+        }
+      }),
+      base::DoNothing(),
+      base::BindOnce([](bool* disposed) { *disposed = true; }, &disposed), {},
+      base::BindRepeating(&stainless_local::IsLocalFeatureAllowed, frame,
+                          stainless_local::Feature::kCaptions));
+  auto send_second = [&] {
+    auto audio = media::mojom::AudioDataS16::New();
+    audio->sample_rate = 16000;
+    audio->channel_count = 1;
+    audio->frame_count = 16000;
+    audio->data.assign(pcm.begin() + 16000, pcm.begin() + 32000);
+    stream.SendAudioToSpeechRecognitionService(std::move(audio), std::nullopt);
+  };
+  // The documented total reserves one second each for the pipe and UI handoff.
+  for (int second = 0; second < 30 - 2; ++second) {
+    send_second();
+  }
+  ASSERT_TRUE(diagnostic.empty()) << diagnostic;
+  send_second();
+  EXPECT_NE(std::string::npos, diagnostic.find("cannot keep up"));
+  EXPECT_NE(std::string::npos, diagnostic.find("30-second"));
+  EXPECT_FALSE(stainless_local::LocalBroker::Get().ReservedSessionForProfile(
+      browser()->GetProfile()));
+  ASSERT_TRUE(
+      base::test::RunUntil([&] { return disposed && reason.has_value(); }));
+  EXPECT_EQ(static_cast<uint32_t>(
+                media::mojom::LocalSpeechDisconnectReason::kAborted),
+            *reason);
+}
