+IN_PROC_BROWSER_TEST_F(
+    StainlessCaptionBrowserTest,
+    MANUAL_MutePauseSeekAndUserUnmutePreserveCaptionSelection) {
+  base::test::ScopedRunLoopTimeout deadline(FROM_HERE, base::Minutes(3));
+  ASSERT_FALSE(wave_.empty());
+  ASSERT_NO_FATAL_FAILURE(Enable("captions"));
+  ASSERT_NO_FATAL_FAILURE(Seed("speech-multilingual"));
+  contents()->SetAudioMuted(true);
+  ASSERT_NO_FATAL_FAILURE(OpenAndStart());
+  auto* caption = Caption();
+  auto text = BubbleText();
+  CloseControls();
+  ASSERT_EQ(true, content::EvalJs(contents(), R"JS(
+    (async () => {
+      const media = new Audio('/speech.wav');
+      window.fictionalMedia = media;
+      document.body.append(media);
+      if (media.readyState < 1) {
+        await new Promise(resolve =>
+          media.addEventListener('loadedmetadata', resolve, {once:true}));
+      }
+      await media.play();
+      await new Promise(resolve => {
+        const progressed = () => {
+          if (media.currentTime >= 0.15) {
+            media.removeEventListener('timeupdate', progressed);
+            resolve();
+          }
+        };
+        media.addEventListener('timeupdate', progressed);
+        progressed();
+      });
+      media.pause();
+      return media.paused && media.playbackRate === 1;
+    })()
+  )JS"));
+  EXPECT_TRUE(caption->selected());
+  EXPECT_TRUE(contents()->IsAudioMuted());
+  ASSERT_EQ(true, content::EvalJs(contents(), R"JS(
+    (async () => {
+      const media = window.fictionalMedia;
+      const sought = new Promise(resolve =>
+        media.addEventListener('seeked', resolve, {once:true}));
+      media.currentTime = 0;
+      await sought;
+      return media.paused && media.currentTime < 0.01;
+    })()
+  )JS"));
+  EXPECT_TRUE(caption->selected());
+  ASSERT_EQ(true, content::EvalJs(contents(), R"JS(
+    (async () => {
+      const media = window.fictionalMedia;
+      const ended = new Promise(resolve =>
+        media.addEventListener('ended', resolve, {once:true}));
+      await media.play();
+      await ended;
+      return media.ended && media.paused && media.playbackRate === 1 &&
+        media.currentTime >= media.duration - 0.01;
+    })()
+  )JS"));
+  EXPECT_TRUE(caption->selected());
+  EXPECT_TRUE(contents()->IsAudioMuted());
+  contents()->SetAudioMuted(false);
+  ASSERT_EQ(true, content::EvalJs(contents(), R"JS(
+    (async () => {
+      const media = window.fictionalMedia;
+      const sought = new Promise(resolve =>
+        media.addEventListener('seeked', resolve, {once:true}));
+      media.currentTime = 0;
+      await sought;
+      const ended = new Promise(resolve =>
+        media.addEventListener('ended', resolve, {once:true}));
+      await media.play();
+      await ended;
+      return media.ended && media.playbackRate === 1;
+    })()
+  )JS"));
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return Concepts(text.Run(), false) >= 4 || !caption->selected();
+  }));
+  ASSERT_TRUE(caption->selected()) << caption->status();
+  EXPECT_GE(Concepts(text.Run(), false), 4);
+  EXPECT_FALSE(contents()->IsAudioMuted());
+  ASSERT_NO_FATAL_FAILURE(StopWithKeyboard());
+  EXPECT_FALSE(caption->selected());
+  EXPECT_FALSE(contents()->IsAudioMuted());
+}
