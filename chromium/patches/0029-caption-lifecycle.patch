+IN_PROC_BROWSER_TEST_F(StainlessCaptionBrowserTest,
+                       MANUAL_NativeBubbleCloseStopsItsSelectedTab) {
+  base::test::ScopedRunLoopTimeout deadline(FROM_HERE, base::Minutes(3));
+  ASSERT_NO_FATAL_FAILURE(Enable("captions"));
+  ASSERT_NO_FATAL_FAILURE(Seed("speech-multilingual"));
+  views::NamedWidgetShownWaiter shown(views::test::AnyWidgetTestPasskey{},
+                                      "LiveCaptionWindow");
+  ASSERT_NO_FATAL_FAILURE(OpenAndStart());
+  auto* caption = Caption();
+  auto text = BubbleText();
+  CloseControls();
+  ASSERT_NO_FATAL_FAILURE(Play(contents(), 44100));
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return Concepts(text.Run(), false) >= 4 || !caption->selected();
+  }));
+  ASSERT_TRUE(caption->selected()) << caption->status();
+  ASSERT_GE(Concepts(text.Run(), false), 4);
+  auto* widget = shown.WaitIfNeededAndGet();
+  ASSERT_TRUE(widget);
+  auto* close = FindBubbleClose(widget->GetContentsView());
+  ASSERT_TRUE(close);
+  widget->Activate();
+  stainless_local::test::ActivateNativeControl(close);
+  ASSERT_TRUE(base::test::RunUntil([&] { return !caption->selected(); }));
+  EXPECT_FALSE(stainless_local::LocalBroker::Get().ReservedSessionForProfile(
+      browser()->GetProfile()));
+  ASSERT_NO_FATAL_FAILURE(Open());
+  EXPECT_TRUE(StartEnabled());
+  EXPECT_FALSE(StopEnabled());
+}
