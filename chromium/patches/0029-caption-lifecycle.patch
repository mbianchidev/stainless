+IN_PROC_BROWSER_TEST_F(StainlessCaptionBrowserTest,
+                       MANUAL_TwoHourSelectionLimitUsesOnlyItsBoundedTimer) {
+  ASSERT_NO_FATAL_FAILURE(Enable("captions"));
+  ASSERT_NO_FATAL_FAILURE(Seed("speech-multilingual"));
+  auto timer = base::MakeRefCounted<base::TestMockTimeTaskRunner>();
+  ASSERT_NO_FATAL_FAILURE(SetSelectionTaskRunner(timer));
+  ASSERT_NO_FATAL_FAILURE(OpenAndStart());
+  auto* caption = Caption();
+  ASSERT_TRUE(caption);
+  ASSERT_NO_FATAL_FAILURE(CheckControlNames());
+  EXPECT_EQ(base::Hours(2), timer->NextPendingTaskDelay());
+  timer->FastForwardBy(base::Hours(2) - base::Milliseconds(1));
+  EXPECT_TRUE(caption->selected());
+  timer->FastForwardBy(base::Milliseconds(1));
+  EXPECT_FALSE(caption->selected());
+  EXPECT_TRUE(caption->error());
+  EXPECT_NE(std::string::npos, caption->status().find("two-hour"));
+  EXPECT_NE(std::u16string::npos, StatusText().find(u"two-hour"));
+  ASSERT_NO_FATAL_FAILURE(CheckControlNames());
+  EXPECT_FALSE(stainless_local::LocalBroker::Get().ReservedSessionForProfile(
+      browser()->GetProfile()));
+}
