 namespace {
 
+base::FilePath StainlessUpdateDirectory() {
+  base::FilePath directory;
+  if (!base::PathService::Get(base::DIR_APP_DATA, &directory)) {
+    return {};
+  }
+  return directory.Append("Stainless Updater");
+}
+
+bool LockStainlessInstallation() {
+  const auto directory = StainlessUpdateDirectory();
+  if (directory.empty() || !base::CreateDirectory(directory)) {
+    LOG(ERROR) << "Cannot create Stainless updater state directory";
+    return false;
+  }
+  static base::NoDestructor<base::File> lock;
+  lock->Initialize(directory.Append("install.lock"),
+                   base::File::FLAG_OPEN_ALWAYS | base::File::FLAG_READ |
+                       base::File::FLAG_WRITE);
+  if (!lock->IsValid() ||
+      flock(lock->GetPlatformFile(), LOCK_SH | LOCK_NB) != 0) {
+    LOG(ERROR) << "Stainless update is in progress; retry launching shortly";
+    return false;
+  }
+  return true;
+}
+
+void StartStainlessUpdater() {
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch("headless")) {
+    return;
+  }
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch("user-data-dir")) {
+    LOG(WARNING) << "Automatic updates require the default Stainless profile";
+    return;
+  }
+  const auto bundle = base::apple::OuterBundlePath();
+  const auto helper = bundle.Append("Contents/Helpers/Stainless Updater.app");
+  if (!base::PathExists(helper)) {
+    LOG(WARNING) << "Updater is only available in a packaged Stainless build";
+    return;
+  }
+  NSWorkspaceOpenConfiguration* configuration =
+      [NSWorkspaceOpenConfiguration configuration];
+  configuration.activates = NO;
+  configuration.arguments =
+      @[ @"--app", base::SysUTF8ToNSString(bundle.value()) ];
+  NSURL* url =
+      [NSURL fileURLWithPath:base::SysUTF8ToNSString(helper.value())];
+  [NSWorkspace.sharedWorkspace
+      openApplicationAtURL:url
+             configuration:configuration
+         completionHandler:^(NSRunningApplication* application, NSError* error) {
+           if (error) {
+             LOG(ERROR) << "Cannot start Stainless updater: "
+                        << base::SysNSStringToUTF8(error.localizedDescription);
+           }
+         }];
+}
+
+void ScheduleStainlessStartupHealth() {
+  const auto* command = base::CommandLine::ForCurrentProcess();
+  if (command->HasSwitch("headless") ||
+      command->HasSwitch("user-data-dir")) {
+    return;
+  }
+  id build = [base::apple::OuterBundle()
+      objectForInfoDictionaryKey:@"StainlessBuild"];
+  if (![build isKindOfClass:[NSNumber class]]) {
+    return;
+  }
+  const auto directory = StainlessUpdateDirectory().Append("health");
+  const auto marker =
+      directory.Append(std::to_string([build unsignedLongLongValue]));
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::FilePath directory, base::FilePath marker) {
+            base::ThreadPool::PostTask(
+                FROM_HERE, {base::MayBlock()},
+                base::BindOnce(
+                    [](base::FilePath directory, base::FilePath marker) {
+                      if (!base::CreateDirectory(directory) ||
+                          !base::WriteFile(marker, "ready\n")) {
+                        LOG(ERROR) << "Cannot write Stainless startup health";
+                      }
+                    },
+                    directory, marker));
+          },
+          directory, marker),
+      base::Seconds(30));
+}
