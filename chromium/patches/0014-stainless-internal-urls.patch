+++ b/chrome/browser/chrome_content_browser_client.cc
@@ -862,6 +862,67 @@ namespace {
 
 const char kAIManagerUserDataKey[] = "ai_manager";
 
+bool IsStainlessInternalPage(const GURL& url) {
+  static constexpr auto kHosts = base::MakeFixedFlatSet<std::string_view>({
+      "about",
+      "bookmarks",
+      "certificate-manager",
+      "chrome-urls",
+      "components",
+      "credits",
+      "downloads",
+      "extensions",
+      "help",
+      "history",
+      "password-manager",
+      "policy",
+      "settings",
+      "version",
+  });
+  return url.is_valid() && url.SchemeIs(content::kChromeUIScheme) &&
+         !url.has_username() && !url.has_password() && !url.has_port() &&
+         kHosts.contains(url.host());
+}
+
+bool MaybeUseStainlessVirtualURL(GURL* url, content::BrowserContext*) {
+  if (!IsStainlessInternalPage(*url)) {
+    return false;
+  }
+  GURL::Replacements replacements;
+  replacements.SetSchemeStr(chrome::kStainlessUIScheme);
+  *url = url->ReplaceComponents(replacements);
+  return true;
+}
+
+bool HandleStainlessURLRewrite(GURL* url,
+                               content::BrowserContext* browser_context) {
+  if (!url->SchemeIs(chrome::kStainlessUIScheme) || !url->has_host() ||
+      url->has_username() || url->has_password() || url->has_port()) {
+    return false;
+  }
+  GURL::Replacements replacements;
+  replacements.SetSchemeStr(content::kChromeUIScheme);
+  GURL canonical = url->ReplaceComponents(replacements);
+  if (!IsStainlessInternalPage(canonical)) {
+    return false;
+  }
+  *url = std::move(canonical);
+  // Re-enter once with chrome:, preserving every native policy, override and
+  // legacy-route rewriter instead of creating another privileged origin.
+  content::BrowserURLHandler::GetInstance()->RewriteURLIfNecessary(
+      url, browser_context);
+  return true;
+}
+
+bool HandleStainlessURLReverseRewrite(
+    GURL* url,
+    content::BrowserContext* browser_context) {
+  MaybeUseStainlessVirtualURL(url, browser_context);
+  // A redirect/override outside this allowlist must display its actual URL,
+  // never retain the previous Stainless address over unrelated content.
+  return true;
+}
