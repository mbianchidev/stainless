+IN_PROC_BROWSER_TEST_F(StainlessInternalURLsBrowserTest,
+                       UnsupportedAndMalformedAddressesStayLocal) {
+  ChromeAutocompleteSchemeClassifier classifier(browser()->GetProfile());
+  for (const char* text : {
+           "stainless://not-supported/fictional?value=a%2Fb#fragment",
+           "stainless://crash/",
+           "stainless://quit/",
+           "stainless://restart/",
+           "stainless://hang/",
+           "stainless://resources/",
+           "stainless://theme/",
+           "stainless://gpu/",
+           "stainless://untrusted/",
+           "stainless://newtab/",
+           "stainless://settings.example/people",
+           "stainless://user:password@settings/people",
+           "stainless://settings:1234/people",
+           "stainless:settings/people",
+           "stainless://",
+       }) {
+    SCOPED_TRACE(text);
+    const GURL original(text);
+    ASSERT_TRUE(original.is_valid());
+    GURL rewritten = original;
+    content::BrowserURLHandler::GetInstance()->RewriteURLIfNecessary(
+        &rewritten, browser()->GetProfile());
+    EXPECT_EQ(original, rewritten);
+    EXPECT_TRUE(ProfileIOData::IsHandledURL(original));
+    const AutocompleteInput input(
+        base::UTF8ToUTF16(text), metrics::OmniboxEventProto::OTHER, classifier);
+    EXPECT_EQ(metrics::OmniboxInputType::URL, input.type());
+    EXPECT_EQ(original, input.canonicalized_url());
+  }
+  for (const char* text :
+       {"stainless://settings:invalid/people", "stainless://[invalid/people"}) {
+    SCOPED_TRACE(text);
+    const AutocompleteInput input(
+        base::UTF8ToUTF16(text), metrics::OmniboxEventProto::OTHER, classifier);
+    EXPECT_EQ(metrics::OmniboxInputType::URL, input.type());
+    EXPECT_EQ(GURL("stainless://invalid/"), input.canonicalized_url());
+  }
+
+  const GURL unsupported("stainless://not-supported/fictional");
+  content::TestNavigationObserver observer(contents());
+  contents()->GetController().LoadURL(unsupported, content::Referrer(),
+                                      ui::PAGE_TRANSITION_TYPED, {});
+  observer.Wait();
+  EXPECT_FALSE(observer.last_navigation_succeeded());
+  EXPECT_EQ(net::ERR_UNKNOWN_URL_SCHEME, observer.last_net_error_code());
+  EXPECT_EQ(unsupported, contents()->GetVisibleURL());
+  EXPECT_FALSE(contents()->GetWebUI());
+  GURL view_source("view-source:stainless://settings/people");
+  content::BrowserURLHandler::GetInstance()->RewriteURLIfNecessary(
+      &view_source, browser()->GetProfile());
+  EXPECT_TRUE(view_source.IsAboutBlank());
+}
