+class StainlessInternalURLsBrowserTest : public InProcessBrowserTest {
+ public:
+  void SetUpCommandLine(base::CommandLine* command) override {
+    command->AppendSwitchASCII("headless", "new");
+    command->AppendSwitch("use-mock-keychain");
+    command->AppendSwitchASCII("lang", "en-US");
+  }
+
+  void SetUpOnMainThread() override {
+    ASSERT_TRUE(display::Screen::Get()->IsHeadless());
+  }
+
+  content::WebContents* contents() {
+    return browser()->GetTabStripModel()->GetActiveWebContents();
+  }
+
+  void CheckAddress(const char* canonical, const char* visible) {
+    ASSERT_TRUE(base::test::RunUntil(
+        [&] { return contents()->GetVisibleURL() == GURL(visible); }));
+    EXPECT_EQ(GURL(canonical), contents()->GetLastCommittedURL());
+    EXPECT_EQ(GURL(visible), contents()->GetVisibleURL());
+    auto* model = LocationBarModel::From(browser());
+    ASSERT_TRUE(model);
+    EXPECT_EQ(GURL(visible), model->GetURL());
+    EXPECT_TRUE(model->GetFormattedFullURL().starts_with(u"stainless://"));
+    ASSERT_TRUE(contents()->GetWebUI());
+    EXPECT_EQ(
+        GURL(canonical).DeprecatedGetOriginAsURL(),
+        contents()->GetPrimaryMainFrame()->GetLastCommittedOrigin().GetURL());
+  }
+};
