+IN_PROC_BROWSER_TEST_F(StainlessInternalURLsBrowserTest,
+                       TypedAddressRoutesReloadsAndHistoryKeepTheAlias) {
+  ui_test_utils::SendToOmniboxAndSubmit(browser(),
+                                        "stainless://settings/people");
+  ASSERT_TRUE(content::WaitForLoadStop(contents()));
+  CheckAddress("chrome://settings/people", "stainless://settings/people");
+  ASSERT_TRUE(content::ExecJs(contents(), R"JS(
+    (async () => {
+      const {Router, routes} = await import('chrome://settings/settings.js');
+      Router.getInstance().navigateTo(routes.SECURITY);
+    })();
+  )JS"));
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return contents()->GetVisibleURL() == GURL("stainless://settings/security");
+  }));
+  CheckAddress("chrome://settings/security", "stainless://settings/security");
+  chrome::Reload(browser(), WindowOpenDisposition::kCurrentTab);
+  ASSERT_TRUE(content::WaitForLoadStop(contents()));
+  CheckAddress("chrome://settings/security", "stainless://settings/security");
+
+  chrome::GoBack(browser(), WindowOpenDisposition::kCurrentTab);
+  ASSERT_TRUE(content::WaitForLoadStop(contents()));
+  CheckAddress("chrome://settings/people", "stainless://settings/people");
+  chrome::GoForward(browser(), WindowOpenDisposition::kCurrentTab);
+  ASSERT_TRUE(content::WaitForLoadStop(contents()));
+  CheckAddress("chrome://settings/security", "stainless://settings/security");
+  ASSERT_TRUE(content::ExecJs(contents(), R"JS(
+    history.replaceState({}, '', '/people?fictional=a%2Fb#roster');
+  )JS"));
+  CheckAddress("chrome://settings/people?fictional=a%2Fb#roster",
+               "stainless://settings/people?fictional=a%2Fb#roster");
+  chrome::Reload(browser(), WindowOpenDisposition::kCurrentTab);
+  ASSERT_TRUE(content::WaitForLoadStop(contents()));
+  CheckAddress("chrome://settings/people?fictional=a%2Fb#roster",
+               "stainless://settings/people?fictional=a%2Fb#roster");
+}
