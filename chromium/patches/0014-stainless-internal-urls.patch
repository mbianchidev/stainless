+IN_PROC_BROWSER_TEST_F(StainlessInternalURLsBrowserTest,
+                       ExtensionOverridesKeepTheirActualUnprivilegedOrigin) {
+  browser()->GetProfile()->GetPrefs()->SetBoolean(
+      prefs::kExtensionsUIDeveloperMode, true);
+  extensions::TestExtensionDir directory;
+  directory.WriteManifest(R"JSON({
+    "name": "Fictional bookmarks override", "version": "1",
+    "manifest_version": 3,
+    "chrome_url_overrides": {"bookmarks": "bookmarks.html"}
+  })JSON");
+  directory.WriteFile(FILE_PATH_LITERAL("bookmarks.html"),
+                      "<title>Fictional extension bookmarks</title>");
+  auto installer =
+      extensions::UnpackedInstaller::Create(browser()->GetProfile());
+  installer->set_be_noisy_on_failure(false);
+  base::test::TestFuture<const extensions::Extension*, base::FilePath,
+                         std::u16string>
+      completion;
+  installer->set_completion_callback(
+      completion.GetCallback<const extensions::Extension*,
+                             const base::FilePath&, const std::u16string&>());
+  installer->Load(directory.UnpackedPath());
+  ASSERT_TRUE(completion.Wait());
+  const auto* extension = completion.Get<0>();
+  ASSERT_TRUE(extension) << completion.Get<2>();
+  ASSERT_TRUE(
+      ui_test_utils::NavigateToURL(browser(), GURL("stainless://bookmarks/")));
+  const GURL destination = extension->GetResourceURL("bookmarks.html");
+  EXPECT_EQ(destination, contents()->GetLastCommittedURL());
+  EXPECT_EQ(destination, contents()->GetVisibleURL());
+  EXPECT_FALSE(contents()->GetWebUI());
+  EXPECT_FALSE(
+      content::ChildProcessSecurityPolicy::GetInstance()->CanRequestURL(
+          contents()->GetPrimaryMainFrame()->GetProcess()->GetDeprecatedID(),
+          GURL("stainless://settings/people")));
+}
+
+IN_PROC_BROWSER_TEST_F(StainlessInternalURLsBrowserTest,
+                       WebContentCannotRequestAliasesOrSpoofTheAddress) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  const GURL external = embedded_test_server()->GetURL("/empty.html");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), external));
+  auto* policy = content::ChildProcessSecurityPolicy::GetInstance();
+  auto* process = contents()->GetPrimaryMainFrame()->GetProcess();
+  EXPECT_FALSE(policy->IsWebSafeScheme("stainless"));
+  EXPECT_FALSE(policy->CanRequestURL(process->GetDeprecatedID(),
+                                     GURL("stainless://settings/people")));
+  EXPECT_EQ("SecurityError", content::EvalJs(contents(), R"JS(
+    (() => {
+      try {
+        history.replaceState({}, '', 'stainless://settings/people');
+        return 'unexpected success';
+      } catch (error) {
+        return error.name;
+      }
+    })();
+  )JS"));
+  EXPECT_EQ("SecurityError", content::EvalJs(contents(), R"JS(
+    (() => {
+      try {
+        navigator.registerProtocolHandler('stainless', location.origin + '/?url=%s');
+        return 'unexpected success';
+      } catch (error) {
+        return error.name;
+      }
+    })();
+  )JS"));
+  EXPECT_EQ("blocked", content::EvalJs(contents(), R"JS(
+    fetch('stainless://settings/people')
+        .then(() => 'unexpected success', () => 'blocked');
+  )JS"));
+  EXPECT_EQ(external, contents()->GetVisibleURL());
+  EXPECT_FALSE(contents()->GetWebUI());
+  {
+    content::TestNavigationObserver observer(contents());
+    contents()->GetController().LoadURL(
+        embedded_test_server()->GetURL(
+            "/server-redirect?stainless://settings/people"),
+        content::Referrer(), ui::PAGE_TRANSITION_TYPED, {});
+    observer.Wait();
+    EXPECT_FALSE(observer.last_navigation_succeeded());
+    EXPECT_NE(net::OK, observer.last_net_error_code());
+    EXPECT_FALSE(contents()->GetWebUI());
+  }
+
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), GURL("stainless://settings/people")));
+  auto* webui_process = contents()->GetPrimaryMainFrame()->GetProcess();
+  EXPECT_FALSE(policy->CanRequestURL(webui_process->GetDeprecatedID(),
+                                     GURL("stainless://settings/people")));
+  EXPECT_TRUE(policy->CanRequestURL(webui_process->GetDeprecatedID(),
+                                    GURL("chrome://settings/people")));
+  EXPECT_EQ("chrome://settings",
+            content::EvalJs(contents(), "location.origin"));
+  EXPECT_TRUE(content::EvalJs(contents(), R"JS(
+    new Promise(resolve => {
+      document.addEventListener('securitypolicyviolation', event => {
+        if (event.violatedDirective.startsWith('script-src')) {
+          resolve(!window.fictionalInlineScriptRan);
+        }
+      }, {once: true});
+      const script = document.createElement('script');
+      try {
+        script.textContent = 'window.fictionalInlineScriptRan = true;';
+        document.body.append(script);
+      } catch (error) {
+        if (error.name !== 'TypeError') throw error;
+        resolve(!window.fictionalInlineScriptRan);
+      }
+    });
+  )JS")
+                  .ExtractBool());
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), external));
+  EXPECT_EQ(external, contents()->GetVisibleURL());
+  EXPECT_FALSE(contents()->GetWebUI());
+  contents()->GetController().GoBack();
+  ASSERT_TRUE(content::WaitForLoadStop(contents()));
+  CheckAddress("chrome://settings/people", "stainless://settings/people");
+}
+
+class StainlessInternalURLsForcedIncognitoBrowserTest
+    : public StainlessInternalURLsBrowserTest {
+ public:
+  void SetUpCommandLine(base::CommandLine* command) override {
+    StainlessInternalURLsBrowserTest::SetUpCommandLine(command);
+    command->AppendSwitch("incognito");
+    command->AppendSwitchASCII("stainless-managed-mode", "incognito");
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(StainlessInternalURLsForcedIncognitoBrowserTest,
+                       AliasesCannotEscapeForcedPrivateMode) {
+  ASSERT_TRUE(browser()->GetProfile()->IsOffTheRecord());
+  const GURL previous = contents()->GetVisibleURL();
+  for (const char* text : {
+           "chrome://settings/people",
+           "stainless://settings/people",
+           "STAINLESS://SETTINGS/people",
+           "stainless://help/",
+           "stainless://history/",
+           "stainless://extensions/",
+           "stainless://password-manager/settings",
+           "view-source:stainless://settings/people",
+       }) {
+    SCOPED_TRACE(text);
+    const GURL url(text);
+    EXPECT_FALSE(IsURLAllowedInIncognito(url));
+    NavigateParams params(browser(), url, ui::PAGE_TRANSITION_TYPED);
+    EXPECT_FALSE(Navigate(&params));
+    EXPECT_FALSE(params.navigated_or_inserted_contents);
+    EXPECT_EQ(previous, contents()->GetVisibleURL());
+    EXPECT_TRUE(browser()->GetProfile()->IsOffTheRecord());
+  }
+}
