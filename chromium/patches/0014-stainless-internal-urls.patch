+IN_PROC_BROWSER_TEST_F(StainlessInternalURLsBrowserTest,
+                       CanonicalSettingsKeepsItsOriginAndBrandsTheAddress) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(),
+                                           GURL("chrome://settings/people")));
+  CheckAddress("chrome://settings/people", "stainless://settings/people");
+  auto* model = LocationBarModel::From(browser());
+  ASSERT_TRUE(model);
+  EXPECT_EQ(u"stainless://settings/people", model->GetURLForDisplay());
+  const auto* icon = &model->GetVectorIcon();
+  EXPECT_TRUE(icon == &omnibox::kChromeProductIcon ||
+              icon == &omnibox::kProductChromeRefreshOldIcon);
+  ASSERT_TRUE(ShowPageInfoDialog(contents(), {},
+                                 bubble_anchor_util::Anchor::kLocationBar));
+  EXPECT_EQ(PageInfoBubbleViewBase::BUBBLE_INTERNAL_PAGE,
+            PageInfoBubbleViewBase::GetShownBubbleTypeForTesting(contents()));
+  auto* bubble =
+      PageInfoBubbleViewBase::GetPageInfoBubbleForTesting(contents());
+  ASSERT_TRUE(bubble);
+  bubble->GetWidget()->CloseNow();
+
+  auto* history_service = HistoryServiceFactory::GetForProfile(
+      browser()->GetProfile(), ServiceAccessType::EXPLICIT_ACCESS);
+  ASSERT_TRUE(history_service);
+  base::test::TestFuture<void> flushed;
+  history_service->FlushForTest(flushed.GetCallback());
+  ASSERT_TRUE(flushed.Wait());
+  for (const char* text :
+       {"chrome://settings/people", "stainless://settings/people"}) {
+    base::CancelableTaskTracker tracker;
+    base::test::TestFuture<history::QueryURLAndVisitsResult> result;
+    history_service->QueryURLAndVisits(
+        GURL(text), history::VisitQuery404sPolicy::kInclude404s,
+        result.GetCallback(), &tracker);
+    EXPECT_FALSE(result.Take().success);
+  }
+}
