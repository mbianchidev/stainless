+namespace {
+
+class OwnedProfileInfoHandler : public settings::ProfileInfoHandler {
+ public:
+  using settings::ProfileInfoHandler::ProfileInfoHandler;
+  using settings::ProfileInfoHandler::set_web_ui;
+};
+
+bool HasLabel(views::View* view, const std::u16string& text) {
+  if (const auto* label = views::AsViewClass<views::Label>(view);
+      label && label->IsDrawn() && label->GetText() == text) {
+    return true;
+  }
+  for (views::View* child : view->children()) {
+    if (HasLabel(child, text)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace
+
+class StainlessProfilesSettingsBrowserTest : public InProcessBrowserTest {
+ public:
+  void SetUpCommandLine(base::CommandLine* command) override {
+    command->AppendSwitchASCII("headless", "new");
+    command->AppendSwitch("use-mock-keychain");
+    command->AppendSwitchASCII("lang", "en-US");
+  }
+
+  void SetUpOnMainThread() override {
+    ASSERT_TRUE(display::Screen::Get()->IsHeadless());
+  }
+
+  ProfileAttributesStorage& storage() {
+    return g_browser_process->profile_manager()->GetProfileAttributesStorage();
+  }
+
+  base::FilePath AddFictionalProfile(const char* directory,
+                                     const std::u16string& name,
+                                     bool omitted = false) {
+    ProfileAttributesInitParams params;
+    params.profile_path =
+        g_browser_process->profile_manager()->user_data_dir().AppendASCII(
+            directory);
+    params.profile_name = name;
+    params.is_ephemeral = omitted;
+    params.is_omitted = omitted;
+    const auto path = params.profile_path;
+    storage().AddProfile(std::move(params));
+    return path;
+  }
+
+  bool RosterHasExactly(const std::string& expected) {
+    auto* contents = browser()->GetTabStripModel()->GetActiveWebContents();
+    return content::EvalJs(contents, content::JsReplace(R"JS(
+      (() => {
+        function find(root) {
+          for (const element of root.querySelectorAll('*')) {
+            if (element.localName === 'settings-people-page') return element;
+            if (element.shadowRoot) {
+              const found = find(element.shadowRoot);
+              if (found) return found;
+            }
+          }
+          return null;
+        }
+        const page = find(document);
+        if (!page) return false;
+        const names = [...page.shadowRoot.querySelectorAll(
+            '#local-profiles-list .local-profile-name')]
+            .map(element => element.textContent.trim());
+        const list = page.shadowRoot.querySelector('#local-profiles-list');
+        return names.join('|') === $1 &&
+            (names.length === 0 || (list && list.checkVisibility() &&
+                list.getBoundingClientRect().height > 0));
+      })();
+    )JS",
+                                                        expected))
+        .ExtractBool();
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(StainlessProfilesSettingsBrowserTest,
+                       SettingsShowsTheActualLocalRosterAndLiveChanges) {
+  const auto beta =
+      AddFictionalProfile("FictionalBeta", u"Fictional Local Beta");
+  AddFictionalProfile("FictionalOmitted", u"Fictional Hidden Profile", true);
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(),
+                                           GURL("chrome://settings/people")));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return RosterHasExactly("Fictional Local Beta"); }));
+  auto* entry = storage().GetProfileAttributesWithPath(beta);
+  ASSERT_TRUE(entry);
+  entry->SetLocalProfileName(u"Fictional Renamed Profile", false);
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return RosterHasExactly("Fictional Renamed Profile"); }));
+  entry->SetIsEphemeral(true);
+  entry->SetIsOmitted(true);
+  ASSERT_TRUE(base::test::RunUntil([&] { return RosterHasExactly(""); }));
+  entry->SetIsOmitted(false);
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return RosterHasExactly("Fictional Renamed Profile"); }));
+  storage().RemoveProfile(beta);
+  ASSERT_TRUE(base::test::RunUntil([&] { return RosterHasExactly(""); }));
+}
+
+IN_PROC_BROWSER_TEST_F(StainlessProfilesSettingsBrowserTest,
+                       PrivateContextsAndStoppedObserversDoNotExposeTheRoster) {
+  const auto beta =
+      AddFictionalProfile("FictionalBeta", u"Fictional Local Beta");
+  {
+    content::TestWebUI web_ui;
+    OwnedProfileInfoHandler handler(
+        browser()->GetProfile()->GetPrimaryOTRProfile(true));
+    handler.set_web_ui(&web_ui);
+    handler.RegisterMessages();
+    web_ui.HandleReceivedMessage("getLocalProfiles",
+                                 base::ListValue().Append("private-callback"));
+    ASSERT_FALSE(web_ui.call_data().empty());
+    const auto& state = web_ui.call_data().back()->arg3()->GetDict();
+    EXPECT_EQ(false, state.FindBool("available"));
+    ASSERT_TRUE(state.FindList("profiles"));
+    EXPECT_TRUE(state.FindList("profiles")->empty());
+  }
+  content::TestWebUI web_ui;
+  OwnedProfileInfoHandler handler(browser()->GetProfile());
+  handler.set_web_ui(&web_ui);
+  handler.RegisterMessages();
+  web_ui.HandleReceivedMessage("getLocalProfiles",
+                               base::ListValue().Append("normal-callback"));
+  const auto& state = web_ui.call_data().back()->arg3()->GetDict();
+  ASSERT_TRUE(state.FindList("profiles"));
+  ASSERT_EQ(1U, state.FindList("profiles")->size());
+  const auto& item = state.FindList("profiles")->front().GetDict();
+  EXPECT_EQ(2U, item.size());
+  EXPECT_EQ("Fictional Local Beta", *item.FindString("name"));
+  EXPECT_TRUE(item.FindString("iconUrl")->starts_with("data:image/png"));
+  web_ui.HandleReceivedMessage("stopLocalProfiles", base::ListValue());
+  web_ui.ClearTrackedCalls();
+  storage().GetProfileAttributesWithPath(beta)->SetLocalProfileName(
+      u"Fictional After Stop", false);
+  for (const auto& call : web_ui.call_data()) {
+    if (call->function_name() == "cr.webUIListenerCallback") {
+      EXPECT_NE("local-profiles-changed", call->arg1()->GetString());
+    }
+  }
+}
+
+IN_PROC_BROWSER_TEST_F(StainlessProfilesSettingsBrowserTest,
+                       NativeProfileMenuUsesStainlessServicesBranding) {
+  auto* coordinator = ProfileMenuCoordinator::From(browser());
+  ASSERT_TRUE(coordinator);
+  coordinator->Show(/*is_source_accelerator=*/false,
+                    /*from_avatar_promo=*/false);
+  ASSERT_TRUE(base::test::RunUntil([&] { return coordinator->IsShowing(); }));
+  auto* menu = coordinator->GetProfileMenuViewBaseForTesting();
+  ASSERT_TRUE(menu);
+  EXPECT_TRUE(menu->GetWidget()->IsVisible());
+  EXPECT_TRUE(HasLabel(menu, u"Stainless Services Settings"));
+  EXPECT_FALSE(HasLabel(menu, u"Google Services Settings"));
+  menu->GetWidget()->CloseNow();
+}
