+
+void ProfileInfoHandler::HandleStopLocalProfiles(const base::ListValue& args) {
+  CHECK(args.empty());
+  local_profiles_requested_ = false;
+}
+
+base::DictValue ProfileInfoHandler::GetLocalProfilesInfo() {
+  base::DictValue response;
+  base::ListValue entries;
+  bool available = false;
+#if !BUILDFLAG(IS_CHROMEOS)
+  available = profile_->IsRegularProfile();
+  if (available) {
+    for (ProfileAttributesEntry* entry :
+         g_browser_process->profile_manager()
+             ->GetProfileAttributesStorage()
+             .GetAllProfilesAttributesSortedByNameWithCheck()) {
+      if (entry->GetPath() == profile_->GetPath() || entry->IsOmitted()) {
+        continue;
+      }
+      entries.Append(
+          base::DictValue()
+              .Set("name", base::UTF16ToUTF8(entry->GetName()))
+              .Set("iconUrl",
+                   AvatarIconUrl(*entry, web_ui()->GetDeviceScaleFactor())));
+    }
+  }
+#endif
+  response.Set("available", available);
+  response.Set("profiles", std::move(entries));
+  return response;
+}
