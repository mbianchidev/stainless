new file mode 100644
index 0000000000000000000000000000000000000000..6391e58be8fb0e122d7520a453680500abf07fea
--- /dev/null
+++ b/chrome/browser/stainless_local/local_translation.cc
@@ -0,0 +1,751 @@
+#include "chrome/browser/stainless_local/local_translation.h"
+
+#include <algorithm>
+#include <string_view>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/json/json_writer.h"
+#include "base/logging.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/stainless_local/local_broker.h"
+#include "chrome/browser/stainless_local/local_models.h"
+#include "chrome/common/chrome_isolated_world_ids.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "third_party/cld_3/src/src/nnet_language_identifier.h"
+
+namespace stainless_local {
+namespace {
+
+constexpr size_t kMaximumScalars = 100000;
+constexpr auto kPageDeadline = base::Minutes(5);
+
+constexpr char kCollect[] = R"JS(
+(args => {
+  const [operation, selectionOnly, maximum] = args;
+  if (!['text/html', 'application/xhtml+xml'].includes(document.contentType))
+    return {status: 'unsupported'};
+  const previous = globalThis.__stainlessLocalTranslation;
+  if (previous?.slots.some(slot => slot.output !== null))
+    return {status: 'needs-restore'};
+  const selection = selectionOnly ? getSelection() : null;
+  if (selectionOnly && (!selection || selection.rangeCount !== 1 || selection.isCollapsed))
+    return {status: 'no-selection'};
+  const range = selectionOnly ? selection.getRangeAt(0) : null;
+  const slots = [];
+  const nodes = [];
+  const eligible = parent => {
+    if (!parent || parent.isContentEditable ||
+        parent.closest('script,style,noscript,template,input,textarea,select,option'))
+      return false;
+    for (let element = parent; element; element = element.parentElement) {
+      const mode = element.getAttribute('translate')?.toLowerCase();
+      if (mode === 'no') return false;
+      if (mode === '' || mode === 'yes') break;
+    }
+    return true;
+  };
+  let count = 0;
+  const walker = document.createTreeWalker(document.body || document.documentElement,
+                                            NodeFilter.SHOW_TEXT);
+  while (walker.nextNode()) {
+    const node = walker.currentNode;
+    const parent = node.parentElement;
+    if (!eligible(parent) || !node.data.trim()) continue;
+    if (range && !range.intersectsNode(node)) continue;
+    const start = range?.startContainer === node ? range.startOffset : 0;
+    const end = range?.endContainer === node ? range.endOffset : node.length;
+    const text = node.data.slice(start, end);
+    if (!text.trim()) continue;
+    for (const scalar of text) {
+      if (++count > maximum) return {status: 'limit'};
+    }
+    const id = slots.length;
+    slots.push({node, parent, original: node.data, start, end, output: null});
+    nodes.push({id, text,
+                lang: (parent.closest('[lang]')?.getAttribute('lang') || '').slice(0, 128)});
+  }
+  globalThis.__stainlessLocalTranslation = {operation, slots, eligible};
+  return {status: 'ok', count,
+          author: (document.documentElement.lang || '').slice(0, 128), nodes};
+})
+)JS";
+
+constexpr char kApply[] = R"JS(
+(args => {
+  const [operation, id, text] = args;
+  const state = globalThis.__stainlessLocalTranslation;
+  const slot = state?.operation === operation ? state.slots[id] : null;
+  if (!slot || !slot.node.isConnected || slot.node.ownerDocument !== document ||
+      slot.node.parentElement !== slot.parent ||
+      !state.eligible(slot.node.parentElement) || slot.node.data !== slot.original)
+    return false;
+  slot.output = slot.original.slice(0, slot.start) + text + slot.original.slice(slot.end);
+  slot.node.data = slot.output;
+  return true;
+})
+)JS";
+
+constexpr char kRestore[] = R"JS(
+(operation => {
+  const state = globalThis.__stainlessLocalTranslation;
+  if (!state || state.operation !== operation) return {restored: 0, changed: 0};
+  let restored = 0, changed = 0;
+  for (const slot of state.slots) {
+    if (slot.output === null) continue;
+    if (slot.node.isConnected && slot.node.ownerDocument === document &&
+        slot.node.parentElement === slot.parent &&
+        state.eligible(slot.node.parentElement) && slot.node.data === slot.output) {
+      slot.node.data = slot.original;
+      restored++;
+    } else {
+      changed++;
+    }
+  }
+  delete globalThis.__stainlessLocalTranslation;
+  return {restored, changed};
+})
+)JS";
+
+std::string Language(std::string_view value) {
+  const auto separator = value.find('-');
+  const auto primary = base::ToLowerASCII(value.substr(0, separator));
+  return primary == "en" || primary == "it" || primary == "fr" ||
+                 primary == "de" || primary == "es"
+             ? primary
+             : "";
+}
+
+bool Document(content::RenderFrameHost* frame) {
+  if (!frame || !frame->IsActive() || !frame->IsRenderFrameLive() ||
+      frame->IsErrorDocument() || frame->IsNestedWithinFencedFrame()) {
+    return false;
+  }
+  const auto& origin = frame->GetLastCommittedOrigin();
+  return !origin.opaque() &&
+         (origin.scheme() == "https" || origin.scheme() == "http" ||
+          origin.scheme() == "file");
+}
+
+size_t Scalars(std::string_view text) {
+  const auto utf16 = base::UTF8ToUTF16(text);
+  return std::ranges::count_if(
+      utf16, [](char16_t value) { return value < 0xdc00 || value > 0xdfff; });
+}
+
+std::vector<std::string> Chunks(const std::string& text) {
+  std::vector<std::string> result;
+  size_t offset = 0;
+  while (offset < text.size()) {
+    size_t end = offset;
+    size_t count = 0;
+    size_t space = offset;
+    while (end < text.size() && count < 256) {
+      const auto first = static_cast<unsigned char>(text[end]);
+      const size_t width = first < 0x80   ? 1
+                           : first < 0xe0 ? 2
+                           : first < 0xf0 ? 3
+                                          : 4;
+      if (end + width - offset > 768) {
+        break;
+      }
+      if (first < 0x80 && base::IsAsciiWhitespace(first)) {
+        space = end + width;
+      }
+      end += width;
+      ++count;
+    }
+    if (end < text.size() && space > offset) {
+      end = space;
+    }
+    if (end == offset) {
+      return {};
+    }
+    result.push_back(text.substr(offset, end - offset));
+    offset = end;
+  }
+  return result;
+}
+
+void Script(content::RenderFrameHost* frame,
+            std::string_view function,
+            base::Value arguments,
+            content::RenderFrameHost::JavaScriptResultCallback callback) {
+  auto json = base::WriteJson(arguments);
+  CHECK(json);
+  frame->ExecuteJavaScriptInIsolatedWorld(
+      base::UTF8ToUTF16("(" + std::string(function) + ")(" + *json + ")"),
+      std::move(callback), ISOLATED_WORLD_ID_STAINLESS_LOCAL);
+}
+
+LocalBroker::Prepared TranslationRequest(model_storage::Acquired acquired,
+                                         const std::string& text) {
+  LocalBroker::Prepared prepared;
+  auto model = mojom::TranslationModel::New();
+  for (auto& file : acquired.files) {
+    if (file->name == "source.spm") {
+      model->source_tokenizer = std::move(file);
+    } else if (file->name == "target.spm") {
+      model->target_tokenizer = std::move(file);
+    } else if (file->name == "model.bin" || file->name == "config.json" ||
+               file->name == "shared_vocabulary.json" ||
+               file->name == "vocabulary.json" ||
+               file->name == "source_vocabulary.json" ||
+               file->name == "target_vocabulary.json") {
+      model->files.push_back(std::move(file));
+    }
+  }
+  if (!model->source_tokenizer || !model->target_tokenizer ||
+      model->files.size() < 3 || model->files.size() > 4) {
+    prepared.error = "The installed translation pack layout is unavailable";
+    return prepared;
+  }
+  prepared.leases = std::move(acquired.leases);
+  auto request = mojom::TranslationRequest::New();
+  request->model = std::move(model);
+  request->text = text;
+  prepared.request = mojom::Request::NewTranslation(std::move(request));
+  return prepared;
+}
+
+}  // namespace
+
+struct LocalTranslation::Frame {
+  content::WeakDocumentPtr document;
+};
+
+struct LocalTranslation::Node {
+  size_t frame;
+  int id;
+  std::string text;
+};
