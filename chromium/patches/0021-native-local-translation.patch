+DEFINE_USER_DATA(StainlessTranslationView);
+
+StainlessTranslationView* StainlessTranslationView::Show(
+    BrowserWindowInterface* browser,
+    int command) {
+  if (!chrome::CanOpenLocalTranslation(browser) ||
+      (command != IDC_STAINLESS_TRANSLATE_PAGE &&
+       command != IDC_STAINLESS_TRANSLATE_SELECTION &&
+       command != IDC_STAINLESS_RESTORE_TRANSLATION) ||
+      !chrome::IsCommandEnabled(browser, command)) {
+    LOG(WARNING) << "Stainless local translation: native action unavailable";
+    return nullptr;
+  }
+  auto* tabs = browser->GetTabStripModel();
+  auto* contents = tabs ? tabs->GetActiveWebContents() : nullptr;
+  auto* owner = BrowserView::GetBrowserViewForBrowser(browser);
+  if (!contents || !owner || !owner->GetWidget() ||
+      owner->GetWidget()->IsClosed() ||
+      tabs->IsTabBlocked(tabs->active_index()) ||
+      contents->GetBrowserContext() != browser->GetProfile()) {
+    LOG(WARNING) << "Stainless local translation: native owner unavailable";
+    return nullptr;
+  }
+  auto* existing = Get(browser->GetUnownedUserDataHost());
+  for (views::Widget* widget :
+       views::Widget::GetAllOwnedWidgets(owner->GetWidget()->GetNativeView())) {
+    if ((!existing || widget != existing->GetWidget()) && !widget->IsClosed() &&
+        widget->IsVisible() && widget->widget_delegate() &&
+        widget->widget_delegate()->GetModalType() !=
+            ui::mojom::ModalType::kNone) {
+      LOG(WARNING)
+          << "Stainless local translation: another modal owns the window";
+      return nullptr;
+    }
+  }
+  if (existing &&
+      (existing->GetWidget()->IsClosed() || !existing->OwnsActiveDocument())) {
+    existing->GetWidget()->CloseNow();
+    existing = nullptr;
+  }
+  if (existing) {
+    existing->GetWidget()->Activate();
+    if (command == IDC_STAINLESS_RESTORE_TRANSLATION) {
+      existing->Restore();
+    }
+    return existing;
+  }
+  auto view = std::make_unique<StainlessTranslationView>(
+      browser, command == IDC_STAINLESS_TRANSLATE_SELECTION);
+  auto* result = view.get();
+  auto dialog = std::make_unique<views::DialogDelegate>();
+  dialog->SetTitle(l10n_util::GetStringUTF16(IDS_STAINLESS_TRANSLATION_TITLE));
+  dialog->SetButtons(static_cast<int>(ui::mojom::DialogButton::kCancel));
+  dialog->SetButtonLabel(
+      ui::mojom::DialogButton::kCancel,
+      l10n_util::GetStringUTF16(IDS_STAINLESS_COMMAND_PALETTE_CLOSE));
+  dialog->SetDefaultButton(static_cast<int>(ui::mojom::DialogButton::kNone));
+  dialog->SetModalType(ui::mojom::ModalType::kWindow);
+  dialog->set_margins(
+      ChromeLayoutProvider::Get()->GetDialogInsetsForContentType(
+          views::DialogContentType::kControl,
+          views::DialogContentType::kControl));
+  dialog->SetInitiallyFocusedView(result->source_);
+  dialog->SetContentsView(std::move(view));
+  auto* widget = views::DialogDelegate::CreateDialogWidget(
+      std::move(dialog), gfx::NativeWindow(),
+      owner->GetWidget()->GetNativeView());
+  result->widget_.Observe(widget);
+  if (command == IDC_STAINLESS_RESTORE_TRANSLATION) {
+    result->Restore();
+  } else if (result->translation_->state().can_restore) {
+    result->OnState(result->translation_->state());
+  } else {
+    result->Collect();
+  }
+  widget->Show();
+  return result;
+}
+
+StainlessTranslationView::StainlessTranslationView(
+    BrowserWindowInterface* browser,
+    bool selection)
+    : browser_(browser->GetWeakPtr()),
+      translation_(stainless_local::LocalTranslation::Get(
+                       browser->GetTabStripModel()->GetActiveWebContents())
+                       ->GetWeakPtr()),
+      document_(browser->GetTabStripModel()
+                    ->GetActiveWebContents()
+                    ->GetPrimaryMainFrame()
+                    ->GetWeakDocumentPtr()),
+      return_focus_(std::make_unique<views::ViewTracker>()),
+      selection_(selection) {
+  registration_.emplace(browser->GetUnownedUserDataHost(), *this);
+  browser_closed_ = browser->RegisterBrowserDidClose(base::BindRepeating(
+      &StainlessTranslationView::OnBrowserClosed, base::Unretained(this)));
+  auto* focus =
+      BrowserView::GetBrowserViewForBrowser(browser)->GetFocusManager();
+  return_focus_->SetView(focus->GetFocusedView() ? focus->GetFocusedView()
+                                                 : focus->GetStoredFocusView());
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(), 8));
+  auto label = [this](int message) {
+    auto* result = AddChildView(
+        std::make_unique<views::Label>(l10n_util::GetStringUTF16(message)));
+    result->SetMultiLine(true);
+    result->SetHorizontalAlignment(gfx::HorizontalAlignment::ALIGN_LEFT);
+    return result;
+  };
+  label(IDS_STAINLESS_TRANSLATION_EXPLANATION);
+  label(IDS_STAINLESS_TRANSLATION_SOURCE);
+  source_ = AddChildView(std::make_unique<views::Combobox>(
+      Languages(IDS_STAINLESS_TRANSLATION_CHOOSE_SOURCE)));
+  source_->GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_STAINLESS_TRANSLATION_SOURCE));
+  source_->SetCallback(base::BindRepeating(
+      &StainlessTranslationView::RefreshButtons, base::Unretained(this)));
+  label(IDS_STAINLESS_TRANSLATION_TARGET);
+  target_ = AddChildView(std::make_unique<views::Combobox>(
+      Languages(IDS_STAINLESS_TRANSLATION_CHOOSE_TARGET)));
+  target_->GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_STAINLESS_TRANSLATION_TARGET));
+  target_->SetSelectedIndex(
+      LanguageIndex(browser->GetProfile()->GetPrefs()->GetString(
+          stainless_local::kTranslationTarget)));
+  target_->SetCallback(base::BindRepeating(
+      &StainlessTranslationView::RefreshButtons, base::Unretained(this)));
+  auto* buttons = AddChildView(std::make_unique<views::View>());
+  buttons->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal, gfx::Insets(), 8));
+  auto button = [buttons](int message,
+                          views::Button::PressedCallback callback) {
+    return buttons->AddChildView(std::make_unique<views::MdTextButton>(
+        std::move(callback), l10n_util::GetStringUTF16(message)));
+  };
+  start_ = button(selection ? IDS_STAINLESS_TRANSLATION_START_SELECTION
+                            : IDS_STAINLESS_TRANSLATION_START_PAGE,
+                  base::BindRepeating(&StainlessTranslationView::Start,
+                                      base::Unretained(this)));
+  stop_ = button(IDS_STAINLESS_TRANSLATION_STOP,
+                 base::BindRepeating(&StainlessTranslationView::Stop,
+                                     base::Unretained(this)));
+  restore_ = button(IDS_STAINLESS_TRANSLATION_RESTORE_BUTTON,
+                    base::BindRepeating(&StainlessTranslationView::Restore,
+                                        base::Unretained(this)));
+  status_ = label(IDS_STAINLESS_TRANSLATION_LOADING);
+  status_->GetViewAccessibility().SetRole(ax::mojom::Role::kStatus);
+  status_->GetViewAccessibility().SetLiveRegionContainer(
+      views::ViewAccessibility::LiveRegionStatus::kPolite);
+  AddChildView(std::make_unique<views::MdTextButton>(
+      base::BindRepeating(&StainlessTranslationView::OpenSettings,
+                          base::Unretained(this)),
+      l10n_util::GetStringUTF16(IDS_STAINLESS_TRANSLATION_SETUP)));
+  SetPreferredSize(gfx::Size(580, 420));
+  RefreshButtons();
+}
+
+StainlessTranslationView::~StainlessTranslationView() {
+  weak_.InvalidateWeakPtrs();
+  if (translation_) {
+    translation_->Cancel();
+  }
+}
+
+bool StainlessTranslationView::OwnsActiveDocument() const {
+  return browser_ && !browser_->IsDeleteScheduled() && translation_ &&
+         document_.AsRenderFrameHostIfValid() &&
+         browser_->GetTabStripModel()->GetActiveWebContents() ==
+             content::WebContents::FromRenderFrameHost(
+                 document_.AsRenderFrameHostIfValid()) &&
+         chrome::CanOpenLocalTranslation(browser_.get());
+}
+
+void StainlessTranslationView::Collect() {
+  if (OwnsActiveDocument()) {
+    suggested_ = false;
+    translation_->Collect(
+        selection_, base::BindRepeating(&StainlessTranslationView::OnState,
+                                        weak_.GetWeakPtr()));
+  }
+}
+
+void StainlessTranslationView::Start() {
+  if (!OwnsActiveDocument() || !start_->GetEnabled()) {
+    LOG(WARNING) << "Stainless local translation: stale native start";
+    return;
+  }
+  translation_->Start(
+      std::string(kLanguages.at(source_->GetSelectedIndex().value_or(0))),
+      std::string(kLanguages.at(target_->GetSelectedIndex().value_or(0))));
+}
+
+void StainlessTranslationView::Restore() {
+  if (!OwnsActiveDocument()) {
+    status_->SetText(
+        l10n_util::GetStringUTF16(IDS_STAINLESS_TRANSLATION_OWNER_CHANGED));
+    RefreshButtons();
+    return;
+  }
+  if (!translation_->state().can_restore) {
+    status_->SetText(
+        l10n_util::GetStringUTF16(IDS_STAINLESS_TRANSLATION_NO_ORIGINAL));
+    RefreshButtons();
+    return;
+  }
+  translation_->Restore(base::BindRepeating(&StainlessTranslationView::OnState,
+                                            weak_.GetWeakPtr()));
+}
+
+void StainlessTranslationView::Stop() {
+  if (translation_) {
+    translation_->Cancel();
+  }
+  RefreshButtons();
+}
+
+void StainlessTranslationView::OpenSettings() {
+  open_settings_ = true;
+  GetWidget()->Close();
+}
+
+void StainlessTranslationView::OnState(
+    const stainless_local::LocalTranslation::State& state) {
+  const bool first_choice =
+      !suggested_ &&
+      state.phase == stainless_local::LocalTranslation::Phase::kChoosing;
+  if (first_choice) {
+    suggested_ = true;
+    source_->SetSelectedIndex(LanguageIndex(state.suggested_source));
+  }
+  const bool restoring =
+      state.phase == stainless_local::LocalTranslation::Phase::kRestoring ||
+      state.phase == stainless_local::LocalTranslation::Phase::kRestored;
+  const auto progress =
+      restoring ? l10n_util::GetStringFUTF16(
+                      IDS_STAINLESS_TRANSLATION_RESTORE_PROGRESS,
+                      base::NumberToString16(state.restored_nodes),
+                      base::NumberToString16(state.changed_nodes))
+                : l10n_util::GetStringFUTF16(
+                      IDS_STAINLESS_TRANSLATION_PROGRESS,
+                      base::NumberToString16(state.translated_nodes),
+                      base::NumberToString16(state.total_nodes),
+                      base::NumberToString16(state.changed_nodes),
+                      base::NumberToString16(state.unsupported_frames));
+  status_->SetText(progress + u"\n" + base::UTF8ToUTF16(state.detail));
+  RefreshButtons();
+  if (first_choice && source_->GetEnabled() && GetWidget() &&
+      GetWidget()->IsActive()) {
+    source_->RequestFocus();
+  }
+}
+
+void StainlessTranslationView::RefreshButtons() {
+  using Phase = stainless_local::LocalTranslation::Phase;
+  const bool owner = OwnsActiveDocument();
+  const auto phase = translation_ ? translation_->state().phase : Phase::kError;
+  const auto source = source_->GetSelectedIndex().value_or(0);
+  const auto target = target_->GetSelectedIndex().value_or(0);
+  const bool choosing = owner && phase == Phase::kChoosing;
+  source_->SetEnabled(choosing);
+  target_->SetEnabled(choosing);
+  start_->SetEnabled(choosing && source > 0 && target > 0 && source != target);
+  stop_->SetEnabled(
+      owner && (phase == Phase::kTranslating || phase == Phase::kCollecting));
+  restore_->SetEnabled(owner && translation_->state().can_restore &&
+                       phase != Phase::kRestoring);
+}
+
+void StainlessTranslationView::OnBrowserClosed(BrowserWindowInterface*) {
+  registration_.reset();
+  browser_.reset();
+  GetWidget()->Close();
+}
+
+void StainlessTranslationView::OnWidgetDestroyed(views::Widget*) {
+  weak_.InvalidateWeakPtrs();
+  if (translation_) {
+    translation_->Cancel();
+  }
+  widget_.Reset();
+  registration_.reset();
+  browser_closed_ = {};
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::WeakPtr<BrowserWindowInterface> browser, bool settings,
+             std::unique_ptr<views::ViewTracker> focus) {
+            if (!browser || browser->IsDeleteScheduled()) {
+              return;
+            }
+            if (settings) {
+              chrome::ShowSettingsSubPage(browser.get(), "localServices");
+            } else if (focus->view() && focus->view()->IsDrawn() &&
+                       focus->view()->IsFocusable()) {
+              focus->view()->RequestFocus();
+            } else if (auto* contents = browser->GetTabStripModel()
+                                            ->GetActiveWebContents()) {
+              contents->Focus();
+            }
+          },
+          browser_, open_settings_, std::move(return_focus_)));
+}
