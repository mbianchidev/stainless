+  void Notify();
+  bool Permitted() const;
+  void DidFinishNavigation(content::NavigationHandle* navigation) override;
+  void RenderFrameDeleted(content::RenderFrameHost* frame) override;
+  void WebContentsDestroyed() override;
+
+  std::vector<Frame> frames_;
+  std::vector<Node> nodes_;
+  std::vector<std::string> chunks_;
+  std::vector<std::pair<std::string, std::string>> routes_;
+  std::vector<std::string> detected_;
+  std::string operation_;
+  std::string node_result_;
+  std::string route_input_;
+  std::string chunk_prefix_;
+  std::string chunk_suffix_;
+  State state_;
+  Update update_;
+  base::TimeTicks deadline_;
+  base::OneShotTimer timer_;
+  base::UnguessableToken job_;
+  size_t frame_index_ = 0;
+  size_t node_index_ = 0;
+  size_t chunk_index_ = 0;
+  size_t route_index_ = 0;
+  size_t output_bytes_ = 0;
+  bool selection_ = false;
+  bool restoring_ = false;
+  base::WeakPtrFactory<LocalTranslation> weak_{this};
+  base::WeakPtrFactory<LocalTranslation> lifetime_{this};
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
