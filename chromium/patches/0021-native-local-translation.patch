+#ifndef CHROME_BROWSER_STAINLESS_LOCAL_LOCAL_TRANSLATION_H_
+#define CHROME_BROWSER_STAINLESS_LOCAL_LOCAL_TRANSLATION_H_
+
+#include <string>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "base/unguessable_token.h"
+#include "base/values.h"
+#include "chrome/services/stainless_local/public/mojom/local_worker.mojom.h"
+#include "content/public/browser/weak_document_ptr.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace stainless_local {
+
+class LocalTranslation final
+    : public content::WebContentsObserver,
+      public content::WebContentsUserData<LocalTranslation> {
+ public:
+  enum class Phase {
+    kIdle,
+    kCollecting,
+    kChoosing,
+    kTranslating,
+    kStopped,
+    kPartial,
+    kComplete,
+    kRestoring,
+    kRestored,
+    kError
+  };
+  struct State {
+    Phase phase = Phase::kIdle;
+    std::string detail;
+    std::string suggested_source;
+    size_t input_scalars = 0;
+    size_t total_nodes = 0;
+    size_t translated_nodes = 0;
+    size_t restored_nodes = 0;
+    size_t changed_nodes = 0;
+    size_t unsupported_frames = 0;
+    bool can_restore = false;
+  };
+  using Update = base::RepeatingCallback<void(const State&)>;
+
+  static LocalTranslation* Get(content::WebContents* contents);
+  ~LocalTranslation() override;
+  void Collect(bool selection, Update update);
+  void Start(const std::string& source, const std::string& target);
+  void Restore(Update update);
+  void Cancel();
+  const State& state() const { return state_; }
+  base::WeakPtr<LocalTranslation> GetWeakPtr() {
+    return lifetime_.GetWeakPtr();
+  }
+
+ private:
+  friend class content::WebContentsUserData<LocalTranslation>;
+  explicit LocalTranslation(content::WebContents* contents);
+  struct Frame;
+  struct Node;
+
+  void CollectFrame();
+  void Collected(size_t frame, base::Value result);
+  void NextNode();
+  void NextChunk();
+  void RunRoute();
+  void Translated(mojom::ResultPtr result);
