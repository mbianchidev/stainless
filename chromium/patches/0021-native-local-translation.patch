+namespace chrome {
+
+bool CanOpenLocalTranslation(BrowserWindowInterface* browser) {
+  return browser && !browser->IsDeleteScheduled() &&
+         browser->GetType() == BrowserWindowInterface::TYPE_NORMAL &&
+         stainless_local::IsEligibleProfile(browser->GetProfile());
+}
+
+void ShowLocalPageTranslation(BrowserWindowInterface* browser) {
+  StainlessTranslationView::Show(browser, IDC_STAINLESS_TRANSLATE_PAGE);
+}
+
+void ShowLocalSelectionTranslation(BrowserWindowInterface* browser) {
+  StainlessTranslationView::Show(browser, IDC_STAINLESS_TRANSLATE_SELECTION);
+}
