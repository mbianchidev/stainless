+class StainlessTranslationBrowserTest : public InProcessBrowserTest {
+ public:
+  using Translation = stainless_local::LocalTranslation;
+  using Phase = Translation::Phase;
+
+  void SetUpCommandLine(base::CommandLine* command) override {
+    const auto summary =
+        base::CommandLine::ForCurrentProcess()->GetSwitchValuePath(
+            "test-launcher-summary-output");
+    if (summary.IsAbsolute()) {
+      ASSERT_TRUE(cache_.CreateUniqueTempDirUnderPath(summary.DirName()));
+    } else {
+      ASSERT_TRUE(cache_.CreateUniqueTempDir());
+    }
+    base::FilePath canonical;
+    ASSERT_TRUE(base::NormalizeFilePath(cache_.GetPath(), &canonical));
+    command->AppendSwitchPath("disk-cache-dir", canonical);
+    command->AppendSwitchASCII("headless", "new");
+    command->AppendSwitch("use-mock-keychain");
+    command->AppendSwitchASCII("lang", "en-US");
+  }
+
+  void SetUpOnMainThread() override {
+    ASSERT_TRUE(display::Screen::Get()->IsHeadless());
+    host_resolver()->AddRule("*", "127.0.0.1");
+    embedded_test_server()->RegisterRequestHandler(base::BindRepeating(
+        &StainlessTranslationBrowserTest::Respond, base::Unretained(this)));
+    ASSERT_TRUE(embedded_test_server()->Start());
+  }
+
+  void TearDownOnMainThread() override {
+    if (auto* view = View()) {
+      view->GetWidget()->CloseNow();
+    }
+    if (auto* translation = Translation::FromWebContents(contents())) {
+      translation->Cancel();
+    }
+    base::RunLoop().RunUntilIdle();
+  }
+
+  content::WebContents* contents() {
+    return browser()->GetTabStripModel()->GetActiveWebContents();
+  }
+
+  Translation* translation() { return Translation::Get(contents()); }
+
+  StainlessTranslationView* View() {
+    return StainlessTranslationView::Get(browser()->GetUnownedUserDataHost());
+  }
+
+  void Document(std::string path, std::string html) {
+    base::AutoLock lock(documents_lock_);
+    documents_[std::move(path)] = std::move(html);
+  }
+
+  bool Navigate(std::string html) {
+    Document("/page", std::move(html));
+    return ui_test_utils::NavigateToURL(
+        browser(), embedded_test_server()->GetURL("one.test", "/page"));
+  }
+
+  void Enable() {
+    auto* models = stainless_local::LocalModels::Get(browser()->GetProfile());
+    ASSERT_TRUE(models);
+    ASSERT_TRUE(
+        models->ConfigureFeature("translation", true, true).has_value());
+  }
+
+  void Collect(bool selection = false) {
+    translation()->Collect(selection, {});
+    ASSERT_TRUE(base::test::RunUntil(
+        [&] { return translation()->state().phase != Phase::kCollecting; }));
+  }
+
+  void Choose(StainlessTranslationView* view, size_t source, size_t target) {
+    view->source_->SetSelectedIndex(source);
+    view->target_->SetSelectedIndex(target);
+    view->RefreshButtons();
+  }
+
+  void Press(views::View* control) {
+    control->RequestFocus();
+    control->OnKeyPressed(
+        ui::KeyEvent(ui::EventType::kKeyPressed, ui::VKEY_SPACE, 0));
+    control->OnKeyReleased(
+        ui::KeyEvent(ui::EventType::kKeyReleased, ui::VKEY_SPACE, 0));
+  }
+
+  bool Finished() {
+    return base::test::RunUntil([&] {
+      const auto phase = translation()->state().phase;
+      return phase == Phase::kComplete || phase == Phase::kPartial ||
+             phase == Phase::kError || phase == Phase::kStopped;
+    });
+  }
+
+  void Seed(const std::string& id) {
+    base::ScopedAllowBlockingForTesting blocking;
+    const auto root =
+        base::CommandLine::ForCurrentProcess()->GetSwitchValuePath(
+            "stainless-model-pack-fixture");
+    ASSERT_TRUE(root.IsAbsolute());
+    const auto& catalog = stainless_local::ModelCatalog();
+    const auto pack =
+        std::ranges::find(catalog, id, &stainless_local::ModelPack::id);
+    ASSERT_NE(catalog.end(), pack);
+    auto location = stainless_local::model_storage::ResolveLocation(
+        browser()->GetProfile()->GetPath().DirName());
+    ASSERT_TRUE(location.has_value()) << location.error();
+    auto reserved = stainless_local::model_storage::Reserve(*location, *pack);
+    ASSERT_TRUE(reserved.has_value()) << reserved.error();
+    base::File input(root.AppendASCII(GURL(pack->url).ExtractFileName()),
+                     base::File::FLAG_OPEN | base::File::FLAG_READ);
+    ASSERT_TRUE(input.IsValid());
+    std::array<uint8_t, 65536> bytes;
+    while (true) {
+      auto count = input.ReadAtCurrentPos(bytes);
+      ASSERT_TRUE(count.has_value());
+      if (!*count) {
+        break;
+      }
+      ASSERT_TRUE((*reserved)->archive_file.WriteAtCurrentPosAndCheck(
+          base::span(bytes).first(*count)));
+    }
+    auto installed = stainless_local::model_storage::Install(**reserved);
+    ASSERT_TRUE(installed.has_value()) << installed.error();
+  }
+
+  bool StartButtonEnabled() { return View()->start_->GetEnabled(); }
+  void StartWithKeyboard() { Press(View()->start_); }
+  void RestoreWithKeyboard() { Press(View()->restore_); }
+  views::Combobox* Source() { return View()->source_; }
+  views::Combobox* Target() { return View()->target_; }
+  views::Label* Status() { return View()->status_; }
+
+ private:
+  std::unique_ptr<net::test_server::HttpResponse> Respond(
+      const net::test_server::HttpRequest& request) {
+    base::AutoLock lock(documents_lock_);
+    auto found = documents_.find(request.relative_url);
+    if (found == documents_.end()) {
+      return nullptr;
+    }
+    auto response = std::make_unique<net::test_server::BasicHttpResponse>();
+    response->set_content_type("text/html; charset=utf-8");
+    response->AddCustomHeader(
+        "Content-Security-Policy",
+        "default-src 'none'; script-src 'none'; frame-src http://*.test:*");
+    response->set_content(found->second);
+    return response;
+  }
+
+  base::ScopedTempDir cache_;
+  base::Lock documents_lock_;
+  std::map<std::string, std::string> documents_ GUARDED_BY(documents_lock_);
+};
+
+IN_PROC_BROWSER_TEST_F(StainlessTranslationBrowserTest,
+                       AggregateUnicodeBoundaryAndIsolatedCollection) {
+  Enable();
+  Document("/child", "<html lang=en><body><p id=t></p>");
+  ASSERT_TRUE(
+      Navigate("<html lang=en><body><p id=t></p><iframe src=\"" +
+               embedded_test_server()->GetURL("two.test", "/child").spec() +
+               "\"></iframe>"));
+  auto* child = content::ChildFrameAt(contents()->GetPrimaryMainFrame(), 0);
+  ASSERT_TRUE(child);
+  ASSERT_TRUE(content::ExecJs(
+      contents(),
+      "document.querySelector('#t').textContent = '\\u{1f600}'.repeat(50000)"));
+  ASSERT_TRUE(content::ExecJs(
+      child, "document.querySelector('#t').textContent = 'b'.repeat(50000)"));
+  Collect();
+  ASSERT_EQ(Phase::kChoosing, translation()->state().phase)
+      << translation()->state().detail;
+  EXPECT_EQ(100000u, translation()->state().input_scalars);
+  EXPECT_EQ(2u, translation()->state().total_nodes);
+  EXPECT_EQ("undefined",
+            content::EvalJs(contents(),
+                            "typeof globalThis.__stainlessLocalTranslation"));
+  ASSERT_TRUE(content::ExecJs(
+      child, "document.querySelector('#t').firstChild.appendData('x')"));
+  Collect();
+  EXPECT_EQ(Phase::kError, translation()->state().phase);
+  EXPECT_NE(std::string::npos, translation()->state().detail.find("100,000"));
+  EXPECT_EQ(50001,
+            content::EvalJs(
+                child, "[...document.querySelector('#t').textContent].length"));
+  EXPECT_EQ(50000, content::EvalJs(
+                       contents(),
+                       "[...document.querySelector('#t').textContent].length"));
+  EXPECT_FALSE(translation()->state().can_restore);
+}
+
+IN_PROC_BROWSER_TEST_F(StainlessTranslationBrowserTest,
+                       FormEditableAndInheritedTranslateNoAreExcluded) {
+  Enable();
+  ASSERT_TRUE(Navigate(
+      "<html lang=en><body><p>Visible words.</p>"
+      "<input type=password value=fictional-password>"
+      "<textarea>fictional-editor</textarea>"
+      "<div contenteditable>fictional-editable</div>"
+      "<div translate=no>fictional-no<p>fictional-inherited</p>"
+      "<p translate=yes>Opted in.</p></div>"
+      "<script>fictional-script</script><style>fictional-style</style>"));
+  Collect();
+  ASSERT_EQ(Phase::kChoosing, translation()->state().phase);
+  EXPECT_EQ(23u, translation()->state().input_scalars);
+  EXPECT_EQ(2u, translation()->state().total_nodes);
+  EXPECT_EQ(
+      "fictional-password",
+      content::EvalJs(contents(), "document.querySelector('input').value"));
+  EXPECT_EQ(
+      "fictional-editor",
+      content::EvalJs(contents(), "document.querySelector('textarea').value"));
+}
+
+IN_PROC_BROWSER_TEST_F(StainlessTranslationBrowserTest,
+                       MixedSourceRequiresChoiceAndMissingPackIsExplicit) {
+  Enable();
+  Document("/child",
+           "<html lang=fr><body>Le robot rouge porte trois boites bleues. "
+           "Cette phrase francaise sert seulement de texte fictif.");
+  ASSERT_TRUE(
+      Navigate("<html lang=en><body>The red robot holds three blue boxes. "
+               "This English sentence is only a fictional browser test."
+               "<iframe src=\"" +
+               embedded_test_server()->GetURL("two.test", "/child").spec() +
+               "\"></iframe>"));
+  ASSERT_TRUE(chrome::ExecuteCommand(browser(), IDC_STAINLESS_TRANSLATE_PAGE));
+  ASSERT_TRUE(View());
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return translation()->state().phase == Phase::kChoosing; }));
+  EXPECT_TRUE(translation()->state().suggested_source.empty());
+  EXPECT_EQ(0u, Source()->GetSelectedIndex());
+  EXPECT_FALSE(StartButtonEnabled());
+  Choose(View(), 1, 2);
+  ASSERT_TRUE(StartButtonEnabled());
+  ui::AXNodeData data;
+  Source()->GetViewAccessibility().GetAccessibleNodeData(&data);
+  EXPECT_EQ(l10n_util::GetStringUTF16(IDS_STAINLESS_TRANSLATION_SOURCE),
+            data.GetString16Attribute(ax::mojom::StringAttribute::kName));
+  Target()->GetViewAccessibility().GetAccessibleNodeData(&data);
+  EXPECT_EQ(l10n_util::GetStringUTF16(IDS_STAINLESS_TRANSLATION_TARGET),
+            data.GetString16Attribute(ax::mojom::StringAttribute::kName));
+  Status()->GetViewAccessibility().GetAccessibleNodeData(&data);
+  EXPECT_EQ(ax::mojom::Role::kStatus, data.role);
+  StartWithKeyboard();
+  ASSERT_TRUE(Finished());
+  EXPECT_EQ(Phase::kError, translation()->state().phase);
+  EXPECT_FALSE(Status()->GetText().empty());
+  EXPECT_EQ(
+      "The red robot holds three blue boxes. "
+      "This English sentence is only a fictional browser test.",
+      content::EvalJs(contents(), "document.body.firstChild.data"));
+  ASSERT_TRUE(View()->GetFocusManager()->ProcessAccelerator(
