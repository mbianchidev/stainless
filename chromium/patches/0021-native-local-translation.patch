+WEB_CONTENTS_USER_DATA_KEY_IMPL(LocalTranslation);
+
+LocalTranslation* LocalTranslation::Get(content::WebContents* contents) {
+  CreateForWebContents(contents);
+  return FromWebContents(contents);
+}
+
+LocalTranslation::LocalTranslation(content::WebContents* contents)
+    : content::WebContentsObserver(contents),
+      content::WebContentsUserData<LocalTranslation>(*contents) {}
+
+LocalTranslation::~LocalTranslation() {
+  update_.Reset();
+  Cancel();
+}
+
+bool LocalTranslation::Permitted() const {
+  auto* profile =
+      Profile::FromBrowserContext(web_contents()->GetBrowserContext());
+  return IsEligibleProfile(profile) &&
+         profile->GetPrefs()->GetBoolean(kTranslationEnabled) &&
+         Document(web_contents()->GetPrimaryMainFrame());
+}
+
+void LocalTranslation::Notify() {
+  if (update_) {
+    update_.Run(state_);
+  }
+}
+
+void LocalTranslation::Collect(bool selection, Update update) {
+  Cancel();
+  update_ = std::move(update);
+  if (!Permitted()) {
+    Fail("Enable local translation in Stainless Local Services Settings first");
+    return;
+  }
+  if (state_.can_restore) {
+    Fail("Restore the original text before starting another translation");
+    return;
+  }
+  state_ = State();
+  restoring_ = false;
+  state_.phase = Phase::kCollecting;
+  selection_ = selection;
+  frames_.clear();
+  nodes_.clear();
+  detected_.clear();
+  frame_index_ = 0;
+  output_bytes_ = 0;
+  operation_ = base::UnguessableToken::Create().ToString();
+  deadline_ = base::TimeTicks::Now() + kPageDeadline;
+  timer_.Start(FROM_HERE, kPageDeadline,
+               base::BindOnce(&LocalTranslation::Fail, weak_.GetWeakPtr(),
+                              "The five-minute page operation expired; restore "
+                              "original remains available"));
+  if (selection) {
+    auto* frame = web_contents()->GetFocusedFrame();
+    if (!Document(frame) ||
+        frame->GetMainFrame() != web_contents()->GetPrimaryMainFrame()) {
+      Fail("Select text in a supported live web document");
+      return;
+    }
+    frames_.push_back({frame->GetWeakDocumentPtr()});
+  } else {
+    web_contents()->GetPrimaryMainFrame()->ForEachRenderFrameHost(
+        [&](content::RenderFrameHost* frame) {
+          if (Document(frame) &&
+              frame->GetMainFrame() == web_contents()->GetPrimaryMainFrame()) {
+            frames_.push_back({frame->GetWeakDocumentPtr()});
+          } else {
+            ++state_.unsupported_frames;
+          }
+        });
+  }
+  Notify();
+  CollectFrame();
+}
+
+void LocalTranslation::CollectFrame() {
+  if (!Permitted() || base::TimeTicks::Now() >= deadline_) {
+    Fail("Translation collection lost authorization or exceeded its deadline");
+    return;
+  }
+  if (frame_index_ == frames_.size()) {
+    if (nodes_.empty()) {
+      Fail("This document has no supported non-editable text to translate");
+      return;
+    }
+    state_.total_nodes = nodes_.size();
+    if (!detected_.empty() && !detected_[0].empty() &&
+        std::ranges::all_of(detected_, [&](const auto& value) {
+          return value == detected_[0];
+        })) {
+      state_.suggested_source = detected_[0];
+    }
+    state_.phase = Phase::kChoosing;
+    state_.detail =
+        state_.suggested_source.empty()
+            ? "Choose the source language; detection is unknown or mixed"
+            : "Confirm the source and target languages";
+    Notify();
+    return;
+  }
+  auto* frame = frames_[frame_index_].document.AsRenderFrameHostIfValid();
+  if (!Document(frame)) {
+    Fail("A frame changed during translation collection");
+    return;
+  }
+  base::ListValue arguments;
+  arguments.Append(operation_);
+  arguments.Append(selection_);
+  arguments.Append(static_cast<int>(kMaximumScalars - state_.input_scalars));
+  Script(frame, kCollect, base::Value(std::move(arguments)),
+         base::BindOnce(&LocalTranslation::Collected, weak_.GetWeakPtr(),
+                        frame_index_));
+}
+
+void LocalTranslation::Collected(size_t frame_index, base::Value result) {
+  if (frame_index != frame_index_ ||
+      !frames_[frame_index].document.AsRenderFrameHostIfValid() ||
+      !result.is_dict()) {
+    Fail("Translation collection returned an invalid or stale document result");
+    return;
+  }
+  const auto& value = result.GetDict();
+  const auto* status = value.FindString("status");
+  if (!status || *status == "limit") {
+    Fail(
+        "A page or selection is limited to 100,000 Unicode scalar values "
+        "across all participating frames");
+    return;
+  }
+  if (*status == "unsupported") {
+    ++state_.unsupported_frames;
+    ++frame_index_;
+    CollectFrame();
+    return;
+  }
+  if (*status != "ok") {
+    Fail(*status == "needs-restore"
+             ? "Restore original before a new translation"
+             : "No supported live text selection is available");
+    return;
+  }
+  const auto* nodes = value.FindList("nodes");
+  const auto* author = value.FindString("author");
+  const auto reported = value.FindInt("count");
+  if (!nodes || nodes->size() > kMaximumScalars || !reported || *reported < 0 ||
+      !author || author->size() > 512) {
+    Fail("Translation collection exceeded its bounded result shape");
+    return;
+  }
+  const auto previous = state_.input_scalars;
+  std::string sample;
+  std::vector<std::string> hints;
+  for (const auto& item : *nodes) {
+    const auto* node = item.GetIfDict();
+    const auto id = node ? node->FindInt("id") : std::nullopt;
+    const auto* text = node ? node->FindString("text") : nullptr;
+    const auto* language = node ? node->FindString("lang") : nullptr;
+    if (!id || *id < 0 || !text || text->empty() ||
+        text->size() > kMaximumScalars * 4 || !language ||
+        language->size() > 512 || !base::IsStringUTF8(*text) ||
+        text->find('\0') != std::string::npos) {
+      Fail("Translation collection returned invalid text metadata");
+      return;
+    }
+    const auto count = Scalars(*text);
+    if (count > kMaximumScalars - state_.input_scalars) {
+      Fail("The aggregate 100,000 Unicode scalar input limit was exceeded");
+      return;
+    }
+    state_.input_scalars += count;
+    nodes_.push_back({frame_index, *id, *text});
+    if (sample.size() < 4096) {
+      auto end = std::min(text->size(), 4095 - sample.size());
+      while (end > 0 && end < text->size() &&
+             (static_cast<unsigned char>((*text)[end]) & 0xc0) == 0x80) {
+        --end;
+      }
+      sample.append(*text, 0, end);
+      sample.push_back(' ');
+    }
+    if (language && !language->empty()) {
+      hints.push_back(Language(*language));
+    }
+  }
+  if (state_.input_scalars - previous != static_cast<size_t>(*reported)) {
+    Fail("Translation collection did not balance its Unicode input count");
+    return;
+  }
+  if (nodes->empty()) {
+    ++frame_index_;
+    CollectFrame();
+    return;
+  }
+  std::string detected = author ? Language(*author) : "";
+  chrome_lang_id::NNetLanguageIdentifier identifier(0, 4096);
+  const auto inferred = identifier.FindLanguage(sample);
+  if (inferred.is_reliable) {
+    const auto local = Language(inferred.language);
+    detected = detected.empty() ? local : detected == local ? detected : "";
+  }
+  if (!hints.empty() && std::ranges::any_of(hints, [&](const auto& hint) {
+        return hint.empty() || hint != detected;
+      })) {
+    detected.clear();
+  }
+  detected_.push_back(std::move(detected));
+  ++frame_index_;
+  CollectFrame();
+}
+
+void LocalTranslation::Start(const std::string& source,
+                             const std::string& target) {
+  if (state_.phase != Phase::kChoosing || !Permitted() ||
+      Language(source).empty() || Language(target).empty() ||
+      Language(source) != source || Language(target) != target ||
+      source == target || base::TimeTicks::Now() >= deadline_) {
+    Fail(
+        "Choose distinct supported source and target languages in this live "
+        "document");
+    return;
+  }
+  Profile::FromBrowserContext(web_contents()->GetBrowserContext())
+      ->GetPrefs()
+      ->SetString(kTranslationTarget, target);
+  routes_.clear();
+  if (source == "en" || target == "en") {
+    routes_.emplace_back(source, target);
+  } else {
+    routes_.emplace_back(source, "en");
+    routes_.emplace_back("en", target);
+  }
+  node_index_ = 0;
+  state_.phase = Phase::kTranslating;
+  state_.detail =
+      "Local model work is queued or running; Stop and Restore original remain "
+      "available";
+  Notify();
+  NextNode();
+}
+
+void LocalTranslation::NextNode() {
+  if (!Permitted() || base::TimeTicks::Now() >= deadline_) {
+    Fail("Translation was stopped by authorization loss or the page deadline");
+    return;
+  }
+  if (node_index_ == nodes_.size()) {
+    timer_.Stop();
+    nodes_.clear();
+    chunks_.clear();
+    state_.phase = state_.changed_nodes ? Phase::kPartial : Phase::kComplete;
+    state_.detail =
+        state_.changed_nodes
+            ? "Changed or removed nodes were preserved; restore original is "
+              "available"
+            : "Local translation finished; restore original is available";
+    Notify();
+    return;
+  }
+  if (!frames_[nodes_[node_index_].frame].document.AsRenderFrameHostIfValid()) {
+    Fail("A participating frame navigated; no stale translation was applied");
+    return;
+  }
+  chunks_ = Chunks(nodes_[node_index_].text);
+  if (chunks_.empty()) {
+    Fail("Text could not be divided into bounded Unicode chunks");
+    return;
+  }
+  chunk_index_ = 0;
+  node_result_.clear();
+  NextChunk();
+}
+
+void LocalTranslation::NextChunk() {
+  if (chunk_index_ == chunks_.size()) {
+    auto& node = nodes_[node_index_];
+    auto* frame = frames_[node.frame].document.AsRenderFrameHostIfValid();
+    if (!Document(frame) || !Permitted()) {
+      Fail("The translation owner changed before text application");
+      return;
+    }
+    base::ListValue arguments;
+    arguments.Append(operation_);
+    arguments.Append(node.id);
+    arguments.Append(node_result_);
+    state_.can_restore = true;
+    Script(frame, kApply, base::Value(std::move(arguments)),
+           base::BindOnce(&LocalTranslation::Applied, weak_.GetWeakPtr(),
+                          node_index_));
+    return;
+  }
+  const auto& original = chunks_[chunk_index_];
+  std::u16string trimmed;
+  base::TrimWhitespace(base::UTF8ToUTF16(original), base::TRIM_ALL, &trimmed);
+  std::string body = base::UTF16ToUTF8(trimmed);
+  if (body.empty()) {
+    node_result_ += original;
+    ++chunk_index_;
+    NextChunk();
+    return;
+  }
+  const auto position = original.find(body);
+  chunk_prefix_ = original.substr(0, position);
+  chunk_suffix_ = original.substr(position + body.size());
+  route_input_ = std::move(body);
+  route_index_ = 0;
+  RunRoute();
+}
+
+void LocalTranslation::RunRoute() {
+  auto* frame =
+      frames_[nodes_[node_index_].frame].document.AsRenderFrameHostIfValid();
+  if (!Document(frame) || !Permitted() || base::TimeTicks::Now() >= deadline_) {
+    Fail("Local translation lost its live owner or page deadline");
+    return;
+  }
+  const auto pair = routes_[route_index_];
+  const auto pack_id = "translation-" + pair.first + "-" + pair.second;
+  auto* models =
+      LocalModels::Get(Profile::FromBrowserContext(frame->GetBrowserContext()));
+  if (!models) {
+    Fail("Local model access is unavailable in this browsing mode");
+    return;
+  }
+  const auto document = frame->GetWeakDocumentPtr();
+  job_ = LocalBroker::Get().Submit(
+      frame, Feature::kTranslation,
+      base::BindOnce(
+          [](base::WeakPtr<LocalModels> models, std::string pack_id,
+             std::string text, content::WeakDocumentPtr document,
+             LocalBroker::Ready ready) {
+            if (!models || !document.AsRenderFrameHostIfValid()) {
+              LocalBroker::Prepared prepared;
+              prepared.error =
+                  "The local translation owner is no longer available";
+              std::move(ready).Run(std::move(prepared));
+              return;
+            }
+            models->AcquirePack(
+                pack_id, Feature::kTranslation,
+                base::BindOnce(
+                    [](std::string text, content::WeakDocumentPtr document,
+                       LocalBroker::Ready ready,
+                       base::expected<model_storage::Acquired, std::string>
+                           acquired) {
+                      if (!acquired.has_value() ||
+                          !document.AsRenderFrameHostIfValid()) {
+                        LocalBroker::Prepared prepared;
+                        prepared.error =
+                            acquired.has_value()
+                                ? "The translation document changed"
+                                : acquired.error();
+                        std::move(ready).Run(std::move(prepared));
+                        return;
+                      }
+                      std::move(ready).Run(
+                          TranslationRequest(std::move(*acquired), text));
+                    },
+                    std::move(text), document, std::move(ready)));
+          },
+          models->GetWeakPtr(), pack_id, route_input_, document),
+      base::BindOnce(&LocalTranslation::Translated, weak_.GetWeakPtr()));
+}
+
+void LocalTranslation::Translated(mojom::ResultPtr result) {
+  job_ = {};
+  if (!result || result->status != mojom::Status::kOk) {
+    Fail(result && !result->detail.empty()
+             ? result->detail
+             : "The local translation model failed");
+    return;
+  }
+  route_input_ = std::move(result->text);
+  if (++route_index_ < routes_.size()) {
+    RunRoute();
+    return;
+  }
+  const auto bytes =
+      chunk_prefix_.size() + route_input_.size() + chunk_suffix_.size();
+  if (bytes > 4194304 - output_bytes_ ||
+      bytes > 1048576 - node_result_.size()) {
+    Fail("Local translation output exceeded the bounded page/node buffer");
+    return;
+  }
+  output_bytes_ += bytes;
+  node_result_ += chunk_prefix_ + route_input_ + chunk_suffix_;
+  ++chunk_index_;
+  NextChunk();
+}
+
+void LocalTranslation::Applied(size_t node, base::Value result) {
+  if (node != node_index_ || !result.is_bool()) {
+    Fail("The renderer returned an invalid text-application acknowledgement");
+    return;
+  }
+  if (result.GetBool()) {
+    ++state_.translated_nodes;
+    state_.can_restore = true;
+  } else {
+    ++state_.changed_nodes;
+  }
+  nodes_[node].text.clear();
+  ++node_index_;
+  Notify();
+  NextNode();
+}
+
+void LocalTranslation::Restore(Update update) {
+  Cancel();
+  update_ = std::move(update);
+  if (!IsEligibleProfile(
+          Profile::FromBrowserContext(web_contents()->GetBrowserContext()))) {
+    Fail(
+        "Restoring a local translation requires its eligible original profile");
+    return;
+  }
+  restoring_ = true;
+  state_.phase = Phase::kRestoring;
+  state_.translated_nodes = 0;
+  state_.restored_nodes = 0;
+  state_.changed_nodes = 0;
+  Notify();
+  RestoreFrame(0);
+}
+
+void LocalTranslation::RestoreFrame(size_t index) {
+  if (index == frames_.size()) {
+    restoring_ = false;
+    state_.can_restore = false;
+    state_.phase = Phase::kRestored;
+    state_.detail = state_.changed_nodes
+                        ? "Original text restored where unchanged; page edits "
+                          "were preserved"
+                        : "Original text restored";
+    Notify();
+    return;
+  }
+  auto* frame = frames_[index].document.AsRenderFrameHostIfValid();
+  if (!Document(frame)) {
+    ++state_.unsupported_frames;
+    RestoreFrame(index + 1);
+    return;
+  }
+  Script(
+      frame, kRestore, base::Value(operation_),
+      base::BindOnce(&LocalTranslation::Restored, weak_.GetWeakPtr(), index));
+}
+
+void LocalTranslation::Restored(size_t index, base::Value result) {
+  const auto* value = result.GetIfDict();
+  const auto restored = value ? value->FindInt("restored") : std::nullopt;
+  const auto changed = value ? value->FindInt("changed") : std::nullopt;
+  if (!restored || *restored < 0 || !changed || *changed < 0 ||
+      static_cast<uint64_t>(*restored) + *changed > kMaximumScalars) {
+    Fail("Original-text restoration returned invalid bounded counts");
+    return;
+  }
+  state_.restored_nodes += *restored;
+  state_.changed_nodes += *changed;
+  RestoreFrame(index + 1);
+}
+
+void LocalTranslation::Cancel() {
+  weak_.InvalidateWeakPtrs();
+  timer_.Stop();
+  const auto job = std::exchange(job_, {});
+  if (!job.is_empty()) {
+    LocalBroker::Get().Cancel(job);
+  }
+  nodes_.clear();
+  chunks_.clear();
+  route_input_.clear();
+  node_result_.clear();
+  if (state_.phase == Phase::kCollecting ||
+      state_.phase == Phase::kTranslating || state_.phase == Phase::kChoosing ||
+      state_.phase == Phase::kRestoring) {
+    state_.phase = Phase::kStopped;
+    state_.detail =
+        "Local translation stopped; unchanged translated nodes can be restored";
+    Notify();
+  }
+}
+
+void LocalTranslation::Fail(std::string detail) {
+  Cancel();
+  state_.phase = state_.can_restore ? Phase::kPartial : Phase::kError;
+  state_.detail = std::move(detail);
+  LOG(ERROR) << "Stainless local translation: operation stopped";
+  Notify();
+}
+
+void LocalTranslation::DidFinishNavigation(content::NavigationHandle*) {
+  if (std::ranges::any_of(frames_,
+                          [](const auto& frame) {
+                            return !frame.document.AsRenderFrameHostIfValid();
+                          }) &&
+      (state_.phase == Phase::kCollecting || state_.phase == Phase::kChoosing ||
+       state_.phase == Phase::kTranslating)) {
+    Fail("A participating document navigated; stale results were discarded");
+  }
+}
+
+void LocalTranslation::RenderFrameDeleted(content::RenderFrameHost* frame) {
+  if (!restoring_ &&
+      (state_.phase == Phase::kCollecting || state_.phase == Phase::kChoosing ||
+       state_.phase == Phase::kTranslating) &&
+      std::ranges::any_of(frames_, [&](const auto& item) {
+        return !item.document.AsRenderFrameHostIfValid() ||
+               item.document.AsRenderFrameHostIfValid() == frame;
+      })) {
+    Fail("A participating frame was removed; late results were discarded");
+  }
+}
+
+void LocalTranslation::WebContentsDestroyed() {
+  update_.Reset();
+  Cancel();
+}
+
+}  // namespace stainless_local
