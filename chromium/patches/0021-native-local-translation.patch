+constexpr std::array<std::string_view, 6> kLanguages = {"",   "en", "it",
+                                                        "fr", "de", "es"};
+
+std::unique_ptr<ui::SimpleComboboxModel> Languages(int placeholder) {
+  std::vector<ui::SimpleComboboxModel::Item> labels;
+  for (int message :
+       {placeholder, IDS_STAINLESS_TRANSLATION_EN, IDS_STAINLESS_TRANSLATION_IT,
+        IDS_STAINLESS_TRANSLATION_FR, IDS_STAINLESS_TRANSLATION_DE,
+        IDS_STAINLESS_TRANSLATION_ES}) {
+    labels.emplace_back(l10n_util::GetStringUTF16(message));
+  }
+  return std::make_unique<ui::SimpleComboboxModel>(std::move(labels));
+}
+
+size_t LanguageIndex(std::string_view language) {
+  auto found = std::ranges::find(kLanguages, language);
+  return found == kLanguages.end() ? 0 : found - kLanguages.begin();
+}
