diff --git a/chrome/browser/stainless_local/local_summary.cc b/chrome/browser/stainless_local/local_summary.cc
new file mode 100644
index 0000000000000000000000000000000000000000..b3eddd307e1e151a886cb04ff5656b77c44fe846
--- /dev/null
+++ b/chrome/browser/stainless_local/local_summary.cc
@@ -0,0 +1,523 @@
+#include "chrome/browser/stainless_local/local_summary.h"
+
+#include <algorithm>
+#include <string_view>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/json/json_writer.h"
+#include "base/logging.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/search_engines/template_url_service_factory.h"
+#include "chrome/browser/stainless_local/local_models.h"
+#include "chrome/common/chrome_isolated_world_ids.h"
+#include "components/search_engines/template_url.h"
+#include "components/search_engines/template_url_service.h"
+#include "content/public/browser/page.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+
+namespace stainless_local {
+namespace {
+
+constexpr size_t kMaximumItems = 40;
+constexpr size_t kMaximumSearchResults = 10;
+constexpr size_t kMaximumPassageUnits = 700;
+constexpr size_t kMaximumLabelBytes = 160;
+constexpr auto kCollectionDeadline = base::Seconds(15);
+
+// Runs in Stainless's isolated world. It reads only visible text from the
+// primary document and never changes the page.
+constexpr char kCollect[] = R"JS(
+(args => {
+  const [kind, maximumItems, maximumPassage] = args;
+  if (!['text/html', 'application/xhtml+xml'].includes(document.contentType))
+    return {status: 'unsupported'};
+  const clean = value => (value || '').replace(/\s+/g, ' ').trim();
+  const shown = element =>
+      element.checkVisibility({checkOpacity: true, checkVisibilityCSS: true});
+  const excluded = 'nav,aside,footer,form,script,style,noscript,template,' +
+      '[role=navigation],[role=complementary],[role=contentinfo],' +
+      '[role=search],[aria-hidden=true],[hidden]';
+  const title = clean(document.title).slice(0, 300);
+  if (kind === 'page') {
+    const root = document.querySelector('main, article, [role=main]') ||
+                 document.body;
+    if (!root) return {status: 'ok', title, items: [], more: false};
+    const blocks = 'h1,h2,h3,h4,h5,h6,p,li,blockquote,pre,td,th,dd,dt,figcaption';
+    const items = [];
+    let current = '';
+    let more = false;
+    const push = text => {
+      if (items.length === maximumItems) more = true;
+      else items.push(text);
+    };
+    const add = text => {
+      while (text && !more) {
+        if (current && current.length + 1 + text.length > maximumPassage) {
+          push(current);
+          current = '';
+        }
+        if (text.length <= maximumPassage) {
+          current = current ? current + ' ' + text : text;
+          text = '';
+        } else {
+          let cut = text.lastIndexOf('. ', maximumPassage - 1);
+          if (cut < maximumPassage / 2) cut = text.lastIndexOf(' ', maximumPassage - 1);
+          if (cut < maximumPassage / 2) cut = maximumPassage - 1;
+          push(text.slice(0, cut + 1).trim());
+          text = text.slice(cut + 1).trim();
+        }
+        if (current.length >= 240) {
+          push(current);
+          current = '';
+        }
+      }
+    };
+    for (const block of root.querySelectorAll(blocks)) {
+      if (more) break;
+      if (block.closest(excluded) || block.querySelector(blocks) || !shown(block))
+        continue;
+      add(clean(block.innerText));
+    }
+    if (current && !more) push(current);
+    if (!items.length && !more) {
+      current = '';
+      add(clean(root.innerText));
+      if (current && !more) push(current);
+    }
+    return {status: 'ok', title, items, more};
+  }
+  const host = location.hostname;
+  const own = url => url.hostname === host || url.hostname.endsWith('.' + host) ||
+                     host.endsWith('.' + url.hostname);
+  const target = anchor => {
+    let url;
+    try { url = new URL(anchor.href); } catch { return null; }
+    if (own(url)) {
+      let decoded = null;
+      for (const name of ['uddg', 'url', 'q', 'u']) {
+        let value = url.searchParams.get(name);
+        if (!value) continue;
+        if (name === 'u' && value.startsWith('a1')) {
+          try {
+            value = atob(value.slice(2).replace(/-/g, '+').replace(/_/g, '/'));
+          } catch { continue; }
+        }
+        try { decoded = new URL(value); break; } catch {}
+      }
+      if (!decoded) return null;
+      url = decoded;
+    }
+    if ((url.protocol !== 'https:' && url.protocol !== 'http:') || own(url) ||
+        url.username || url.password)
+      return null;
+    url.hash = '';
+    return url;
+  };
+  const root = document.querySelector('main, [role=main]') || document.body;
+  if (!root) return {status: 'ok', title, items: [], more: false};
+  const headings = [...root.querySelectorAll('h1,h2,h3,h4,[role=heading]')];
+  const links = headings.map(heading =>
+      heading.closest('a[href]') || heading.querySelector('a[href]'));
+  const items = [];
+  const seen = new Set();
+  let more = false;
+  for (let index = 0; index < headings.length; ++index) {
+    const heading = headings[index];
+    const anchor = links[index];
+    if (!anchor || heading.closest(excluded) || !shown(heading)) continue;
+    const url = target(anchor);
+    const name = clean(heading.innerText);
+    if (!url || !name || seen.has(url.href)) continue;
+    if (items.length === maximumItems) {
+      more = true;
+      break;
+    }
+    let container = anchor.contains(heading) ? anchor : heading;
+    for (let depth = 0; depth < 6 && container.parentElement &&
+                        container.parentElement !== root; ++depth) {
+      const parent = container.parentElement;
+      if (headings.some((other, position) => position !== index &&
+                        links[position] && parent.contains(other)))
+        break;
+      container = parent;
+    }
+    seen.add(url.href);
+    items.push({title: name.slice(0, 300), url: url.href,
+                snippet: clean(clean(container.innerText).replace(name, ''))
+                             .slice(0, maximumPassage)});
+  }
+  return {status: 'ok', title, items, more};
+})
+)JS";
+
+std::string Truncate(std::string text, size_t bytes) {
+  if (text.size() <= bytes) {
+    return text;
+  }
+  size_t end = bytes;
+  while (end > 0 && (static_cast<unsigned char>(text[end]) & 0xc0) == 0x80) {
+    --end;
+  }
+  text.resize(end);
+  return text;
+}
+
+bool Text(const std::string* value, size_t maximum) {
+  return value && value->size() <= maximum && base::IsStringUTF8(*value) &&
+         value->find('\0') == std::string::npos;
+}
+
+}  // namespace
+
+std::optional<std::u16string> LocalSummarySearchQuery(
+    content::WebContents* contents) {
+  if (!contents) {
+    return std::nullopt;
+  }
+  auto* service = TemplateURLServiceFactory::GetForProfile(
+      Profile::FromBrowserContext(contents->GetBrowserContext()));
+  const GURL& url = contents->GetPrimaryMainFrame()->GetLastCommittedURL();
+  if (!service || !service->loaded() || !url.SchemeIsHTTPOrHTTPS()) {
+    return std::nullopt;
+  }
+  for (const TemplateURL* engine : service->GetTemplateURLs()) {
+    std::u16string terms;
+    if (engine->ExtractSearchTermsFromURL(url, service->search_terms_data(),
+                                          &terms)) {
+      base::TrimWhitespace(terms, base::TRIM_ALL, &terms);
+      if (!terms.empty()) {
+        return terms;
+      }
+    }
+  }
+  return std::nullopt;
+}
+
+LocalSummary::State::State() = default;
+LocalSummary::State::~State() = default;
+LocalSummary::State::State(const State&) = default;
+LocalSummary::State& LocalSummary::State::operator=(const State&) = default;
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(LocalSummary);
+
+LocalSummary* LocalSummary::Get(content::WebContents* contents) {
+  CreateForWebContents(contents);
+  return FromWebContents(contents);
+}
+
+LocalSummary::LocalSummary(content::WebContents* contents)
+    : content::WebContentsObserver(contents),
+      content::WebContentsUserData<LocalSummary>(*contents) {}
+
+LocalSummary::~LocalSummary() {
+  update_.Reset();
+  Cancel();
+}
+
+bool LocalSummary::Permitted() const {
+  return IsLocalFeatureAllowed(web_contents()->GetPrimaryMainFrame(),
+                               Feature::kSummaries);
+}
+
+void LocalSummary::Notify() {
+  if (update_) {
+    update_.Run(state_);
+  }
+}
+
+void LocalSummary::Start(Kind kind, Update update) {
+  Cancel();
+  update_ = std::move(update);
+  state_ = State();
+  state_.kind = kind;
+  if (!Permitted()) {
+    Fail(
+        "Enable local summaries in Stainless Local Services Settings, then "
+        "install the image-description model pack");
+    return;
+  }
+  auto* frame = web_contents()->GetPrimaryMainFrame();
+  if (kind == Kind::kSearchResults) {
+    const auto query = LocalSummarySearchQuery(web_contents());
+    if (!query) {
+      Fail(
+          "This page is not a results page of a configured search engine; use "
+          "Summarize page instead");
+      return;
+    }
+    state_.subject =
+        Truncate(base::UTF16ToUTF8(*query), kMaximumSummarySubjectBytes);
+  }
+  document_ = frame->GetWeakDocumentPtr();
+  started_ = base::TimeTicks::Now();
+  state_.phase = Phase::kCollecting;
+  state_.detail = "Reading visible text from this page";
+  Notify();
+  timer_.Start(FROM_HERE, kCollectionDeadline,
+               base::BindOnce(&LocalSummary::Fail, weak_.GetWeakPtr(),
+                              "Reading the page timed out after 15 seconds"));
+  base::ListValue arguments;
+  arguments.Append(kind == Kind::kPage ? "page" : "search");
+  arguments.Append(static_cast<int>(kind == Kind::kPage ? kMaximumItems
+                                                         : kMaximumSearchResults));
+  arguments.Append(static_cast<int>(kMaximumPassageUnits));
+  auto json = base::WriteJson(base::Value(std::move(arguments)));
+  CHECK(json);
+  frame->ExecuteJavaScriptInIsolatedWorld(
+      base::UTF8ToUTF16("(" + std::string(kCollect) + ")(" + *json + ")"),
+      base::BindOnce(&LocalSummary::Collected, weak_.GetWeakPtr()),
+      ISOLATED_WORLD_ID_STAINLESS_LOCAL);
+}
+
+void LocalSummary::Collected(base::Value result) {
+  timer_.Stop();
+  auto* frame = document_.AsRenderFrameHostIfValid();
+  if (state_.phase != Phase::kCollecting || !Permitted() ||
+      frame != web_contents()->GetPrimaryMainFrame()) {
+    Fail("The page changed while its text was being read");
+    return;
+  }
+  const auto* value = result.GetIfDict();
+  const auto* status = value ? value->FindString("status") : nullptr;
+  if (status && *status == "unsupported") {
+    Fail("Only HTML documents can be summarized");
+    return;
+  }
+  const auto* title = value ? value->FindString("title") : nullptr;
+  const auto* items = value ? value->FindList("items") : nullptr;
+  const auto more = value ? value->FindBool("more") : std::nullopt;
+  if (!status || *status != "ok" || !Text(title, 1200) || !items ||
+      items->size() > kMaximumItems || !more) {
+    Fail("Reading the page returned an invalid bounded result");
+    return;
+  }
+  if (state_.kind == Kind::kPage) {
+    state_.subject = Truncate(
+        title->empty() ? frame->GetLastCommittedOrigin().host() : *title,
+        kMaximumSummarySubjectBytes);
+  }
+  state_.found = items->size();
+  state_.more_found = *more;
+  size_t total = 0;
+  for (const auto& item : *items) {
+    Source source;
+    if (state_.kind == Kind::kPage) {
+      const auto* passage = item.GetIfString();
+      if (!Text(passage, kMaximumSummarySourceBytes) || passage->empty()) {
+        Fail("Reading the page returned an invalid passage");
+        return;
+      }
+      source.evidence = *passage;
+      source.label = Truncate(*passage, kMaximumLabelBytes);
+      if (source.label.size() < passage->size()) {
+        source.label += "\u2026";
+      }
+    } else {
+      const auto* entry = item.GetIfDict();
+      const auto* name = entry ? entry->FindString("title") : nullptr;
+      const auto* address = entry ? entry->FindString("url") : nullptr;
+      const auto* snippet = entry ? entry->FindString("snippet") : nullptr;
+      const GURL url = address && address->size() <= 2048 ? GURL(*address)
+                                                          : GURL();
+      if (!Text(name, 1200) || name->empty() || !Text(snippet, 2800) ||
+          !url.is_valid() || !url.SchemeIsHTTPOrHTTPS() ||
+          url.has_username() || url.has_password() || url.host().empty()) {
+        Fail("Reading the search results returned an invalid result");
+        return;
+      }
+      source.label = *name;
+      source.url = url;
+      source.evidence = "Title: " + *name + "\nSite: " + std::string(url.host()) +
+                        "\nSnippet: " +
+                        (snippet->empty() ? std::string("(none)") : *snippet);
+      if (source.evidence.size() > kMaximumSummarySourceBytes) {
+        Fail("A search result exceeded its bounded size");
+        return;
+      }
+    }
+    if (state_.sources.size() == kMaximumSummarySources ||
+        total + source.evidence.size() > kSummaryEvidenceBudgetBytes) {
+      break;
+    }
+    total += source.evidence.size();
+    state_.sources.push_back(std::move(source));
+  }
+  if (state_.sources.empty()) {
+    Fail(state_.kind == Kind::kPage
+             ? "No readable text was found on this page"
+             : "No search results were recognized on this page; use "
+               "Summarize page instead");
+    return;
+  }
+  if (state_.subject.empty()) {
+    state_.subject = "(untitled)";
+  }
+  state_.phase = Phase::kSummarizing;
+  state_.detail = "Waiting for the local model";
+  Notify();
+  const auto job = LocalBroker::Get().Submit(
+      frame, Feature::kSummaries,
+      base::BindOnce(&LocalSummary::Admitted, weak_.GetWeakPtr()),
+      base::BindOnce(&LocalSummary::Summarized, weak_.GetWeakPtr()));
+  if (state_.phase == Phase::kSummarizing) {
+    job_ = job;
+  }
+}
+
+void LocalSummary::Admitted(LocalBroker::Ready ready) {
+  if (state_.phase != Phase::kSummarizing || !Permitted() ||
+      document_.AsRenderFrameHostIfValid() !=
+          web_contents()->GetPrimaryMainFrame()) {
+    LocalBroker::Prepared prepared;
+    prepared.error = "The summarized page changed";
+    std::move(ready).Run(std::move(prepared));
+    return;
+  }
+  ready_ = std::move(ready);
+  auto* models = LocalModels::Get(
+      Profile::FromBrowserContext(web_contents()->GetBrowserContext()));
+  if (!models) {
+    LocalBroker::Prepared prepared;
+    prepared.error = "Local summary setup is unavailable";
+    std::move(ready_).Run(std::move(prepared));
+    return;
+  }
+  state_.detail = "Summarizing locally";
+  Notify();
+  models->AcquirePack(
+      "image-description", Feature::kSummaries,
+      base::BindOnce(&LocalSummary::PackReady, weak_.GetWeakPtr()));
+}
+
+void LocalSummary::PackReady(
+    base::expected<model_storage::Acquired, std::string> pack) {
+  if (!ready_) {
+    return;
+  }
+  LocalBroker::Prepared prepared;
+  if (!pack.has_value() || !Permitted()) {
+    prepared.error = pack.has_value() ? "Local summary consent changed"
+                                      : pack.error();
+    std::move(ready_).Run(std::move(prepared));
+    return;
+  }
+  auto request = mojom::SummaryRequest::New();
+  for (auto& file : pack->files) {
+    if (file->name == "model.gguf" && !request->model) {
+      request->model = std::move(file);
+    } else {
+      prepared.leases.push_back(std::move(file->file));
+    }
+  }
+  for (auto& lease : pack->leases) {
+    prepared.leases.push_back(std::move(lease));
+  }
+  if (!request->model) {
+    prepared.error = "The verified image-description pack has no text model";
+    std::move(ready_).Run(std::move(prepared));
+    return;
+  }
+  request->kind = state_.kind == Kind::kPage
+                      ? mojom::SummaryKind::kPage
+                      : mojom::SummaryKind::kSearchResults;
+  request->subject = state_.subject;
+  for (const auto& source : state_.sources) {
+    request->sources.push_back(source.evidence);
+  }
+  prepared.request = mojom::Request::NewSummary(std::move(request));
+  std::move(ready_).Run(std::move(prepared));
+}
+
+void LocalSummary::Summarized(mojom::ResultPtr result) {
+  job_ = {};
+  if (state_.phase != Phase::kSummarizing) {
+    return;
+  }
+  if (!result || result->status != mojom::Status::kOk) {
+    Fail(result && !result->detail.empty() ? result->detail
+                                           : "Local summary failed");
+    return;
+  }
+  if (!Permitted() || !result->summary ||
+      result->summary->used_sources > state_.sources.size()) {
+    Fail("Local summary returned an invalid bounded result");
+    return;
+  }
+  state_.points =
+      ParseSummary(result->text, result->summary->used_sources);
+  if (state_.points.empty()) {
+    Fail("The local model returned no usable summary");
+    return;
+  }
+  state_.used_sources = result->summary->used_sources;
+  state_.input_tokens = result->summary->input_tokens;
+  state_.generated_tokens = result->summary->generated_tokens;
+  state_.elapsed = base::TimeTicks::Now() - started_;
+  state_.phase = Phase::kComplete;
+  state_.detail = "Local summary completed";
+  if (auto* models = LocalModels::GetIfExists(
+          Profile::FromBrowserContext(web_contents()->GetBrowserContext()))) {
+    models->ReportRuntimeStatus(Feature::kSummaries, state_.detail, false);
+  }
+  Notify();
+}
+
+void LocalSummary::Fail(std::string detail) {
+  const bool active = state_.phase == Phase::kCollecting ||
+                      state_.phase == Phase::kSummarizing ||
+                      state_.phase == Phase::kIdle;
+  Stop();
+  if (!active) {
+    return;
+  }
+  state_.phase = Phase::kError;
+  state_.points.clear();
+  state_.detail = std::move(detail);
+  LOG(ERROR) << "Stainless local summary unavailable";
+  if (auto* models = LocalModels::GetIfExists(
+          Profile::FromBrowserContext(web_contents()->GetBrowserContext()))) {
+    models->ReportRuntimeStatus(Feature::kSummaries, state_.detail, true);
+  }
+  Notify();
+}
+
+void LocalSummary::Cancel() {
+  Stop();
+  if (state_.phase == Phase::kCollecting ||
+      state_.phase == Phase::kSummarizing) {
+    state_.phase = Phase::kCancelled;
+    state_.detail = "Summary stopped";
+    Notify();
+  }
+}
+
+void LocalSummary::Stop() {
+  weak_.InvalidateWeakPtrs();
+  timer_.Stop();
+  if (!job_.is_empty()) {
+    LocalBroker::Get().Cancel(job_);
+    job_ = {};
+  }
+  if (ready_) {
+    LocalBroker::Prepared prepared;
+    prepared.error = "The local summary was stopped";
+    std::move(ready_).Run(std::move(prepared));
+  }
+}
+
+void LocalSummary::PrimaryPageChanged(content::Page&) {
+  Cancel();
+  state_ = State();
+  Notify();
+}
+
+void LocalSummary::WebContentsDestroyed() {
+  update_.Reset();
+  Cancel();
+}
+
+}  // namespace stainless_local
