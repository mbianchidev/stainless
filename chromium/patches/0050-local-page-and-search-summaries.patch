+
+using Kind = stainless_local::LocalSummary::Kind;
+using Phase = stainless_local::LocalSummary::Phase;
+
+std::u16string Citations(const stainless_local::SummaryPoint& point) {
+  if (point.sources.empty()) {
+    return u" " + l10n_util::GetStringUTF16(IDS_STAINLESS_SUMMARY_UNCITED);
+  }
+  std::u16string result;
+  for (const auto source : point.sources) {
+    result += u" [" + base::NumberToString16(source) + u"]";
+  }
+  return result;
+}
+
+views::Label* AddText(views::View* parent, std::u16string text) {
+  auto* label = parent->AddChildView(std::make_unique<views::Label>(text));
+  label->SetMultiLine(true);
+  label->SetHorizontalAlignment(gfx::HorizontalAlignment::ALIGN_LEFT);
+  label->SetSelectable(true);
+  return label;
+}
+
+}  // namespace
+
+DEFINE_USER_DATA(StainlessSummaryView);
+
+StainlessSummaryView* StainlessSummaryView::Show(
+    BrowserWindowInterface* browser) {
+  if (!chrome::CanOpenStainlessLocalControls(browser) ||
+      !chrome::IsCommandEnabled(browser, IDC_STAINLESS_SUMMARIZE_PAGE)) {
+    LOG(WARNING) << "Stainless local summary: native action unavailable";
+    return nullptr;
+  }
+  auto* tabs = browser->GetTabStripModel();
+  auto* contents = tabs ? tabs->GetActiveWebContents() : nullptr;
+  auto* owner = BrowserView::GetBrowserViewForBrowser(browser);
+  if (!contents || !owner || !owner->GetWidget() ||
+      owner->GetWidget()->IsClosed() ||
+      tabs->IsTabBlocked(tabs->active_index()) ||
+      contents->GetBrowserContext() != browser->GetProfile()) {
+    LOG(WARNING) << "Stainless local summary: native owner unavailable";
+    return nullptr;
+  }
+  auto* existing = Get(browser->GetUnownedUserDataHost());
+  for (views::Widget* widget :
+       views::Widget::GetAllOwnedWidgets(owner->GetWidget()->GetNativeView())) {
+    if ((!existing || widget != existing->GetWidget()) && !widget->IsClosed() &&
+        widget->IsVisible() && widget->widget_delegate() &&
+        widget->widget_delegate()->GetModalType() !=
+            ui::mojom::ModalType::kNone) {
+      LOG(WARNING) << "Stainless local summary: another modal owns the window";
+      return nullptr;
+    }
+  }
+  if (existing &&
+      (existing->GetWidget()->IsClosed() || !existing->OwnsActiveDocument())) {
+    existing->GetWidget()->CloseNow();
+    existing = nullptr;
+  }
+  if (existing) {
+    existing->GetWidget()->Activate();
+    return existing;
+  }
+  auto view = std::make_unique<StainlessSummaryView>(browser);
+  auto* result = view.get();
+  auto dialog = std::make_unique<views::DialogDelegate>();
+  dialog->SetTitle(l10n_util::GetStringUTF16(IDS_STAINLESS_SUMMARY_TITLE));
+  dialog->SetButtons(static_cast<int>(ui::mojom::DialogButton::kCancel));
+  dialog->SetButtonLabel(
+      ui::mojom::DialogButton::kCancel,
+      l10n_util::GetStringUTF16(IDS_STAINLESS_COMMAND_PALETTE_CLOSE));
+  dialog->SetDefaultButton(static_cast<int>(ui::mojom::DialogButton::kNone));
+  dialog->SetModalType(ui::mojom::ModalType::kWindow);
+  dialog->set_margins(
+      ChromeLayoutProvider::Get()->GetDialogInsetsForContentType(
+          views::DialogContentType::kControl,
+          views::DialogContentType::kControl));
+  dialog->SetInitiallyFocusedView(result->search_page_ ? result->search_.get()
+                                                       : result->page_.get());
+  dialog->SetContentsView(std::move(view));
+  auto* widget = views::DialogDelegate::CreateDialogWidget(
+      std::move(dialog), gfx::NativeWindow(),
+      owner->GetWidget()->GetNativeView());
+  result->widget_.Observe(widget);
+  if (result->summary_->state().phase != Phase::kIdle) {
+    result->OnState(result->summary_->state());
+  }
+  widget->Show();
+  return result;
+}
+
+StainlessSummaryView::StainlessSummaryView(BrowserWindowInterface* browser)
+    : browser_(browser->GetWeakPtr()),
+      summary_(stainless_local::LocalSummary::Get(
+                   browser->GetTabStripModel()->GetActiveWebContents())
+                   ->GetWeakPtr()),
+      document_(browser->GetTabStripModel()
+                    ->GetActiveWebContents()
+                    ->GetPrimaryMainFrame()
+                    ->GetWeakDocumentPtr()),
+      search_page_(stainless_local::LocalSummarySearchQuery(
+                       browser->GetTabStripModel()->GetActiveWebContents())
+                       .has_value()),
+      return_focus_(std::make_unique<views::ViewTracker>()) {
+  registration_.emplace(browser->GetUnownedUserDataHost(), *this);
+  browser_closed_ = browser->RegisterBrowserDidClose(base::BindRepeating(
+      &StainlessSummaryView::OnBrowserClosed, base::Unretained(this)));
+  auto* focus =
+      BrowserView::GetBrowserViewForBrowser(browser)->GetFocusManager();
+  return_focus_->SetView(focus->GetFocusedView() ? focus->GetFocusedView()
+                                                 : focus->GetStoredFocusView());
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(), 8));
+  AddText(this, l10n_util::GetStringUTF16(IDS_STAINLESS_SUMMARY_EXPLANATION))
+      ->SetSelectable(false);
+  auto* buttons = AddChildView(std::make_unique<views::View>());
+  buttons->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal, gfx::Insets(), 8));
+  auto button = [buttons](int message,
+                          views::Button::PressedCallback callback) {
+    return buttons->AddChildView(std::make_unique<views::MdTextButton>(
+        std::move(callback), l10n_util::GetStringUTF16(message)));
+  };
+  page_ = button(IDS_STAINLESS_SUMMARY_PAGE,
+                 base::BindRepeating(&StainlessSummaryView::Start,
+                                     base::Unretained(this), Kind::kPage));
+  search_ = button(
+      IDS_STAINLESS_SUMMARY_SEARCH,
+      base::BindRepeating(&StainlessSummaryView::Start, base::Unretained(this),
+                          Kind::kSearchResults));
+  stop_ = button(IDS_STAINLESS_SUMMARY_STOP,
+                 base::BindRepeating(&StainlessSummaryView::Stop,
+                                     base::Unretained(this)));
+  status_ = AddText(this, l10n_util::GetStringUTF16(
+                              search_page_ ? IDS_STAINLESS_SUMMARY_READY_SEARCH
+                                           : IDS_STAINLESS_SUMMARY_READY));
+  status_->GetViewAccessibility().SetRole(ax::mojom::Role::kStatus);
+  status_->GetViewAccessibility().SetLiveRegionContainer(
+      views::ViewAccessibility::LiveRegionStatus::kPolite);
+  auto output = std::make_unique<views::View>();
+  output->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(), 6));
+  scroll_ = AddChildView(std::make_unique<views::ScrollView>());
+  output_ = scroll_->SetContents(std::move(output));
+  scroll_->ClipHeightTo(0, 300);
+  scroll_->SetHorizontalScrollBarMode(
+      views::ScrollView::ScrollBarMode::kDisabled);
+  scroll_->GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_STAINLESS_SUMMARY_OUTPUT));
+  AddChildView(std::make_unique<views::MdTextButton>(
+      base::BindRepeating(&StainlessSummaryView::OpenSettings,
+                          base::Unretained(this)),
+      l10n_util::GetStringUTF16(IDS_STAINLESS_TRANSLATION_SETUP)));
+  SetPreferredSize(gfx::Size(620, 520));
+  RefreshButtons();
+}
+
+StainlessSummaryView::~StainlessSummaryView() {
+  weak_.InvalidateWeakPtrs();
+  if (summary_) {
+    summary_->Cancel();
+  }
+}
+
+bool StainlessSummaryView::OwnsActiveDocument() const {
+  return browser_ && !browser_->IsDeleteScheduled() && summary_ &&
+         document_.AsRenderFrameHostIfValid() &&
+         browser_->GetTabStripModel()->GetActiveWebContents() ==
+             content::WebContents::FromRenderFrameHost(
+                 document_.AsRenderFrameHostIfValid()) &&
+         chrome::CanOpenStainlessLocalControls(browser_.get());
+}
+
+void StainlessSummaryView::Start(Kind kind) {
+  if (!OwnsActiveDocument() ||
+      !(kind == Kind::kPage ? page_ : search_)->GetEnabled()) {
+    LOG(WARNING) << "Stainless local summary: stale native start";
+    return;
+  }
+  summary_->Start(kind, base::BindRepeating(&StainlessSummaryView::OnState,
+                                            weak_.GetWeakPtr()));
+}
+
+void StainlessSummaryView::Stop() {
+  if (summary_) {
+    summary_->Cancel();
+  }
+  RefreshButtons();
+}
+
+void StainlessSummaryView::OpenSettings() {
+  open_settings_ = true;
+  GetWidget()->Close();
+}
+
+void StainlessSummaryView::OpenSource(size_t index) {
+  if (!OwnsActiveDocument() || summary_->state().phase != Phase::kComplete ||
+      index >= summary_->state().used_sources) {
+    return;
+  }
+  const GURL url = summary_->state().sources[index].url;
+  if (url.SchemeIsHTTPOrHTTPS()) {
+    browser_->OpenGURL(url, WindowOpenDisposition::kNewBackgroundTab);
+  }
+}
+
+void StainlessSummaryView::OnState(
+    const stainless_local::LocalSummary::State& state) {
+  if (!OwnsActiveDocument()) {
+    status_->SetText(
+        l10n_util::GetStringUTF16(IDS_STAINLESS_TRANSLATION_OWNER_CHANGED));
+    output_->RemoveAllChildViews();
+    RefreshButtons();
+    return;
+  }
+  std::u16string status = base::UTF8ToUTF16(state.detail);
+  if (state.phase == Phase::kComplete) {
+    status += u"\n" + l10n_util::GetStringFUTF16(
+                          IDS_STAINLESS_SUMMARY_METRICS,
+                          base::NumberToString16(base::ClampRound(
+                              state.elapsed.InSecondsF())),
+                          base::NumberToString16(state.input_tokens),
+                          base::NumberToString16(state.generated_tokens));
+  }
+  status_->SetText(status);
+  output_->RemoveAllChildViews();
+  if (state.phase == Phase::kComplete) {
+    const auto found = base::NumberToString16(state.found) +
+                       (state.more_found ? u"+" : u"");
+    AddText(output_,
+            state.kind == Kind::kPage
+                ? l10n_util::GetStringFUTF16(
+                      IDS_STAINLESS_SUMMARY_PAGE_LABEL,
+                      base::NumberToString16(state.used_sources), found)
+                : l10n_util::GetStringFUTF16(
+                      IDS_STAINLESS_SUMMARY_SEARCH_LABEL,
+                      base::UTF8ToUTF16(state.subject),
+                      base::NumberToString16(state.used_sources), found));
+    for (const auto& point : state.points) {
+      AddText(output_, u"\u2022 " + base::UTF8ToUTF16(point.text) +
+                           Citations(point));
+    }
+    AddText(output_, l10n_util::GetStringUTF16(IDS_STAINLESS_SUMMARY_SOURCES));
+    for (size_t index = 0; index < state.used_sources; ++index) {
+      const auto& source = state.sources[index];
+      const auto text = u"[" + base::NumberToString16(index + 1) + u"] " +
+                        base::UTF8ToUTF16(source.label);
+      if (source.url.is_valid()) {
+        auto* link = output_->AddChildView(std::make_unique<views::Link>(
+            text + u" (" + base::UTF8ToUTF16(source.url.host()) + u")"));
+        link->SetMultiLine(true);
+        link->SetHorizontalAlignment(gfx::HorizontalAlignment::ALIGN_LEFT);
+        link->SetTooltipText(base::UTF8ToUTF16(source.url.spec()));
+        link->SetCallback(base::BindRepeating(&StainlessSummaryView::OpenSource,
+                                              weak_.GetWeakPtr(), index));
+      } else {
+        AddText(output_, text);
+      }
+    }
+  }
+  output_->InvalidateLayout();
+  scroll_->InvalidateLayout();
+  RefreshButtons();
+}
+
+void StainlessSummaryView::RefreshButtons() {
+  const bool owner = OwnsActiveDocument();
+  const auto phase = summary_ ? summary_->state().phase : Phase::kError;
+  const bool busy = phase == Phase::kCollecting || phase == Phase::kSummarizing;
+  page_->SetEnabled(owner && !busy);
+  search_->SetEnabled(owner && !busy && search_page_);
+  stop_->SetEnabled(owner && busy);
+}
+
+void StainlessSummaryView::OnBrowserClosed(BrowserWindowInterface*) {
+  registration_.reset();
+  browser_.reset();
+  GetWidget()->Close();
+}
+
+void StainlessSummaryView::OnWidgetDestroyed(views::Widget*) {
+  weak_.InvalidateWeakPtrs();
+  if (summary_) {
+    summary_->Cancel();
+  }
+  widget_.Reset();
+  registration_.reset();
+  browser_closed_ = {};
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::WeakPtr<BrowserWindowInterface> browser, bool settings,
+             std::unique_ptr<views::ViewTracker> focus) {
+            if (!browser || browser->IsDeleteScheduled()) {
+              return;
+            }
+            if (settings) {
+              chrome::ShowSettingsSubPage(browser.get(), "localServices");
+            } else if (focus->view() && focus->view()->IsDrawn() &&
+                       focus->view()->IsFocusable()) {
+              focus->view()->RequestFocus();
+            } else if (auto* contents = browser->GetTabStripModel()
+                                            ->GetActiveWebContents()) {
+              contents->Focus();
+            }
+          },
+          browser_, open_settings_, std::move(return_focus_)));
+}
+
+namespace chrome {
+
+void ShowLocalSummary(BrowserWindowInterface* browser) {
+  StainlessSummaryView::Show(browser);
+}
+
+}  // namespace chrome
+
+BEGIN_METADATA(StainlessSummaryView)
+END_METADATA
