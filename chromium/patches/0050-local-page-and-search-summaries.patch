+#include "content/public/browser/web_contents_user_data.h"
+#include "url/gurl.h"
+
+namespace stainless_local {
+
+// Evidence budget per request. It keeps the fixed-context prompt and its
+// generation inside the broker's 60-second deadline on two CPU threads.
+inline constexpr size_t kSummaryEvidenceBudgetBytes = 9000;
+
+// Returns the search terms when the primary document is a results page of a
+// configured search engine.
+std::optional<std::u16string> LocalSummarySearchQuery(
+    content::WebContents* contents);
+
+class LocalSummary final : public content::WebContentsObserver,
+                           public content::WebContentsUserData<LocalSummary> {
+ public:
+  enum class Kind { kPage, kSearchResults };
+  enum class Phase {
+    kIdle,
+    kCollecting,
+    kSummarizing,
+    kComplete,
+    kCancelled,
+    kError
+  };
+  struct Source {
+    std::string label;
+    std::string evidence;
+    GURL url;
+  };
+  struct State {
+    State();
+    ~State();
+    State(const State&);
+    State& operator=(const State&);
+
+    Phase phase = Phase::kIdle;
+    Kind kind = Kind::kPage;
+    std::string detail;
+    std::string subject;
+    std::vector<Source> sources;
+    size_t found = 0;
+    bool more_found = false;
+    size_t used_sources = 0;
+    std::vector<SummaryPoint> points;
+    uint32_t input_tokens = 0;
+    uint32_t generated_tokens = 0;
+    base::TimeDelta elapsed;
+  };
+  using Update = base::RepeatingCallback<void(const State&)>;
+
+  static LocalSummary* Get(content::WebContents* contents);
+  ~LocalSummary() override;
+  void Start(Kind kind, Update update);
+  void Cancel();
+  const State& state() const { return state_; }
+  base::WeakPtr<LocalSummary> GetWeakPtr() { return lifetime_.GetWeakPtr(); }
+
+ private:
+  friend class content::WebContentsUserData<LocalSummary>;
+  explicit LocalSummary(content::WebContents* contents);
+
+  void Collected(base::Value result);
+  void Admitted(LocalBroker::Ready ready);
+  void PackReady(base::expected<model_storage::Acquired, std::string> pack);
+  void Summarized(mojom::ResultPtr result);
+  void Fail(std::string detail);
+  void Stop();
+  void Notify();
+  bool Permitted() const;
+  void PrimaryPageChanged(content::Page& page) override;
+  void WebContentsDestroyed() override;
+
+  State state_;
+  Update update_;
+  content::WeakDocumentPtr document_;
+  base::UnguessableToken job_;
+  LocalBroker::Ready ready_;
+  base::TimeTicks started_;
+  base::OneShotTimer timer_;
+  base::WeakPtrFactory<LocalSummary> weak_{this};
+  base::WeakPtrFactory<LocalSummary> lifetime_{this};
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+}  // namespace stainless_local
+
+#endif
