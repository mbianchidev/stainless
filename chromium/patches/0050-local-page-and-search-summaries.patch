+void LocalWorker::Summarize(mojom::ModelFilePtr model,
+                            mojom::SummaryKind kind,
+                            const std::string& subject,
+                            const std::vector<std::string>& sources,
+                            SummarizeCallback callback) {
+  auto replies = base::SplitOnceCallback(std::move(callback));
+  if (!runner_->PostTask(
+          FROM_HERE,
+          base::BindOnce(
+              &LocalWorker::RunSummary, libraries_, std::move(model), kind,
+              subject, sources,
+              base::BindPostTaskToCurrentDefault(std::move(replies.first))))) {
+    std::move(replies.second)
+        .Run(Failure(mojom::Status::kFailed,
+                     "Local summary worker is stopping"));
+  }
+}
+
+void LocalWorker::RunSummary(const base::FilePath& libraries,
+                             mojom::ModelFilePtr model,
+                             mojom::SummaryKind kind,
+                             const std::string& subject,
+                             const std::vector<std::string>& sources,
+                             SummarizeCallback callback) {
+  size_t total = 0;
+  bool valid = model && model->sha256.size() == 32 && !sources.empty() &&
+               sources.size() <= kMaximumSummarySources &&
+               BoundedText(subject, kMaximumSummarySubjectBytes);
+  for (const auto& source : sources) {
+    valid = valid && BoundedText(source, kMaximumSummarySourceBytes);
+    total += source.size();
+  }
+  if (!valid || total > kMaximumSummaryEvidenceBytes) {
+    std::move(callback).Run(
+        Failure(mojom::Status::kInvalidInput, "Invalid local summary request"));
+    return;
+  }
+  base::ScopedBlockingCall blocking(FROM_HERE, base::BlockingType::MAY_BLOCK);
+  base::ScopedNativeLibrary library(
+      libraries.AppendASCII("libstainless_vision.dylib"));
+  const auto version = Bind<decltype(&stainless_summary_abi_version)>(
+      library, "stainless_summary_abi_version");
+  const auto create = Bind<decltype(&stainless_summary_create)>(
+      library, "stainless_summary_create");
+  const auto run =
+      Bind<decltype(&stainless_summary_run)>(library, "stainless_summary_run");
+  const auto destroy = Bind<decltype(&stainless_summary_destroy)>(
+      library, "stainless_summary_destroy");
+  if (!library.is_valid() || !version || !create || !run || !destroy ||
+      version() != 1) {
+    LogRuntimeFailure(library, "summary");
+    std::move(callback).Run(Failure(mojom::Status::kUnavailable,
+                                    "Bundled local summary runtime is unavailable"));
+    return;
+  }
+  const auto text_model = NativeModel(*model);
+  StainlessRuntimeError error = {};
+  std::unique_ptr<StainlessSummarizer, decltype(destroy)> engine(
+      create(&text_model, 2, &error), destroy);
+  if (!engine) {
+    std::move(callback).Run(
+        Failure(error.code == STAINLESS_RUNTIME_OK ? mojom::Status::kFailed
+                                                   : NativeStatus(error.code),
+                "Verified local summary model initialization failed"));
+    return;
+  }
+  std::vector<StainlessText> native;
+  native.reserve(sources.size());
+  for (const auto& source : sources) {
+    native.push_back({source.data(), source.size()});
+  }
+  TokenSink sink;
+  uint32_t used_sources = 0;
+  uint32_t input_tokens = 0;
+  uint32_t generated_tokens = 0;
+  const auto status =
+      run(engine.get(),
+          kind == mojom::SummaryKind::kPage ? STAINLESS_SUMMARY_PAGE
+                                            : STAINLESS_SUMMARY_SEARCH_RESULTS,
+          {subject.data(), subject.size()}, native.data(), native.size(),
+          EmitToken, &sink, &used_sources, &input_tokens, &generated_tokens,
+          &error);
+  engine.reset();
+  if (status != STAINLESS_RUNTIME_OK) {
+    LOG(ERROR) << "Local summary inference failed (runtime status " << status
+               << ", input tokens " << input_tokens << ", generated tokens "
+               << generated_tokens << ")";
+    std::move(callback).Run(
+        Failure(NativeStatus(status),
+                status == STAINLESS_RUNTIME_RESOURCE_LIMIT
+                    ? "Local summary exceeded its bounded context or output"
+                    : "Local summary did not complete successfully"));
+    return;
+  }
+  std::string raw;
+  for (const auto& text : sink.tokens) {
+    raw += text;
+  }
+  auto final = CompleteSummary(raw);
+  if (!used_sources || used_sources > sources.size() || !generated_tokens ||
+      generated_tokens > kMaximumSummaryTokens || !final.has_value()) {
+    std::move(callback).Run(
+        Failure(mojom::Status::kFailed,
+                "Local summary returned an invalid bounded result"));
+    return;
+  }
+  auto result = mojom::Result::New();
+  result->status = mojom::Status::kOk;
+  result->text = std::move(*final);
+  result->summary = mojom::SummaryMetrics::New();
+  result->summary->used_sources = used_sources;
+  result->summary->input_tokens = input_tokens;
+  result->summary->generated_tokens = generated_tokens;
+  std::move(callback).Run(std::move(result));
+}
+
 }  // namespace stainless_local
