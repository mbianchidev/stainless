diff --git a/chrome/services/stainless_local/summary_text.cc b/chrome/services/stainless_local/summary_text.cc
new file mode 100644
index 0000000000000000000000000000000000000000..1f346114692cbe7d2a5113cdde66db4614e1a625
--- /dev/null
+++ b/chrome/services/stainless_local/summary_text.cc
@@ -0,0 +1,126 @@
+#include "chrome/services/stainless_local/summary_text.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+
+namespace stainless_local {
+namespace {
+
+std::string_view StripMarker(std::string_view line) {
+  for (std::string_view marker : {"- ", "* ", "\u2022 "}) {
+    if (line.starts_with(marker)) {
+      return line.substr(marker.size());
+    }
+  }
+  size_t digits = 0;
+  while (digits < line.size() && digits < 3 &&
+         base::IsAsciiDigit(line[digits])) {
+    ++digits;
+  }
+  if (digits && digits + 1 < line.size() &&
+      (line[digits] == '.' || line[digits] == ')') && line[digits + 1] == ' ') {
+    return line.substr(digits + 2);
+  }
+  return line;
+}
+
+}  // namespace
+
+base::expected<std::string, std::string> CompleteSummary(std::string_view raw) {
+  if (raw.empty() || raw.size() > kMaximumSummaryBytes ||
+      !base::IsStringUTF8(raw) || raw.find('\0') != std::string_view::npos) {
+    return base::unexpected("Invalid generated summary");
+  }
+  std::string text(base::TrimWhitespaceASCII(raw, base::TRIM_ALL));
+  if (text.starts_with("<think>")) {
+    const auto end = text.find("</think>");
+    if (end == std::string::npos ||
+        !base::TrimWhitespaceASCII(std::string_view(text).substr(7, end - 7),
+                                   base::TRIM_ALL)
+             .empty()) {
+      return base::unexpected("Summary model returned reasoning, not a summary");
+    }
+    text = base::TrimWhitespaceASCII(std::string_view(text).substr(end + 8),
+                                     base::TRIM_ALL);
+  }
+  if (text.empty() || text.find("<think>") != std::string::npos) {
+    return base::unexpected("Summary model returned no final summary");
+  }
+  return base::ok(std::move(text));
+}
+
+std::vector<SummaryPoint> ParseSummary(std::string_view text,
+                                       size_t source_count) {
+  std::vector<SummaryPoint> points;
+  for (auto line : base::SplitStringPiece(text, "\n", base::TRIM_WHITESPACE,
+                                          base::SPLIT_WANT_NONEMPTY)) {
+    if (points.size() == kMaximumSummaryPoints) {
+      break;
+    }
+    line = base::TrimWhitespaceASCII(StripMarker(line), base::TRIM_ALL);
+    SummaryPoint point;
+    std::string body;
+    size_t offset = 0;
+    while (offset < line.size()) {
+      const auto open = line.find('[', offset);
+      const auto close =
+          open == std::string_view::npos ? open : line.find(']', open);
+      if (close == std::string_view::npos) {
+        body.append(line.substr(offset));
+        break;
+      }
+      bool citation = close > open + 1;
+      std::vector<uint32_t> numbers;
+      for (auto part : base::SplitStringPiece(
+               line.substr(open + 1, close - open - 1), ",",
+               base::TRIM_WHITESPACE, base::SPLIT_WANT_ALL)) {
+        uint32_t number = 0;
+        if (part.empty() || part.size() > 3 ||
+            !base::StringToUint(part, &number)) {
+          citation = false;
+          break;
+        }
+        numbers.push_back(number);
+      }
+      if (!citation) {
+        body.append(line.substr(offset, close + 1 - offset));
+        offset = close + 1;
+        continue;
+      }
+      body.append(line.substr(offset, open - offset));
+      for (const auto number : numbers) {
+        if (number >= 1 && number <= source_count) {
+          point.sources.push_back(number);
+        } else {
+          point.invalid_citation = true;
+        }
+      }
+      offset = close + 1;
+    }
+    std::string clean;
+    for (const char character : body) {
+      if ((character == '.' || character == ',' || character == ';') &&
+          clean.ends_with(' ')) {
+        clean.pop_back();
+      }
+      if (character != ' ' || (!clean.empty() && !clean.ends_with(' '))) {
+        clean.push_back(character);
+      }
+    }
+    point.text = base::TrimWhitespaceASCII(clean, base::TRIM_ALL);
+    if (point.text.empty()) {
+      continue;
+    }
+    std::ranges::sort(point.sources);
+    const auto [first, last] = std::ranges::unique(point.sources);
+    point.sources.erase(first, last);
+    points.push_back(std::move(point));
+  }
+  return points;
+}
+
+}  // namespace stainless_local
diff --git a/chrome/services/stainless_local/summary_text.h b/chrome/services/stainless_local/summary_text.h
new file mode 100644
index 0000000000000000000000000000000000000000..e6e521d435380c8779cb3778c2fdf86a11bccb3e
--- /dev/null
+++ b/chrome/services/stainless_local/summary_text.h
@@ -0,0 +1,41 @@
+#ifndef CHROME_SERVICES_STAINLESS_LOCAL_SUMMARY_TEXT_H_
+#define CHROME_SERVICES_STAINLESS_LOCAL_SUMMARY_TEXT_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/types/expected.h"
+
+namespace stainless_local {
+
+inline constexpr size_t kMaximumSummarySources = 16;
+inline constexpr size_t kMaximumSummarySourceBytes = 4096;
+inline constexpr size_t kMaximumSummarySubjectBytes = 1024;
+inline constexpr size_t kMaximumSummaryEvidenceBytes = 24576;
+inline constexpr uint32_t kMaximumSummaryTokens = 384;
+inline constexpr size_t kMaximumSummaryBytes = 8192;
+inline constexpr size_t kMaximumSummaryPoints = 12;
+
+struct SummaryPoint {
+  std::string text;
+  // Valid 1-based source numbers, sorted and unique.
+  std::vector<uint32_t> sources;
+  // The model cited a number outside the supplied sources.
+  bool invalid_citation = false;
+  bool operator==(const SummaryPoint&) const = default;
+};
+
+// Returns the generated final text without an empty reasoning block.
+base::expected<std::string, std::string> CompleteSummary(std::string_view raw);
+
+// Splits generated text into points and validates its [n] citations against
+// the number of sources the model actually received.
+std::vector<SummaryPoint> ParseSummary(std::string_view text,
+                                       size_t source_count);
+
+}  // namespace stainless_local
+
+#endif
diff --git a/chrome/services/stainless_local/summary_text_unittest.cc b/chrome/services/stainless_local/summary_text_unittest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..65b9f37e140b31bbbe06abc2bf3c550b97695e3d
--- /dev/null
+++ b/chrome/services/stainless_local/summary_text_unittest.cc
@@ -0,0 +1,45 @@
+#include "chrome/services/stainless_local/summary_text.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace stainless_local {
+
+TEST(StainlessSummaryTextTest, EmptyReasoningIsRemovedAndRealReasoningFails) {
+  auto result = CompleteSummary("<think>\n\n</think>\n- A fact. [1]\n");
+  ASSERT_TRUE(result.has_value());
+  EXPECT_EQ("- A fact. [1]", *result);
+  EXPECT_FALSE(CompleteSummary("<think>plan</think>- A fact. [1]").has_value());
+  EXPECT_FALSE(CompleteSummary("<think>unterminated").has_value());
+  EXPECT_FALSE(CompleteSummary("  \n").has_value());
+}
+
+TEST(StainlessSummaryTextTest, CitationsAreValidatedAgainstSuppliedSources) {
+  const auto points = ParseSummary(
+      "- The library opened on 3 March. [1]\n"
+      "* It holds 42,000 books [2][1][2].\n"
+      "3. Hours follow the tide. [2, 9]\n"
+      "\u2022 Nothing supports this.\n"
+      "- [3]\n"
+      "Keep [brackets] that are not citations. [0]",
+      2);
+  ASSERT_EQ(5u, points.size());
+  EXPECT_EQ((SummaryPoint{"The library opened on 3 March.", {1}, false}),
+            points[0]);
+  EXPECT_EQ((SummaryPoint{"It holds 42,000 books.", {1, 2}, false}),
+            points[1]);
+  EXPECT_EQ((SummaryPoint{"Hours follow the tide.", {2}, true}), points[2]);
+  EXPECT_EQ((SummaryPoint{"Nothing supports this.", {}, false}), points[3]);
+  EXPECT_EQ(
+      (SummaryPoint{"Keep [brackets] that are not citations.", {}, true}),
+      points[4]);
+}
+
+TEST(StainlessSummaryTextTest, PointCountIsBounded) {
+  std::string text;
+  for (int index = 0; index < 20; ++index) {
+    text += "- Point. [1]\n";
+  }
+  EXPECT_EQ(kMaximumSummaryPoints, ParseSummary(text, 1).size());
+}
+
+}  // namespace stainless_local
