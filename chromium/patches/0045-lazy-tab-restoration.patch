@@ -93,12 +97,30 @@ void SessionRestoreDelegate::RestoreTabs(
           SessionRestoreStatsCollector::UmaStatsReportingDelegate>())
       ->TrackTabs(tabs);
 
+  // Stainless: with lazy restoration, only each window's selected tab loads
+  // now. The others keep their restored history and load when first
+  // selected; their favicons come from the local favicon database.
+  const bool lazy =
+      Profile::FromBrowserContext(tabs.front().contents()->GetBrowserContext())
+          ->GetPrefs()
+          ->GetBoolean(prefs::kStainlessLazyTabRestoration);
   std::vector<content::WebContents*> web_contents_vector;
   web_contents_vector.reserve(tabs.size());
   for (const auto& tab : tabs) {
     CHECK(tab.contents());
+    if (lazy && !tab.is_active()) {
+      if (auto* favicon_driver = favicon::ContentFaviconDriver::FromWebContents(
+              tab.contents())) {
+        favicon_driver->FetchFavicon(favicon_driver->GetActiveURL(),
+                                     /*is_same_document=*/false);
+      }
+      continue;
+    }
     web_contents_vector.push_back(tab.contents());
   }
+  if (web_contents_vector.empty()) {
+    return;
+  }
   performance_manager::policies::ScheduleLoadForRestoredTabs(
       std::move(web_contents_vector));
 }
diff --git a/chrome/browser/ui/views/stainless_lazy_restore_browsertest.cc b/chrome/browser/ui/views/stainless_lazy_restore_browsertest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..985dd8673bd507eb786528611d67ea5a02c92ee7
--- /dev/null
+++ b/chrome/browser/ui/views/stainless_lazy_restore_browsertest.cc
@@ -0,0 +1,130 @@
+// Copyright 2026 Synctune Open
+
+#include <string>
+
+#include "base/strings/string_number_conversions.h"
+#include "base/test/run_until.h"
+#include "chrome/browser/prefs/session_startup_pref.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/common/stainless_pref_names.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "url/gurl.h"
+
+namespace {
+
+GURL Page(int number) {
+  return GURL("data:text/html,<title>Restored page " +
+              base::NumberToString(number) + "</title>");
+}
+
+bool Loaded(content::WebContents* contents) {
+  return !contents->GetController().NeedsReload();
+}
+
+}  // namespace
+
+// Each PRE_ launch leaves three tabs with the first one selected and
+// "Continue where you left off" on. The next launch restores them.
+class StainlessTabRestoreBrowserTest : public InProcessBrowserTest {
+ protected:
+  explicit StainlessTabRestoreBrowserTest(bool lazy) : lazy_(lazy) {
+    // A launch URL would replace session restore.
+    set_open_about_blank_on_browser_launch(false);
+  }
+
+  void SaveSession() {
+    Profile* profile = browser()->GetProfile();
+    SessionStartupPref::SetStartupPref(
+        profile, SessionStartupPref(SessionStartupPref::LAST));
+    profile->GetPrefs()->SetBoolean(prefs::kStainlessLazyTabRestoration,
+                                    lazy_);
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), Page(1)));
+    for (int page : {2, 3}) {
+      ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+          browser(), Page(page),
+          ui::mojom::WindowOpenDisposition::kNewForegroundTab,
+          ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    }
+    browser()->GetTabStripModel()->ActivateTabAt(0);
+  }
+
+  TabStripModel* RestoredTabs() {
+    TabStripModel* tabs = browser()->GetTabStripModel();
+    EXPECT_TRUE(base::test::RunUntil([&] { return tabs->count() == 3; }));
+    EXPECT_EQ(0, tabs->active_index());
+    for (int i = 0; i < tabs->count(); ++i) {
+      EXPECT_EQ(Page(i + 1), tabs->GetWebContentsAt(i)->GetVisibleURL());
+    }
+    return tabs;
+  }
+
+ private:
+  const bool lazy_;
+};
+
+class StainlessLazyTabRestoreBrowserTest
+    : public StainlessTabRestoreBrowserTest {
+ public:
+  StainlessLazyTabRestoreBrowserTest()
+      : StainlessTabRestoreBrowserTest(/*lazy=*/true) {}
+};
+
+IN_PROC_BROWSER_TEST_F(StainlessLazyTabRestoreBrowserTest,
+                       PRE_BackgroundTabsLoadWhenSelected) {
+  SaveSession();
+}
+
+IN_PROC_BROWSER_TEST_F(StainlessLazyTabRestoreBrowserTest,
+                       BackgroundTabsLoadWhenSelected) {
+  TabStripModel* tabs = RestoredTabs();
+  content::WebContents* selected = tabs->GetWebContentsAt(0);
+  ASSERT_TRUE(base::test::RunUntil([&] { return Loaded(selected); }));
+  // Unselected tabs keep their history but stay unloaded.
+  for (int i : {1, 2}) {
+    content::WebContents* contents = tabs->GetWebContentsAt(i);
+    EXPECT_FALSE(Loaded(contents));
+    EXPECT_EQ(1, contents->GetController().GetEntryCount());
+  }
+  tabs->ActivateTabAt(2);
+  EXPECT_TRUE(base::test::RunUntil(
+      [&] { return Loaded(tabs->GetWebContentsAt(2)); }));
+  EXPECT_TRUE(content::WaitForLoadStop(tabs->GetWebContentsAt(2)));
+  EXPECT_EQ(u"Restored page 3", tabs->GetWebContentsAt(2)->GetTitle());
+  EXPECT_FALSE(Loaded(tabs->GetWebContentsAt(1)));
+}
+
+class StainlessEagerTabRestoreBrowserTest
+    : public StainlessTabRestoreBrowserTest {
+ public:
+  StainlessEagerTabRestoreBrowserTest()
+      : StainlessTabRestoreBrowserTest(/*lazy=*/false) {}
+};
+
+IN_PROC_BROWSER_TEST_F(StainlessEagerTabRestoreBrowserTest,
+                       PRE_BackgroundTabsLoadByDefault) {
+  EXPECT_FALSE(browser()->GetProfile()->GetPrefs()->GetBoolean(
+      prefs::kStainlessLazyTabRestoration));
+  SaveSession();
+}
+
+IN_PROC_BROWSER_TEST_F(StainlessEagerTabRestoreBrowserTest,
+                       BackgroundTabsLoadByDefault) {
+  TabStripModel* tabs = RestoredTabs();
+  // Chromium's background loading policy loads every restored tab.
+  EXPECT_TRUE(base::test::RunUntil([&] {
+    for (int i = 0; i < tabs->count(); ++i) {
+      if (!Loaded(tabs->GetWebContentsAt(i))) {
+        return false;
+      }
+    }
+    return true;
+  }));
+}
