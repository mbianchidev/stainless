@@ -0,0 +1,107 @@
+#ifndef CHROME_BROWSER_STAINLESS_LOCAL_LOCAL_CAPTION_H_
+#define CHROME_BROWSER_STAINLESS_LOCAL_LOCAL_CAPTION_H_
+
+#include <memory>
+#include <string>
+
+#include "base/callback_list.h"
+#include "base/memory/weak_ptr.h"
+#include "base/timer/timer.h"
+#include "base/types/expected.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "content/public/browser/weak_document_ptr.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "media/mojo/mojom/speech_recognition.mojom.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "mojo/public/cpp/bindings/remote.h"
+
+class Profile;
+namespace media {
+struct SpeechRecognitionResult;
+}
+
+namespace stainless_local {
+
+class LocalCaptionAudio;
+class LocalSpeechStream;
+
+class LocalCaption final
+    : public content::WebContentsObserver,
+      public content::WebContentsUserData<LocalCaption>,
+      public media::mojom::SpeechRecognitionRecognizerClient {
+ public:
+  struct Options {
+    std::string source;
+    std::string target;
+  };
+  class Presentation {
+   public:
+    virtual ~Presentation() = default;
+    virtual bool OnTranscription(
+        const media::SpeechRecognitionResult& result) = 0;
+    virtual void OnStatus(const std::string& status, bool error) = 0;
+  };
+
+  static LocalCaption* Get(content::WebContents* contents);
+  static LocalCaption* SelectedForProfile(Profile* profile);
+  static bool StopForProfile(Profile* profile);
+  ~LocalCaption() override;
+
+  base::expected<void, std::string> Start(
+      Options options,
+      std::unique_ptr<Presentation> presentation);
+  void Stop();
+  bool selected() const { return selected_; }
+  bool paused() const { return paused_; }
+  const Options& options() const { return options_; }
+  const std::string& status() const { return status_; }
+  bool error() const { return error_; }
+  base::CallbackListSubscription Observe(
+      base::RepeatingCallback<void(const std::string&, bool)> update);
+  bool Authorized() const;
+  base::WeakPtr<LocalCaption> GetWeakPtr() { return lifetime_.GetWeakPtr(); }
+
+ private:
+  friend class content::WebContentsUserData<LocalCaption>;
+  explicit LocalCaption(content::WebContents* contents);
+  base::expected<void, std::string> BeginCapture();
+  void StreamStatus(const std::string& status, bool error);
+  void StreamClosed();
+  void Fail(const std::string& error);
+  void Release();
+  void PreferencesChanged();
+  void Notify(const std::string& status, bool error);
+  void PrimaryPageChanged(content::Page& page) override;
+  void WebContentsDestroyed() override;
+
+  void OnSpeechRecognitionRecognitionEvent(
+      const media::SpeechRecognitionResult& result,
+      OnSpeechRecognitionRecognitionEventCallback reply) override;
+  void OnSpeechRecognitionError() override;
+  void OnLanguageIdentificationEvent(
+      media::mojom::LanguageIdentificationEventPtr event) override;
+  void OnSpeechRecognitionStopped() override;
+
+  Options options_;
+  content::WeakDocumentPtr document_;
+  std::unique_ptr<Presentation> presentation_;
+  std::unique_ptr<LocalCaptionAudio> audio_;
+  std::unique_ptr<LocalSpeechStream> stream_;
+  mojo::Remote<media::mojom::SpeechRecognitionRecognizer> recognizer_;
+  mojo::Receiver<media::mojom::SpeechRecognitionRecognizerClient> client_{this};
+  PrefChangeRegistrar preferences_;
+  base::OneShotTimer session_limit_;
+  bool selected_ = false;
+  bool paused_ = false;
+  std::string status_ = "Local tab captions are not running";
+  bool error_ = false;
+  base::RepeatingCallbackList<void(const std::string&, bool)> observers_;
+  base::WeakPtrFactory<LocalCaption> operations_{this};
+  base::WeakPtrFactory<LocalCaption> lifetime_{this};
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+}  // namespace stainless_local
+
+#endif
