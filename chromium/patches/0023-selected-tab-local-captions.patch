+bool StainlessCaptionView::OwnsActiveDocument() const {
+  auto* frame = document_.AsRenderFrameHostIfValid();
+  return browser_ && !browser_->IsDeleteScheduled() && caption_ && frame &&
+         browser_->GetTabStripModel()->GetActiveWebContents() ==
+             content::WebContents::FromRenderFrameHost(frame) &&
+         chrome::CanOpenStainlessLocalControls(browser_.get());
+}
+
+void StainlessCaptionView::Start() {
+  if (!OwnsActiveDocument() || !start_->GetEnabled()) {
+    OnStatus(l10n_util::GetStringUTF8(IDS_STAINLESS_CAPTION_OWNER_CHANGED),
+             true);
+    return;
+  }
+  const auto language = stainless_local::SelectedSpeechLanguage(
+      browser_->GetProfile(), base::UTF16ToUTF8(source_->GetText()));
+  if (!language) {
+    OnStatus(
+        l10n_util::GetStringUTF8(IDS_STAINLESS_CAPTION_LANGUAGE_UNSUPPORTED),
+        true);
+    return;
+  }
+  const auto target = kTargets.at(target_->GetSelectedIndex().value_or(0));
+  stainless_local::LocalCaption::Options options;
+  options.source = *language;
+  options.target =
+      target.tag_string() == "und" ? "" : std::string(target.tag_string());
+  auto* contents = browser_->GetTabStripModel()->GetActiveWebContents();
+  auto presentation = std::make_unique<NativeCaptionPresentation>(
+      browser_.get(), contents, caption_, *language, target);
+  caption_text_for_testing_ = base::BindRepeating(
+      [](base::WeakPtr<NativeCaptionPresentation> presentation) {
+        return presentation ? presentation->TextForTesting() : std::string();
+      },
+      presentation->GetWeakPtr());
+  const auto started =
+      caption_->Start(std::move(options), std::move(presentation));
+  if (!started.has_value()) {
+    OnStatus(started.error(), true);
+  }
+  Refresh();
+}
+
+void StainlessCaptionView::Stop() {
+  if (caption_) {
+    caption_->Stop();
+  }
+  Refresh();
+}
+
+void StainlessCaptionView::OpenSettings() {
+  open_settings_ = true;
+  GetWidget()->Close();
+}
+
+void StainlessCaptionView::OnStatus(const std::string& status, bool) {
+  status_->SetText(base::UTF8ToUTF16(status));
+  Refresh();
+}
+
+void StainlessCaptionView::Refresh() {
+  const bool owner = OwnsActiveDocument();
+  const bool running = caption_ && caption_->selected();
+  source_->SetEnabled(owner && !running);
+  target_->SetEnabled(owner && !running);
+  start_->SetEnabled(owner && !running &&
+                     stainless_local::IsLocalFeatureAllowed(
+                         document_.AsRenderFrameHostIfValid(),
+                         stainless_local::Feature::kCaptions));
+  stop_->SetEnabled(running);
+  if (!owner) {
+    status_->SetText(
+        l10n_util::GetStringUTF16(IDS_STAINLESS_CAPTION_OWNER_CHANGED));
+  }
+}
+
+void StainlessCaptionView::OnBrowserClosed(BrowserWindowInterface*) {
+  registration_.reset();
+  browser_.reset();
+  GetWidget()->Close();
+}
+
+void StainlessCaptionView::OnWidgetDestroyed(views::Widget*) {
+  weak_.InvalidateWeakPtrs();
+  updates_ = {};
+  widget_.Reset();
+  registration_.reset();
+  browser_closed_ = {};
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::WeakPtr<BrowserWindowInterface> browser, bool settings,
+             std::unique_ptr<views::ViewTracker> focus) {
+            if (!browser || browser->IsDeleteScheduled()) {
+              return;
+            }
+            if (settings) {
+              chrome::ShowSettingsSubPage(browser.get(), "localServices");
+            } else if (focus->view() && focus->view()->IsDrawn() &&
+                       focus->view()->IsFocusable()) {
+              focus->view()->RequestFocus();
+            } else if (auto* contents = browser->GetTabStripModel()
+                                            ->GetActiveWebContents()) {
+              contents->Focus();
+            }
+          },
+          browser_, open_settings_, std::move(return_focus_)));
+}
+
+namespace chrome {
+
+void ShowLocalTabCaptions(BrowserWindowInterface* browser) {
+  StainlessCaptionView::Show(browser);
+}
+
+}  // namespace chrome
+
+BEGIN_METADATA(StainlessCaptionView)
+END_METADATA
