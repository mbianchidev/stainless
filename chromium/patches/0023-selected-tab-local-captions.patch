+class NativeCaptionPresentation final
+    : public stainless_local::LocalCaption::Presentation,
+      public captions::CaptionBubbleSettings {
+ public:
+  NativeCaptionPresentation(
+      BrowserWindowInterface* browser,
+      content::WebContents* contents,
+      base::WeakPtr<stainless_local::LocalCaption> caption,
+      std::string source,
+      base::i18n::LanguageTag target)
+      : browser_(browser->GetWeakPtr()),
+        caption_(caption),
+        document_(contents->GetPrimaryMainFrame()->GetWeakDocumentPtr()),
+        source_(std::move(source)),
+        target_(target),
+        context_(captions::CaptionBubbleContextBrowser::Create(contents)),
+        controller_(captions::CaptionBubbleController::Create(
+            this,
+            g_browser_process->GetApplicationLocale(),
+            nullptr)) {}
+  ~NativeCaptionPresentation() override { controller_.reset(); }
+  base::WeakPtr<NativeCaptionPresentation> GetWeakPtr() {
+    return weak_.GetWeakPtr();
+  }
+  std::string TextForTesting() {
+    return controller_->GetBubbleLabelTextForTesting();
+  }
+
+  bool OnTranscription(const media::SpeechRecognitionResult& result) override {
+    auto* frame = document_.AsRenderFrameHostIfValid();
+    return frame && caption_ && caption_->Authorized() &&
+           controller_->OnTranscription(frame, context_.get(), result);
+  }
+  void OnStatus(const std::string&, bool error) override {
+    if (error) {
+      controller_->OnError(
+          context_.get(), captions::kGeneric,
+          base::BindRepeating(&NativeCaptionPresentation::OpenSettings,
+                              weak_.GetWeakPtr()),
+          base::DoNothing());
+    }
+  }
+
+  void SetObserver(base::WeakPtr<Observer> observer) override {
+    observer_ = observer;
+  }
+  void RemoveObserver() override { observer_.reset(); }
+  bool IsLiveTranslateFeatureEnabled() override { return false; }
+  bool GetLiveCaptionBubbleExpanded() override { return expanded_; }
+  bool GetLiveTranslateEnabled() override { return false; }
+  std::string GetLiveCaptionLanguageCode() override {
+    return target_.tag_string() == "und" ? source_
+                                         : std::string(target_.tag_string());
+  }
+  base::i18n::LanguageTag GetLiveTranslateTargetLanguageCode() override {
+    return target_;
+  }
+  void SetLiveCaptionEnabled(bool enabled) override {
+    if (!enabled) {
+      OnCaptionBubbleClosed();
+    } else {
+      LOG(WARNING) << "Stainless captions require the native tab start action";
+    }
+  }
+  void SetLiveCaptionBubbleExpanded(bool expanded) override {
+    expanded_ = expanded;
+  }
+  void SetLiveTranslateTargetLanguageCode(
+      const base::i18n::LanguageTag&) override {
+    LOG(WARNING)
+        << "Stainless caption language changes require a native restart";
+    OnCaptionBubbleClosed();
+  }
+  bool ShouldAdjustPositionOnExpand() override { return true; }
+  void OnCaptionBubbleClosed() override {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(&stainless_local::LocalCaption::Stop, caption_));
+  }
+
+ private:
+  void OpenSettings() {
+    if (browser_ && !browser_->IsDeleteScheduled()) {
+      chrome::ShowSettingsSubPage(browser_.get(), "localServices");
+    }
+  }
+
+  base::WeakPtr<BrowserWindowInterface> browser_;
+  base::WeakPtr<stainless_local::LocalCaption> caption_;
+  content::WeakDocumentPtr document_;
+  const std::string source_;
+  const base::i18n::LanguageTag target_;
+  bool expanded_ = false;
+  base::WeakPtr<Observer> observer_;
+  std::unique_ptr<captions::CaptionBubbleContextBrowser> context_;
+  std::unique_ptr<captions::CaptionBubbleController> controller_;
+  base::WeakPtrFactory<NativeCaptionPresentation> weak_{this};
+};
