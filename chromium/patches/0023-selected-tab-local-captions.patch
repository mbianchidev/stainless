diff --git a/chrome/browser/stainless_local/local_caption.cc b/chrome/browser/stainless_local/local_caption.cc
new file mode 100644
index 0000000000000000000000000000000000000000..21775bab9e569eb0e262795103ffa7976d74456d
--- /dev/null
+++ b/chrome/browser/stainless_local/local_caption.cc
@@ -0,0 +1,282 @@
+#include "chrome/browser/stainless_local/local_caption.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/logging.h"
+#include "base/no_destructor.h"
+#include "base/task/bind_post_task.h"
+#include "base/task/single_thread_task_runner.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/stainless_local/local_broker.h"
+#include "chrome/browser/stainless_local/local_caption_audio.h"
+#include "chrome/browser/stainless_local/local_models.h"
+#include "chrome/browser/stainless_local/local_speech.h"
+#include "chrome/browser/stainless_local/local_speech_stream.h"
+#include "chrome/browser/stainless_local/local_translation.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "media/mojo/mojom/audio_data.mojom.h"
+#include "media/mojo/mojom/speech_recognition_result.h"
+#include "mojo/public/cpp/bindings/remote.h"
+
+namespace stainless_local {
+namespace {
+
+base::WeakPtr<LocalCaption>& Selected() {
+  static base::NoDestructor<base::WeakPtr<LocalCaption>> selected;
+  return *selected;
+}
+
+}  // namespace
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(LocalCaption);
+
+LocalCaption* LocalCaption::Get(content::WebContents* contents) {
+  CreateForWebContents(contents);
+  return FromWebContents(contents);
+}
+
+LocalCaption* LocalCaption::SelectedForProfile(Profile* profile) {
+  auto selected = Selected();
+  return selected && selected->web_contents() &&
+                 selected->web_contents()->GetBrowserContext() == profile
+             ? selected.get()
+             : nullptr;
+}
+
+bool LocalCaption::StopForProfile(Profile* profile) {
+  auto* selected = SelectedForProfile(profile);
+  if (!selected) {
+    return false;
+  }
+  selected->Stop();
+  return true;
+}
+
+LocalCaption::LocalCaption(content::WebContents* contents)
+    : content::WebContentsObserver(contents),
+      content::WebContentsUserData<LocalCaption>(*contents) {
+  preferences_.Init(
+      Profile::FromBrowserContext(contents->GetBrowserContext())->GetPrefs());
+  for (const char* preference : {kCaptionsEnabled, kTranslationEnabled}) {
+    preferences_.Add(preference,
+                     base::BindRepeating(&LocalCaption::PreferencesChanged,
+                                         base::Unretained(this)));
+  }
+}
+
+LocalCaption::~LocalCaption() {
+  Stop();
+}
+
+base::expected<void, std::string> LocalCaption::Start(
+    Options options,
+    std::unique_ptr<Presentation> presentation) {
+  auto* frame = web_contents()->GetPrimaryMainFrame();
+  if (!presentation || selected_ || (Selected() && Selected().get() != this) ||
+      web_contents()->GetVisibility() != content::Visibility::VISIBLE ||
+      !IsLocalFeatureAllowed(frame, Feature::kCaptions)) {
+    return base::unexpected(
+        "Local captions require an eligible selected tab, consent and no "
+        "other caption selection");
+  }
+  auto* profile = Profile::FromBrowserContext(frame->GetBrowserContext());
+  const auto language = SelectedSpeechLanguage(profile, options.source);
+  if (!language) {
+    return base::unexpected(
+        "The selected caption speech language is unsupported");
+  }
+  options.source = *language;
+  if (!options.target.empty() &&
+      (NormalizeTranslationLanguage(options.source) != options.source ||
+       NormalizeTranslationLanguage(options.target) != options.target ||
+       !IsLocalFeatureAllowed(frame, Feature::kTranslation))) {
+    return base::unexpected(
+        "Caption translation needs separate local-translation consent and "
+        "English, Italian, French, German or Spanish");
+  }
+  document_ = frame->GetWeakDocumentPtr();
+  options_ = std::move(options);
+  presentation_ = std::move(presentation);
+  selected_ = true;
+  paused_ = false;
+  Selected() = lifetime_.GetWeakPtr();
+  session_limit_.Start(
+      FROM_HERE, base::Hours(2),
+      base::BindOnce(&LocalCaption::Fail, operations_.GetWeakPtr(),
+                     "The two-hour caption selection ended; start it again "
+                     "from the native tab action"));
+  const auto started = BeginCapture();
+  if (!started.has_value()) {
+    Fail(started.error());
+  }
+  return started;
+}
+
+bool LocalCaption::Authorized() const {
+  auto* frame = document_.AsRenderFrameHostIfValid();
+  return selected_ && frame && frame == web_contents()->GetPrimaryMainFrame() &&
+         IsLocalFeatureAllowed(frame, Feature::kCaptions) &&
+         (options_.target.empty() ||
+          IsLocalFeatureAllowed(frame, Feature::kTranslation));
+}
+
+base::expected<void, std::string> LocalCaption::BeginCapture() {
+  if (!Authorized()) {
+    return base::unexpected(
+        "The selected caption document or feature authorization changed");
+  }
+  auto options = media::mojom::SpeechRecognitionOptions::New();
+  options->language = options_.source;
+  options->recognition_mode = media::mojom::SpeechRecognitionMode::kCaption;
+  options->recognizer_client_type =
+      media::mojom::RecognizerClientType::kLiveCaption;
+  options->enable_formatting = true;
+  options->allow_multi_language = false;
+  stream_ = std::make_unique<LocalSpeechStream>(
+      document_, Feature::kCaptions, std::move(options),
+      recognizer_.BindNewPipeAndPassReceiver(),
+      client_.BindNewPipeAndPassRemote(),
+      base::BindPostTaskToCurrentDefault(base::BindRepeating(
+          &LocalCaption::StreamStatus, operations_.GetWeakPtr())),
+      base::DoNothing(),
+      base::BindOnce(&LocalCaption::StreamClosed, operations_.GetWeakPtr()),
+      options_.target,
+      base::BindRepeating(
+          [](base::WeakPtr<LocalCaption> caption) {
+            return caption && caption->Authorized();
+          },
+          operations_.GetWeakPtr()));
+  audio_ = std::make_unique<LocalCaptionAudio>(
+      web_contents()->GetAudioGroupId(),
+      base::BindRepeating(
+          [](base::WeakPtr<LocalCaption> caption,
+             media::mojom::AudioDataS16Ptr audio) {
+            if (caption && caption->Authorized() && caption->stream_) {
+              caption->stream_->SendAudioToSpeechRecognitionService(
+                  std::move(audio), std::nullopt);
+            } else if (caption) {
+              caption->Fail("The selected caption document changed");
+            }
+          },
+          operations_.GetWeakPtr()),
+      base::BindPostTaskToCurrentDefault(
+          base::BindRepeating(&LocalCaption::Fail, operations_.GetWeakPtr())));
+  const auto started = audio_->Start();
+  if (!started.has_value()) {
+    return base::unexpected(started.error());
+  }
+  StreamStatus("Waiting for selected-tab audio", false);
+  return {};
+}
+
+void LocalCaption::StreamStatus(const std::string& status, bool error) {
+  if (!selected_) {
+    return;
+  }
+  if (error) {
+    Fail(status);
+    return;
+  }
+  paused_ = status.starts_with("Captions paused") ||
+            status.starts_with("Captions armed");
+  Notify(status, false);
+}
+
+base::CallbackListSubscription LocalCaption::Observe(
+    base::RepeatingCallback<void(const std::string&, bool)> update) {
+  return observers_.Add(std::move(update));
+}
+
+void LocalCaption::Notify(const std::string& status, bool error) {
+  status_ = status;
+  error_ = error;
+  if (auto* models = LocalModels::GetIfExists(
+          Profile::FromBrowserContext(web_contents()->GetBrowserContext()))) {
+    models->ReportRuntimeStatus(Feature::kCaptions, status, error);
+  }
+  if (presentation_) {
+    presentation_->OnStatus(status, error);
+  }
+  observers_.Notify(status, error);
+}
+
+void LocalCaption::Release() {
+  operations_.InvalidateWeakPtrs();
+  session_limit_.Stop();
+  if (audio_) {
+    audio_->Stop();
+  }
+  audio_.reset();
+  recognizer_.reset();
+  stream_.reset();
+  client_.reset();
+  selected_ = false;
+  paused_ = false;
+  if (Selected().get() == this) {
+    Selected().reset();
+  }
+  document_ = {};
+}
+
+void LocalCaption::Stop() {
+  const bool was_selected = selected_;
+  Release();
+  presentation_.reset();
+  if (was_selected && web_contents()) {
+    Notify("Local tab captions stopped", false);
+  }
+}
+
+void LocalCaption::Fail(const std::string& error) {
+  if (!selected_) {
+    return;
+  }
+  LOG(ERROR) << "Stainless local captions: selected-tab session stopped";
+  Release();
+  Notify(error, true);
+}
+
+void LocalCaption::StreamClosed() {
+  Fail("Local caption inference stopped; use the native action to start again");
+}
+
+void LocalCaption::PreferencesChanged() {
+  if (selected_ && !Authorized()) {
+    Fail("Local captions or their requested translation were disabled");
+  }
+}
+
+void LocalCaption::PrimaryPageChanged(content::Page&) {
+  Stop();
+}
+
+void LocalCaption::WebContentsDestroyed() {
+  Stop();
+}
+
+void LocalCaption::OnSpeechRecognitionRecognitionEvent(
+    const media::SpeechRecognitionResult& result,
+    OnSpeechRecognitionRecognitionEventCallback reply) {
+  const bool accepted =
+      Authorized() && presentation_ && presentation_->OnTranscription(result);
+  std::move(reply).Run(accepted);
+  if (!accepted) {
+    Stop();
+  }
+}
+
+void LocalCaption::OnSpeechRecognitionError() {
+  Fail("Local caption inference failed");
+}
+
+void LocalCaption::OnLanguageIdentificationEvent(
+    media::mojom::LanguageIdentificationEventPtr) {}
+
+void LocalCaption::OnSpeechRecognitionStopped() {
+  Stop();
+}
+
+}  // namespace stainless_local
