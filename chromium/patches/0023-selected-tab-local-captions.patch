@@ -0,0 +1,226 @@
+#include "chrome/browser/stainless_local/local_caption_audio.h"
+
+#include <memory>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/memory/raw_ptr.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/task/bind_post_task.h"
+#include "content/public/browser/audio_service.h"
+#include "content/public/browser/browser_thread.h"
+#include "media/audio/audio_input_device.h"
+#include "media/audio/audio_input_ipc.h"
+#include "media/base/audio_bus.h"
+#include "media/base/audio_parameters.h"
+#include "media/base/audio_sample_types.h"
+#include "media/mojo/common/input_error_code_converter.h"
+#include "media/mojo/mojom/audio_data_pipe.mojom.h"
+#include "media/mojo/mojom/audio_input_stream.mojom.h"
+#include "media/mojo/mojom/audio_stream_factory.mojom.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "mojo/public/cpp/bindings/remote.h"
+
+namespace stainless_local {
+namespace {
+
+constexpr int kSampleRate = 16000;
+constexpr int kFramesPerBuffer = 1600;
+constexpr size_t kUiQueuedFrames = 16000;
+
+class CaptionLoopbackIPC final : public media::AudioInputIPC,
+                                 public media::mojom::AudioInputStreamClient,
+                                 public media::mojom::AudioInputStreamObserver {
+ public:
+  explicit CaptionLoopbackIPC(base::UnguessableToken group) : group_(group) {}
+  ~CaptionLoopbackIPC() override { CloseStream(); }
+
+  void CreateStream(media::AudioInputIPCDelegate* delegate,
+                    const media::AudioParameters& parameters,
+                    bool automatic_gain_control,
+                    uint32_t segments) override {
+    delegate_ = delegate;
+    if (!delegate_ || group_.is_empty() || automatic_gain_control ||
+        parameters.channels() != 1 || parameters.sample_rate() != kSampleRate ||
+        parameters.frames_per_buffer() != kFramesPerBuffer || segments == 0 ||
+        segments > 10) {
+      OnError(media::mojom::InputStreamErrorCode::kUnknown);
+      return;
+    }
+    content::GetAudioService().BindStreamFactory(
+        factory_.BindNewPipeAndPassReceiver());
+    factory_.set_disconnect_handler(
+        base::BindOnce(&CaptionLoopbackIPC::Disconnected, weak_.GetWeakPtr()));
+    factory_->CreateLoopbackStream(
+        stream_.BindNewPipeAndPassReceiver(),
+        client_.BindNewPipeAndPassRemote(),
+        observer_.BindNewPipeAndPassRemote(), parameters, segments, group_,
+        base::BindOnce(&CaptionLoopbackIPC::Created, weak_.GetWeakPtr()));
+    stream_.set_disconnect_handler(
+        base::BindOnce(&CaptionLoopbackIPC::Disconnected, weak_.GetWeakPtr()));
+  }
+
+  void RecordStream() override {
+    if (stream_.is_bound()) {
+      stream_->Record();
+    } else {
+      Disconnected();
+    }
+  }
+  void SetVolume(double volume) override {
+    if (stream_.is_bound() && volume >= 0 && volume <= 1) {
+      stream_->SetVolume(volume);
+    } else {
+      Disconnected();
+    }
+  }
+  void SetOutputDeviceForAec(const std::string&) override { Disconnected(); }
+  void CloseStream() override {
+    weak_.InvalidateWeakPtrs();
+    delegate_ = nullptr;
+    client_.reset();
+    observer_.reset();
+    stream_.reset();
+    factory_.reset();
+  }
+  void OnError(media::mojom::InputStreamErrorCode code) override {
+    if (delegate_) {
+      delegate_->OnError(media::ConvertToCaptureCallbackCode(code));
+    }
+  }
+  void OnMutedStateChanged(bool muted) override {
+    if (delegate_) {
+      delegate_->OnMuted(muted);
+    }
+  }
+  void DidStartRecording() override {}
+
+ private:
+  void Created(media::mojom::ReadWriteAudioDataPipePtr pipe) {
+    if (!delegate_) {
+      return;
+    }
+    if (!pipe || !pipe->shared_memory.IsValid() ||
+        !pipe->socket.is_valid_platform_file()) {
+      Disconnected();
+      return;
+    }
+    delegate_->OnStreamCreated(std::move(pipe->shared_memory),
+                               pipe->socket.TakePlatformFile(), false);
+  }
+  void Disconnected() { OnError(media::mojom::InputStreamErrorCode::kUnknown); }
+
+  const base::UnguessableToken group_;
+  raw_ptr<media::AudioInputIPCDelegate> delegate_ = nullptr;
+  mojo::Remote<media::mojom::AudioStreamFactory> factory_;
+  mojo::Remote<media::mojom::AudioInputStream> stream_;
+  mojo::Receiver<media::mojom::AudioInputStreamClient> client_{this};
+  mojo::Receiver<media::mojom::AudioInputStreamObserver> observer_{this};
+  base::WeakPtrFactory<CaptionLoopbackIPC> weak_{this};
+};
+
+}  // namespace
+
+LocalCaptionAudio::LocalCaptionAudio(base::UnguessableToken group,
+                                     Audio audio,
+                                     Failure failure)
+    : audio_group_(group),
+      audio_(std::move(audio)),
+      failure_(std::move(failure)) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  deliver_to_ui_ = base::BindPostTaskToCurrentDefault(
+      base::BindRepeating(&LocalCaptionAudio::Deliver, weak_.GetWeakPtr()));
+  fail_to_ui_ = base::BindPostTaskToCurrentDefault(
+      base::BindRepeating(&LocalCaptionAudio::Failed, weak_.GetWeakPtr()));
+}
+
+LocalCaptionAudio::~LocalCaptionAudio() {
+  Stop();
+}
+
+base::expected<void, std::string> LocalCaptionAudio::Start() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (source_ || failed_.load() || audio_group_.is_empty() || !audio_ ||
+      !failure_) {
+    return base::unexpected("Selected-tab audio has no valid native owner");
+  }
+  source_ = base::MakeRefCounted<media::AudioInputDevice>(
+      std::make_unique<CaptionLoopbackIPC>(audio_group_),
+      media::AudioInputDevice::kLoopback,
+      media::AudioInputDevice::DeadStreamDetection::kDisabled);
+  source_->Initialize(
+      media::AudioParameters(media::AudioParameters::AUDIO_PCM_LOW_LATENCY,
+                             media::ChannelLayoutConfig::Mono(), kSampleRate,
+                             kFramesPerBuffer),
+      this);
+  source_->Start();
+  return {};
+}
+
+void LocalCaptionAudio::Stop() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  failed_.store(true);
+  if (source_) {
+    source_->Stop();
+    source_.reset();
+  }
+  weak_.InvalidateWeakPtrs();
+}
+
+void LocalCaptionAudio::Capture(const media::AudioBus* source,
+                                base::TimeTicks,
+                                const media::AudioGlitchInfo&,
+                                double) {
+  if (failed_.load()) {
+    return;
+  }
+  if (!source || source->channels() != 1 ||
+      source->frames() != kFramesPerBuffer) {
+    FailFromAudioThread("Selected-tab audio has an unsupported PCM format");
+    return;
+  }
+  const size_t frames = source->frames();
+  if (pending_frames_.fetch_add(frames) + frames > kUiQueuedFrames) {
+    pending_frames_.fetch_sub(frames);
+    FailFromAudioThread(
+        "Local captions cannot keep up; the bounded audio handoff is full");
+    return;
+  }
+  auto audio = media::mojom::AudioDataS16::New();
+  audio->sample_rate = kSampleRate;
+  audio->channel_count = 1;
+  audio->frame_count = frames;
+  audio->data.resize(frames);
+  source->ToInterleaved<media::SignedInt16SampleTypeTraits>(audio->data);
+  deliver_to_ui_.Run(std::move(audio));
+}
+
+void LocalCaptionAudio::Deliver(media::mojom::AudioDataS16Ptr audio) {
+  pending_frames_.fetch_sub(audio->data.size());
+  if (!failed_.load()) {
+    auto callback = audio_;
+    callback.Run(std::move(audio));
+  }
+}
+
+void LocalCaptionAudio::OnCaptureError(
+    media::AudioCapturerSource::ErrorCode code,
+    const std::string&) {
+  FailFromAudioThread("Selected-tab audio capture error " +
+                      base::NumberToString(static_cast<int>(code)));
+}
+
+void LocalCaptionAudio::OnCaptureMuted(bool) {}
+
+void LocalCaptionAudio::FailFromAudioThread(const std::string& error) {
+  if (!failed_.exchange(true)) {
+    fail_to_ui_.Run(error);
+  }
+}
+
+void LocalCaptionAudio::Failed(const std::string& error) {
+  auto callback = failure_;
+  callback.Run(error);
+}
+
+}  // namespace stainless_local
