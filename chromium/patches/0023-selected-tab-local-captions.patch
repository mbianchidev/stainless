+StainlessCaptionView::StainlessCaptionView(BrowserWindowInterface* browser)
+    : browser_(browser->GetWeakPtr()),
+      caption_(stainless_local::LocalCaption::Get(
+                   browser->GetTabStripModel()->GetActiveWebContents())
+                   ->GetWeakPtr()),
