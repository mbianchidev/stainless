+                    ->GetActiveWebContents()
+                    ->GetPrimaryMainFrame()
+                    ->GetWeakDocumentPtr()),
+      return_focus_(std::make_unique<views::ViewTracker>()) {
+  registration_.emplace(browser->GetUnownedUserDataHost(), *this);
+  browser_closed_ = browser->RegisterBrowserDidClose(base::BindRepeating(
+      &StainlessCaptionView::OnBrowserClosed, base::Unretained(this)));
+  auto* focus =
+      BrowserView::GetBrowserViewForBrowser(browser)->GetFocusManager();
+  return_focus_->SetView(focus->GetFocusedView() ? focus->GetFocusedView()
+                                                 : focus->GetStoredFocusView());
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(), 8));
+  auto label = [this](int message) {
+    auto* result = AddChildView(
+        std::make_unique<views::Label>(l10n_util::GetStringUTF16(message)));
+    result->SetMultiLine(true);
+    result->SetHorizontalAlignment(gfx::HorizontalAlignment::ALIGN_LEFT);
+    return result;
+  };
+  label(IDS_STAINLESS_CAPTION_EXPLANATION);
+  label(IDS_STAINLESS_CAPTION_SOURCE);
+  source_ = AddChildView(std::make_unique<views::Textfield>());
+  source_->GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_STAINLESS_CAPTION_SOURCE));
+  source_->SetText(
+      base::UTF8ToUTF16(browser->GetProfile()->GetPrefs()->GetString(
+          stainless_local::kSpeechLanguage)));
+  label(IDS_STAINLESS_CAPTION_SOURCE_HINT);
+  label(IDS_STAINLESS_CAPTION_TARGET);
+  std::vector<ui::SimpleComboboxModel::Item> targets;
+  for (int message :
+       {IDS_STAINLESS_CAPTION_ORIGINAL, IDS_STAINLESS_TRANSLATION_EN,
+        IDS_STAINLESS_TRANSLATION_IT, IDS_STAINLESS_TRANSLATION_FR,
+        IDS_STAINLESS_TRANSLATION_DE, IDS_STAINLESS_TRANSLATION_ES}) {
+    targets.emplace_back(l10n_util::GetStringUTF16(message));
+  }
+  target_ = AddChildView(std::make_unique<views::Combobox>(
+      std::make_unique<ui::SimpleComboboxModel>(std::move(targets))));
+  target_->GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_STAINLESS_CAPTION_TARGET));
+  if (caption_->selected()) {
+    source_->SetText(base::UTF8ToUTF16(caption_->options().source));
+    for (size_t index = 0; index < kTargets.size(); ++index) {
+      if ((index == 0 && caption_->options().target.empty()) ||
+          kTargets[index].tag_string() == caption_->options().target) {
+        target_->SetSelectedIndex(index);
+        break;
+      }
+    }
+  }
+  auto* buttons = AddChildView(std::make_unique<views::View>());
+  buttons->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal, gfx::Insets(), 8));
+  start_ = buttons->AddChildView(std::make_unique<views::MdTextButton>(
+      base::BindRepeating(&StainlessCaptionView::Start, base::Unretained(this)),
+      l10n_util::GetStringUTF16(IDS_STAINLESS_CAPTION_START)));
+  stop_ = buttons->AddChildView(std::make_unique<views::MdTextButton>(
+      base::BindRepeating(&StainlessCaptionView::Stop, base::Unretained(this)),
+      l10n_util::GetStringUTF16(IDS_STAINLESS_TRANSLATION_STOP)));
+  status_ = label(IDS_STAINLESS_CAPTION_SETUP_REQUIRED);
+  status_->GetViewAccessibility().SetRole(ax::mojom::Role::kStatus);
+  status_->GetViewAccessibility().SetLiveRegionContainer(
+      views::ViewAccessibility::LiveRegionStatus::kPolite);
+  AddChildView(std::make_unique<views::MdTextButton>(
+      base::BindRepeating(&StainlessCaptionView::OpenSettings,
+                          base::Unretained(this)),
+      l10n_util::GetStringUTF16(IDS_STAINLESS_TRANSLATION_SETUP)));
+  updates_ = caption_->Observe(
+      base::BindRepeating(&StainlessCaptionView::OnStatus, weak_.GetWeakPtr()));
+  if (caption_->selected() || caption_->error()) {
+    OnStatus(caption_->status(), caption_->error());
+  }
+  SetPreferredSize(gfx::Size(620, 430));
+  Refresh();
+}
