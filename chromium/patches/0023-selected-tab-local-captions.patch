+class StainlessCaptionBrowserTest : public InProcessBrowserTest {
+ public:
+  void SetUpCommandLine(base::CommandLine* command) override {
+    const auto summary =
+        base::CommandLine::ForCurrentProcess()->GetSwitchValuePath(
+            "test-launcher-summary-output");
+    ASSERT_TRUE(summary.IsAbsolute());
+    ASSERT_TRUE(cache_.CreateUniqueTempDirUnderPath(summary.DirName()));
+    base::FilePath canonical;
+    ASSERT_TRUE(base::NormalizeFilePath(cache_.GetPath(), &canonical));
+    command->AppendSwitchPath("disk-cache-dir", canonical);
+    command->AppendSwitchASCII("headless", "new");
+    command->AppendSwitch("use-mock-keychain");
+    command->AppendSwitch("use-fake-device-for-media-stream");
+    command->AppendSwitch("disable-audio-input");
+    command->AppendSwitch("disable-audio-output");
+  }
+
+  void SetUpOnMainThread() override {
+    ASSERT_TRUE(display::Screen::Get()->IsHeadless());
+    normalizer_ = base::i18n::CreateTransliterator(
+        "NFD; [:Nonspacing Mark:] Remove; Lower; NFC");
+    ASSERT_TRUE(normalizer_);
+    const auto wave =
+        base::CommandLine::ForCurrentProcess()->GetSwitchValuePath(
+            "stainless-speech-api-wave");
+    if (!wave.empty()) {
+      base::ScopedAllowBlockingForTesting blocking;
+      ASSERT_TRUE(base::ReadFileToStringWithMaxSize(wave, &wave_, 1048576));
+      ASSERT_EQ(
+          "25417ca993befbe9fe5bfe2651ec827c56fae66482d45fc30b7c8d96c71db695",
+          base::HexEncodeLower(crypto::hash::Sha256(wave_)));
+    }
+    embedded_test_server()->RegisterRequestHandler(base::BindRepeating(
+        &StainlessCaptionBrowserTest::Respond, base::Unretained(this)));
+    ASSERT_TRUE(embedded_test_server()->Start());
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(
+        browser(), embedded_test_server()->GetURL("/caption")));
+    network_ = std::make_unique<content::URLLoaderInterceptor>(
+        base::BindLambdaForTesting(
+            [&](content::URLLoaderInterceptor::RequestParams* request) {
+              const auto host = request->url_request.url.host();
+              if (host == "github.com" ||
+                  host.ends_with(".githubusercontent.com") ||
+                  host.ends_with(".huggingface.co") ||
+                  host == "huggingface.co" || host == "google.com" ||
+                  host.ends_with(".google.com") ||
+                  host.ends_with(".googleapis.com")) {
+                ++feature_requests_;
+                content::URLLoaderInterceptor::WriteResponse(
+                    "HTTP/1.1 503 No feature network permitted\n\n", "",
+                    request->client.get());
+                return true;
+              }
+              return false;
+            }));
+  }
+
+  void TearDownOnMainThread() override {
+    stainless_local::LocalCaption::StopForProfile(browser()->GetProfile());
+    if (View()) {
+      View()->GetWidget()->CloseNow();
+    }
+    EXPECT_TRUE(ui_test_utils::NavigateToURL(browser(), GURL("about:blank")));
+    network_.reset();
+    base::RunLoop().RunUntilIdle();
+    base::ScopedAllowBlockingForTesting blocking;
+    auto location = stainless_local::model_storage::ResolveLocation(
+        browser()->GetProfile()->GetPath().DirName());
+    ASSERT_TRUE(location.has_value()) << location.error();
+    auto removed = stainless_local::test::RemoveModelFixtures(*location);
+    EXPECT_TRUE(removed.has_value()) << removed.error();
+  }
+
+  content::WebContents* contents() {
+    return browser()->GetTabStripModel()->GetActiveWebContents();
+  }
+  StainlessCaptionView* View() {
+    return StainlessCaptionView::Get(browser()->GetUnownedUserDataHost());
+  }
+  bool StartEnabled() { return View()->start_->GetEnabled(); }
+  bool StopEnabled() { return View()->stop_->GetEnabled(); }
+  void Open() {
+    ASSERT_TRUE(chrome::ExecuteCommand(browser(), IDC_STAINLESS_CAPTION_TAB));
+    ASSERT_TRUE(View());
+  }
+  void Enable(const std::string& feature) {
+    auto* models = stainless_local::LocalModels::Get(browser()->GetProfile());
+    ASSERT_TRUE(models);
+    ASSERT_TRUE(models->ConfigureFeature(feature, true, true).has_value());
+  }
+  void Seed(const std::string& pack) {
+    base::ScopedAllowBlockingForTesting blocking;
+    auto location = stainless_local::model_storage::ResolveLocation(
+        browser()->GetProfile()->GetPath().DirName());
+    ASSERT_TRUE(location.has_value()) << location.error();
+    const auto directory =
+        base::CommandLine::ForCurrentProcess()->GetSwitchValuePath(
+            "stainless-model-pack-fixture");
+    auto installed =
+        stainless_local::test::InstallModelFixture(*location, pack, directory);
+    ASSERT_TRUE(installed.has_value()) << installed.error();
+  }
+  void Play(content::WebContents* target, int rate) {
+    ASSERT_FALSE(wave_.empty());
+    ASSERT_EQ(true, content::EvalJs(target, content::JsReplace(R"(
+      (async () => {
+        const context = new AudioContext({sampleRate: $1});
+        const response = await fetch('/speech.wav');
+        const buffer = await context.decodeAudioData(await response.arrayBuffer());
+        const source = context.createBufferSource();
+        source.buffer = buffer;
+        source.connect(context.destination);
+        await context.resume();
+        await new Promise(resolve => {
+          source.onended = resolve;
+          source.start();
+        });
+        await context.close();
+        return true;
+      })()
+    )",
+                                                               rate)));
+  }
+  int Concepts(const std::string& text, bool translate) {
+    if (text.empty()) {
+      return 0;
+    }
+    const auto normalized = normalizer_->Transliterate(base::UTF8ToUTF16(text));
+    base::i18n::BreakIterator iterator(normalized,
+                                       base::i18n::BreakIterator::BREAK_WORD);
+    if (!iterator.Init()) {
+      ADD_FAILURE() << "Frozen synthetic caption word segmentation failed";
+      return -1;
+    }
+    std::vector<std::u16string> words;
+    while (iterator.Advance()) {
+      if (iterator.IsWord()) {
+        words.emplace_back(iterator.GetString());
+      }
+    }
+    const std::array<std::vector<std::u16string>, 5> groups =
+        translate
+            ? std::array<std::vector<std::u16string>, 5>{{{u"robot"},
+                                                          {u"blu"},
+                                                          {u"tre", u"3"},
+                                                          {u"scatole",
+                                                           u"scatola"},
+                                                          {u"verdi", u"verde"}}}
+            : std::array<std::vector<std::u16string>, 5>{{{u"blue"},
+                                                          {u"robot"},
+                                                          {u"three", u"3"},
+                                                          {u"green"},
+                                                          {u"boxes", u"box"}}};
+    return std::ranges::count_if(groups, [&](const auto& aliases) {
+      return std::ranges::any_of(aliases, [&](const auto& word) {
+        return std::ranges::find(words, word) != words.end();
+      });
+    });
+  }
+  void NativeCaption(bool translate) {
+    base::test::ScopedRunLoopTimeout deadline(FROM_HERE, base::Minutes(3));
+    ASSERT_FALSE(wave_.empty());
+    ASSERT_NO_FATAL_FAILURE(Enable("captions"));
+    ASSERT_NO_FATAL_FAILURE(Seed("speech-multilingual"));
+    if (translate) {
+      ASSERT_NO_FATAL_FAILURE(Enable("translation"));
+      ASSERT_NO_FATAL_FAILURE(Seed("translation-en-it"));
+    }
+    ASSERT_NO_FATAL_FAILURE(Open());
+    View()->source_->SetText(u"en-US");
+    View()->target_->SetSelectedIndex(translate ? 2 : 0);
+    ASSERT_TRUE(View()->start_->GetEnabled());
+    stainless_local::test::ActivateNativeControl(View()->start_);
+    auto* caption = stainless_local::LocalCaption::SelectedForProfile(
+        browser()->GetProfile());
+    ASSERT_TRUE(caption) << base::UTF16ToUTF8(View()->status_->GetText());
+    auto states = caption->Observe(
+        base::BindLambdaForTesting([](const std::string& status, bool error) {
+          LOG(INFO) << "Stainless synthetic caption state error=" << error
+                    << " status=" << status;
+        }));
+    auto text = View()->caption_text_for_testing_;
+    ASSERT_FALSE(text.is_null());
+    View()->GetWidget()->CloseNow();
+    EXPECT_TRUE(caption->selected());
+    const auto start = base::TimeTicks::Now();
+    ASSERT_NO_FATAL_FAILURE(Play(contents(), 44100));
+    ASSERT_TRUE(base::test::RunUntil([&] {
+      return Concepts(text.Run(), translate) >= 4 || !caption->selected();
+    }));
+    ASSERT_TRUE(caption->selected()) << caption->status();
+    ASSERT_GE(Concepts(text.Run(), translate), 4);
+    LOG(INFO) << "Stainless synthetic tab caption latency ms="
+              << (base::TimeTicks::Now() - start).InMilliseconds();
+    EXPECT_EQ("prompt",
+              content::EvalJs(contents(),
+                              "navigator.permissions.query({name:'microphone'})"
+                              ".then(permission => permission.state)",
+                              content::EXECUTE_SCRIPT_NO_USER_GESTURE));
+    EXPECT_FALSE(contents()->IsAudioMuted());
+    ASSERT_NO_FATAL_FAILURE(Open());
+    ASSERT_TRUE(View()->stop_->GetEnabled());
+    EXPECT_EQ(translate ? 2u : 0u, View()->target_->GetSelectedIndex());
+    stainless_local::test::ActivateNativeControl(View()->stop_);
+    EXPECT_FALSE(caption->selected());
+    EXPECT_FALSE(stainless_local::LocalBroker::Get().ReservedSessionForProfile(
+        browser()->GetProfile()));
+    EXPECT_EQ(0, feature_requests_.load());
+  }
+
+ protected:
+  std::unique_ptr<net::test_server::HttpResponse> Respond(
+      const net::test_server::HttpRequest& request) {
+    auto response = std::make_unique<net::test_server::BasicHttpResponse>();
+    if (request.relative_url == "/speech.wav" && !wave_.empty()) {
+      response->set_content_type("audio/wav");
+      response->set_content(wave_);
+    } else if (request.relative_url == "/caption" ||
+               request.relative_url == "/other") {
+      response->set_content_type("text/html");
+      response->set_content(
+          "<!doctype html><title>Synthetic caption tab</title>"
+          "<button>Fictional playback controls</button>");
+    } else {
+      return nullptr;
+    }
+    return response;
+  }
+  base::ScopedTempDir cache_;
+  std::unique_ptr<base::i18n::Transliterator> normalizer_;
+  std::string wave_;
+  std::unique_ptr<content::URLLoaderInterceptor> network_;
+  std::atomic<int> feature_requests_{0};
+};
+
+IN_PROC_BROWSER_TEST_F(StainlessCaptionBrowserTest,
+                       DefaultOffAndPrivateNeverStartCaptureOrModels) {
+  ASSERT_NO_FATAL_FAILURE(Open());
+  EXPECT_FALSE(StartEnabled());
+  EXPECT_FALSE(StopEnabled());
+  EXPECT_FALSE(stainless_local::LocalCaption::SelectedForProfile(
+      browser()->GetProfile()));
+  View()->GetWidget()->CloseNow();
+  auto* private_browser = CreateIncognitoBrowser();
+  EXPECT_FALSE(chrome::CanOpenStainlessLocalControls(private_browser));
+  EXPECT_FALSE(
+      chrome::IsCommandEnabled(private_browser, IDC_STAINLESS_CAPTION_TAB));
+  EXPECT_EQ(nullptr, StainlessCaptionView::Show(private_browser));
+  base::ScopedAllowBlockingForTesting blocking;
+  auto location = stainless_local::model_storage::ResolveLocation(
+      browser()->GetProfile()->GetPath().DirName());
+  ASSERT_TRUE(location.has_value());
+  EXPECT_FALSE(base::PathExists(location->leaf));
+}
+
+IN_PROC_BROWSER_TEST_F(StainlessCaptionBrowserTest,
+                       MANUAL_LoopbackIsolatesTabsAndResamplesWithoutHardware) {
+  ASSERT_FALSE(wave_.empty());
+  auto* selected = contents();
+  chrome::AddTabAt(browser(), GURL("about:blank"), -1, true);
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("/other")));
+  auto* other = contents();
+  ASSERT_NE(selected, other);
+  size_t samples = 0;
+  int peak = 0;
+  std::string error;
+  stainless_local::LocalCaptionAudio audio(
+      selected->GetAudioGroupId(),
+      base::BindLambdaForTesting([&](media::mojom::AudioDataS16Ptr data) {
+        EXPECT_EQ(16000, data->sample_rate);
+        EXPECT_EQ(1, data->channel_count);
+        samples += data->data.size();
+        for (int16_t sample : data->data) {
+          peak = std::max(peak, std::abs(static_cast<int>(sample)));
+        }
+      }),
+      base::BindLambdaForTesting(
+          [&](const std::string& value) { error = value; }));
+  ASSERT_TRUE(audio.Start().has_value());
+  ASSERT_NO_FATAL_FAILURE(Play(other, 48000));
+  ASSERT_TRUE(
+      base::test::RunUntil([&] { return samples >= 48000 || !error.empty(); }));
+  EXPECT_TRUE(error.empty()) << error;
+  EXPECT_EQ(0, peak);
+  ASSERT_NO_FATAL_FAILURE(Play(selected, 44100));
+  ASSERT_TRUE(
+      base::test::RunUntil([&] { return peak > 100 || !error.empty(); }));
+  EXPECT_TRUE(error.empty()) << error;
+  EXPECT_GT(peak, 100);
+  audio.Stop();
+}
+
+IN_PROC_BROWSER_TEST_F(StainlessCaptionBrowserTest,
+                       MANUAL_NativeSelectedTabCaptionsReachActualBubble) {
+  NativeCaption(false);
+}
+
+IN_PROC_BROWSER_TEST_F(StainlessCaptionBrowserTest,
+                       MANUAL_NativeCaptionTranslationReachesActualBubble) {
+  NativeCaption(true);
+}
