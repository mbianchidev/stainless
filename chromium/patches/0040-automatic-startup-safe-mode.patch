diff --git a/chrome/browser/stainless_startup/startup_recovery.cc b/chrome/browser/stainless_startup/startup_recovery.cc
new file mode 100644
index 0000000000000000000000000000000000000000..c72170db87d8ccf3b8d49b3bf5df9b66bcf29bc8
--- /dev/null
+++ b/chrome/browser/stainless_startup/startup_recovery.cc
@@ -0,0 +1,137 @@
+// Copyright 2026 Synctune Open
+
+#include "chrome/browser/stainless_startup/startup_recovery.h"
+
+#include <algorithm>
+#include <string>
+#include <utility>
+
+#include "base/command_line.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/files/important_file_writer.h"
+#include "base/functional/bind.h"
+#include "base/functional/callback.h"
+#include "base/functional/callback_helpers.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/logging.h"
+#include "base/no_destructor.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/task/thread_pool.h"
+#include "base/values.h"
+#include "chrome/common/stainless_switches.h"
+
+namespace stainless {
+namespace {
+
+constexpr int kRecordVersion = 1;
+constexpr size_t kMaxRecordBytes = 4096;
+// Keeps the record bounded if a root keeps failing to start.
+constexpr int kMaxRecordedFailures = 1000;
+
+base::FilePath& TrackedRecord() {
+  static base::NoDestructor<base::FilePath> record;
+  return *record;
+}
+
+std::optional<int> ReadRecord(const base::FilePath& record) {
+  if (!base::PathExists(record)) {
+    return 0;
+  }
+  std::string contents;
+  if (!base::ReadFileToStringWithMaxSize(record, &contents, kMaxRecordBytes)) {
+    return std::nullopt;
+  }
+  std::optional<base::DictValue> dict =
+      base::JSONReader::ReadDict(contents, base::JSON_PARSE_RFC);
+  if (!dict || dict->FindInt("version") != kRecordVersion) {
+    return std::nullopt;
+  }
+  std::optional<int> failed = dict->FindInt("failed_startups");
+  if (!failed || *failed < 0) {
+    return std::nullopt;
+  }
+  return failed;
+}
+
+bool WriteRecord(const base::FilePath& record, int failed) {
+  base::DictValue dict;
+  dict.Set("version", kRecordVersion);
+  dict.Set("failed_startups", failed);
+  std::optional<std::string> json = base::WriteJson(dict);
+  return json &&
+         base::ImportantFileWriter::WriteFileAtomically(record, *json + "\n");
+}
+
+void ClearRecord(const base::FilePath& record) {
+  if (!WriteRecord(record, 0)) {
+    LOG(ERROR) << "Cannot clear the Stainless startup record " << record;
+  }
+}
+
+void PostClearRecord(base::OnceClosure done) {
+  const base::FilePath& record = TrackedRecord();
+  if (record.empty()) {
+    std::move(done).Run();
+    return;
+  }
+  base::ThreadPool::PostTaskAndReply(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskShutdownBehavior::BLOCK_SHUTDOWN},
+      base::BindOnce(&ClearRecord, record), std::move(done));
+}
+
+}  // namespace
+
+std::optional<int> ReadFailedStartups(const base::FilePath& user_data_dir) {
+  return ReadRecord(user_data_dir.Append(kStartupRecoveryFileName));
+}
+
+void BeginStartupFailureTracking(const base::FilePath& user_data_dir,
+                                 const base::CommandLine& command_line) {
+  if (user_data_dir.empty() || command_line.HasSwitch("headless") ||
+      command_line.HasSwitch("incognito")) {
+    return;
+  }
+  const base::FilePath record = user_data_dir.Append(kStartupRecoveryFileName);
+  std::optional<int> failed = ReadRecord(record);
+  if (!failed) {
+    LOG(ERROR) << "Ignoring the unreadable Stainless startup record " << record
+               << "; counting failed startups from zero";
+    failed = 0;
+  }
+  if (*failed >= kAutomaticSafeModeThreshold &&
+      !command_line.HasSwitch(kStartupSafeMode)) {
+    g_automatic_startup_safe_mode = true;
+    LOG(WARNING) << "Stainless did not start successfully " << *failed
+                 << " times in a row; starting in automatic Safe Mode. Saved "
+                    "extensions, background apps and session restoration are "
+                    "temporarily unavailable";
+  }
+  if (!WriteRecord(record, std::min(*failed + 1, kMaxRecordedFailures))) {
+    LOG(ERROR) << "Cannot record this Stainless startup in " << record
+               << "; failed startups are not counted for this launch";
+    return;
+  }
+  TrackedRecord() = record;
+}
+
+void ScheduleStartupHealthConfirmation() {
+  if (TrackedRecord().empty()) {
+    return;
+  }
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE, base::BindOnce(&PostClearRecord, base::DoNothing()),
+      kStartupHealthDelay);
+}
+
+void RecordNormalShutdown() {
+  PostClearRecord(base::DoNothing());
+}
+
+void ConfirmStartupHealthForTesting(base::OnceClosure done) {
+  PostClearRecord(std::move(done));
+}
+
+}  // namespace stainless
diff --git a/chrome/browser/stainless_startup/startup_recovery.h b/chrome/browser/stainless_startup/startup_recovery.h
new file mode 100644
index 0000000000000000000000000000000000000000..81f149f06824ce65ac4283dadb43600049048a1f
--- /dev/null
+++ b/chrome/browser/stainless_startup/startup_recovery.h
@@ -0,0 +1,53 @@
+// Copyright 2026 Synctune Open
+
+#ifndef CHROME_BROWSER_STAINLESS_STARTUP_STARTUP_RECOVERY_H_
+#define CHROME_BROWSER_STAINLESS_STARTUP_STARTUP_RECOVERY_H_
+
+#include <optional>
+
+#include "base/functional/callback_forward.h"
+#include "base/time/time.h"
+
+namespace base {
+class CommandLine;
+class FilePath;
+}  // namespace base
+
+namespace stainless {
+
+// Versioned per-root record of consecutive startups that neither stayed up for
+// kStartupHealthDelay nor quit normally.
+inline constexpr char kStartupRecoveryFileName[] = "Stainless Startup Recovery";
+
+// After this many consecutive failed startups, the next launch of the same
+// Standard root starts in automatic Safe Mode.
+inline constexpr int kAutomaticSafeModeThreshold = 2;
+
+// Matches the updater's startup-health confirmation delay.
+inline constexpr base::TimeDelta kStartupHealthDelay = base::Seconds(30);
+
+// Browser process only. Call after acquiring the process singleton and before
+// Local State, policy, extensions or session services are created. Records this
+// launch as a pending startup and enables automatic Safe Mode after repeated
+// failures. Fresh Incognito/Guest roots and headless launches are not tracked.
+void BeginStartupFailureTracking(const base::FilePath& user_data_dir,
+                                 const base::CommandLine& command_line);
+
+// Clears the failure record once the browser has stayed up for
+// kStartupHealthDelay after startup completed.
+void ScheduleStartupHealthConfirmation();
+
+// Clears the failure record when the browser quits normally, including a
+// restart. A crash or killed process leaves the startup counted as failed.
+void RecordNormalShutdown();
+
+// Reads the recorded number of failed startups. Returns 0 when there is no
+// record and std::nullopt when the record is unreadable or malformed.
+std::optional<int> ReadFailedStartups(const base::FilePath& user_data_dir);
+
+// Clears the record immediately and runs `done` on the calling sequence.
+void ConfirmStartupHealthForTesting(base::OnceClosure done);
+
+}  // namespace stainless
+
+#endif  // CHROME_BROWSER_STAINLESS_STARTUP_STARTUP_RECOVERY_H_
diff --git a/chrome/browser/stainless_startup/startup_recovery_browsertest.cc b/chrome/browser/stainless_startup/startup_recovery_browsertest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..d92dc508da7cb4005c44a36a429fdc0d3953ccc9
--- /dev/null
+++ b/chrome/browser/stainless_startup/startup_recovery_browsertest.cc
@@ -0,0 +1,160 @@
+// Copyright 2026 Synctune Open
+
+#include "chrome/browser/stainless_startup/startup_recovery.h"
+
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/path_service.h"
+#include "base/test/run_until.h"
+#include "base/test/test_future.h"
+#include "base/threading/thread_restrictions.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/startup/startup_browser_creator.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/common/chrome_paths.h"
+#include "chrome/common/stainless_switches.h"
+#include "chrome/grit/branded_strings.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "components/infobars/content/content_infobar_manager.h"
+#include "components/infobars/core/confirm_infobar_delegate.h"
+#include "components/infobars/core/infobar.h"
+#include "content/public/test/browser_test.h"
+#include "ui/base/l10n/l10n_util.h"
+
+namespace {
+
+base::FilePath UserDataDir() {
+  return base::PathService::CheckedGet(chrome::DIR_USER_DATA);
+}
+
+bool WriteRecord(int failed_startups) {
+  return base::WriteFile(
+      UserDataDir().Append(stainless::kStartupRecoveryFileName),
+      "{\"version\":1,\"failed_startups\":" +
+          base::NumberToString(failed_startups) + "}\n");
+}
+
+std::optional<int> ReadRecord() {
+  base::ScopedAllowBlockingForTesting allow_blocking;
+  return stainless::ReadFailedStartups(UserDataDir());
+}
+
+void ConfirmHealth() {
+  base::test::TestFuture<void> confirmed;
+  stainless::ConfirmStartupHealthForTesting(confirmed.GetCallback());
+  ASSERT_TRUE(confirmed.Wait());
+}
+
+std::u16string SafeModeNotice(BrowserWindowInterface* browser) {
+  auto* manager = infobars::ContentInfoBarManager::FromWebContents(
+      browser->GetTabStripModel()->GetActiveWebContents());
+  for (infobars::InfoBar* infobar : manager->infobars()) {
+    if (infobar->delegate()->GetIdentifier() ==
+        infobars::InfoBarDelegate::
+            STAINLESS_STARTUP_SAFE_MODE_INFOBAR_DELEGATE) {
+      return infobar->delegate()->AsConfirmInfoBarDelegate()->GetMessageText();
+    }
+  }
+  return {};
+}
+
+class StainlessStartupRecoveryBrowserTest : public InProcessBrowserTest {
+ protected:
+  explicit StainlessStartupRecoveryBrowserTest(int recorded_failures)
+      : recorded_failures_(recorded_failures) {}
+
+  bool SetUpUserDataDirectory() override {
+    return recorded_failures_ < 0 || WriteRecord(recorded_failures_);
+  }
+
+ private:
+  const int recorded_failures_;
+};
+
+class StainlessRepeatedStartupFailureBrowserTest
+    : public StainlessStartupRecoveryBrowserTest {
+ public:
+  StainlessRepeatedStartupFailureBrowserTest()
+      : StainlessStartupRecoveryBrowserTest(
+            stainless::kAutomaticSafeModeThreshold) {}
+};
+
+IN_PROC_BROWSER_TEST_F(StainlessRepeatedStartupFailureBrowserTest,
+                       StartsInAutomaticSafeModeUntilHealthy) {
+  EXPECT_TRUE(stainless::IsAutomaticStartupSafeMode());
+  EXPECT_TRUE(stainless::IsStartupSafeMode());
+  EXPECT_FALSE(base::CommandLine::ForCurrentProcess()->HasSwitch(
+      stainless::kStartupSafeMode));
+  EXPECT_EQ(SessionStartupPref::DEFAULT,
+            StartupBrowserCreator::GetSessionStartupPref(
+                *base::CommandLine::ForCurrentProcess(), browser()->GetProfile())
+                .type);
+  // This launch stays counted until it proves healthy.
+  EXPECT_EQ(stainless::kAutomaticSafeModeThreshold + 1, ReadRecord());
+  ASSERT_TRUE(base::test::RunUntil([&] { return !SafeModeNotice(browser()).empty(); }));
+  EXPECT_EQ(l10n_util::GetStringUTF16(IDS_STAINLESS_AUTOMATIC_STARTUP_SAFE_MODE),
+            SafeModeNotice(browser()));
+
+  ConfirmHealth();
+  EXPECT_EQ(0, ReadRecord());
+}
+
+class StainlessSingleStartupFailureBrowserTest
+    : public StainlessStartupRecoveryBrowserTest {
+ public:
+  StainlessSingleStartupFailureBrowserTest()
+      : StainlessStartupRecoveryBrowserTest(
+            stainless::kAutomaticSafeModeThreshold - 1) {}
+};
+
+IN_PROC_BROWSER_TEST_F(StainlessSingleStartupFailureBrowserTest,
+                       StartsNormallyBelowTheThreshold) {
+  EXPECT_FALSE(stainless::IsAutomaticStartupSafeMode());
+  EXPECT_FALSE(stainless::IsStartupSafeMode());
+  EXPECT_EQ(stainless::kAutomaticSafeModeThreshold, ReadRecord());
+  EXPECT_TRUE(SafeModeNotice(browser()).empty());
+}
+
+class StainlessMalformedStartupRecordBrowserTest
+    : public StainlessStartupRecoveryBrowserTest {
+ public:
+  StainlessMalformedStartupRecordBrowserTest()
+      : StainlessStartupRecoveryBrowserTest(-1) {}
+
+  bool SetUpUserDataDirectory() override {
+    return base::WriteFile(
+        UserDataDir().Append(stainless::kStartupRecoveryFileName),
+        "{\"version\":2,\"failed_startups\":9}");
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(StainlessMalformedStartupRecordBrowserTest,
+                       UnknownRecordsCountFromZero) {
+  EXPECT_FALSE(stainless::IsStartupSafeMode());
+  EXPECT_EQ(1, ReadRecord());
+}
+
+class StainlessNormalShutdownBrowserTest
+    : public StainlessStartupRecoveryBrowserTest {
+ public:
+  StainlessNormalShutdownBrowserTest()
+      : StainlessStartupRecoveryBrowserTest(-1) {}
+};
+
+// A normal quit clears the record even before the health delay, so quick
+// manual quits never accumulate into automatic Safe Mode.
+IN_PROC_BROWSER_TEST_F(StainlessNormalShutdownBrowserTest,
+                       PRE_NormalQuitClearsFailures) {
+  base::ScopedAllowBlockingForTesting allow_blocking;
+  ASSERT_TRUE(WriteRecord(stainless::kAutomaticSafeModeThreshold + 5));
+}
+
+IN_PROC_BROWSER_TEST_F(StainlessNormalShutdownBrowserTest,
+                       NormalQuitClearsFailures) {
+  EXPECT_FALSE(stainless::IsStartupSafeMode());
+  EXPECT_EQ(1, ReadRecord());
+}
+
+}  // namespace
